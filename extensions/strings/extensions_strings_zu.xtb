<translation id="8517576857589387417">Ifayela le-manifest alikho noma alifundeki</translation>
<translation id="8565650234829130278">Izame ukwehlisa ukuthuthukiswa kohlelo lokusebenza.</translation>
<translation id="8621383749470166852">Ayikwazanga ukulayisha ifayela elithi '<ph name="RELATIVE_PATH" />' leskripthi sekhontenti, iskripthi sekhontenti singalayishwa kuphela ukusuka kumafayela eJavaScript asekelwayo njengamafayela okuthi .js.</translation>
