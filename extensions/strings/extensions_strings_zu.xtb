<translation id="2150661552845026580">Engeza i-"<ph name="EXTENSION_NAME" />"?</translation>
<translation id="2159915644201199628">Ayikwazanga ukukhipha ikhodi kusithombe: '<ph name="IMAGE_NAME" />'</translation>
