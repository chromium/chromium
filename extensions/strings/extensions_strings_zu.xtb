<translation id="2766161002040448006">Buza umzali</translation>
<translation id="2785530881066938471">Ayikwazanga ukulayisha ifayela le-'<ph name="RELATIVE_PATH" />' ngesikripthi sokuqukethwe. Ayibhalwanga ngekhodi ye-UTF-8.</translation>
<translation id="2850541429955027218">Engeza itimu</translation>
<translation id="2883143988769190738">Lesi sandiso sicela izimvume ezilandelayo:</translation>
