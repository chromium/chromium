<translation id="6202304368170870640">သင့်စက်ပစ္စည်းသို့ လက်မှတ်ထိုးဝင်ရန် (သို့) လော့ခ်ဖွင့်ရန် သင်၏' ပင်နံပါတ်' ကို အသုံးပြုနိုင်သည်။</translation>
<translation id="6209908325007204267">သင့်စက်တွင် 'Chrome လုပ်ငန်းသုံး အဆင့်မြှင့်တင်မှု' ပါဝင်သည်၊ သို့သော် သင့်အသုံးပြုသူအမည်သည် လုပ်ငန်းသုံး အကောင့်နှင့် ဆက်စပ်မှုမရှိပါ။ ဒုတိယစက်တစ်ခုတွင် g.co/ChromeEnterpriseAccount သို့သွားပြီး လုပ်ငန်းသုံး အကောင့်တစ်ခု ဖွင့်ပါ။</translation>
<translation id="623261264391834964">‘ကူရေးပေးပါ’ သုံးရန် စာသားအကွက်တွင် ညာဘက်ခလုတ်ကို နှိပ်ပါ</translation>
<translation id="6280215091796946657">မတူညီသည့်အကောင့်တစ်ခုဖြင့် လက်မှတ်ထိုးဝင်ပါ</translation>
<translation id="6283823201263716145">‘သရုပ်ပြမုဒ်’ စက်များသည် ဝန်ဆောင်မှုများနှင့် စွမ်းဆောင်ရည်မြှင့်တင်ရန် အမှားရှာဖွေမှုနှင့် သုံးစွဲမှု ဒေတာအပြင် ပျက်စီးမှု အစီရင်ခံစာများကို Google သို့ အလိုအလျောက်ပို့သည်</translation>
<translation id="6287713404380454515">လုံခြုံရေးဆိုင်ရာ အကြောင်းရင်းများကြောင့် သင့်စီမံခန့်ခွဲသူသည် သင်၏စက် ပင်နံပါတ်နှင့် စကားဝှက်ကို ပိတ်ထားသည်။ ယခုမှစ၍ သင်၏ <ph name="MANAGER" /> စကားဝှက်ကို သုံးပါ။</translation>
<translation id="6301300352769835063"><ph name="DEVICE_OS" /> ပိုမိုကောင်းမွန်စေရန် သင့်ကွန်ပျူတာဆိုင်ရာ စက်ပစ္စည်းဒေတာကို Google အားသုံးခွင့်ပေးပါ။ သဘောမတူပါက ဤဒေတာကို သင့်လျော်သော အပ်ဒိတ်များ ဆုံးဖြတ်ပေးရန် Google သို့ ပို့မည်ဖြစ်သော်လည်း အခြားကိစ္စများအတွက် သိမ်းထားမည်မဟုတ်ပါ (သို့) သုံးမည်မဟုတ်ပါ။ g.co/flex/HWDataCollection တွင် ပိုမိုလေ့လာပါ။</translation>
<translation id="6308493641021088955"><ph name="EXTENSION_NAME" /> က လက်မှတ်ထိုးဝင်ခြင်းကို ထောက်ပံ့ပေးထားသည်</translation>
<translation id="6314819609899340042">ဤ<ph name="IDS_SHORT_PRODUCT_NAME" />စက်ပစ္စည်းပေါ်တွင် ချို့ယွင်းချင်ရှာဖွေပြုပြင်ရေး အင်္ဂါရပ်များကို သင်အောင်မြင်စွာ ဖွင့်ထားပြီးဖြစ်သည်။</translation>
<translation id="6343262564968371601">Google၊ ဖိုင်၊ အက်ပ် စသည်တို့ကို ရှာဖွေခြင်းဖြင့် သင်လိုချင်သည့်အရာကို ရှာနိုင်သည်</translation>
<translation id="635609604405270300">ကိရိယာကို ဆက်ဖွင့်ထားပါ</translation>
<translation id="6367097275976877956">ChromeOS ၏ အသင့်ပါ ဖန်သားပြင်ဖတ်အက်ပ် ChromeVox ကို စဖွင့်လိုသလား။ ဖွင့်လိုပါက နေရာခြားခလုတ်ကို နှိပ်ပါ။</translation>
<translation id="636850387210749493">လုပ်ငန်း အမည်စာရင်းသွင်းခြင်း</translation>
<translation id="6380143666419481200">လက်ခံပြီး ဆက်လုပ်ရန်</translation>
<translation id="640457954117263537">ChromeOS၊ Android အက်ပ်နှင့် ဝန်ဆောင်မှုများအတွက် တည်နေရာသုံးရန်။</translation>
<translation id="6418311015934520372"><ph name="BEGIN_PARAGRAPH1" />သင်၏ ChromeOS စက်ပစ္စည်းများမှ အလိုအလျောက် အစီရင်ခံစာများ ပို့ခွင့်ပြုခြင်းက ChromeOS တွင် ပြင်ဆင်ရန်နှင့် ပိုကောင်းအောင် လုပ်ရန်ရှိသည်များကို ဦးစားပေး လုပ်ဆောင်နိုင်ရန် အကူအညီဖြစ်စေသည်။ ဤအစီရင်ခံစာများတွင် ChromeOS ရပ်တန့်သွားမှုများ၊ သင်အသုံးပြုသည့် လုပ်ဆောင်ချက်များနှင့် ပုံမှန်အသုံးပြုသည့် မှတ်ဉာဏ်ပမာဏကဲ့သို့သော အချက်များ ပါဝင်နိုင်သည်။<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />သင်၏ Chrome စက်ပစ္စည်း ဆက်တင်များတွင် ဤအစီရင်ခံစာများ ခွင့်ပြုခြင်းကို အချိန်မရွေး စတင်နိုင်သည် သို့မဟုတ် ရပ်တန့်နိုင်သည်။ သင်သည် ဒိုမိန်း စီမံခန့်ခွဲသူဖြစ်ပါက ဤဆက်တင်ကို စီမံခန့်ခွဲသူ ကွန်ဆိုးလ်တွင် ပြောင်းနိုင်ပါသည်။<ph name="END_PARAGRAPH2" /></translation>
<translation id="6418511932144861495">အရေးကြီးသော အပ်ဒိတ်ကို ထည့်ပါ</translation>
<translation id="6478849105642611893">အမြန်ထည့်ကီးသည် တဘ်ကီး၏ အောက်တွင်ရှိသည်</translation>
<translation id="6480327114083866287"><ph name="MANAGER" /> က စီမံခန့်ခွဲသည်</translation>
<translation id="6488384360522318064">ဘာသာစကား ရွေးချယ်ရန်</translation>
<translation id="6495266441917713704">Wi-Fi လွှဲပြောင်း၍မရပါ</translation>
<translation id="6515620015470298987">စက်ကိရိယာ ပုံစံပြင်သတ်မှတ်ခြင်း စစ်ဆေးမှုပြဿနာကြောင့် လက်မှတ်ထိုးဝင်၍ မရလိုက်ပါ။ သင့် <ph name="DEVICE_TYPE" /> ကို အားဖြင့်ရှင်းထုတ်ပြီး ထပ်စမ်းကြည့်ပါ။</translation>
<translation id="6519689855001245063">သတ်မှတ်ချက်ပြည့်မီမှုကို စစ်ဆေးနေသည်</translation>
<translation id="6532527800157340614">တိုကင်ကို မရယူနိုင်သည့်အတွက် လက်မှတ်ထိုးဝင်၍မရပါ။ သင့်ကွန်ရက်ချိတ်ဆက်မှုကို စစ်ဆေးပြီး ထပ်စမ်းကြည့်ပါ။</translation>
<translation id="653920215766444089">ညွှန်ပြသည့်ကိရိယာကို ရှာနေသည်</translation>
<translation id="65513682072153627">သင့်ကြီးကြပ်သူက ဆက်တင် (သို့) ဝန်ဆောင်မှုတစ်ခုကို စီမံထားပါက ဤ ‘စီမံထားသည်’ သင်္ကေတကို တွေ့ရပါမည်။</translation>
<translation id="6561726789132298588">ထည့်သွင်းရန်</translation>
<translation id="6607890859198268021"><ph name="USER_EMAIL" /> ကို <ph name="DOMAIN" /> က စီမံနေပါသည်။ မတူညီသော Google Account ဖြင့် မိဘ အထိန်းအချုပ်များကိုသုံးရန် စနစ်ထည့်သွင်းပြီးပါက ထွက်ပါ၊ ထို့နောက် လက်မှတ်ထိုး ဝင်သည့်ဖန်သားပြင်ရှိ "လူထည့်ရန်" ကို ရွေးပါ။</translation>
<translation id="6642720633335369752">ဖွင့်ထားသော အက်ပ်ဝင်းဒိုးအားလုံးကို ကြည့်ရန် အောက်ခြေမှအပေါ်သို့ ပွတ်ဆွဲပြီး ဖိထားပါ။</translation>
<translation id="6648911618876616409">အရေးကြီးသည့် အပ်ဒိတ်ကို ထည့်သွင်းရန် အဆင်သင့်ဖြစ်ပါပြီ။ စတင်ရန် လက်မှတ်ထိုးဝင်ပါ။</translation>
<translation id="6671497123040790595"><ph name="MANAGER" /> က စီမံခန့်ခွဲမှုကို စနစ်ထည့်သွင်းနေသည်</translation>
<translation id="6675665718701918026">ညွှန်းပြ ကိရိယာကို ချိတ်ဆက်ထားသည်</translation>
<translation id="667752334740867460">Wi-Fi အချက်အလက်ကို လက်ခံနေသည်…</translation>
<translation id="6680442031740878064">ရနိုင်သည့် နေရာလွတ်− <ph name="AVAILABLE_SPACE" /></translation>
<translation id="6722744767592605627"><ph name="EMAIL" /> ကို ပြန်လည်ရယူနိုင်သော်လည်း စက်တွင်းဒေတာကို ဖျက်ပါမည်။</translation>
<translation id="6748980958975836188">ကျွန်ုပ်သည် <ph name="BEGIN_LINK1" />Google ဝန်ဆောင်မှုစည်းမျဉ်းများ<ph name="END_LINK1" />၊ <ph name="BEGIN_LINK2" />Chrome နှင့် ChromeOS ထပ်တိုး ဝန်ဆောင်မှုစည်းမျဉ်းများ<ph name="END_LINK2" /> ကို ဖတ်ရှုပြီး သဘောတူပါသည်။</translation>
<translation id="6749473226660745022">ဓာတ်ပုံများ</translation>
<translation id="6754918760968695779">အမြန်ထည့်</translation>
<translation id="6789834167207639931">ပြန်လည်ရယူမှု အပြီးသတ်ရန် လာမည့်စခရင်တွင် သင့် Google Account စကားဝှက်ကို ထပ်မံထည့်ပါ</translation>
<translation id="6797022073000660150"><ph name="BEGIN_PARAGRAPH1" />ChromeOS စက်ပစ္စည်းများမှ အလိုအလျောက် အစီရင်ခံစာများ ပို့ခွင့်ပြုခြင်းက ChromeOS တွင် ပြင်ဆင်ရန်နှင့် ပိုကောင်းအောင် လုပ်ရန်ရှိသည်များကို ဦးစားပေး လုပ်ဆောင်နိုင်ရန် အကူအညီဖြစ်စေသည်။ ဤအစီရင်ခံစာများတွင် ChromeOS ရပ်တန့်သွားမှုများ၊ သင်အသုံးပြုသည့် လုပ်ဆောင်ချက်များနှင့် ပုံမှန်အသုံးပြုသည့် မှတ်ဉာဏ်ပမာဏကဲ့သို့သော အချက်များ ပါဝင်နိုင်သည်။ ပေါင်းစည်းထားသည့် ဒေတာအချို့သည် Google အက်ပ်များနှင့် Android ဆော့ဖ်ဝဲရေးသူများကဲ့သို့ ပါတနာများကိုလည်း အကူအညီဖြစ်စေပါမည်။<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />သင့်ကလေး၏ ChromeOS စက်ပစ္စည်း ဆက်တင်များတွင် ဤအစီရင်ခံစာများ ခွင့်ပြုခြင်းကို အချိန်မရွေး စတင်နိုင်သည် သို့မဟုတ် ရပ်တန့်နိုင်သည်။ သင်သည် ဒိုမိန်း စီမံခန့်ခွဲသူဖြစ်ပါက ဤဆက်တင်ကို စီမံခန့်ခွဲသူ ကွန်ဆိုးလ်တွင် ပြောင်းနိုင်ပါသည်။<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH4" />သင့်ကလေး၏ Google Account အတွက် ‘ဝဘ်နှင့်အက်ပ်လုပ်ဆောင်ချက်’ ဆက်တင် ဖွင့်ထားပါက သင့်ကလေး၏ဒေတာကို သူ၏ Google Account တွင် သိမ်းထားနိုင်သည်။ ဤဆက်တင်များနှင့် ၎င်းတို့ကို ချိန်ညှိနည်းအကြောင်း families.google.com တွင် ပိုမိုလေ့လာနိုင်သည်။<ph name="END_PARAGRAPH4" /></translation>
<translation id="6800893479155997609">သင့် <ph name="DEVICE_TYPE" /> အတွက် ထိပ်တန်းအက်ပ်များ</translation>
<translation id="682971198310367122">Google ကိုယ်ရေးအချက်အလက်လုံခြုံမှုဆိုင်ရာ မူဝါဒ</translation>
<translation id="6835762382653651563">သင့် <ph name="DEVICE_TYPE" /> ကို အသစ်မွမ်းမံရန် ကျေးဇူးပြု၍ အင်တာနက်နှင့် ချိတ်ဆက်ပါ။</translation>
<translation id="6839916869147598086">အကောင့်ဝင်ရောက်ခြင်းကို ပြောင်းထားသည်</translation>
<translation id="6852529053326738838">သင့်အကောင့်အကျုံးဝင်၊ မဝင် ကြည့်ရန် သင့်အဖွဲ့အစည်းကို မေးနိုင်သည် (သို့) သင့်အလုပ်အီးမေးလ်နှင့် စာရင်းသွင်းနိုင်သည်။</translation>
