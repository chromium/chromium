<translation id="49027928311173603">ဆာဗာမှ ဒေါင်းလုပ်လုပ်ထားသည့် ပေါ်လစီသည် မမှန်ကန်ပါ: <ph name="VALIDATION_ERROR" />။</translation>
<translation id="4941246025622441835">လုပ်ငန်းစီမံမှုအတွက် စက်ပစ္စည်းကို စာရင်းသွင်းသော် ဤစက်ပစ္စည်းတောင်းဆိုမှုကို သုံးပါ။</translation>
<translation id="4944310289250773232">ဤအထောက်အထားစိစစ်ခြင်း ဝန်ဆောင်မှုကို <ph name="SAML_DOMAIN" /> က လက်ခံဝန်ဆောင်ပေးထားခြင်းဖြစ်သည်</translation>
<translation id="4955710816792587366">သင်၏ ပင်နံပါတ်ကို ရွေးချယ်ခြင်း</translation>
<translation id="4965808351167763748">Hangouts Meet ကို ဖွင့်ရန်အတွက် ဤစက်ပစ္စည်းကို စနစ်ထည့်သွင်းလိုသည်မှာ သေချာပါသလား။</translation>
<translation id="4987944280765486504">ဒေါင်းလုဒ်ပြီးဆုံးသည်နှင့် Chromebook ပြန်လည်စတင်ပြီး စနစ်ထည့်သွင်းခြင်းကို ဆက်လုပ်နိုင်ပါသည်။</translation>
<translation id="5029287942302939687">သင့်စကားဝှက်ကို စနစ်ထည့်သွင်းပြီးပြီ</translation>
<translation id="503155457707535043">အက်ပ်များကို ဒေါင်းလုဒ်လုပ်နေသည်</translation>
<translation id="5045550434625856497">စကားဝှက် မမှန်ပါ</translation>
<translation id="5062930723426326933">လက်မှတ်ထိုး ဝင်မှု မအောင်မြင်ခဲ့ပါ၊ ကျေးဇူးပြုပြီး အင်တာနက်သို့ ဆက်ပြီး ထပ်စမ်းပါ။</translation>
<translation id="5085162214018721575">မွမ်းမံမှုများကို စစ်ကြည့်နေ</translation>
<translation id="5097306410549350357">တည်နေရာအသုံးပြုခြင်းအကြောင်း ပိုမိုလေ့လာရန်</translation>
<translation id="5107486920067578245"><ph name="BEGIN_PARAGRAPH1" />Google AI ဖြင့် စာရေးခြင်း၊ စီစဉ်ခြင်း၊ လေ့လာခြင်း စသည်တို့စတင်ရန် Gemini နှင့် ချတ်လုပ်ပါ။<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />စနစ်ထည့်သွင်းပြီးနောက် စခရင်အောက်ခြေရှိ စင်ပေါ်တွင် Gemini အက်ပ်ကို ရွေးပြီး Gemini ကို စတင်အသုံးပြုပါ။<ph name="END_PARAGRAPH2" /></translation>
<translation id="5115309401544567011">သင်၏ <ph name="DEVICE_TYPE" /> ကို အားသွင်းပါ။</translation>
<translation id="5145876360421795017">စက်ကို စာရင်းမသွင်းပါနှင့်</translation>
<translation id="5147516217412920887">ကုဒ်ကို အတည်ပြုရန် သင့်ဖုန်းရှိ လမ်းညွှန်ချက်များအတိုင်း ဆောင်ရွက်ပါ</translation>
<translation id="5160857336552977725">သင့်<ph name="DEVICE_TYPE" /> သို့ လက်မှတ်ထိုးဝင်ရန်</translation>
<translation id="5171185788583376591"><ph name="BEGIN_H3" />အမှားရှာပြင်သည့် လုပ်ဆောင်ချက်များ<ph name="END_H3" />
          <ph name="BR" />
          သင့်စက်တွင် စိတ်ကြိုက်ကုဒ်များ ထည့်သွင်းစမ်းသပ်ရန် ChromeOS Flex စက်ပစ္စည်းတွင် အမှားရှာပြင်သည့် လုပ်ဆောင်ချက်များကို ဖွင့်နိုင်သည်။  ၎င်းက သင့်အား အောက်ပါတို့ကို လုပ်ဆောင်ခွင့်ပေးမည်-<ph name="BR" />
          <ph name="BEGIN_LIST" />
            <ph name="LIST_ITEM" />OS ဖိုင်များ ပြုပြင်နိုင်ရန်အတွက် rootfs စိစစ်မှုကို ဖယ်ရှားခြင်း
            <ph name="LIST_ITEM" />စက်ကို ဝင်သုံးရန်အတွက် <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> ကဲ့သို့သော တူးလ်များကို အသုံးပြုနိုင်ရန် ပုံမှန်စမ်းသပ်ကီးများဖြင့် SSH ဝင်ရောက်ခွင့်ကို ဖွင့်ခြင်း
            <ph name="LIST_ITEM" />USB ဒရိုက်ဗ်မှ OS မိတ္တူကို ထည့်သွင်းနိုင်ရန်အတွက် USB မှ စနစ်စတင်ခြင်းကို ဖွင့်ခြင်း
            <ph name="LIST_ITEM" />စက်ထဲသို့ ကိုယ်တိုင် SSH ဝင်နိုင်ရန် dev နှင့် စနစ် root ဝင်ရောက်သည့် စကားဝှက်နှစ်ခုစလုံးကို စိတ်ကြိုက်တန်ဖိုး သတ်မှတ်ခြင်း
          <ph name="END_LIST" />
          <ph name="BR" />
          ဖွင့်ပြီးပါက အဖွဲ့အစည်းတစ်ခုက စီမံသည့် စက်တွင် Powerwash လုပ်ခြင်း (သို့) ဒေတာရှင်းလင်းခြင်း ဆောင်ရွက်ပြီးသည့်တိုင် အမှားရှာပြင်သည့် လုပ်ဆောင်ချက် အများစုမှာ ပွင့်နေပါမည်။ အမှားရှာပြင်သည့် လုပ်ဆောင်ချက်အားလုံးကို လုံးဝပိတ်ရန် ChromeOS ပြန်လည်ရယူခြင်း လုပ်ငန်းစဉ် (https://support.google.com/chromebook/answer/1080595) ကို အပြီးသတ်ပါ။
          <ph name="BR" />
          <ph name="BR" />
          အမှားရှာပြင်သည့် လုပ်ဆောင်ချက်များအကြောင်း နောက်ထပ်အချက်အလက်များအတွက် ဝင်ကြည့်ရန်-<ph name="BR" />
          https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
          <ph name="BR" />
          <ph name="BR" />
          <ph name="BEGIN_BOLD" />မှတ်ချက်-<ph name="END_BOLD" />  လုပ်ငန်းစဉ်အတွင်း စနစ်ပြန်လည်စတင်ပါမည်။</translation>
<translation id="5215502535566372932">နိုင်ငံ ရွေးပါ</translation>
<translation id="5234523649284990414">စာသားမှ စကားသံပြောင်းစနစ် (သို့) မျက်မမြင်စာဖတ်ကိရိယာဖြင့် ဖန်သားပြင်တွင် ပြထားသော စာသားအား ဖတ်ရန် ChromeOS ရှိ ဖန်သားပြင်ဖတ် အက်ပ်ဖြစ်သည့် ChromeVox ကို မျက်မမြင် (သို့) အမြင်အာရုံအားနည်းသူများက အဓိက အသုံးပြုသည်။ ChromeVox ဖွင့်ရန် နေရာခြားခလုတ်ကို နှိပ်ပါ။ ChromeVox ဖွင့်ပြီးသွားသည့်အခါ လမ်းညွှန်အကျဥ်းချုပ်တစ်ခုကို သင်လေ့လာရပါမည်။</translation>
<translation id="523505283826916779">ရယူသုံးနိုင်မှု ဆက်တင်များ</translation>
<translation id="5240931875940563122">Android ဖုန်းဖြင့် လက်မှတ်ထိုးဝင်ရန်</translation>
<translation id="5255859108402770436">နောက်တစ်ကြိမ် လက်မှတ်ထိုးဝင်ရောက်ပါ</translation>
<translation id="5260508466980570042">ဆောရီး၊ သင်၏ စကားဝှက်ကို စိစစ် မရခဲ့ပါ။ ကျေးဇူးပြုပြီး ထပ် စမ်းပါ။</translation>
<translation id="5264252276333215551">သင်၏ အက်ပ်ကို kiosk မုဒ်မှာ ဖွင့်တင်ရန် ကျေးဇူးပြုပြီး အင်တာနက်သို့ ချိတ်ဆက်ပါ။</translation>
<translation id="528208740344463258">Android အက်ပ်များကို ဒေါင်းလုဒ်လုပ်ပြီး အသုံးပြုရန် ပထမဦးစွာ ဤအပ်ဒိတ်ကို ထည့်သွင်းရန် လိုအပ်ပါမည်။ သင်၏ <ph name="DEVICE_TYPE" /> အပ်ဒိတ်လုပ်နေစဉ် ၎င်းကို အသုံးပြု၍မရနိုင်ပါ။ ထည့်သွင်းပြီးသွားလျှင် <ph name="DEVICE_TYPE" /> ကို ပြန်လည်စတင်ပါမည်။</translation>
<translation id="5283677936944177147">သည်းခံပါ။ စနစ်သည် ကိရိယာအမျိုးအစား သို့မဟုတ် စက်မှတ်ပုံတင်နံပါတ်ကို ဆုံးဖြတ်၍ မရပါ။</translation>
<translation id="5333896723098573627">အက်ပ်များကို ဖယ်ရှားရန် ‘ဆက်တင်များ’ &gt; ‘အက်ပ်များ’ &gt; Google Play Store &gt; ‘Android ရွေးချယ်ချက်များ စီမံရန်’ &gt; ‘အက်ပ်များ’ သို့မဟုတ် ‘အပလီကေးရှင်း’ မန်နေဂျာသို့ သွားပါ။ ထို့နောက် သင်ဖယ်ရှားလိုသည့် အက်ပ်ကို တို့ပါ (အက်ပ်ကို ရှာရန် ဘယ် သို့မဟုတ် ညာသို့ ပွတ်ဆွဲရနိုင်ပါသည်)။ ၎င်းနောက် ‘ဖယ်ရှားရန်’ သို့မဟုတ် ‘ပိတ်ရန်’ ကို တို့ပါ။</translation>
<translation id="5355501370336370394">လုပ်ငန်းသုံးစက်ကို စာရင်းသွင်းရန်</translation>
<translation id="5372529912055771682">သုံးနေသည့် စာရင်းပေးသွင်းရေး မုဒ်ကို လက်ရှိ လည်ပတ်မှု စနစ်၏ ဗားရှင်းမှ မပံ့ပိုးပါ။ ကျေးဇူးပြုပြီး သင်သည် နောက်ဆုံး ဗားရှင်း သုံးနေတာကို သေချာအောင် စစ်ကြည့်ပြီး ထပ်စမ်းပါ။</translation>
<translation id="5397378439569041789">kiosk (သို့) သတ်မှတ်စက်တွင် စာရင်းသွင်းပါ</translation>
<translation id="5397794290049113714">သင်</translation>
<translation id="5411022484772257615">ကျောင်းအပ်နှံမှု ပြီးမသွားပါ</translation>
<translation id="5413640305322530561">အမှားရှာဖွေမှုနှင့် သုံးစွဲမှုဒေတာအကြောင်း ပိုမိုလေ့လာရန်</translation>
<translation id="542750953150239272">ရှေ့ဆက်ခြင်းအားဖြင့် ဤစက်ပစ္စည်းသည် Google၊ သင်၏ မိုဘိုင်းဝန်ဆောင်မှုပေးသူနှင့် သင့်စက်ပစ္စည်း၏ ထုတ်လုပ်သူ တို့ထံမှနေ၍ အပ်ဒိတ်များနှင့် အက်ပ်များကို ဆယ်လူလာ ဒေတာအား အသုံးပြုပြီး အလိုအလျောက် ဒေါင်းလုဒ်လုပ်၍ ထည့်သွင်းနိုင်ခြင်းကို သဘောတူရာ ရောက်ပါသည်။ ဤအက်ပ်အချို့တွင် အက်ပ်အတွင်း ဝယ်ယူခြင်းများ ကမ်းလှမ်းနိုင်သည်။</translation>
<translation id="542948651837270806">'ယုံကြည်စိတ်ချရသည့် စနစ်မော်ဂျူး' ဖာမ်းဝဲအတွက် အပ်ဒိတ်ထည့်သွင်းရန် လိုအပ်သည်။ <ph name="TPM_FIRMWARE_UPDATE_LINK" /> ကို ကြည့်ပါ</translation>
<translation id="5448293924669608770">အူးပ်စ်၊ လက်မှတ်ထိုး ဝင်မှု ထဲမှာ တစ်ခုခု မှားသွားသည်</translation>
