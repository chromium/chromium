<translation id="1426410128494586442">Po</translation>
<translation id="1427269577154060167">Shteti</translation>
<translation id="1440090277117135316">Regjistrimi për përdorimin në shkollë përfundoi</translation>
<translation id="1473927070149284123">Provo përsëri ose lidhu me një rrjet në mënyrë manuale</translation>
<translation id="1503556098270577657">U identifikove në <ph name="USER_EMAIL" /> duke përdorur telefonin tënd Android</translation>
<translation id="1510238584712386396">Nisësi</translation>
