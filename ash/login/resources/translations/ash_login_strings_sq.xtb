<translation id="3661106764436337772">Shkruaj më shpejt dhe me më shumë vetëbesim</translation>
<translation id="3662207097851752847">Konfirmo "Llogarinë tënde të Google" në telefonin tënd</translation>
<translation id="3672681487849735243">Është zbuluar një gabim fabrike</translation>
<translation id="3673097791729989571">Identifikimi i organizuar nga <ph name="SAML_DOMAIN" /></translation>
