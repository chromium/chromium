<translation id="8428213095426709021">Ustawienia</translation>
<translation id="843173223122814223">Twórz tła za pomocą AI</translation>
<translation id="8452105022015742247">Przenoszę informacje o koncie Google z telefonu z Androidem</translation>
<translation id="8464132254133862871">To konto użytkownika nie kwalifikuje się do korzystania z tej usługi.</translation>
