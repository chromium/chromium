<translation id="8637688295594795546">עדכון מערכת זמין. המערכת מתכוננת להורדה…</translation>
<translation id="8655972064210167941">הכניסה נכשלה מפני שלא ניתן היה לאמת את הסיסמה. יש לפנות למנהל המערכת או לנסות שוב.</translation>
<translation id="8661876674803386786">‏<ph name="BEGIN_PARAGRAPH1" />אם ההגדרה "זיהוי מיקום משופר" מופעלת, המידע על אותות אלחוטיים, כמו נקודות גישה ל-Wi-Fi ואנטנות סלולריות, יחד עם נתוני חיישנים מהמכשיר, כמו מד התאוצה והג'ירוסקופ, משמשים כדי לזהות את המיקום של המכשיר בצורה יותר מדויקת. אפליקציות ושירותים של Android משתמשים במידע הזה כדי לספק תכונות מבוססות-מיקום. כדי לעשות את זה, ‏Google אוספת מדי פעם נתונים על חיישני מכשיר ואותות אלחוטיים בקרבת המכשיר כדי לתמוך במיקור המונים של מיקומי אותות אלחוטיים.<ph name="END_PARAGRAPH1" />
        ‫<ph name="BEGIN_PARAGRAPH2" />Google משתמשת בנתונים האלה בלי לזהות אותך. המטרה שלה היא לשפר את הדיוק של "זיהוי מיקום משופר" והשירותים מבוססי-המיקום, ובאופן כללי, לשפר, לספק ולתחזק את שירותי Google. אנחנו מעבדים את המידע הזה על סמך האינטרסים הלגיטימיים של Google ושל צדדים שלישיים כדי לשרת את צורכי המשתמשים.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />אפשר להשבית את ההגדרה "זיהוי מיקום משופר" בכל שלב בהגדרות המיקום של המכשיר: עוברים אל "הגדרות" &gt; "פרטיות ואבטחה" &gt; "אמצעי בקרה על פרטיות" &gt; "גישה למיקום" &gt; "הגדרות מיקום מתקדמות". אם ההגדרה "זיהוי מיקום משופר" מושבתת, לא נאספים נתונים לזיהוי מיקום משופר. באפליקציות ובשירותים של Android, מיקום המכשיר מזוהה על סמך כתובת IP בלבד, אם המידע הזה זמין. יכולה להיות לזה השפעה על הזמינות והדיוק של המיקומים באפליקציות ובשירותים של Android, כמו מפות Google.<ph name="END_PARAGRAPH3" /></translation>
<translation id="8674903726754070732">‏לצערנו, המחשב שלך מוגדר באמצעות מזהה חומרה פגום. המצב הזה מונע מ-ChromeOS להתקין את עדכוני האבטחה האחרונים, <ph name="BEGIN_BOLD" />ויכול להיות שהמחשב שלך יהיה חשוף להתקפות זדוניות<ph name="END_BOLD" />.</translation>
<translation id="8675704450909805533">מנהל ההתקנה לא מצא יעד תקין להתקנה של <ph name="DEVICE_OS" />.</translation>
<translation id="8695139659682234808">הוספה של בקרת הורים לאחר ההגדרה</translation>
<translation id="8698269656364382265">כדי לחזור למסך הקודם, מחליקים מצד ימין.</translation>
<translation id="8718994464069323380">זוהה מסך מגע</translation>
<translation id="8725066075913043281">ניסיון חוזר</translation>
<translation id="8726206820263995930">אירעה שגיאה בעת הבאת הגדרות מדיניות מהשרת: <ph name="CLIENT_ERROR" />.</translation>
<translation id="8730621377337864115">בוצע</translation>
<translation id="8740086188450289493">‏שימוש בסיסמה לחשבון Google</translation>
<translation id="8740247629089392745">‏אפשר להעביר את ה-Chromebook הזה אל <ph name="SUPERVISED_USER_NAME" />. ההתקנה כמעט הסתיימה. מיד ניתן יהיה לחקור ולהתנסות.</translation>
<translation id="8759753423332885148">למידע נוסף</translation>
<translation id="8762886931014513155">צריך לעדכן את ה-<ph name="DEVICE_TYPE" /></translation>
<translation id="8777628254805677039">‏סיסמת root</translation>
<translation id="877985182522063539">A4</translation>
<translation id="8783834180813871000">‏עליך להקליד את קוד ההתאמה ל-Bluetooth ולאחר מכן ללחוץ על Return או Enter.</translation>
<translation id="8794548468611058947">‏במקום להזין את הסיסמה לחשבון Google כדי להיכנס, אפשר ליצור קוד אימות למכשיר <ph name="DEVICE_TYPE" /> הזה</translation>
<translation id="8830779999439981481">מתבצעת הפעלה מחדש להחלת העדכונים</translation>
<translation id="8830796635868321089">‏בדיקת העדכון נכשלה עם ההגדרות הנוכחיות של שרת ה-proxy‏. יש להתאים את <ph name="PROXY_SETTINGS_LINK_START" />הגדרות שרת ה-proxy שלך<ph name="PROXY_SETTINGS_LINK_END" />.</translation>
<translation id="8855977033756560989">‏מכשיר Chromebook Enterprise הזה מגיע עם שדרוג ל-Chrome Enterprise כחלק מהחבילה. כדי ליהנות מהיכולות הארגוניות של המכשיר, מומלץ לרשום אותו עם חשבון אדמין של Google.</translation>
<translation id="885746075120788020">‏הפעילות וההעדפות השמורות שלך יהיו מוכנות בכל מכשיר ChromeOS לאחר הכניסה באמצעות חשבון Google. יש לך אפשרות לבחור מה לסנכרן בהגדרות.</translation>
<translation id="8868333925931032127">מתבצעת הפעלה של מצב הדגמה</translation>
<translation id="8875221558267407626">מסכמים תכנים, מפשטים שפה מורכבת או שואלים שאלות</translation>
<translation id="8907701755790961703">בחר ארץ</translation>
<translation id="8913163265790894442">‏קל להגדיר את ה-<ph name="DEVICE_TYPE" /> באמצעות הטלפון. אפשר להוסיף את ה-Wi-Fi ואת החשבון שלך ב-Google, גם בלי להקליד את הסיסמאות.
        <ph name="BR" />
        <ph name="BR" />
        גלוי בתור <ph name="DEVICE_TYPE" />...</translation>
<translation id="8934732568177537184">המשך</translation>
<translation id="8946359700442089734">תכונות לניפוי באגים לא הופעלו באופן מלא במכשיר <ph name="IDS_SHORT_PRODUCT_NAME" /> זה.</translation>
<translation id="8965037249707889821">יש להזין את הסיסמה הישנה</translation>
<translation id="8968906873893164556">בחירת החשבון שישמש להגדרה</translation>
<translation id="8973596347849323817">ניתן להתאים אישית את המכשיר הזה כדי שיתאים לצרכיך. ניתן לשנות את תכונות הנגישות מאוחר יותר ב'הגדרות'.</translation>
<translation id="8975396729541388937">ניתן לבטל את ההרשמה בכל שלב בלחיצה על הקישור בהודעות האימייל שמקבלים.</translation>
<translation id="8987305927843254629">כל משתמש יכול להתאים אישית את חוויית המשתמש שלו ולהגן על פרטיות הנתונים.</translation>
<translation id="8993059306046735527">‏אם שכחת את הסיסמה של <ph name="DEVICE_TYPE" />, עדיין אפשר לשחזר את הנתונים המקומיים. עליך להיכנס לחשבון Google או להשתמש בתכונת שחזור החשבון.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="9033765790910064284">אני רוצה להמשיך בכל זאת</translation>
<translation id="903480517321259405">יש להקליד שוב את קוד האימות</translation>
<translation id="9040473193163777637">‏רוצה להפעיל את ChromeVox, קורא המסך המובנה של ChromeOS? אם כן, יש ללחוץ לחיצה ארוכה על 2 הלחצנים של עוצמת הקול למשך 5 שניות.</translation>
<translation id="9068298336633421551">‏מומלץ לאפשר לאפליקציות ולשירותים של Android עם הרשאת מיקום להשתמש במיקום של המכשיר שלך. Google עשויה לאסוף נתוני מיקום מדי פעם ולהשתמש בנתונים האלה בצורה אנונימית כדי לשפר את הדיוק של המיקום ואת האיכות של השירותים מבוססי-המיקום</translation>
<translation id="9074836595010225693">‏עכבר USB מחובר</translation>
<translation id="9076523132036239772">מצטערים, לא ניתן לאמת את האימייל או הסיסמה שלך. יש לנסות תחילה להתחבר לרשת.</translation>
<translation id="9089959054554410481">שינוי כיוון הגלילה של לוח המגע</translation>
<translation id="9158715103698450907">אופס! אירעה בעיה של תקשורת רשת במהלך האימות. יש לבדוק את חיבור הרשת ולנסות שוב.</translation>
<translation id="9186963452600581158">‏כניסה באמצעות חשבון Google של ילד או ילדה</translation>
<translation id="919686179725692564">מידע נוסף על גיבוי האפליקציות שלך</translation>
<translation id="9214520840402538427">אופס! תם הזמן הקצוב לאתחול של מאפייני זמן ההתקנה. יש לפנות אל נציג התמיכה שלך.</translation>
<translation id="9217002308921247002">‏<ph name="BEGIN_PARAGRAPH1" />בלעדי ל-<ph name="DEVICE_TYPE" />.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ה-AI הגנרטיבי הוא ניסיוני, ונמצא בשלבי פיתוח ראשוניים. כרגע הזמינות שלו מוגבלת.<ph name="END_PARAGRAPH2" /></translation>
<translation id="936479314588646618">‏קל להגדיר את ה-<ph name="DEVICE_TYPE" /> באמצעות הטלפון. עליך פשוט להוסיף את החשבון שלך ב-Google, אפילו בלי להקליד את הסיסמה.
        <ph name="BR" />
        <ph name="BR" />
        גלוי בתור <ph name="DEVICE_TYPE" />...</translation>
<translation id="945522503751344254"> שליחת משוב</translation>
<translation id="951991426597076286">דחייה</translation>
<translation id="954749761428814584">השפה ושיטת הקלט</translation>
<translation id="960987915827980018">נותרה בערך שעה אחת</translation>
<translation id="995420352808264005">בחירת סוג שיוך המכשיר לארגון</translation>
</translationbundle>