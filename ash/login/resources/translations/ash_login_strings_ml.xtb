<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1005333234656240382">ADB ഡീബഗ് ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കണോ?</translation>
<translation id="1053898984916097744">പുതുതായി എന്തെങ്കിലും ആരംഭിക്കുക അല്ലെങ്കിൽ ഫ്ലോയുമായി ബന്ധപ്പെട്ട് സഹായം നേടുക.</translation>
<translation id="1061130374843955397">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഉപകരണത്തിലേക്ക് സ്വാഗതം</translation>
<translation id="1069778954840159202">Android ഫോണിൽ നിന്ന് സ്വയമേവ നിരക്ക് നേടുക</translation>
<translation id="1076766328672150609">നിങ്ങളുടെ കുട്ടിക്ക് ഒരു പിൻ ഉപയോഗിച്ച് ഈ ഉപകരണം അൺലോക്ക് ചെയ്യാനാകും.</translation>
<translation id="1091767800771861448">ഒഴിവാക്കുന്നതിനായി ESCAPE അമർത്തുക (അനൗദ്യോഗിക നിർമ്മിതകൾക്ക് മാത്രം).</translation>
<translation id="1097658378307015415">സൈൻ ഇൻ ചെയ്യുന്നതിന് മുമ്പ്, <ph name="NETWORK_ID" /> സജീവമാക്കാൻ അതിഥിയായി പ്രവേശിക്കുക</translation>
<translation id="1111932478203988717">നിങ്ങളുടെ കുട്ടിക്ക് അവരുടെ ഉപകരണത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഈ പിൻ ഉപയോഗിക്കാം</translation>
<translation id="1122587596907914265">തനതായ വാൾപേപ്പറുകൾ രൂപകൽപ്പന ചെയ്യുക</translation>
<translation id="1131201598497838573">നിങ്ങളുടെ കുട്ടിയുടെ പിൻ അപ്‌ഡേറ്റ് ചെയ്തു</translation>
<translation id="1147322039136785890">ഇനി <ph name="SUPERVISED_USER_NAME" />' എന്ന കുട്ടിയുടെ ഊഴമാണ്</translation>
<translation id="1148669835763563782">മെച്ചപ്പെടുത്തിയ സുരക്ഷയ്ക്കും പുതിയ Chromebook ഫീച്ചറുകൾക്കുമായി നിങ്ങൾക്ക് ഏറ്റവും പുതിയ സോഫ്റ്റ്‌വെയർ അപ്‌ഡേറ്റ് ലഭിക്കുന്നു. നിങ്ങളുടെ Chromebook-ൽ സുഗമമായ തുടക്കം ലഭിക്കാൻ സഹായിക്കുന്നതിന് ഈ അപ്ഡേറ്റിൽ മെച്ചപ്പെടുത്തിയ സജ്ജീകരണ അനുഭവം ഉൾപ്പെടുന്നു.</translation>
<translation id="1176864681932214421">AI ഉപയോഗിച്ച് ചിത്രങ്ങൾ സൃഷ്‌ടിക്കുക</translation>
<translation id="1177073277575830464">Android-ന്റെ ദ്രുത സജ്ജീകരണം പൂർത്തിയായി. നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിൽ സജ്ജീകരിക്കുന്നത് തുടരുക.</translation>
<translation id="1179902906564467236">നിങ്ങളുടെ ഫോണിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക അല്ലെങ്കിൽ ക്യാമറാ ആപ്പ് ഉപയോഗിക്കുക</translation>
<translation id="1185924365081634987">ഈ നെറ്റ്‌വർക്ക് പിശക് പരിഹരിക്കാൻ നിങ്ങൾക്ക് <ph name="GUEST_SIGNIN_LINK_START" />അതിഥിയായി ബ്രൗസ് ചെയ്യുന്നതിന്<ph name="GUEST_SIGNIN_LINK_END" /> പരീക്ഷിക്കാം.</translation>
<translation id="1191353342579061195">നിങ്ങളുടെ ആവശ്യങ്ങൾക്ക് അനുയോജ്യമായ തീം തിരഞ്ഞെടുക്കുക. നിങ്ങളുടെ തീമും വാൾപേപ്പറും സ്ക്രീൻ സേവറും മറ്റും മാറ്റാൻ ഡെസ്‌ക്ടോപ്പിൽ വലത്-ക്ലിക്ക് ചെയ്യൂ.</translation>
<translation id="1201402288615127009">അടുത്തത്</translation>
<translation id="1217114730239853757">ChromeOS Flex-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ? അങ്ങനെയെങ്കിൽ, സ്പെയ്‌സ് ബാർ അമർത്തുക.</translation>
<translation id="1222835797152767346">സൈൻ ഇൻ ചെയ്യുന്നത് എളുപ്പമാക്കാൻ ഒരു പിൻ സജ്ജീകരിക്കുക</translation>
<translation id="1231426483209637778">അടുത്ത തവണ നിങ്ങൾ <ph name="DEVICE_TYPE" /> ഉപയോഗിക്കുമ്പോൾ നിങ്ങളുടെ നെറ്റ്‌വർക്ക് ഏതാണെന്ന് ഞങ്ങൾ ഓർക്കും</translation>
<translation id="1243002225871118300">ഡിസ്പ്ലേ, ടെക്സ്റ്റ് വലുപ്പം മാറ്റുക</translation>
<translation id="1256588359404100567">നിങ്ങളുടെ മുമ്പത്തെ ഉപകരണത്തിൽ നിന്ന് ക്രമീകരണം സമന്വയിപ്പിച്ചു.</translation>
<translation id="1272978324304772054">ഈ ഉപയോക്തൃ അക്കൗണ്ട്, ഉപകരണം ചേർത്തിരിക്കുന്ന ഡൊമെയ്‌നിന്റെ ഭാഗമല്ല.  നിങ്ങൾക്ക് മറ്റൊരു ഡൊമെയ്ൻ ചേർക്കണമെങ്കിൽ, ആദ്യം ഉപകരണം വീണ്ടെടുക്കുന്നതിലേക്ക് പോകേണ്ടതുണ്ട്.</translation>
<translation id="1293556467332435079">Files</translation>
<translation id="1307559529304613120">ക്ഷമിക്കണം!  ഈ ഉപകരണത്തിനായി ദീർഘകാല API ആക്‌സസ് ടോക്കൺ സംഭരിക്കുന്നതിൽ സിസ്റ്റം പരാജയപ്പെട്ടു.</translation>
<translation id="1335929031622236846">നിങ്ങളുടെ ഉപകരണം എൻറോൾ ചെയ്യുക</translation>
<translation id="1346669614038013595"><ph name="BEGIN_H3" />ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ<ph name="END_H3" />
          <ph name="BR" />
          നിങ്ങളുടെ ഉപകരണത്തിൽ ഇഷ്ടാനുസൃത കോഡ് ഇൻസ്റ്റാൾ ചെയ്യാനും പരീക്ഷിക്കാനും നിങ്ങളുടെ ChromeOS ഉപകരണത്തിലെ ഡീബഗ് ചെയ്യൽ ഫീച്ചർ പ്രവർത്തനക്ഷമമാക്കാം. ഇത് ഇനിപ്പറയുന്ന കാര്യങ്ങൾ ചെയ്യാൻ നിങ്ങളെ അനുവദിക്കുന്നു:<ph name="BR" />
          <ph name="BEGIN_LIST" />
            <ph name="LIST_ITEM" />OS ഫയലുകൾ പരിഷ്കരിക്കാനാകുന്നതിന് rootfs പരിശോധിച്ചുറപ്പിക്കൽ നീക്കം ചെയ്യാൻ
            <ph name="LIST_ITEM" />ഉപകരണം ആക്‌സസ് ചെയ്യാൻ <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> പോലുള്ള ടൂളുകൾ ഉപയോഗിക്കാനാകുന്നതിന് സാധാരണ പരീക്ഷണ കീകൾ ഉപയോഗിച്ച് ഉപകരണത്തിലേക്ക് SSH ആക്‌സസ് അനുവദിക്കാൻ
          <ph name="LIST_ITEM" />USB ഡ്രൈവിൽ നിന്ന് OS ചിത്രം ഇൻസ്റ്റാൾ ചെയ്യാനാകുന്നതിന് USB-യിൽ നിന്ന് ബൂട്ട് ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കാൻ
            <ph name="LIST_ITEM" />ഉപകരണത്തിലേക്ക് നേരിട്ട് SSH ചെയ്യാൻ dev, സിസ്റ്റം റൂട്ട് ലോഗിൻ പാസ്‌വേഡുകൾ ഇഷ്ടാനുസൃത മൂല്യത്തിലേക്ക് സജ്ജീകരിക്കാൻ
          <ph name="END_LIST" />
          <ph name="BR" />
          പ്രവർത്തനക്ഷമമാക്കിയ ശേഷം, എന്റർപ്രൈസ് മാനേജ് ചെയ്യുന്ന ഉപകരണത്തിലെ വിവരങ്ങൾ പവർവാഷ് ചെയ്യുകയോ ഡാറ്റ മായ്ക്കുകയോ ചെയ്തതിന് ശേഷവും മിക്ക ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളും പ്രവർത്തനക്ഷമമായി തുടരും. എല്ലാ ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളും പൂർണ്ണമായും പ്രവർത്തനരഹിതമാക്കാൻ, ChromeOS വീണ്ടെടുക്കൽ പ്രക്രിയ പൂർത്തിയാക്കുക (https://support.google.com/chromebook/answer/1080595).
          <ph name="BR" />
          <ph name="BR" />
          ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളെ കുറിച്ചുള്ള കൂടുതൽ വിവരങ്ങൾക്ക് ഇത് കാണുക:<ph name="BR" />
          https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
          <ph name="BR" />
          <ph name="BR" />
          <ph name="BEGIN_BOLD" />ശ്രദ്ധിക്കുക:<ph name="END_BOLD" />  പ്രോസസിനിടെ സിസ്റ്റം റീബൂട്ട് ചെയ്യും.</translation>
<translation id="1347625331607114917">നിങ്ങളുടെ Android ഫോണിൽ കോഡ് പരിശോധിച്ചുറപ്പിക്കുക</translation>
<translation id="1347975661240122359">ബാറ്ററി ചാർജ് <ph name="BATTERY_LEVEL" /> ശതമാനമാകുമ്പോൾ അപ്‌ഡേറ്റ് ആരംഭിക്കും.</translation>
<translation id="1353275871123211385">ആപ്പ് അനുമതി, സ്ക്രീൻ സമയ പരിധികൾ എന്നിവ പോലുള്ള രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ഉപയോഗിക്കാൻ, രക്ഷിതാവ് മാനേജ് ചെയ്യുന്ന ഒരു Google Account കുട്ടിക്ക് ഉണ്ടായിരിക്കണം. Google Classroom പോലുള്ള ടൂളുകൾക്ക് ഒരു സ്‌കൂൾ അക്കൗണ്ട് പിന്നീട് ചേർക്കാനാകും.</translation>
<translation id="1375557162880614858">ChromeOS Flex-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ?</translation>
<translation id="1375938286942050085">സജ്ജീകരണം പൂർത്തിയായി! അടുത്ത്, നിങ്ങളുടെ ഉപകരണം ഗെയിമിംഗിനായി സജ്ജീകരിക്കൂ</translation>
<translation id="1377600615067678409">ഇപ്പോഴത്തേക്ക് ഒഴിവാക്കുക</translation>
<translation id="1399261165075500043">Google Play സേവന നിബന്ധനകൾ ലോഡ് ചെയ്യാനാകുന്നില്ല</translation>
<translation id="1400243387594338234">നിങ്ങളുടെ ഉപകരണത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഈ പിൻ ഉപയോഗിക്കാം</translation>
<translation id="1406500794671479665">സ്ഥിരീകരിക്കുന്നു...</translation>
<translation id="1407069428457324124">ഡാർക്ക് തീം</translation>
<translation id="1417497355604638350">ഡയഗ്‌നോസ്‌റ്റിക്‌സ്, ഉപയോഗ ഡാറ്റ അയയ്ക്കുക.</translation>
<translation id="1418882096915998312">എന്റർപ്രൈസ് എൻറോൾമെന്റ് പുരോഗതിയിലാണ്</translation>
<translation id="1426410128494586442">അതെ</translation>
<translation id="1427269577154060167">രാജ്യം</translation>
<translation id="1440090277117135316">സ്‌കൂൾ എൻറോൾമെന്റ് പൂർത്തിയായി</translation>
<translation id="1473927070149284123">വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ ഒരു നെറ്റ്‌വർക്കിലേക്ക് നേരിട്ട് കണക്‌റ്റ് ചെയ്യുക</translation>
<translation id="1503556098270577657">Android ഫോൺ ഉപയോഗിച്ച് <ph name="USER_EMAIL" /> എന്ന വിലാസത്തിലേക്ക് നിങ്ങൾ സൈൻ ഇൻ ചെയ്തു</translation>
<translation id="1510238584712386396">ലോഞ്ചർ</translation>
<translation id="1521442365706402292">സര്‍ട്ടിഫിക്കറ്റുകള്‍ മാനേജ് ചെയ്യുക</translation>
<translation id="15373452373711364">വലിയ മൗസ് കഴ്‌സർ</translation>
<translation id="1540605929960647700">ഡെമോ മോഡ് പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="1572876035008611720">നിങ്ങളുടെ ഇമെയിൽ നൽകുക</translation>
<translation id="1588438908519853928">സാധാരണം</translation>
<translation id="1620510694547887537">ക്യാമറ</translation>
<translation id="1636212173818785548">ശരി</translation>
<translation id="1642494467033190216">മറ്റ് ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പ്രവർത്തനക്ഷമമാക്കുന്നതിന് മുമ്പ് റൂട്‌സ് പരിരക്ഷയുടെ നീക്കം ചെയ്യലും പുനഃരാരംഭിക്കലും ആവശ്യമാണ്.</translation>
<translation id="1646045728251578877">സോഫ്റ്റ്‌വെയർ അപ്ഡേറ്റ് ലഭ്യമാണ്</translation>
<translation id="1650801028905250434">'എന്റെ ഡ്രൈവ്' എന്നതിലെ ഫയലുകൾ നിങ്ങളുടെ Chromebook-ലേക്ക് സ്വയമേവ സമന്വയിപ്പിക്കും, അതുവഴി ഇന്റർനെറ്റ് കണക്ഷനില്ലാതെ തന്നെ നിങ്ങൾക്ക് അവ ആക്‌സസ് ചെയ്യാനാകും. ക്രമീകരണം &gt; Files എന്നതിൽ ഏതുസമയത്തും നിങ്ങൾക്കിത് മാറ്റാം.</translation>
<translation id="1668435968811469751">നേരിട്ട് എൻറോൾ ചെയ്യുക</translation>
<translation id="1678919064276516737">നിങ്ങൾ നൽകിയ ഇമെയിലും പിൻ നമ്പറും പൊരുത്തപ്പെടുന്നില്ല</translation>
<translation id="1692115862433274081">മറ്റൊരു അക്കൗണ്ട് ഉപയോഗിക്കുക</translation>
<translation id="1695487653372841667">Google-മായി എന്ത് ഡാറ്റയാണ് പങ്കിടുന്നതെന്ന് നിങ്ങൾക്ക് നിയന്ത്രിക്കാനാകും. ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഇത് മാറ്റാം.</translation>
<translation id="169675691788639886">ഉപകരണത്തിൽ SSH സെർവർ കോൺഫിഗർ ചെയ്തിരിക്കുന്നു. സൂക്ഷ്‌മമായി കൈകാര്യം ചെയ്യേണ്ട അക്കൗണ്ടുകൾ ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യരുത്.</translation>
<translation id="1700517974991662022">സന്ദർശിച്ചു</translation>
<translation id="1730666151302379551">പഴയ പാസ്‌വേഡ് മറന്നു</translation>
<translation id="1741314857973421784">തുടരുക</translation>
<translation id="1749645492410897998">സോഫ്റ്റ്‌വെയർ ഇൻസ്റ്റാൾ ചെയ്യുന്നു</translation>
<translation id="177053719077591686">Android ആപ്പുകൾ Google Drive-ലേക്ക് ബാക്കപ്പെടുക്കുക.</translation>
<translation id="1798832846931769717">Meet-നുള്ള Google Beam</translation>
<translation id="1806335016774576568">തുറന്നിരിക്കുന്ന മറ്റൊരു ആപ്പിലേക്ക് മാറുക</translation>
<translation id="1826192255355608658">നിങ്ങളുടെ Chrome ബ്രൗസർ ബുക്ക്‌മാർക്കുകളും പാസ്‌വേഡുകളും ചരിത്രവും മറ്റും സമന്വയിപ്പിക്കുക</translation>
<translation id="1826657447823925402">വിപരീതക്രമത്തിൽ സ്‌ക്രോൾ ചെയ്യൽ പ്രവർത്തനരഹിതമാക്കി</translation>
<translation id="1831848493690504725">കണക്റ്റ് ചെയ്‌ത നെറ്റ്‌വർക്കിലൂടെ ഞങ്ങൾക്ക് Google-ലേക്ക് എത്തിച്ചേരാനാകുന്നില്ല. മറ്റൊരു നെറ്റ്‌വർക്ക് തിരഞ്ഞെടുക്കാനോ നിങ്ങളുടെ നെറ്റ്‌വർക്ക് ക്രമീകരണമോ പ്രോക്‌സി ക്രമീകരണമോ പരിശോധിക്കാനോ ശ്രമിക്കുക (നിങ്ങൾ ഒരു പ്രോക്‌സിയാണ് ഉപയോഗിക്കുന്നതെങ്കിൽ).</translation>
<translation id="1842766183094193446">ഡൊമോ മോഡ് പ്രവർത്തനക്ഷമമാക്കണമെന്ന് ഉറപ്പാണോ?</translation>
<translation id="1845060436536902492">സംഭാഷണ സിന്തസൈസർ അല്ലെങ്കിൽ ബ്രെയ്‌ലി ഡിസ്‌പ്ലേയുടെ സഹായത്തോടെ സ്ക്രീനിൽ കാണിക്കുന്ന ടെക്‌സ്റ്റ് വായിക്കാൻ അന്ധതയോ കാഴ്ചക്കുറവോ ഉള്ള ആളുകളാണ് ChromeOS Flex, ChromeVox എന്നിവയിലെ സ്ക്രീൻ പ്രധാനമായും റീഡർ ഉപയോഗിക്കുന്നത്. ChromeVox ഓണാക്കാൻ സ്പേസ് ബാർ അമർത്തുക. ChromeVox സജീവമായിക്കഴിഞ്ഞാൽ, ദ്രുത ടൂർ വഴി നിങ്ങൾക്ക് അതേക്കുറിച്ച് അറിയാനാകും.</translation>
<translation id="185766080319917408">ഇടത് Alt കീയുടെ ഇടതുവശത്താണ് ലോഞ്ചർ കീ സ്ഥിതി ചെയ്യുന്നത്</translation>
<translation id="1868617395637139709">Android ആപ്പുകൾക്കും സേവനങ്ങൾക്കും ലൊക്കേഷൻ ഉപയോഗിക്കുക.</translation>
<translation id="1877377730633446520">ഇത് ഏതാണ്ട് <ph name="REQUIRED_SPACE" /> ഉപയോഗിക്കും. നിലവിൽ നിങ്ങൾക്ക് <ph name="FREE_SPACE" /> ലഭ്യമാണ്.</translation>
<translation id="1878155070920054810">അപ്‌ഡേറ്റ് പൂർത്തിയാകുന്നതിന് മുമ്പ് നിങ്ങളുടെ Chromebook-ലെ ചാർജ് തീരുമെന്ന് തോന്നുന്നു. തടസ്സം ഒഴിവാക്കുന്നതിന്, അത് ശരിയായി ചാർജ് ചെയ്യുന്നുണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="189035593835762169">നിബന്ധനകളും വ്യവസ്ഥകളും</translation>
<translation id="189358972401248634">മറ്റ് ഭാഷകൾ</translation>
<translation id="1915734383465415025">സ്‌റ്റോറിന്റെ നമ്പർ</translation>
<translation id="1919096511823372013">ലിങ്കുകളും ഇമോജികളും മറ്റും ചേർക്കൂ. Google AI ഉപയോഗിച്ച് എഴുതാനും ചിത്രങ്ങൾ സൃഷ്ടിക്കാനുമുള്ള സഹായവും നിങ്ങൾക്ക് ലഭിക്കും.</translation>
<translation id="1922496389170590548">കുട്ടിയുടെ സ്കൂൾ അക്കൗണ്ട്</translation>
<translation id="1931410639376954712"><ph name="DEVICE_OS" /> ഇൻസ്റ്റാൾ ചെയ്യുന്നു</translation>
<translation id="1944528062465413897">Bluetooth ജോടിയാക്കൽ കോഡ്:</translation>
<translation id="1987574314042117472">ജനപ്രിയ ആപ്പുകൾ തിരഞ്ഞെടുത്ത് ഇൻസ്റ്റാൾ ചെയ്യുക</translation>
<translation id="1991829061375381344">ഈ Google Meet ഹാർഡ്‌വെയർ ഉപകരണം എൻറോൾ ചെയ്യാൻ ആവശ്യമായ ലൈസൻസുകൾ നിങ്ങൾക്ക് ഇല്ല. കൂടുതൽ ലൈസൻസുകൾ വാങ്ങാൻ നിങ്ങളുടെ റീസെല്ലറെ ബന്ധപ്പെടുക. പിശക് കാരണമാണ് ഈ സന്ദേശം കാണുന്നതെന്ന് നിങ്ങൾ കരുതുന്നുവെങ്കിൽ, നിങ്ങളുടെ റീസെല്ലറെ ബന്ധപ്പെടുക.</translation>
<translation id="200928901437634269">നിങ്ങളുടെ കുട്ടിയുടെ Google Account അല്ലെങ്കിൽ ഒരു സ്കൂൾ അക്കൗണ്ട് ഉപയോഗിക്കുക. നിങ്ങൾക്ക് രക്ഷാകർതൃ നിയന്ത്രണങ്ങളും സജ്ജീകരിക്കാം.</translation>
<translation id="2013550551806600826">ഇത് പരീക്ഷിച്ചുനോക്കൂ. ക്രമീകരണം ഓണാക്കുകയോ ഓഫാക്കുകയോ ചെയ്യുക, തുടർന്ന് പരീക്ഷണ ഏരിയയിലെ ടച്ച്പാഡിൽ രണ്ട് വിരലുകൾ ഉപയോഗിച്ച് സ്ക്രോൾ ചെയ്യുക. നിങ്ങൾക്ക് ഇത് പിന്നീട് ക്രമീകരണം &gt; ഉപകരണം &gt; മൗസും ടച്ച്പാഡും എന്നതിൽ കണ്ടെത്തുകയും ചെയ്യാം.</translation>
<translation id="2016574333161572915">നിങ്ങളുടെ Google Meet ഹാർഡ്‌വെയർ സജ്ജീകരിക്കാൻ തയ്യാറാണ്</translation>
<translation id="2018189721942291407">എൻറോൾ ചെയ്യണോ എന്ന് ഉറപ്പില്ലേ?</translation>
<translation id="2040460856718599782">ക്ഷമിക്കണം! നിങ്ങളെ പ്രാമാണീകരിക്കാന്‍ ശ്രമിക്കുമ്പോൾ എന്തോ കുഴപ്പം സംഭവിച്ചു. നിങ്ങളുടെ സൈൻ ഇൻ ക്രെഡൻഷ്യലുകൾ രണ്ടുതവണ പരിശോധിച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="2052572566310583903">നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിൽ ഇൻസ്‌റ്റാൾ ചെയ്‌തു</translation>
<translation id="2088092308059522196">നിങ്ങൾ <ph name="DEVICE_OS" /> ഇൻസ്റ്റാൾ ചെയ്ത ശേഷം മാത്രമേ എൻറോൾ ചെയ്യൽ പിന്തുണയ്ക്കൂ.</translation>
<translation id="208928984520943006">ഏതുസമയത്തും നിങ്ങളുടെ ഹോം സ്ക്രീനിലേക്ക് പോകാൻ താഴെ നിന്ന് മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക.</translation>
<translation id="2090165459409185032">അക്കൗണ്ട് വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, ഇതിലേക്ക് പോകുക: google.com/accounts/recovery</translation>
<translation id="2133775869826239001">സജ്ജീകരിക്കാൻ കൂടുതൽ ഫീച്ചറുകൾ തിരഞ്ഞെടുക്കുക</translation>
<translation id="2135456203358955318">ഡോക്ക് ചെയ്‌ത മാഗ്‌നിഫയർ</translation>
<translation id="2157779167749714207">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഉപകരണത്തിനൊപ്പം Gemini-യും ലഭിക്കും</translation>
<translation id="2163470535490402084"><ph name="DEVICE_TYPE" /> ഉപകരണത്തിൽ സൈൻ ഇൻ ചെയ്യാൻ ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യുക.</translation>
<translation id="2173801458090845390">ഈ ഉപകരണത്തിൽ അഭ്യർത്ഥന ഐഡി ചേർക്കുക</translation>
<translation id="2178585470774851578">sshd daemon സജ്ജീകരിക്കുന്നതും USB ഡ്രൈവുകളിൽ നിന്ന് ബൂട്ടിംഗ് പ്രവർത്തനക്ഷമമാക്കുന്നതുമായ ChromeOS Flex ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ നിങ്ങൾ പ്രവർത്തനക്ഷമമാക്കുകയാണ്.</translation>
<translation id="2183570493397356669">'തുടരുക' ബട്ടൺ പ്രവർത്തനരഹിതമാക്കി</translation>
<translation id="2210462644007531147">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയാക്കാനായില്ല</translation>
<translation id="221872881068107022">വിപരീതക്രമത്തിൽ സ്‌ക്രോൾ ചെയ്യൽ</translation>
<translation id="2219081237089444028">സൈൻ ഇൻ ചെയ്യുന്നത് എളുപ്പമാക്കാൻ ഒരു <ph name="DEVICE_TYPE" /> പാസ്‌വേഡ് സജ്ജീകരിക്കുക</translation>
<translation id="222115440608612541">സൂര്യോദയത്തിലും സൂര്യാസ്തമയത്തിലും തീമുകൾ മാറ്റുന്നു</translation>
<translation id="2229161054156947610">1 മണിക്കൂറിൽ കൂടുതൽ ശേഷിക്കുന്നു</translation>
<translation id="2246129643805925002">പുത്തൻ ഫീച്ചറുകളും സുരക്ഷാ മെച്ചപ്പെടുത്തലുകളും നിങ്ങൾക്ക് ലഭ്യമാക്കാൻ, നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> പശ്ചാത്തലത്തിൽ സ്വയമേവ അപ്ഡേറ്റ് ചെയ്യുന്നു. അപ്ഡേറ്റ് മുൻഗണനകൾ നിങ്ങൾക്ക് ക്രമീകരണത്തിൽ അവലോകനം ചെയ്യാം.</translation>
<translation id="2274840746523584236">നിങ്ങളുടെ Chromebook ചാർജ് ചെയ്യുക</translation>
<translation id="2296022312651137376"><ph name="EMAIL" /> -ലേക്ക് സൈൻ ഇൻ ചെയ്യുമ്പോൾ, <ph name="DOMAIN_NAME" /> -ന് ഉപകരണം ഓൺലൈനായിരിക്കേണ്ടതുണ്ട്</translation>
<translation id="2317842250900878657"><ph name="PROGRESS_PERCENT" />% പൂർത്തിയായി</translation>
<translation id="2319072477089403627">നിങ്ങളുടെ Android ഫോണിലേക്ക് കണക്റ്റ് ചെയ്യുന്നു...</translation>
<translation id="2328137272841210255">നിങ്ങളുടെ പിൻ റീസെറ്റ് ചെയ്യുക</translation>
<translation id="2342180549977909852">ഈ ഉപകരണം അൺലോക്ക് ചെയ്യാൻ നിങ്ങളുടെ കുട്ടിക്ക് പാസ്‌വേഡിന് പകരം ഒരു നമ്പർ (പിൻ) ഉപയോഗിക്കാം. പിന്നീട് പിൻ സജ്ജീകരിക്കാൻ, ക്രമീകരണത്തിലേക്ക് പോവുക.</translation>
<translation id="2359808026110333948">തുടരുക</translation>
<translation id="2387052489799050037">ഹോമിലേക്ക് പോവുക</translation>
<translation id="2395616325548404795">എന്റർപ്രൈസ് മാനേജ്‌മെന്റിന് വേണ്ടി നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എൻറോൾ ചെയ്‌തെങ്കിലും അതിന്റെ അസറ്റും ലൊക്കേഷൻ വിവരങ്ങളും അയയ്‌ക്കാനായില്ല. ഈ ഉപകരണത്തിനുവേണ്ടി നിങ്ങളുടെ അഡ്‍മിൻ കൺസോളിൽ നിന്ന് ഈ വിവരങ്ങൾ നേരിട്ട് നൽകുക.</translation>
<translation id="2408955596600435184">നിങ്ങളുടെ പിൻ നൽകുക</translation>
<translation id="2418307627282545839">തെളിച്ചവും വ്യക്തതയും നിലനിർത്തുന്നു</translation>
<translation id="243179355394256322">ഉപകരണ എൻറോൾമെന്റ് നടത്താൻ അംഗീകൃത ഉപയോക്താക്കളെ മാത്രമേ നിങ്ങളുടെ സ്ഥാപനം അനുവദിക്കുന്നുള്ളൂ. ഉപകരണങ്ങൾ എൻറോൾ ചെയ്യാൻ ഈ ഉപയോക്താവിന് അംഗീകാരമില്ല. അഡ്‌മിൻ കൺസോളിലെ ഉപയോക്താക്കൾ വിഭാഗത്തിൽ ഉപയോക്താവിന് "Google Meet ഹാർഡ്‍വെയർ എൻറോൾ ചെയ്യുക" എന്ന പ്രത്യേക അഡ്മിൻ അവകാശം ഉണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="2439152382014731627"><ph name="DEVICE_TYPE" /> പാസ്‌വേഡ് റീസെറ്റ് ചെയ്യൂ</translation>
<translation id="2450223707519584812">Google API കീകൾ നഷ്‌ടമായതിനാൽ നിങ്ങൾക്ക് ഉപയോക്താക്കളെ ചേർക്കാനാവില്ല. വിശദാംശങ്ങൾക്ക്, <ph name="DETAILS_URL" /> കാണുക.</translation>
<translation id="24786041351753425">ഡാറ്റ വീണ്ടെടുക്കൽ സേവനം പ്രവർത്തനക്ഷമമാക്കുക.</translation>
<translation id="2485681265915754872">Google Play സേവന നിബന്ധനകൾ</translation>
<translation id="248676429071089168">പേജ് താഴേക്ക് നീക്കാൻ മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്യുക</translation>
<translation id="2501278716633472235">പിന്നോട്ട് പോകുക</translation>
<translation id="252418934079508528"><ph name="DEVICE_OS" /> ഇൻസ്‌റ്റാൾ ചെയ്യുക</translation>
<translation id="2538084450874617176"><ph name="DEVICE_TYPE" /> ആരാണ് ഉപയോഗിക്കുന്നത്?</translation>
<translation id="2553340429761841190"><ph name="PRODUCT_NAME" /> ന് <ph name="NETWORK_ID" /> ലേയ്ക്ക് ബന്ധിപ്പിക്കാന്‍ കഴിയുന്നില്ല. ദയവായി മറ്റൊരു നെറ്റ്‍വര്‍ക്ക് തിരഞ്ഞെടുക്കുക അല്ലെങ്കില്‍ വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="2565214867520763227">സ്‌ക്രീൻ റീഡർ ഓണാക്കുക</translation>
<translation id="2569972178052279830">ചില്ലറവ്യാപാരിയുടെ പേര്</translation>
<translation id="257779572837908839">മീറ്റിംഗിനുള്ള Chromebox സജ്ജമാക്കുക</translation>
<translation id="2582253231918033891"><ph name="PRODUCT_NAME" /> <ph name="PRODUCT_VERSION" /> (പ്ലാറ്റ്‌ഫോം <ph name="PLATFORM_VERSION" />) <ph name="DEVICE_SERIAL_NUMBER" /></translation>
<translation id="2593499352046705383">ആരംഭിക്കും മുമ്പ് നിങ്ങളുടെ ഡാറ്റ ബാക്കപ്പെടുത്തിട്ടുണ്ടെന്ന് ഉറപ്പാക്കുക. <ph name="DEVICE_OS" /> ഇൻസ്റ്റാൾ ചെയ്യുന്നത് നിങ്ങളുടെ ഹാർഡ് ഡ്രൈവ് ഓവർറൈറ്റ് ചെയ്യും. g.co/flex/InstallGuide -ൽ കൂടുതലറിയുക.</translation>
<translation id="2606454609872547359">വേണ്ട, ChromeVox ഇല്ലാതെ തുടരുക</translation>
<translation id="2619007277744171543"><ph name="BEGIN_PARAGRAPH1" />ഈ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ നിർണ്ണയിക്കാൻ Google-ന്റെ ലൊക്കേഷൻ സേവനം, വൈഫൈയും മൊബൈൽ നെറ്റ്‌വർക്കുകളും സെൻസറുകളും പോലുള്ള ഉറവിടങ്ങൾ ഉപയോഗിക്കുന്നു.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ക്രമീകരണം &gt; ആപ്പുകൾ &gt; Google Play Store &gt; Android മുൻഗണനകൾ മാനേജ് ചെയ്യുക &gt; സുരക്ഷയും ലൊക്കേഷനും &gt; ലൊക്കേഷൻ എന്നതിലേക്ക് പോയി നിങ്ങൾക്ക് ഏത് സമയത്തും ഈ ഉപകരണത്തിലെ Android ലൊക്കേഷൻ ഓഫാക്കാം. അതേ മെനുവിലെ “Google ലൊക്കേഷൻ കൃത്യത” ഓഫാക്കി നിങ്ങൾക്ക് Android ലൊക്കേഷനുള്ള വൈഫൈ, മൊബൈൽ നെറ്റ്‌വർക്കുകൾ, സെൻസറുകൾ എന്നിവയുടെ ഉപയോഗവും ഓഫാക്കാനാകും.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2663302507110284145">ഭാഷ</translation>
<translation id="2687407218262674387">Google സേവന നിബന്ധനകൾ</translation>
<translation id="2688196195245426394">ഉപകരണം സെർവറിൽ രജിസ്റ്റർ ചെയ്യുന്നതിൽ പിശക്: <ph name="CLIENT_ERROR" />.</translation>
<translation id="2698147581454716013">ഇതൊരു ബണ്ടിൽ ചെയ്‌ത ഉപകരണമാണ്, Kiosk &amp; Signage അപ്ഗ്രേഡ് ഉപയോഗിച്ച് എൻറോൾ ചെയ്യാനാകില്ല.</translation>
<translation id="2722540561488096675"><ph name="TIME_LEFT" />-നുള്ളിൽ നിങ്ങളുടെ ഉപകരണം ഷട്ട് ഡൗൺ ചെയ്യും. നിങ്ങളുടെ ഉപകരണം വീണ്ടും ഓണാക്കുന്നതിന് മുമ്പ് USB നീക്കം ചെയ്യുക. തുടർന്ന് നിങ്ങൾക്ക് <ph name="DEVICE_OS" /> ഉപയോഗിച്ച് തുടങ്ങാം.</translation>
<translation id="2725200716980197196">നെറ്റ്‌വർക്ക് കണക്‌റ്റിവിറ്റി പുനഃസ്‌ഥാപിച്ചു</translation>
<translation id="2731700343119398978">കാത്തിരിക്കുക...</translation>
<translation id="2732134891301408122"><ph name="TOTAL_ELEMENTS" />-ൽ <ph name="CURRENT_ELEMENT" />-ാമത്തെ അധിക ഉള്ളടക്കം</translation>
<translation id="2740531572673183784">ശരി</translation>
<translation id="2742448780373473567"><ph name="DEVICE_OS" /> ഇൻസ്‌റ്റാൾ ചെയ്യുന്നത് നിങ്ങളുടെ ഉപകരണത്തിലെ എല്ലാ ഡാറ്റയും ഓവർറൈറ്റ് ചെയ്യും.</translation>
<translation id="274318651891194348">കീബോർഡ് തിരയുന്നു</translation>
<translation id="2754825024506485820">ഉൽപ്പാദനക്ഷമത മുതൽ വിനോദം വരെ, നിങ്ങൾക്ക് ആവശ്യമുള്ള ആപ്പുകൾ Google Play Store-ൽ നിന്ന് കണ്ടെത്തുക. നിങ്ങൾക്ക് ഏതുസമയത്തും ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യാം.</translation>
<translation id="2758774297008336689"><ph name="BEGIN_PARAGRAPH1" />ലൊക്കേഷൻ കൃത്യത ഓണായിരിക്കുമ്പോൾ, Wi-Fi ആക്സസ് പോയിന്റുകൾ, സെല്ലുലാർ നെറ്റ്‌വർക്ക് ടവറുകൾ, എന്നിവ പോലുള്ള വയർലെസ് സിഗ്നലുകളെ കുറിച്ചുള്ള വിവരങ്ങൾക്കൊപ്പം ആക്‌സിലറോമീറ്റർ, ജൈറോസ്‌കോപ്പ് എന്നിവ പോലുള്ള ഉപകരണ സെൻസർ ഡാറ്റയും കൂടുതൽ കൃത്യമായ ഉപകരണ ലൊക്കേഷൻ കണക്കാക്കാൻ ഉപയോഗിക്കുന്നു, ലൊക്കേഷൻ അധിഷ്ഠിത ഫീച്ചറുകൾ ലഭ്യമാക്കാൻ Android ആപ്പുകളും സേവനങ്ങളും ഇവ ഉപയോഗിക്കുന്നു. ഇത് ചെയ്യാൻ, ക്രൗഡ് സോഴ്‌സ്ഡ് വയർലെസ് സിഗ്നൽ ലൊക്കേഷനുകളിലേക്ക് സംഭാവന നൽകുന്നതിന് ഈ ഉപകരണത്തിന്റെ അടുത്തുള്ള ഉപകരണ സെൻസറുകളെയും വയർലെസ് സിഗ്നലുകളെയും കുറിച്ചുള്ള വിവരങ്ങൾ Google ഇടയ്ക്കിടെ ശേഖരിക്കുന്നു.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ഈ ഉപകരണത്തിൽ നിന്ന് ശേഖരിക്കുന്ന വിവരങ്ങൾ Google ഇനിപ്പറയുന്ന കാര്യങ്ങൾക്ക് ഉപയോഗിക്കുന്നു: ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്താൻ; പൊതുവായി Google-ന്റെ സേവനങ്ങൾ മെച്ചപ്പെടുത്താനും നൽകാനും പരിപാലിക്കാനും. ഉപയോക്താക്കളുടെ ആവശ്യങ്ങൾ നിറവേറ്റുന്നതിനായി, Google-ന്റെയും മൂന്നാം കക്ഷികളുടെയും നിയമപരമായ താൽപ്പര്യങ്ങളെ അടിസ്ഥാനമാക്കി ഈ വിവരം ഞങ്ങൾ പ്രോസസ് ചെയ്യുന്നു. ഒരു വ്യക്തിയെ തിരിച്ചറിയാനായി ഈ വിവരം ഉപയോഗിക്കുന്നില്ല.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />ഈ ഉപകരണത്തിന്റെ ക്രമീകരണത്തിന് കീഴിലുള്ള ലൊക്കേഷൻ ക്രമീകരണം &gt; സ്വകാര്യതയും സുരക്ഷയും &gt; സ്വകാര്യതാ നിയന്ത്രണങ്ങൾ &gt; ലൊക്കേഷൻ ആക്സസ് &gt; വിപുലമായ ലൊക്കേഷൻ ക്രമീകരണം എന്ന ക്രമത്തിൽ സന്ദർശിച്ച് നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും ലൊക്കേഷൻ കൃത്യത ഓഫാക്കാനാകും. ലൊക്കേഷൻ കൃത്യത ഓഫാണെങ്കിൽ, ലൊക്കേഷൻ കൃത്യതയുമായി ബന്ധപ്പെട്ട ഡാറ്റ ശേഖരിക്കില്ല. Android ആപ്പുകളുടെയും സേവനങ്ങളുടെയും കാര്യത്തിൽ, ഈ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ നിർണ്ണയിക്കാനായി, ലഭ്യമാണെങ്കിൽ, IP വിലാസം മാത്രമേ ഉപയോഗിക്കൂ, ഇത് Google Maps പോലുള്ള Android ആപ്പുകളുടെയും സേവനങ്ങളുടെയും ലഭ്യതയേയും കൃത്യതയേയും ബാധിച്ചേക്കാം.<ph name="END_PARAGRAPH3" /></translation>
<translation id="2805539617243680210">നിങ്ങൾ തയ്യാറായിക്കഴിഞ്ഞു!</translation>
<translation id="2819519502129272135">ഫയൽ സമന്വയിപ്പിക്കൽ ഓഫാക്കി</translation>
<translation id="2832124733806557606">നിങ്ങളുടെ കുട്ടിക്ക് ഒരു പിൻ ഉപയോഗിച്ച് ഉപകരണത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യാനോ ഉപകരണം അൺലോക്ക് ചെയ്യാനോ കഴിയും.</translation>
<translation id="283669119850230892">നെറ്റ്‌വർക്ക് <ph name="NETWORK_ID" /> ഉപയോഗിക്കുന്നതിന്, ആദ്യം ഇന്റർനെറ്റിലേക്കുള്ള നിങ്ങളുടെ കണക്ഷൻ ചുവടെ പൂർത്തിയാക്കുക.</translation>
<translation id="2849767214114481738">നിങ്ങളുടെ PIN ചേർത്തു</translation>
<translation id="2851810309108851898"><ph name="BEGIN_PARAGRAPH1" />സ്വയമേവയുള്ള റിപ്പോർട്ടുകൾ അയയ്ക്കാൻ ChromeOS ഉപകരണങ്ങളെ അനുവദിക്കുന്നത്, ChromeOS-ൽ പരിഹരിക്കേണ്ടവയ്ക്കും മെച്ചപ്പെടുത്തേണ്ടവയ്ക്കും മുൻഗണന നൽകാൻ ഞങ്ങളെ സഹായിക്കുന്നു ChromeOS എപ്പോഴാണ് ക്രാഷാകുന്നത്, ഏതൊക്കെ ഫീച്ചറുകളാണ് ഉപയോഗിച്ചത്, സാധാരണ ഗതിയിൽ ഉപയോഗിക്കുന്ന മെമ്മറിയുടെ അളവ് എത്രയാണ് എന്നിവ പോലുള്ള കാര്യങ്ങൾ ഈ റിപ്പോർട്ടിൽ ഉൾപ്പെടുത്താം.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളുടെ Chrome ഉപകരണ ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഈ റിപ്പോർട്ടുകൾ അനുവദിക്കാൻ തുടങ്ങുകയോ നിർത്തുകയോ ചെയ്യാം. നിങ്ങളൊരു ഡൊമെയ്ൻ അഡ്മിനിസ്ട്രേറ്റർ ആണെങ്കിൽ, അഡ്മിൻ കൺസോളിൽ ഈ ക്രമീകരണം നിങ്ങൾക്ക് മാറ്റാനാകും.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2861301611394761800">സിസ്റ്റം അപ്ഡേറ്റ് പൂര്‍ത്തിയായി. ദയവായി സിസ്റ്റം റീസ്റ്റാർട്ട് ചെയ്യുക.</translation>
<translation id="2870909136778269686">അപ്‌ഡേറ്റ് ചെയ്യുന്നു...</translation>
<translation id="2872961005593481000">അടയ്ക്കുക</translation>
<translation id="2886119409731773154">ഇതിന് 30 മിനിറ്റ് വരെ എടുത്തേക്കാം</translation>
<translation id="2893180576842394309">തിരയലും മറ്റ് Google സേവനങ്ങളും വ്യക്തിപരമാക്കാൻ Google നിങ്ങളുടെ ചരിത്രം ഉപയോഗിച്ചേക്കാം</translation>
<translation id="2902265136119311513">അതിഥിയായി ബ്രൗസ് ചെയ്യുക</translation>
<translation id="2904210161403910217">നിങ്ങൾ അവസാനം സൈൻ ഇൻ ചെയ്തതിനു ശേഷം പാസ്‍വേഡ് മാറിയിട്ടുണ്ട്</translation>
<translation id="2918484644467055090">മറ്റൊരു സ്ഥാപനം ഉപകരണത്തെ നിയന്ത്രിക്കുന്നതിനായി അടയാളപ്പെടുത്തിയിരിക്കുന്നതിനാൽ, ഈ ഉപകരണത്തിന് നിങ്ങളുടെ അക്കൗണ്ട് ഉൾപ്പെട്ടിരിക്കുന്ന സ്ഥാപനത്തിലേക്ക് എൻറോൾ ചെയ്യാനാകില്ല.</translation>
<translation id="2921081876747860777">നിങ്ങളുടെ ലോക്കൽ ഡാറ്റ സംരക്ഷിക്കുന്നതിന് പാസ്‌വേഡ് സൃഷ്‌ടിക്കുക.</translation>
<translation id="2935654492420446828">സ്‌കൂൾ അക്കൗണ്ട് പിന്നീട് ചേർക്കുക</translation>
<translation id="2950666755714083615">എന്നെ സൈൻ അപ്പ് ചെയ്യിക്കൂ</translation>
<translation id="2979966855249721010">നിങ്ങളുടെ താൽപ്പര്യങ്ങളുടെ അടിസ്ഥാനത്തിൽ, ആപ്പ് നിർദ്ദേശങ്ങളും നുറുങ്ങുകളും മറ്റും നിങ്ങൾ കണ്ടേക്കാം</translation>
<translation id="3012917896646559015">നിങ്ങളുടെ കമ്പ്യൂട്ടർ കേടുപാടുകൾ തീർക്കുന്നതിനായി അയയ്‌ക്കുന്നതിന് നിങ്ങളുടെ ഹാർഡ്‌വെയർ നിർമ്മാതാവിനെ ഉടൻ ബന്ധപ്പെടുക.</translation>
<translation id="3023464535986383522">വായിച്ചുകേൾക്കാൻ തിരഞ്ഞെടുക്കുക</translation>
<translation id="3028371505549235127">സൈൻ ഇൻ ചെയ്യുന്നതിന് നിങ്ങളുടെ Google Account പാസ്‌വേഡ് നൽകുന്നതിന് പകരം, ഈ ഉപകരണത്തിനായി നിങ്ങൾക്ക് ഒരു <ph name="DEVICE_TYPE" /> പാസ്‌വേഡ് സൃഷ്‌ടിക്കാം</translation>
<translation id="3033348223765101500">നിങ്ങളുടെ ഡാറ്റ നിയന്ത്രിക്കുക</translation>
<translation id="3090871774332213558">"<ph name="DEVICE_NAME" />" ജോടിയാക്കി</translation>
<translation id="3101924772906986970">നിങ്ങളുടെ Chrome ബ്രൗസർ ബുക്ക്‌മാർക്കുകൾ, പാസ്‌വേഡുകൾ, ചരിത്രം എന്നിവയും മറ്റും നിങ്ങളുടെ Google Account-ൽ സംരക്ഷിച്ചിരിക്കുന്നു</translation>
<translation id="313205617302240621">പാസ്‌വേഡ് മറന്നോ?</translation>
<translation id="3162070126914310576">നിങ്ങളുടെ ഓർഗനൈസേഷൻ യൂണിറ്റ് അതിന്റെ പ്രാരംഭ എൻറോൾമെന്റ് പരിധിയിൽ എത്തിയതിനാൽ, ഈ ഉപകരണം നിലവിൽ എൻറോൾ ചെയ്യാനാകില്ല. സഹായത്തിന്, നിങ്ങളുടെ അഡ്‌മിനെ ബന്ധപ്പെടുക.</translation>
<translation id="3163511056918491211">ഏത് സമയത്തും എളുപ്പത്തിൽ നിങ്ങളുടെ ഡാറ്റ പുനഃസ്ഥാപിക്കുകയോ ഉപകരണങ്ങൾ തമ്മിൽ മാറുകയോ ചെയ്യൂ. നിങ്ങളുടെ ബാക്കപ്പുകൾ Google-ലേക്ക് അപ്‌ലോഡ് ചെയ്ത്, നിങ്ങളുടെ Google Account പാസ്‌വേഡ് ഉപയോഗിച്ച് എൻക്രിപ്റ്റ് ചെയ്തു.</translation>
<translation id="3169930038976362151">നിങ്ങളുടെ ആവശ്യങ്ങൾക്ക് അനുയോജ്യമായ തീം തിരഞ്ഞെടുക്കുക. നിങ്ങളുടെ തീമും വാൾപേപ്പറും സ്ക്രീൻ സേവറും മറ്റും മാറ്റാൻ ഡെസ്‌ക്ടോപ്പിൽ സ്‌പർശിച്ച് പിടിക്കുക.</translation>
<translation id="3170072451822350649">നിങ്ങൾക്ക് സൈൻ ഇൻ ചെയ്യുന്നത് ഒഴിവാക്കി <ph name="LINK_START" />അതിഥിയായി ബ്രൗസ് ചെയ്യാനുമാകും<ph name="LINK_END" />.</translation>
<translation id="3177914167275935955">നിങ്ങളുടെ ഉപകരണത്തിൽ Chrome വിദ്യാഭ്യാസ അപ്‌ഗ്രേഡ് ഉൾപ്പെടുന്നു, എന്നാൽ നിങ്ങളുടെ ഉപയോക്തൃനാമം Google for Education അക്കൗണ്ടുമായി ബന്ധപ്പെട്ടതല്ല. ഒരു സെക്കൻഡറി ഉപകരണത്തിൽ g.co/workspace/edusignup സന്ദർശിച്ച് Google for Education അക്കൗണ്ട് സൃഷ്ടിക്കുക.</translation>
<translation id="3196912927885212665">Android ഫോൺ ഉപയോഗിച്ച് സജ്ജീകരിക്കാൻ, നിങ്ങളുടെ Chromebook-ന്റെ Bluetooth ഓണാക്കണം</translation>
<translation id="322708765617468434">സജ്ജീകരിച്ചതിന് ശേഷം നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും മറ്റൊരു വ്യക്തിയെ ഉപകരണത്തിലേക്ക് ചേർക്കാം. ഓരോ വ്യക്തിക്കും അവരുടെ അനുഭവം വ്യക്തിപരമാക്കാനും ഡാറ്റ സ്വകാര്യമായി സൂക്ഷിക്കാനും കഴിയും.</translation>
<translation id="3238192140106069382">കണക്റ്റ് ചെയ്‌ത് പരിശോധിച്ചുറപ്പിക്കുന്നു</translation>
<translation id="3251119461199395237">ഫയൽ സമന്വയിപ്പിക്കൽ</translation>
<translation id="325238099842880997">നിങ്ങളുടെ കുട്ടികളെ കളിക്കാനും അടുത്തറിയാനും സ്‌കൂൾ വർക്ക് വീട്ടിൽ ചെയ്യാനും സഹായിക്കുന്നതിന് ഡിജിറ്റൽ അടിസ്ഥാന നിയമങ്ങൾ സജ്ജീകരിക്കുക</translation>
<translation id="3255747772218936245">അപ്‌ഡേറ്റ് ഇൻസ്‌റ്റാൾ ചെയ്യുക</translation>
<translation id="3261268979727295785">മുതിർന്ന കുട്ടികൾക്ക്, സജ്ജീകരണം പൂർത്തിയാക്കിക്കഴിഞ്ഞാൽ നിങ്ങൾക്ക് രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ചേർക്കാൻ കഴിയും. Explore ആപ്പിൽ രക്ഷാകർതൃ നിയന്ത്രണങ്ങളെ കുറിച്ചുള്ള വിവരങ്ങൾ നിങ്ങൾക്ക് കാണാം.</translation>
<translation id="3278001907972365362">നിങ്ങളുടെ Google അക്കൗണ്ടിന്(കൾക്ക്) ശ്രദ്ധ ആവശ്യമാണ്</translation>
<translation id="3283148363895519428">സജ്ജീകരണം തുടരാൻ, ഫോണിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക. നിങ്ങളുടെ ഫോൺ സമീപത്തുണ്ടെന്നും Bluetooth ഓണാക്കിയിട്ടുണ്ടെന്നും ഉറപ്പാക്കുക.</translation>
<translation id="3327050066667856415">Chromebooks സുരക്ഷയ്‌ക്കായി രൂപകൽപ്പന ചെയ്‌തിരിക്കുന്നു. നിങ്ങളുടെ ഉപകരണം മാൽവെയറിൽ നിന്ന് സ്വയമേവ പരിരക്ഷിക്കപ്പെട്ടിരിക്കുന്നു – അധിക സോഫ്‌റ്റ്‌വെയർ ആവശ്യമില്ല.</translation>
<translation id="3382073616108123819">ക്ഷമിക്കണം!  ഈ ഉപകരണത്തിന് ഉപകരണ ഐഡന്റിഫയറുകൾ കണ്ടെത്തുന്നതിൽ ഈ സി‌സ്‌റ്റം പരാജയപ്പെട്ടു.</translation>
<translation id="3382200254148930874">മേൽനോട്ടം നിർത്തുന്നു...</translation>
<translation id="3384362484379805487">ഡിസ്‌ക് സ്പെയ്‌സ് ലാഭിക്കാൻ, ഭാഷാ ഫയലുകൾ ഉപയോക്താക്കൾക്കിടയിൽ പങ്കിടും.</translation>
<translation id="3385092118218578224"><ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3391721320619127327">സംഭാഷണ സിന്തസൈസർ അല്ലെങ്കിൽ ബ്രെയ്‌ലി ഡിസ്‌പ്ലേയുടെ സഹായത്തോടെ സ്ക്രീനിൽ കാണിക്കുന്ന ടെക്‌സ്റ്റ് വായിക്കാൻ അന്ധതയോ കാഴ്ചക്കുറവോ ഉള്ള ആളുകളാണ് ChromeOS Flex, ChromeVox എന്നിവയിലെ സ്ക്രീൻ പ്രധാനമായും റീഡർ ഉപയോഗിക്കുന്നത്. ChromeVox ഓണാക്കാൻ രണ്ട് വോളിയം കീകളും അഞ്ച് സെക്കൻഡ് നേരത്തേക്ക് അമർത്തിപ്പിടിക്കുക. ChromeVox സജീവമായിക്കഴിഞ്ഞാൽ, ദ്രുത ടൂർ വഴി നിങ്ങൾക്ക് അതേക്കുറിച്ച് അറിയാനാകും.</translation>
<translation id="3402585168444815892">ഡെമോ മോഡിൽ എൻറോൾ ചെയ്യുന്നു</translation>
<translation id="3433621910545056227">ക്ഷമിക്കണം! ഉപകരണ ഇൻസ്റ്റലേഷൻ-സമയ ആട്രിബ്യൂട്ട് ലോക്ക് സ്ഥാപിക്കുന്നതിൽ സിസ്റ്റം പരാജയപ്പെട്ടു.</translation>
<translation id="3435896845095436175">തയ്യാറാക്കുക</translation>
<translation id="3462413494201477527">അക്കൗണ്ട് സജ്ജീകരണം ഇല്ലാതാക്കണോ?</translation>
<translation id="3473241910002674503">ടാബ്‌ലെറ്റ് മോഡിൽ ബട്ടണുകൾ ഉപയോഗിച്ച് ഹോമിലേക്ക് നാവിഗേറ്റ് ചെയ്യുക, മടങ്ങുക, ആപ്പുകൾ മാറുക.</translation>
<translation id="3473479545200714844">സ്‌ക്രീൻ മാഗ്‌നിഫയർ</translation>
<translation id="3491669675709357988">നിങ്ങളുടെ കുട്ടിയുടെ അക്കൗണ്ടിൽ Family Link-ന്റെ രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ സജ്ജീകരിച്ചിട്ടില്ല. സജ്ജീകരണം പൂർത്തിയാക്കിക്കഴിഞ്ഞാൽ നിങ്ങൾക്ക് രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ചേർക്കാൻ കഴിയും. Explore ആപ്പിൽ രക്ഷാകർതൃ നിയന്ത്രണങ്ങളെ കുറിച്ചുള്ള വിവരങ്ങൾ നിങ്ങൾക്ക് കാണാം.</translation>
<translation id="350397915809787283">നിങ്ങൾക്ക് അക്കൗണ്ട് ഇല്ലെങ്കിൽ, അക്കൗണ്ട് സൃഷ്‌ടിക്കാൻ ആദ്യത്തെ ഓപ്ഷൻ തിരഞ്ഞെടുക്കുക.</translation>
<translation id="3520824492621090923">കിയോസ്‌ക്, സൈനേജ് ഉപകരണ എൻറോൾമെന്റ് സ്ഥിരീകരിക്കണോ?</translation>
<translation id="3547954654003013442">പ്രോക്‌സി ക്രമീകരണം</translation>
<translation id="3550915441744863158">സ്വയമേവ Chrome അപ്‌ഡേറ്റ് ചെയ്യുന്നതിനാൽ നിങ്ങളുടേത് എപ്പോഴും പുതുമയുള്ള പതിപ്പായിരിക്കും.</translation>
<translation id="3559533181353831840">ഏകദേശം <ph name="TIME_LEFT" /> ശേഷിക്കുന്നു</translation>
<translation id="3567129848895158510"><ph name="BEGIN_PARAGRAPH1" />ഈ ഡെമോ ഉപകരണം കോൺഫിഗർ ചെയ്യേണ്ട ചില്ലറവ്യാപാരിയുടെ പേരും സ്‌റ്റോറിന്റെ നമ്പറും നൽകുക*. <ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങൾക്ക് സ്‌റ്റോറിന്റെ നമ്പർ അറിയില്ലെങ്കിൽ, ഡെമോ മോഡ് ഇൻസ്റ്റലേഷൻ തുടരുന്നതിന് "0000" എന്ന് നൽകാം. <ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />*ശ്രദ്ധിക്കുക: ഉപകരണത്തിന് ലഭിക്കേണ്ട ഡെമോ മോഡിന്റെ പതിപ്പ് ഏതാണെന്ന് കണ്ടെത്താനും ഡെമോ മോഡിന്റെ ഉപയോഗം കണക്കാക്കാനും Google ഈ വിവരങ്ങൾ ഉപയോഗിക്കുന്നു.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3577473026931028326">എന്തോ കുഴപ്പമുണ്ടായി. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="3577745545227000795"><ph name="DEVICE_OS" /> ഹാർഡ്‌വെയർ ഡാറ്റാ ശേഖരണം</translation>
<translation id="3602290021589620013">പ്രിവ്യൂ</translation>
<translation id="3607671391978830431">ഒരു കുട്ടിക്ക്</translation>
<translation id="3627320433825461852">1 മിനിറ്റിൽ താഴെ ശേഷിക്കുന്നു</translation>
<translation id="3635199270495525546">വിശ്വസ്ത പ്ലാറ്റ്‌ഫോം മൊഡ്യൂൾ (TPM) കണ്ടെത്തി</translation>
<translation id="3650753875413052677">എൻറോൾമെന്റ് പിശക്</translation>
<translation id="3661106764436337772">കൂടുതൽ ആത്മവിശ്വാസത്തോടെ വേഗത്തിൽ എഴുതൂ</translation>
<translation id="3662207097851752847">ഫോണിൽ നിങ്ങളുടെ Google Account സ്ഥിരീകരിക്കുക</translation>
<translation id="3672681487849735243">ഒരു ഫാക്‌ടറി പിശക് കണ്ടെത്തി</translation>
<translation id="3673097791729989571">സൈൻ ഇൻ ഹോസ്റ്റ് ചെയ്യുന്നത് <ph name="SAML_DOMAIN" /> ആണ്</translation>
<translation id="3673287357837016374">നിങ്ങളുടെ പിൻ അപ്‌ഡേറ്റ് ചെയ്‌തു</translation>
<translation id="367645871420407123">പരീക്ഷണ ചിത്ര മൂല്യത്തിലേക്ക് ഡീഫോൾട്ട് റൂട്ട് പാസ്‌വേഡ് സജ്ജീകരിക്കണമെങ്കിൽ ശൂന്യമായിടുക</translation>
<translation id="370665806235115550">ലോഡ്ചെയ്യുന്നു...</translation>
<translation id="3712050472459130149">അക്കൗണ്ട് അപ്ഡേറ്റ് ആവശ്യമാണ്</translation>
<translation id="3733296813637058299">ആ ആപ്പുകൾ ഞങ്ങൾ നിങ്ങൾക്കായി ഇൻസ്റ്റാൾ ചെയ്യും. നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഉപകരണത്തിനുള്ള കൂടുതൽ ആപ്പുകൾ Play Store-ൽ കണ്ടെത്താം.</translation>
<translation id="3740945083753997630">ഡിസ്പ്ലേ, ടെക്സ്റ്റ് വലുപ്പം കുറയ്ക്കുക</translation>
<translation id="376841534249795524">നിങ്ങൾ എന്തിനാണ് നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഉപയോഗിക്കുക?</translation>
<translation id="3772046291955677288"><ph name="BEGIN_LINK1" />Google സേവന നിബന്ധനകളും<ph name="END_LINK1" /><ph name="BEGIN_LINK2" />Chrome, ChromeOS അധിക സേവന നിബന്ധനകളും<ph name="END_LINK2" /> ഞാൻ വായിച്ച് അംഗീകരിക്കുന്നു.</translation>
<translation id="3789841737615482174">ഇന്‍സ്റ്റാൾ ചെയ്യുക</translation>
<translation id="3800828618615365228">Google Chrome, ChromeOS അധിക നിബന്ധനകൾ</translation>
<translation id="3828953470056652895"><ph name="BEGIN_LINK1" />Google സേവന നിബന്ധനകളും<ph name="END_LINK1" /> <ph name="BEGIN_LINK2" />Chrome, ChromeOS അധിക സേവന നിബന്ധനകളും<ph name="END_LINK2" /> <ph name="BEGIN_LINK3" />Play സേവന നിബന്ധനകളും<ph name="END_LINK3" /> ഞാൻ വായിച്ച് അംഗീകരിക്കുന്നു.</translation>
<translation id="3837569373891539515">ബാധകമാകുന്നവയെല്ലാം തിരഞ്ഞെടുക്കാം. നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> സജ്ജീകരിച്ച് കഴിഞ്ഞാൽ, നിങ്ങൾക്ക് ക്രമീകരണത്തിലും ഈ ഓപ്ഷനുകൾ കണ്ടെത്താം.</translation>
<translation id="385051799172605136">പിന്നോട്ട്</translation>
<translation id="3856470183388031602"><ph name="DEVICE_TYPE" /> എന്നതിൽ നിങ്ങളുടെ Google Account ഉപയോഗിക്കുക</translation>
<translation id="3856800405688283469">സമയ മേഖല തിരഞ്ഞെടുക്കുക</translation>
<translation id="3893630138897523026">ChromeVox (സ്‌പോക്കൺ ഫീഡ്‌ബാക്ക്)</translation>
<translation id="3897746662269329507">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഗെയിമിംഗിന് വേണ്ടി നിർമ്മിച്ചതാണ്. നൂറുകണക്കിന് പുത്തൻ ഗെയിമുകൾ ആക്‌സസ് ചെയ്യാനും ഗെയിമിംഗ് ഓഫറുകൾ കാണാനും നിങ്ങളുടെ ഉപകരണത്തിലുള്ള ഗെയിമിംഗ് ഫീച്ചറുകൾ കണ്ടെത്താനുമാകുന്ന Explore ആപ്പ് അടുത്ത സ്ക്രീനിൽ തുറക്കും.</translation>
<translation id="389901847090970821">കീബോർഡ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="3910588685973519483">AI ഉപയോഗിച്ച് വാൾപേപ്പറുകൾ സൃഷ്‌ടിക്കൂ</translation>
<translation id="3924259174674732591">ഡിസ്പ്ലേ, ടെക്സ്റ്റ് വലുപ്പം <ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3950820424414687140">സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="397703832102027365">തീര്‍ച്ചപ്പെടുത്തുന്നു...</translation>
<translation id="3983400541576569538">ചില ആപ്പുകളിൽ നിന്നുള്ള ഡാറ്റ നഷ്‌ടപ്പെട്ടേക്കാം</translation>
<translation id="3984159763196946143">ഡെമോ മോഡ് ആരംഭിക്കാനായില്ല</translation>
<translation id="3988996860813292272">സമയ മേഖല തിരഞ്ഞെടുക്കുക</translation>
<translation id="3994318741694670028">നിർഭാഗ്യവശാൽ, കേടായ ഹാർഡ്‌വെയർ ഐഡി ഉപയോഗിച്ചാണ് നിങ്ങളുടെ കമ്പ്യൂട്ടർ കോൺഫിഗർ ചെയ്തിരിക്കുന്നത്. ഇത് ഏറ്റവും പുതിയ സുരക്ഷാ പ്രശ്നപരിഹാരമാർഗ്ഗങ്ങൾ അപ്ഡേറ്റ് ചെയ്യുന്നതിൽ നിന്ന് ChromeOS Flex-നെ തടയുന്നു, നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ <ph name="BEGIN_BOLD" />ദോഷകരമായ ആക്രമണങ്ങളുണ്ടായേക്കാം<ph name="END_BOLD" />.</translation>
<translation id="4002440992267487163">സജ്ജീകരണം പിൻ ചെയ്യുക</translation>
<translation id="403725336528835653">ആദ്യം ഇത് പരീക്ഷിക്കൂ</translation>
<translation id="4044883420905480380">Android ഫോൺ ഉപയോഗിച്ച് നിങ്ങൾ വൈഫൈയിലേക്ക് കണക്‌റ്റ് ചെയ്‌ത് <ph name="USER_EMAIL" /> എന്നതിലേക്ക് സൈൻ ഇൻ ചെയ്‌തു</translation>
<translation id="4047726037116394521">ഹോമിലേക്ക് പോവുക</translation>
<translation id="4062561150282203854">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ആപ്പുകൾ, ക്രമീകരണം എന്നിവയും മറ്റും സമന്വയിപ്പിക്കുക</translation>
<translation id="4089743381329341712">തിരഞ്ഞെടുത്ത ആപ്പുകൾ സജ്ജീകരണത്തിന് ശേഷം ഇൻസ്റ്റാൾ ചെയ്യും. Apps &amp; Games ആപ്പിൽ പിന്നീട് കൂടുതൽ നിർദ്ദേശങ്ങൾ കണ്ടെത്തുക.</translation>
<translation id="4104944259562794668">ക്രമീകരണം &gt; സുരക്ഷയും സ്വകാര്യതയും &gt; ലോക്ക് സ്ക്രീനും സൈൻ ഇൻ ചെയ്യൽ എന്നതിൽ നിങ്ങൾക്കിത് പിന്നീട് പ്രവർത്തനക്ഷമമാക്കാം</translation>
<translation id="4132183752438206707">Google Play Store-ൽ ആപ്പുകൾ കണ്ടെത്തുക</translation>
<translation id="4135746311382563554">Google Chrome, ChromeOS അധിക സേവന നിബന്ധനകൾ</translation>
<translation id="41365691917097717">തുടരുന്നത്, Android ആപ്പുകൾ സൃഷ്‌ടിക്കാനും പരിശോധിക്കാനും ADB ഡീബഗ് ചെയ്യലിനെ പ്രവർത്തനക്ഷമമാക്കും. Google പരിശോധിച്ചുറപ്പിച്ചിട്ടില്ലാത്ത Android ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യാൻ ഈ പ്രവൃത്തി അനുവദിക്കുമെന്നതും ഇത് പ്രവർത്തനരഹിതമാക്കാൻ ഫാക്ടറി റീസെറ്റ് ചെയ്യേണ്ടി വരുമെന്നതും ശ്രദ്ധിക്കുക.</translation>
<translation id="4165942112764990069"><ph name="USER_EMAIL" /> സാധുവായ ഒരു സ്ഥാപനത്തിൽ ഉൾപ്പെടുന്നതല്ല. നിങ്ങളുടെ അഡ്‌മിനെ ബന്ധപ്പെടുക. നിങ്ങൾ ഒരു അഡ്മിൻ ആണെങ്കിൽ ഇവിടെ സന്ദർശിച്ച് നിങ്ങളുടെ സ്ഥാപനം സജ്ജീകരിക്കാനാകും: g.co/ChromeEnterpriseAccount</translation>
<translation id="4167393659000039775">ഏതെങ്കിലും തരത്തിലുള്ള ഡാറ്റാ നഷ്‌ടത്തിന് Google ഉത്തരവാദിയായിരിക്കില്ല, അംഗീകൃതമല്ലാത്ത മോഡലുകളിൽ <ph name="DEVICE_OS" /> പ്രവർത്തിച്ചേക്കില്ല. g.co/flex/InstallGuide -ൽ കൂടുതലറിയുക.</translation>
<translation id="4209092469652827314">വലുത്</translation>
<translation id="4213918571089943508">കുട്ടിയുടെ Google Account</translation>
<translation id="4228071595943929139">നിങ്ങളുടെ സ്ഥാപനത്തിന്റെ ഇമെയിൽ വിലാസം ഉപയോഗിക്കുക</translation>
<translation id="4232484478444192782">Android ഫോണിൽ നിങ്ങളുടെ വിവരങ്ങളുണ്ട്. നിങ്ങളുടെ വൈഫൈയും പാസ്‌വേഡും കൈമാറുന്നു.</translation>
<translation id="4242145785130247982">ഒന്നിലധികം ക്ലയന്റ് സർട്ടിഫിക്കറ്റുകൾ പിന്തുണയ്‌ക്കുന്നില്ല</translation>
<translation id="4242577469625748426">ഉപകരണത്തിൽ നയ ക്രമീകരണങ്ങൾ ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പരാജയപ്പെട്ടു: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4250680216510889253">ഇല്ല</translation>
<translation id="4251377547188244181">കിയോസ്‌ക്, സൈനേജ് ഉപകരണ എൻറോൾമെന്റ്</translation>
<translation id="4263223596040212967">നിങ്ങളുടെ കീബോർഡ് ലേഔട്ട് പരിശോധിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4268490040465852105">Gmail, YouTube, Chrome, മറ്റ് Google ഉൽപ്പന്നങ്ങൾ എന്നിവയ്‌ക്കായി നിങ്ങൾ ഉപയോഗിക്കുന്ന അക്കൗണ്ട്, നിങ്ങളുടെ Google Account തന്നെയാണ്.
        എല്ലാ ബുക്ക്‌മാര്‍ക്കുകളും ഫയലുകളും മറ്റും എളുപ്പത്തിൽ ആക്സസ് ചെയ്യാൻ നിങ്ങളുടെ അക്കൗണ്ട് ഉപയോഗിക്കുക.</translation>
<translation id="4278498748067682896">ഉപകരണത്തെ കിയോസ്‌ക് അല്ലെങ്കിൽ സൈനേജ് മോഡിൽ മാത്രം റൺ ചെയ്യാൻ അനുവദിക്കുന്ന കിയോസ്‌ക്, സൈനേജ് അപ്ഗ്രേഡ് ആയിരിക്കും നിങ്ങൾ ഉപയോഗിക്കുക. ഉപകരണത്തിൽ ഉപയോക്താക്കൾ സൈൻ ഇൻ ചെയ്യണമെന്നുണ്ടെങ്കിൽ, പിന്നിലേക്ക് പോയി Chrome Enterprise അപ്ഗ്രേഡ് ഉപയോഗിച്ച് എൻറോൾ ചെയ്യുക.</translation>
<translation id="4287157641315808225">വേണം, ChromeVox സജീവമാക്കുക</translation>
<translation id="4289732974614035569">ഒരു പിൻ തിരഞ്ഞെടുക്കുക</translation>
<translation id="4291265871880246274">ലോഗിൻ ഡയലോഗ്</translation>
<translation id="4305817255990598646">സ്വിച്ച് ചെയ്യുക</translation>
<translation id="4309165024397827958">നിങ്ങളുടെ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ ഉപയോഗിക്കാൻ ലൊക്കേഷൻ അനുമതിയുള്ള Android ആപ്പുകളെയും സേവനങ്ങളെയും അനുവദിക്കുക. Google ഇടയ്ക്കിടെ ലൊക്കേഷൻ ഡാറ്റ ശേഖരിക്കുകയും, ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്താൻ നിങ്ങളുടെ വ്യക്തിവിവരങ്ങൾ എടുത്തുനീക്കി ഈ ഡാറ്റ ഉപയോഗിക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="4317733381297736564">ആപ്പ് വഴി വാങ്ങൽ</translation>
<translation id="4341905082470253054">TPM നില പരിശോധിക്കുന്നു...</translation>
<translation id="434198521554309404">വേഗമേറിയത്. സുരക്ഷിതം. ആയാസരഹിതം.</translation>
<translation id="4358643842961018282">നിങ്ങളുടെ ഉപകരണം അപ് ടു ഡേറ്റ് ആണ്</translation>
<translation id="4370975561335139969">നിങ്ങൾ നൽകിയ ഇമെയിലും പാസ്‌വേഡും പൊരുത്തപ്പെടുന്നില്ല</translation>
<translation id="4373418556073552953">Android ഫോൺ ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="4378556263712303865">ഉപകരണ അഭ്യർത്ഥന</translation>
<translation id="4383048845287221326"><ph name="BEGIN_PARAGRAPH1" />സ്വയമേവയുള്ള റിപ്പോർട്ടുകൾ അയയ്ക്കാൻ നിങ്ങളുടെ ChromeOS ഉപകരണങ്ങളെ അനുവദിക്കുന്നത്, ChromeOS-ൽ പരിഹരിക്കേണ്ടവയ്ക്കും മെച്ചപ്പെടുത്തേണ്ടവയ്ക്കും മുൻഗണന നൽകാൻ ഞങ്ങളെ സഹായിക്കുന്നു. ChromeOS എപ്പോഴാണ് ക്രാഷാകുന്നത്, നിങ്ങൾ ഉപയോഗിക്കുന്ന ഫീച്ചറുകൾ ഏതൊക്കെയാണ്, സാധാരണ ഗതിയിൽ നിങ്ങൾ ഉപയോഗിക്കുന്ന മെമ്മറിയുടെ അളവ് എത്രയാണ്, Android ആപ്പിന്റെ ഡയഗ്‌നോസ്‌റ്റിക്‌സ്, ഉപയോഗ ഡാറ്റ എന്നിവ പോലുള്ള കാര്യങ്ങൾ ഈ റിപ്പോർട്ടിൽ ഉൾപ്പെടാം. ചില സംയോജിത ഡാറ്റയും Google ആപ്പുകളെയും Android ഡെവലപ്പർമാരെപ്പോലുള്ള പങ്കാളികളെയും സഹായിക്കും.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളുടെ ChromeOS ഉപകരണ ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഈ റിപ്പോർട്ടുകൾ അനുവദിക്കാൻ തുടങ്ങുകയോ നിർത്തുകയോ ചെയ്യാം. നിങ്ങളൊരു ഡൊമെയ്ൻ അഡ്മിനിസ്ട്രേറ്റർ ആണെങ്കിൽ, അഡ്മിൻ കൺസോളിൽ ഈ ക്രമീകരണം നിങ്ങൾക്ക് മാറ്റാനാകും.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />നിങ്ങളുടെ Google അക്കൗണ്ടിനുള്ള വെബ്, ആപ്പ് ആക്റ്റിവിറ്റി ക്രമീകരണം ഓണാക്കിയിട്ടുണ്ടെങ്കിൽ, നിങ്ങളുടെ Android ഡാറ്റ Google അക്കൗണ്ടിലേക്ക് സംരക്ഷിച്ചേക്കാം. account.google.com -ൽ നിങ്ങളുടെ ഡാറ്റ കാണാനും ഇല്ലാതാക്കാനും അക്കൗണ്ട് ക്രമീകരണം മാറ്റാനും കഴിയും.<ph name="END_PARAGRAPH3" /></translation>
<translation id="4385905942116811558">Bluetooth, USB ഉപകരണങ്ങൾ തിരയുന്നു</translation>
<translation id="4403266582403435904">ഏത് സമയത്തും എളുപ്പത്തിൽ ഡാറ്റ പുനഃസ്ഥാപിക്കുകയോ ഉപകരണങ്ങൾ തമ്മിൽ മാറുകയോ ചെയ്യൂ. ബാക്കപ്പുകൾ Google-ലേക്ക് അപ്‌ലോഡ് ചെയ്ത്, നിങ്ങളുടെ കുട്ടിയുടെ Google Account പാസ്‌വേഡ് ഉപയോഗിച്ച് എൻക്രിപ്റ്റ് ചെയ്തു.</translation>
<translation id="4410545552906060960">നിങ്ങളുടെ ഉപകരണം അൺലോക്ക് ചെയ്യാൻ പാസ്‌വേഡിന് പകരം ഒരു സംഖ്യ (പിൻ) ഉപയോഗിക്കുക. പിന്നീട് പിൻ സജ്ജീകരിക്കാൻ, ക്രമീകരണത്തിലേക്ക് പോവുക.</translation>
<translation id="4415213869328311284">നിങ്ങൾ <ph name="DEVICE_TYPE" /> ഉപയോഗിക്കുന്നത് ആരംഭിക്കാൻ തയ്യാറാണ്.</translation>
<translation id="443031431654216610">സംഖ്യകൾ മാത്രം ഉപയോഗിക്കുക</translation>
<translation id="4448560527907365660">സംരക്ഷിച്ച് കൂടുതൽ കാണുക</translation>
<translation id="4449948729197510913">നിങ്ങളുടെ ഉപയോക്തൃനാമം നിങ്ങളുടെ സ്ഥാപനത്തിന്റെ എന്റർപ്രൈസ് അക്കൗണ്ടിന്റെയാണ്. ഉപകരണങ്ങൾ അക്കൗണ്ടിലേക്ക് എൻറോൾ ചെയ്യുന്നതിന്, ആദ്യം അഡ്‌മിൻ കൺസോളിൽ ഡൊമെയ്ൻ ഉടമസ്ഥത പരിശോധിച്ചുറപ്പിക്കുക. പരിശോധിച്ചുറപ്പിക്കുന്നതിന് അക്കൗണ്ടിന്റെ അഡ്മിൻ അധികാരങ്ങൾ നിങ്ങൾക്ക് ആവശ്യമാണ്.</translation>
<translation id="4450974146388585462">പ്രശ്‌നം നിർണ്ണയിക്കുക</translation>
<translation id="445099924538929605"><ph name="DEVICE_OS" />, നിങ്ങളുടെ ഡാറ്റ കൂടുതൽ സുരക്ഷിതമായി സംഭരിക്കാനാകുന്ന സജീവ TPM കണ്ടെത്തി.</translation>
<translation id="4472298120638043495">നിങ്ങൾ മുൻഗണന നൽകുന്ന Google Account ഭാഷ (<ph name="NEW_LOCALE_FROM_GAIA" />) ഉപയോഗിക്കാം</translation>
<translation id="4472575034687746823">ആരംഭിക്കാം</translation>
<translation id="4487489714832036847">Chromebooks പരമ്പരാഗത സോഫ്‌റ്റ്‌വെയറിന് പകരം ആപ്പുകൾ ഉപയോഗിക്കുന്നു. ഉൽപ്പാദനക്ഷമത, വിനോദം എന്നിവയ്‌ക്കും മറ്റും ആപ്പുകൾ നേടുക.</translation>
<translation id="450867954911715010">ഉപയോഗസഹായി ക്രമീകരണങ്ങൾ</translation>
<translation id="4519605771716872386">ഫയൽ സമന്വയിപ്പിക്കൽ ഓണാക്കി</translation>
<translation id="4531924570968473143">ആരെയാണ് ഈ <ph name="DEVICE_TYPE" /> എന്നതിലേക്ക് നിങ്ങൾക്ക് ചേർക്കേണ്ടത്?</translation>
<translation id="4566170377336116390">എൻറോൾമെന്റിന് ശേഷം മാറണമെന്നുണ്ടെങ്കിൽ നിങ്ങളുടെ ഉപകരണം ഫാക്‌ടറി റീസെറ്റ് (Powerwash) ചെയ്യേണ്ടി വരും.</translation>
<translation id="4567512141633030272">സൈൻ ഇൻ ഓപ്ഷൻ തെറ്റാണോ?</translation>
<translation id="4567533462991917415">സജ്ജീകരിച്ചതിനുശേഷം, നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും കൂടുതൽ ആളുകളെ ചേർക്കാം. ഓരോ വ്യക്തിക്കും അവരുടെ അക്കൗണ്ട് വ്യക്തിപരമാക്കാനും ഡാറ്റ സ്വകാര്യമായി സൂക്ഷിക്കാനും കഴിയും.</translation>
<translation id="4568213207643490790">ക്ഷമിക്കണം, ഈ ഉപകരണത്തിൽ Google അക്കൗണ്ടുകൾ അനുവദനീയമല്ല.</translation>
<translation id="4611759022973144129">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഈ പാസ്‍വേഡ് ഉപയോഗിക്കാം.</translation>
<translation id="4634575639321169635">ഔദ്യോഗിക അല്ലെങ്കിൽ വ്യക്തിപരമായ ഉപയോഗത്തിനായി ഈ ഉപകരണം സജ്ജീകരിക്കുക</translation>
<translation id="4689235506267737042">നിങ്ങളുടെ ഡെമോ മുൻഗണനകൾ തിരഞ്ഞെടുക്കുക</translation>
<translation id="4727847987444062305">മാനേജ് ചെയ്യപ്പെടുന്ന അതിഥി സെഷൻ</translation>
<translation id="473775607612524610">അപ്ഡേറ്റ് ചെയ്യുക</translation>
<translation id="473936925429402449"><ph name="TOTAL_ELEMENTS" />-ൽ <ph name="CURRENT_ELEMENT" />-ാമത്തെ അധിക ഉള്ളടക്കം തിരഞ്ഞെടുത്തു</translation>
<translation id="4763757134413542119"><ph name="USER_EMAIL" /> ഒരു സാധുവായ Google for Education അക്കൗണ്ട് അല്ല. നിങ്ങളുടെ അഡ്‌മിനെ ബന്ധപ്പെടുക. നിങ്ങൾ അഡ്‌മിൻ ആണെങ്കിൽ, ഇത് സന്ദർശിച്ച് നിങ്ങളുടെ സ്ഥാപനം സജ്ജീകരിക്കാനാകും: g.co/workspace/edusignup</translation>
<translation id="4780558987886269159">ഔദ്യോഗികം</translation>
<translation id="4806457879608775995">ഈ നിബന്ധനകൾ അവലോകനം ചെയ്‌ത് നിങ്ങളുടെ ഡാറ്റ നിയന്ത്രിക്കുക</translation>
<translation id="4809927044794281115">ലൈറ്റ് തീം</translation>
<translation id="4814327014588285482">ഒഴിവാക്കുക, പിന്നീട് എന്നെ ഓർമ്മിപ്പിക്കുക</translation>
<translation id="4830502475412647084">OS അപ്‌ഡേറ്റ് ഇൻസ്‌റ്റാൾ ചെയ്യുന്നു</translation>
<translation id="4837926214103741331">ഈ ഉപകരണം ഉപയോഗിക്കാൻ നിങ്ങൾക്ക് അനുമതിയില്ല. സൈൻ ഇൻ അനുമതിയ്‌ക്കായി ഉപകരണ ഉടമയെ ബന്ധപ്പെടുക.</translation>
<translation id="4844333629810439236">മറ്റ് കീബോർഡുകൾ</translation>
<translation id="484462545196658690">സ്വയമേവ</translation>
<translation id="4864369630010738180">സൈൻ ഇൻ ചെയ്യുന്നു...</translation>
<translation id="4867272607148176509">രക്ഷിതാക്കൾക്ക് ആപ്പുകൾക്ക് അനുമതി നൽകാൻ അല്ലെങ്കിൽ ബ്ലോക്ക് ചെയ്യാനും സമയ പരിധികൾ സജ്ജീകരിക്കാനും വെബ് ബ്രൗസിംഗ് നിയന്ത്രിക്കാനും കഴിയും. മിക്ക സ്കൂൾ വിഭവങ്ങളും ആക്‌സസ് ചെയ്യാൻ പിന്നീട് ഒരു സ്കൂൾ അക്കൗണ്ട് ചേർക്കാവുന്നതാണ്.</translation>
<translation id="4877652723592270843">ChromeOS Flex-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ? അങ്ങനെയെങ്കിൽ, രണ്ട് വോളിയം കീകളും അഞ്ച് സെക്കൻഡ് നേരത്തേക്ക് അമർത്തിപ്പിടിക്കുക.</translation>
<translation id="4899696330053002588">പരസ്യങ്ങൾ ഉണ്ട്</translation>
<translation id="49027928311173603">സെർവറിൽ നിന്നും ഡൗൺലോഡ് ചെയ്‌ത നയം അസാധുവാണ്: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4941246025622441835">ഉപകരണ എന്റർപ്രൈസ് മാനേജ്‍മെന്റിനായി എൻറോൾ ചെയ്യുമ്പോൾ ഈ ഉപകരണ അഭ്യർത്ഥന ഉപയോഗിക്കുക:</translation>
<translation id="4944310289250773232">ഈ പരിശോധിച്ചുറപ്പിക്കൽ സേവനം ഹോസ്‌റ്റ് ചെയ്‌തിരിക്കുന്നത് <ph name="SAML_DOMAIN" /> ആണ്</translation>
<translation id="4955710816792587366">നിങ്ങളുടെ പിൻ തിരഞ്ഞെടുക്കുക</translation>
<translation id="4965808351167763748">Hangouts Meet റൺ ചെയ്യാനായി ഈ ഉപകരണം സജ്ജമാക്കണോ?</translation>
<translation id="4987944280765486504">ഡൗൺലോഡ് പൂർത്തിയായിക്കഴിഞ്ഞാൽ നിങ്ങളുടെ Chromebook റീസ്റ്റാർട്ട് ചെയ്യും, തുടർന്ന് സജ്ജീകരണം തുടരാം.</translation>
<translation id="5029287942302939687">നിങ്ങളുടെ പാസ്‍വേഡ് സജ്ജീകരിച്ചു</translation>
<translation id="503155457707535043">ആപ്പുകൾ ഡൗൺലോഡ് ചെയ്യുന്നു</translation>
<translation id="5045550434625856497">പാസ്‍വേഡ് തെറ്റാണ്</translation>
<translation id="5062930723426326933">സൈൻ ഇൻ പരാജയപ്പെട്ടു, ഇന്റർനെറ്റിൽ കണക്റ്റ് ചെയ്‌തതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5085162214018721575">അപ്‌ഡേറ്റുകൾക്കായി പരിശോധിക്കുന്നു</translation>
<translation id="5097306410549350357">ലൊക്കേഷൻ ഉപയോഗത്തെ കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="5107486920067578245"><ph name="BEGIN_PARAGRAPH1" />Google AI-യുടെ സഹായത്തോടെ എഴുതാനും പ്ലാൻ ചെയ്യാനും പഠിക്കാനും മറ്റും Gemini-യുമായി ചാറ്റ് ചെയ്യൂ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />സജ്ജീകരിച്ചതിന് ശേഷം, നിങ്ങളുടെ സ്ക്രീനിന്റെ താഴെയുള്ള ഷെൽഫിൽ നിന്ന് Gemini ആപ്പ് തിരഞ്ഞെടുത്ത് Gemini ഉപയോഗിച്ച് തുടങ്ങൂ.<ph name="END_PARAGRAPH2" /></translation>
<translation id="5115309401544567011">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> പവർ ഉറവിടത്തിൽ പ്ലഗ് ചെയ്യുക.</translation>
<translation id="5145876360421795017">ഉപകരണം എൻറോൾ ചെയ്യരുത്</translation>
<translation id="5147516217412920887">കോഡ് പരിശോധിച്ചുറപ്പിക്കാൻ നിങ്ങളുടെ ഫോണിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക</translation>
<translation id="5160857336552977725">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="5171185788583376591"><ph name="BEGIN_H3" />ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ<ph name="END_H3" />
          <ph name="BR" />
          നിങ്ങളുടെ ഉപകരണത്തിൽ ഇഷ്ടാനുസൃത കോഡ് ഇൻസ്റ്റാൾ ചെയ്യാനും പരീക്ഷിക്കാനും നിങ്ങളുടെ ChromeOS Flex ഉപകരണത്തിലെ ഡീബഗ് ചെയ്യൽ ഫീച്ചർ പ്രവർത്തനക്ഷമമാക്കാം.  ഇത് ഇനിപ്പറയുന്ന കാര്യങ്ങൾ ചെയ്യാൻ നിങ്ങളെ അനുവദിക്കുന്നു:<ph name="BR" />
          <ph name="BEGIN_LIST" />
            <ph name="LIST_ITEM" />OS ഫയലുകൾ പരിഷ്കരിക്കാനാകുന്നതിന് rootfs പരിശോധിച്ചുറപ്പിക്കൽ നീക്കം ചെയ്യാൻ
            <ph name="LIST_ITEM" />ഉപകരണം ആക്‌സസ് ചെയ്യാൻ <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> പോലുള്ള ടൂളുകൾ ഉപയോഗിക്കാനാകുന്നതിന് സാധാരണ പരീക്ഷണ കീകൾ ഉപയോഗിച്ച് ഉപകരണത്തിലേക്ക് SSH ആക്‌സസ് അനുവദിക്കാൻ
            <ph name="LIST_ITEM" />USB ഡ്രൈവിൽ നിന്ന് OS ചിത്രം ഇൻസ്റ്റാൾ ചെയ്യാനാകുന്നതിന് USB-യിൽ നിന്ന് ബൂട്ട് ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കാൻ
            <ph name="LIST_ITEM" />ഉപകരണത്തിലേക്ക് നേരിട്ട് SSH ചെയ്യാൻ dev, സിസ്റ്റം റൂട്ട് ലോഗിൻ പാസ്‌വേഡുകൾ ഇഷ്ടാനുസൃത മൂല്യത്തിലേക്ക് സജ്ജീകരിക്കാൻ
          <ph name="END_LIST" />
          <ph name="BR" />
          പ്രവർത്തനക്ഷമമാക്കിയ ശേഷം, എന്റർപ്രൈസ് മാനേജ് ചെയ്യുന്ന ഉപകരണത്തിലെ വിവരങ്ങൾ പവർവാഷ് ചെയ്യുകയോ ഡാറ്റ മായ്ക്കുകയോ ചെയ്തതിന് ശേഷവും മിക്ക ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളും പ്രവർത്തനക്ഷമമായി തുടരും. എല്ലാ ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളും പൂർണ്ണമായും പ്രവർത്തനരഹിതമാക്കാൻ, ChromeOS വീണ്ടെടുക്കൽ പ്രക്രിയ പൂർത്തിയാക്കുക (https://support.google.com/chromebook/answer/1080595).
          <ph name="BR" />
          <ph name="BR" />
          ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകളെ കുറിച്ചുള്ള കൂടുതൽ വിവരങ്ങൾക്ക് ഇത് കാണുക:<ph name="BR" />
          https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
          <ph name="BR" />
          <ph name="BR" />
          <ph name="BEGIN_BOLD" />ശ്രദ്ധിക്കുക:<ph name="END_BOLD" />  പ്രോസസിനിടെ സിസ്റ്റം റീബൂട്ട് ചെയ്യും.</translation>
<translation id="5215502535566372932">രാജ്യം തിരഞ്ഞെടുക്കുക</translation>
<translation id="5234523649284990414">സംഭാഷണ സിന്തസൈസർ അല്ലെങ്കിൽ ബ്രെയ്‌ലി ഡിസ്‌പ്ലേയുടെ സഹായത്തോടെ സ്ക്രീനിൽ കാണിക്കുന്ന ടെക്‌സ്റ്റ് വായിക്കാൻ അന്ധതയോ കാഴ്ചക്കുറവോ ഉള്ള ആളുകളാണ് ChromeOS, ChromeVox എന്നിവയിലെ സ്ക്രീൻ റീഡർ പ്രധാനമായും ഉപയോഗിക്കുന്നത്. ChromeVox ഓണാക്കാൻ സ്പേസ് ബാർ അമർത്തുക. ChromeVox സജീവമായിക്കഴിഞ്ഞാൽ, ദ്രുത ടൂർ വഴി നിങ്ങൾക്ക് അതേക്കുറിച്ച് അറിയാനാകും.</translation>
<translation id="523505283826916779">ഉപയോഗസഹായി ക്രമീകരണങ്ങൾ</translation>
<translation id="5240931875940563122">Android ഫോൺ ഉപയോഗിച്ച് സെെൻ ഇൻ ചെയ്യൂ</translation>
<translation id="5255859108402770436">വീണ്ടും സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="5260508466980570042">ക്ഷമിക്കൂ, നിങ്ങളുടെ ഇമെയില്‍ അല്ലെങ്കില്‍ പാസ്‍വേഡ് പരിശോധിച്ചുറപ്പിക്കാൻ കഴിഞ്ഞില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5264252276333215551">കിയോസ്‌ക് മോഡിൽ നിങ്ങളുടെ ആപ്പ് ലോഞ്ച് ചെയ്യാൻ ഇന്റർനെറ്റിൽ കണക്റ്റ് ചെയ്യുക.</translation>
<translation id="528208740344463258">Android ആപ്പുകൾ ഡൗൺലോഡ് ചെയ്‌ത് ഉപയോഗിക്കാൻ ആദ്യം നിങ്ങൾ ഈ ആവശ്യമായ അപ്‌ഡേറ്റ് ഇൻസ്‌റ്റാൾ ചെയ്യേണ്ടതുണ്ട്. <ph name="DEVICE_TYPE" /> അപ്ഡേറ്റ് ചെയ്യുമ്പോൾ, നിങ്ങൾക്കത് ഉപയോഗിക്കാനാവില്ല. ഇൻസ്റ്റലേഷൻ പൂർത്തിയായി കഴിയുമ്പോൾ, നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> റീസ്റ്റാർട്ട് ചെയ്യും.</translation>
<translation id="5283677936944177147">ക്ഷമിക്കണം! സിസ്റ്റത്തിന് ഉപകരണ മോഡലോ സീരിയൽ നമ്പറോ കണ്ടെത്താനായില്ല.</translation>
<translation id="5333896723098573627">ആപ്പുകൾ നീക്കം ചെയ്യാൻ, ക്രമീകരണം &gt; ആപ്പുകൾ &gt; Google Play Store &gt; Android മുൻഗണനകൾ മാനേജ് ചെയ്യുക &gt; ആപ്പുകൾ അല്ലെങ്കിൽ ആപ്പ് മാനേജർ എന്നതിലേക്ക് പോകുക. തുടർന്ന് നിങ്ങൾക്ക് അൺഇൻസ്റ്റാൾ ചെയ്യേണ്ട ആപ്പിൽ ടാപ്പ് ചെയ്യുക (ആപ്പ് കണ്ടെത്താൻ നിങ്ങൾക്ക് വലത്തോട്ടോ ഇടത്തോട്ടോ സ്വൈപ്പ് ചെയ്യേണ്ടി വന്നേക്കാം). തുടർന്ന് അൺഇൻസ്റ്റാൾ ചെയ്യുക അല്ലെങ്കിൽ പ്രവർത്തനരഹിതമാക്കുക ടാപ്പ് ചെയ്യുക.</translation>
<translation id="5355501370336370394">എന്റർപ്രൈസ് ഉപകരണം എൻറോൾ ചെയ്യുക</translation>
<translation id="5372529912055771682">വിതരണം ചെയ്‌ത എൻറോൾമെന്റ് മോഡിനെ ഈ ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ പതിപ്പ് പിന്തുണയ്‌ക്കുന്നില്ല. പുതിയ പതിപ്പിലാണ് നിങ്ങൾ പ്രവർത്തിക്കുന്നതെന്ന് ഉറപ്പുവരുത്തി വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5397378439569041789">കിയോസ്‌ക് അല്ലെങ്കിൽ സൈനേജ് ഉപകരണം എൻറോൾ ചെയ്യുക</translation>
<translation id="5397794290049113714">നിങ്ങള്‍</translation>
<translation id="5411022484772257615">സ്‌കൂൾ എൻറോൾമെന്റ് പൂർത്തിയാക്കാനായില്ല</translation>
<translation id="5413640305322530561">പ്രശ്‌നനിർണ്ണയ, ഉപയോഗ വിവരങ്ങളെ കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="542750953150239272">തുടരുന്നതിലൂടെ, ഈ ഉപകരണം Google-ൽ നിന്നും നിങ്ങളുടെ കാരിയറിൽ നിന്നും ഉപകരണ നിർമ്മാതാവിൽ നിന്നും, ഒരുപക്ഷേ സെല്ലുലാർ ഡാറ്റ ഉപയോഗിച്ച്, അപ്ഡേറ്റുകളും ആപ്പുകളും സ്വയമേവ ഡൗൺലോഡും ഇൻസ്റ്റാളും ചെയ്തേക്കാമെന്നും നിങ്ങൾ അംഗീകരിക്കുന്നു. ഈ ആപ്പുകളിൽ ചിലത് ആപ്പ് വഴി വാങ്ങാനുള്ള സൗകര്യം നൽകിയേക്കാം.</translation>
<translation id="542948651837270806">പരിചിത പ്ലാറ്റ്‌ഫോം മൊഡ്യൂൾ ഫേംവെയറിനുള്ള അപ്‌ഡേറ്റ് ഇൻസ്‌റ്റാൾ ചെയ്യേണ്ടതുണ്ട്. <ph name="TPM_FIRMWARE_UPDATE_LINK" /> കാണുക</translation>
<translation id="5448293924669608770">ക്ഷമിക്കണം, സൈൻ ഇൻ ചെയ്യുമ്പോൾ എന്തോ തെറ്റായി സംഭവിച്ചു</translation>
<translation id="5453829744223920473">നിങ്ങളുടെ കുട്ടിക്ക് അവരുടെ എല്ലാ സ്കൂൾ ആപ്പുകളും ബുക്ക്‌മാർക്കുകളും വിഭവങ്ങളും ക്ലാസിൽ ചെയ്യുന്നതുപോലെ ഉപയോഗിക്കാനാകും. അടിസ്ഥാന നയങ്ങൾ സജ്ജീകരിക്കുന്നത് സ്കൂളാണ്.</translation>
<translation id="5463450804024056231"><ph name="DEVICE_TYPE" /> ഇമെയിലുകൾക്ക് സൈന്‍ അപ്പ് ചെയ്യുക</translation>
<translation id="5473099001878321374">തുടരുന്നതിലൂടെ, Google, നിങ്ങളുടെ കുട്ടിയുടെ മൊബൈൽ സേവനദാതാവ്, ഈ ഉപകരണത്തിന്റെ നിർമ്മാതാവ് എന്നിവരിൽ നിന്ന് ഈ ഉപകരണം, ഒരു പക്ഷേ സെല്ലുലാർ ഡാറ്റ ഉപയോഗിച്ച് അപ്ഡേറ്റുകളും ആപ്പുകളും സ്വയമേവ ഡൗൺലോഡോ ഇൻസ്റ്റാളോ ചെയ്തേക്കാമെന്ന് നിങ്ങൾ അംഗീകരിക്കുന്നു. ഇവയിൽ ചില ആപ്പുകൾ, ആപ്പ് വഴിയുള്ള വാങ്ങലുകൾ ഓഫർ ചെയ്യുന്നവയാകാം.</translation>
<translation id="5502915260472117187">കുട്ടി</translation>
<translation id="5511823366942919280">"ഷാർക്ക്" എന്ന പേരിൽ ഈ ഉപകരണം സജ്ജീകരിക്കണമെന്ന് തീർച്ചയാണോ?</translation>
<translation id="5513807280330619196">കാൽക്കുലേറ്റർ</translation>
<translation id="5527474464531963247">നിങ്ങൾക്ക് മറ്റൊരു നെറ്റ്‌വർക്കും തിരഞ്ഞെടുക്കാവുന്നതാണ്.</translation>
<translation id="5539070192556911367">Google-ൽ എത്തിച്ചേരാനാകുന്നില്ല</translation>
<translation id="5549511085333906441">നിങ്ങളുടെ സജ്ജീകരണം തിരഞ്ഞെടുക്കുക</translation>
<translation id="5554403733534868102">ഇതിന് ശേഷം അപ്‌ഡേറ്റുകൾക്ക് കാത്തിരിക്കേണ്ടതില്ല</translation>
<translation id="557722062034137776">നിങ്ങളുടെ ഉപകരണം റീസെറ്റ് ചെയ്യുന്നത് Google അക്കൗണ്ടുകളെയോ ഈ അക്കൗണ്ടുകളിൽ സമന്വയിപ്പിച്ചിരിക്കുന്ന മറ്റേതെങ്കിലും ഡാറ്റയെയോ ബാധിക്കില്ല. എന്നിരുന്നാലും, നിങ്ങളുടെ ഉപകരണത്തിൽ പ്രാദേശികമായി സംരക്ഷിച്ച എല്ലാ ഫയലുകളും ഇല്ലാതാക്കും.</translation>
<translation id="5600348067066185292">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിന് അൽപ്പം ചില ഘട്ടങ്ങൾ മാത്രമേ എടുക്കൂ. നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ മാറ്റങ്ങൾ വരുത്തും മുമ്പ് അത് സ്ഥിരീകരിക്കാൻ നിങ്ങൾക്ക് ഒരു അവസരം കൂടി ലഭിക്കും.</translation>
<translation id="5626172233890210551">പകരം പാസ്‌വേഡ് ഉപയോഗിക്കുക</translation>
<translation id="5631304855083152608"><ph name="BEGIN_PARAGRAPH1" />ഏറ്റവും മികച്ച അനുഭവം ലഭ്യമാക്കാൻ, <ph name="DEVICE_OS" />ഉപകരണങ്ങളുടെ ഹാർഡ്‌വെയർ ഡാറ്റ ശേഖരിക്കുകയും ലഭ്യമാക്കേണ്ട അപ്ഡേറ്റുകൾ കണ്ടെത്താൻ അത് Google-മായി പങ്കിടുകയും ചെയ്യുന്നു. <ph name="DEVICE_OS" /> അനുഭവത്തിനും സേവനത്തിനും പിന്തുണ നൽകുന്നതും മെച്ചപ്പെടുത്തലുകൾ വരുത്തുന്നതും പോലുള്ള അധിക ആവശ്യങ്ങൾക്ക് ഈ ഡാറ്റ ഉപയോഗിക്കാൻ Google-നെ അനുവദിക്കുന്നത് നിങ്ങൾക്ക് ഓപ്ഷണലായി തിരഞ്ഞെടുക്കാനാകും.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />അപ്ഡേറ്റ് ഫിൽട്ടറിംഗ് പ്രക്രിയയ്ക്കായി Google-ലേക്ക് അയയ്ക്കുന്ന ഡാറ്റയും നിങ്ങൾ Google-മായി ഡാറ്റ പങ്കിടാൻ തിരഞ്ഞെടുത്തിട്ടുള്ള മറ്റ് സന്ദർഭങ്ങളും കാണാൻ, ഈ ഉപകരണത്തിൽ ലോഗിൻ ചെയ്ത് chromeosflex_ in chrome://system എന്നതായി ലിസ്റ്റ് ചെയ്തിരിക്കുന്ന ഫീൽഡുകൾ കാണുക.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" /><ph name="DEVICE_OS" /> Google-മായി ഡാറ്റ പങ്കിടുന്നതിനെയും അതിന്റെ ഉപയോഗത്തെയും കുറിച്ചുള്ള കൂടുതൽ വിവരങ്ങൾക്ക് g.co/flex/HWDataCollection സന്ദർശിക്കുക.<ph name="END_PARAGRAPH3" /></translation>
<translation id="5636996382092289526"><ph name="NETWORK_ID" /> ഉപയോഗിക്കുന്നതിന് നിങ്ങൾ ആദ്യം <ph name="LINK_START" />നെറ്റ്‌വർക്കിന്റെ സൈൻ-ഇൻ പേജ് സന്ദർശിക്കേണ്ടതുണ്ട്<ph name="LINK_END" />, അത് കുറച്ച് സെക്കൻഡിനുള്ളിൽ സ്വയമേവ തുറക്കും. അങ്ങനെ സംഭവിച്ചില്ലെങ്കിൽ, നെറ്റ്‌വർക്ക് ഉപയോഗിക്കാനാകില്ല.</translation>
<translation id="5641608986289282154"><ph name="DEVICE_OS" /> ഉപയോഗിച്ച് തുടങ്ങുക</translation>
<translation id="5655296450510165335">ഉപകരണ എൻറോൾമെന്റ്</translation>
<translation id="565899488479822148">ഏറ്റവും പുതിയ അപ്ഡേറ്റ് ഇൻസ്റ്റാൾ ചെയ്യുന്നു</translation>
<translation id="5659964844710667266">ഈ <ph name="DEVICE_TYPE" /> എന്നതിന് പാസ്‌വേഡ് സൃഷ്‌ടിക്കുക</translation>
<translation id="5684661240348539843">അസറ്റ് ഐഡന്റിഫയർ</translation>
<translation id="5684950556880280580">നിങ്ങളുടെ പാസ്‍വേഡ് അപ്ഡേറ്റ് ചെയ്തു</translation>
<translation id="5687326903064479980">സമയമേഖല</translation>
<translation id="5687935527303996204">നിങ്ങളുടെ ഉപകരണം പ്ലഗ് ഇൻ ചെയ്തിട്ടുണ്ടെന്ന് ഉറപ്പാക്കുക, ഉപകരണം ഓഫാക്കുകയും അരുത്. ഇൻസ്റ്റാൾ ചെയ്യാൻ 20 മിനിറ്റ് വരെയെടുത്തേക്കാം. ഇൻസ്റ്റാൾ പൂർത്തിയാകുമ്പോൾ നിങ്ങളുടെ ഉപകരണം സ്വയമേവ ഷട്ട് ഡൗൺ ചെയ്യും.</translation>
<translation id="5705882733397021510">മടങ്ങുക</translation>
<translation id="5711010025974903573">സേവന ലോഗുകൾ</translation>
<translation id="5762787084360227629">Google Account വിവരങ്ങൾ നൽകുക</translation>
<translation id="5764797882307050727">നിങ്ങളുടെ ഉപകരണത്തിൽ കുറച്ച് ഇടം സൃഷ്‌ടിക്കുക.</translation>
<translation id="5765425701854290211">ക്ഷമിക്കണം, ചില ഫയലുകൾ കേടായതിനാൽ അപ്‌ഡേറ്റ് ചെയ്യാനായില്ല. നിങ്ങളുടെ സമന്വയിപ്പിച്ച ഫയലുകൾ സുരക്ഷിതമാണ്.</translation>
<translation id="5770125698810550803">നാവിഗേഷൻ ബട്ടണുകൾ കാണിക്കുക</translation>
<translation id="5793339252089865437">മൊബൈൽ നെറ്റ്‌വർക്ക് ഉപയോഗിച്ച് അ‌പ്‌ഡേറ്റ് ഡൗൺലോഡ് ചെയ്‌താൽ, അത് അധിക നിരക്കുകൾക്കിടയാക്കും.</translation>
<translation id="5799478978078236781"><ph name="DEVICE_TYPE" /> നുറുങ്ങുകളും ഓഫറുകളും അപ്‌ഡേറ്റുകളും നേടുകയും ഫീഡ്‌ബാക്ക് പങ്കിടുകയും ചെയ്യുക.</translation>
<translation id="5800703268655655701">ലൈറ്റ് അല്ലെങ്കിൽ ഡാർക്ക് തീം തിരഞ്ഞെടുക്കുക</translation>
<translation id="5804259315582798390">ലോക്കൽ ഡാറ്റ വീണ്ടെടുക്കൽ പ്രവർത്തനക്ഷമമാക്കാനായില്ല</translation>
<translation id="5810809306422959727">രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾക്ക് ഈ അക്കൗണ്ട് യോഗ്യമല്ല</translation>
<translation id="5819206523222900309"><ph name="BEGIN_DESCRIPTION" />നിങ്ങളുടെ സ്ഥാപനത്തിൽ നിങ്ങളുടെ ഉപകരണങ്ങൾ എൻറോൾ ചെയ്യുന്നത്, കേന്ദ്രീകൃത ഉപകരണ മാനേജ്മെന്റിനായി അത് സജ്ജീകരിക്കുന്നു. ഒന്നിലധികം കാരണങ്ങളാൽ നിങ്ങളുടെ സ്ഥാപനത്തിന് എൻറോൾമെന്റ് ആവശ്യമായി വന്നേക്കാം:<ph name="END_DESCRIPTION" />
        <ph name="BEGIN_SUBTITLE1" /><ph name="BEGIN_BOLD" />സുരക്ഷ മെച്ചപ്പെടുത്താൻ<ph name="END_BOLD" /><ph name="END_SUBTITLE1" />
        <ph name="BEGIN_DESCRIPTION1" />അധിക സുരക്ഷാ ക്രമീകരണം കോൺഫിഗർ ചെയ്യുന്നതിലൂടെ, സ്ഥാപനത്തിന് ഉപയോക്താവിന്റെയും ഉപകരണത്തിന്റെയും ഡാറ്റ സുരക്ഷിതമായി സൂക്ഷിക്കാൻ കഴിയും. റിമോട്ട് റീസെറ്റ്, നഷ്‌ടപ്പെട്ട ഉപകരണം പ്രവർത്തനരഹിതമാക്കല്‍ എന്നിവ പോലുള്ള പ്രവർത്തനങ്ങളും ഇതിന് ചെയ്യാൻ കഴിയും.<ph name="END_DESCRIPTION1" />
        <ph name="BEGIN_SUBTITLE2" /><ph name="BEGIN_BOLD" />അനുഭവം ഇഷ്ടാനുസൃതമാക്കാൻ<ph name="END_BOLD" /><ph name="END_SUBTITLE2" />
        <ph name="BEGIN_DESCRIPTION2" />ബൂട്ടപ്പിലും ലോഗിൻ സ്ക്രീനിലും ലോഗിൻ ചെയ്തതിന് ശേഷവും ഉപകരണത്തിന്റെ സ്വഭാവം സ്ഥാപനത്തിന്റെ ആവശ്യങ്ങൾക്ക് അനുസരിച്ച് ക്രമീകരിക്കാം.<ph name="END_DESCRIPTION2" />
        <ph name="BEGIN_SUBTITLE3" /><ph name="BEGIN_BOLD" />പിന്തുണ നൽകാൻ<ph name="END_BOLD" /><ph name="END_SUBTITLE3" />
        <ph name="BEGIN_DESCRIPTION3" />ട്രബിൾഷൂട്ടിംഗ് നൽകുന്നതിന് സ്ഥാപനത്തിന് ഉപകരണ സെഷൻ വിദൂരമായി ആക്സസ് ചെയ്യാൻ കഴിയും.<ph name="END_DESCRIPTION3" />
        <ph name="BEGIN_SUBTITLE4" /><ph name="BEGIN_BOLD" />ആക്‌സസ് പ്രവർത്തനക്ഷമമാക്കാൻ<ph name="END_BOLD" /><ph name="END_SUBTITLE4" />
        <ph name="BEGIN_DESCRIPTION4" />എൻറോൾ ചെയ്ത ഉപകരണങ്ങളിൽ മാത്രമേ സ്ഥാപനത്തിന്റെ ആപ്പുകൾ, സേവനങ്ങൾ, നെറ്റ്‌വർക്കുകൾ എന്നിവ ലഭ്യമാകൂ.<ph name="END_DESCRIPTION4" /></translation>
<translation id="5834581999798853053">ഏകദേശം <ph name="TIME" /> മിനിറ്റ് ശേഷിക്കുന്നു</translation>
<translation id="5852112051279473187">ക്ഷമിക്കണം! ഈ ഉപാധി എന്‍‌റോള്‍ ചെയ്യാന്‍ ശ്രമിക്കുന്നതിനിടയില്‍ എന്തോ കാര്യമായ തെറ്റ് സംഭവിച്ചിരിക്കുന്നു. ദയവായി വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കില്‍ നിങ്ങളുടെ പിന്തുണാ പ്രതിനിധിയുമായി ബന്ധപ്പെടുക.</translation>
<translation id="5852137567692933493">പുനരാരംഭിച്ച് പവർവാഷ് ചെയ്യുക</translation>
<translation id="5856721540245522153">ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="5860033963881614850">ഓഫാക്കുക</translation>
<translation id="5860491529813859533">ഓൺ ചെയ്യുക</translation>
<translation id="5863445608433396414">ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പ്രവർത്തനക്ഷമമാക്കുക</translation>
<translation id="5870086504539785141">ഉപയോഗസഹായി മെനു അടയ്ക്കുക</translation>
<translation id="5895138241574237353">പുനരാരംഭിക്കുക</translation>
<translation id="5895335062901455404">നിങ്ങളുടെ Google Account ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുമ്പോൾ ഏതൊരു ChromeOS Flex ഉപകരണത്തിലും നിങ്ങൾ സംരക്ഷിച്ച മുൻഗണനകളും ആക്റ്റിവിറ്റിയും തയ്യാറായിരിക്കും. എന്തൊക്കെ സമന്വയിപ്പിക്കണമെന്നത് ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് തിരഞ്ഞെടുക്കാം.</translation>
<translation id="5916664084637901428">ഓൺ ചെയ്യുക</translation>
<translation id="5919305207330938913">ശേഖരിച്ച എല്ലാ ഡാറ്റയും Google-ന്റെ <ph name="BEGIN_LINK" />സ്വകാര്യതാ നയം<ph name="END_LINK" /> അനുസരിച്ച് ഉപയോഗിക്കും.</translation>
<translation id="5932441198730183141">ഈ Google Meet ഹാർഡ്‌വെയർ ഉപകരണം എൻറോൾ ചെയ്യാൻ ആവശ്യമായ ലൈസൻസുകൾ നിങ്ങൾക്ക് ഇല്ല. കൂടുതൽ വാങ്ങാൻ വിൽപ്പന വിഭാഗത്തെ ബന്ധപ്പെടുക. പിശക് കാരണമാണ് ഈ സന്ദേശം കാണുന്നതെന്ന് നിങ്ങൾ കരുതുന്നുവെങ്കിൽ പിന്തുണയുമായി ബന്ധപ്പെടുക.</translation>
<translation id="5933376509899483611">സമയമേഖല</translation>
<translation id="5939518447894949180">റീസെറ്റ് ചെയ്യുക</translation>
<translation id="5948536763493709626">ഒരു കീബോർഡോ മൗസോ കണക്റ്റ് ചെയ്യുക അല്ലെങ്കിൽ നിങ്ങളുടെ ടച്ച്സ്ക്രീൻ ഉപയോഗിച്ച് സജ്ജീകരണം തുടരുക. നിങ്ങൾ Bluetooth ഉപകരണങ്ങളാണ് ഉപയോഗിക്കുന്നതെങ്കിൽ, നിങ്ങളുടെ ഉപകരണങ്ങൾ ജോടിയാക്കാൻ തയ്യാറാണെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="5959471481388474538">നെറ്റ്‌വർക്ക് ലഭ്യമല്ല</translation>
<translation id="6016178549409952427"><ph name="TOTAL_ELEMENTS" />-ൽ <ph name="CURRENT_ELEMENT" />-ാമത്തെ അധിക ഉള്ളടക്കത്തിലേക്ക് നാവിഗേറ്റ് ചെയ്യുക</translation>
<translation id="6016972670657536680">ഭാഷയും കീബോർഡും ബട്ടൺ തിരഞ്ഞെടുക്കുക. നിലവിൽ തിരഞ്ഞെടുത്ത ഭാഷ <ph name="LANGUAGE" /> ആണ്.</translation>
<translation id="6040143037577758943">അടയ്ക്കുക</translation>
<translation id="6042193169866365541">Gmail, YouTube, Chrome, മറ്റ് Google ഉൽപ്പന്നങ്ങൾ എന്നിവയ്‌ക്കായി നിങ്ങൾ ഉപയോഗിക്കുന്ന അക്കൗണ്ട്, നിങ്ങളുടെ Google Account തന്നെയാണ്.
        എല്ലാ ബുക്ക്‌മാര്‍ക്കുകളും ഫയലുകളും മറ്റും എളുപ്പത്തിൽ ആക്സസ് ചെയ്യാൻ നിങ്ങളുടെ അക്കൗണ്ട് ഉപയോഗിക്കുക. നിങ്ങൾക്ക് അക്കൗണ്ട് ഇല്ലെങ്കിൽ, അടുത്ത സ്ക്രീനിൽ നിങ്ങൾക്ക് ഒരെണ്ണം സൃഷ്ടിക്കാം.</translation>
<translation id="6051354611314852653">ക്ഷമിക്കണം! ഈ ഉപകരണത്തിന്റെ API ആക്‌സസ് അംഗീകൃതമാക്കുന്നതിൽ സിസ്റ്റം പരാജയപ്പെട്ടു.</translation>
<translation id="6055544610007596637">Google Play Store-ൽ നിന്ന് നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിനായി ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യുക</translation>
<translation id="6069464830445383022">നിങ്ങളുടെ Chromebook-ലേക്ക് സെെൻ ഇൻ ചെയ്യാൻ നിങ്ങളുടെ Google അക്കൗണ്ടാണ് ഉപയോഗിക്കുന്നത്</translation>
<translation id="6071181508177083058">പാസ്‌വേഡ് സ്ഥിരീകരിക്കുക</translation>
<translation id="6075731018162044558">ക്ഷമിക്കണം!  ഈ ഉപകരണത്തിനായി ദീർഘകാല API ആക്‌സസ് ടോക്കൺ നേടുന്നതിൽ സിസ്റ്റം പരാജയപ്പെട്ടു.</translation>
<translation id="6093888419484831006">അപ്‌ഡേറ്റ് റദ്ദാക്കുന്നു...</translation>
<translation id="6125479973208104919">നിർഭാഗ്യവശാൽ ഈ <ph name="DEVICE_TYPE" /> ഉപകരണത്തിൽ വീണ്ടും നിങ്ങളുടെ അക്കൗണ്ട് ചേർക്കേണ്ടതുണ്ട്.</translation>
<translation id="6165508094623778733">കൂടുതലറിയുക</translation>
<translation id="6170498031581934115">ADB ഡീബഗ് ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കാനായില്ല. ക്രമീകരണത്തിലേക്ക് പോയി വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="6172020488605056255">'എന്നെ വായിക്കാൻ സഹായിക്കൂ' ഉപയോഗിക്കാൻ വലത്-ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="6173623053897475761">നിങ്ങളുടെ പിൻ വീണ്ടും ടൈപ്പ് ചെയ്യുക</translation>
<translation id="6185132558746749656">ഉപകരണ ലൊക്കേഷൻ</translation>
<translation id="6202304368170870640">ഉപകരണത്തിൽ സൈൻ ഇൻ ചെയ്യാനോ അൺലോക്ക് ചെയ്യാനോ നിങ്ങളുടെ പിൻ ഉപയോഗിക്കാം.</translation>
<translation id="6209908325007204267">നിങ്ങളുടെ ഉപകരണത്തിൽ Chrome എന്റർപ്രൈസ് അപ്‌ഗ്രേഡ് ഉൾപ്പെടുന്നു, എന്നാൽ നിങ്ങളുടെ ഉപയോക്തൃനാമം ഒരു എന്റർപ്രൈസ് അക്കൗണ്ടുമായി ബന്ധപ്പെട്ടതല്ല. മറ്റൊരു ഉപകരണത്തിൽ g.co/ChromeEnterpriseAccount സന്ദർശിച്ച് എന്റർപ്രൈസ് അക്കൗണ്ട് സൃഷ്‌ടിക്കുക.</translation>
<translation id="623261264391834964">'എന്നെ എഴുതാൻ സഹായിക്കൂ' ഉപയോഗിക്കുന്നതിന് ടെക്സ്റ്റ് ബോക്‌സിൽ വലത്-ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="6264520534872750757">ഉപകരണം തുടർന്നും ഉപയോഗിക്കുക</translation>
<translation id="6280215091796946657">മറ്റൊരു അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="6283823201263716145">ഫീച്ചറുകളും പ്രകടനവും മെച്ചപ്പെടുത്താൻ, ഡെമോ മോഡ് ഉപകരണങ്ങൾ ക്രാഷ് റിപ്പോർട്ടുകളും പ്രശ്നനിർണ്ണയ, ഉപയോഗ ഡാറ്റയും സ്വയമേവ Google-ന് അയയ്ക്കുന്നു.</translation>
<translation id="6287713404380454515">സുരക്ഷാ കാരണങ്ങളാൽ, നിങ്ങളുടെ അഡ്‌മിൻ നിങ്ങളുടെ ഉപകരണ പിന്നും പാസ്‌വേഡും പ്രവർത്തനരഹിതമാക്കി. ഇപ്പോൾ മുതൽ, നിങ്ങളുടെ <ph name="MANAGER" /> പാസ്‌വേഡ് ഉപയോഗിക്കുക.</translation>
<translation id="6301300352769835063"><ph name="DEVICE_OS" /> മെച്ചപ്പെടുത്തുന്നതിന് നിങ്ങളുടെ ഹാർഡ്‌വെയർ ഡാറ്റ ഉപയോഗിക്കാൻ Google-നെ അനുവദിക്കുക. നിങ്ങൾ നിരസിച്ചാൽ, ശരിയായ അപ്ഡേറ്റുകൾ കണ്ടെത്താൻ Google-ന് ഈ ഡാറ്റ അയയ്ക്കുമെങ്കിലും മറ്റ് കാര്യങ്ങൾക്കായി സംഭരിക്കുകയോ ഉപയോഗിക്കുകയോ ഇല്ല. g.co/flex/HWDataCollection -ൽ കൂടുതലറിയുക.</translation>
<translation id="6308493641021088955">സൈൻ ഇൻ ലഭ്യമാക്കിയത് <ph name="EXTENSION_NAME" /></translation>
<translation id="6314819609899340042">നിങ്ങൾ ഈ <ph name="IDS_SHORT_PRODUCT_NAME" /> ഉപകരണത്തിലെ ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പ്രവർത്തനക്ഷമമാക്കി.</translation>
<translation id="6343262564968371601">Google, ഫയലുകൾ, ആപ്പുകൾ എന്നിവയും മറ്റും തിരഞ്ഞ് നിങ്ങൾ തിരയുന്ന കാര്യങ്ങൾ കണ്ടെത്തുക</translation>
<translation id="635609604405270300">ഉപകരണം ഓഫാക്കരുത്</translation>
<translation id="6363786367719063276">ലോഗുകൾ കാണുക</translation>
<translation id="6367097275976877956">ChromeOS-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ? അങ്ങനെയെങ്കിൽ, സ്പെയ്‌സ് ബാർ അമർത്തുക.</translation>
<translation id="636850387210749493">സംരംഭ വിവരപ്പട്ടിക</translation>
<translation id="6380143666419481200">അംഗീകരിച്ച് തുടരുക</translation>
<translation id="640457954117263537">ChromeOS, Android ആപ്പുകൾക്കും സേവനങ്ങൾക്കുമായി ലൊക്കേഷൻ ഉപയോഗിക്കുക.</translation>
<translation id="6418311015934520372"><ph name="BEGIN_PARAGRAPH1" />സ്വയമേവയുള്ള റിപ്പോർട്ടുകൾ അയയ്ക്കാൻ നിങ്ങളുടെ ChromeOS ഉപകരണങ്ങളെ അനുവദിക്കുന്നത്, ChromeOS-ൽ പരിഹരിക്കേണ്ടവയ്ക്കും മെച്ചപ്പെടുത്തേണ്ടവയ്ക്കും മുൻഗണന നൽകാൻ ഞങ്ങളെ സഹായിക്കുന്നു. ChromeOS എപ്പോഴാണ് ക്രാഷാകുന്നത്, ഏതൊക്കെ ഫീച്ചറുകളാണ് നിങ്ങൾ ഉപയോഗിക്കുന്നത്, സാധാരണ ഗതിയിൽ നിങ്ങൾ ഉപയോഗിക്കുന്ന മെമ്മറിയുടെ അളവ് എത്രയാണ് എന്നിവ പോലുള്ള കാര്യങ്ങൾ ഈ റിപ്പോർട്ടിൽ ഉൾപ്പെടാം.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളുടെ Chrome ഉപകരണ ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഈ റിപ്പോർട്ടുകൾ അനുവദിക്കാൻ തുടങ്ങുകയോ നിർത്തുകയോ ചെയ്യാം. നിങ്ങളൊരു ഡൊമെയ്ൻ അഡ്മിനിസ്ട്രേറ്റർ ആണെങ്കിൽ, അഡ്മിൻ കൺസോളിൽ ഈ ക്രമീകരണം നിങ്ങൾക്ക് മാറ്റാനാകും.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6418511932144861495">സുപ്രധാന അപ്‌ഡേറ്റുകൾ ഇൻസ്‌റ്റാൾ ചെയ്യുക</translation>
<translation id="6452251728599530347"><ph name="PERCENT" /> പൂർത്തിയായി</translation>
<translation id="6478849105642611893">tab കീയുടെ താഴെയാണ് ക്വിക്ക് ഇൻസേർട്ട് കീ സ്ഥിതി ചെയ്യുന്നത്</translation>
<translation id="6480327114083866287"><ph name="MANAGER" /> മാനേജ് ചെയ്യുന്നത്</translation>
<translation id="6488384360522318064">ഭാഷ തിരഞ്ഞെടുക്കുക</translation>
<translation id="6495266441917713704">വൈഫൈ കൈമാറാനാകുന്നില്ല</translation>
<translation id="6515620015470298987">ഉപകരണ ക്രമീകരണത്തിന്റെ പരിശോധനയുമായി ബന്ധപ്പെട്ട പ്രശ്നം കാരണം സൈൻ ഇൻ ചെയ്യാനായില്ല. നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> പവർവാഷ് ചെയ്ത് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="6519689855001245063">യോഗ്യത പരിശോധിക്കുന്നു</translation>
<translation id="6532527800157340614">നിങ്ങളുടെ ആക്സസ് ടോക്കൺ വീണ്ടെടുക്കാനാവാത്തതിനാൽ സൈൻ ഇൻ ചെയ്യാനായില്ല. നിങ്ങളുടെ നെറ്റ്‌വർക്ക് കണക്ഷൻ പരിശോധിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="653920215766444089">പോയിന്റ് ചെയ്യുന്ന ഉപകരണം തിരയുന്നു</translation>
<translation id="65513682072153627">നിങ്ങളുടെ അഡ്‌മിൻ, ക്രമീകരണമോ ഫീച്ചറോ മാനേജ് ചെയ്യുമ്പോൾ നിങ്ങൾക്ക് ഈ 'മാനേജ് ചെയ്യുന്നു' ഐക്കൺ കാണാം.</translation>
<translation id="6561726789132298588">എന്റർ</translation>
<translation id="6607890859198268021"><ph name="USER_EMAIL" /> ഇപ്പോൾ തന്നെ <ph name="DOMAIN" /> മാനേജ് ചെയ്യുന്നുണ്ട്. മറ്റൊരു അക്കൗണ്ടിൽ രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ഉപയോഗിക്കാൻ, സജ്ജീകരിച്ചതിനുശേഷം സൈൻ ഔട്ട് ചെയ്യുക, തുടർന്ന് സൈൻ-ഇൻ സ്ക്രീനിൽ "വ്യക്തിയെ ചേർക്കുക" തിരഞ്ഞെടുക്കുക.</translation>
<translation id="6642720633335369752">തുറന്നിരിക്കുന്ന എല്ലാ ആപ്പ് വിൻഡോകളും കാണാൻ, താഴെ നിന്ന് മുകളിലേക്ക് സ്വൈപ്പ് ചെയ്ത് പിടിക്കുക.</translation>
<translation id="6648911618876616409">ഒരു സുപ്രധാന അപ്ഡേറ്റ് ഇൻസ്റ്റാൾ ചെയ്യാൻ തയ്യാറാണ്. ആരംഭിക്കാൻ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="6671497123040790595"><ph name="MANAGER" />-ന്റെ മാനേജ്മെന്റിന് സജ്ജീകരിക്കുന്നു</translation>
<translation id="6675665718701918026">പോയിന്റ് ചെയ്യുന്ന ഉപകരണം കണക്റ്റ് ചെയ്‌തു</translation>
<translation id="667752334740867460">വൈഫൈ വിവരങ്ങൾ സ്വീകരിക്കുന്നു...</translation>
<translation id="6680442031740878064">ലഭ്യമായ ഇടം: <ph name="AVAILABLE_SPACE" /></translation>
<translation id="6684827949542560880">ഏറ്റവും പുതിയ അപ്‌ഡേറ്റ് ഡൗൺലോഡ് ചെയ്യുന്നു</translation>
<translation id="6722744767592605627">നിങ്ങൾക്ക് <ph name="EMAIL" />വീണ്ടെടുക്കാം, എന്നാൽ ലോക്കൽ ഡാറ്റ ഇല്ലാതാക്കും.</translation>
<translation id="6748980958975836188"><ph name="BEGIN_LINK1" />Google സേവന നിബന്ധനകളും<ph name="END_LINK1" /> <ph name="BEGIN_LINK2" />Chrome, ChromeOS അധിക സേവന നിബന്ധനകളും<ph name="END_LINK2" /> ഞാൻ വായിച്ച് അംഗീകരിക്കുന്നു.</translation>
<translation id="6749473226660745022">ഫോട്ടോകൾ</translation>
<translation id="6754918760968695779">ക്വിക്ക് ഇൻസേർട്ട്</translation>
<translation id="6789834167207639931">വീണ്ടെടുക്കൽ പൂർത്തിയാക്കാൻ അടുത്ത സ്ക്രീനിൽ നിങ്ങളുടെ Google Account പാസ്‌വേഡ് വീണ്ടും നൽകുക</translation>
<translation id="6797022073000660150"><ph name="BEGIN_PARAGRAPH1" />സ്വയമേവയുള്ള റിപ്പോർട്ടുകൾ അയയ്ക്കാൻ ChromeOS ഉപകരണങ്ങളെ അനുവദിക്കുന്നത്, ChromeOS-ൽ പരിഹരിക്കേണ്ടവയ്ക്കും മെച്ചപ്പെടുത്തേണ്ടവയ്ക്കും മുൻഗണന നൽകാൻ ഞങ്ങളെ സഹായിക്കുന്നു ChromeOS എപ്പോഴാണ് ക്രാഷാകുന്നത്, ഏതൊക്കെ ഫീച്ചറുകളാണ് ഉപയോഗിച്ചത്, സാധാരണഗതിയിൽ ഉപയോഗിക്കുന്ന മെമ്മറിയുടെ അളവ് എത്രയാണ്, Android ആപ്പ് ഡയഗ്‌നോസ്‌റ്റിക്, ഉപയോഗ ഡാറ്റ എന്നിവ പോലുള്ള കാര്യങ്ങൾ ഈ റിപ്പോർട്ടുകളിൽ ഉൾപ്പെടുത്താം. ചില സംയോജിത ഡാറ്റയും Google ആപ്പുകളെയും Android ഡെവലപ്പർമാരെപ്പോലുള്ള പങ്കാളികളെയും സഹായിക്കും.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളുടെ കുട്ടിയുടെ ChromeOS ഉപകരണ ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഈ റിപ്പോർട്ടുകൾ അനുവദിക്കാൻ തുടങ്ങുകയോ നിർത്തുകയോ ചെയ്യാം. നിങ്ങളൊരു ഡൊമെയ്ൻ അഡ്മിനിസ്ട്രേറ്റർ ആണെങ്കിൽ, ഈ ക്രമീകരണം നിങ്ങൾക്ക് അഡ്മിൻ കൺസോളിൽ മാറ്റാനാകും.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH4" />നിങ്ങളുടെ കുട്ടിയുടെ Google അക്കൗണ്ടിനുള്ള വെബ്, ആപ്പ് ആക്റ്റിവിറ്റി ക്രമീകരണം ഓണാക്കിയിട്ടുണ്ടെങ്കിൽ, നിങ്ങളുടെ കുട്ടിയുടെ ഡാറ്റ അവരുടെ Google അക്കൗണ്ടിലേക്ക് സംരക്ഷിച്ചേക്കാം. ഈ ക്രമീകരണത്തെ കുറിച്ചും അതെങ്ങനെയാണ് ക്രമപ്പെടുത്തുന്നത് എന്നതിനെ കുറിച്ചും families.google.com-ൽ കൂടുതലറിയുക.<ph name="END_PARAGRAPH4" /></translation>
<translation id="6800893479155997609">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിനുള്ള മുൻനിര ആപ്പുകൾ</translation>
<translation id="6818802132960437751">ബിൽറ്റ്-ഇൻ വെെറസ് പരിരക്ഷ</translation>
<translation id="682971198310367122">Google സ്വകാര്യതാ നയം</translation>
<translation id="6835762382653651563">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> അപ്‌ഡേറ്റ് ചെയ്യാൻ ഇന്റർനെറ്റിൽ കണക്റ്റ് ചെയ്യുക.</translation>
<translation id="6839916869147598086">സൈൻ ഇൻ മാറ്റി</translation>
<translation id="6852529053326738838">നിങ്ങളുടെ അക്കൗണ്ടിന് യോഗ്യതയുണ്ടോയെന്ന് പരിശോധിക്കാൻ സ്ഥാപനത്തോട് ചോദിക്കുക അല്ലെങ്കിൽ നിങ്ങളുടെ ഔദ്യോഗിക ഇമെയിൽ ഉപയോഗിച്ച് എൻറോൾ ചെയ്യുക.</translation>
<translation id="6867671714894555998">പുതിയ കീബോർഡ് ഉപയോഗിച്ച് കാര്യങ്ങൾ വേഗത്തിൽ ചെയ്തുതീർക്കൂ</translation>
<translation id="6881845890692344060">നിങ്ങളുടെ അഡ്മിൻ ലോഗൗട്ട് ചെയ്തു. ഇപ്പോൾ നിയന്ത്രണം നിങ്ങൾക്കാണ്.</translation>
<translation id="6883319974225028188">ക്ഷമിക്കണം!  സിസ്‌റ്റത്തിന് ഉപകരണ കോൺഫിഗറേഷൻ സംരക്ഷിക്കാനായില്ല.</translation>
<translation id="6888831646723563669">നിങ്ങളുടെ പുതിയ <ph name="DEVICE_TYPE" /> എന്നതിലെ എല്ലാ ഫീച്ചറുകളും ആസ്വദിക്കാൻ കണക്റ്റ് ചെയ്യുക</translation>
<translation id="6890053850723168825"><ph name="BEGIN_PARAGRAPH1" />ആപ്പ് ഡാറ്റ എന്നത് കോൺടാക്റ്റുകൾ, സന്ദേശങ്ങൾ, ഫോട്ടോകൾ എന്നിവ പോലുള്ള ഡാറ്റ ഉൾപ്പെടെ ഒരു ആപ്പ് സംരക്ഷിച്ചിട്ടുള്ള ഏതൊരു ഡാറ്റയും (ഡെവലപ്പർ ക്രമീകരണം അടിസ്ഥാനമാക്കി) ആകാം. ബാക്കപ്പ് ഡാറ്റയെ നിങ്ങളുടെ കുട്ടിയുടെ Drive സ്റ്റോറേജ് ക്വാട്ടയുടെ ഭാഗമായി കണക്കാക്കില്ല.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് ഈ സേവനം ഓഫാക്കാം.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6897688156970667447">വെളിച്ചം കുറവായിരിക്കുമ്പോൾ സഹായകരം, ബാറ്ററി ലാഭിക്കുന്നു</translation>
<translation id="6903907808598579934">സമന്വയിപ്പിക്കൽ ഓണാക്കുക</translation>
<translation id="6918733588290914545">Android ഫോൺ ഉപയോഗിച്ചുള്ള ദ്രുത്ര സജ്ജീകരണം</translation>
<translation id="6920473853105515518">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്തിട്ടുണ്ടെന്ന് ഉറപ്പാക്കിയ ശേഷം വീണ്ടും ശ്രമിക്കുക. നിങ്ങൾക്ക് മറ്റൊരു ഉപകരണത്തിൽ play.google/play-terms സന്ദർശിക്കാനുമാകും.</translation>
<translation id="6929126689972602640">സ്‌കൂൾ അക്കൗണ്ടുകൾക്കായി രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ പിന്തുണയ്ക്കുന്നില്ല. Google Classroom-ഉം വീട്ടിലിരുന്ന് സ്‌കൂൾ വർക്ക് ചെയ്യാനുള്ള മറ്റ് വെബ്‌സൈറ്റുകളും ആക്‌സസ് ചെയ്യുന്നതിന് ഒരു സ്‌കൂൾ അക്കൗണ്ട് ചേർക്കാൻ, ആദ്യം കുട്ടിയുടെ വ്യക്തിപര അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക. സജ്ജീകരണത്തിൽ നിങ്ങൾക്ക് പിന്നീട് സ്‌കൂൾ അക്കൗണ്ട് ചേർക്കാനാകും.</translation>
<translation id="6935031746833428401">ഉപകരണ മാനേജ്‌മെന്റിനെ കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="6950351336108213154">ഉപകരണ പെരിഫറലുകൾ അപ്ഡേറ്റ് ചെയ്യുന്നു</translation>
<translation id="6955698182324067397">sshd daemon സജ്ജീകരിക്കുന്നതും USB ഡ്രൈവുകളിൽ നിന്ന് ബൂട്ടിംഗ് പ്രവർത്തനക്ഷമമാക്കുന്നതുമായ ChromeOS ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ നിങ്ങൾ പ്രവർത്തനക്ഷമമാക്കുകയാണ്.</translation>
<translation id="6965382102122355670">ശരി</translation>
<translation id="6969216690072714773">ഈ ഉപകരണവുമായി ബന്ധപ്പെടുത്തേണ്ട പുതിയ വിവരങ്ങൾ നൽകുക അല്ലെങ്കിൽ ഇപ്പോഴുള്ള വിവരങ്ങൾ അപ്‌ഡേറ്റ് ചെയ്യുക.</translation>
<translation id="6981982820502123353">ഉപയോഗസഹായി</translation>
<translation id="6984652455487792101">നിങ്ങൾ ഒരു പ്രോക്‌സി സെർവർ ഉപയോഗിക്കുകയാണെങ്കിൽ, പ്രോക്‌സി
സെർവർ പ്രവർത്തനക്ഷമമാണെന്ന് ഉറപ്പുവരുത്തുന്നതിന് നിങ്ങളുടെ പ്രോക്‌സി ക്രമീകരണങ്ങൾ പരിശോധിക്കുകയോ
         നിങ്ങളുടെ നെറ്റ്‌വർക്ക് അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുകയോ ചെയ്യുക. നിങ്ങൾ ഉപയോഗിക്കുന്നത് ഒരു പ്രോക്‌സി സെർവറാണെന്ന് കരുതുന്നില്ലെങ്കിൽ,
        നിങ്ങളുടെ <ph name="LINK_START" />പ്രോക്‌സി ക്രമീകരണങ്ങൾ<ph name="LINK_END" /> അഡ്ജസ്റ്റ് ചെയ്യുക.</translation>
<translation id="6996245928508281884">നിങ്ങളുടെ ഫോണിന്റെ Bluetooth-ഉം വൈഫൈയും ഓണാക്കുക</translation>
<translation id="6996438701394974959">ഡിസ്പ്ലേ, ടെക്സ്റ്റ് വലുപ്പം വർദ്ധിപ്പിക്കുക</translation>
<translation id="6998793565256476099">വീഡിയോ കോണ്‍ഫറന്‍സിംഗിനായി ഉപകരണം എൻറോൾ ചെയ്യുക</translation>
<translation id="7025082428878635038">ജെസ്‌ചറുകൾ ഉപയോഗിച്ച് നാവിഗേറ്റ് ചെയ്യാൻ പുതിയൊരു മാർഗ്ഗം അവതരിപ്പിക്കുന്നു</translation>
<translation id="7034692021407794547">പ്രത്യേക ബില്ലിംഗ് മാനേജ്മെന്റ് അവകാശങ്ങളുള്ള അഡ്മിൻ ആദ്യം അഡ്മിൻ കൺസോളിലെ Google Meet ഹാർഡ്‍വെയർ വിഭാഗത്തിൽ നൽകിയ Google Meet ഹാർഡ്‍വെയർ സേവന നിബന്ധനകൾ അംഗീകരിക്കണം.</translation>
<translation id="7039951224110875196">കുട്ടിക്കായി Google Account സൃഷ്‌ടിക്കുക</translation>
<translation id="7065223852455347715">എന്റർപ്രൈസ് എൻറോൾമെന്റിനെ തടയുന്ന മോഡിൽ ഈ ഉപകരണം ലോക്ക് ചെയ്‌തു. നിങ്ങൾക്ക് ഉപകരണം എ‌ൻറോൾ ചെയ്യണമെങ്കിൽ, ആദ്യം ഉപകരണ വീണ്ടെടുക്കൽ എന്നതിലൂടെ പോകേണ്ടതുണ്ട്.</translation>
<translation id="7066572364168923329">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിന്റെ സജ്ജീകരണം തിരഞ്ഞെടുക്കുക</translation>
<translation id="7077829361966535409">നിലവിലെ പ്രോക്‌സി ക്രമീകരണങ്ങൾ ഉപയോഗിച്ച് ലോഡ് ചെയ്യുന്നതിൽ സൈൻ-ഇൻ പേജ് പരാജയപ്പെട്ടു. <ph name="GAIA_RELOAD_LINK_START" />വീണ്ടും സൈൻ ഇൻ ചെയ്യാൻ ശ്രമിക്കുക<ph name="GAIA_RELOAD_LINK_END" />, അല്ലെങ്കിൽ മറ്റ് <ph name="PROXY_SETTINGS_LINK_START" />പ്രോക്‌സി ക്രമീകരണങ്ങൾ<ph name="PROXY_SETTINGS_LINK_END" /> ഉപയോഗിക്കുക.</translation>
<translation id="7088674813905715446">അഡ്‌മിനിസ്‌ട്രേറ്റർ ഈ ഉപകരണം ഡിപ്രൊവിഷൻ ചെയ്‌ത നിലയിലാക്കിയിരിക്കുന്നു. എൻറോൾമെന്റിനായി ഇത് പ്രവർത്തനക്ഷമമാക്കാൻ, അഡ്‌മിനിസ്‌ട്രേറ്റർ ഈ ഉപകരണത്തെ തീർപ്പുകൽപ്പിക്കാത്ത നിലയിലാക്കേണ്ടതുണ്ട്.</translation>
<translation id="7114054701490058191">പാസ്‌വേഡുകൾ പൊരുത്തപ്പെടുന്നില്ല</translation>
<translation id="7135729336746831607">Bluetooth ഓണാക്കണോ?</translation>
<translation id="7141105143012495934">നിങ്ങളുടെ അക്കൗണ്ട് വിശദാംശങ്ങൾ വീണ്ടെടുക്കാനാവാത്തതിനാൽ സൈൻ ഇൻ ചെയ്യുന്നത് പരാജയപ്പെട്ടു. നിങ്ങളുടെ അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുക അല്ലെങ്കിൽ വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="7144878232160441200">വീണ്ടും ശ്രമിക്കുക</translation>
<translation id="7149839598364933473">ഈ ഉപകരണം ഒരു <ph name="DEVICE_OS" /> ഉപകരണമായി പരിവർത്തനം ചെയ്യുക.</translation>
<translation id="7171259390164035663">എൻറോൾ ചെയ്യരുത്</translation>
<translation id="7189451821249468368">നിങ്ങൾക്ക് ഈ ഉപകരണം ചേർക്കുന്നതിനാവശ്യമായ അപ്ഗ്രേഡുകൾ ഇല്ല. കൂടുതൽ വാങ്ങുന്നതിന് വിൽപ്പനയുമായി ബന്ധപ്പെടുക. ഈ സന്ദേശം പിശക് കാരണമാണെന്ന് നിങ്ങൾ കരുതുന്നുവെങ്കിൽ പിന്തുണയുമായി ബന്ധപ്പെടുക.</translation>
<translation id="7202337678781136582">നിങ്ങളുടെ Android ഫോൺ ഉപയോഗിച്ച് QR കോഡ് സ്‌കാൻ ചെയ്യുക</translation>
<translation id="7228854227189381547">മാറ്റേണ്ടതില്ല</translation>
<translation id="7230881857327093958">സജ്ജീകരണത്തിന് ശേഷം മാറ്റങ്ങൾ ബാധകമാക്കും</translation>
<translation id="7260186537988033909">കിയോസ്‌ക്, സൈനേജ് ഉപകരണ എൻറോൾമെന്റ് പൂർത്തിയായി</translation>
<translation id="7284411326658527427">ഓരോ വ്യക്തിക്കും അവരുടെ അക്കൗണ്ട് വ്യക്തിപരമാക്കാനും ഡാറ്റ സ്വകാര്യമായി സൂക്ഷിക്കാനും കഴിയും.</translation>
<translation id="7290242001003353852"><ph name="SAML_DOMAIN" /> ഹോസ്‌റ്റ് ചെയ്യുന്ന ഈ സൈൻ ഇൻ സേവനം നിങ്ങളുടെ ക്യാമറ ആക്‌സസ് ചെയ്യുന്നുണ്ട്.</translation>
<translation id="7311005168897771689">ഓഫ്‌ലൈനിലായിരിക്കുമ്പോൾ നിങ്ങളുടെ Google Drive ഫയലുകൾ ആക്‌സസ് ചെയ്യൂ</translation>
<translation id="7317831949569936035">സ്‌കൂൾ എൻറോൾമെന്റ്</translation>
<translation id="7326004502692201767">കുട്ടിക്കായി ഈ <ph name="DEVICE_TYPE" /> സജ്ജീകരിക്കുക</translation>
<translation id="732659786514229249">ഉപകരണം നിങ്ങളുടെ സ്ഥാപനത്തിൽ എൻറോൾ ചെയ്യണോ?</translation>
<translation id="7329154610228416156">സുരക്ഷിതമല്ലാത്ത URL (<ph name="BLOCKED_URL" />) ഉപയോഗിക്കാൻ കോൺഫിഗർ ചെയ്‌തിരിക്കുന്നതിനാൽ സൈൻ ഇൻ ചെയ്യുന്നതിന് പരാജയപ്പെട്ടു. നിങ്ങളുടെ അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുക.</translation>
<translation id="7345706641791090287">പാസ്‌വേഡ് സ്ഥിരീകരിക്കുക</translation>
<translation id="7348093485538360975">ഓൺ-സ്‌ക്രീൻ കീബോർഡ്</translation>
<translation id="7352651011704765696">എന്തോ കുഴപ്പം സംഭവിച്ചു</translation>
<translation id="7403642243184989645">ഉറവിടങ്ങൾ ഡൗൺലോഡ് ചെയ്യുന്നു</translation>
<translation id="7406912950279255498">നിറം വിപരീതമാക്കൽ മോഡ്</translation>
<translation id="7416263748877373774">സേവന നിബന്ധനകൾ ലോഡ് ചെയ്യാനാകില്ല. നിങ്ങളുടെ നെറ്റ്‌വർക്ക് കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="7475742997309661417">സംഭാഷണ സിന്തസൈസർ അല്ലെങ്കിൽ ബ്രെയ്‌ലി ഡിസ്‌പ്ലേയുടെ സഹായത്തോടെ സ്ക്രീനിൽ കാണിക്കുന്ന ടെക്‌സ്റ്റ് വായിക്കാൻ അന്ധതയോ കാഴ്ചക്കുറവോ ഉള്ള ആളുകളാണ് ChromeOS, ChromeVox എന്നിവയിലെ സ്ക്രീൻ റീഡർ പ്രധാനമായും ഉപയോഗിക്കുന്നത്. ChromeVox ഓണാക്കാൻ രണ്ട് വോളിയം കീകളും അഞ്ച് സെക്കൻഡ് നേരത്തേക്ക് അമർത്തിപ്പിടിക്കുക. ChromeVox സജീവമായിക്കഴിഞ്ഞാൽ, ദ്രുത ടൂർ വഴി നിങ്ങൾക്ക് അതേക്കുറിച്ച് അറിയാനാകും.</translation>
<translation id="7476454130948140105">അപ്‌ഡേറ്റ് ചെയ്യാൻ ബാറ്ററി ചാർജ്ജ് വളരെ കുറവാണ്. (<ph name="BATTERY_PERCENT" />%)</translation>
<translation id="7504187084873714912"><ph name="BEGIN_PARAGRAPH1" /><ph name="DEVICE_OS" /> എന്നതിന് ഈ ഉപകരണത്തിന്റെ ഉടമസ്ഥത ഏറ്റെടുക്കാൻ, എൻറോൾ ചെയ്യുന്നതിന് മുമ്പ് TPM മായ്‌ക്കേണ്ടതുണ്ട്.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങൾക്ക് TPM ഉപകരണം പൂർണ്ണമായും ഓഫാക്കാനുമാകും. സോഫ്‌റ്റ്‌വെയർ എൻക്രിപ്ഷൻ ഉപയോഗിച്ച് നിങ്ങളുടെ ഡാറ്റ സുരക്ഷിതമായി സംഭരിക്കും, എന്നാൽ ഹാർഡ്‌വെയർ പിന്തുണയുള്ള സർട്ടിഫിക്കറ്റുകൾ പോലുള്ള ചില സുരക്ഷാ ഫീച്ചറുകൾ പ്രവർത്തനരഹിതമായിരിക്കും.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />റീബൂട്ട് ചെയ്ത ശേഷം സിസ്റ്റം BIOS/UEFI ക്രമീകരണം നൽകുന്നതിലൂടെ നിങ്ങളുടെ TPM ക്രമീകരണം മാറ്റാം. ഉപകരണ മോഡൽ അനുസരിച്ച് ഘട്ടങ്ങൾ വ്യത്യാസപ്പെടാം. കൂടുതൽ വിവരങ്ങൾക്ക്, റീബൂട്ട് ചെയ്യുന്നതിന് മുമ്പ് മറ്റൊരു ഉപകരണത്തിൽ <ph name="DEVICE_OS" /> ഡോക്യുമെന്റേഷൻ തുറക്കുക: g.co/flex/TPMHelp.<ph name="END_PARAGRAPH3" /></translation>
<translation id="7506541170099744506">എന്റർപ്രൈസ് മാനേജ്‌മെന്റിന് വേണ്ടി നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഉപകരണത്തെ എൻറോൾ ചെ‌യ്‌തു.</translation>
<translation id="7509097596023256288">മാനേജ്മെന്റ് സജ്ജീകരിക്കുന്നു</translation>
<translation id="7543104066686362383">ഈ <ph name="IDS_SHORT_PRODUCT_NAME" /> ഉപകരണത്തിലെ ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പ്രവർത്തനക്ഷമമാക്കുന്നു</translation>
<translation id="7544227555407951270">ഉപകരണം എൻറോൾ ചെയ്യുക</translation>
<translation id="7549434883223124329">ഉപകരണത്തിന്റെ ഭാഷ മാറ്റണോ?</translation>
<translation id="7553242001898162573">നിങ്ങളുടെ പാസ്‌വേഡ് നല്‍‌കുക</translation>
<translation id="7556242789364317684">നിർഭാഗ്യവശാൽ, <ph name="SHORT_PRODUCT_NAME" />-ന് നിങ്ങളുടെ ക്രമീകരണങ്ങൾ വീണ്ടെടുക്കാനായില്ല. പിശക് പരിഹരിക്കാൻ, പവർവാഷ് ഉപയോഗിച്ച് <ph name="SHORT_PRODUCT_NAME" /> നിങ്ങളുടെ ഉപകരണം വീണ്ടും സജ്ജമാക്കണം.</translation>
<translation id="7560756177962144929">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> സമന്വയിപ്പിക്കുക</translation>
<translation id="7571643774869182231">അപ്‌ഡേറ്റിന് ആവശ്യമായ സ്‌റ്റോറേജില്ല</translation>
<translation id="7616214729753637086">ഉപകരണം എൻറോൾ ചെയ്യുന്നു...</translation>
<translation id="7619937211696316184">അറ്റകുറ്റപ്പണി പൂർത്തിയായി</translation>
<translation id="7622114377921274169">ചാർജ് ചെയ്യുന്നു.</translation>
<translation id="7630426712700473382">ഈ ഉപകരണം മാനേജ് ചെയ്യുന്നത് <ph name="MANAGER" /> ആണ്, ഓരോ തവണയും നിങ്ങൾ സൈൻ ഇൻ ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="7633724038415831385">നിങ്ങൾ ഒരു അപ്‌ഡേറ്റിന് കാത്തിരിക്കുന്ന ഏക സമയം ഇതായിരിക്കും. Chromebooks-ൽ, സോഫ്‌റ്റ്‌വെയർ അപ്‌ഡേറ്റുകൾ പശ്ചാത്തലത്തിൽ സംഭവിക്കുന്നു.</translation>
<translation id="7639914187072011620">സെർവറിൽ നിന്ന് SAML റീഡയറക്‌റ്റ് ചെയ്യുന്ന URL ലഭ്യമാക്കാനായില്ല</translation>
<translation id="7643117827468520640">ഈ നിബന്ധനകൾ അവലോകനം ചെയ്യുക</translation>
<translation id="7647504534168186939"><ph name="BEGIN_PARAGRAPH1" />ആപ്പ് ഡാറ്റ എന്നത് കോൺടാക്റ്റുകൾ, സന്ദേശങ്ങൾ, ഫോട്ടോകൾ എന്നിവ പോലുള്ള ഡാറ്റ ഉൾപ്പെടെ ഒരു ആപ്പ് സംരക്ഷിച്ചിട്ടുള്ള ഏതൊരു ഡാറ്റയും (ഡെവലപ്പർ ക്രമീകരണം അടിസ്ഥാനമാക്കി) ആകാം. ബാക്കപ്പ് ഡാറ്റയെ നിങ്ങളുടെ Drive സ്റ്റോറേജ് ക്വാട്ടയുടെ ഭാഗമായി കണക്കാക്കില്ല.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് ഈ സേവനം ഓഫാക്കാം.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7649070708921625228">സഹായം</translation>
<translation id="7658239707568436148">റദ്ദാക്കൂ</translation>
<translation id="7659584679870740384">ഈ ഉപകരണം ഉപയോഗിക്കാൻ നിങ്ങൾക്ക് അനുമതിയില്ല. സൈൻ ഇൻ അനുമതിയ്‌ക്കായി അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുക.</translation>
<translation id="7660116474961254898">നിങ്ങളുടെ ഫോണിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക</translation>
<translation id="7661451191293163002">ഒരു രജിസ്‌ട്രേഷൻ സർട്ടിഫിക്കറ്റ് ലഭ്യമാക്കാനായില്ല.</translation>
<translation id="7666531788977935712">'തുടരുക' ബട്ടൺ പ്രവർത്തനക്ഷമമാക്കി</translation>
<translation id="7671139479636735732">നിങ്ങളുടെ ആശയങ്ങൾ എളുപ്പത്തിൽ ദൃശ്യവൽക്കരിക്കാൻ വലത്-ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="770831926727930011">പഴയ പാസ്‌വേഡ് ഉപയോഗിച്ച് നിങ്ങളുടെ ലോക്കൽ ഡാറ്റ പരിരക്ഷിച്ചിരിക്കുന്നു. ലോക്കൽ ഡാറ്റ വീണ്ടെടുക്കാൻ നിങ്ങളുടെ പഴയ പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="7722040605881499779">അപ്‌ഡേറ്റിന് ആവശ്യമായ ഇടം: <ph name="NECESSARY_SPACE" /></translation>
<translation id="7737115349420013392">"<ph name="DEVICE_NAME" />"-മായി ജോടിയാക്കുന്നു ...</translation>
<translation id="7746045113967198252">ടെക്സ്റ്റ് ഉൾപ്പെടെ നിങ്ങളുടെ സ്ക്രീനിലുള്ള ഇനങ്ങളെല്ലാം വലുതാക്കുകയോ ചെറുതാക്കുകയോ ചെയ്യുക. നിങ്ങൾക്ക് ഇത് പിന്നീട് ക്രമീകരണം &gt; ഉപകരണം &gt; ഡിസ്പ്ലേകൾ എന്നതിൽ കണ്ടെത്തുകയും ചെയ്യാം.</translation>
<translation id="7760176388948986635">ഈ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ ഉപയോഗിക്കാൻ, ലൊക്കേഷൻ അനുമതിയുള്ള ChromeOS, Android ആപ്പുകൾ, വെബ്‌സൈറ്റുകൾ, സേവനങ്ങൾ എന്നിവയെ അനുവദിക്കുക. ലൊക്കേഷൻ കൃത്യത, Android ആപ്പുകൾക്കും സേവനങ്ങൾക്കും കൂടുതൽ കൃത്യമായ ലൊക്കേഷൻ ലഭ്യമാക്കുന്നു. ഇത് ചെയ്യാൻ, വയർലെസ് സിഗ്നൽ ലൊക്കേഷനുകൾ ക്രൗഡ്സോഴ്സ് ചെയ്യുന്നതിന്, ഈ ഉപകരണത്തിൽ നിന്നുള്ള ഉപകരണ സെൻസറുകളെയും വയർലെസ് സിഗ്നലുകളെയും കുറിച്ചുള്ള വിവരങ്ങൾ Google ഇടയ്ക്കിടെ പ്രോസസ് ചെയ്യുന്നു. ഉപയോക്താക്കളുടെ ആവശ്യങ്ങൾ നിറവേറ്റുന്നതിനായി Google-ന്റെയും മൂന്നാം കക്ഷികളുടെയും നിയമപരമായ താൽപ്പര്യങ്ങൾ അടിസ്ഥാനമാക്കി, ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്‌ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്തുന്നതിനും Google-ന്റെ സേവനങ്ങൾ മെച്ചപ്പെടുത്തുന്നതിനും നൽകുന്നതിനും പരിപാലിക്കുന്നതിനും ഒരു വ്യക്തിയേയും തിരിച്ചറിയാത്ത തരത്തിൽ ഇവ ഉപയോഗിക്കുന്നു.</translation>
<translation id="7784875615510899699">ഈ Google Beam ഉപകരണം എൻറോൾ ചെയ്യാൻ ആവശ്യമായ ലൈസൻസുകൾ നിങ്ങൾക്ക് ഇല്ല. കൂടുതൽ ലൈസൻസുകൾ വാങ്ങാൻ നിങ്ങളുടെ റീസെല്ലറെ ബന്ധപ്പെടുക. പിശക് കാരണമാണ് ഈ സന്ദേശം കാണുന്നതെന്ന് നിങ്ങൾ കരുതുന്നുവെങ്കിൽ, നിങ്ങളുടെ റീസെല്ലറെ ബന്ധപ്പെടുക.</translation>
<translation id="7791269138074599214">ഇൻപുട്ട് രീതി</translation>
<translation id="7791436592012979144">വിപരീതക്രമത്തിൽ സ്‌ക്രോൾ ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കി</translation>
<translation id="7792012425874949788">സൈൻ ഇൻ ചെയ്യുമ്പോൾ എന്തോ തെറ്റായി സംഭവിച്ചു</translation>
<translation id="780301667611848630">വേണ്ട</translation>
<translation id="7803657407897251194">നിങ്ങളുടെ Android ഉപകരണം ഉപയോഗിച്ച് സജ്ജീകരിക്കുന്നത് തുടരാൻ, നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഒരു നെറ്റ്‌വർക്കിലേക്ക് കണക്റ്റ് ചെയ്യുക</translation>
<translation id="7842692330619197998">നിങ്ങൾക്ക് ഒരു പുതിയ അക്കൗണ്ട് സൃഷ്‌ടിക്കണമെങ്കിൽ, g.co/ChromeEnterpriseAccount സന്ദർശിക്കുക.</translation>
<translation id="7851457902707056880">സൈൻ ഇൻ ചെയ്യുന്നത് ഉടമയുടെ അക്കൗണ്ടിനുമാത്രമായി പരിമിതപ്പെടുത്തിയിരിക്കുന്നു. റീബൂട്ട് ചെയ്‌തതിനുശേഷം ഉടമയുടെ അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക. 30 സെക്കൻഡിനുള്ളിൽ മെഷീൻ സ്വയമേവ റീബൂട്ട് ചെയ്യും.</translation>
<translation id="7870730066603611552">സജ്ജീകരണത്തിന് ശേഷം സമന്വയ ഓപ്‌ഷനുകൾ അവലോകനം ചെയ്യുക</translation>
<translation id="7883792253546618164">ഏത് സമയത്തും വരിക്കാരല്ലാതാവുക.</translation>
<translation id="7887864092952184874">Bluetooth മൗസ് ജോടിയാക്കി</translation>
<translation id="7906440585529721295">ലോക്കൽ ഡാറ്റ ഇല്ലാതാക്കും</translation>
<translation id="7910725946105920830">നിങ്ങളുടെ വ്യക്തിഗത Google Account ഉപയോഗിക്കുക</translation>
<translation id="7918257978052780342">എൻറോൾ ചെയ്യുക</translation>
<translation id="7923516590127538256"><ph name="BEGIN_PARAGRAPH1" />സ്വയമേവയുള്ള റിപ്പോർട്ടുകൾ അയയ്ക്കാൻ ChromeOS ഉപകരണങ്ങളെ അനുവദിക്കുന്നത്, ChromeOS-ൽ പരിഹരിക്കേണ്ടവയ്ക്കും മെച്ചപ്പെടുത്തേണ്ടവയ്ക്കും മുൻഗണന നൽകാൻ ഞങ്ങളെ സഹായിക്കുന്നു ChromeOS എപ്പോഴാണ് ക്രാഷാകുന്നത്, ഏതൊക്കെ ഫീച്ചറുകളാണ് ഉപയോഗിച്ചത്, സാധാരണ ഗതിയിൽ ഉപയോഗിക്കുന്ന മെമ്മറിയുടെ അളവ് എത്രയാണ് എന്നിവ പോലുള്ള കാര്യങ്ങൾ ഈ റിപ്പോർട്ടിൽ ഉൾപ്പെടുത്താം.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളുടെ കുട്ടിയുടെ ChromeOS ഉപകരണ ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഈ റിപ്പോർട്ടുകൾ അനുവദിക്കാൻ തുടങ്ങുകയോ നിർത്തുകയോ ചെയ്യാം. നിങ്ങളൊരു ഡൊമെയ്ൻ അഡ്മിനിസ്ട്രേറ്റർ ആണെങ്കിൽ, ഈ ക്രമീകരണം നിങ്ങൾക്ക് അഡ്മിൻ കൺസോളിൽ മാറ്റാനാകും.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7939062555109487992">വിപുലമായ ഓപ്ഷനുകൾ</translation>
<translation id="7943311690198910993">സൈൻ ഇൻ രീതി അപ്ഡേറ്റ് ചെയ്തു</translation>
<translation id="795240231873601803">വർക്ക്, സ്‌കൂൾ അക്കൗണ്ടുകൾക്കുള്ള എന്റർപ്രൈസ് എൻറോൾമെന്റ് ഉപയോഗിക്കുക</translation>
<translation id="7968982339740310781">വിശദാംശങ്ങൾ കാണുക</translation>
<translation id="7975504106303186033">ഈ Chrome Education ഉപകരണം നിങ്ങൾ ഒരു വിദ്യാഭ്യാസ അക്കൗണ്ടിലേക്ക് എൻറോൾ ചെയ്തിരിക്കണം. പുതിയ അക്കൗണ്ടിനായി സൈൻ അപ്പ് ചെയ്യാൻ, g.co/workspace/edusignup സന്ദർശിക്കുക.</translation>
<translation id="7980084013673500153">അസറ്റ് ഐഡി: <ph name="ASSET_ID" /></translation>
<translation id="7981670705071137488">ഇതിന് ശേഷം, സോഫ്റ്റ്‌വെയർ അപ്ഡേറ്റുകൾ പശ്ചാത്തലത്തിൽ നടക്കും. അപ്ഡേറ്റ് മുൻഗണനകൾ നിങ്ങൾക്ക് ക്രമീകരണത്തിൽ അവലോകനം ചെയ്യാം.</translation>
<translation id="7982083145464587921">ഈ പിശക് പരിഹരിക്കാൻ നിങ്ങളുടെ ഉപകരണം പുനരാരംഭിക്കുക.</translation>
<translation id="7988805580376093356">നിങ്ങളുടെ OS നിലനിർത്തി USB-യിൽ നിന്ന് <ph name="DEVICE_OS" /> റൺ ചെയ്യുക.</translation>
<translation id="7990958035181555539">നിങ്ങളുടെ Android ഫോണിൽ നിന്ന് വൈഫൈ സ്വയമേവ കൈമാറുക</translation>
<translation id="8022466874160067884">നിങ്ങളുടെ Google Account-ഉം പാസ്‌വേഡും നൽകുക</translation>
<translation id="8049029041626250638">കീബോർഡോ മൗസോ കണക്റ്റ് ചെയ്യുക. നിങ്ങൾ Bluetooth ഉപകരണങ്ങളാണ് ഉപയോഗിക്കുന്നതെങ്കിൽ, നിങ്ങളുടെ ഉപകരണങ്ങൾ ജോടിയാക്കാൻ തയ്യാറാണെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="8054563304616131773">സാധുതയുള്ള ഒരു ഇമെയില്‍വിലാസം നല്‍കുക.</translation>
<translation id="8054921503121346576">USB കീബോർഡ് കണക്‌റ്റുചെയ്‌തു</translation>
<translation id="8065144531309810062">കൂടുതൽ ക്രിയേറ്റീവാകാനും കാര്യക്ഷമത കൈവരിക്കാനും Google AI ഉപയോഗിക്കൂ</translation>
<translation id="8082106343289440791">"<ph name="DEVICE_NAME" />"-മായി ജോടിയാക്കണോ?</translation>
<translation id="8097959162767603171">അഡ്‌മിൻ കൺസോളിലുള്ള Chrome ഉപകരണ ലിസ്‌റ്റിലെ സേവന നിബന്ധനകൾ നിങ്ങളുടെ അഡ്‌മിൻ ആദ്യം അംഗീകരിക്കണം.</translation>
<translation id="8098156986344908134"><ph name="DEVICE_OS" /> ഇൻസ്റ്റാൾ ചെയ്ത് ഹാർഡ് ഡ്രൈവ് മായ്ക്കണോ?</translation>
<translation id="8098616321286360457">നെറ്റ്‌വർക്ക് കണക്ഷൻ ആവശ്യമാണ്</translation>
<translation id="8129265306888404830">നിങ്ങളുടെ സ്ഥാപനത്തിന്റെ ഇമെയിൽ വിലാസം (<ph name="EMAIL_DOMAIN" />) ഉപയോഗിക്കുന്നതിന്, നിങ്ങൾ എന്റർപ്രൈസ് എൻറോൾമെന്റ് ഉപയോഗിക്കേണ്ടതുണ്ട്. ഈ ഉപകരണം നിങ്ങളുടെ വ്യക്തിപരമായ ഉപയോഗത്തിനുള്ളതാണെങ്കിൽ, വ്യക്തിഗത Google Account ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8131740175452115882">സ്ഥിരീകരിക്കുക</translation>
<translation id="8146177459103116374">നിങ്ങൾ ഇതിനകം ഈ ഉപകരണത്തിൽ രജിസ്റ്റർ ചെയ്‌തെങ്കിൽ, <ph name="LINK2_START" />നിലവിലുള്ള ഉപയോക്താവായി സൈൻ ഇൻ ചെയ്യാൻ<ph name="LINK2_END" /> നിങ്ങൾക്ക് കഴിയും.</translation>
<translation id="8146793085009540321">സൈൻ ഇൻ ചെയ്യാനായില്ല. നിങ്ങളുടെ അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുകയോ വീണ്ടും ശ്രമിക്കുകയോ ചെയ്യുക.</translation>
<translation id="8147346945017130012">ക്രാഷ് റിപ്പോർട്ടുകളും പ്രശ്നനിർണ്ണയ, ഉപയോഗ ഡാറ്റയും സ്വയമേവ Google-ലേക്ക് അയച്ച് Chrome, ChromeOS ഫീച്ചറുകളും പ്രകടനവും മെച്ചപ്പെടുത്താൻ സഹായിക്കുക.</translation>
<translation id="8152760814912191567">Zoom-നുള്ള Google Beam</translation>
<translation id="815491593104042026">ക്ഷമിക്കണം!  സുരക്ഷിതമല്ലാത്ത URL ഉപയോഗിക്കുന്നതിന് കോൺഫിഗർ ചെയ്‌തിരിക്കുന്നതിനാൽ പരിശോധിച്ചുറപ്പിക്കൽ പരാജയപ്പെട്ടു (<ph name="BLOCKED_URL" />). നിങ്ങളുടെ അഡ്‌മിനി‌സ്‌ട്രേറ്ററെ ബന്ധപ്പെടുക.</translation>
<translation id="8157704005178149728">മേൽനോട്ടം സജ്ജീകരിക്കുന്നു</translation>
<translation id="8174047975335711832">ഉപകരണ വിവരങ്ങൾ</translation>
<translation id="818985507198861625"><ph name="BEGIN_PARAGRAPH1" />നിങ്ങളുടെ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ നിർണ്ണയിക്കാൻ Google-ന്റെ ലൊക്കേഷൻ സേവനം, വൈഫൈയോ മൊബൈൽ നെറ്റ്‌വർക്കുകളോ സെൻസറുകളോ പോലുള്ള ഉറവിടങ്ങൾ ഉപയോഗിക്കുന്നു.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ക്രമീകരണം &gt; ആപ്പുകൾ &gt; Google Play Store &gt; Android മുൻഗണനകൾ മാനേജ് ചെയ്യുക &gt; സുരക്ഷയും ലൊക്കേഷനും &gt; ലൊക്കേഷൻ എന്നതിലേക്ക് പോയി നിങ്ങൾക്ക് ഏത് സമയത്തും നിങ്ങളുടെ ഉപകരണത്തിലെ Android ലൊക്കേഷൻ ഓഫാക്കാം. അതേ മെനുവിലെ “Google ലൊക്കേഷൻ കൃത്യത” ഓഫാക്കി നിങ്ങൾക്ക് Android ലൊക്കേഷനുള്ള വൈഫൈ, മൊബൈൽ നെറ്റ്‌വർക്കുകൾ, സെൻസറുകൾ എന്നിവയുടെ ഉപയോഗവും ഓഫാക്കാനാകും.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8202160505685531999">നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> പ്രൊഫൈൽ അപ്‌ഡേറ്റ് ചെയ്യാൻ പാസ്‌വേഡ് വീണ്ടും നൽകുക.</translation>
<translation id="822050276545350872">തുടർന്നങ്ങോട്ട് കാത്തിരിക്കേണ്ടതില്ല</translation>
<translation id="8239032431519548577">എന്റർപ്രൈസ് എൻറോൾമെൻറ് പൂർത്തിയായി</translation>
<translation id="8241806945692107836">ഉപകരണ കോൺഫിഗറേഷൻ നിർണ്ണയിക്കുന്നു...</translation>
<translation id="8242426110754782860">തുടരുക</translation>
<translation id="826905130698769948">ക്ലയന്റ് സർട്ടിഫിക്കറ്റ് അസാധുവാണ്</translation>
<translation id="8271379370373330993">രക്ഷിതാക്കളെ, അടുത്ത ഏതാനും ഘട്ടങ്ങൾ നിങ്ങൾക്കുള്ളതാണ്. അക്കൗണ്ട് സജ്ജീകരണത്തിന് ശേഷം, <ph name="DEVICE_TYPE" /> കുട്ടിക്ക് കൈമാറാവുന്നതാണ്.</translation>
<translation id="8274924778568117936">അപ്‌ഡേറ്റ് പൂർത്തിയാകുന്നതുവരെ നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> ഓഫാക്കുകയോ അടയ്‌ക്കുകയോ ചെയ്യരുത്. ഇൻസ്‌റ്റലേഷൻ പൂർത്തിയായിക്കഴിഞ്ഞാൽ <ph name="DEVICE_TYPE" /> റീസ്‌റ്റാർട്ട് ആകുന്നതാണ്.</translation>
<translation id="8281886186245836920">ഉപേക്ഷിക്കുക</translation>
<translation id="8289509909262565712"><ph name="DEVICE_OS" /> എന്നതിലേക്ക് സ്വാഗതം</translation>
<translation id="8291942417224950075">വ്യക്തിപരമായ ഉപയോഗത്തിനുള്ളത്</translation>
<translation id="8304383784961451596">ഈ ഉപകരണം ഉപയോഗിക്കാൻ നിങ്ങൾക്ക് അനുമതിയില്ല. സൈൻ-ഇൻ അനുമതിക്കായി അഡ്‌മിനുമായി ബന്ധപ്പെടുക അല്ലെങ്കിൽ Family Link മേൽനോട്ടത്തിലുള്ള ഒരു Google Account ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8321837372750396788">ഈ <ph name="DEVICE_TYPE" /> മാനേജ് ചെയ്യുന്നത് <ph name="MANAGER" /> ആണ്.</translation>
<translation id="8339288417038613756">ഡിസ്പ്ലേ, ടെക്സ്റ്റ് വലുപ്പം</translation>
<translation id="8354034204605718473">നിങ്ങളുടെ കുട്ടിയുടെ PIN ചേർത്തു</translation>
<translation id="8360140320636871023">നിങ്ങളുടെ ഡിസ്പ്ലേ തീം വ്യക്തിപരമാക്കുക</translation>
<translation id="8366396658833131068">നിങ്ങളുടെ നെറ്റ്‌വർക്ക് കണക്റ്റിവിറ്റി പുനഃസ്‌ഥാപിച്ചു. നിങ്ങളുടെ കിയോസ്‌ക് ആപ്പ് സമാരംഭിക്കാൻ മറ്റൊരു നെറ്റ്‌വർക്ക് തിരഞ്ഞെടുക്കുകയോ ചുവടെയുള്ള 'തുടരുക' ബട്ടൺ അമർത്തുകയോ ചെയ്യുക.</translation>
<translation id="8401432541486058167">നിങ്ങളുടെ സ്‌മാർട്ട് കാർഡിന്റെ പിൻ നൽകുക.</translation>
<translation id="8408270600235826886">Google-മായി എന്ത് ഡാറ്റയാണ് പങ്കിടുന്നതെന്ന് നിങ്ങൾക്ക് നിയന്ത്രിക്കാനാകും. ക്രമീകരണത്തിൽ ഏതുസമയത്തും ഇത് മാറ്റാം. Google-ന്റെ <ph name="BEGIN_LINK" />സ്വകാര്യതാ നയം<ph name="END_LINK" /> അനുസരിച്ച് ഡാറ്റ ഉപയോഗിക്കും.</translation>
<translation id="8413956290606243087">ChromeOS-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ?</translation>
<translation id="8425768983279799676">ഉപകരണം അൺലോക്ക് ചെയ്യാൻ നിങ്ങളുടെ പിൻ ഉപയോഗിക്കാം.</translation>
<translation id="8428213095426709021">ക്രമീകരണം</translation>
<translation id="843173223122814223">AI ഉപയോഗിച്ച് പശ്ചാത്തലങ്ങൾ സൃഷ്‌ടിക്കൂ</translation>
<translation id="8452105022015742247">നിങ്ങളുടെ Android ഫോണിൽ നിന്ന് Google Account വിവരങ്ങൾ കൈമാറുന്നു</translation>
<translation id="8464132254133862871">സേവനത്തിനായി ഈ ഉപയോക്തൃ അക്കൗണ്ട് യോഗ്യമല്ല.</translation>
<translation id="8524841856047224176">വീഡിയോ കോളുകൾക്കും മറ്റുമായി ക്യാമറാ പശ്ചാത്തലങ്ങൾ വ്യക്തിപരമാക്കുക</translation>
<translation id="8527257351549797148">നിങ്ങൾക്ക് ആപ്പുകളും വിപുലീകരണങ്ങളും മറ്റും ആക്‌സസ് ചെയ്യാൻ കഴിയുന്നതിന് നിങ്ങളുടെ സ്ഥാപനത്തിന് എൻറോൾമെന്റ് ആവശ്യമായി വന്നേക്കാം. സുരക്ഷാ, ഉപകരണ ക്രമീകരണം പോലുള്ള കാര്യങ്ങൾ മാനേജ് ചെയ്യാനും ഇത് നിങ്ങളുടെ സ്ഥാപനത്തെ അനുവദിക്കുന്നു.</translation>
<translation id="8549316893834449916">Chromebook-ലേക്ക് സെെൻ ഇൻ ചെയ്യാൻ, Gmail, Drive, YouTube തുടങ്ങിയവയ്ക്ക് ഉപയോഗിക്കുന്ന അതേ Google Account നിങ്ങൾ ഉപയോഗിക്കും.</translation>
<translation id="8558063527625343224">Google Beam സജ്ജീകരിക്കുക</translation>
<translation id="8569673829373920831"><ph name="APP_NAME" /> എന്നതിനെ കുറിച്ചുള്ള കൂടുതൽ വിവരങ്ങൾ</translation>
<translation id="8586421813321819377">നിങ്ങളുടെ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ ഉപയോഗിക്കാൻ, ലൊക്കേഷൻ അനുമതിയുള്ള ChromeOS, Android ആപ്പുകൾ, വെബ്‌സൈറ്റുകൾ, സേവനങ്ങൾ എന്നിവയെ അനുവദിക്കുക. ലൊക്കേഷൻ കൃത്യത, Android ആപ്പുകൾക്കും സേവനങ്ങൾക്കും കൂടുതൽ കൃത്യമായ ലൊക്കേഷൻ ലഭ്യമാക്കുന്നു. ഇത് ചെയ്യാൻ, വയർലെസ് സിഗ്നൽ ലൊക്കേഷനുകൾ ക്രൗഡ്സോഴ്സ് ചെയ്യാൻ നിങ്ങളുടെ ഉപകരണത്തിലെ സെൻസറുകളെയും വയർലെസ് സിഗ്നലുകളെയും കുറിച്ചുള്ള വിവരങ്ങൾ Google ഇടയ്‌ക്കിടെ പ്രോസസ് ചെയ്യുന്നു. ഉപയോക്താക്കളുടെ ആവശ്യങ്ങൾ നിറവേറ്റുന്നതിനായി Google-ന്റെയും മൂന്നാം കക്ഷികളുടെയും നിയമപരമായ താൽപ്പര്യങ്ങൾ അടിസ്ഥാനമാക്കി, ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്‌ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്തുന്നതിനും Google-ന്റെ സേവനങ്ങൾ മെച്ചപ്പെടുത്തുന്നതിനും നൽകുന്നതിനും പരിപാലിക്കുന്നതിനും നിങ്ങളെ തിരിച്ചറിയാത്ത തരത്തിൽ ഇവ ഉപയോഗിക്കുന്നു.</translation>
<translation id="8627804903623428808">ഈ നിബന്ധനകൾ അവലോകനം ചെയ്ത് നിങ്ങളുടെ കുട്ടിയുടെ ഡാറ്റ നിയന്ത്രിക്കുക</translation>
<translation id="8628232294964836490">QR കോഡ് സ്കാൻ ചെയ്യാൻ നിങ്ങളുടെ ഫോണിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക. നിങ്ങളുടെ ഫോണിൻ്റെ ബ്ലൂടൂത്ത് ഓണാണെന്ന് ഉറപ്പാക്കുക.
        <ph name="BR" />
        <ph name="BR" />
        സമീപമുള്ള ഉപകരണങ്ങൾക്ക് <ph name="QUICK_START_DEVICE_DISPLAY_NAME" /> എന്ന പേരിൽ ദൃശ്യമാണ്...</translation>
<translation id="8637688295594795546">സിസ്റ്റം അപ്ഡേറ്റ് ലഭ്യമാണ്. ഡൗണ്‍ലോഡ് ചെയ്യുന്നതിന് തയ്യാറെടുക്കുന്നു...</translation>
<translation id="8655972064210167941">നിങ്ങളുടെ പാസ്‌വേഡ് പരിശോധിച്ചുറപ്പിക്കാനാകാത്തതിനാൽ സൈൻ ഇൻ ചെയ്യുന്നതിന് പരാജയപ്പെട്ടു. അഡ്‌മിനിസ്‌ട്രേറ്ററെ ബന്ധപ്പെടുകയോ വീണ്ടും ശ്രമിക്കുകയോ ചെയ്യുക.</translation>
<translation id="8661876674803386786"><ph name="BEGIN_PARAGRAPH1" />ലൊക്കേഷൻ കൃത്യത ഓണായിരിക്കുമ്പോൾ, Wi-Fi ആക്സസ് പോയിന്റുകൾ, സെല്ലുലാർ നെറ്റ്‌വർക്ക് ടവറുകൾ, എന്നിവ പോലുള്ള വയർലെസ് സിഗ്നലുകളെ കുറിച്ചുള്ള വിവരങ്ങൾക്കൊപ്പം ആക്‌സിലറോമീറ്റർ, ജൈറോസ്‌കോപ്പ് എന്നിവ പോലുള്ള ഉപകരണ സെൻസർ ഡാറ്റയും കൂടുതൽ കൃത്യമായ ഉപകരണ ലൊക്കേഷൻ കണക്കാക്കാൻ ഉപയോഗിക്കുന്നു, ലൊക്കേഷൻ അധിഷ്ഠിത ഫീച്ചറുകൾ ലഭ്യമാക്കാൻ Android ആപ്പുകളും സേവനങ്ങളും ഇവ ഉപയോഗിക്കുന്നു. ഇത് ചെയ്യാൻ, ക്രൗഡ് സോഴ്‌സ്ഡ് വയർലെസ് സിഗ്നൽ ലൊക്കേഷനുകളിലേക്ക് സംഭാവന നൽകുന്നതിന് നിങ്ങളുടെ അടുത്തുള്ള ഉപകരണ സെൻസറുകളെയും വയർലെസ് സിഗ്നലുകളെയും കുറിച്ചുള്ള വിവരങ്ങൾ Google ഇടയ്ക്കിടെ ശേഖരിക്കുന്നു.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />നിങ്ങളെ തിരിച്ചറിയാതെ, ഇനിപ്പറയുന്ന കാര്യങ്ങൾക്കായി Google ഈ വിവരങ്ങൾ ഉപയോഗിക്കുന്നു: ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്താൻ; പൊതുവായി Google-ന്റെ സേവനങ്ങൾ നൽകാനും മെച്ചപ്പെടുത്താനും നിലനിർത്താനും. ഉപയോക്താക്കളുടെ ആവശ്യങ്ങൾ നിറവേറ്റുന്നതിനായി, Google-ന്റെയും മൂന്നാം കക്ഷികളുടെയും നിയമപരമായ താൽപ്പര്യങ്ങളെ അടിസ്ഥാനമാക്കി ഈ വിവരം ഞങ്ങൾ പ്രോസസ് ചെയ്യുന്നു.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />നിങ്ങളുടെ ഉപകരണത്തിന്റെ ക്രമീകരണത്തിന് കീഴിലുള്ള ലൊക്കേഷൻ ക്രമീകരണം &gt; സ്വകാര്യതയും സുരക്ഷയും &gt; സ്വകാര്യതാ നിയന്ത്രണങ്ങൾ &gt; ലൊക്കേഷൻ ആക്സസ് &gt; വിപുലമായ ലൊക്കേഷൻ ക്രമീകരണം എന്ന ക്രമത്തിൽ സന്ദർശിച്ച് നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും ലൊക്കേഷൻ കൃത്യത ഓഫാക്കാനാകും. ലൊക്കേഷൻ കൃത്യത ഓഫാണെങ്കിൽ, ലൊക്കേഷൻ കൃത്യതയുമായി ബന്ധപ്പെട്ട ഡാറ്റ ശേഖരിക്കില്ല. Android ആപ്പുകളുടെയും സേവനങ്ങളുടെയും കാര്യത്തിൽ, നിങ്ങളുടെ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ നിർണ്ണയിക്കാനായി, ലഭ്യമാണെങ്കിൽ, IP വിലാസം മാത്രമേ ഉപയോഗിക്കൂ, ഇത് Google Maps പോലുള്ള Android ആപ്പുകളുടെയും സേവനങ്ങളുടെയും ലഭ്യതയേയും കൃത്യതയേയും ബാധിച്ചേക്കാം.<ph name="END_PARAGRAPH3" /></translation>
<translation id="8674903726754070732">നിർഭാഗ്യവശാൽ, കേടായ ഹാർഡ്‌വെയർ ഐഡി ഉപയോഗിച്ചാണ് നിങ്ങളുടെ കമ്പ്യൂട്ടർ കോൺഫിഗർ ചെയ്തിരിക്കുന്നത്. ഇത് ഏറ്റവും പുതിയ സുരക്ഷാ പ്രശ്നപരിഹാരമാർഗ്ഗങ്ങൾ അപ്ഡേറ്റ് ചെയ്യുന്നതിൽ നിന്ന് ChromeOS-നെ തടയുന്നു, നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ <ph name="BEGIN_BOLD" />ദോഷകരമായ ആക്രമണങ്ങളുണ്ടായേക്കാം<ph name="END_BOLD" />.</translation>
<translation id="8675704450909805533">ഇൻസ്റ്റാളറിന് <ph name="DEVICE_OS" /> ഇൻസ്റ്റാൾ ചെയ്യാൻ സാധുതയുള്ള ഇടം കണ്ടെത്താനായില്ല.</translation>
<translation id="8695139659682234808">സജ്ജീകരിച്ചതിനുശേഷം രക്ഷാകർതൃ നിയന്ത്രണങ്ങൾ ചേർക്കുക</translation>
<translation id="8698269656364382265">മുമ്പത്തെ സ്ക്രീനിലേക്ക് മടങ്ങാൻ ഇടതുവശത്ത് നിന്ന് സ്വൈപ്പ് ചെയ്യുക.</translation>
<translation id="8718994464069323380">ടച്ച് സ്‌ക്രീൻ കണ്ടെത്തി</translation>
<translation id="8725066075913043281">വീണ്ടും ശ്രമിക്കുക</translation>
<translation id="8726206820263995930">സെർവറിൽ നിന്നും നയ ക്രമീകരണങ്ങൾ ലഭ്യമാക്കുന്നതിൽ പിശക്: <ph name="CLIENT_ERROR" />.</translation>
<translation id="8730621377337864115">പൂർത്തിയാക്കി</translation>
<translation id="8740086188450289493">Google Account പാസ്‍വേഡ് ഉപയോഗിക്കുക</translation>
<translation id="8740247629089392745">നിങ്ങൾക്ക് ഈ Chromebook <ph name="SUPERVISED_USER_NAME" /> എന്ന കുട്ടിക്ക് കൈമാറാം. സജ്ജീകരണം ഏതാണ്ട് പൂർത്തിയായി, ഇനി അടുത്തറിയാനുള്ള സമയമാണ്.</translation>
<translation id="8759753423332885148">കൂടുതലറിയുക.</translation>
<translation id="8762886931014513155">നിങ്ങളുടെ <ph name="DEVICE_TYPE" />-ന് അപ്‌ഡേറ്റ് ആവശ്യമാണ്</translation>
<translation id="8777628254805677039">റൂട്ട് പാസ്‌വേഡ്</translation>
<translation id="877985182522063539">A4</translation>
<translation id="8783834180813871000">Bluetooth ജോടിയാക്കൽ കോഡ് ടൈപ്പ് ചെയ്‌ത ശേഷം 'മടങ്ങുക' അല്ലെങ്കിൽ 'എന്റർ' അമർത്തുക.</translation>
<translation id="8794548468611058947">സൈൻ ഇൻ ചെയ്യുന്നതിന് നിങ്ങളുടെ Google Account പാസ്‌വേഡ് നൽകുന്നതിന് പകരം, ഈ <ph name="DEVICE_TYPE" /> എന്നതിനായി നിങ്ങൾക്ക് ഒരു പിൻ സൃഷ്‌ടിക്കാം</translation>
<translation id="8830779999439981481">അപ്ഡേറ്റുകൾ ബാധകമാക്കാൻ റീസ്റ്റാർട്ട് ചെയ്യുന്നു</translation>
<translation id="8830796635868321089">നിലവിലെ പ്രോക്‌സി ക്രമീകരണങ്ങൾ ഉപയോഗിച്ചുള്ള അപ്‌ഡേറ്റ് പരിശോധന പരാജയപ്പെട്ടു. നിങ്ങളുടെ <ph name="PROXY_SETTINGS_LINK_START" />പ്രോക്‌സി ക്രമീകരണങ്ങൾ<ph name="PROXY_SETTINGS_LINK_END" /> ക്രമീകരിക്കുക.</translation>
<translation id="8855977033756560989">Chrome എന്റർപ്രൈസ് അപ്‌ഗ്രേഡ് ഉൾപ്പെടുത്തിയാണ് ഈ Chromebook എന്റർപ്രൈസ് ഉപകരണം വരുന്നത്. എന്റർപ്രൈസ് കാര്യക്ഷമതകൾ പ്രയോജനപ്പെടുത്താൻ, Google അഡ്‌മിൻ അക്കൗണ്ട് ഉപയോഗിച്ച് ഈ ഉപകരണം എൻറോൾ ചെയ്യുക.</translation>
<translation id="885746075120788020">നിങ്ങളുടെ Google Account ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുമ്പോൾ ഏതൊരു ChromeOS ഉപകരണത്തിലും നിങ്ങൾ സംരക്ഷിച്ച മുൻഗണനകളും ആക്റ്റിവിറ്റിയും തയ്യാറായിരിക്കും. എന്തൊക്കെ സമന്വയിപ്പിക്കണമെന്നത് ക്രമീകരണത്തിൽ നിങ്ങൾക്ക് തിരഞ്ഞെടുക്കാം.</translation>
<translation id="8868333925931032127">ഡെമോ മോഡ് ആരംഭിക്കുന്നു</translation>
<translation id="8875221558267407626">ഉള്ളടക്കം സംഗ്രഹിക്കുക, സങ്കീർണ്ണമായ ഭാഷ ലളിതമാക്കുക, അല്ലെങ്കിൽ ചോദ്യങ്ങൾ ചോദിക്കുക</translation>
<translation id="8907701755790961703">ഒരു രാജ്യം തിരഞ്ഞെടുക്കുക</translation>
<translation id="8913163265790894442">നിങ്ങളുടെ ഫോൺ ഉപയോഗിച്ച് <ph name="DEVICE_TYPE" /> എളുപ്പത്തിൽ സജ്ജീകരിക്കുക. നിങ്ങളുടെ പാസ്‌വേഡുകൾ നേരിട്ട് നൽകാതെ തന്നെ നിങ്ങൾക്ക് വൈഫൈ, Google Account എന്നിവ ചേർക്കാനാകും.
        <ph name="BR" />
        <ph name="BR" />
        <ph name="DEVICE_TYPE" /> ആയി ദൃശ്യമാകും...</translation>
<translation id="8934732568177537184">തുടരുക</translation>
<translation id="8946359700442089734">ഈ <ph name="IDS_SHORT_PRODUCT_NAME" /> ഉപകരണത്തിൽ ഡീബഗ് ചെയ്യൽ ഫീച്ചറുകൾ പൂർണ്ണമായി പ്രവർത്തനക്ഷമമാക്കിയിട്ടില്ല.</translation>
<translation id="8965037249707889821">പഴയ പാസ്‌വേഡ് നൽകുക</translation>
<translation id="8968906873893164556">സജ്ജീകരണത്തിന് ഉപയോഗിക്കേണ്ട അക്കൗണ്ട് തിരഞ്ഞെടുക്കുക</translation>
<translation id="8973596347849323817">ആവശ്യങ്ങൾക്ക് അനുസരിച്ച് നിങ്ങൾക്ക് ഈ ഉപകരണം ഇഷ്ടാനുസൃതമാക്കാം. ഈ ഉപയോഗസഹായി ഫീച്ചറുകൾ പിന്നീട് ക്രമീകരണത്തിൽ മാറ്റാവുന്നതാണ്.</translation>
<translation id="8975396729541388937">നിങ്ങൾക്ക് ലഭിക്കുന്ന ഇമെയിലുകളിലുള്ള ലിങ്ക് ക്ലിക്ക് ചെയ്‌ത് ഏത് സമയത്തും വരിക്കാരല്ലാതാകുക.</translation>
<translation id="8987305927843254629">ഓരോ വ്യക്തിക്കും അവരുടെ അനുഭവം വ്യക്തിപരമാക്കാനും ഡാറ്റ സ്വകാര്യമായി സൂക്ഷിക്കാനും കഴിയും.</translation>
<translation id="8993059306046735527">നിങ്ങൾ <ph name="DEVICE_TYPE" /> പാസ്‌വേഡ് മറന്നാലും നിങ്ങളുടെ ലോക്കൽ ഡാറ്റ പുനഃസ്ഥാപിക്കാനാകും. നിങ്ങൾ Google അക്കൗണ്ടിലേക്ക് സൈൻ ഇൻ ചെയ്യുകയോ അക്കൗണ്ട് വീണ്ടെടുക്കൽ ഉപയോഗിക്കുകയോ ചെയ്യണം.</translation>
<translation id="9018218886431812662">ഇൻസ്‌റ്റലേഷൻ പൂർത്തിയായി</translation>
<translation id="9033765790910064284">എന്തായാലും തുടരുക</translation>
<translation id="903480517321259405">പിൻ വീണ്ടും ടൈപ്പ് ചെയ്യുക</translation>
<translation id="9040473193163777637">ChromeOS-നുള്ള ബിൽറ്റ് ഇൻ സ്ക്രീൻ റീഡർ ആയ ChromeVox സജീവമാക്കണോ? അങ്ങനെയെങ്കിൽ, രണ്ട് വോളിയം കീകളും അഞ്ച് സെക്കൻഡ് നേരത്തേക്ക് അമർത്തിപ്പിടിക്കുക.</translation>
<translation id="9068298336633421551">ഈ ഉപകരണത്തിന്റെ ലൊക്കേഷൻ ഉപയോഗിക്കാൻ ലൊക്കേഷൻ അനുമതിയുള്ള Android ആപ്പുകളെയും സേവനങ്ങളെയും അനുവദിക്കുക. Google ഇടയ്ക്കിടെ ലൊക്കേഷൻ ഡാറ്റ ശേഖരിക്കുകയും, ലൊക്കേഷൻ കൃത്യതയും ലൊക്കേഷൻ അധിഷ്ഠിത സേവനങ്ങളും മെച്ചപ്പെടുത്താൻ നിങ്ങളുടെ വ്യക്തിവിവരങ്ങൾ എടുത്തുനീക്കി ഈ ഡാറ്റ ഉപയോഗിക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="9074836595010225693">USB മൗസ് കണക്‌റ്റ് ചെയ്‌തു</translation>
<translation id="9076523132036239772">ക്ഷമിക്കുക, നിങ്ങളുടെ ഇമെയിലോ പാസ്‌വേഡോ പരീശോധിച്ചുറപ്പിക്കാൻ കഴിഞ്ഞില്ല. ആദ്യം ഒരു നെറ്റ്‍വര്‍ക്കിലേക്ക് കണക്റ്റ് ചെയ്യാൻ ശ്രമിക്കുക.</translation>
<translation id="9089959054554410481">ടച്ച്പാഡ് സ്‍ക്രോൾ ചെയ്യൽ ദിശ മാറ്റുക</translation>
<translation id="9158715103698450907">ക്ഷമിക്കണം! പരിശോധിച്ചുറപ്പിക്കലിനിടെ നെറ്റ്‌വർക്ക് ആശയവിനിമയ പ്രശ്‌നം സംഭവിച്ചു.  നിങ്ങളുടെ നെറ്റ്‌വർക്ക് കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="9186963452600581158">കുട്ടിയുടെ Google Account ഉപയോഗിച്ച് സെെൻ ഇൻ ചെയ്യുക</translation>
<translation id="919686179725692564">നിങ്ങളുടെ ആപ്പുകൾ ബാക്കപ്പ് ചെയ്യുന്നതിനെ കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="9214520840402538427">ക്ഷമിക്കണം!  ഇൻസ്റ്റലേഷൻ സമയ-ആട്രിബ്യൂട്ടുകളുടെ ലോഞ്ച് ചെയ്യൽ കാലഹരണപ്പെട്ടു.  നിങ്ങളുടെ പിന്തുണാ പ്രതിനിധിയെ ബന്ധപ്പെടുക.</translation>
<translation id="9217002308921247002"><ph name="BEGIN_PARAGRAPH1" /><ph name="DEVICE_TYPE" /> എന്നതിൽ മാത്രം.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ജനറേറ്റീവ് AI പരീക്ഷണാത്മകവും പ്രാരംഭ ഘട്ടത്തിലുള്ളതുമാണ്, നിലവിൽ ഇതിന്റെ ലഭ്യത പരിമിതമാണ്.<ph name="END_PARAGRAPH2" /></translation>
<translation id="936479314588646618">നിങ്ങളുടെ ഫോൺ ഉപയോഗിച്ച് <ph name="DEVICE_TYPE" /> എളുപ്പത്തിൽ സജ്ജീകരിക്കുക. നിങ്ങളുടെ പാസ്‌വേഡ് നേരിട്ട് നൽകാതെ തന്നെ Google Account ചേർക്കാനാകും.
        <ph name="BR" />
        <ph name="BR" />
        <ph name="DEVICE_TYPE" /> ആയി ദൃശ്യമാകും...</translation>
<translation id="945522503751344254">ഫീഡ്‌ബാക്ക് അയയ്‌ക്കുക</translation>
<translation id="951991426597076286">നിരസിക്കുക</translation>
<translation id="954749761428814584">ഭാഷയും ഇൻപുട്ട് രീതിയും</translation>
<translation id="960987915827980018">ഏകദേശം 1 മണിക്കൂർ ശേഷിക്കുന്നു</translation>
<translation id="995420352808264005">ഉപകരണ എൻറോൾമെന്റ് തരം തിരഞ്ഞെടുക്കുക</translation>
</translationbundle>