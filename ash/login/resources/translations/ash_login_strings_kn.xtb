<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1005333234656240382">ADB ಡೀಬಗ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಬೇಕೇ?</translation>
<translation id="1053898984916097744">ಹೊಸದನ್ನು ಪ್ರಾರಂಭಿಸಿ ಅಥವಾ ಪ್ರಕ್ರಿಯೆಯಲ್ಲಿ ಸಹಾಯ ಪಡೆಯಿರಿ.</translation>
<translation id="1061130374843955397">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="1069778954840159202">Android ಫೋನ್‌ನಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಖಾತೆಯನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="1076766328672150609">ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲು ನಿಮ್ಮ ಮಗುವು ಪಿನ್ ಬಳಸಬಹುದು.</translation>
<translation id="1091767800771861448">ಸ್ಕಿಪ್‌ ಮಾಡಲು ESCAPE ಅನ್ನು ಒತ್ತಿರಿ (ಅಧಿಕೃತವಲ್ಲದ ಬಿಲ್ಡ್‌ಗಳಿಗೆ ಮಾತ್ರ).</translation>
<translation id="1097658378307015415">ಸೈನ್ ಇನ್ ಮಾಡುವ ಮುನ್ನ, <ph name="NETWORK_ID" /> ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಅತಿಥಿಯಾಗಿ ಪ್ರವೇಶಿಸಿ</translation>
<translation id="1111932478203988717">ನಿಮ್ಮ ಮಗು ತಮ್ಮ ಸಾಧನಕ್ಕೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಈ ಪಿನ್ ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="1122587596907914265">ಅನನ್ಯ ಶೈಲಿಯ ವಾಲ್‌ಪೇಪರ್‌ಗಳು</translation>
<translation id="1131201598497838573">ನಿಮ್ಮ ಮಗುವಿನ ಪಿನ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="1147322039136785890">ಇದೀಗ <ph name="SUPERVISED_USER_NAME" /> ಅವರ ಸರದಿ</translation>
<translation id="1148669835763563782">ವರ್ಧಿತ ಭದ್ರತೆ ಹಾಗೂ ಹೊಸ Chromebook ಫೀಚರ್‌ಗಳಿಗಾಗಿ ನೀವು ಇತ್ತೀಚಿನ ಸಾಫ್ಟ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್‌ ಅನ್ನು ಪಡೆಯುತ್ತಿದ್ದೀರಿ. ನಿಮ್ಮ Chromebook ನಲ್ಲಿ ಸುಲಭವಾಗಿ ಪ್ರಾರಂಭಿಸುವ ಸಲುವಾಗಿ ನಿಮಗೆ ಸಹಾಯ ಮಾಡಲು ಈ ಅಪ್‌ಡೇಟ್‌ ಸುಧಾರಿತ ಸೆಟಪ್ ಅನುಭವವನ್ನು ಒಳಗೊಂಡಿದೆ.</translation>
<translation id="1176864681932214421">AI ಜೊತೆಗೆ ಚಿತ್ರಗಳನ್ನು ರಚಿಸಿ</translation>
<translation id="1177073277575830464">Android ತ್ವರಿತ ಸೆಟಪ್ ಪೂರ್ಣಗೊಂಡಿದೆ. ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ಸೆಟಪ್ ಮುಂದುವರಿಸಿ.</translation>
<translation id="1179902906564467236">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ ಅಥವಾ ಕ್ಯಾಮರಾ ಆ್ಯಪ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="1185924365081634987">ಈ ನೆಟ್‌ವರ್ಕ್‌ ದೋಷವನ್ನು ಬಗೆಹರಿಸಲು <ph name="GUEST_SIGNIN_LINK_START" />ಅತಿಥಿಯಾಗಿ ಬ್ರೌಸ್ ಮಾಡುವುದನ್ನು<ph name="GUEST_SIGNIN_LINK_END" /> ಕೂಡಾ ನೀವು ಪ್ರಯತ್ನಿಸಬಹುದು.</translation>
<translation id="1191353342579061195">ನಿಮ್ಮ ಅಗತ್ಯಗಳಿಗೆ ಸರಿಹೊಂದುವ ಥೀಮ್ ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಥೀಮ್, ವಾಲ್‌ಪೇಪರ್‌, ಸ್ಕ್ರೀನ್ ಸೇವರ್ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಬದಲಾಯಿಸಲು, ಡೆಸ್ಕ್‌ಟಾಪ್ ಮೇಲೆ ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿದರೆ ಸಾಕು.</translation>
<translation id="1201402288615127009">ಮುಂದೆ</translation>
<translation id="1217114730239853757">ನೀವು ChromeOS Flex ನ ಬಿಲ್ಟ್-ಇನ್ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಆದ, ChromeVox ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಯಸುತ್ತೀರಾ? ಹಾಗಿದ್ದರೆ, ಸ್ಪೇಸ್ ಬಾರ್ ಅನ್ನು ಒತ್ತಿ.</translation>
<translation id="1222835797152767346">ಸೈನ್ ಇನ್ ಮಾಡಲು ಸುಲಭಗೊಳಿಸುವುದಕ್ಕಾಗಿ ಪಿನ್‌‌ ಅನ್ನು ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="1231426483209637778">ಮುಂದಿನ ಬಾರಿ ನೀವು <ph name="DEVICE_TYPE" /> ಅನ್ನು ಬಳಸುವಾಗ ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ನಾವು ನೆನಪಿನಲ್ಲಿಟ್ಟುಕೊಳ್ಳುತ್ತೇವೆ</translation>
<translation id="1243002225871118300">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಪಠ್ಯ ಗಾತ್ರವನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="1256588359404100567">ನಿಮ್ಮ ಹಿಂದಿನ ಸಾಧನದಿಂದ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಸಿಂಕ್ ಮಾಡಲಾಗಿದೆ.</translation>
<translation id="1272978324304772054">ಈ ಬಳಕೆದಾರನ ಖಾತೆಯು ಸಾಧನವು ದಾಖಲಾಗಿರುವ ಡೊಮೇನ್‌ಗೆ ಸಂಬಂಧಿಸಿಲ್ಲ. ನೀವು ವಿಭಿನ್ನ ಡೊಮೆನ್ ಅನ್ನು ದಾಖಲಿಸಲು ಬಯಸುವುದಾದರೆ ನೀವು ಮೊದಲು ಮರುಪ್ರಾಪ್ತಿಯ ಸಾಧನದ ಮೂಲಕ ಹೋಗುವ ಅವಶ್ಯಕತೆ ಇದೆ.</translation>
<translation id="1293556467332435079">Files</translation>
<translation id="1307559529304613120">ಓಹ್! ಈ ಸಾಧನಕ್ಕಾಗಿ ಒಂದು ಸುದೀರ್ಘ API ಆ್ಯಕ್ಸೆಸ್ ಟೋಕನ್ ಪಡೆದುಕೊಳ್ಳಲು ಸಿಸ್ಟಂ ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="1335929031622236846">ನಿಮ್ಮ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿಕೊಳ್ಳಿ</translation>
<translation id="1346669614038013595"><ph name="BEGIN_H3" />ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳು<ph name="END_H3" />
      <ph name="BR" />
      ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಕಸ್ಟಮ್ ಕೋಡ್ ಅನ್ನು ಇನ್‍‍ಸ್ಟಾಲ್ ಮಾಡಲು ಮತ್ತು ಪರೀಕ್ಷಿಸಲು ನಿಮ್ಮ ChromeOS ಸಾಧನದಲ್ಲಿ ನೀವು ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು. ಇದರಿಂದ ನಿಮಗೆ ಕೆಳಕಂಡ ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುವ ಅವಕಾಶ ದೊರೆಯುತ್ತದೆ:<ph name="BR" />
      <ph name="BEGIN_LIST" />
        <ph name="LIST_ITEM" />OS ಫೈಲ್‍ಗಳನ್ನು ಮಾರ್ಪಡಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು rootfs ಪರಿಶೀಲನೆಯನ್ನು ತೆಗೆದುಹಾಕುವುದು
        <ph name="LIST_ITEM" />ಸಾಧನವನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> ನಂತಹ ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಪರೀಕ್ಷಾ ಕೀಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸಾಧನಕ್ಕೆ SSH ಕಂಟೆಂಟ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು
        <ph name="LIST_ITEM" />USB ಡ್ರೈವ್‍ನಿಂದ OS ಚಿತ್ರವನ್ನು ಇನ್‍‍ಸ್ಟಾಲ್ ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು USB ಡ್ರೈವ್‌ನಿಂದ ಬೂಟ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು
        <ph name="LIST_ITEM" />ಸಾಧನಕ್ಕೆ ಮ್ಯಾನುಯಲ್ ಆಗಿ SSH ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು dev ಮತ್ತು ಸಿಸ್ಟಮ್ ರೂಟ್ ಲಾಗಿನ್ ಪಾಸ್‍‍ವರ್ಡ್ ಎರಡನ್ನೂ ಸೆಟ್ ಮಾಡುವುದು
      <ph name="END_LIST" />
      <ph name="BR" />
      ಸಕ್ರಿಯಗೊಳಿಸಿದ ನಂತರ, ಪವರ್‌ವಾಷ್ ಮಾಡಿದ ನಂತರವೂ ಅಥವಾ ಎಂಟರ್‌ಪ್ರೈಸ್ ಒಂದರ ಮೂಲಕ ನಿರ್ವಹಿಸಲಾದ ಸಾಧನದಲ್ಲಿನ ಡೇಟಾವನ್ನು ಅಳಿಸಿಹಾಕಿದ ನಂತರವೂ ಬಹುತೇಕ ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳು ಸಕ್ರಿಯವಾಗಿಯೇ ಇರುತ್ತವೆ. ಎಲ್ಲಾ ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು, ChromeOS ರಿಕವರಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ (https://support.google.com/chromebook/answer/1080595).
      <ph name="BR" />
      <ph name="BR" />
      ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ಇದನ್ನು ನೋಡಿ:<ph name="BR" />
      https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
      <ph name="BR" />
      <ph name="BR" />
      <ph name="BEGIN_BOLD" />ಗಮನಿಸಿ:<ph name="END_BOLD" /> ಪ್ರಕ್ರಿಯೆಯ ವೇಳೆ ಸಿಸ್ಟಂ ರೀಬೂಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="1347625331607114917">ನಿಮ್ಮ Android ಫೋನ್‌ನಲ್ಲಿ ಕೋಡ್ ಅನ್ನು ದೃಢೀಕರಿಸಿ</translation>
<translation id="1347975661240122359">ಬ್ಯಾಟರಿ <ph name="BATTERY_LEVEL" />% ಪ್ರಮಾಣ ತಲುಪಿದಾಗ ಅಪ್‌ಡೇಟ್ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ.</translation>
<translation id="1353275871123211385">ಆ್ಯಪ್ ಅನುಮೋದನೆ ಮತ್ತು ವೀಕ್ಷಣಾ ಅವಧಿ ಮಿತಿಗಳಂತಹ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಬಳಸಲು, ಮಗುವು ಪೋಷಕರು ನಿರ್ವಹಿಸುವ Google ಖಾತೆಯೊಂದನ್ನು ಹೊಂದಿರಬೇಕು. Google Classroom ನಂತಹ ಪರಿಕರಗಳಿಗಾಗಿ ಶಾಲಾ ಖಾತೆಯನ್ನು ನಂತರ ಸೇರಿಸಬಹುದು.</translation>
<translation id="1375557162880614858">ನೀವು ChromeOS Flex ನ ಬಿಲ್ಟ್-ಇನ್ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಆದ, ChromeVox ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಯಸುತ್ತೀರಾ?</translation>
<translation id="1375938286942050085">ಸೆಟಪ್ ಪೂರ್ಣಗೊಂಡಿದೆ! ಮುಂದೆ, ಗೇಮಿಂಗ್‌ಗಾಗಿ ನಿಮ್ಮ ಸಾಧನವನ್ನು ಹೊಂದಿಸಿ</translation>
<translation id="1377600615067678409">ಈಗ ಸ್ಕಿಪ್‌ ಮಾಡಿ</translation>
<translation id="1399261165075500043">Google Play ಸೇವಾ ನಿಯಮಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="1400243387594338234">ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನೀವು ಈ ಪಿನ್ ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="1406500794671479665">ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="1407069428457324124">ಡಾರ್ಕ್ ಥೀಮ್</translation>
<translation id="1417497355604638350">ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು ಕಳುಹಿಸಿ.</translation>
<translation id="1418882096915998312">ಎಂಟರ್‌ಪ್ರೈಸ್ ನೋಂದಣಿ ಪ್ರಗತಿಯಲ್ಲಿದೆ</translation>
<translation id="1426410128494586442">ಹೌದು</translation>
<translation id="1427269577154060167">ದೇಶ</translation>
<translation id="1440090277117135316">ಶಾಲಾ ದಾಖಲಾತಿ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="1473927070149284123">ಪುನಃ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಹಸ್ತಚಾಲಿತವಾಗಿ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಿ</translation>
<translation id="1503556098270577657">ನಿಮ್ಮ Android ಫೋನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ನೀವು <ph name="USER_EMAIL" /> ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ</translation>
<translation id="1510238584712386396">ಲಾಂಚರ್</translation>
<translation id="1521442365706402292">ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="15373452373711364">ದೊಡ್ಡ ಮೌಸ್ ಕರ್ಸರ್</translation>
<translation id="1540605929960647700">ಡೆಮೊ ಮೋಡ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="1572876035008611720">ನಿಮ್ಮ ಇಮೇಲ್ ನಮೂದಿಸಿ</translation>
<translation id="1588438908519853928">ಸಾಮಾನ್ಯ</translation>
<translation id="1620510694547887537">ಕ್ಯಾಮರಾ</translation>
<translation id="1636212173818785548">ಸರಿ</translation>
<translation id="1642494467033190216">Rootfs ರಕ್ಷಣೆ ಮತ್ತು ಪುನರಾರಂಭಿಸುವ ಮೊದಲು ಇತರ ದೋಷ ನಿವಾರಣಾ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="1646045728251578877">ಸಾಫ್ಟ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ</translation>
<translation id="1650801028905250434">ನನ್ನ ಡ್ರೈವ್‌ನಲ್ಲಿರುವ ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ನಿಮ್ಮ Chromebook ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸಿಂಕ್ ಆಗುತ್ತವೆ ಇದರಿಂದ ನೀವು ಇಂಟರ್‌ನೆಟ್ ಕನೆಕ್ಷನ್ ಇಲ್ಲದೆ ಅವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು. ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಫೈಲ್‌ಗಳಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="1668435968811469751">ಹಸ್ತಚಾಲಿತವಾಗಿ ನೋಂದಾಯಿಸಿ</translation>
<translation id="1678919064276516737">ನೀವು ನಮೂದಿಸಿದ ಇಮೇಲ್ ಮತ್ತು ಪಿನ್‌‌ ಹೊಂದಾಣಿಕೆಯಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="1692115862433274081">ಬೇರೊಂದು ಖಾತೆಯನ್ನು ಬಳಸಿ</translation>
<translation id="1695487653372841667">Google ಜೊತೆಗೆ ಯಾವ ಡೇಟಾವನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ ಎನ್ನುವುದನ್ನು ನೀವು ನಿಯಂತ್ರಿಸಬಹುದು. ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="169675691788639886">ಸಾಧನವನ್ನು SSH ಸರ್ವರ್‌ನೊಂದಿಗೆ ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾಗಿದೆ. ಸೂಕ್ಷ್ಮ ಖಾತೆಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸೈನ್ ಇನ್ ಮಾಡಬೇಡಿ.</translation>
<translation id="1700517974991662022">ಭೇಟಿ ನೀಡಲಾಗಿದೆ</translation>
<translation id="1730666151302379551">ಹಳೆಯ ಪಾಸ್‌ವರ್ಡ್ ಮರೆತುಹೋಗಿದೆ</translation>
<translation id="1741314857973421784">ಮುಂದುವರಿಸಿ</translation>
<translation id="1749645492410897998">ಸಾಫ್ಟ್‌ವೇರ್ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="177053719077591686">Android ಆ್ಯಪ್‌‌ಗಳನ್ನು Google Drive ನಲ್ಲಿ ಬ್ಯಾಕಪ್ ಮಾಡಿ.</translation>
<translation id="1798832846931769717">Meet ಗಾಗಿ Google Beam</translation>
<translation id="1806335016774576568">ತೆರೆದಿರುವ ಬೇರೊಂದು ಆ್ಯಪ್‌ಗೆ ಬದಲಿಸಿ</translation>
<translation id="1826192255355608658">ನಿಮ್ಮ Chrome ಬ್ರೌಸರ್ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಿ</translation>
<translation id="1826657447823925402">ಹಿಮ್ಮುಖ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="1831848493690504725">ಕನೆಕ್ಟ್ ಮಾಡಿದ ನೆಟ್‌ವರ್ಕ್ ಮೂಲಕ ನಾವು Google ಅನ್ನು ತಲುಪಲು ನಮಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ಬೇರೆ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಅಥವಾ ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು (ನೀವು ಪ್ರಾಕ್ಸಿಯನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ) ಪರಿಶೀಲಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="1842766183094193446">ನೀವು ಖಚಿತವಾಗಿಯೂ ಡೆಮೊ ಮೋಡ್ ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಯಸುತ್ತೀರಾ?</translation>
<translation id="1845060436536902492">ChromeOS Flex ನಲ್ಲಿನ ಸ್ಕ್ರೀನ್ ರೀಡರ್, ChromeVox, ಮುಖ್ಯವಾಗಿ ಅಂಧತ್ವ ಅಥವಾ ಕಡಿಮೆ ದೃಷ್ಟಿ ಹೊಂದಿರುವ ಜನರು ಸ್ಪೀಚ್ ಸಿಂಥಸೈಜರ್ ಅಥವಾ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯಿರುವ ಸ್ಕ್ರೀನ್ ಮೇಲೆ ತೋರಿಸಲಾದ ಪಠ್ಯವನ್ನು ಓದಲು ಬಳಸುತ್ತಾರೆ. ChromeVox ಅನ್ನು ಆನ್ ಮಾಡಲು ಸ್ಪೇಸ್ ಬಾರ್ ಅನ್ನು ಒತ್ತಿರಿ. ChromeVox ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ನೀವು ಕ್ವಿಕ್ ಟೂರ್ ಮೂಲಕ ತಿಳಿದುಕೊಳ್ಳುತ್ತೀರಿ.</translation>
<translation id="185766080319917408">ಲಾಂಚರ್ ಕೀ ಎಡ alt ಕೀಯ ಎಡಭಾಗದಲ್ಲಿದೆ</translation>
<translation id="1868617395637139709">Android ಆ್ಯಪ್‌‌ಗಳು ಹಾಗೂ ಸೇವೆಗಳಿಗಾಗಿ ಸ್ಥಳವನ್ನು ಬಳಸಿ.</translation>
<translation id="1877377730633446520">ಇದು ಸುಮಾರು <ph name="REQUIRED_SPACE" /> ಯಷ್ಟು ಸ್ಥಳಾವಕಾಶ ಬಳಸುತ್ತದೆ. ನೀವು ಪ್ರಸ್ತುತ <ph name="FREE_SPACE" /> ಯಷ್ಟು ಸ್ಥಳಾವಕಾಶ ಹೊಂದಿದ್ದೀರಿ.</translation>
<translation id="1878155070920054810">ಅಪ್‌ಡೇಟ್ ಪೂರ್ಣವಾಗುವ ಮೊದಲೇ ನಿಮ್ಮ Chromebook ನ ಪವರ್ ಖಾಲಿಯಾಗುವಂತೆ ಕಾಣುತ್ತಿದೆ. ಅಡಚಣೆಯನ್ನು ತಪ್ಪಿಸಲು, ಅದು ಸರಿಯಾಗಿ ಚಾರ್ಜ್ ಆಗುತ್ತಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="189035593835762169">ನಿಯಮಗಳು ಮತ್ತು ನಿಬಂಧನೆಗಳು</translation>
<translation id="189358972401248634">ಇತರೆ ಭಾಷೆಗಳು</translation>
<translation id="1915734383465415025">ಸ್ಟೋರ್ ಸಂಖ್ಯೆ</translation>
<translation id="1919096511823372013">ಲಿಂಕ್‌ಗಳು, ಎಮೋಜಿಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಸೇರಿಸಿ. ನೀವು Google AI ಅನ್ನು ಬಳಸಿಕೊಂಡು ಚಿತ್ರಗಳನ್ನು ಬರೆಯಲು ಮತ್ತು ರಚಿಸಲು ಸಹಾಯವನ್ನು ಸಹ ಪಡೆಯಬಹುದು.</translation>
<translation id="1922496389170590548">ಮಗುವಿನ ಶಾಲಾ ಖಾತೆ</translation>
<translation id="1931410639376954712"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="1944528062465413897">ಬ್ಲೂಟೂತ್ ಜೋಡಿಸುವ ಕೋಡ್:</translation>
<translation id="1987574314042117472">ಜನಪ್ರಿಯ ಆ್ಯಪ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="1991829061375381344">ಈ Google Meet ಹಾರ್ಡ್‌ವೇರ್ ಸಾಧನವನ್ನು ನೋಂದಣಿ ಮಾಡಲು ನಿಮಗೆ ಸಾಕಷ್ಟು ಲಭ್ಯವಿರುವ ಪರವಾನಗಿಗಳಿಲ್ಲ. ಹೆಚ್ಚಿನದನ್ನು ಖರೀದಿಸಲು ನಿಮ್ಮ ಮರುಮಾರಾಟಗಾರರನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ಈ ಸಂದೇಶವನ್ನು ತಪ್ಪಾಗಿ ನೋಡುತ್ತಿರುವಿರಿ ಎಂದು ಭಾವಿಸುವುದಾದರೆ, ನಿಮ್ಮ ಮರುಮಾರಾಟಗಾರರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="200928901437634269">ನಿಮ್ಮ ಮಗುವಿನ Google ಖಾತೆ ಅಥವಾ ಶಾಲಾ ಖಾತೆಯನ್ನು ಬಳಸಿ. ನೀವು ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಸಹ ಸೆಟ್ ಮಾಡಬಹುದು.</translation>
<translation id="2013550551806600826">ಇದನ್ನು ಬಳಸಿ ನೋಡಿ. ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ, ನಂತರ ಪರೀಕ್ಷಾ ಪ್ರದೇಶದಲ್ಲಿ ಎರಡು ಬೆರಳುಗಳಿಂದ ನಿಮ್ಮ ಟಚ್‌ಪ್ಯಾಡ್ ಮೇಲೆ ಸ್ಕ್ರಾಲ್ ಮಾಡಿ. ನೀವು ಇದನ್ನು ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಸಾಧನ &gt; ಮೌಸ್ ಮತ್ತು ಟಚ್‌ಪ್ಯಾಡ್‌ನಲ್ಲಿಯೂ ಕಾಣಬಹುದು.</translation>
<translation id="2016574333161572915">ನಿಮ್ಮ Google Meet ಹಾರ್ಡ್‌ವೇರ್ ಸೆಟಪ್‌ಗೆ ಸಿದ್ಧವಾಗಿದೆ</translation>
<translation id="2018189721942291407">ನೀವು ನೋಂದಾಯಿಸಬೇಕೆ ಎಂದು ಖಚಿತವಿಲ್ಲವೇ?</translation>
<translation id="2040460856718599782">ಓಹ್! ನೀವು ದೃಢೀಕರಿಸುವ ಪ್ರಯತ್ನದಲ್ಲಿರುವಾಗ ಏನೋ ತಪ್ಪು ನಡೆದಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಸೈನ್‌-ಇನ್‌ ರುಜುವಾತುಗಳನ್ನು ಎರಡು ಬಾರಿ ಪರಿಶೀಲಿಸಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2052572566310583903">ನಿಮ್ಮ ಇತರ ಸಾಧನಗಳಲ್ಲಿ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="2088092308059522196"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದ ನಂತರ ನೋಂದಣಿಯನ್ನು ಮಾತ್ರ ಬೆಂಬಲಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="208928984520943006">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಹೋಮ್ ಸ್ಕ್ರೀನ್‌ಗೆ ಹೋಗಲು, ಕೆಳಗಿನಿಂದ ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ.</translation>
<translation id="2090165459409185032">ನಿಮ್ಮ ಖಾತೆಯ ಮಾಹಿತಿಯನ್ನು ಮರುಪಡೆಯಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ: google.com/accounts/recovery</translation>
<translation id="2133775869826239001">ಸೆಟಪ್ ಮಾಡಲು ಇನ್ನಷ್ಟು ಫೀಚರ್‌ಗಳನ್ನು ಆರಿಸಿ</translation>
<translation id="2135456203358955318">ಡಾಕ್‌‌ ಮಾಡಿರುವ ವರ್ಧಕ</translation>
<translation id="2157779167749714207">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> Gemini ಯೊಂದಿಗೆ ಬರುತ್ತದೆ</translation>
<translation id="2163470535490402084">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಗೊಳಿಸಿ.</translation>
<translation id="2173801458090845390">ಈ ಸಾಧನಕ್ಕೆ ನಿಯೋಜನ ಐಡಿ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="2178585470774851578">ನೀವು ChromeOS Flex ಡೀಬಗ್ ಮಾಡುವಿಕೆಯ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತಿದ್ದು, ಅದು sshd daemon ಅನ್ನು ಸೆಟಪ್ ಮಾಡುತ್ತದೆ ಮತ್ತು USB ಡ್ರೈವ್‌ಗಳಿಂದ ಬೂಟ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ.</translation>
<translation id="2183570493397356669">ಮುಂದುವರೆಸಿ ಬಟನ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="2210462644007531147">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="221872881068107022">ಹಿಮ್ಮುಖ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆ</translation>
<translation id="2219081237089444028">ಸೈನ್ ಇನ್ ಮಾಡಲು ಸುಲಭಗೊಳಿಸುವುದಕ್ಕಾಗಿ <ph name="DEVICE_TYPE" /> ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="222115440608612541">ಸೂರ್ಯೋದಯ ಮತ್ತು ಸೂರ್ಯಾಸ್ತದ ಸಮಯದಲ್ಲಿ ಥೀಮ್‌ಗಳನ್ನು ಬದಲಿಸಿ</translation>
<translation id="2229161054156947610">1 ಗಂಟೆಗಿಂತಲೂ ಹೆಚ್ಚು ಬಾಕಿ ಉಳಿದಿದೆ</translation>
<translation id="2246129643805925002">ನಿಮಗೆ ಇತ್ತೀಚಿನ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಭದ್ರತಾ ಸುಧಾರಣೆಗಳನ್ನು ನೀಡಲು, ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ. ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅಪ್‌ಡೇಟ್ ಆದ್ಯತೆಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು.</translation>
<translation id="2274840746523584236">ನಿಮ್ಮ Chromebook ಅನ್ನು ಚಾರ್ಜ್ ಮಾಡಿ</translation>
<translation id="2296022312651137376"><ph name="EMAIL" /> ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ <ph name="DOMAIN_NAME" /> ಡೊಮೇನ್‌ಗೆ ಸಾಧನವು ಆನ್‌ಲೈನ್‌ನಲ್ಲಿರಬೇಕು</translation>
<translation id="2317842250900878657"><ph name="PROGRESS_PERCENT" /> % ಮುಗಿದಿದೆ</translation>
<translation id="2319072477089403627">ನಿಮ್ಮ Android ಫೋನ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ...</translation>
<translation id="2328137272841210255">ನಿಮ್ಮ ಪಿನ್ ಅನ್ನು ರೀಸೆಟ್ ಮಾಡಿ</translation>
<translation id="2342180549977909852">ನಿಮ್ಮ ಮಗುವು ಈ ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್‌ ಮಾಡಲು ಪಾಸ್‌ವರ್ಡ್‌ ಬದಲಾಗಿ ಸಂಖ್ಯೆ (ಪಿನ್‌) ಅನ್ನು ಬಳಸಬಹುದು. ನಂತರದಲ್ಲಿ ಪಿನ್ ಸೆಟ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ.</translation>
<translation id="2359808026110333948">ಮುಂದುವರೆಸಿ</translation>
<translation id="2387052489799050037">ಹೋಮ್‌ಗೆ ಹೋಗಿ</translation>
<translation id="2395616325548404795">ಎಂಟರ್‌ಪ್ರೈಸ್ ನಿರ್ವಹಣೆಗಾಗಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಯಶಸ್ವಿಯಾಗಿ ನೋಂದಾಯಿಸಲಾಗಿದೆ, ಆದರೆ ಅದರ ಅಸೆಟ್ ಹಾಗೂ ಸ್ಥಳ ಮಾಹಿತಿಯನ್ನು ಕಳುಹಿಸಲು ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ಈ ಸಾಧನಕ್ಕಾಗಿ ನಿಮ್ಮ ನಿರ್ವಾಹಕ ಕನ್ಸೋಲ್‌ನಿಂದ ಈ ಮಾಹಿತಿಯನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ನಮೂದಿಸಿ.</translation>
<translation id="2408955596600435184">ನಿಮ್ಮ ಪಿನ್ ನಮೂದಿಸಿ</translation>
<translation id="2418307627282545839">ಎಲ್ಲವನ್ನೂ ಪ್ರಕಾಶಮಾನ ಮತ್ತು ಉಲ್ಲಾಸಕರವಾಗಿರಿಸಿ</translation>
<translation id="243179355394256322">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅಧಿಕೃತ ಬಳಕೆದಾರರಿಗೆ ಮಾತ್ರ ಸಾಧನದ ನೋಂದಣಿಯನ್ನು ಮಿತಿಗೊಳಿಸುತ್ತದೆ. ಈ ಬಳಕೆದಾರರಿಗೆ ಸಾಧನಗಳನ್ನು ನೋಂದಣಿ ಮಾಡಲು ಅಧಿಕಾರವಿಲ್ಲ. ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನ ಬಳಕೆದಾರರ ವಿಭಾಗದಲ್ಲಿರುವ ಬಳಕೆದಾರರು "Google Meet ಹಾರ್ಡ್‌ವೇರ್ ನೋಂದಣಿ ಮಾಡಿ" ನಿರ್ವಾಹಕರ ಸವಲತ್ತು ಹೊಂದಿದ್ದಾರೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="2439152382014731627"><ph name="DEVICE_TYPE" /> ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ರೀಸೆಟ್ ಮಾಡಿ</translation>
<translation id="2441904859060349709"><ph name="BEGIN_PARAGRAPH1" />ಇನ್‌ಸ್ಟಾಲೇಶನ್ <ph name="BEGIN_BOLD" />ನಿಮ್ಮ ಸಂಪೂರ್ಣ ಹಾರ್ಡ್ ಡ್ರೈವ್ ಅನ್ನು ಅಳಿಸುತ್ತದೆ<ph name="END_BOLD" />. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಲಾಗಿದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪ್ರಾರಂಭವಾದ ನಂತರ ಅದನ್ನು ರದ್ದು ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2450223707519584812">Google API ಕೀಗಳು ಕಾಣೆಯಾಗಿರುವ ಕಾರಣ ಬಳಕೆದಾರರನ್ನು ಸೇರಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ವಿವರಗಳಿಗೆ <ph name="DETAILS_URL" /> ನೋಡಿ.</translation>
<translation id="24786041351753425">ಡೇಟಾ ಮರುಪಡೆಯುವಿಕೆ ಸೇವೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.</translation>
<translation id="2485681265915754872">Google Play ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="248676429071089168">ಪುಟವನ್ನು ಕೆಳಕ್ಕೆ ಸರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ</translation>
<translation id="2501278716633472235">ಹಿಂದಿರುಗಿ</translation>
<translation id="252418934079508528"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="2538084450874617176">ಈ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಯಾರು ಬಳಸುತ್ತಿದ್ದಾರೆ?</translation>
<translation id="2553340429761841190"><ph name="NETWORK_ID" /> ಅನ್ನು ಸಂಪರ್ಕಿಸಲು <ph name="PRODUCT_NAME" /> ಗೆ ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು ಇನ್ನೊಂದು ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2565214867520763227">ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="2569972178052279830">ರಿಟೇಲರ್ ಹೆಸರು</translation>
<translation id="257779572837908839">ಸಭೆಗಳಿಗಾಗಿ Chromebox ಅನ್ನು ಸೆಟಪ್‌ ಮಾಡಿ</translation>
<translation id="2582253231918033891"><ph name="PRODUCT_NAME" /><ph name="PRODUCT_VERSION" /> (ಪ್ಲ್ಯಾಟ್‌ಫಾರ್ಮ್ <ph name="PLATFORM_VERSION" />) <ph name="DEVICE_SERIAL_NUMBER" /></translation>
<translation id="2593499352046705383">ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು, ನಿಮ್ಮ ಡೇಟಾದ ಬ್ಯಾಕಪ್ ನಿಮ್ಮ ಬಳಿ ಇದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ. <ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದರಿಂದ ನಿಮ್ಮ ಹಾರ್ಡ್ ಡ್ರೈವ್ ಓವರ್‌ರೈಟ್ ಆಗುತ್ತದೆ. g.co/flex/InstallGuide ನಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="2606454609872547359">ಇಲ್ಲ, ChromeVox ಇಲ್ಲದೆಯೇ ಮುಂದುವರಿಸಿ</translation>
<translation id="2619007277744171543"><ph name="BEGIN_PARAGRAPH1" />ಈ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಅಂದಾಜು ಮಾಡುವುದಕ್ಕೆ ಸಹಾಯ ಮಾಡಲು, Google ನ ಸ್ಥಳ ಸೇವೆಯು ವೈ-ಫೈ, ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್‌ಗಳು ಮತ್ತು ಸೆನ್ಸರ್‌ಗಳಂತಹ ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಆ್ಯಪ್‌ಗಳು &gt; Google Play Store &gt; Android ಆದ್ಯತೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ &gt; ಸುರಕ್ಷತೆ ಮತ್ತು ಸ್ಥಳ &gt; ಸ್ಥಳ ಎಂಬಲ್ಲಿಗೆ ಹೋಗುವ ಮೂಲಕ ನೀವು ಈ ಸಾಧನದಲ್ಲಿ Android ಸ್ಥಳವನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು. ಅದೇ ಮೆನುವಿನಲ್ಲಿ “Google ಸ್ಥಳ ನಿಖರತೆಯನ್ನು” ಆಫ್ ಮಾಡುವ ಮೂಲಕ ನೀವು Android ಸ್ಥಳಕ್ಕಾಗಿ ವೈ-ಫೈ, ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್‌ಗಳು ಮತ್ತು ಸೆನ್ಸರ್‌ಗಳ ಬಳಕೆಯನ್ನು ಸಹ ಆಫ್ ಮಾಡಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2663302507110284145">ಭಾಷೆ</translation>
<translation id="2687407218262674387">Google ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="2688196195245426394">ಸರ್ವರ್‌ನೊಂದಿಗೆ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸುವಾಗ ದೋಷ: <ph name="CLIENT_ERROR" />.</translation>
<translation id="2698147581454716013">ಇದು ಸಂಯೋಜಿತ ಸಾಧನವಾಗಿವೆ ಹಾಗೂ ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಅಪ್‌ಗ್ರೇಡ್‌ನೊಂದಿಗೆ ನೋಂದಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="2722540561488096675">ನಿಮ್ಮ ಸಾಧನವು <ph name="TIME_LEFT" /> ಸಮಯದೊಳಗೆ ಶಟ್ ಡೌನ್ ಆಗುತ್ತದೆ. ನಿಮ್ಮ ಸಾಧನವನ್ನು ಪುನಃ ಆನ್ ಮಾಡುವ ಮೊದಲು USB ತೆಗೆದುಹಾಕಿ. ನಂತರ ನೀವು <ph name="DEVICE_OS" /> ಬಳಕೆಯನ್ನು ಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="2725200716980197196">ನೆಟ್‌ವರ್ಕ್‌ ಸಂಪರ್ಕತೆಯನ್ನು ಮರುಸ್ಥಾಪಿಲಾಗಿದೆ</translation>
<translation id="2731700343119398978">ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ...</translation>
<translation id="2732134891301408122"><ph name="TOTAL_ELEMENTS" /> ರಲ್ಲಿ <ph name="CURRENT_ELEMENT" /> ಹೆಚ್ಚುವರಿ ಕಂಟೆಂಟ್‌</translation>
<translation id="2740531572673183784">ಸರಿ</translation>
<translation id="2742448780373473567"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದರಿಂದ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿನ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಓವರ್‌ವ್ರೈಟ್ ಮಾಡುತ್ತದೆ.</translation>
<translation id="274318651891194348">ಕೀಬೋರ್ಡ್ ಅನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ</translation>
<translation id="2754825024506485820">Google Play Store ನಲ್ಲಿ ಉತ್ಪಾದಕತೆಯಿಂದ ಹಿಡಿದು ಮನರಂಜನೆಯವರೆಗೆ ನಿಮಗೆ ಅಗತ್ಯವಿರುವ ಆ್ಯಪ್‌ಗಳನ್ನು ಹುಡುಕಿ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದು.</translation>
<translation id="2758774297008336689"><ph name="BEGIN_PARAGRAPH1" />ಸ್ಥಳದ ನಿಖರತೆ ಆನ್ ಆಗಿರುವಾಗ, ವೈ-ಫೈ ಆ್ಯಕ್ಸೆಸ್ ಪಾಯಿಂಟ್‌ಗಳು ಹಾಗೂ ಸೆಲ್ಯುಲಾರ್ ನೆಟ್‌ವರ್ಕ್ ಟವರ್‌ಗಳಂತಹ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು ಆ್ಯಕ್ಸಿಲೆರೊಮೀಟರ್ ಮತ್ತು ಗೈರೊಸ್ಕೋಪ್‌ನಂತಹ ಸಾಧನ ಸೆನ್ಸಾರ್ ಡೇಟಾದೊಂದಿಗೆ ಹೆಚ್ಚು ನಿಖರವಾದ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಅಂದಾಜು ಮಾಡಲು ಬಳಸಲಾಗುತ್ತದೆ, ಅವುಗಳನ್ನು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳು ಸ್ಥಳ-ಆಧಾರಿತ ಫೀಚರ್‌ಗಳನ್ನು ಒದಗಿಸಲು ಬಳಸುತ್ತವೆ. ಇದನ್ನು ಮಾಡಲು, ಕ್ರೌಡ್‌ಸೋರ್ಸ್ ಮಾಡಿದ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್ ಸ್ಥಳಗಳಿಗೆ ಕೊಡುಗೆ ನೀಡಲು ಈ ಸಾಧನದ ಸಮೀಪವಿರುವ ಸಾಧನದ ಸೆನ್ಸರ್‌ಗಳು ಮತ್ತು ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತಾದ ಮಾಹಿತಿಯನ್ನು Google ನಿಯತಕಾಲಿಕವಾಗಿ ಸಂಗ್ರಹಿಸುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಈ ಸಾಧನದಿಂದ ಸಂಗ್ರಹಿಸಲಾದ ಈ ಮಾಹಿತಿಯನ್ನು ಇವುಗಳಿಗಾಗಿ Google ಬಳಸುತ್ತದೆ: ಸ್ಥಳದ ನಿಖರತೆ ಮತ್ತು ಸ್ಥಳ ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು; ಹಾಗೂ ಸಾಮಾನ್ಯವಾಗಿ Google ನ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು, ಒದಗಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು. ಬಳಕೆದಾರರ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಲು Google ಮತ್ತು ಥರ್ಡ್ ಪಾರ್ಟಿಗಳ ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ ನಾವು ಈ ಮಾಹಿತಿಯನ್ನು ಪ್ರಾಸೆಸ್ ಮಾಡುತ್ತೇವೆ. ಯಾವುದೇ ವ್ಯಕ್ತಿಯನ್ನು ಗುರುತಿಸಲು ಈ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />ನೀವು ಈ ಸಾಧನದ ಸ್ಥಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ &gt; ಗೌಪ್ಯತೆ ನಿಯಂತ್ರಣಗಳು &gt; ಸ್ಥಳದ ಆ್ಯಕ್ಸೆಸ್ &gt; ಸುಧಾರಿತ ಸ್ಥಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಅಡಿಯಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಸ್ಥಳದ ನಿಖರತೆಯನ್ನು ಆಫ್ ಮಾಡಬಹುದು. ಸ್ಥಳದ ನಿಖರತೆ ಆಫ್ ಆಗಿದ್ದರೆ, ಯಾವುದೇ ಸ್ಥಳದ ನಿಖರತೆಯ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ. Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ, ಲಭ್ಯವಿದ್ದರೆ ಈ ಸಾಧನದ ಸ್ಥಳವನ್ನು ನಿರ್ಧರಿಸಲು, IP ವಿಳಾಸವನ್ನು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ, ಇದು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು Google Maps ನಂತಹ ಸೇವೆಗಳಿಗೆ ಸ್ಥಳಗಳ ಲಭ್ಯತೆ ಮತ್ತು ನಿಖರತೆಯ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರಬಹುದು.<ph name="END_PARAGRAPH3" /></translation>
<translation id="2805539617243680210">ನೀವು ಸಿದ್ಧರಾಗಿರುವಿರಿ!</translation>
<translation id="2819519502129272135">ಫೈಲ್ ಸಿಂಕ್ ಅನ್ನು ಆಫ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="2832124733806557606">ಸಾಧನಕ್ಕೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಅಥವಾ ಅದನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲು ನಿಮ್ಮ ಮಗುವು ಪಿನ್ ಬಳಸಬಹುದು.</translation>
<translation id="283669119850230892">ನೆಟ್‌ವರ್ಕ್ <ph name="NETWORK_ID" /> ಅನ್ನು ಬಳಸಲು, ಮೊದಲು ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಕೆಳಗಿನ ಇಂಟರ್‌ನೆಟ್‌ಗೆ ಸಂಪೂರ್ಣಗೊಳಿಸಿ.</translation>
<translation id="2849767214114481738">ನಿಮ್ಮ ಪಿನ್ ಅನ್ನು ಸೇರಿಸಲಾಗಿದೆ</translation>
<translation id="2851810309108851898"><ph name="BEGIN_PARAGRAPH1" />ಸ್ವಯಂಚಾಲಿತ ವರದಿಗಳನ್ನು ಕಳುಹಿಸಲು ChromeOS ಸಾಧನಗಳಿಗೆ ಅನುಮತಿಸುವುದರಿಂದ, ChromeOS ನಲ್ಲಿ ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಮತ್ತು ಸುಧಾರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆದ್ಯತೆಯ ಪ್ರಕಾರ ನಿರ್ವಹಿಸಲು ನಮಗೆ ಸಹಾಯವಾಗುತ್ತದೆ. Chrome OS ಯಾವಾಗ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತದೆ, ಯಾವ ಫೀಚರ್‌ಗಳನ್ನು ಬಳಸಲಾಗಿದೆ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಮೆಮೊರಿಯನ್ನು ಬಳಸಲಾಗಿದೆ ಎನ್ನುವಂತಹ ವಿಷಯಗಳು ಈ ವರದಿಗಳಲ್ಲಿ ಸೇರಿರಬಹುದು.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮ Chrome ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ, ನೀವು ಈ ವರದಿಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಾರಂಭಿಸಬಹುದು ಅಥವಾ ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಡೊಮೇನ್ ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2861301611394761800">ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್‌‌ ಪೂರ್ಣಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು ಸಿಸ್ಟಂ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="2870909136778269686">ಅಪ್‌ಡೇಟ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ...</translation>
<translation id="2872961005593481000">ಮುಚ್ಚಿಬಿಡಿ </translation>
<translation id="2886119409731773154">ಇದು 30 ನಿಮಿಷಗಳವರೆಗಿನ ಕಾಲಾವಕಾಶ ತೆಗೆದುಕೊಳ್ಳಬಹುದು</translation>
<translation id="2893180576842394309">ಹುಡುಕಾಟ ಮತ್ತು ಇತರ Google ಸೇವೆಗಳನ್ನು ವೈಯಕ್ತೀಕರಿಸಲು ನಿಮ್ಮ ಇತಿಹಾಸವನ್ನು Google ಬಳಸಬಹುದು.</translation>
<translation id="2902265136119311513">ಅತಿಥಿಯಂತೆ ಬ್ರೌಸ್ ಮಾಡಿ</translation>
<translation id="2904210161403910217">ನೀವು ಕೊನೆಯ ಬಾರಿ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗಿನಿಂದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಬದಲಾಗಿದೆ</translation>
<translation id="2918484644467055090">ಈ ಸಾಧನವನ್ನು ನಿಮ್ಮ ಖಾತೆಗೆ ಸಂಬಂಧಿಸಿದ ಸಂಸ್ಥೆಗೆ ಸೇರಿಸಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ ಏಕೆಂದರೆ ಈ ಸಾಧನವನ್ನು ಬೇರೊಂದು ಸಂಸ್ಥೆಯ ಮೂಲಕ ನಿರ್ವಹಿಸಲು ಗುರುತಿಸಲಾಗಿದೆ.</translation>
<translation id="2921081876747860777">ನಿಮ್ಮ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು ದಯವಿಟ್ಟು ಪಾಸ್‌ವರ್ಡ್ ರಚಿಸಿ.</translation>
<translation id="2935654492420446828">ನಂತರ ಶಾಲೆಯ ಖಾತೆಯೊಂದನ್ನು ಸೇರಿಸಿ</translation>
<translation id="2950666755714083615">ನನ್ನನ್ನು ಸೈನ್ ಅಪ್ ಮಾಡಿ</translation>
<translation id="2979966855249721010">ನಿಮ್ಮ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ, ನೀವು ಆ್ಯಪ್ ಶಿಫಾರಸುಗಳು, ಸಲಹೆಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ನೋಡಬಹುದು</translation>
<translation id="3012917896646559015">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ದುರಸ್ತಿ ಸೌಲಭ್ಯಕ್ಕೆ ಕಳುಹಿಸಲು ದಯವಿಟ್ಟು ನಿಮ್ಮ ಹಾರ್ಡ್‌ವೇರ್ ತಯಾರಕರನ್ನು ತಕ್ಷಣವೇ ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="3023464535986383522">ಧ್ವನಿ ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="3028371505549235127">ಸೈನ್ ಇನ್ ಮಾಡುವುದಕ್ಕಾಗಿ ನಿಮ್ಮ Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸುವ ಬದಲು, ನೀವು ಈ ಸಾಧನಕ್ಕಾಗಿ <ph name="DEVICE_TYPE" /> ಪಾಸ್‌ವರ್ಡ್ ಒಂದನ್ನು ರಚಿಸಬಹುದು</translation>
<translation id="3033348223765101500">ನಿಮ್ಮ ಡೇಟಾ ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="3090871774332213558">"<ph name="DEVICE_NAME" />" ಜೋಡಿಸಲಾಗಿದೆ</translation>
<translation id="3101924772906986970">ನಿಮ್ಮ Chrome ಬ್ರೌಸರ್ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ</translation>
<translation id="313205617302240621">ಪಾಸ್‌ವರ್ಡ್ ಮರೆತಿರುವಿರಾ?</translation>
<translation id="3162070126914310576">ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಘಟಕವು ತನ್ನ ಆರಂಭಿಕ ನೋಂದಣಿ ಮಿತಿಯನ್ನು ತಲುಪಿರುವ ಕಾರಣ ಈ ಸಾಧನವನ್ನು ಇದೀಗ ನೋಂದಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಸಹಾಯಕ್ಕಾಗಿ ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="3163511056918491211">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಸುಲಭವಾಗಿ ಮರುಸ್ಥಾಪಿಸಿ ಅಥವಾ ಸಾಧನಗಳನ್ನು ಬದಲಿಸಿ. ನಿಮ್ಮ ಬ್ಯಾಕಪ್‌ಗಳನ್ನು Google ನಲ್ಲಿ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಳಸಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="3169930038976362151">ನಿಮ್ಮ ಅಗತ್ಯಗಳಿಗೆ ಸರಿಹೊಂದುವ ಥೀಮ್ ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಥೀಮ್, ವಾಲ್‌ಪೇಪರ್, ಸ್ಕ್ರೀನ್ ಸೇವರ್ ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಬದಲಾಯಿಸಲು, ಡೆಸ್ಕ್‌ಟಾಪ್ ಅನ್ನು ಸ್ಪರ್ಶಿಸಿ ಮತ್ತು ಒತ್ತಿ ಹಿಡಿಯಿರಿ.</translation>
<translation id="3170072451822350649">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡುವುದನ್ನು ಸ್ಕಿಪ್‌ ಮಾಡಬಹುದು ಹಾಗೂ <ph name="LINK_START" />ಅತಿಥಿಯಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು<ph name="LINK_END" />.</translation>
<translation id="3177914167275935955">ನಿಮ್ಮ ಸಾಧನವು Chrome Education ಅಪ್‌ಗ್ರೇಡ್ ಅನ್ನು ಹೊಂದಿದೆ, ಆದರೆ ನಿಮ್ಮ ಬಳಕೆದಾರ ಹೆಸರು ಅದಕ್ಕೆ ಸಂಬಂಧಿಸಿದ Google for Education ಖಾತೆಯನ್ನು ಹೊಂದಿಲ್ಲ. ಸೆಕೆಂಡರಿ ಸಾಧನದಲ್ಲಿ g.co/workspace/edusignup ಗೆ ಭೇಟಿ ನೀಡುವ ಮೂಲಕ Google for Education ಖಾತೆಯನ್ನು ರಚಿಸಿ.</translation>
<translation id="3196912927885212665">ನಿಮ್ಮ Android ಫೋನ್‌ ಮೂಲಕ ಸೆಟಪ್‌ ಮಾಡಲು, ನಿಮ್ಮ Chromebook ನ ಬ್ಲೂಟೂತ್ ಆನ್ ಆಗಿರಬೇಕು</translation>
<translation id="322708765617468434">ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ ನೀವು ಯಾವಾಗಲೂ ಇನ್ನೊಬ್ಬ ವ್ಯಕ್ತಿಯನ್ನು ಸಾಧನಕ್ಕೆ ಸೇರಿಸಬಹುದು. ಪ್ರತಿಯೊಬ್ಬ ವ್ಯಕ್ತಿಯು ತಮ್ಮ ಅನುಭವವನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಬಹುದು ಮತ್ತು ಡೇಟಾವನ್ನು ಖಾಸಗಿಯಾಗಿರಿಸಬಹುದು.</translation>
<translation id="3238192140106069382">ಕನೆಕ್ಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ ಮತ್ತು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="3251119461199395237">ಫೈಲ್ ಸಿಂಕ್</translation>
<translation id="325238099842880997">ಮಕ್ಕಳಿಗೆ ಮನೆಯಲ್ಲಿ ಆಟವಾಡಲು, ಅನ್ವೇಷಿಸಲು ಮತ್ತು ಶಾಲೆಯ ಕೆಲಸ ಮಾಡಲು ಸಹಾಯ ಮಾಡುವುದಕ್ಕಾಗಿ ತಳಮಟ್ಟದ ಡಿಜಿಟಲ್ ನಿಯಮಗಳನ್ನು ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="3255747772218936245">ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="3261268979727295785">ದೊಡ್ಡ ಮಕ್ಕಳಿಗಾಗಿ, ಸೆಟಪ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿದ ನಂತರ ನೀವು ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಸೇರಿಸಬಹುದು. ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಆ್ಯಪ್‌ನಲ್ಲಿ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳ ಕುರಿತ ಮಾಹಿತಿಯನ್ನು ನೀವು ಕಾಣಬಹುದು.</translation>
<translation id="3278001907972365362">ನಿಮ್ಮ Google ಖಾತೆಗಳ ಮೇಲೆ ಗಮನಹರಿಸಬೇಕಿದೆ</translation>
<translation id="3283148363895519428">ಸೆಟಪ್ ಮುಂದುವರಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ. ನಿಮ್ಮ ಫೋನ್ ಹತ್ತಿರದಲ್ಲಿದೆ ಮತ್ತು ಬ್ಲೂಟೂತ್ ಆನ್ ಆಗಿದೆಯೇ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="3327050066667856415">Chromebooks ಅನ್ನು ಸುರಕ್ಷತೆಗಾಗಿ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಸಾಧನವನ್ನು ಮಾಲ್‌ವೇರ್‌ನಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ರಕ್ಷಿಸಲಾಗಿದೆ - ಹೆಚ್ಚುವರಿ ಸಾಫ್ಟ್‌ವೇರ್‌ನ ಅಗತ್ಯವಿಲ್ಲ.</translation>
<translation id="3382073616108123819">ಓಹ್‌‌!  ಈ ಸಾಧನಕ್ಕಾಗಿ ಸಾಧನ ಗುರುತಿಸುವಿಕೆಗಳನ್ನು ನಿರ್ಧರಿಸಲು ಸಿಸ್ಟಂ ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="3382200254148930874">ಮೇಲ್ವಿಚಾರಣೆಯನ್ನು ನಿಲ್ಲಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3384362484379805487">ಡಿಸ್ಕ್ ಸ್ಪೇಸ್ ಉಳಿತಾಯ ಮಾಡಲು ಬಳಕೆದಾರರ ನಡುವೆ ಭಾಷಾ ಫೈಲ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ.</translation>
<translation id="3385092118218578224"><ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3391721320619127327">ChromeOS Flex ನಲ್ಲಿನ ಸ್ಕ್ರೀನ್ ರೀಡರ್, ChromeVox, ಮುಖ್ಯವಾಗಿ ಅಂಧತ್ವ ಅಥವಾ ಕಡಿಮೆ ದೃಷ್ಟಿ ಹೊಂದಿರುವ ಜನರು ಸ್ಪೀಚ್ ಸಿಂಥಸೈಜರ್ ಅಥವಾ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯಿರುವ ಸ್ಕ್ರೀನ್ ಮೇಲೆ ತೋರಿಸಲಾದ ಪಠ್ಯವನ್ನು ಓದಲು ಬಳಸುತ್ತಾರೆ. ChromeVox ಅನ್ನು ಆನ್ ಮಾಡಲು ಎರಡೂ ವಾಲ್ಯೂಮ್ ಕೀಗಳನ್ನು ಐದು ಸೆಕೆಂಡುಗಳ ಕಾಲ ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ. ChromeVox ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ನೀವು ಕ್ವಿಕ್ ಟೂರ್ ಮೂಲಕ ತಿಳಿದುಕೊಳ್ಳುತ್ತೀರಿ.</translation>
<translation id="3402585168444815892">ಡೆಮೋ ಮೋಡ್‌ನಲ್ಲಿ ನೋಂದಣಿ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="3433621910545056227">ಓಹ್! ಸಾಧನ ಇನ್‌ಸ್ಟಾಲೇಶನ್-ಸಮಯದ ಲಕ್ಷಣಗಳ ಲಾಕ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಿಸ್ಟಂ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3435896845095436175">ಸಕ್ರಿಯಗೊಳಿಸು</translation>
<translation id="3462413494201477527">ಖಾತೆ ಸೆಟಪ್ ರದ್ದುಗೊಳಿಸುವುದೇ?</translation>
<translation id="3473241910002674503">ಟ್ಯಾಬ್ಲೆಟ್ ಮೋಡ್‌ನಲ್ಲಿ, ಹೋಮ್‌ಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು, ಹಿಂತಿರುಗಲು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು ಬಟನ್‌ಗಳನ್ನು ಬಳಸಿ.</translation>
<translation id="3473479545200714844">ಸ್ಕ್ರೀನ್ ವರ್ಧಕ</translation>
<translation id="3491669675709357988">ನಿಮ್ಮ ಮಗುವಿನ ಖಾತೆಯನ್ನು Family Link ಪೋಷಕ ನಿಯಂತ್ರಣಗಳಿಗಾಗಿ ಸೆಟಪ್ ಮಾಡಲಾಗಿಲ್ಲ. ನೀವು ಸೆಟಪ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿದ ನಂತರ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಸೇರಿಸಬಹುದು. ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಆ್ಯಪ್‌ನಲ್ಲಿ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳ ಕುರಿತ ಮಾಹಿತಿಯನ್ನು ನೀವು ಕಾಣಬಹುದು.</translation>
<translation id="350397915809787283">ನೀವು ಖಾತೆಯನ್ನು ಹೊಂದಿಲ್ಲದಿದ್ದರೆ, ಒಂದನ್ನು ರಚಿಸಲು ಮೊದಲ ಆಯ್ಕೆಯನ್ನು ಆರಿಸಿ.</translation>
<translation id="3520824492621090923">ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಸಾಧನದ ನೋಂದಣಿಯನ್ನು ಖಚಿತಪಡಿಸಬೇಕೇ?</translation>
<translation id="3547954654003013442">ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="3550915441744863158">Chrome ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ. ಹೀಗಾಗಿ ನೀವು ಯಾವಾಗಲೂ ತಾಜಾ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರುತ್ತೀರಿ.</translation>
<translation id="3559533181353831840"><ph name="TIME_LEFT" /> ಸಮಯ ಬಾಕಿ ಉಳಿದಿದೆ</translation>
<translation id="3567129848895158510"><ph name="BEGIN_PARAGRAPH1" />ಈ ಡೆಮೊ ಸಾಧನಕ್ಕೆ ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾಗುತ್ತಿರುವ ರಿಟೇಲರ್ ಹೆಸರು ಮತ್ತು ಸ್ಟೋರ್ ಸಂಖ್ಯೆಯನ್ನು ನಮೂದಿಸಿ*. <ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />ನಿಮಗೆ ಸ್ಟೋರ್ ಸಂಖ್ಯೆ ತಿಳಿದಿಲ್ಲದಿದ್ದರೆ, ಡೆಮೊ ಮೋಡ್ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ಮುಂದುವರಿಸಲು ನೀವು "0000" ಅನ್ನು ನಮೂದಿಸಬಹುದು. <ph name="END_PARAGRAPH2" />
    <ph name="BEGIN_PARAGRAPH3" />*ಗಮನಿಸಿ: ಸಾಧನವು ಡೆಮೋ ಮೋಡ್‌ನ ಯಾವ ಆವೃತ್ತಿಯನ್ನು ಸ್ವೀಕರಿಸಬೇಕು ಎಂಬುದನ್ನು ಗುರುತಿಸಲು ಮತ್ತು ಡೆಮೋ ಮೋಡ್‌ನ ಬಳಕೆಯನ್ನು ಮಾಪನ ಮಾಡಲು Google ಈ ಮಾಹಿತಿಯನ್ನು ಬಳಸುತ್ತದೆ.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3577473026931028326">ಏನೋ ತಪ್ಪಾಗಿದೆ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3577745545227000795"><ph name="DEVICE_OS" /> ಹಾರ್ಡ್‌ವೇರ್ ಡೇಟಾ ಸಂಗ್ರಹಣೆ</translation>
<translation id="3602290021589620013">ಪೂರ್ವವೀಕ್ಷಣೆ</translation>
<translation id="3607671391978830431">ಮಗುವಿಗಾಗಿ</translation>
<translation id="3627320433825461852">1 ನಿಮಿಷಕ್ಕಿಂತಲೂ ಕಡಿಮೆ ಬಾಕಿ ಉಳಿದಿದೆ</translation>
<translation id="3635199270495525546">ವಿಶ್ವಾಸಾರ್ಹ ಪ್ಲ್ಯಾಟ್‌ಫಾರ್ಮ್ ಮಾಡ್ಯುಲ್ (TPM) ಪತ್ತೆಯಾಗಿದೆ</translation>
<translation id="3650753875413052677">ನೋಂದಣಿ ದೋಷ</translation>
<translation id="3661106764436337772">ವೇಗವಾಗಿ ಮತ್ತು ಹೆಚ್ಚು ವಿಶ್ವಾಸದಿಂದ ಬರೆಯಿರಿ</translation>
<translation id="3662207097851752847">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ದೃಢೀಕರಿಸಿ</translation>
<translation id="3672681487849735243">ತಯಾರಿಕೆಯ ದೋಷವನ್ನು ಪತ್ತೆ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="3673097791729989571">ಸೈನ್ ಇನ್ ಅನ್ನು <ph name="SAML_DOMAIN" /> ಮೂಲಕ ಹೋಸ್ಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="3673287357837016374">ನಿಮ್ಮ ಪಿನ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="367645871420407123">ರೂಟ್ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಪರೀಕ್ಷೆ ಚಿತ್ರ ಮೌಲ್ಯಕ್ಕೆ ಹೊಂದಿಸಲು ನೀವು ಬಯಸಿದರೆ ಖಾಲಿ ಬಿಡಿ</translation>
<translation id="370665806235115550">ಲೋಡ್ ಆಗುತ್ತಿದೆ...</translation>
<translation id="3712050472459130149">ಖಾತೆಯ ಅಪ್‌ಡೇಟ್ ಅಗತ್ಯವಿದೆ</translation>
<translation id="3733296813637058299">ನಿಮಗಾಗಿ ಆ ನಾವು ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡುತ್ತೇವೆ. ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗಾಗಿ ನೀವು ಹೆಚ್ಚಿನ ಆ್ಯಪ್‌ಗಳನ್ನು Play Store ನಲ್ಲಿ ಕಂಡುಕೊಳ್ಳಬಹುದು.</translation>
<translation id="3740945083753997630">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಪಠ್ಯ ಗಾತ್ರವನ್ನು ಕಡಿಮೆ ಮಾಡಿ</translation>
<translation id="376841534249795524">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ನೀವು ಯಾವುದಕ್ಕಾಗಿ ಬಳಸುತ್ತೀರಿ?</translation>
<translation id="3772046291955677288"><ph name="BEGIN_LINK1" />Google ಸೇವಾ ನಿಯಮಗಳು<ph name="END_LINK1" /> ಮತ್ತು <ph name="BEGIN_LINK2" />Chrome ಹಾಗೂ Chrome OS ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳನ್ನು<ph name="END_LINK2" /> ನಾನು ಓದಿದ್ದೇನೆ ಮತ್ತು ಅವುಗಳಿಗೆ ಸಮ್ಮತಿಸುತ್ತೇನೆ.</translation>
<translation id="3789841737615482174">ಇನ್‌ಸ್ಟಾಲ್</translation>
<translation id="3800828618615365228">Google Chrome ಹಾಗೂ Chrome OS ಹೆಚ್ಚುವರಿ ನಿಯಮಗಳು</translation>
<translation id="3828953470056652895"><ph name="BEGIN_LINK1" />Google ಸೇವಾ ನಿಯಮಗಳು<ph name="END_LINK1" />, <ph name="BEGIN_LINK2" />Chrome ಮತ್ತು Chrome OS ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳು<ph name="END_LINK2" /> ಮತ್ತು <ph name="BEGIN_LINK3" />Play ಸೇವಾ ನಿಅಯಮಗಳನ್ನು<ph name="END_LINK3" /> ನಾನು ಓದಿದ್ದೇನೆ ಮತ್ತು ಅವುಗಳಿಗೆ ಸಮ್ಮತಿಸುತ್ತೇನೆ.</translation>
<translation id="3837569373891539515">ಅನ್ವಯಿಸುವ ಎಲ್ಲವನ್ನೂ ನೀವು ಆಯ್ಕೆ ಮಾಡಬಹುದು. ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಸೆಟಪ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿದ ನಂತರ ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಈ ಆಯ್ಕೆಗಳನ್ನು ಸಹ ಕಾಣಬಹುದು.</translation>
<translation id="385051799172605136">ಹಿಂದೆ</translation>
<translation id="3856470183388031602">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ಬಳಸಿ</translation>
<translation id="3856800405688283469">ಸಮಯ ವಲಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="3893630138897523026">ChromeVox (ಮಾತಿನ ಪ್ರತಿಕ್ರಿಯೆ)</translation>
<translation id="3897746662269329507">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಗೇಮಿಂಗ್‌ಗಾಗಿ ನಿರ್ಮಿಸಲಾಗಿದೆ. ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಆ್ಯಪ್ ಮುಂದಿನ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ, ಅಲ್ಲಿ ನೀವು ನೂರಾರು ಹೊಸ ಗೇಮ್‌ಗಳನ್ನು ಪ್ರವೇಶಿಸಬಹುದು, ಗೇಮಿಂಗ್ ಆಫರ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಗೇಮಿಂಗ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಡಿಸ್ಕವರ್ ಮಾಡಬಹುದು.</translation>
<translation id="389901847090970821">ಕೀಬೋರ್ಡ್ ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="3910588685973519483">AI ಮೂಲಕ ವಾಲ್‌ಪೇಪರ್‌ಗಳನ್ನು ರಚಿಸಿ</translation>
<translation id="3924259174674732591">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಪಠ್ಯ ಗಾತ್ರ <ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3950820424414687140">ಸೈನ್ ಇನ್</translation>
<translation id="397703832102027365">ಅಂತಿಮಗೊಳಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3983400541576569538">ಕೆಲವು ಆ್ಯಪ್‌ಗಳ ಡೇಟಾ ನಷ್ಟವಾಗಬಹುದು</translation>
<translation id="3984159763196946143">ಡೆಮೋ ಮೋಡ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="3988996860813292272">ಸಮಯ ವಲಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="3994318741694670028">ದುರದೃಷ್ಟವಶಾತ್, ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಸರಿಯಾಗಿ ರೂಪುಗೊಳ್ಳದ ಹಾರ್ಡ್‌ವೇರ್ ID ಯ ಜೊತೆಗೆ ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾಗಿದೆ. ಇದು ChromeOS Flex ಇತ್ತೀಚಿನ ಭದ್ರತಾ ಸರಿಪಡಿಸುವಿಕೆಗಳೊಂದಿಗೆ ಅಪ್‌ಡೇಟ್ ಆಗುವುದನ್ನು ತಡೆಗಟ್ಟುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ <ph name="BEGIN_BOLD" />ದುರುದ್ದೇಶಪ್ರೇರಿತ ದಾಳಿಗಳಿಗೆ ಗುರಿಯಾಗಬಹುದು<ph name="END_BOLD" />.</translation>
<translation id="4002440992267487163">ಪಿನ್ ಸೆಟಪ್</translation>
<translation id="403725336528835653">ಮೊದಲು ಇದನ್ನು ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="4044883420905480380">ನೀವು ವೈ-ಫೈಗೆ ಕನೆಕ್ಟ್ ಮಾಡಿದ್ದೀರಿ ಮತ್ತು ನಿಮ್ಮ Android ಫೋನ್ ಬಳಸಿಕೊಂಡು <ph name="USER_EMAIL" /> ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ</translation>
<translation id="4047726037116394521">ಮುಖಪುಟಕ್ಕೆ ಹೋಗಿ</translation>
<translation id="4062561150282203854">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಆ್ಯಪ್‌ಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಹಾಗೂ ಇತ್ಯಾದಿಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಿ</translation>
<translation id="4089743381329341712">ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ ಆಯ್ಕೆಮಾಡಿದ ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡಲಾಗುತ್ತದೆ. ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಗೇಮ್‌ಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ ನಂತರ ಹೆಚ್ಚಿನ ಶಿಫಾರಸುಗಳನ್ನು ಹುಡುಕಿ.</translation>
<translation id="4104944259562794668">ನೀವು ಅದನ್ನು ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಭದ್ರತೆ ಮತ್ತು ಗೌಪ್ಯತೆ &gt; ಲಾಕ್ ಸ್ಕ್ರೀನ್ ಮತ್ತು ಸೈನ್-ಇನ್‌ನಲ್ಲಿ ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು</translation>
<translation id="4132183752438206707">Google Play Store ನಲ್ಲಿ  ಆ್ಯಪ್‌ಗಳನ್ನು ಹುಡುಕಿ</translation>
<translation id="4135746311382563554">Google Chrome ಮತ್ತು ChromeOS ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="41365691917097717">ಮುಂದುವರಿಸಿದರೆ, Android ಆ್ಯಪ್‌ಗಳನ್ನು ರಚಿಸಲು ಮತ್ತು ಪರೀಕ್ಷಿಸಲು ADB ಡೀಬಗ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ. ಇದು Google ನಿಂದ ದೃಢೀಕರಿಸದ Android ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಅನುಮತಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಗಮನಿಸಿ ಹಾಗೂ ಇದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಫ್ಯಾಕ್ಟರಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಮರುಹೊಂದಿಸುವ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="4165942112764990069"><ph name="USER_EMAIL" /> ಇಮೇಲ್ ಮಾನ್ಯ ಸಂಸ್ಥೆಗೆ ಸೇರಿಲ್ಲ. ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ಇಲ್ಲಿಗೆ ಭೇಟಿ ನೀಡುವ ಮೂಲಕ ನಿಮ್ಮ ಸಂಸ್ಥೆಯನ್ನು ನೀವು ಸೆಟಪ್ ಮಾಡಬಹುದು: g.co/ChromeEnterpriseAccount</translation>
<translation id="4167393659000039775">ಯಾವುದೇ ಡೇಟಾ ನಷ್ಟಕ್ಕೆ Google ಜವಾಬ್ದಾರರಾಗಿರುವುದಿಲ್ಲ ಮತ್ತು ಪ್ರಮಾಣೀಕರಿಸದ ಮಾದರಿಗಳಲ್ಲಿ <ph name="DEVICE_OS" /> ಕೆಲಸ ಮಾಡದಿರಬಹುದು. g.co/flex/InstallGuide ನಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="4209092469652827314">ದೊಡ್ಡದು</translation>
<translation id="4213918571089943508">ಮಗುವಿನ Google ಖಾತೆ</translation>
<translation id="4228071595943929139">ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಬಳಸಿ</translation>
<translation id="4232484478444192782">Android ಫೋನ್ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೊಂದಿದೆ. ನಿಮ್ಮ ವೈ-ಫೈ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ವರ್ಗಾಯಿಸಲಾಗುತ್ತಿದೆ.</translation>
<translation id="4242145785130247982">ಬಹು ಕ್ಲೈಂಟ್ ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ಬೆಂಬಲಿಸುವುದಿಲ್ಲ</translation>
<translation id="4242577469625748426">ಸಾಧನದಲ್ಲಿ ನೀತಿಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4250680216510889253">ಇಲ್ಲ</translation>
<translation id="4251377547188244181">ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಸಾಧನಗಳ ನೋಂದಣಿ</translation>
<translation id="4263223596040212967">ನಿಮ್ಮ ಕೀಬೋರ್ಡ್ ವಿನ್ಯಾಸವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="4268490040465852105">ನಿಮ್ಮ Google ಖಾತೆಯು Gmail, YouTube, Chrome ಮತ್ತು ಇತರ Google ಉತ್ಪನ್ನಗಳಿಗಾಗಿ ನೀವು ಬಳಸುವ ಅದೇ ಖಾತೆಯಾಗಿದೆ.
        ನಿಮ್ಮ ಎಲ್ಲಾ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಬಳಸಿ.</translation>
<translation id="4278498748067682896">ಸಾಧನವನ್ನು ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಮೋಡ್‌ನಲ್ಲಿ ಮಾತ್ರವೇ ರನ್ ಮಾಡಲು ಅನುಮತಿ ನೀಡುವ ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಅಪ್‌ಗ್ರೇಡ್ ಅನ್ನು ನೀವು ಬಳಸುತ್ತೀರಿ. ಬಳಕೆದಾರರು ಸಾಧನಕ್ಕೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆಂದು ನೀವು ಬಯಸಿದರೆ, ಹಿಂದಕ್ಕೆ ಹೋಗಿ ಮತ್ತು Chrome ಎಂಟರ್‌ಪ್ರೈಸ್ ಅಪ್‌ಗ್ರೇಡ್ ಬಳಸಿಕೊಂಡು ನೋಂದಣಿ ಮಾಡಿ.</translation>
<translation id="4287157641315808225">ಹೌದು, ChromeVox ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="4289732974614035569">ಪಿನ್‌ ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="4291265871880246274">ಲಾಗಿನ್ ಡೈಲಾಗ್</translation>
<translation id="4305817255990598646">ಬದಲಿಸಿ</translation>
<translation id="4309165024397827958">ಸ್ಥಳವನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು ಅನುಮತಿ ಇರುವ Android ಆ್ಯಪ್‌‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಬಳಸಲು ಅನುಮತಿ ನೀಡಿ. Google, ಸ್ಥಳ ಡೇಟಾವನ್ನು ನಿಯಮಿತವಾಗಿ ಸಂಗ್ರಹಿಸಬಹುದು ಮತ್ತು ಸ್ಥಳದ ನಿಖರತೆ ಹಾಗೂ ಸ್ಥಳ-ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು ಈ ಡೇಟಾವನ್ನು ಅನಾಮಧೇಯವಾಗಿ ಬಳಸಬಹುದು.</translation>
<translation id="4317733381297736564">ಆ್ಯಪ್‌ನಲ್ಲಿನ ಖರೀದಿಗಳು</translation>
<translation id="4341905082470253054">TPM ಸ್ಥಿತಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="434198521554309404">ವೇಗ. ಸುರಕ್ಷಿತ. ಶ್ರಮರಹಿತ.</translation>
<translation id="4358643842961018282">ನಿಮ್ಮ ಸಾಧನ ಅಪ್ ಟು ಡೇಟ್ ಆಗಿದೆ</translation>
<translation id="4370975561335139969">ನೀವು ನಮೂದಿಸಿದ ಇಮೇಲ್ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="4373418556073552953">ನಿಮ್ಮ Android ಫೋನ್‌ನೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="4378556263712303865">ಸಾಧನದ ನಿಯೋಜನೆ</translation>
<translation id="4383048845287221326"><ph name="BEGIN_PARAGRAPH1" />ಸ್ವಯಂಚಾಲಿತ ವರದಿಗಳನ್ನು ಕಳುಹಿಸಲು ನಿಮ್ಮ ChromeOS ಸಾಧನಗಳಿಗೆ ಅನುಮತಿಸುವುದರಿಂದ, ChromeOS ನಲ್ಲಿ ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಮತ್ತು ಸುಧಾರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆದ್ಯತೆಯ ಪ್ರಕಾರ ನಿರ್ವಹಿಸಲು ನಮಗೆ ಸಹಾಯವಾಗುತ್ತದೆ. ಈ ವರದಿಗಳು ChromeOS ಯಾವಾಗ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತದೆ, ನೀವು ಯಾವ ಫೀಚರ್‌ಗಳನ್ನು ಬಳಸುತ್ತೀರಿ, ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಮೆಮೊರಿಯನ್ನು ಬಳಸುತ್ತೀರಿ ಮತ್ತು Android ಆ್ಯಪ್ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾದಂತಹ ವಿಷಯಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ಕೆಲವು ಅಗ್ರಿಗೇಟ್ ಡೇಟಾಗಳು, Google ಆ್ಯಪ್‌ಗಳಿಗೆ ಮತ್ತು Android ಡೆವಲಪರ್‌ಗಳಂತಹ ಪಾಲುದಾರರಿಗೂ ಸಹಾಯ ಮಾಡುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮ ChromeOS ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ, ನೀವು ಈ ವರದಿಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಾರಂಭಿಸಬಹುದು ಅಥವಾ ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಡೊಮೇನ್ ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />ನಿಮ್ಮ Google ಖಾತೆಗಾಗಿ ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಆನ್ ಮಾಡಿದ್ದರೆ, ನಿಮ್ಮ Android ಡೇಟಾವನ್ನು ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್‌ ಮಾಡಿಕೊಳ್ಳಬಹುದು. account.google.com ನಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ನೀವು ನೋಡಬಹುದು, ಅಳಿಸಬಹುದು ಮತ್ತು ನಿಮ್ಮ ಖಾತೆಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH3" /></translation>
<translation id="4385905942116811558">ಬ್ಲೂಟೂತ್ ಮತ್ತು USB ಸಾಧನಗಳನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ</translation>
<translation id="4403266582403435904">ಯಾವಾಗ ಬೇಕಾದರೂ ಡೇಟಾವನ್ನು ಸುಲಭವಾಗಿ ಮರುಸ್ಥಾಪಿಸಿ ಅಥವಾ ಸಾಧನಗಳನ್ನು ಬದಲಿಸಿ. ಬ್ಯಾಕಪ್‌ಗಳನ್ನು Google ಗೆ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಮಗುವಿನ Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಳಸಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="4410545552906060960">ನಿಮ್ಮ ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್‌ ಮಾಡಲು ಪಾಸ್‌ವರ್ಡ್‌ ಬದಲಾಗಿ ಸಂಖ್ಯೆಯನ್ನು (ಪಿನ್‌) ಬಳಸಿ. ನಿಮ್ಮ ಪಿನ್‌ ಅನ್ನು ನಂತರ ಹೊಂದಿಸಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ.</translation>
<translation id="4415213869328311284">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಬಳಸಲು ಸಿದ್ಧರಾಗಿದ್ದೀರಿ.</translation>
<translation id="443031431654216610">ಸಂಖ್ಯಾತ್ಮಕ ಅಂಕಿಗಳನ್ನು ಮಾತ್ರ ಬಳಸಿ</translation>
<translation id="4448560527907365660">ಸೇವ್ ಮಾಡಿ ಹಾಗೂ ಇನ್ನಷ್ಟು ನೋಡಿ</translation>
<translation id="4449948729197510913">ನಿಮ್ಮ ಬಳಕೆದಾರರ ಹೆಸರು, ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಎಂಟರ್‌ಪ್ರೈಸ್ ಖಾತೆಗೆ ಸೇರಿರುತ್ತದೆ. ಖಾತೆಯಲ್ಲಿ ಸಾಧನಗಳನ್ನು ನೋಂದಾಯಿಸಲು, ಮೊದಲಿಗೆ ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ಡೊಮೇನ್ ಮಾಲೀಕತ್ವವನ್ನು ದೃಢೀಕರಿಸಿ. ದೃಢೀಕರಿಸುವುದಕ್ಕಾಗಿ, ನಿಮಗೆ ಖಾತೆಯಲ್ಲಿ ನಿರ್ವಾಹಕರ ಸವಲತ್ತುಗಳ ಅಗತ್ಯವಿರುತ್ತದೆ.</translation>
<translation id="4450974146388585462">ಪತ್ತೆಹಚ್ಚುವಿಕೆ</translation>
<translation id="445099924538929605">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೆಚ್ಚು ಸುರಕ್ಷಿತವಾಗಿ ಸಂಗ್ರಹಿಸಬಲ್ಲ ಸಕ್ರಿಯ TPM ಅನ್ನು <ph name="DEVICE_OS" /> ಪತ್ತೆಹಚ್ಚಿದೆ.</translation>
<translation id="4472298120638043495">ನಿಮ್ಮ ಆದ್ಯತೆಯ Google ಖಾತೆಯ ಭಾಷೆಯನ್ನು ನೀವು ಬಳಸಬಹುದು (<ph name="NEW_LOCALE_FROM_GAIA" />)</translation>
<translation id="4472575034687746823">ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4487489714832036847">ಸಾಂಪ್ರದಾಯಿಕ ಸಾಫ್ಟ್‌ವೇರ್ ಬದಲಾಗಿ Chromebook ಗಳು ಆ್ಯಪ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಉತ್ಪಾದಕತೆ, ಮನರಂಜನೆ ಮತ್ತು ಇನ್ನಷ್ಟವುಗಳಿಗಾಗಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಪಡೆದುಕೊಳ್ಳಿ.</translation>
<translation id="450867954911715010">ಪ್ರವೇಶದ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="4519605771716872386">ಫೈಲ್ ಸಿಂಕ್ ಆನ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="4523780892555982827"><ph name="BEGIN_PARAGRAPH1" />ಈ ಕೆಳಗಿನ ಟ್ರಬಲ್‌ಶೂಟಿಂಗ್ ಹಂತಗಳನ್ನು ಪ್ರಯತ್ನಿಸಿ:
        <ph name="BEGIN_LIST" />
        <ph name="LIST_ITEM" />ನಿಮ್ಮ ಸಾಧನ HDD, SSD, ಅಥವಾ eMMC ಯಂತಹ ಕಾರ್ಯನಿರ್ವಹಿಸುವ ಆಂತರಿಕ ಸಂಗ್ರಹಣೆ ಹೊಂದಿರುವುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ
    <ph name="LIST_ITEM" />ನಿಮ್ಮ ಆಂತರಿಕ ಸಂಗ್ರಹಣೆ ಸಾಧನದಲ್ಲಿ 16GB ಗಿಂತ ಹೆಚ್ಚಿನ ಸ್ಥಳಾವಕಾಶವಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ
    <ph name="LIST_ITEM" />ಭೌತಿಕವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವ ಅವಕಾಶವಿದ್ದರೆ, ಆಂತರಿಕ ಸಂಗ್ರಹಣೆಯ ಕನೆಕ್ಷನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ
    <ph name="LIST_ITEM" />ನೀವು ಪ್ರಮಾಣೀಕೃತ ಮಾಡಲ್ ಅನ್ನು ಬಳಸುತ್ತಿದ್ದೀರಿ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಟಿಪ್ಪಣಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ
    <ph name="END_LIST" />
    <ph name="END_PARAGRAPH1" />
    <ph name="BEGIN_PARAGRAPH2" />ಹೆಚ್ಚಿನ ಸಹಾಯಕ್ಕಾಗಿ, ಇಲ್ಲಿಗೆ ಭೇಟಿ ನೀಡಿ: g.co/flex/InstallErrors.<ph name="END_PARAGRAPH2" /></translation>
<translation id="4531924570968473143">ಈ <ph name="DEVICE_TYPE" /> ಗೆ ನೀವು ಯಾರನ್ನು ಸೇರಿಸಲು ಬಯಸುತ್ತೀರಿ?</translation>
<translation id="4566170377336116390">ನೀವು ನೋಂದಣಿಯ ನಂತರ ಬದಲಿಸಲು ಬಯಸಿದರೆ, ನಿಮ್ಮ ಸಾಧನವನ್ನು ನೀವು ಫ್ಯಾಕ್ಟರಿ ರೀಸೆಟ್ (ಪವರ್‌ವಾಷ್) ಮಾಡಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="4567512141633030272">ಸೈನ್ ಇನ್ ಆಯ್ಕೆ ತಪ್ಪಾಗಿದೆಯೇ?</translation>
<translation id="4567533462991917415">ಸೆಟಪ್‌ನ ನಂತರ ನೀವು ಯಾವಾಗಲೂ ಹೆಚ್ಚಿನ ಜನರನ್ನು ಸೇರಿಸಬಹುದು. ಪ್ರತಿಯೊಬ್ಬ ವ್ಯಕ್ತಿಯು ತಮ್ಮ ಖಾತೆಯನ್ನು ವೈಯಕ್ತೀಕರಿಸಬಹುದು ಮತ್ತು ಡೇಟಾವನ್ನು ಖಾಸಗಿಯಾಗಿರಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="4568213207643490790">ಕ್ಷಮಿಸಿ, ಈ ಸಾಧನದಲ್ಲಿ Google ಖಾತೆಗಳಿಗೆ ಅನುಮತಿ ಇಲ್ಲ.</translation>
<translation id="4611759022973144129">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನೀವು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="4634575639321169635">ಕೆಲಸ ಅಥವಾ ವೈಯಕ್ತಿಕ ಬಳಕೆಗಾಗಿ ಈ ಸಾಧನವನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="4689235506267737042">ನಿಮ್ಮ ಡೆಮೋ ಆದ್ಯತೆಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="4727847987444062305">ನಿರ್ವಹಿಸಲಾದ ಅತಿಥಿ ಸೆಶನ್</translation>
<translation id="473775607612524610">ಅಪ್‌ಡೇಟ್‌‌</translation>
<translation id="473936925429402449"><ph name="TOTAL_ELEMENTS" /> ರಲ್ಲಿ <ph name="CURRENT_ELEMENT" /> ಹೆಚ್ಚುವರಿ ವಿಷಯವನ್ನು ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ</translation>
<translation id="4763757134413542119"><ph name="USER_EMAIL" /> ಮಾನ್ಯವಾದ Google for Education ಖಾತೆ ಅಲ್ಲ. ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ಇಲ್ಲಿಗೆ ಭೇಟಿ ನೀಡುವ ಮೂಲಕ ನಿಮ್ಮ ಸಂಸ್ಥೆಯನ್ನು ನೀವು ಸೆಟಪ್ ಮಾಡಬಹುದು: g.co/workspace/edusignup</translation>
<translation id="4780558987886269159">ಉದ್ಯೋಗಕ್ಕಾಗಿ</translation>
<translation id="4806457879608775995">ಈ ನಿಯಮಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="4809927044794281115">ಲೈಟ್ ಥೀಮ್‌</translation>
<translation id="4814327014588285482">ಸ್ಕಿಪ್ ಮಾಡಿ ಮತ್ತು ನಂತರ ನನಗೆ ರಿಮೈಂಡ್ ಮಾಡಿ</translation>
<translation id="4830502475412647084">OS ಅಪ್‌ಡೇಟ್‌ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="4837926214103741331">ನೀವು ಈ ಸಾಧನವನ್ನು ಬಳಸಲು ಪ್ರಮಾಣಿತರಾಗಿಲ್ಲ. ಸೈನ್-ಇನ್ ಅನುಮತಿಗಾಗಿ ಸಾಧನ ಮಾಲೀಕನನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="4844333629810439236">ಇತರ ಕೀಬೋರ್ಡ್‌ಗಳು</translation>
<translation id="484462545196658690">ಆಟೋ</translation>
<translation id="4864369630010738180">ಸೈನ್ ಇನ್ ಮಾಡಲಾಗುತ್ತಿದೆ...</translation>
<translation id="4867272607148176509">ಪೋಷಕರು ಆ್ಯಪ್‌ಗಳನ್ನು ಅನುಮೋದಿಸಬಹುದು ಅಥವಾ ನಿರ್ಬಂಧಿಸಬಹುದು, ಸಮಯದ ಮಿತಿಗಳನ್ನು ಸೆಟ್ ಮಾಡಬಹುದು ಮತ್ತು ವೆಬ್ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ನಿಯಂತ್ರಿಸಬಹುದು. ಬಹುತೇಕ ಶಾಲೆಯ ಮಾಹಿತಿ ಮೂಲಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಶಾಲೆಯ ಖಾತೆಯನ್ನು ನಂತರ ಸೇರಿಸಬಹುದು.</translation>
<translation id="4877652723592270843">ನೀವು ChromeOS Flex ನ ಬಿಲ್ಟ್-ಇನ್ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಆದ, ChromeVox ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಯಸುತ್ತೀರಾ? ಹಾಗಿದ್ದರೆ, ಐದು ಸೆಕೆಂಡ್‌ಗಳ ಕಾಲ ಎರಡೂ ವಾಲ್ಯೂಮ್ ಕೀಗಳನ್ನು ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ.</translation>
<translation id="4899696330053002588">ಜಾಹೀರಾತುಗಳಿವೆ</translation>
<translation id="49027928311173603">ಸರ್ವರ್‌ನಿಂದ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾದ ನೀತಿಯು ಅಮಾನ್ಯವಾಗಿದೆ: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4941246025622441835">ಎಂಟರ್‌ಪ್ರೈಸ್ ನಿರ್ವಹಣೆಗಾಗಿ ಸಾಧನವನ್ನು ದಾಖಲಿಸುತ್ತಿರುವಾಗ ಈ ಸಾಧನದ ನಿಯೋಜನೆಯನ್ನು ಬಳಸಿ:</translation>
<translation id="4944310289250773232">ಈ ದೃಢೀಕರಣ ಸೇವೆಯನ್ನು <ph name="SAML_DOMAIN" /> ಮೂಲಕ ಹೋಸ್ಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="4955710816792587366">ನಿಮ್ಮ ಪಿನ್‌ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="4965808351167763748">Hangouts ಸಭೆಯನ್ನು ಚಾಲನೆ ಮಾಡಲು ಈ ಸಾಧನವನ್ನು ಸೆಟಪ್‌ ಮಾಡಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?</translation>
<translation id="4987944280765486504">ಡೌನ್‌ಲೋಡ್ ಪೂರ್ಣಗೊಂಡ ನಂತರ ನಿಮ್ಮ Chromebook ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ ಮತ್ತು ನೀವು ಸೆಟಪ್ ಅನ್ನು ಮುಂದುವರಿಸಬಹುದು.</translation>
<translation id="5029287942302939687">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸೆಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="503155457707535043">ಆ್ಯಪ್‌ಗಳು ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿವೆ</translation>
<translation id="5045550434625856497">ತಪ್ಪು ಪಾಸ್‌ವರ್ಡ್</translation>
<translation id="5062930723426326933">ಸೈನ್‌-ಇನ್‌ ವಿಫಲವಾಗಿದೆ, ದಯವಿಟ್ಟು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5085162214018721575">ನವೀಕರಣಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="5097306410549350357">ಸ್ಥಳವನ್ನು ಬಳಸುವ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="5107486920067578245"><ph name="BEGIN_PARAGRAPH1" />Google AI ಮೂಲಕ ಬರವಣಿಗೆ, ಪ್ಲಾನಿಂಗ್, ಕಲಿಕೆ ಮತ್ತು ಇನ್ನಷ್ಟು ಚಟುವಟಿಕೆಗಳನ್ನು ಪ್ರಾರಂಭಿಸಲು Gemini ಜೊತೆ ಚಾಟ್ ಮಾಡಿ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ, ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ನ ಕೆಳಭಾಗದಲ್ಲಿರುವ ನಿಮ್ಮ ಶೆಲ್ಫ್‌ನಲ್ಲಿರುವ Gemini ಆ್ಯಪ್ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡುವ ಮೂಲಕ Gemini ಬಳಸಲು ಪ್ರಾರಂಭಿಸಿ.<ph name="END_PARAGRAPH2" /></translation>
<translation id="5115309401544567011">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ವಿದ್ಯುತ್ ಸಂಪರ್ಕಕ್ಕೆ ಪ್ಲಗ್ ಮಾಡಿ.</translation>
<translation id="5145876360421795017">ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಬೇಡಿ</translation>
<translation id="5147516217412920887">ಕೋಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ</translation>
<translation id="5160857336552977725">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಸಾಧನದಲ್ಲಿ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5171185788583376591"><ph name="BEGIN_H3" />ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳು<ph name="END_H3" />
      <ph name="BR" />
      ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಕಸ್ಟಮ್ ಕೋಡ್ ಅನ್ನು ಇನ್‍‍ಸ್ಟಾಲ್ ಮಾಡಲು ಮತ್ತು ಪರೀಕ್ಷಿಸಲು ನಿಮ್ಮ ChromeOS Flex ಸಾಧನದಲ್ಲಿ ನೀವು ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು. ಇದರಿಂದ ನಿಮಗೆ ಕೆಳಕಂಡ ಕ್ರಿಯೆಗಳನ್ನು ಮಾಡುವ ಅವಕಾಶ ದೊರೆಯುತ್ತದೆ:<ph name="BR" />
      <ph name="BEGIN_LIST" />
        <ph name="LIST_ITEM" />OS ಫೈಲ್‍ಗಳನ್ನು ಮಾರ್ಪಡಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು rootfs ಪರಿಶೀಲನೆಯನ್ನು ತೆಗೆದುಹಾಕುವುದು
        <ph name="LIST_ITEM" />ಸಾಧನವನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> ನಂತಹ ಟೂಲ್‌ಗಳನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಪರೀಕ್ಷಾ ಕೀಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸಾಧನಕ್ಕೆ SSH ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು
        <ph name="LIST_ITEM" />USB ಡ್ರೈವ್‍ನಿಂದ OS ಚಿತ್ರವನ್ನು ಇನ್‍‍ಸ್ಟಾಲ್ ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು USB ಡ್ರೈವ್‌ನಿಂದ ಬೂಟ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವುದು
        <ph name="LIST_ITEM" />ಸಾಧನಕ್ಕೆ ಮ್ಯಾನುಯಲ್ ಆಗಿ SSH ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗಲು dev ಮತ್ತು ಸಿಸ್ಟಮ್ ರೂಟ್ ಲಾಗಿನ್ ಪಾಸ್‍‍ವರ್ಡ್ ಎರಡನ್ನೂ ಸೆಟ್ ಮಾಡುವುದು
      <ph name="END_LIST" />
      <ph name="BR" />
      ಸಕ್ರಿಯಗೊಳಿಸಿದ ನಂತರ, ಪವರ್‌ವಾಷ್ ಮಾಡಿದ ನಂತರವೂ ಅಥವಾ ಎಂಟರ್‌ಪ್ರೈಸ್ ಒಂದರ ಮೂಲಕ ನಿರ್ವಹಿಸಲಾದ ಸಾಧನದಲ್ಲಿನ ಡೇಟಾವನ್ನು ಅಳಿಸಿಹಾಕಿದ ನಂತರವೂ ಬಹುತೇಕ ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳು ಸಕ್ರಿಯವಾಗಿಯೇ ಇರುತ್ತವೆ. ಎಲ್ಲಾ ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು, Chrome OS ರಿಕವರಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ (https://support.google.com/chromebook/answer/1080595).
      <ph name="BR" />
      <ph name="BR" />
      ಡೀಬಗ್ಗಿಂಗ್ ಫೀಚರ್‌ಗಳ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ಇದನ್ನು ನೋಡಿ:<ph name="BR" />
      https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
      <ph name="BR" />
      <ph name="BR" />
      <ph name="BEGIN_BOLD" />ಗಮನಿಸಿ:<ph name="END_BOLD" /> ಪ್ರಕ್ರಿಯೆಯ ವೇಳೆ ಸಿಸ್ಟಂ ರೀಬೂಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="5215502535566372932">ದೇಶವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5234523649284990414">ChromeOS ನಲ್ಲಿನ ಸ್ಕ್ರೀನ್ ರೀಡರ್, ChromeVox, ಮುಖ್ಯವಾಗಿ ಅಂಧತ್ವ ಅಥವಾ ಕಡಿಮೆ ದೃಷ್ಟಿ ಹೊಂದಿರುವ ಜನರು ಸ್ಪೀಚ್ ಸಿಂಥಸೈಜರ್ ಅಥವಾ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯಿರುವ ಸ್ಕ್ರೀನ್ ಮೇಲೆ ತೋರಿಸಲಾದ ಪಠ್ಯವನ್ನು ಓದಲು ಬಳಸುತ್ತಾರೆ. ChromeVox ಅನ್ನು ಆನ್ ಮಾಡಲು ಸ್ಪೇಸ್ ಬಾರ್ ಅನ್ನು ಒತ್ತಿರಿ. ChromeVox ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ನೀವು ಕ್ವಿಕ್ ಟೂರ್ ಮೂಲಕ ತಿಳಿದುಕೊಳ್ಳುತ್ತೀರಿ.</translation>
<translation id="523505283826916779">ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="5240931875940563122">Android ಫೋನ್‌ನಿಂದ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5255859108402770436">ಮತ್ತೊಮ್ಮೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="5260508466980570042">ಕ್ಷಮಿಸಿ, ನಿಮ್ಮ ಇಮೇಲ್ ಅಥವಾ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲಾಗಲಿಲ್ಲ.  ದಯವಿಟ್ಟು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5264252276333215551">ನಿಮ್ಮ ಆ್ಯಪ್‌ ಅನ್ನು ಕಿಯೋಸ್ಕ್ ಮೋಡ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸಲು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="528208740344463258">Android ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು, ಮೊದಲು ನೀವು ಅಗತ್ಯವಿರುವ ಈ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡಬೇಕು. ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತಿರುವಾಗ, ಅದನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡುವಿಕೆ ಪೂರ್ಣಗೊಂಡ ನಂತರ, ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ.</translation>
<translation id="5283677936944177147">ಓಹ್‌‌! ಸಿಸ್ಟಂ ಸಾಧನದ ಮಾದರಿ ಅಥವಾ ಕ್ರಮಸಂಖ್ಯೆಯನ್ನು ನಿರ್ಧರಿಸಲು ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="5333896723098573627">ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಆ್ಯಪ್‌ಗಳು &gt; Google Play Store &gt; Android ಆದ್ಯತೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ &gt; ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ಅಪ್ಲಿಕೇಶನ್ ನಿರ್ವಾಹಕಕ್ಕೆ ಹೋಗಿ. ನಂತರ ನೀವು ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಬಯಸುವ ಆ್ಯಪ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ (ಆ್ಯಪ್ ಹುಡುಕಲು ಎಡಕ್ಕೆ ಅಥವಾ ಬಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡುವ ಅಗತ್ಯವಿರಬಹುದು). ನಂತರ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಅಥವಾ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ ಎಂಬುದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ.</translation>
<translation id="5355501370336370394">ಎಂಟರ್‌ಪ್ರೈಸ್ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿ</translation>
<translation id="5372529912055771682">ಪೂರೈಸಿದ ದಾಖಲಾತಿ ಮೋಡ್ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂನ ಈ ಆವೃತ್ತಿಯ ಮೂಲಕ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ. ನೀವು ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಚಾಲನೆಗೊಳಿಸುತ್ತಿರುವಿರಿ ಎಂಬುದನ್ನು ದಯವಿಟ್ಟು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5397378439569041789">ಕಿಯೋಸ್ಕ್ ಅಥವಾ ಸಂಕೇತ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿ</translation>
<translation id="5397794290049113714">ನೀವು</translation>
<translation id="5411022484772257615">ಶಾಲಾ ದಾಖಲಾತಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="5413640305322530561">ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾದ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="542750953150239272">ಮುಂದುವರೆಯುವ ಮೂಲಕ, ಈ ಸಾಧನವು ಸಂಭಾವ್ಯವಾಗಿ ಸೆಲ್ಯುಲರ್ ಡೇಟಾವನ್ನು ಬಳಸಿಕೊಂಡು Google, ನಿಮ್ಮ ವಾಹಕ ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದ ತಯಾರಕರ ಅಪ್‌ಡೇಟ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ಸಹ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬಹುದು ಮತ್ತು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದು ಎಂಬುದನ್ನು ನೀವು ಒಪ್ಪಿಕೊಳ್ಳುವಿರಿ. ಇವುಗಳಲ್ಲಿ ಕೆಲವೊಂದು ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ಖರೀದಿಸುವ ಅವಕಾಶ ಒದಗಿಸಬಹುದು.</translation>
<translation id="542948651837270806">ವಿಶ್ವಾಸಾರ್ಹ ಪ್ಲ್ಯಾಟ್‌ಫಾರ್ಮ್ ಮಾಡ್ಯೂಲ್ ಫರ್ಮ್‌ವೇರ್‌ಗಾಗಿ ಅಪ್‌ಡೇಟ್‌ ಒಂದನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವ ಅಗತ್ಯವಿದೆ. <ph name="TPM_FIRMWARE_UPDATE_LINK" /> ಅನ್ನು ನೋಡಿ</translation>
<translation id="5448293924669608770">ಓಹ್, ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ಏನೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="5453829744223920473">ನಿಮ್ಮ ಮಗು ತರಗತಿಯಲ್ಲಿ ಮಾಡುವಂತೆಯೇ ಅವರ ಶಾಲೆಯ ಎಲ್ಲಾ ಆ್ಯಪ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸಬಹುದು. ಶಾಲೆಯು ಮೂಲ ನಿಯಮಗಳನ್ನು ಸೆಟ್ ಮಾಡುತ್ತದೆ.</translation>
<translation id="5463450804024056231"><ph name="DEVICE_TYPE" /> ಇಮೇಲ್‌ಗಳಿಗಾಗಿ ಸೈನ್ ಅಪ್ ಮಾಡಿ</translation>
<translation id="5473099001878321374">ಮುಂದುವರೆಯುವ ಮೂಲಕ, ಈ ಸಾಧನವು ಸಂಭಾವ್ಯವಾಗಿ ಸೆಲ್ಯುಲರ್ ಡೇಟಾ ಬಳಸಿಕೊಂಡು Google ನಿಂದ, ನಿಮ್ಮ ಮಗುವಿನ ವಾಹಕದಿಂದ ಮತ್ತು ಈ ಸಾಧನದ ತಯಾರಕರಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಪ್‌ಡೇಟ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ಸಹ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬಹುದು ಹಾಗೂ ಇನ್‍ಸ್ಟಾಲ್ ಮಾಡಬಹುದು ಎನ್ನುವುದಕ್ಕೆ ನೀವು ಸಮ್ಮತಿಸುತ್ತೀರಿ. ಈ ಆ್ಯಪ್‌ಗಳ ಪೈಕಿ ಕೆಲವು ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್‌ನಲ್ಲಿ ಖರೀದಿಸುವ ಸೌಲಭ್ಯ ಒದಗಿಸಬಹುದು.</translation>
<translation id="5502915260472117187">ಮಗು</translation>
<translation id="5511823366942919280">ಈ ಸಾಧನವನ್ನು ನೀವು "ಶಾರ್ಕ್‌" ನಂತೆ ಹೊಂದಿಸಲು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?</translation>
<translation id="5513807280330619196">ಕ್ಯಾಲ್ಕ್ಯುಲೇಟರ್</translation>
<translation id="5527474464531963247">ನೀವು ಇನ್ನೊಂದು ನೆಟ್‌‌ವರ್ಟ್ ಅನ್ನು ಸಹ ಆಯ್ಕೆಮಾಡಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="5539070192556911367">Google ತಲುಪಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="5549511085333906441">ನಿಮ್ಮ ಸೆಟಪ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5554403733534868102">ಇದರ ನಂತರ ಅಪ್‌ಡೇಟ್‌ಗಳಿಗಾಗಿ ಕಾಯಬೇಕಾಗಿಲ್ಲ</translation>
<translation id="557722062034137776">ನಿಮ್ಮ ಸಾಧನವನ್ನು ಮರುಹೊಂದಿಸುವುದರಿಂದ, ನಿಮ್ಮ Google ಖಾತೆಗಳು ಅಥವಾ ಈ ಖಾತೆಗಳಿಗೆ ಸಿಂಕ್ ಮಾಡಲಾಗಿರುವ ಯಾವುದೇ ಡೇಟಾದ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ. ಆದಾಗ್ಯೂ, ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸ್ಥಳೀಯವಾಗಿ ಉಳಿಸಲಾಗಿರುವ ಎಲ್ಲಾ ಫೈಲ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="5600348067066185292">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಕೆಲವು ಸರಳ ಹಂತಗಳ ಅಗತ್ಯವಿದೆ. ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಯಾವುದೇ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡುವ ಮೊದಲು, ಅದನ್ನು ದೃಢೀಕರಿಸಲು ನಿಮಗೆ ಇನ್ನೊಂದು ಅವಕಾಶವಿರುತ್ತದೆ.</translation>
<translation id="5626172233890210551">ಬದಲಿಗೆ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ</translation>
<translation id="5631304855083152608"><ph name="BEGIN_PARAGRAPH1" />ಅತ್ಯುತ್ತಮ ಅನುಭವವನ್ನು ಒದಗಿಸಲು, <ph name="DEVICE_OS" /> ಸಾಧನಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹಾರ್ಡ್‌ವೇರ್‌ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ ಮತ್ತು ಯಾವೆಲ್ಲ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಒದಗಿಸಬೇಕು ಎಂಬುದನ್ನು ನಿರ್ಧರಿಸಲು ಆ ಡೇಟಾವನ್ನು Google ಜೊತೆ ಹಂಚಿಕೊಳ್ಳುತ್ತದೆ. ಐಚ್ಛಿಕವಾಗಿ, <ph name="DEVICE_OS" /> ನ ಅನುಭವ ಮತ್ತು ಸೇವೆಯನ್ನು ಸುಧಾರಿಸುವ ಮತ್ತು ಬೆಂಬಲಿಸುವಂತಹ ಹೆಚ್ಚುವರಿ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಈ ಡೇಟಾವನ್ನು ಬಳಸಲು ನೀವು Google ಗೆ ಅನುಮತಿಸಬಹುದು.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಅಪ್‌ಡೇಟ್ ಫಿಲ್ಟರ್ ಮಾಡುವಿಕೆಗಾಗಿ Google ಗೆ ಕಳುಹಿಸಲಾಗಿರುವ ಡೇಟಾವನ್ನು ನೋಡಲು, ಅಷ್ಟೇ ಅಲ್ಲದೇ ನೀವು Google ಜೊತೆ ಡೇಟಾ ಹಂಚಿಕೊಳ್ಳುವ ಆಯ್ಕೆಯನ್ನು ಮಾಡಿದ ಯಾವುದೇ ಇತರ ನಿದರ್ಶನಗಳನ್ನು ನೋಡಲು ನೀವು ಈ ಸಾಧನದಲ್ಲಿ ಲಾಗ್‌ ಇನ್‌ ಮಾಡಿ, chrome://system ನಲ್ಲಿ chromeosflex_ ಎಂದು ಪಟ್ಟಿ ಮಾಡಲಾದ ಫೀಲ್ಡ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />Google ಜೊತೆಗೆ <ph name="DEVICE_OS" /> ಹಂಚಿಕೊಳ್ಳಬಹುದಾದ ಡೇಟಾದ ಕುರಿತು ಮತ್ತು ಅದರ ಬಳಕೆಯ ಬಗ್ಗೆ ಹೆಚ್ಚಿನ ವಿವರಗಳಿಗಾಗಿ g.co/flex/HWDataCollection ಗೆ ಭೇಟಿ ನೀಡಿ.<ph name="END_PARAGRAPH3" /></translation>
<translation id="5636996382092289526"><ph name="NETWORK_ID" /> ಅನ್ನು ಬಳಸಲು ನೀವು ಮೊದಲಿಗೆ ಕೆಲವು ಸೆಕೆಂಡುಗಳಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ತೆರೆಯುವಂತಹ, <ph name="LINK_START" />ನೆಟ್‌ವರ್ಕ್‌ನ ಸೈನ್-ಇನ್ ಪುಟವನ್ನು ಭೇಟಿ ಮಾಡಬೇಕಾಗಿದೆ<ph name="LINK_END" />. ಇದು ಸಂಭವಿಸದಿದ್ದರೆ, ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="5641608986289282154"><ph name="DEVICE_OS" /> ಬಳಸಲು ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5655296450510165335">ಸಾಧನದ ನೋಂದಣಿ</translation>
<translation id="565899488479822148">ಇತ್ತೀಚಿನ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="5659964844710667266">ಈ <ph name="DEVICE_TYPE" /> ಗೆ ಪಾ‌ಸ್‌ವರ್ಡ್ ರಚಿಸಿ</translation>
<translation id="5684661240348539843">ಅಸೆಟ್ ಗುರುತಿಸುವಿಕೆ</translation>
<translation id="5684950556880280580">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="5687326903064479980">ಸಮಯ ವಲಯ</translation>
<translation id="5687935527303996204">ನಿಮ್ಮ ಸಾಧನವನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಲಾಗಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಹಾಗೂ ಅದನ್ನು ಆಫ್ ಮಾಡಬೇಡಿ. ಇನ್‌ಸ್ಟಾಲ್ ಆಗಲು 20 ನಿಮಿಷಗಳವರೆಗೆ ತೆಗೆದುಕೊಳ್ಳಬಹುದು. ಇನ್‌ಸ್ಟಾಲ್ ಪ್ರಕ್ರಿಯೆ ಪೂರ್ಣಗೊಂಡ ನಂತರ, ನಿಮ್ಮ ಸಾಧನವು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಶಟ್ ಡೌನ್ ಆಗುತ್ತದೆ.</translation>
<translation id="5705882733397021510">ಹಿಂದೆ ಹೋಗಿ</translation>
<translation id="5711010025974903573">ಸೇವಾ ಲಾಗ್‌ಗಳು</translation>
<translation id="5762787084360227629">Google ಖಾತೆಯ ಮಾಹಿತಿಯನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="5764797882307050727">ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸ್ವಲ್ಪ ಸ್ಥಳಾವಕಾಶ ಮಾಡಿ.</translation>
<translation id="5765425701854290211">ಕ್ಷಮಿಸಿ, ಕೆಲವು ಫೈಲ್‌ಗಳು ಹಾನಿಗೊಳಗಾಗಿದ್ದವು ಮತ್ತು ಅಪ್‌ಡೇಟ್ ಪ್ರಕ್ರಿಯೆ ಯಶಸ್ವಿಯಾಗಿರಲಿಲ್ಲ. ಸಿಂಕ್ ಆಗಿರುವ ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಸುರಕ್ಷಿತವಾಗಿವೆ.</translation>
<translation id="5770125698810550803">ನ್ಯಾವಿಗೇಷನ್‌ ಬಟನ್‌ಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="5793339252089865437">ನೀವು ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ನು ನಿಮ್ಮ ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್‌ ಮೂಲಕ ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಿದರೆ, ಅದು ಮಿತಿಮೀರಿದ ಬಳಕೆಯ ಶುಲ್ಕದಲ್ಲಿ ಪರಿಣಮಿಸಬಹುದು.</translation>
<translation id="5799478978078236781"><ph name="DEVICE_TYPE" /> ಕುರಿತು ಸಲಹೆಗಳು, ಆಫರ್‌ಗಳು ಹಾಗೂ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳಿ.</translation>
<translation id="5800703268655655701">ಲೈಟ್ ಥೀಮ್‌ ಅಥವಾ ಡಾರ್ಕ್‌ ಥೀಮ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5804259315582798390">ಸ್ಥಳೀಯ ಡೇಟಾ ರಿಕವರಿಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ವಿಫಲವಾಗಿದೆ</translation>
<translation id="5810809306422959727">ಈ ಖಾತೆಯು ಪೋಷಕ ನಿಯಂತ್ರಣಗಳಿಗಾಗಿ ಅರ್ಹವಾಗಿಲ್ಲ</translation>
<translation id="5819206523222900309"><ph name="BEGIN_DESCRIPTION" />ನಿಮ್ಮ ಸಂಸ್ಥೆಯಲ್ಲಿ ನಿಮ್ಮ ಸಾಧನಗಳನ್ನು ನೋಂದಾಯಿಸುವುದರಿಂದ ಅದನ್ನು ಕೇಂದ್ರೀಕೃತ ಸಾಧನ ನಿರ್ವಹಣೆಗಾಗಿ ಸೆಟಪ್ ಮಾಡುತ್ತದೆ. ಹಲವಾರು ಕಾರಣಗಳಿಗಾಗಿ ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ನೋಂದಣಿಯ ಅಗತ್ಯವಿರಬಹುದು:<ph name="END_DESCRIPTION" />
        <ph name="BEGIN_SUBTITLE1" /><ph name="BEGIN_BOLD" />ಭದ್ರತೆಯನ್ನು ವರ್ಧಿಸಲು<ph name="END_BOLD" /><ph name="END_SUBTITLE1" />
        <ph name="BEGIN_DESCRIPTION1" />ಹೆಚ್ಚುವರಿ ಭದ್ರತೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡುವ ಮೂಲಕ, ಸಂಸ್ಥೆಯು ಬಳಕೆದಾರರ ಮತ್ತು ಸಾಧನದ ಡೇಟಾವನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಬಹುದು. ಇದು ರಿಮೋಟ್ ರೀಸೆಟ್ ಅಥವಾ ಕಳೆದುಹೋದ ಸಾಧನವನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುವಂತಹ ಕ್ರಿಯೆಗಳನ್ನು ಸಹ ಮಾಡಬಹುದು.<ph name="END_DESCRIPTION1" />
        <ph name="BEGIN_SUBTITLE2" /><ph name="BEGIN_BOLD" />ಅನುಭವವನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಲು<ph name="END_BOLD" /><ph name="END_SUBTITLE2" />
    <ph name="BEGIN_DESCRIPTION2" />ಬೂಟ್ಅಪ್‌ನಲ್ಲಿ, ಲಾಗಿನ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಮತ್ತು ಲಾಗಿನ್ ನಂತರದ ಸಾಧನದ ನಡವಳಿಕೆಯನ್ನು ಸಂಸ್ಥೆಯ ಅಗತ್ಯಗಳಿಗೆ ಕಸ್ಟಮೈಸ್ ಮಾಡಬಹುದು.<ph name="END_DESCRIPTION2" />
        <ph name="BEGIN_SUBTITLE3" /><ph name="BEGIN_BOLD" />ಬೆಂಬಲವನ್ನು ಒದಗಿಸಲು<ph name="END_BOLD" /><ph name="END_SUBTITLE3" />
        <ph name="BEGIN_DESCRIPTION3" />ಟ್ರಬಲ್‌ಶೂಟಿಂಗ್ ಅನ್ನು ಒದಗಿಸುವ ಸಲುವಾಗಿ ಸಂಸ್ಥೆಯು ಸಾಧನದ ಸೆಶನ್ ಅನ್ನು ದೂರದಿಂದಲೇ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು.<ph name="END_DESCRIPTION3" />
        <ph name="BEGIN_SUBTITLE4" /><ph name="BEGIN_BOLD" />ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು<ph name="END_BOLD" /><ph name="END_SUBTITLE4" />
    <ph name="BEGIN_DESCRIPTION4" />ಸಂಸ್ಥೆಯ ಆ್ಯಪ್‌ಗಳು, ಸೇವೆಗಳು ಮತ್ತು ನೆಟ್‌ವರ್ಕ್‌ಗಳು ನೋಂದಾಯಿಸಿದ ಸಾಧನಗಳಲ್ಲಿ ಮಾತ್ರ ಲಭ್ಯವಿರಬಹುದು.<ph name="END_DESCRIPTION4" /></translation>
<translation id="5834581999798853053">ಸುಮಾರು <ph name="TIME" /> ನಿಮಿಷಗಳು ಉಳಿದಿವೆ</translation>
<translation id="5852112051279473187">ಓಹ್! ಈ ಸಾಧನವನ್ನು ದಾಖಲಿಸುವಾಗ ನಿಜವಾಗಿಯೂ ಏನೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ನಿಮ್ಮ ಬೆಂಬಲಿತ ಪ್ರತಿನಿಧಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="5852137567692933493">ಮರುಪ್ರಾರಂಭಿಸು ಮತ್ತು ಪವರ್‌ವಾಶ್ ಮಾಡು</translation>
<translation id="5856721540245522153">ಡೀಬಗ್ ಮಾಡುವಿಕೆ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="5860033963881614850">ಆಫ್</translation>
<translation id="5860491529813859533">ಆನ್ ಮಾಡಿ</translation>
<translation id="5863445608433396414">ಡೀಬಗ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="5870086504539785141">ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಮೆನು ಮುಚ್ಚಿ</translation>
<translation id="5895138241574237353">ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5895335062901455404">ನಿಮ್ಮ Google ಖಾತೆಯ ಮೂಲಕ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, ನಿಮ್ಮ ಉಳಿಸಲಾದ ಆದ್ಯತೆಗಳು ಮತ್ತು ಚಟುವಟಿಕೆ ಯಾವುದೇ ChromeOS Flex ಸಾಧನದಲ್ಲಿ ಸಿದ್ಧವಾಗಿರುತ್ತವೆ. ಏನನ್ನು ಸಿಂಕ್ ಮಾಡಬೇಕು ಎಂಬುದನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆರಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="5916664084637901428">ಆನ್‌</translation>
<translation id="5919305207330938913">ಸಂಗ್ರಹಿಸಿದ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು Google ನ <ph name="BEGIN_LINK" />ಗೌಪ್ಯತೆ ನೀತಿಗೆ<ph name="END_LINK" /> ಅನುಗುಣವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ.</translation>
<translation id="5932441198730183141">ಈ Google Meet ಹಾರ್ಡ್‌ವೇರ್ ಸಾಧನವನ್ನು ನೋಂದಣಿ ಮಾಡಲು ನಿಮಗೆ ಸಾಕಷ್ಟು ಲಭ್ಯವಿರುವ ಪರವಾನಗಿಗಳಿಲ್ಲ. ಹೆಚ್ಚಿನದನ್ನು ಖರೀದಿಸಲು ಮಾರಾಟವನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ಈ ಸಂದೇಶವನ್ನು ತಪ್ಪಾಗಿ ನೋಡುತ್ತಿರುವಿರಿ ಎಂದು ಭಾವಿಸುವುದಾದರೆ, ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="5933376509899483611">ಸಮಯ ವಲಯ</translation>
<translation id="5939518447894949180">ಮರುಹೊಂದಿಸು</translation>
<translation id="5948536763493709626">ಕೀಬೋರ್ಡ್ ಅಥವಾ ಮೌಸ್ ಅನ್ನು ಕನೆಕ್ಟ್ ಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಟಚ್‌ಸ್ಕ್ರೀನ್ ಬಳಸಿ ಸೆಟಪ್ ಮುಂದುವರಿಸಿ. ನೀವು ಬ್ಲೂಟೂತ್ ಸಾಧನಗಳನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, ನಿಮ್ಮ ಸಾಧನಗಳು ಜೋಡಿಸಲು ಸಿದ್ಧವಾಗಿವೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="5959471481388474538">ನೆಟ್‌ವರ್ಕ್ ಲಭ್ಯವಿಲ್ಲ</translation>
<translation id="6016178549409952427"><ph name="TOTAL_ELEMENTS" /> ರಲ್ಲಿ <ph name="CURRENT_ELEMENT" /> ಹೆಚ್ಚುವರಿ ವಿಷಯಕ್ಕೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ</translation>
<translation id="6016972670657536680">ಭಾಷೆ ಮತ್ತು ಕೀಬೋರ್ಡ್ ಬಟನ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಪ್ರಸ್ತುತ ಆಯ್ಕೆಮಾಡಿದ ಭಾಷೆ <ph name="LANGUAGE" /> ಇದಾಗಿದೆ.</translation>
<translation id="6040143037577758943">ಮುಚ್ಚಿರಿ</translation>
<translation id="6042193169866365541">ನಿಮ್ಮ Google ಖಾತೆಯು Gmail, YouTube, Chrome ಮತ್ತು ಇತರ Google ಉತ್ಪನ್ನಗಳಿಗಾಗಿ ನೀವು ಬಳಸುವ ಅದೇ ಖಾತೆಯಾಗಿದೆ.
        ನಿಮ್ಮ ಎಲ್ಲಾ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಬಳಸಿ. ನೀವು ಖಾತೆಯನ್ನು ಹೊಂದಿಲ್ಲದಿದ್ದರೆ, ಮುಂದಿನ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ನೀವು ಒಂದನ್ನು ರಚಿಸಬಹುದು.</translation>
<translation id="6051354611314852653">ಓಹ್! ಈ ಸಾಧನಕ್ಕಾಗಿ API ಪ್ರವೇಶವನ್ನು ದೃಢೀಕರಿಸುವಾಗ ಸಿಸ್ಟಂ ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="6055544610007596637">Google Play Store ನಿಂದ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗಾಗಿ ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="6069464830445383022">ನಿಮ್ಮ Google ಖಾತೆಯು ನಿಮ್ಮ Chromebook ಸೈನ್ ಇನ್ ಆಗಿದೆ</translation>
<translation id="6071181508177083058">ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಖಚಿತಪಡಿಸು</translation>
<translation id="6075731018162044558">ಓಹ್! ಈ ಸಾಧನಕ್ಕಾಗಿ ಒಂದು ಸುದೀರ್ಘ API ಆ್ಯಕ್ಸೆಸ್ ಟೋಕನ್ ಪಡೆದುಕೊಳ್ಳಲು ಸಿಸ್ಟಂ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="6093888419484831006">ಅಪ್‌ಡೇಟ್‌ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="6125479973208104919">ದುರದೃಷ್ಟವಶಾತ್, ನಿಮ್ಮ ಖಾತೆಯನ್ನು ನೀವು ಮತ್ತೆ ಈ <ph name="DEVICE_TYPE" /> ಗೆ ಸೇರಿಸುವ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="6165508094623778733">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="6170498031581934115">ADB ಡೀಬಗ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ, ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6172020488605056255">'ಓದಲು ಸಹಾಯ ಮಾಡಿ' ಅನ್ನು ಬಳಸಲು ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6173623053897475761">ನಿಮ್ಮ ಪಿನ್‌ ಅನ್ನು ಪುನಃ ಟೈಪ್‌ ಮಾಡಿ</translation>
<translation id="6185132558746749656">ಸಾಧನದ ಸ್ಥಳ</translation>
<translation id="6202304368170870640">ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದಕ್ಕೆ ಅಥವಾ ಅದನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡುವುದಕ್ಕೆ ನಿಮ್ಮ ಪಿನ್‌ ಅನ್ನು ನೀವು ಬಳಸಬಹುದು.</translation>
<translation id="6209908325007204267">ನಿಮ್ಮ ಸಾಧನವು Chrome ಎಂಟರ್‌ಪ್ರೈಸ್ ಅಪ್‌ಗ್ರೇಡ್ ಅನ್ನು ಒಳಗೊಂಡಿದೆ, ಆದರೆ ನಿಮ್ಮ ಬಳಕೆದಾರರ ಹೆಸರು ಯಾವುದೇ ಎಂಟರ್‌ಪ್ರೈಸ್ ಖಾತೆಯ ಜೊತೆಗೆ ಸಂಯೋಜಿತವಾಗಿಲ್ಲ. ಸೆಕೆಂಡರಿ ಸಾಧನದಲ್ಲಿ g.co/ChromeEnterpriseAccount ಗೆ ಭೇಟಿ ನೀಡುವ ಮೂಲಕ ಎಂಟರ್‌ಪ್ರೈಸ್ ಖಾತೆಯನ್ನು ರಚಿಸಿ.</translation>
<translation id="623261264391834964">'ನನಗೆ ಬರೆಯಲು ಸಹಾಯ ಮಾಡಿ' ಬಳಸಲು ಟೆಕ್ಸ್ಟ್ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6264520534872750757">ಈ ಸಾಧನವನ್ನು ಬಳಸಲು ಮುಂದುವರಿಯಿರಿ</translation>
<translation id="6280215091796946657">ಬೇರೆ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="6283823201263716145">ಫೀಚರ್‌ಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಲು, ಡೆಮೋ ಮೋಡ್‌ನಲ್ಲಿರುವ ಸಾಧನಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕ್ರ್ಯಾಶ್ ವರದಿಗಳು ಹಾಗೂ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ಸ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು Google ಗೆ ಕಳುಹಿಸುತ್ತವೆ.</translation>
<translation id="6287713404380454515">ಭದ್ರತಾ ಕಾರಣಗಳಿಗಾಗಿ, ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ನಿಮ್ಮ ಸಾಧನದ ಪಿನ್ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದಾರೆ. ಇಂದಿನಿಂದ, ನಿಮ್ಮ <ph name="MANAGER" /> ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="6301300352769835063"><ph name="DEVICE_OS" /> ಅನ್ನು ಸುಧಾರಿಸಲು ನೆರವಾಗಲು Google ಗೆ ನಿಮ್ಮ ಹಾರ್ಡ್‌ವೇರ್ ಡೇಟಾ ಬಳಸಲು ಅನುಮತಿಸಿ. ನೀವು ನಿರಾಕರಿಸಿದರೆ, ಸೂಕ್ತವಾದ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ನಿರ್ಧರಿಸಲು ಈ ಡೇಟಾವನ್ನು ಈಗಲೂ Google ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ ಆದರೆ ಅದನ್ನು ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಬಳಸಲಾಗುವುದಿಲ್ಲ. g.co/flex/HWDataCollection ನಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="6308493641021088955"><ph name="EXTENSION_NAME" />, ಸೈನ್ ಇನ್ ಅನ್ನು ಒದಗಿಸಿದೆ</translation>
<translation id="6314819609899340042">ಈ <ph name="IDS_SHORT_PRODUCT_NAME" /> ಸಾಧನದಲ್ಲಿ ನೀವು ದೋಷ ನಿವಾರಣಾ ವೈಶಿಷ್ಟ್ಯತೆಗಳನ್ನು ಯಶಸ್ವಿಯಾಗಿ ಸಕ್ರಿಯಗೊಳಿಸಿದ್ದೀರಿ.</translation>
<translation id="6343262564968371601">Google, ಫೈಲ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಹುಡುಕುವ ಮೂಲಕ ನೀವು ಹುಡುಕುತ್ತಿರುವುದನ್ನು ಕಂಡುಕೊಳ್ಳಿ</translation>
<translation id="635609604405270300">ಸಾಧನವು ಆನ್ ಆಗಿರಲಿ</translation>
<translation id="6363786367719063276">ಲಾಗ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ</translation>
<translation id="6367097275976877956">ChromeVox, ChromeOS ಗಾಗಿ ಅಂತರ್ನಿರ್ಮಿತ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನೀವು ಬಯಸುವಿರಾ? ಹಾಗಿದ್ದರೆ, ಸ್ಪೇಸ್ ಬಾರ್ ಅನ್ನು ಒತ್ತಿ.</translation>
<translation id="636850387210749493">ಎಂಟರ್‌ಪ್ರೈಸ್ ದಾಖಲಾತಿ</translation>
<translation id="6380143666419481200">ಸಮ್ಮತಿಸಿ ಮತ್ತು ಮುಂದುವರಿಯಿರಿ</translation>
<translation id="640457954117263537">ChromeOS ಮತ್ತು Android ಆ್ಯಪ್‌ಗಳು ಹಾಗೂ ಸೇವೆಗಳಿಗಾಗಿ ಸ್ಥಳವನ್ನು ಬಳಸಿ.</translation>
<translation id="6418311015934520372"><ph name="BEGIN_PARAGRAPH1" />ಸ್ವಯಂಚಾಲಿತ ವರದಿಗಳನ್ನು ಕಳುಹಿಸಲು ನಿಮ್ಮ ChromeOS ಸಾಧನಗಳಿಗೆ ಅನುಮತಿಸುವುದರಿಂದ, ChromeOS ನಲ್ಲಿ ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಮತ್ತು ಸುಧಾರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆದ್ಯತೆಯ ಪ್ರಕಾರ ನಿರ್ವಹಿಸಲು ನಮಗೆ ಸಹಾಯವಾಗುತ್ತದೆ. ಈ ವರದಿಗಳಲ್ಲಿ ChromeOS ಯಾವಾಗ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತದೆ, ನೀವು ಯಾವ ಫೀಚರ್‌ಗಳನ್ನು ಬಳಸುತ್ತೀರಿ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಮೆಮೊರಿಯನ್ನು ಬಳಸುತ್ತೀರಿ ಎನ್ನುವಂತಹ ಮಾಹಿತಿಗಳು ಇರಲಿವೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮ Chrome ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ, ನೀವು ಈ ವರದಿಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಾರಂಭಿಸಬಹುದು ಅಥವಾ ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಡೊಮೇನ್ ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6418511932144861495">ಮಹತ್ವದ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="6452251728599530347"><ph name="PERCENT" /> ಪೂರ್ಣವಾಗಿದೆ</translation>
<translation id="6478849105642611893">ಕ್ವಿಕ್ ಇನ್‌ಸರ್ಟ್ ಕೀ ಟ್ಯಾಬ್ ಕೀಯ ಕೆಳಗೆ ಇದೆ</translation>
<translation id="6480327114083866287"><ph name="MANAGER" /> ಮೂಲಕ ನಿರ್ವಹಿಸಲಾಗಿದೆ</translation>
<translation id="6488384360522318064">ಭಾಷೆ ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="6495266441917713704">ವೈ-ಫೈ ಅನ್ನು ವರ್ಗಾಯಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="6515620015470298987">ಸಾಧನದ ಕಾನ್ಫಿಗರೇಶನ್‌ ಪರಿಶೀಲನೆಯ ಸಮಸ್ಯೆಯಿಂದಾಗಿ ಸೈನ್-ಇನ್ ವಿಫಲವಾಗಿದೆ. ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಪವರ್‌ವಾಷ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6519689855001245063">ಅರ್ಹತೆಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="6532527800157340614">ನಿಮ್ಮ ಆ್ಯಕ್ಸೆಸ್ ಟೋಕನ್ ಅನ್ನು ಹಿಂಪಡೆಯಲು ಸಾಧ್ಯವಾಗದ ಕಾರಣ ಸೈನ್-ಇನ್ ವಿಫಲವಾಗಿದೆ. ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಹಾಗೂ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="653920215766444089">ಸೂಚಕ ಸಾಧನವನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ</translation>
<translation id="65513682072153627">ನಿಮ್ಮ ನಿರ್ವಾಹಕರ ಮೂಲಕ ಸೆಟ್ಟಿಂಗ್ ಅಥವಾ ಫೀಚರ್ ಅನ್ನು ನಿರ್ವಹಿಲ್ಪಡುತ್ತಿರುವಾಗ, ನೀವು ಈ 'ನಿರ್ವಹಿಸಲ್ಪಟ್ಟ' ಐಕಾನ್ ಅನ್ನು ನೋಡುತ್ತೀರಿ.</translation>
<translation id="6561726789132298588">ನಮೂದಿಸಿ</translation>
<translation id="6607890859198268021">ಈ <ph name="USER_EMAIL" /> ಅನ್ನು ಈಗಾಗಲೇ <ph name="DOMAIN" /> ಇಂದ ನಿರ್ವಹಿಸಲ್ಪಡುತ್ತಿದೆ. ಬೇರೊಂದು Google ಖಾತೆಯ ಮೂಲಕ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಬಳಸಲು, ಸೆಟಪ್‌ನ ನಂತರ ಸೈನ್ ಔಟ್ ಮಾಡಿ ಹಾಗೂ ಸೈನ್ ಇನ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ "ವ್ಯಕ್ತಿಯನ್ನು ಸೇರಿಸಿ" ಆಯ್ಕೆಮಾಡಿ.</translation>
<translation id="6642720633335369752">ಎಲ್ಲಾ ತೆರೆದ ಆ್ಯಪ್ ವಿಂಡೋಗಳನ್ನು ನೋಡಲು, ಕೆಳಗಿನಿಂದ ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ ಮತ್ತು ಹೋಲ್ಡ್‌‌ ಮಾಡಿ.</translation>
<translation id="6648911618876616409">ಮಹತ್ವದ ಅಪ್‌ಡೇಟ್ ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡಲು ಸಿದ್ಧವಾಗಿದೆ. ಪ್ರಾರಂಭಿಸಲು ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="6671497123040790595"><ph name="MANAGER" /> ಮೂಲಕ ನಿರ್ವಹಣೆಯನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="6675665718701918026">ಪಾಯಿಂಟಿಂಗ್ ಸಾಧನ ಸಂಪರ್ಕಿಸಲಾಗಿದೆ</translation>
<translation id="667752334740867460">ವೈ-ಫೈ ಮಾಹಿತಿಯನ್ನು ಸ್ವೀಕರಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="6680442031740878064">ಲಭ್ಯವಿದೆ: <ph name="AVAILABLE_SPACE" /></translation>
<translation id="6684827949542560880">ಇತ್ತೀಚಿನ ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="6722744767592605627">ನೀವು <ph name="EMAIL" /> ಅನ್ನು ರಿಕವರ್ ಮಾಡಬಹುದು, ಆದರೆ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6748980958975836188"><ph name="BEGIN_LINK1" />Google ಸೇವಾ ನಿಯಮಗಳು<ph name="END_LINK1" />, <ph name="BEGIN_LINK2" />Chrome ಮತ್ತು Chrome OS ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳನ್ನು<ph name="END_LINK2" /> ನಾನು ಓದಿದ್ದೇನೆ ಮತ್ತು ಒಪ್ಪುತ್ತೇನೆ.</translation>
<translation id="6749473226660745022">ಫೋಟೋಗಳು</translation>
<translation id="6754918760968695779">ಕ್ವಿಕ್ ಇನ್‌ಸರ್ಟ್</translation>
<translation id="6789834167207639931">ಮರುಪ್ರಾಪ್ತಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಮುಂದಿನ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ನಿಮ್ಮ Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಮತ್ತೊಮ್ಮೆ ನಮೂದಿಸಿ</translation>
<translation id="6797022073000660150"><ph name="BEGIN_PARAGRAPH1" />ಸ್ವಯಂಚಾಲಿತ ವರದಿಗಳನ್ನು ಕಳುಹಿಸಲು ChromeOS ಸಾಧನಗಳಿಗೆ ಅನುಮತಿಸುವುದರಿಂದ, ChromeOS ನಲ್ಲಿ ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಮತ್ತು ಸುಧಾರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆದ್ಯತೆಯ ಪ್ರಕಾರ ನಿರ್ವಹಿಸಲು ನಮಗೆ ಸಹಾಯವಾಗುತ್ತದೆ. ಈ ವರದಿಗಳು Chrome OS ಯಾವಾಗ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತದೆ, ಯಾವ ಫೀಚರ್‌ಗಳನ್ನು ಬಳಸಲಾಗಿದೆ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಮೆಮೊರಿಯನ್ನು ಬಳಸಲಾಗಿದೆ ಹಾಗೂ Android ಆ್ಯಪ್‌ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾದಂತಹ ವಿಷಯಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ಕೆಲವು ಅಗ್ರಿಗೇಟ್ ಡೇಟಾಗಳು, Google ಆ್ಯಪ್‌ಗಳಿಗೆ ಮತ್ತು Android ಡೆವಲಪರ್‌ಗಳಂತಹ ಪಾಲುದಾರರಿಗೂ ಸಹಾಯ ಮಾಡುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮ ಮಗುವಿನ ChromeOS ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ, ನೀವು ಈ ವರದಿಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಾರಂಭಿಸಬಹುದು ಅಥವಾ ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಡೊಮೇನ್ ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH4" />ನಿಮ್ಮ ಮಗುವಿನ Google ಖಾತೆಗಾಗಿ ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಆನ್ ಮಾಡಿದ್ದರೆ, ನಿಮ್ಮ ಮಗುವಿನ ಡೇಟಾವನ್ನು ಅವರ Google ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಬಹುದು. ಈ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಕುರಿತು ಮತ್ತು ಇವುಗಳನ್ನು ಹೊಂದಾಣಿಕೆ ಮಾಡುವುದು ಹೇಗೆ ಎಂಬ ಕುರಿತು families.google.com ನಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.<ph name="END_PARAGRAPH4" /></translation>
<translation id="6800893479155997609">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗಾಗಿ ಟಾಪ್‌ ಆ್ಯಪ್‌ಗಳು</translation>
<translation id="6818802132960437751">ಅಂತರ್ನಿರ್ಮಿತ ವೈರಸ್‌ನಿಂದ ರಕ್ಷಣೆ</translation>
<translation id="682971198310367122">Google ಗೌಪ್ಯತೆ ನೀತಿ</translation>
<translation id="6835762382653651563">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ದಯವಿಟ್ಟು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಗೊಳಿಸಿ.</translation>
<translation id="6839916869147598086">ಸೈನ್ ಇನ್ ಬದಲಾಗಿದೆ</translation>
<translation id="6852529053326738838">ನಿಮ್ಮ ಖಾತೆಯು ಅರ್ಹವಾಗಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, ನಿಮ್ಮ ಸಂಸ್ಥೆಯನ್ನು ಕೇಳಿ ಅಥವಾ ನಿಮ್ಮ ಉದ್ಯೋಗದ ಇಮೇಲ್‌ನ ಮೂಲಕ ನೋಂದಾಯಿಸಿ.</translation>
<translation id="6867671714894555998">ಹೊಸ ಕೀಬೋರ್ಡ್‌ ಮೂಲಕ ಕೆಲಸಗಳನ್ನು ತ್ವರಿತವಾಗಿ ಮಾಡಿ</translation>
<translation id="6881845890692344060">ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಲಾಗ್ ಔಟ್ ಮಾಡಿದ್ದಾರೆ. ಈಗ ಎಲ್ಲವೂ ನಿಮ್ಮ ನಿಯಂತ್ರಣದಲ್ಲಿದೆ.</translation>
<translation id="6883319974225028188">ಓಹ್‌‌! ಸಾಧನದ ಕಾನ್ಫಿಗರೇಶನ್ ಉಳಿಸಲು ಸಿಸ್ಟಂ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="6888831646723563669">ನಿಮ್ಮ ಹೊಸ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ಎಲ್ಲಾ ಫೀಚರ್‌ಗಳನ್ನು ಆನಂದಿಸಲು ಸಂಪರ್ಕದಲ್ಲಿರಿ</translation>
<translation id="6890053850723168825"><ph name="BEGIN_PARAGRAPH1" />ಸಂಪರ್ಕಗಳು, ಸಂದೇಶಗಳು ಮತ್ತು ಫೋಟೋಗಳಂತಹ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ, ಆ್ಯಪ್ ಸೇವ್ ಮಾಡಿರುವ ಯಾವುದೇ ಮಾಹಿತಿಯು (ಡೆವಲಪರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಆಧರಿಸಿ) ಆ್ಯಪ್ ಡೇಟಾ ಆಗಿರಬಹುದು. ನಿಮ್ಮ ಮಗುವಿನ ಡ್ರೈವ್ ಸಂಗ್ರಹಣೆ ಕೋಟಾದಲ್ಲಿ ಬ್ಯಾಕಪ್‌ ಡೇಟಾ ಸೇರಿರುವುದಿಲ್ಲ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಈ ಸೇವೆಯನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆಫ್ ಮಾಡಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6897688156970667447">ಕಡಿಮೆ ಬೆಳಕಿದ್ದಾಗ ಉಪಯುಕ್ತ ಮತ್ತು ಬ್ಯಾಟರಿ ಉಳಿಸುತ್ತದೆ</translation>
<translation id="6903907808598579934">ಸಿಂಕ್‌ ಆನ್‌ ಮಾಡಿ</translation>
<translation id="6918733588290914545">Android ಫೋನ್‌ನೊಂದಿಗೆ ತ್ವರಿತ ಸೆಟಪ್</translation>
<translation id="6920473853105515518">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಆಗಿದೆಯೆ ಎಂದು ಖಾತ್ರಿಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಇನ್ನೊಂದು ಸಾಧನದಲ್ಲಿ play.google/play-terms ಗೆ ಭೇಟಿ ನೀಡಬಹುದು.</translation>
<translation id="6929126689972602640">ಶಾಲಾ ಖಾತೆಗಳಿಗೆ ಪೋಷಕರ ನಿಯಂತ್ರಣಗಳನ್ನು ಬೆಂಬಲಿಸಲಾಗುವುದಿಲ್ಲ. ಮನೆಯಲ್ಲಿ ಶಾಲಾ ಕೆಲಸ ಮಾಡುವುದಕ್ಕಾಗಿ Google Classroom ಮತ್ತು ಇತರ ವೆಬ್‌ಸೈಟ್‌ಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಶಾಲಾ ಖಾತೆಯೊಂದನ್ನು ಸೇರಿಸಲು, ಮೊದಲು ಮಗುವಿನ ವೈಯಕ್ತಿಕ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ನಂತರ ಸೆಟಪ್‌ನಲ್ಲಿ ಶಾಲಾ ಖಾತೆಯನ್ನು ಸೇರಿಸಬಹುದು.</translation>
<translation id="6935031746833428401">ಡಿವೈಸ್ ಮ್ಯಾನೇಜ್‌ಮೆಂಟ್ ಕುರಿತಾಗಿ ಹೆಚ್ಚಿನ ಮಾಹಿತಿಯನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="6950351336108213154">ಸಾಧನದ ಪೆರಿಫೆರಲ್‌ಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="6955698182324067397">ನೀವು ChromeOS ಡೀಬಗ್ ಮಾಡುವಿಕೆಯ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತಿದ್ದು, ಅದು sshd daemon ಅನ್ನು ಸೆಟಪ್ ಮಾಡುತ್ತದೆ ಮತ್ತು USB ಡ್ರೈವ್‌ಗಳಿಂದ ಬೂಟ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ.</translation>
<translation id="6965382102122355670">ಸರಿ</translation>
<translation id="6969216690072714773">ಈ ಸಾಧನಕ್ಕೆ ಸಂಯೋಜಿಸಲು ಹೊಸ ಮಾಹಿತಿಯನ್ನು ನಮೂದಿಸಿ ಅಥವಾ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಮಾಹಿತಿಯನ್ನು ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ.</translation>
<translation id="6981982820502123353">ಪ್ರವೇಶ</translation>
<translation id="6984652455487792101">ನೀವು ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್ ಬಳಸುತ್ತಿದ್ದರೆ, ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿದೆಯೇ
        ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಅಥವಾ ನಿಮ್ಮ
ನೆಟ್‌ವರ್ಕ್ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್‌ ಅನ್ನು ಬಳಸುತ್ತಿರುವಿರಿ ಎಂದು ನೀವು ನಂಬದಿದ್ದರೆ, ನೀವು
       ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್ ಅನ್ನು ಬಳಸುತ್ತಿರಬಹುದು, ನಿಮ್ಮ <ph name="LINK_START" />ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="LINK_END" /> ಸರಿಹೊಂದಿಸಿ.</translation>
<translation id="6996245928508281884">ನಿಮ್ಮ ಫೋನ್‌ನ ಬ್ಲೂಟೂತ್ ಮತ್ತು ವೈ-ಫೈ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="6996438701394974959">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಪಠ್ಯ ಗಾತ್ರವನ್ನು ಹೆಚ್ಚಿಸಿ</translation>
<translation id="6998793565256476099">ವೀಡಿಯೊ ಸಂವಾದ ನಡೆಸಲು ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿ</translation>
<translation id="7025082428878635038">ಗೆಸ್ಚರ್‌ಗಳನ್ನು ಬಳಸಿ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ಹೊಸ ವಿಧಾನವನ್ನು ಪರಿಚಯಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="7034692021407794547">ಬಿಲ್ಲಿಂಗ್ ನಿರ್ವಹಣಾ ಸವಲತ್ತುಗಳನ್ನು ಹೊಂದಿರುವ ನಿರ್ವಾಹಕರು ಮೊದಲು ನಿರ್ವಹಣೆ ಕನ್ಸೋಲ್‌ನಲ್ಲಿರುವ Google Meet ಹಾರ್ಡ್‌ವೇರ್ ವಿಭಾಗದಲ್ಲಿನ Google Meet ಹಾರ್ಡ್‌ವೇರ್ ಸೇವಾ ನಿಯಮಗಳಿಗೆ ಸಮ್ಮತಿಸಬೇಕು.</translation>
<translation id="7039951224110875196">ಮಗುವೊಂದಕ್ಕೆ Google ಖಾತೆಯನ್ನು ರಚಿಸಿ</translation>
<translation id="7065223852455347715">ಈ ಸಾಧನವನ್ನು ಎಂಟರ್‌ರ್ಪ್ರೈಸ್ ನೋಂದಣಿಯನ್ನು ತಡೆಯುವ ಮೋಡ್‌ನಲ್ಲಿ ಲಾಕ್ ಮಾಡಲಾಗಿದೆ. ನೀವು ಸಾಧನವನ್ನು ನೋಂದಣಿ ಮಾಡಲು ಬಯಸಿದರೆ ನೀವು ಮೊದಲಿಗೆ ಸಾಧನ ಮರುಪ್ರಾಪ್ತಿಯನ್ನು ಮಾಡಬೇಕಾದ ಅಗತ್ಯವಿರುತ್ತದೆ.</translation>
<translation id="7066572364168923329">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನ ಸೆಟಪ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="7077829361966535409">ಪ್ರಸ್ತುತ ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಲೋಡ್ ಮಾಡುವಾಗ ಸೈನ್-ಇನ್ ಪುಟವು ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು <ph name="GAIA_RELOAD_LINK_START" />ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ<ph name="GAIA_RELOAD_LINK_END" />, ಅಥವಾ ಬೇರೆ <ph name="PROXY_SETTINGS_LINK_START" />ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="PROXY_SETTINGS_LINK_END" /> ಬಳಸಿ.</translation>
<translation id="7088674813905715446">ನಿರ್ವಾಹಕರಿಂದ ಈ ಸಾಧನವನ್ನು ಆದ್ಯತೆ ಇಲ್ಲದ ಸ್ಥಿತಿಯಲ್ಲಿ ಇರಿಸಲಾಗಿದೆ. ನೋಂದಣಿಗಾಗಿ ಸಕ್ರಿಯಗೊಳಿಸಲು, ಸಾಧನವನ್ನು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಾಕಿ ಸ್ಥಿತಿಯಲ್ಲಿರಿಸುವಂತೆ ತಿಳಿಸಿ.</translation>
<translation id="7114054701490058191">ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹೊಂದಾಣಿಕೆಯಾಗುವುದಿಲ್ಲ</translation>
<translation id="7135729336746831607">ಬ್ಲೂಟೂತ್ ಆನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="7141105143012495934">ನಿಮ್ಮ ಖಾತೆ ವಿವರಗಳನ್ನು ಹಿಂಪಡೆಯಲು ಸಾಧ್ಯವಾಗದಿರುವುದರಿಂದ ಸೈನ್ ಇನ್ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ ಅಥವಾ ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7144878232160441200">ಮರುಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="7149839598364933473">ಈ ಸಾಧನವನ್ನು <ph name="DEVICE_OS" /> ಸಾಧನವನ್ನಾಗಿ ಪರಿವರ್ತಿಸಿ.</translation>
<translation id="7171259390164035663">ನೋಂದಾಯಿಸಿಕೊಳ್ಳಬೇಡಿ</translation>
<translation id="7189451821249468368">ಈ ಸಾಧನವನ್ನು ನೋಂದಣಿ ಮಾಡಲು ನೀವು ಸಾಕಷ್ಟು ಅಪ್‌ಗ್ರೇಡ್‌ಗಳನ್ನು ಹೊಂದಿಲ್ಲ. ಇನ್ನಷ್ಟು ಖರೀದಿಸಲು ಮಾರಾಟ ವಿಭಾಗವನ್ನು ಸಂಪರ್ಕಿಸಿ. ಈ ಸಂದೇಶವನ್ನು ನೀವು ದೋಷದಲ್ಲಿ ನೋಡುತ್ತಿರುವಿರಿ ಎಂದು ಭಾವಿಸುವುದಾದರೆ, ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="7202337678781136582">ನಿಮ್ಮ Android ಫೋನ್ ಮೂಲಕ QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ</translation>
<translation id="7228854227189381547">ಬದಲಿಸಬೇಡಿ</translation>
<translation id="7230429581553827767"><ph name="BEGIN_PARAGRAPH1" />ಉತ್ತಮ ಅನುಭವಕ್ಕಾಗಿ, ನಿಮ್ಮ ಆಂತರಿಕ ಡಿಸ್ಕ್‌ನಲ್ಲಿ <ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ನೀವು ಇದನ್ನು ನಂತರ ಲಾಗಿನ್ ಸ್ಕ್ರೀನ್‌ನಿಂದಲೂ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದು.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನೀವು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಿದ್ಧರಿಲ್ಲದಿದ್ದರೆ, ಇದನ್ನು ಬಳಸಿ ನೋಡಲು ನೀವು USB ಇಂದ ರನ್ ಮಾಡಬಹುದು. ಇದು ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ OS ಮತ್ತು ಡೇಟಾವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ, ಆದರೆ ನೀವು ಸಂಗ್ರಹಣೆ ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯ ಮಿತಿಗಳನ್ನು ನೋಡಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7230881857327093958">ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ</translation>
<translation id="7260186537988033909">ಕಿಯೋಸ್ಕ್ ಮತ್ತು ಸೈನೇಜ್ ಸಾಧನಗಳ ನೋಂದಣಿ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="7284411326658527427">ಪ್ರತಿಯೊಬ್ಬ ವ್ಯಕ್ತಿಯು ತಮ್ಮ ಖಾತೆಯನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಬಹುದು ಮತ್ತು ಡೇಟಾವನ್ನು ಖಾಸಗಿಯಾಗಿರಿಸಬಹುದು.</translation>
<translation id="7290242001003353852">ಈ ಸೈನ್ ಇನ್ ಸೇವೆಯನ್ನು <ph name="SAML_DOMAIN" /> ಮೂಲಕ ಹೋಸ್ಟ್ ಮಾಡಲಾಗಿದೆ, ಇದು ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಪ್ರವೇಶಿಸುತ್ತದೆ.</translation>
<translation id="7311005168897771689">ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿರುವಾಗ ನಿಮ್ಮ Google Drive ಫೈಲ್‌ಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ</translation>
<translation id="7317831949569936035">ಶಾಲಾ ನೋಂದಣಿ</translation>
<translation id="7326004502692201767">ಮಗುವೊಂದಕ್ಕಾಗಿ ಈ <ph name="DEVICE_TYPE" /> ಸಾಧನವನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="732659786514229249">ನಿಮ್ಮ ಸಂಸ್ಥೆಯಲ್ಲಿ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಬೇಕೆ?</translation>
<translation id="7329154610228416156">ಸೈನ್‌ ಇನ್‌ ವಿಫಲಗೊಂಡಿದೆ ಏಕೆಂದರೆ ಅದು ಸುರಕ್ಷಿತವಲ್ಲದ URL (<ph name="BLOCKED_URL" />) ಬಳಸುವಂತೆ ಕಾನ್ಫಿಗರ್‌‌ ಮಾಡಲಾಗಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="7345706641791090287">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಖಚಿತಪಡಿಸಿ</translation>
<translation id="7348093485538360975">ಆನ್ ಸ್ಕ್ರೀನ್ ಕೀಬೋರ್ಡ್</translation>
<translation id="7352651011704765696">ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="7403642243184989645">ಮಾಹಿತಿ ಮೂಲಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="7406912950279255498">ಬಣ್ಣ ವಿಲೋಮದ ಮೋಡ್</translation>
<translation id="7416263748877373774">ಸೇವಾ ನಿಯಮಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಕನೆಕ್ಷನ್ ಪರಿಶೀಲಿಸಿ, ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7475742997309661417">ChromeOS ನಲ್ಲಿನ ಸ್ಕ್ರೀನ್ ರೀಡರ್, ChromeVox, ಮುಖ್ಯವಾಗಿ ಅಂಧತ್ವ ಅಥವಾ ಕಡಿಮೆ ದೃಷ್ಟಿ ಹೊಂದಿರುವ ಜನರು ಸ್ಪೀಚ್ ಸಿಂಥಸೈಜರ್ ಅಥವಾ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯಿರುವ ಸ್ಕ್ರೀನ್ ಮೇಲೆ ತೋರಿಸಲಾದ ಪಠ್ಯವನ್ನು ಓದಲು ಬಳಸುತ್ತಾರೆ. ChromeVox ಅನ್ನು ಆನ್ ಮಾಡಲು ಎರಡೂ ವಾಲ್ಯೂಮ್ ಕೀಗಳನ್ನು ಐದು ಸೆಕೆಂಡುಗಳ ಕಾಲ ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ. ChromeVox ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ನೀವು ಕ್ವಿಕ್ ಟೂರ್ ಮೂಲಕ ತಿಳಿದುಕೊಳ್ಳುತ್ತೀರಿ.</translation>
<translation id="7476454130948140105">ಅಪ್‌ಡೇಟ್‌ ಮಾಡಲು ಬ್ಯಾಟರಿ <ph name="BATTERY_PERCENT" /> ತುಂಬಾ ಕಡಿಮೆ ಇದೆ</translation>
<translation id="7479437430459628222"><ph name="BEGIN_PARAGRAPH1" />ಏನೋ ತಪ್ಪಾಗಿದೆ ಹಾಗೂ <ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಹೆಚ್ಚಿನ ಸಹಾಯಕ್ಕಾಗಿ ಇಲ್ಲಿಗೆ ಭೇಟಿ ನೀಡಿ: g.co/flex/InstallErrors.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7504187084873714912"><ph name="BEGIN_PARAGRAPH1" />ನೋಂದಾಯಿಸುವ ಮೊದಲು ನೀವು TPM ತೆರವುಗೊಳಿಸಬೇಕು, ಇದರಿಂದ <ph name="DEVICE_OS" /> ಗೆ ಸಾಧನದ ಮಾಲೀಕತ್ವವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಅಲ್ಲದೇ, ನೀವು TPM ಸಾಧನವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಆಫ್ ಮಾಡಬಹುದು. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಈಗಲೂ ಸಾಫ್ಟ್‌ವೇರ್ ಎನ್‌ಕ್ರಿಪ್ಶನ್‌ನ ಮೂಲಕ ಸುರಕ್ಷಿತವಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ, ಆದರೆ ಹಾರ್ಡ್‌ವೇರ್ ಬೆಂಬಲಿತ ಪ್ರಮಾಣಪತ್ರಗಳಂತಹ ಕೆಲವು ಭದ್ರತಾ ಫೀಚರ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />ರೀಬೂಟ್ ಮಾಡಿ, ಸಿಸ್ಟಂ BIOS/UEFI ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನಮೂದಿಸುವ ಮೂಲಕ ನಿಮ್ಮ TPM ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ನೀವು ಬದಲಾಯಿಸಬಹುದು. ಸಾಧನದ ಮಾದರಿಯನ್ನು ಆಧರಿಸಿ ಹಂತಗಳು ಬದಲಾಗುತ್ತವೆ. ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ, ನೀವು ರೀಬೂಟ್ ಮಾಡುವ ಮೊದಲು <ph name="DEVICE_OS" /> ಡಾಕ್ಯುಮೆಂಟೇಶನ್ ಅನ್ನು ಪ್ರತ್ಯೇಕ ಸಾಧನದಲ್ಲಿ ತೆರೆಯಿರಿ: g.co/flex/TPMHelp.<ph name="END_PARAGRAPH3" /></translation>
<translation id="7506541170099744506">ಎಂಟರ್‌ಪ್ರೈಸ್ ನಿರ್ವಹಣೆಗಾಗಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಯಶಸ್ವಿಯಾಗಿ ದಾಖಲಿಸಲಾಗಿದೆ.</translation>
<translation id="7509097596023256288">ನಿಯಂತ್ರಣವನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="7543104066686362383">ಈ <ph name="IDS_SHORT_PRODUCT_NAME" /> ಸಾಧನದಲ್ಲಿ ಡೀಬಗ್ ಮಾಡುವಿಕೆ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="7544227555407951270">ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿ</translation>
<translation id="7549434883223124329">ಸಾಧನದ ಭಾಷೆಯನ್ನು ಬದಲಿಸಬೇಕೆ?</translation>
<translation id="7553242001898162573">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ</translation>
<translation id="7556242789364317684">ದುರದೃಷ್ಟವಶಾತ್, <ph name="SHORT_PRODUCT_NAME" /> ಗೆ ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರುಪಡೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದೋಷವನ್ನು ಸರಿಪಡಿಸಲು, ನಿಮ್ಮ ಸಾಧನವನ್ನು ಪವರ್‌ವಾಷ್‌ನೊಂದಿಗೆ <ph name="SHORT_PRODUCT_NAME" /> ಮರುಹೊಂದಿಸಬೇಕು.</translation>
<translation id="7560756177962144929">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ</translation>
<translation id="7571643774869182231">ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಕಷ್ಟು ಸಂಗ್ರಹಣೆಯಿಲ್ಲ</translation>
<translation id="7616214729753637086">ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="7619937211696316184">ನಿರ್ವಹಣೆ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="7622114377921274169">ಚಾರ್ಜ್ ಆಗುತ್ತಿದೆ.</translation>
<translation id="7630426712700473382">ಈ ಸಾಧನವನ್ನು <ph name="MANAGER" /> ಮೂಲಕ ನಿರ್ವಹಿಸಲಾಗುತ್ತಿದೆ ಮತ್ತು ನೀವು ಪ್ರತಿ ಬಾರಿಯೂ ಸೈನ್ ಇನ್ ಮಾಡುವ ಅಗತ್ಯವಿರುತ್ತದೆ.</translation>
<translation id="7633724038415831385">ಅಪ್‌ಡೇಟ್‌ಗಾಗಿ ನೀವು ಕಾಯುವ ಏಕೈಕ ಸಮಯ ಇದಾಗಿದೆ. Chromebook ಗಳಲ್ಲಿ, ಸಾಫ್ಟ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್‌ಗಳು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ.</translation>
<translation id="7639914187072011620">ಸರ್ವರ್‌ನಿಂದ SAML ಮರುನಿರ್ದೇಶನದ URL ಅನ್ನು ಪಡೆದುಕೊಳ್ಳಲು ವಿಫಲವಾಗಿದೆ</translation>
<translation id="7643117827468520640">ಈ ನಿಯಮಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="7647504534168186939"><ph name="BEGIN_PARAGRAPH1" />ಸಂಪರ್ಕಗಳು, ಸಂದೇಶಗಳು ಮತ್ತು ಫೋಟೋಗಳಂತಹ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ, ಆ್ಯಪ್ ಸೇವ್ ಮಾಡಿರುವ ಯಾವುದೇ ಮಾಹಿತಿಯು (ಡೆವಲಪರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಆಧರಿಸಿ) ಆ್ಯಪ್ ಡೇಟಾ ಆಗಿರಬಹುದು. ಬ್ಯಾಕಪ್ ಡೇಟಾವನ್ನು ನಿಮ್ಮ ಡ್ರೈವ್ ಸಂಗ್ರಹಣೆ ಕೋಟಾದಲ್ಲಿ ಪರಿಗಣಿಸಲಾಗುವುದಿಲ್ಲ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಈ ಸೇವೆಯನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆಫ್ ಮಾಡಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7649070708921625228">ಸಹಾಯ</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="7659584679870740384">ನೀವು ಈ ಸಾಧನವನ್ನು ಬಳಸಲು ಪ್ರಮಾಣಿತರಾಗಿಲ್ಲ. ಸೈನ್-ಇನ್ ಅನುಮತಿಗಾಗಿ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="7660116474961254898">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ</translation>
<translation id="7661451191293163002">ನೋಂದಣಿ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಪಡೆದುಕೊಳ್ಳಲಾಗಲಿಲ್ಲ.</translation>
<translation id="7666531788977935712">ಮುಂದುವರೆಸಿ ಬಟನ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="7671139479636735732">ನಿಮ್ಮ ಐಡಿಯಾಗಳನ್ನು ಸುಲಭವಾಗಿ ವಿಶುವಲೈಸ್ ಮಾಡಲು ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="770831926727930011">ನಿಮ್ಮ ಹಳೆಯ ಪಾಸ್‌ವರ್ಡ್‌ನ ಮೂಲಕ ನಿಮ್ಮ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲಾಗಿದೆ. ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ರಿಕವರ್ ಮಾಡಲು ನಿಮ್ಮ ಹಳೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="7722040605881499779">ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಇಷ್ಟು ಅಗತ್ಯವಿದೆ: <ph name="NECESSARY_SPACE" /></translation>
<translation id="7737115349420013392">"<ph name="DEVICE_NAME" />" ಜೊತೆ ಜೋಡಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="7746045113967198252">ಪಠ್ಯವನ್ನು ಒಳಗೊಂಡಂತೆ ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಮೇಲೆ ಐಟಂಗಳನ್ನು ದೊಡ್ಡದಾಗಿಸಿ ಅಥವಾ ಚಿಕ್ಕದಾಗಿಸಿ. ನೀವು ಇದನ್ನು ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಸಾಧನ &gt; ಡಿಸ್‌ಪ್ಲೇಗಳಲ್ಲಿ ಕಾಣಬಹುದು.</translation>
<translation id="7760176388948986635">ಸ್ಥಳ ಅನುಮತಿಯನ್ನು ಹೊಂದಿರುವ ChromeOS ಮತ್ತು Android ಆ್ಯಪ್‌ಗಳು, ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ಈ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಬಳಸಲು ಅನುಮತಿಸಿ. ಸ್ಥಳದ ನಿಖರತೆಯು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ಹೆಚ್ಚು ನಿಖರವಾದ ಸ್ಥಳವನ್ನು ಒದಗಿಸುತ್ತದೆ. ಇದನ್ನು ಮಾಡಲು, ಸಾಧನದ ಸೆನ್ಸರ್‌ಗಳು ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದಿಂದ ಕ್ರೌಡ್‌ಸೋರ್ಸ್ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್ ಸ್ಥಳಗಳಿಗೆ ಹೋಗುವ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳನ್ನು ಕುರಿತು Google ನಿಯಮಿತವಾಗಿ ಮಾಹಿತಿಯನ್ನು ಪ್ರಾಸೆಸ್ ಮಾಡುತ್ತದೆ. ಸ್ಥಳದ ನಿಖರತೆ ಮತ್ತು ಸ್ಥಳ ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು ಮತ್ತು ಬಳಕೆದಾರರ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಲು Google ನ ಮತ್ತು ಥರ್ಡ್ ಪಾರ್ಟಿಗಳ ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ Google ನ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು, ಒದಗಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು ಯಾವುದೇ ವ್ಯಕ್ತಿಯನ್ನು ಗುರುತಿಸದೆಯೇ ಇವುಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ.</translation>
<translation id="7784875615510899699">ಈ Google Beam ಸಾಧನವನ್ನು ನೋಂದಣಿ ಮಾಡಲು ನಿಮಗೆ ಸಾಕಷ್ಟು ಲಭ್ಯವಿರುವ ಪರವಾನಗಿಗಳಿಲ್ಲ. ಹೆಚ್ಚಿನದನ್ನು ಖರೀದಿಸಲು ನಿಮ್ಮ ಮರುಮಾರಾಟಗಾರರನ್ನು ಸಂಪರ್ಕಿಸಿ. ನೀವು ಈ ಸಂದೇಶವನ್ನು ತಪ್ಪಾಗಿ ನೋಡುತ್ತಿರುವಿರಿ ಎಂದು ಭಾವಿಸುವುದಾದರೆ, ನಿಮ್ಮ ಮರುಮಾರಾಟಗಾರರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="7791269138074599214">ಇನ್‌ಪುಟ್ ವಿಧಾನ</translation>
<translation id="7791436592012979144">ಹಿಮ್ಮುಖ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="7792012425874949788">ಸೈನ್ ಇನ್ ಮಾಡುವುದರೊಂದಿಗೆ ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="780301667611848630">ಬೇಡ</translation>
<translation id="7803657407897251194">ನಿಮ್ಮ Android ಸಾಧನದೊಂದಿಗೆ ಸೆಟಪ್ ಅನ್ನು ಮುಂದುವರಿಸಲು, ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಸಾಧನವೊಂದನ್ನು ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಿ</translation>
<translation id="7842692330619197998">ನೀವು ಹೊಸ ಖಾತೆಯೊಂದನ್ನು ರಚಿಸಬೇಕಾದರೆ g.co/ChromeEnterpriseAccount ಗೆ ಭೇಟಿ ನೀಡಿ.</translation>
<translation id="7851457902707056880">ಮಾಲೀಕನ ಖಾತೆಗೆ ಮಾತ್ರ ಸೈನ್‌-ಇನ್‌ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ. ದಯವಿಟ್ಟು ರೀಬೂಟ್ ಮಾಡಿ ಮತ್ತು ಮಾಲೀಕರ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ಯಂತ್ರವು 30 ಸೆಕುಂಡುಗಳಲ್ಲಿ ಸ್ವಯಂ ರೀಬೂಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="7870730066603611552">ಸೆಟಪ್ ನಂತರ ಸಿಂಕ್ ಆಯ್ಕೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="7883792253546618164">ಯಾವಾಗ ಬೇಕಾದರೂ ಅನ್‌ಸಬ್‌ಸ್ಕ್ರೈಬ್ ಮಾಡಿ.</translation>
<translation id="7887864092952184874">ಬ್ಲೂಟೂತ್‌ ಮೌಸ್ ಜೋಡಿಯಾಗಿದೆ</translation>
<translation id="7906440585529721295">ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ</translation>
<translation id="7910725946105920830">ನಿಮ್ಮ ವೈಯಕ್ತಿಕ Google ಖಾತೆಯನ್ನು ಬಳಸಿ</translation>
<translation id="7918257978052780342">ನೋಂದಾಯಿಸಿ</translation>
<translation id="7923516590127538256"><ph name="BEGIN_PARAGRAPH1" />ಸ್ವಯಂಚಾಲಿತ ವರದಿಗಳನ್ನು ಕಳುಹಿಸಲು ChromeOS ಸಾಧನಗಳಿಗೆ ಅನುಮತಿಸುವುದರಿಂದ, ChromeOS ನಲ್ಲಿ ಏನನ್ನು ಸರಿಪಡಿಸಬೇಕು ಮತ್ತು ಸುಧಾರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆದ್ಯತೆಯ ಪ್ರಕಾರ ನಿರ್ವಹಿಸಲು ನಮಗೆ ಸಹಾಯವಾಗುತ್ತದೆ. Chrome OS ಯಾವಾಗ ಕ್ರ್ಯಾಶ್ ಆಗುತ್ತದೆ, ಯಾವ ಫೀಚರ್‌ಗಳನ್ನು ಬಳಸಲಾಗಿದೆ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಮೆಮೊರಿಯನ್ನು ಬಳಸಲಾಗಿದೆ ಎನ್ನುವಂತಹ ವಿಷಯಗಳು ಈ ವರದಿಗಳಲ್ಲಿ ಸೇರಿರಬಹುದು.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮ ಮಗುವಿನ ChromeOS ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ, ನೀವು ಈ ವರದಿಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಾರಂಭಿಸಬಹುದು ಅಥವಾ ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಡೊಮೇನ್ ನಿರ್ವಾಹಕರಾಗಿದ್ದರೆ, ನಿರ್ವಾಹಕರ ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನೀವು ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7939062555109487992">ಸುಧಾರಿತ ಆಯ್ಕೆಗಳು</translation>
<translation id="7943311690198910993">ಸೈನ್-ಇನ್ ವಿಧಾನವನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="795240231873601803">ಉದ್ಯೋಗ ಮತ್ತು ಶಾಲಾ ಖಾತೆಗಳಿಗಾಗಿ ಎಂಟರ್‌ಪ್ರೈಸ್ ದಾಖಲಾತಿಯನ್ನು ಬಳಸಿ</translation>
<translation id="7968982339740310781">ವಿವರಗಳನ್ನು ವೀಕ್ಷಿಸಿ</translation>
<translation id="7975504106303186033">ನೀವು ಈ Chrome Education ಸಾಧನವನ್ನು ಶಿಕ್ಷಣ ಖಾತೆಯಲ್ಲಿ ನೋಂದಾಯಿಸಬೇಕು. ಹೊಸ ಖಾತೆಗಾಗಿ ಸೈನ್ ಅಪ್ ಮಾಡಲು, g.co/workspace/edusignup ಗೆ ಭೇಟಿ ನೀಡಿ.</translation>
<translation id="7980084013673500153">ಅಸೆಟ್ ID: <ph name="ASSET_ID" /></translation>
<translation id="7981670705071137488">ಇದರ ನಂತರ, ಸಾಫ್ಟ್‌ವೇರ್ ಅಪ್‌ಡೇಟ್‌ಗಳು ಹಿನ್ನೆಲೆಯನ್ನು ನಡೆಯುತ್ತವೆ. ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅಪ್‌ಡೇಟ್ ಆದ್ಯತೆಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು.</translation>
<translation id="7982083145464587921">ಈ ದೋಷವನ್ನು ಸರಿಪಡಿಸಲು ದಯವಿಟ್ಟು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="7988805580376093356">ನಿಮ್ಮ OS ಅನ್ನು ಉಳಿಸಿಕೊಳ್ಳಿ ಹಾಗೂ USB ಯಿಂದ <ph name="DEVICE_OS" /> ಅನ್ನು ರನ್ ಮಾಡಿ.</translation>
<translation id="7990958035181555539">ನಿಮ್ಮ Android ಫೋನ್‌ನಿಂದ Wi-Fi ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ವರ್ಗಾಯಿಸಿ</translation>
<translation id="8022466874160067884">ನಿಮ್ಮ Google ಖಾತೆ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="8049029041626250638">ಕೀಬೋರ್ಡ್ ಅಥವಾ ಮೌಸ್ ಅನ್ನು ಕನೆಕ್ಟ್ ಮಾಡಿ. ನೀವು ಬ್ಲೂಟೂತ್ ಸಾಧನಗಳನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, ನಿಮ್ಮ ಸಾಧನಗಳು ಜೋಡಿಸಲು ಸಿದ್ಧವಾಗಿವೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="8054563304616131773">ದಯವಿಟ್ಟು ಮಾನ್ಯವಾದ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="8054921503121346576">USB ಕೀಬೋರ್ಡ್ ಸಂಪರ್ಕಗೊಂಡಿದೆ</translation>
<translation id="8065144531309810062">ಇನ್ನಷ್ಟು ಸೃಜನಾತ್ಮಕ ಮತ್ತು ಉತ್ಪಾದಕತೆಯನ್ನು ಹೆಚ್ಚಿಸಲು Google AI ಅನ್ನು ಬಳಸಿ</translation>
<translation id="8082106343289440791">"<ph name="DEVICE_NAME" />" ಜೊತೆ ಪೇರ್ ಮಾಡಬೇಕೇ?</translation>
<translation id="8097959162767603171">ನಿರ್ವಾಹಕ ಕನ್ಸೋಲ್‌ನಲ್ಲಿನ Chrome ಸಾಧನ ಪಟ್ಟಿಯಲ್ಲಿನ ಸೇವಾ ನಿಯಮಗಳನ್ನು ಮೊದಲು ನಿರ್ವಾಹಕರು ಒಪ್ಪಿಕೊಳ್ಳಬೇಕು.</translation>
<translation id="8098156986344908134"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬೇಕೆ ಹಾಗೂ ಹಾರ್ಡ್ ಡ್ರೈವ್‌ನಲ್ಲಿರುವುದನ್ನು ಅಳಿಸಬೇಕೆ?</translation>
<translation id="8098616321286360457">ನೆಟ್‌ವರ್ಕ್ ಕನೆಕ್ಷನ್‌ನ ಅಗತ್ಯವಿದೆ</translation>
<translation id="8129265306888404830">ನಿಮ್ಮ ಸಂಸ್ಥೆಯಲ್ಲಿನ (<ph name="EMAIL_DOMAIN" />) ನಿಮ್ಮ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಬಳಸಲು, ನೀವು ಎಂಟರ್‌ಪ್ರೈಸ್ ದಾಖಲಾತಿಯನ್ನು ಬಳಸಬೇಕಾಗುತ್ತದೆ. ಈ ಸಾಧನವು ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಬಳಕೆಗಾಗಿ ಇದ್ದರೆ, ನಿಮ್ಮ ವೈಯಕ್ತಿಕ Google ಖಾತೆ ಬಳಸಿಕೊಂಡು ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8131740175452115882">ದೃಢೀಕರಿಸು</translation>
<translation id="8146177459103116374">ಈ ಸಾಧನದಲ್ಲಿ ನೀವು ಈಗಾಗಲೇ ನೋಂದಾಯಿಸಿದ್ದರೆ, ನೀವು <ph name="LINK2_START" />ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಬಳಕೆದಾರನಂತೆ ಸೈನ್ ಇನ್<ph name="LINK2_END" /> ಮಾಡಬಹುದು.</translation>
<translation id="8146793085009540321">ಸೈನ್-ಇನ್ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ ಅಥವಾ ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8147346945017130012">ಕ್ರ್ಯಾಶ್ ವರದಿಗಳು ಹಾಗೂ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ಸ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು Google ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಳುಹಿಸುವ ಮೂಲಕ Chrome ಹಾಗೂ Chrome OS ಫೀಚರ್‌ಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="8152760814912191567">Zoom ಗಾಗಿ Google Beam</translation>
<translation id="815491593104042026">ಓಹ್‌!  ದೃಢೀಕರಣವು ವಿಫಲಗೊಂಡಿದೆ ಏಕೆಂದರೆ ಅದನ್ನು ಸುರಕ್ಷಿತವಲ್ಲದ URL (<ph name="BLOCKED_URL" />) ಬಳಸಿ ಕಾನ್ಫಿಗರ್‌ ಮಾಡಿದೆ.  ದಯವಿಟ್ಟು ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="8157704005178149728">ಮೇಲ್ವಿಚಾರಣೆಯನ್ನು ಹೊಂದಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="8174047975335711832">ಸಾಧನದ ಮಾಹಿತಿ</translation>
<translation id="818985507198861625"><ph name="BEGIN_PARAGRAPH1" />ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಅಂದಾಜು ಮಾಡುವುದಕ್ಕೆ ಸಹಾಯ ಮಾಡಲು, Google ನ ಸ್ಥಳ ಸೇವೆಯು ವೈ-ಫೈ, ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್‌ಗಳು ಮತ್ತು ಸೆನ್ಸರ್‌ಗಳಂತಹ ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಆ್ಯಪ್‌ಗಳು &gt; Google Play Store &gt; Android ಆದ್ಯತೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ &gt; ಸುರಕ್ಷತೆ ಮತ್ತು ಸ್ಥಳ &gt; ಸ್ಥಳ ಎಂಬಲ್ಲಿಗೆ ಹೋಗುವ ಮೂಲಕ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ Android ಸ್ಥಳವನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು. ಅದೇ ಮೆನುವಿನಲ್ಲಿ “Google ಸ್ಥಳ ನಿಖರತೆಯನ್ನು” ಆಫ್ ಮಾಡುವ ಮೂಲಕ ನೀವು Android ಸ್ಥಳಕ್ಕಾಗಿ ವೈ-ಫೈ, ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್‌ಗಳು ಮತ್ತು ಸೆನ್ಸರ್‌ಗಳ ಬಳಕೆಯನ್ನು ಸಹ ಆಫ್ ಮಾಡಬಹುದು.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8202160505685531999">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಪ್ರೊಫೈಲ್ ಅಪ್‌‌ಡೇಟ್‌ ಮಾಡಲು ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ ಮರುನಮೂದಿಸಿ.</translation>
<translation id="822050276545350872">ಈ ಕ್ಷಣದಿಂದ ಕಾಯುವ ಅಗತ್ಯವಿಲ್ಲ</translation>
<translation id="8239032431519548577">ಎಂಟರ್‌ಪ್ರೈಸ್ ನೋಂದಣಿ ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="8241806945692107836">ಸಾಧನದ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ನಿರ್ಧರಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="8242426110754782860">ಮುಂದುವರಿಸು</translation>
<translation id="826905130698769948">ಅಮಾನ್ಯ ಕ್ಲೈಂಟ್ ಪ್ರಮಾಣಪತ್ರ</translation>
<translation id="8271379370373330993">ಪೋಷಕರೇ, ನಿಮಗಾಗಿ ಮುಂದಿನ ಕೆಲವು ಹಂತಗಳು ಇಲ್ಲಿವೆ. ಖಾತೆ ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ ನೀವು ಮಗುವಿಗೆ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಹಿಂತಿರುಗಿಸಬಹುದು.</translation>
<translation id="8274924778568117936">ಅಪ್‌ಡೇಟ್ ಮುಕ್ತಾಯಗೊಳ್ಳುವವರೆಗೆ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಆಫ್ ಮಾಡಬೇಡಿ. ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪ್ರಕ್ರಿಯೆ ಪೂರ್ಣಗೊಂಡ ನಂತರ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ.</translation>
<translation id="8281886186245836920">ಸ್ಕಿಪ್‌ ಮಾಡಿ</translation>
<translation id="8289509909262565712"><ph name="DEVICE_OS" /> ಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="8291942417224950075">ವೈಯಕ್ತಿಕ ಬಳಕೆಗಾಗಿ</translation>
<translation id="8304383784961451596">ಈ ಸಾಧನವನ್ನು ಬಳಸಲು ನಿಮಗೆ ಅನುಮತಿ ಇಲ್ಲ. ಸೈನ್-ಇನ್ ಅನುಮತಿಗಾಗಿ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ ಅಥವಾ Family Link ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿರುವ Google ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8321837372750396788">ಈ <ph name="DEVICE_TYPE" /> ಅನ್ನು <ph name="MANAGER" /> ಮೂಲಕ ನಿರ್ವಹಿಸಲಾಗುತ್ತಿದೆ.</translation>
<translation id="8339288417038613756">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಪಠ್ಯ ಗಾತ್ರ</translation>
<translation id="8354034204605718473">ನಿಮ್ಮ ಮಗುವಿನ ಪಿನ್ ಅನ್ನು ಸೇರಿಸಲಾಗಿದೆ</translation>
<translation id="8360140320636871023">ನಿಮ್ಮ ಡಿಸ್‌ಪ್ಲೇ ಥೀಮ್ ಅನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಿ</translation>
<translation id="8366396658833131068">ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್‌ ಸಂಪರ್ಕವನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ. ದಯವಿಟ್ಟು ಬೇರೊಂದು ನೆಟ್‌ವರ್ಕ್‌ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಕಿಯೋಸ್ಕ್‌ ಅಪ್ಲಿಕೇಶನ್‌ ಪ್ರಾರಂಭಿಸಲು ಕೆಳಗಿರುವ 'ಮುಂದುವರಿಸು' ಬಟನ್‌ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="8401432541486058167">ನಿಮ್ಮ ಸ್ಮಾರ್ಟ್ ಕಾರ್ಡ್‌ನೊಂದಿಗೆ ಸಂಯೋಜಿತವಾಗಿರುವ ಪಿನ್ ಅನ್ನು ಒದಗಿಸಿ.</translation>
<translation id="8408270600235826886">Google ನೊಂದಿಗೆ ಯಾವ ಡೇಟಾವನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ ಎನ್ನುವುದನ್ನು ನೀವು ನಿಯಂತ್ರಿಸಬಹುದು. ನೀವು ಇದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಿಸಬಹುದು. Google ನ <ph name="BEGIN_LINK" />ಗೌಪ್ಯತೆ ನೀತಿಗೆ<ph name="END_LINK" /> ಅನುಗುಣವಾಗಿ ಡೇಟಾವನ್ನು ಬಳಸಲಾಗುತ್ತದೆ.</translation>
<translation id="8413956290606243087">ChromeVox, ChromeOS ಗಾಗಿ ಅಂತರ್ನಿರ್ಮಿತ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನೀವು ಬಯಸುವಿರಾ?</translation>
<translation id="8425768983279799676">ನೀವು ಸಾಧನವನ್ನು ಅನ್‌ಲಾಕ್‌ ಮಾಡಲು ನಿಮ್ಮ ಪಿನ್ ಅನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="8428213095426709021">ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="843173223122814223">AI ಮೂಲಕ ಹಿನ್ನೆಲೆಗಳನ್ನು ರಚಿಸಿ</translation>
<translation id="8452105022015742247">ನಿಮ್ಮ Android ಫೋನ್‌ನಿಂದ Google ಖಾತೆಯ ಮಾಹಿತಿಯನ್ನು ವರ್ಗಾಯಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="8464132254133862871">ಸೇವೆಗಾಗಿ ಈ ಬಳಕೆದಾರರ ಖಾತೆಯು ಅರ್ಹವಲ್ಲ.</translation>
<translation id="8524841856047224176">ವೀಡಿಯೊ ಕರೆಗಳು ಹಾಗೂ ಮುಂತಾದವುಗಳಿಗಾಗಿ ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಹಿನ್ನೆಲೆಗಳನ್ನು ವೈಯಕ್ತೀಕರಿಸಿ</translation>
<translation id="8527257351549797148">ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ನೋಂದಣಿ ಅಗತ್ಯವಿರಬಹುದು ಆದ್ದರಿಂದ ನೀವು ಆ್ಯಪ್‌ಗಳು, ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು. ಭದ್ರತೆ ಮತ್ತು ಸಾಧನ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ವಿಷಯಗಳನ್ನು ನಿರ್ವಹಿಸಲು ಇದು ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ಅನುಮತಿಸುತ್ತದೆ.</translation>
<translation id="8549316893834449916">ನೀವು Gmail, Drive, YouTube ಮತ್ತು ಇನ್ನಷ್ಟವುಗಳಿಗೆ ಬಳಸುವ ಅದೇ ಖಾತೆಯನ್ನು ನಿಮ್ಮ Chromebook ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ಬಳಸುತ್ತೀರಿ.</translation>
<translation id="8558063527625343224">Google Beam ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="8569673829373920831"><ph name="APP_NAME" /> ಕುರಿತು ಇನ್ನಷ್ಟು ಮಾಹಿತಿ</translation>
<translation id="8586421813321819377">ಸ್ಥಳ ಅನುಮತಿಯನ್ನು ಹೊಂದಿರುವ ChromeOS ಮತ್ತು Android ಆ್ಯಪ್‌ಗಳು, ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಬಳಸಲು ಅನುಮತಿಸಿ. ಸ್ಥಳದ ನಿಖರತೆಯು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ಹೆಚ್ಚು ನಿಖರವಾದ ಸ್ಥಳವನ್ನು ಒದಗಿಸುತ್ತದೆ. ಇದನ್ನು ಮಾಡಲು, ನಿಮ್ಮ ಸಾಧನದಿಂದ ಕ್ರೌಡ್‌ಸೋರ್ಸ್ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್ ಸ್ಥಳಗಳಿಗೆ ಸಾಧನದ ಸೆನ್ಸರ್‌ಗಳು ಮತ್ತು ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು Google ನಿಯತಕಾಲಿಕವಾಗಿ ಪ್ರಾಸೆಸ್ ಮಾಡುತ್ತದೆ. ಸ್ಥಳದ ನಿಖರತೆ ಮತ್ತು ಸ್ಥಳ ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು ಮತ್ತು ಬಳಕೆದಾರರ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಲು Google ನ ಮತ್ತು ಥರ್ಡ್ ಪಾರ್ಟಿಗಳ ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ Google ನ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು, ಒದಗಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು ನಿಮ್ಮನ್ನು ಗುರುತಿಸದೆಯೇ ಇವುಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ.</translation>
<translation id="8627804903623428808">ಈ ನಿಯಮಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಮಗುವಿನ ಡೇಟಾವನ್ನು ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="8628232294964836490">QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ. ನಿಮ್ಮ ಫೋನ್‌ನ ಬ್ಲೂಟೂತ್ ಆನ್‌ ಆಗಿದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.
        <ph name="BR" />
        <ph name="BR" />
        <ph name="QUICK_START_DEVICE_DISPLAY_NAME" /> ಆಗಿ ಸಮೀಪದಲ್ಲಿನ ಸಾಧನಗಳಿಗೆ ಗೋಚರಿಸುತ್ತದೆ...</translation>
<translation id="8637688295594795546">ಸಿಸ್ಟಂ ಅಪ್‌ಡೇಟ್‌‌ ಲಭ್ಯವಿದೆ. ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಿದ್ಧಗೊಳ್ಳುತ್ತಿದೆ...</translation>
<translation id="8655972064210167941">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದಿರುವುದರಿಂದ ಸೈನ್ ಇನ್ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ ಅಥವಾ ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8661876674803386786"><ph name="BEGIN_PARAGRAPH1" />ಸ್ಥಳದ ನಿಖರತೆ ಆನ್ ಆಗಿರುವಾಗ, ವೈ-ಫೈ ಆ್ಯಕ್ಸೆಸ್ ಪಾಯಿಂಟ್‌ಗಳು ಹಾಗೂ ಸೆಲ್ಯುಲಾರ್ ನೆಟ್‌ವರ್ಕ್ ಟವರ್‌ಗಳಂತಹ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು ಆ್ಯಕ್ಸಿಲೆರೊಮೀಟರ್ ಮತ್ತು ಗೈರೊಸ್ಕೋಪ್‌ನಂತಹ ಸಾಧನ ಸೆನ್ಸಾರ್ ಡೇಟಾದೊಂದಿಗೆ ಹೆಚ್ಚು ನಿಖರವಾದ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಅಂದಾಜು ಮಾಡಲು ಬಳಸಲಾಗುತ್ತದೆ, ಅವುಗಳನ್ನು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳು ಸ್ಥಳ-ಆಧಾರಿತ ಫೀಚರ್‌ಗಳನ್ನು ಒದಗಿಸಲು ಬಳಸುತ್ತವೆ. ಇದನ್ನು ಮಾಡಲು, ಕ್ರೌಡ್‌ಸೋರ್ಸ್ ಮಾಡಿದ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್ ಸ್ಥಳಗಳಿಗೆ ಕೊಡುಗೆ ನೀಡಲು ನಿಮ್ಮ ಸಮೀಪವಿರುವ ಸಾಧನದ ಸೆನ್ಸರ್‌ಗಳು ಮತ್ತು ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತಾದ ಮಾಹಿತಿಯನ್ನು Google ನಿಯತಕಾಲಿಕವಾಗಿ ಸಂಗ್ರಹಿಸುತ್ತದೆ.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ನಿಮ್ಮನ್ನು ಗುರುತಿಸದೆಯೇ Google ಈ ಮಾಹಿತಿಯನ್ನು ಇವುಗಳಿಗಾಗಿ ಬಳಸುತ್ತದೆ: ಸ್ಥಳದ ನಿಖರತೆ ಮತ್ತು ಸ್ಥಳ ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು; ಹಾಗೂ ಸಾಮಾನ್ಯವಾಗಿ Google ನ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು, ಒದಗಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು. ಬಳಕೆದಾರರ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಲು Google ಮತ್ತು ಥರ್ಡ್ ಪಾರ್ಟಿಗಳ ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ ನಾವು ಈ ಮಾಹಿತಿಯನ್ನು ಪ್ರಾಸೆಸ್ ಮಾಡುತ್ತೇವೆ.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ &gt; ಗೌಪ್ಯತೆ ನಿಯಂತ್ರಣಗಳು &gt; ಸ್ಥಳದ ಆ್ಯಕ್ಸೆಸ್ &gt; ಸುಧಾರಿತ ಸ್ಥಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಅಡಿಯಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಸ್ಥಳದ ನಿಖರತೆಯನ್ನು ಆಫ್ ಮಾಡಬಹುದು. ಸ್ಥಳದ ನಿಖರತೆ ಆಫ್ ಆಗಿದ್ದರೆ, ಯಾವುದೇ ಸ್ಥಳದ ನಿಖರತೆಯ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ. Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗಾಗಿ, ಲಭ್ಯವಿದ್ದಲ್ಲಿ ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಪತ್ತೆಹಚ್ಚಲು IP ವಿಳಾಸವನ್ನು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ. ಇದು Android ಆ್ಯಪ್‌ಗಳು ಮತ್ತು Google Maps ನಂತಹ ಸೇವೆಗಳಿಗೆ ಸ್ಥಳದ ಮಾಹಿತಿ ದೊರೆಯುವಿಕೆ ಮತ್ತು ಅದರ ನಿಖರತೆಯ ಮೇಲೆ ಪ್ರಭಾವ ಬೀರಬಹುದು.<ph name="END_PARAGRAPH3" /></translation>
<translation id="8674903726754070732">ದುರದೃಷ್ಟವಶಾತ್, ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಸರಿಯಾಗಿ ರೂಪುಗೊಳ್ಳದ ಹಾರ್ಡ್‌ವೇರ್ ID ಯ ಜೊತೆಗೆ ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾಗಿದೆ. ಇದು ChromeOS ಇತ್ತೀಚಿನ ಭದ್ರತಾ ಸರಿಪಡಿಸುವಿಕೆಗಳೊಂದಿಗೆ ಅಪ್‌ಡೇಟ್ ಆಗುವುದನ್ನು ತಡೆಗಟ್ಟುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ <ph name="BEGIN_BOLD" />ದುರುದ್ದೇಶಪ್ರೇರಿತ ದಾಳಿಗಳಿಗೆ ಗುರಿಯಾಗಬಹುದು<ph name="END_BOLD" />.</translation>
<translation id="8675704450909805533"><ph name="DEVICE_OS" /> ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದಕ್ಕಾಗಿ ಮಾನ್ಯವಾದ ಗಮ್ಯಸ್ಥಾನವನ್ನು ಹುಡುಕಲು ಇನ್‌ಸ್ಟಾಲರ್‌‌ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="8695139659682234808">ಸೆಟಪ್‌ನ ನಂತರ ಪೋಷಕ ನಿಯಂತ್ರಣಗಳನ್ನು ಸೇರಿಸಿ</translation>
<translation id="8698269656364382265">ಹಿಂದಿನ ಸ್ಕ್ರೀನ್‌ಗೆ ಮರಳಲು, ಎಡ ಬದಿಯಿಂದ ಸ್ವೈಪ್ ಮಾಡಿ.</translation>
<translation id="8718994464069323380">ಟಚ್‌ಸ್ಕ್ರೀನ್ ಪತ್ತೆಯಾಗಿದೆ</translation>
<translation id="8725066075913043281">ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="8726206820263995930">ಸರ್ವರ್‌ನಿಂದ ನೀತಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪಡೆಯುತ್ತಿರುವಾಗ ದೋಷ: <ph name="CLIENT_ERROR" />.</translation>
<translation id="8730621377337864115">ಮುಗಿದಿದೆ</translation>
<translation id="8740086188450289493">Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ</translation>
<translation id="8740247629089392745">ಈ Chromebook ಅನ್ನು <ph name="SUPERVISED_USER_NAME" /> ಅವರಿಗೆ ಹಸ್ತಾಂತರಿಸಬಹುದು. ಸೆಟಪ್ ಬಹುತೇಕ ಪೂರ್ಣಗೊಂಡಿದೆ, ಇದು ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಮಾಡುವ ಸಮಯ.</translation>
<translation id="8759753423332885148">ಮತ್ತಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="8762886931014513155">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಅಪ್‌ಡೇಟ್‌ ಒಂದರ ಅಗತ್ಯವಿದೆ</translation>
<translation id="8777628254805677039">ಮೂಲ ಪಾಸ್‌ವರ್ಡ್</translation>
<translation id="877985182522063539">A4</translation>
<translation id="8783834180813871000">ಬ್ಲೂಟೂತ್ ಜೋಡಣೆ ಕೋಡ್‌ ಟೈಪ್‌ ಮಾಡಿ ನಂತರ Return ಅಥವಾ Enter ಒತ್ತಿ.</translation>
<translation id="8794548468611058947">ಸೈನ್ ಇನ್ ಮಾಡುವುದಕ್ಕಾಗಿ ನಿಮ್ಮ Google ಖಾತೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಮೂದಿಸುವ ಬದಲು, ನೀವು ಈ <ph name="DEVICE_TYPE" /> ಗಾಗಿ ಪಿನ್‌‌ ಅನ್ನು ರಚಿಸಬಹುದು</translation>
<translation id="8830779999439981481">ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಅನ್ವಯಿಸಲು ಮರುಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="8830796635868321089">ಪ್ರಸ್ತುತ ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಅಪ್‌ಡೇಟ್‌‌ನ ಪರಿಶೀಲನೆ ವಿಫಲಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ <ph name="PROXY_SETTINGS_LINK_START" />ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="PROXY_SETTINGS_LINK_END" /> ಅಡ್ಜಸ್ಟ್ ಮಾಡಿ.</translation>
<translation id="8855977033756560989">ಈ Chromebook ಎಂಟರ್‌ಪ್ರೈಸ್ ಸಾಧನ ಮತ್ತು Chrome ಎಂಟರ್‌ಪ್ರೈಸ್ ಅಪ್‌ಗ್ರೇಡ್ ಎರಡೂ ಸಂಯೋಜಿತವಾಗಿವೆ. ಎಂಟರ್‌ಪ್ರೈಸ್ ಸಾಮರ್ಥ್ಯಗಳ ಪ್ರಯೋಜನವನ್ನು ಪಡೆದುಕೊಳ್ಳಲು, Google ನಿರ್ವಾಹಕ ಖಾತೆಯನ್ನು ಬಳಸಿಕೊಂಡು ಈ ಸಾಧನವನ್ನು ನೋಂದಾಯಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="885746075120788020">ನಿಮ್ಮ Google ಖಾತೆಯ ಮೂಲಕ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, ನಿಮ್ಮ ಉಳಿಸಲಾದ ಆದ್ಯತೆಗಳು ಮತ್ತು ಚಟುವಟಿಕೆ ಯಾವುದೇ ChromeOS ಸಾಧನದಲ್ಲಿ ಸಿದ್ಧವಾಗಿರುತ್ತವೆ. ಏನನ್ನು ಸಿಂಕ್ ಮಾಡಬೇಕು ಎಂಬುದನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆರಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="8868333925931032127">ಡೆಮೋ ಮೋಡ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ</translation>
<translation id="8875221558267407626">ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸಾರಾಂಶಗೊಳಿಸಿ, ಸಂಕೀರ್ಣ ಭಾಷೆಯನ್ನು ಸರಳಗೊಳಿಸಿ ಅಥವಾ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ</translation>
<translation id="8907701755790961703">ದಯವಿಟ್ಟು ದೇಶವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8913163265790894442">ನಿಮ್ಮ ಫೋನ್‌ ಮೂಲಕ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಸುಲಭವಾಗಿ ಸೆಟಪ್‌ ಮಾಡಿ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ನಮೂದಿಸದೆಯೇ ನಿಮ್ಮ ವೈ-ಫೈ ಮತ್ತು Google ಖಾತೆಯನ್ನು ನೀವು ಸೇರಿಸಬಹುದು.
        <ph name="BR" />
    <ph name="BR" />
     <ph name="DEVICE_TYPE" /> ಆಗಿ ಗೋಚರಿಸುತ್ತದೆ...</translation>
<translation id="8934732568177537184">ಮುಂದುವರಿಸು</translation>
<translation id="8946359700442089734">ದೋಷ ನಿವಾರಣೆಯಾಗುತ್ತಿರುವ ವೈಶಿಷ್ಟ್ಯಗಳು ಈ ಸಾಧನದಲ್ಲಿ <ph name="IDS_SHORT_PRODUCT_NAME" /> ಇನ್ನೂ ಸಂಫೂರ್ಣವಾಗಿ ಸಕ್ರಿಯವಾಗಿಲ್ಲ.</translation>
<translation id="8965037249707889821">ಹಳೆಯ ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ</translation>
<translation id="8968906873893164556">ಸೆಟಪ್‌ಗಾಗಿ ಬಳಸಲು ಖಾತೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8973596347849323817">ನಿಮ್ಮ ಅಗತ್ಯಗಳಿಗೆ ಸರಿಹೊಂದುವಂತೆ ಈ ಸಾಧನವನ್ನು ನೀವು ಕಸ್ಟಮೈಸ್ ಮಾಡಬಹುದು. ಈ ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಫಿಚರ್‌ಗಳನ್ನು ನಂತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="8975396729541388937">ನೀವು ಸ್ವೀಕರಿಸುವ ಇಮೇಲ್‌ಗಳಲ್ಲಿರುವ ಲಿಂಕ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡುವ ಮೂಲಕ ಯಾವಾಗ ಬೇಕಾದರೂ ಅನ್‌ಸಬ್‌ಸ್ಕ್ರೈಬ್ ಮಾಡಿ.</translation>
<translation id="8987305927843254629">ಪ್ರತಿಯೊಬ್ಬ ವ್ಯಕ್ತಿಯು ತಮ್ಮ ಅನುಭವವನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಬಹುದು ಮತ್ತು ಡೇಟಾವನ್ನು ಖಾಸಗಿಯಾಗಿರಿಸಬಹುದು.</translation>
<translation id="8993059306046735527">ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನೀವು ಮರೆತರೆ, ನಿಮ್ಮ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ನೀವು ಇಗಲೂ ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು. ನಿಮ್ಮ Google ಖಾತೆಗೆ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಬೇಕಾಗುತ್ತದೆ ಅಥವಾ ಖಾತೆ ಮರುಪ್ರಾಪ್ತಿಯನ್ನು ಬಳಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="9018218886431812662">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಿಕೆಯು ಪೂರ್ಣಗೊಂಡಿದೆ</translation>
<translation id="9033765790910064284">ಹೇಗಾದರೂ ಮುಂದುವರಿಸಿ</translation>
<translation id="903480517321259405">ಪುನಃ ಪಿನ್ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ</translation>
<translation id="9040473193163777637">ChromeVox, ChromeOS ಗಾಗಿ ಅಂತರ್ನಿರ್ಮಿತ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನೀವು ಬಯಸುವಿರಾ? ಹಾಗಿದ್ದರೆ, ಐದು ಸೆಕೆಂಡ್‌ಗಳ ಕಾಲ ಎರಡೂ ವಾಲ್ಯೂಮ್ ಕೀಗಳನ್ನು ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ.</translation>
<translation id="9068298336633421551">ಸ್ಥಳವನ್ನು ತಿಳಿದುಕೊಳ್ಳಲು ಅನುಮತಿ ಇರುವ Android ಆ್ಯಪ್‌‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ಈ ಸಾಧನದ ಸ್ಥಳವನ್ನು ಬಳಸಲು ಅನುಮತಿ ನೀಡಿ. Google, ಸ್ಥಳ ಡೇಟಾವನ್ನು ನಿಯಮಿತವಾಗಿ ಸಂಗ್ರಹಿಸಬಹುದು ಮತ್ತು ಸ್ಥಳದ ನಿಖರತೆ ಹಾಗೂ ಸ್ಥಳ-ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು ಈ ಡೇಟಾವನ್ನು ಅನಾಮಧೇಯವಾಗಿ ಬಳಸಬಹುದು.</translation>
<translation id="9074836595010225693">USB ಮೌಸ್ ಸಂಪರ್ಕಗೊಂಡಿದೆ</translation>
<translation id="9076523132036239772">ಕ್ಷಮಿಸಿ, ನಿಮ್ಮ ಇಮೇಲ್ ಅಥವಾ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲಾಗಲಿಲ್ಲ. ಮೊದಲು ಯಾವುದಾದರೂ ನೆಟ್‌ವರ್ಕ್‌ ಜೊತೆ ಸಂಪರ್ಕ ಸಾಧಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="9089959054554410481">ಟಚ್‌ಪ್ಯಾಡ್ ಸ್ಕ್ರೋಲ್ ಮಾಡುವ ದಿಕ್ಕನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="9158715103698450907">ಓಹ್! ದೃಢೀಕರಣ ಸಮಯದಲ್ಲಿ ನೆಟ್‌ವರ್ಕ್ ಸಂವಹನ ಸಮಸ್ಯೆಯು ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ಸಂರ್ಪಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="9186963452600581158">ಮಗುವಿನ Google ಖಾತೆಯ ಮೂಲಕ ಸೈನ್-ಇನ್ ಮಾಡಿ</translation>
<translation id="919686179725692564">ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡುವ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="9214520840402538427">ಓಹ್! ಇನ್‌ಸ್ಟಾಲೇಶನ್-ಟೈಮ್-ಆ್ಯಟ್ರಿಬ್ಯೂಷನ್ ಅವಧಿ ಮುಗಿದಿದೆ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಬೆಂಬಲ ಪ್ರತಿನಿಧಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="9217002308921247002"><ph name="BEGIN_PARAGRAPH1" /><ph name="DEVICE_TYPE" /> ಗಾಗಿ ಎಕ್ಸ್‌ಕ್ಲೂಸಿವ್.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ಜನರೇಟಿವ್ AI ಪ್ರಾಯೋಗಿಕವಾಗಿದೆ, ಅಭಿವೃದ್ಧಿಯ ಆರಂಭಿಕ ಹಂತದಲ್ಲಿದೆ ಹಾಗೂ ಪ್ರಸ್ತುತ ಸೀಮಿತ ಲಭ್ಯತೆಯನ್ನು ಹೊಂದಿದೆ.<ph name="END_PARAGRAPH2" /></translation>
<translation id="936479314588646618">ನಿಮ್ಮ ಫೋನ್‌ ಮೂಲಕ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಸುಲಭವಾಗಿ ಸೆಟಪ್‌ ಮಾಡಿ. ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಮ್ಯಾನುಯಲ್ ಆಗಿ ನಮೂದಿಸದೆಯೇ ನಿಮ್ಮ Google ಖಾತೆಯನ್ನು ನೀವು ಸೇರಿಸಬಹುದು.
        <ph name="BR" />
    <ph name="BR" />
     <ph name="DEVICE_TYPE" /> ಆಗಿ ಗೋಚರಿಸುತ್ತದೆ...</translation>
<translation id="945522503751344254">ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="951991426597076286">ನಿರಾಕರಿಸಿ</translation>
<translation id="954749761428814584">ಭಾಷೆಗಳು ಮತ್ತು ಇನ್‌ಪುಟ್ ವಿಧಾನ</translation>
<translation id="960987915827980018">ಸುಮಾರು 1 ಗಂಟೆ ಉಳಿದಿದೆ</translation>
<translation id="995420352808264005">ಸಾಧನ ನೋಂದಣಿ ಪ್ರಕಾರವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
</translationbundle>