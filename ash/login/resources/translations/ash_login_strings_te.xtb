<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1005333234656240382">ADB డీబగ్గింగ్‌ను ఎనేబుల్ చేయాలా?</translation>
<translation id="1053898984916097744">కొత్తగా ఏదైనా ప్రారంభించండి లేదా ఫ్లోలో సహాయం పొందండి.</translation>
<translation id="1061130374843955397">మీ <ph name="DEVICE_TYPE" />కు స్వాగతం</translation>
<translation id="1069778954840159202">Android ఫోన్ నుండి ఆటోమేటిక్‌గా ఖాతాను పొందండి</translation>
<translation id="1076766328672150609">డివైజ్‌ను అన్‌లాక్ చేయడానికి మీ చిన్నారి PINను ఉపయోగించవచ్చు.</translation>
<translation id="1091767800771861448">దాటవేయడానికి ESCAPEను నొక్కండి (అనధికార బిల్డ్‌లకు మాత్రమే)</translation>
<translation id="1097658378307015415">సైన్ ఇన్ చేయడానికి ముందుగా, దయచేసి <ph name="NETWORK_ID" /> నెట్‌వర్క్‌ను యాక్టివేట్ చేయడానికి గెస్ట్ లాగా ప్రవేశించండి</translation>
<translation id="1111932478203988717">మీ చిన్నారి తమ పరికరానికి సైన్ ఇన్ చేయడానికి ఈ PINను ఉపయోగించవచ్చు</translation>
<translation id="1122587596907914265">ప్రత్యేకమైన వాల్‌పేపర్‌లను రూపొందించుకోండి</translation>
<translation id="1131201598497838573">మీ చిన్నారి PIN అప్‌డేట్ చేయబడింది</translation>
<translation id="1147322039136785890">ఇప్పుడు దీనిని <ph name="SUPERVISED_USER_NAME" /> ఉపయోగించవచ్చు</translation>
<translation id="1148669835763563782">మీరు మెరుగైన సెక్యూరిటీ, సరికొత్త Chromebook ఫీచర్‌ల కోసం తాజా సాఫ్ట్‌వేర్ అప్‌డేట్‌ను పొందుతున్నారు. ఈ అప్‌డేట్‌లో మీ Chromebookను ఎటువంటి అంతరాయాలు లేకుండా స్మూత్‌గా ప్రారంభించడంలో సహాయపడటానికి మెరుగైన సెటప్ ఉంది.</translation>
<translation id="1176864681932214421">AI సహాయంతో ఇమేజ్‌లను క్రియేట్ చేయండి</translation>
<translation id="1177073277575830464">Android త్వరిత సెటప్ పూర్తయింది. మీ <ph name="DEVICE_TYPE" />లో సెటప్ చేయడాన్ని కొనసాగించండి.</translation>
<translation id="1179902906564467236">మీ ఫోన్‌లోని సూచనలను ఫాలో అవ్వండి లేదా కెమెరా యాప్‌ను ఉపయోగించండి</translation>
<translation id="1185924365081634987">మీరు ఈ నెట్‌వర్క్ ఎర్ర‌ర్‌ను పరిష్కరించడానికి <ph name="GUEST_SIGNIN_LINK_START" />అతిథిగా బ్రౌజ్ చేయడాన్ని<ph name="GUEST_SIGNIN_LINK_END" /> కూడా ప్రయత్నించవచ్చు.</translation>
<translation id="1191353342579061195">మీ అవసరాలకు తగిన రూపాన్ని ఎంచుకోండి. మీ రూపాన్ని, వాల్‌పేపర్‌ను, స్క్రీన్ సేవర్‌ను, మరిన్నింటిని మార్చడానికి, డెస్క్‌టాప్‌పై కేవలం కుడి క్లిక్ చేయండి.</translation>
<translation id="1201402288615127009">తర్వాత</translation>
<translation id="1217114730239853757">మీరు ChromeOS Flexకి బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను యాక్టివేట్ చేయాలనుకుంటున్నారా? అలా చేయాలనుకుంటే, స్పేస్ బార్‌ను నొక్కండి.</translation>
<translation id="1222835797152767346">సైన్ ఇన్ చేయడాన్ని సులభతరం చేయడానికి పాస్‌వర్డ్‌ను సెట్ చేయండి</translation>
<translation id="1231426483209637778">తర్వాతిసారి మీరు <ph name="DEVICE_TYPE" />‌ను ఉపయోగించినప్పుడు మేము మిమ్మల్ని గుర్తుంచుకుంటాము</translation>
<translation id="1243002225871118300">డిస్‌ప్లే, టెక్స్ట్ సైజ్‌ను మార్చండి</translation>
<translation id="1256588359404100567">మీ మునుపటి పరికరం నుండి సింక్ చేయబడిన సెట్టింగ్.</translation>
<translation id="1272978324304772054">ఈ యూజర్ ఖాతా డివైజ్ ఎన్‌రోల్ అయిన డొమైన్‌కు చెందినది కాదు. మీరు వేరొక డొమైన్‌కు ఎన్‌రోల్ చేయాలనుకుంటే మీరు ముందుగా డివైజ్‌ను రికవరీ చేయాలి.</translation>
<translation id="1293556467332435079">Files</translation>
<translation id="1307559529304613120">అయ్యో!  సిస్టమ్ ఈ పరికరం కోసం దీర్ఘకాల API యాక్సెస్‌ టోకెన్‌ను స్టోరేజ్‌ చేయడంలో విఫలమైంది.</translation>
<translation id="1335929031622236846">మీ డివైజ్‌ను ఎన్‌రోల్ చేయండి</translation>
<translation id="1346669614038013595"><ph name="BEGIN_H3" />డీబగ్గింగ్ ఫీచర్‌లు<ph name="END_H3" />
      <ph name="BR" />
      మీరు మీ డివైజ్‌లో అనుకూల కోడ్‌ను ఇన్‌స్టాల్ చేసి, టెస్ట్ చేయడానికి మీ ChromeOS డివైజ్‌లో డీబగ్గింగ్ ఫీచర్‌లను ఎనేబుల్ చేయవచ్చు. ఇది వీటిని చేయడానికి మిమ్మల్ని అనుమతిస్తుంది:<ph name="BR" />
      <ph name="BEGIN_LIST" />
        <ph name="LIST_ITEM" />rootfs వెరిఫికేషన్‌ను తీసివేయడానికి, తద్వారా మీరు OS ఫైల్స్‌ను మాడిఫై చేయవచ్చు
        <ph name="LIST_ITEM" />స్టాండర్డ్ టెస్ట్ 'కీ'లను ఉపయోగించి డివైజ్‌కు SSH యాక్సెస్‌ను ఎనేబుల్ చేయడానికి, తద్వారా మీరు డివైజ్‌ను యాక్సెస్ చేయడానికి <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> వంటి టూల్స్‌ను ఉపయోగించవచ్చు
        <ph name="LIST_ITEM" />USB నుండి బూట్ చేయడాన్ని ఎనేబుల్ చేయడానికి, తద్వారా మీరు USB డ్రైవర్ నుండి OS ఇమేజ్‌ను ఇన్‌స్టాల్ చేయవచ్చు
        <ph name="LIST_ITEM" />డెవలపర్ అలాగే సిస్టమ్ రూట్ లాగిన్ పాస్‌వర్డ్ రెండింటినీ అనుకూల విలువకు సెట్ చేయడానికి, తద్వారా మీరు డివైజ్‌లోకి మాన్యువల్‌గా SSH చేయవచ్చు
      <ph name="END_LIST" />
      <ph name="BR" />
      ఎనేబుల్ చేసిన తర్వాత, ఎంటర్‌ప్రయిజ్ ద్వారా మేనేజ్ అయ్యే డివైజ్‌లో డేటాను పవర్‌వాష్ చేసిన తర్వాత లేదా పూర్తిగా తొలగించిన తర్వాత కూడా చాలా వరకు డీబగ్గింగ్ ఫీచర్‌లు ఎనేబుల్ అయ్యి ఉంటాయి. అన్ని డీబగ్గింగ్ ఫీచర్‌లను పూర్తిగా డిజేబుల్ చేయడానికి, ChromeOS రికవరీ ప్రాసెస్‌ను పూర్తి చేయండి (https://support.google.com/chromebook/answer/1080595).
      <ph name="BR" />
      <ph name="BR" />
      డీబగ్గింగ్ ఫీచర్‌ల గురించి మరింత సమాచారం కోసం ఇక్కడ చూడండి:<ph name="BR" />
      https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
      <ph name="BR" />
      <ph name="BR" />
      <ph name="BEGIN_BOLD" />గమనిక:<ph name="END_BOLD" />  ప్రాసెస్ సమయంలో సిస్టమ్ రీబూట్ అవుతుంది.</translation>
<translation id="1347625331607114917">మీ Android ఫోన్‌లో కోడ్‌ను వెరిఫై చేయండి</translation>
<translation id="1347975661240122359">బ్యాటరీ <ph name="BATTERY_LEVEL" />% ఉన్నప్పుడు అప్‌డేట్ ప్రారంభమవుతుంది.</translation>
<translation id="1353275871123211385">యాప్ ఆమోదం, పరికర వినియోగ వ్యవధిపై పరిమితుల వంటి తల్లిదండ్రుల కంట్రోల్స్‌ను ఉపయోగించడానికి, చిన్నారి వద్ద తల్లి/తండ్రి ద్వారా మేనేజ్ చేయబడే Google ఖాతా ఉండాలి. Google Classroom వంటి టూల్స్‌కు స్కూల్ ఖాతాను తర్వాత జోడించవచ్చు.</translation>
<translation id="1375557162880614858">మీరు ChromeOS Flexకి బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను యాక్టివేట్ చేయాలనుకుంటున్నారా?</translation>
<translation id="1375938286942050085">సెటప్ పూర్తయింది! తర్వాత, వీడియో గేమ్‌ల కోసం మీ డివైజ్‌ను సిద్ధం చేయండి</translation>
<translation id="1377600615067678409">ప్రస్తుతానికి దాటవేయి</translation>
<translation id="1399261165075500043">Google Play సర్వీస్ నియమాలను లోడ్ చేయడం సాధ్యం కాలేదు</translation>
<translation id="1400243387594338234">మీ పరికరానికి సైన్ ఇన్ చేయడానికి మీరు ఈ PINను ఉపయోగించవచ్చు</translation>
<translation id="1406500794671479665">ధృవీకరిస్తోంది...</translation>
<translation id="1407069428457324124">ముదురు రూపం</translation>
<translation id="1417497355604638350">సమస్య విశ్లేషణ, వినియోగ డేటాను పంపండి.</translation>
<translation id="1418882096915998312">Enterpriseను ఎన్‌రోల్ చేయడం ప్రోగ్రెస్‌లో ఉంది</translation>
<translation id="1426410128494586442">అవును</translation>
<translation id="1427269577154060167">దేశం</translation>
<translation id="1440090277117135316">స్కూల్ ఎన్‌రోల్‌మెంట్ పూర్తయింది</translation>
<translation id="1473927070149284123">మళ్లీ ట్రై చేయండి లేదా మాన్యువల్‌గా నెట్‌వర్క్‌కు కనెక్ట్ చేయండి</translation>
<translation id="1503556098270577657">మీరు మీ Android ఫోన్‌ను ఉపయోగించి <ph name="USER_EMAIL" />కి సైన్ ఇన్ చేశారు</translation>
<translation id="1510238584712386396">లాంచర్</translation>
<translation id="1521442365706402292">సర్టిఫికెట్‌లను మేనేజ్ చేయండి</translation>
<translation id="15373452373711364">పెద్ద మౌస్ కర్సర్</translation>
<translation id="1540605929960647700">డెమో మోడ్‌ని ప్రారంభించండి</translation>
<translation id="1572876035008611720">మీ ఈమెయిల్‌ను నమోదు చేయండి</translation>
<translation id="1588438908519853928">సాధారణ</translation>
<translation id="1620510694547887537">కెమెరా</translation>
<translation id="1636212173818785548">సరే</translation>
<translation id="1642494467033190216">ఇతర డీబగ్గింగ్ ఫీచ‌ర్‌లను ప్రారంభించడానికి ముందు rootfs రక్షణను తీసివేసి, పునఃప్రారంభించాలి.</translation>
<translation id="1646045728251578877">సాఫ్ట్‌వేర్ అప్‌డేట్ అందుబాటులో ఉంది</translation>
<translation id="1650801028905250434">నా డ్రైవ్‌లోని మీ ఫైల్స్ ఆటోమేటిక్‌గా మీ Chromebookకు సింక్ అవుతాయి, కాబట్టి మీరు ఇంటర్నెట్ కనెక్షన్ లేకుండానే వాటిని యాక్సెస్ చేయగలరు. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లు &gt; ఫైల్స్‌లో మార్చవచ్చు.</translation>
<translation id="1668435968811469751">మాన్యువల్‌గా ఎన్‌రోల్ చేయండి</translation>
<translation id="1678919064276516737">మీరు ఎంటర్ చేసిన ఈమెయిల్, PIN మ్యాచ్ అవ్వడం లేదు</translation>
<translation id="1692115862433274081">మరో ఖాతాను ఉపయోగించండి</translation>
<translation id="1695487653372841667">Googleతో ఏ డేటాను షేర్ చేయాలో మీరు కంట్రోల్ చేయవచ్చు. మీరు దీనిని సెట్టింగ్‌లలో ఎప్పుడైనా మార్చవచ్చు.</translation>
<translation id="169675691788639886">పరికరానికి SSH సర్వర్ కాన్ఫిగ‌ర్ చేయబడింది. గోప్యమైన ఖాతాలతో సైన్ ఇన్ చేయవద్దు.</translation>
<translation id="1700517974991662022">సందర్శించబడింది</translation>
<translation id="1730666151302379551">పాత పాస్‌వర్డ్‌ను మర్చిపోయారా</translation>
<translation id="1741314857973421784">కొనసాగించండి</translation>
<translation id="1749645492410897998">సాఫ్ట్‌వేర్ ఇన్‌స్టాల్ అవుతోంది</translation>
<translation id="177053719077591686">Google Driveకు Android యాప్‌లను బ్యాకప్ చేయండి.</translation>
<translation id="1798832846931769717">Meet కోసం Google Beam</translation>
<translation id="1806335016774576568">తెరిచి ఉన్న మరొక యాప్‌కు మారండి</translation>
<translation id="1826192255355608658">మీ Chrome బ్రౌజర్ బుక్‌మార్క్‌లు, పాస్‌వర్డ్‌‌లు, హిస్టరీ, ఇంకా మరిన్నింటిని సింక్ చేయండి</translation>
<translation id="1826657447823925402">రివర్స్ స్క్రోలింగ్ డిజేబుల్ చేయబడింది</translation>
<translation id="1831848493690504725">కనెక్ట్ చేయబడిన నెట్‌వర్క్ ద్వారా Googleను చేరుకోవడం మాకు సాధ్యపడలేదు. వేరే నెట్‌వర్క్‌ను ఎంచుకోవడానికి ట్రై చేయండి లేదా మీ నెట్‌వర్క్ సెట్టింగ్‌లను లేదా ప్రాక్సీ సెట్టింగ్‌లను (మీరు ప్రాక్సీని ఉపయోగిస్తున్నట్లయితే) చెక్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="1842766183094193446">మీరు ఖచ్చితంగా డెమో మోడ్‌ని ప్రారంభించాలనుకుంటున్నారా?</translation>
<translation id="1845060436536902492">ChromeOS Flexలో, ChromeVoxలో ఉండే స్క్రీన్ రీడర్‌ను, ప్రధానంగా అంధత్వం ఉన్న వారు, లేదా దృష్టి లోపం ఉన్న వారు, స్క్రీన్ మీద డిస్‌ప్లే అయ్యే టెక్స్ట్‌ను చదవడానికి ఉపయోగిస్తారు, ఇందు కోసం స్పీచ్ సింథసైజర్‌ను లేదా బ్రెయిలీ డిస్‌ప్లేను ఉపయోగించడం జరుగుతుంది. ChromeVoxను ఆన్ చేయడానికి స్పేస్ బార్‌ను నొక్కండి. ChromeVoxను యాక్టివేట్ చేసినప్పుడు, మీకు ఒక క్విక్ టూర్ అందించబడుతుంది.</translation>
<translation id="185766080319917408">లాంచర్ కీ ఎడమ alt కీకి ఎడమవైపు ఉంటుంది</translation>
<translation id="1868617395637139709">Android యాప్‌లు, సర్వీస్‌లకు లొకేషన్‌ను ఉపయోగించండి.</translation>
<translation id="1877377730633446520">ఇది సుమారు <ph name="REQUIRED_SPACE" /> స్పేస్‌ను ఉపయోగిస్తుంది. ప్రస్తుతం మీ వద్ద <ph name="FREE_SPACE" /> స్పేస్ ఖాళీగా ఉంది.</translation>
<translation id="1878155070920054810">అప్‌డేట్ పూర్తయ్యే లోపు మీ Chromebook పవర్ అయిపోయేటట్లు కనిపిస్తోంది. అంతరాయాన్ని నివారించడానికి ఇది సరిగ్గా ఛార్జింగ్ అవుతోందని నిర్ధారించుకోండి.</translation>
<translation id="189035593835762169">నియమాలు, షరతులు</translation>
<translation id="189358972401248634">ఇతర భాషలు</translation>
<translation id="1915734383465415025">స్టోర్ నంబర్</translation>
<translation id="1919096511823372013">లింక్‌లను, ఎమోజీలను, ఇంకా మరిన్నింటిని ఇన్‌సర్ట్ చేయండి. Googleకు చెందిన AI టెక్నాలజీలతో మీరు రాయడంలో, ఇమేజ్‌లను క్రియేట్ చేయడంలో సహాయాన్ని పొందవచ్చు.</translation>
<translation id="1922496389170590548">చిన్నారికి చెందిన స్కూల్ ఖాతా</translation>
<translation id="1931410639376954712"><ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేస్తోంది</translation>
<translation id="1944528062465413897">బ్లూటూత్ పెయిరింగ్ కోడ్:</translation>
<translation id="1987574314042117472">జనాదరణ పొందిన యాప్‌లను ఎంచుకుని, ఇన్‌స్టాల్ చేయండి</translation>
<translation id="1991829061375381344">ఈ Google Meet హార్డ్‌వేర్ డివైజ్‌ను ఎన్‌రోల్ చేయడానికి మీకు తగిన లైసెన్స్‌లు లేవు. మరిన్ని కొనుగోలు చేయడానికి దయచేసి మీ రీసెల్లర్‌ను సంప్రదించండి. మీకు ఈ మెసేజ్ పొరపాటున వచ్చిందని మీరు భావిస్తే, దయచేసి మీ రీసెల్లర్‌ను సంప్రదించండి.</translation>
<translation id="200928901437634269">మీ చిన్నారికి చెందిన Google ఖాతాను లేదా స్కూల్ ఖాతాను ఉపయోగించండి. మీరు తల్లిదండ్రుల కంట్రోల్స్‌ను కూడా సెట్ చేయవచ్చు.</translation>
<translation id="2013550551806600826">దీనిని ట్రై చేయండి. ఈ సెట్టింగ్‌ను ఆన్ లేదా ఆఫ్ చేసి, ఆపై టెస్ట్ ఏరియాలో మీ టచ్‌ప్యాడ్‌ను రెండు వేళ్లతో స్క్రోల్ చేయండి. దీనిని మీరు తర్వాత కూడా సెట్టింగ్‌లు &gt; పరికరం &gt; మౌస్, టచ్‌ప్యాడ్ అనే ఆప్షన్‌లో కనుగొనవచ్చు.</translation>
<translation id="2016574333161572915">మీ Google Meet హార్డ్‌వేర్ సెటప్ చేయడానికి సిద్ధంగా ఉంది</translation>
<translation id="2018189721942291407">ఎన్‌రోల్ అవ్వాలో లేదో మీకు అర్థం కావడం లేదా?</translation>
<translation id="2040460856718599782">అయ్యో!  మిమ్మల్ని ప్రామాణీకరించడానికి ప్రయత్నిస్తున్నప్పుడు ఏదో తప్పు జరిగింది. దయచేసి మీ సైన్-ఇన్ ప్రమాణాలను ఒకటికి రెండుసార్లు చెక్ చేసుకుని మళ్లీ ట్రై చేయండి.</translation>
<translation id="2052572566310583903">మీ ఇతర పరికరాలలో ఇన్‌స్టాల్ చేయబడింది</translation>
<translation id="2088092308059522196">మీరు <ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేసిన తర్వాత మాత్రమే ఎన్‌రోల్‌మెంట్ సపోర్ట్ చేస్తుంది.</translation>
<translation id="208928984520943006">ఎప్పుడైనా హోమ్ స్క్రీన్‌కు వెళ్ళడానికి, కింది నుండి పైకి స్వైప్ చేయండి.</translation>
<translation id="2090165459409185032">మీ ఖాతా సమాచారాన్ని పునరుద్ధరించడానికి, దీనికి వెళ్లండి: google.com/accounts/recovery</translation>
<translation id="2133775869826239001">సెటప్ చేయడానికి మరిన్ని ఫీచర్‌లను ఎంచుకోండి</translation>
<translation id="2135456203358955318">డాక్ చేయబడిన మాగ్నిఫైయర్</translation>
<translation id="2157779167749714207">మీ <ph name="DEVICE_TYPE" />‌తో పాటు Gemini వస్తుంది</translation>
<translation id="2163470535490402084">మీ <ph name="DEVICE_TYPE" />కు సైన్ ఇన్ చేయడానికి దయచేసి ఇంటర్నెట్‌కు కనెక్ట్ చేయండి.</translation>
<translation id="2173801458090845390">ఈ పరికరానికి రిక్వెస్ట్‌ IDని జోడించండి</translation>
<translation id="2178585470774851578">మీరు ChromeOS Flex డీబగ్గింగ్ ఫీచర్‌లను ఎనేబుల్ చేస్తున్నారు, ఇది sshd daemonను సెటప్ చేస్తుంది అలాగే USB డిస్క్‌ల నుండి బూట్ చేయడాన్ని ఎనేబుల్ చేస్తుంది.</translation>
<translation id="2183570493397356669">కొనసాగించండి బటన్ డిజేబుల్ చేయబడింది</translation>
<translation id="2210462644007531147">ఇన్‌స్టాలేషన్‌ను పూర్తి చేయడం సాధ్యపడలేదు</translation>
<translation id="221872881068107022">రివర్స్ స్క్రోలింగ్</translation>
<translation id="2219081237089444028">సైన్ ఇన్ చేయడాన్ని సులభతరం చేయడానికి <ph name="DEVICE_TYPE" /> పాస్‌వర్డ్‌ను సెట్ చేయండి</translation>
<translation id="222115440608612541">సూర్యోదయ సమయంలో, సూర్యాస్తమయం సమయంలో రూపాలను మార్చండి</translation>
<translation id="2229161054156947610">1 గంట పైగా మిగిలి ఉంది</translation>
<translation id="2246129643805925002">మీకు తాజా ఫీచర్‌లు, భద్రతా మెరుగుదలలను అందించడానికి మీ <ph name="DEVICE_TYPE" /> బ్యాక్‌గ్రౌండ్‌లో ఆటోమేటిక్‌గా అప్‌డేట్ అవుతుంది. మీరు సెట్టింగ్‌లలో అప్‌డేట్ ప్రాధాన్యతలను రివ్యూ చేయవచ్చు.</translation>
<translation id="2274840746523584236">మీ Chromebookను ఛార్జ్ చేయండి</translation>
<translation id="2296022312651137376"><ph name="DOMAIN_NAME" />కి <ph name="EMAIL" />కు సైన్ ఇన్ చేసేటప్పుడు పరికరం ఆన్‌లో ఉండాలి</translation>
<translation id="2317842250900878657"><ph name="PROGRESS_PERCENT" />% పూర్తయింది</translation>
<translation id="2319072477089403627">మీ Android ఫోన్‌కు కనెక్ట్ అవుతోంది...</translation>
<translation id="2328137272841210255">మీ PINను రీసెట్ చేయండి</translation>
<translation id="2342180549977909852">ఈ డివైజ్‌ను అన్‌లాక్ చేయడానికి మీ చిన్నారి పాస్‌వర్డ్‌కు బదులుగా నంబర్ (PIN)ను ఉపయోగించవచ్చు. PINను సెట్ చేయడానికి, సెట్టింగ్‌లకు వెళ్లండి.</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="2387052489799050037">హోమ్‌కు వెళ్లండి</translation>
<translation id="2395616325548404795">మీ <ph name="DEVICE_TYPE" /> ఎంటర్‌ప్రైజ్ నిర్వహణ కోసం విజయవంతంగా నమోదు చేయబడింది, కానీ దాని లక్షణ మరియు స్థాన సమాచారాన్ని పంపడంలో విఫలమైంది. దయచేసి ఈ పరికరం కోసం ఈ సమాచారాన్ని మీ నిర్వాహక కన్సోల్ నుండి మాన్యువల్‌గా నమోదు చేయండి.</translation>
<translation id="2408955596600435184">మీ PINని నమోదు చేయండి</translation>
<translation id="2418307627282545839">ప్రకాశవంతంగా, చూడచక్కని రంగులతో అందంగా ఉంచుకోండి</translation>
<translation id="243179355394256322">మీ సంస్థ అధికారిక యూజర్‌లకు మాత్రమే పరికర నమోదును పరిమితం చేస్తుంది. ఈ యూజర్‌కు పరికరాలను ఎన్‌రోల్ చేసే అధికారం లేదు. దయచేసి అడ్మిన్ కన్సోల్ యూజర్‌ల విభాగంలోని యూజర్ "Google Meet హార్డ్‌వేర్‌ను ఎన్‌రోల్ చేయి" అడ్మినిస్ట్రేటర్ ప్రత్యేక హక్కును కలిగి ఉన్నారని నిర్ధారించుకోండి.</translation>
<translation id="2439152382014731627"><ph name="DEVICE_TYPE" /> పాస్‌వర్డ్‌ను రీసెట్ చేయండి</translation>
<translation id="2450223707519584812">Google API కీలు లేనందున మీరు వినియోగదారులను జోడించలేరు. వివరాల కోసం <ph name="DETAILS_URL" /> చూడండి.</translation>
<translation id="24786041351753425">డేటా రికవరీ సర్వీస్‌ను ఎనేబుల్ చేయండి.</translation>
<translation id="2485681265915754872">Google Play సర్వీస్ నియమాలు</translation>
<translation id="248676429071089168">పైకి స్వైప్ చేసి, పేజీని కిందికి తరలించండి</translation>
<translation id="2501278716633472235">వెనుకకు వెళ్ళు</translation>
<translation id="252418934079508528"><ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేయండి</translation>
<translation id="2538084450874617176"><ph name="DEVICE_TYPE" />ను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="2553340429761841190"><ph name="NETWORK_ID" />కు కనెక్ట్ చేయడానికి <ph name="PRODUCT_NAME" />కి సాధ్యం కాలేదు. దయచేసి మరొక నెట్‌వర్క్‌ని ఎంచుకోండి లేదా మళ్ళీ ప్రయత్నిచండి.</translation>
<translation id="2565214867520763227">స్క్రీన్ రీడర్‌ని ఆన్ చేయండి</translation>
<translation id="2569972178052279830">రిటైలర్ పేరు</translation>
<translation id="257779572837908839">మీటింగ్‌ల కోసం Chromebox లాగా సెటప్ చేయండి</translation>
<translation id="2582253231918033891"><ph name="PRODUCT_NAME" /> <ph name="PRODUCT_VERSION" /> (ప్లాట్‌ఫారమ్ <ph name="PLATFORM_VERSION" />) <ph name="DEVICE_SERIAL_NUMBER" /></translation>
<translation id="2593499352046705383">ప్రారంభించడానికి ముందు, మీరు మీ డేటాను బ్యాకప్ చేశారని నిర్ధారించుకోండి. <ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేయడం వలన మీ హార్డ్ డ్రైవ్ ఓవర్‌రైట్ అవుతుంది. g.co/flex/InstallGuide లో మరింత తెలుసుకోండి.</translation>
<translation id="2606454609872547359">వద్దు, ChromeVox లేకుండా కొనసాగించండి</translation>
<translation id="2619007277744171543"><ph name="BEGIN_PARAGRAPH1" />ఈ డివైజ్ లొకేషన్‌ను అంచనా వేయడంలో సాయం పొందడటానికి Wi-Fi, మొబైల్ నెట్‌వర్క్‌లు, సెన్సర్‌ల వంటి సోర్సులను Google లొకేషన్ సర్వీస్ ఉపయోగిస్తుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />సెట్టింగ్స్ &gt; యాప్‌లు &gt; Google Play Store &gt; Android ప్రిఫరెన్స్‌లను (ప్రాధాన్యతలను) మేనేజ్ చేయండి &gt; సెక్యూరిటీ &amp; లొకేషన్ &gt; లొకేషన్‌కు వెళ్లడం ద్వారా ఏ సమయంలోనైనా మీరు ఈ డివైజ్‌లో Android లొకేషన్‌ను ఆఫ్ చేయవచ్చు. అదే మెనూలోని "Google లొకేషన్ ఖచ్చితత్వాన్ని" ఆఫ్ చేయడం ద్వారా Wi‑Fi, మొబైల్ నెట్‌వర్క్‌లతో పాటు Android లొకేషన్ కోసం సెన్సర్‌ల వినియోగాన్ని కూడా ఆఫ్ చేయవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2663302507110284145">భాష</translation>
<translation id="2687407218262674387">Google సర్వీస్ నియమాలు</translation>
<translation id="2688196195245426394">పరికరం సర్వర్‌తో నమోదు అవుతున్నప్పుడు ఎర్రర్: <ph name="CLIENT_ERROR" />.</translation>
<translation id="2698147581454716013">ఇది బండిల్ చేయబడిన పరికరం, కియోస్క్ &amp; సంకేత చిహ్నాల అప్‌గ్రేడ్‌తో దీనిని ఎన్‌రోల్ చేయడం సాధ్యం కాదు.</translation>
<translation id="2722540561488096675">మీ డివైజ్ <ph name="TIME_LEFT" />లో షట్ డౌన్ అవుతుంది. మీ డివైజ్‌ను తిరిగి ఆన్ చేయడానికి ముందే USBని తీసివేయండి. తర్వాత మీరు <ph name="DEVICE_OS" />ను ఉపయోగించడం ప్రారంభించవచ్చు.</translation>
<translation id="2725200716980197196">నెట్‌వర్క్ కనెక్టివిటీ పునరుద్ధరించబడింది</translation>
<translation id="2731700343119398978">దయచేసి వేచి ఉండండి...</translation>
<translation id="2732134891301408122"><ph name="TOTAL_ELEMENTS" />లో <ph name="CURRENT_ELEMENT" />వ అదనపు కంటెంట్</translation>
<translation id="2740531572673183784">సరే</translation>
<translation id="2742448780373473567"><ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేయడం వలన మీ పరికరంలో డేటా మొత్తం ఓవర్‌రైట్ అవుతుంది.</translation>
<translation id="274318651891194348">కీబోర్డ్ కోసం సెర్చ్ చేస్తోంది</translation>
<translation id="2754825024506485820">పని చేసే సామర్థ్యాన్ని పెంచడం దగ్గర నుండి వినోదం దాకా మీకు అవసరమైన యాప్‌లను Google Play Storeలో కనుగొనండి. యాప్‌లను మీరు ఎప్పుడైనా ఇన్‌స్టాల్ చేయవచ్చు.</translation>
<translation id="2758774297008336689"><ph name="BEGIN_PARAGRAPH1" />'లొకేషన్ ఖచ్చితత్వం' ఆన్‌లో ఉన్నప్పుడు, Wi-Fi యాక్సెస్ పాయింట్లు, సెల్యులార్ నెట్‌వర్క్ టవర్‌ల వంటి వైర్‌లెస్ సిగ్నల్స్‌తో పాటు యాక్సిలెరోమీటర్, గైరోస్కోప్ వంటి డివైజ్ సెన్సర్ డేటాకు సంబంధించిన సమాచారాన్ని ఉపయోగించి మరింత ఖచ్చితమైన డివైజ్ లొకేషన్‌ను అంచనా వేస్తారు. లొకేషన్ ఆధారిత ఫీచర్లను అందించడానికి Android యాప్‌లు &amp; సర్వీస్‌లు దీన్ని ఉపయోగిస్తాయి. ఇలా చేసేందుకు గానూ, క్రౌడ్‌సోర్స్ చేసిన వైర్‌లెస్ సిగ్నల్ లొకేషన్‌లకు కంట్రిబ్యూట్ చేయడానికి ఈ డివైజ్‌కు సమీపంలో ఉన్న డివైజ్ సెన్సర్‌లు, వైర్‌లెస్ సిగ్నల్స్ సమాచారాన్ని Google కాలానుగుణంగా సేకరిస్తుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />ఈ డివైజ్ నుండి సేకరించిన సమాచారాన్ని Google ఉపయోగించి: 'లొకేషన్ ఖచ్చితత్వాన్ని', లొకేషన్ ఆధారిత సర్వీస్‌లను మెరుగుపరుస్తుంది; సాధారణంగా Google సర్వీస్‌లను మెరుగుపరుస్తుంది, అందిస్తుంది, మెయిన్‌టెయిన్ చేస్తుంది. యూజర్ అవసరాలను తీర్చడానికి Googleతో పాటు థర్డ్-పార్టీల చట్టబద్ధమైన ప్రయోజనాల ఆధారంగా మేము ఈ సమాచారాన్ని ప్రాసెస్ చేస్తాము. ఏ వ్యక్తినీ గుర్తించడం కోసం ఈ సమాచారం వినియోగించము.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />మీరు సెట్టింగ్స్ కింద ఉన్న ఈ డివైజ్ లొకేషన్ సెట్టింగ్స్ &gt; గోప్యతా, సెక్యూరిటీ &gt; గోప్యతా కంట్రోల్స్ &gt; లొకేషన్ యాక్సెస్ &gt; అడ్వాన్స్‌డ్ లొకేషన్ సెట్టింగ్స్‌లో ఏ సమయంలోనైనా 'లొకేషన్ ఖచ్చితత్వాన్ని' ఆఫ్ చేయవచ్చు. లొకేషన్ ఖచ్చితత్వం ఆఫ్‌లో ఉంటే, లొకేషన్ ఖచ్చితత్వ డేటా ఏదీ కలెక్ట్ కాదు. మీ డివైజ్ లొకేషన్‌ను గుర్తించడానికి, Android యాప్‌లు &amp; సర్వీస్‌లు (అందుబాటులో ఉంటే) IP అడ్రస్‌ను మాత్రమే ఉపయోగిస్తాయి. దీనివల్ల, Google Maps లాంటి Android యాప్‌లు, &amp; సర్వీస్‌ల్లో లొకేషన్లు అందుబాటులో ఉండటం పైన, అలాగే వాటి కచ్చితత్వం పైన ప్రభావం పడవచ్చు.<ph name="END_PARAGRAPH3" /></translation>
<translation id="2805539617243680210">మీరు మొత్తం పూర్తి చేశారు!</translation>
<translation id="2819519502129272135">ఫైల్ సింక్ ఆఫ్ చేయబడింది</translation>
<translation id="2832124733806557606">మీ చిన్నారి, పరికరానికి సైన్ ఇన్ చేయడానికి లేదా అన్‌లాక్ చేయడానికి PINను ఉపయోగించవచ్చు.</translation>
<translation id="283669119850230892"><ph name="NETWORK_ID" /> నెట్‌వర్క్‌ను ఉపయోగించడానికి, మొదట దిగువ ఇంటర్నెట్‌కు మీ కనెక్షన్‌ను పూర్తి చేయండి.</translation>
<translation id="2849767214114481738">మీ PINను జోడించడం జరిగింది</translation>
<translation id="2851810309108851898"><ph name="BEGIN_PARAGRAPH1" />ఆటోమేటిక్ రిపోర్ట్‌లను పంపడానికి ChromeOS డివైజ్‌లను అనుమతించడం ద్వారా, ఏ సమస్యను ముందుగా పరిష్కరించి, ChromeOSను మెరుగుపరచాలనే అంశంపై నిర్ణయం తీసుకోవడం మాకు సులువు అవుతుంది. ఈ రిపోర్ట్‌ల్లో ChromeOS ఎప్పుడు క్రాష్ అయింది, ఏ ఫీచర్లను ఉపయోగించారు, సాధారణంగా ఎంత మెమరీని ఉపయోగించారు వంటి వివరాలు కూడా ఉంటాయి.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీ Chrome డివైజ్ సెట్టింగ్స్‌లో ఈ రిపోర్ట్‌లను అనుమతించడాన్ని మీరు ఏ సమయంలోనైనా ప్రారంభించవచ్చు లేదా ఆపివేయవచ్చు. మీరు డొమైన్ అడ్మినిస్ట్రేటర్ అయితే, మీరు ఈ సెట్టింగ్‌ను అడ్మిన్ కన్సోల్‌లో మార్చవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="2861301611394761800">సిస్టమ్ అప్‌డేట్ పూర్తయ్యింది. దయచేసి సిస్టమ్‌ని పునఃప్రారంభించండి.</translation>
<translation id="2870909136778269686">అప్‌డేట్ చేస్తోంది...</translation>
<translation id="2872961005593481000">షట్ డౌన్ చేయండి</translation>
<translation id="2886119409731773154">దీనికి 30 నిమిషాల వరకు సమయం పట్టవచ్చు</translation>
<translation id="2893180576842394309">శోధన, ఇతర Google సేవలను వ్యక్తిగతీకరించడానికి Google మీ హిస్టరీని ఉపయోగించే అవకాశం ఉంటుంది</translation>
<translation id="2902265136119311513">గెస్ట్‌లాగా బ్రౌజ్ చేయండి</translation>
<translation id="2904210161403910217">చివరిసారి సైన్ ఇన్ చేసిన తర్వాత మీ పాస్‌వర్డ్ మార్చబడింది</translation>
<translation id="2918484644467055090">ఈ డివైజ్‌ను మీ ఖాతా చెందిన ఆర్గనైజేషన్‌కు ఎన్‌రోల్ చేయడం సాధ్యపడదు, ఎందుకంటే మేనేజ్‌మెంట్ కోసం డివైజ్ వేరే ఆర్గనైజేషన్ ద్వారా మార్క్ చేయబడింది.</translation>
<translation id="2921081876747860777">దయచేసి మీ స్థానిక డేటాను రక్షించడానికి పాస్‌వర్డ్‌ను క్రియేట్ చేయండి.</translation>
<translation id="2935654492420446828">పాఠశాల ఖాతాను తర్వాత జోడించండి</translation>
<translation id="2950666755714083615">నన్ను సైన్ అప్ చేయనివ్వు</translation>
<translation id="2979966855249721010">మీ ఆసక్తుల ఆధారంగా, మీరు యాప్ సిఫార్సులు, చిట్కాలు, మరిన్నింటిని చూడవచ్చు</translation>
<translation id="3012917896646559015">మీ కంప్యూటర్‌ను మరమ్మత్తు చేయడానికి పంపడానికి, దయచేసి వెంటనే మీ హార్డ్‌వేర్ తయారీదారుని సంప్రదించండి.</translation>
<translation id="3023464535986383522">వినడానికి ఎంచుకోండి</translation>
<translation id="3028371505549235127">సైన్ ఇన్ చేయడానికి మీ Google ఖాతా పాస్‌వర్డ్‌ను ఎంటర్ చేయడానికి బదులుగా, మీరు ఈ పరికరం కోసం <ph name="DEVICE_TYPE" /> పాస్‌వర్డ్‌ను క్రియేట్ చేయవచ్చు</translation>
<translation id="3033348223765101500">మీ డేటాను కంట్రోల్ చేయండి</translation>
<translation id="3090871774332213558">"<ph name="DEVICE_NAME" />" జత చేయబడింది</translation>
<translation id="3101924772906986970">మీ Chrome బ్రౌజర్ బుక్‌మార్క్‌లు, పాస్‌వర్డ్‌లు, హిస్టరీ, ఇంకా మరిన్ని వివరాలు మీ Google ఖాతాలో సేవ్ అవుతాయి</translation>
<translation id="313205617302240621">పాస్‌వర్డ్‌ను మర్చిపోయారా?</translation>
<translation id="3162070126914310576">మీ సంస్థ యూనిట్ దాని ప్రారంభ ఎన్‌రోల్‌మెంట్ పరిమితిని చేరుకున్నందున ఈ డివైజ్‌ను ప్రస్తుతం ఎన్‌రోల్ చేయడం సాధ్యం కాదు. సహాయం కోసం మీ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి.</translation>
<translation id="3163511056918491211">ఏ సమయంలో అయినా మీ డేటాను సులభంగా రీస్టోర్ చేయండి లేదా పరికరాలను మార్చండి. మీ బ్యాకప్‌లు Googleకు అప్‌లోడ్ చేయబడతాయి, మీ Google ఖాతా పాస్‌వర్డ్‌ను ఉపయోగించి ఎన్‌క్రిప్ట్ చేయబడతాయి.</translation>
<translation id="3169930038976362151">మీ అవసరాలకు తగిన రూపాన్ని ఎంచుకోండి. మీ రూపాన్ని, వాల్‌పేపర్‌ను, స్క్రీన్ సేవర్‌ను, ఇంకా మరిన్నింటిని మార్చడానికి, డెస్క్‌టాప్‌పై తాకి, నొక్కి ఉంచండి.</translation>
<translation id="3170072451822350649">మీరు సైన్ ఇన్ చేయడాన్ని కూడా దాట వేయవచ్చు. <ph name="LINK_START" />అతిథిగా బ్రౌజ్ చేయవచ్చు<ph name="LINK_END" />.</translation>
<translation id="3177914167275935955">మీ పరికరం Chrome Education అప్‌గ్రేడ్‌ను కలిగి ఉంది, కానీ మీ యూజర్‌నేమ్ Google for Education ఖాతాతో అనుబంధించబడి లేదు. వేరొక పరికరంలో దయచేసి g.co/workspace/edusignup లింక్‌ను సందర్శించి Google for Education ఖాతాను క్రియేట్ చేయండి.</translation>
<translation id="3196912927885212665">మీ Android ఫోన్‌తో సెటప్ చేయడానికి, మీ Chromebook బ్లూటూత్ ఆన్‌లో ఉండాలి</translation>
<translation id="322708765617468434">సెటప్ తర్వాత మీరు ఎప్పుడైనా పరికరానికి మరొక వ్యక్తిని జోడించవచ్చు. ప్రతి వ్యక్తి వారి ఎక్స్‌పీరియన్స్‌ను వ్యక్తిగతీకరించుకోవచ్చు, వారి డేటాను ప్రైవేట్‌గా ఉంచుకోవచ్చు.</translation>
<translation id="3238192140106069382">కనెక్ట్ చేయడానికి మరియు వెరిఫై చేయడానికి ట్రై చేస్తోంది</translation>
<translation id="3251119461199395237">ఫైల్ సింక్</translation>
<translation id="325238099842880997">చిన్నారులు ఆడుకోవడానికి, అన్వేషించడానికి, అలాగే ఇంట్లో పాఠశాల విద్యను అభ్యసించడానికి సహాయపడేలా డిజిటల్ గ్రౌండ్ నియమాలను సెట్ చేయండి</translation>
<translation id="3255747772218936245">అప్‌డేట్‌ను ఇన్‌స్టాల్ చేయండి</translation>
<translation id="3261268979727295785">ఎదిగిన పిల్లల కోసం, మీరు సెటప్‌ను పూర్తి చేశాక తల్లిదండ్రుల నియంత్రణలను జోడించవచ్చు. తల్లిదండ్రుల నియంత్రణలకు సంబంధించిన సమాచారాన్ని Explore యాప్‌లో చూడగలరు.</translation>
<translation id="3278001907972365362">మీ Google ఖాతా లేదా ఖాతాలను జాగ్రత్తగా గమనించాలి</translation>
<translation id="3283148363895519428">మీ ఫోన్‌లోని సూచనలను ఫాలో అయ్యి, సెటప్‌ను కొనసాగించండి. మీ ఫోన్ సమీపంలో ఉందని, బ్లూటూత్ ఆన్ చేసి ఉందని నిర్ధారించుకోండి.</translation>
<translation id="3327050066667856415">Chromebooks భద్రత కోసం రూపొందించబడ్డాయి. మీ పరికరం ఆటోమేటిక్‌గా మాల్‌వేర్ నుండి రక్షించబడుతుంది - అదనపు సాఫ్ట్‌వేర్ అవసరం లేదు.</translation>
<translation id="3382073616108123819">అయ్యో!  ఈ పరికరం కోసం పరికర ఐడెంటిఫైయర్‌లను నిశ్చయించడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="3382200254148930874">పర్యవేక్షణను ఆపివేస్తోంది...</translation>
<translation id="3384362484379805487">డిస్క్ స్పేస్‌ను సేవ్ చేయడానికి భాషకు సంబంధించిన ఫైళ్లు యూజర్‌లతో షేర్ చేయబడతాయి.</translation>
<translation id="3385092118218578224"><ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3391721320619127327">ChromeOS Flexలో, ChromeVoxలో ఉండే స్క్రీన్ రీడర్‌ను, ప్రధానంగా అంధత్వం ఉన్న వారు, లేదా దృష్టి లోపం ఉన్న వారు, స్క్రీన్ మీద డిస్‌ప్లే అయ్యే టెక్స్ట్‌ను చదవడానికి ఉపయోగిస్తారు, ఇందు కోసం స్పీచ్ సింథసైజర్‌ను లేదా బ్రెయిలీ డిస్‌ప్లేను ఉపయోగించడం జరుగుతుంది. ChromeVoxను ఆన్ చేయడానికి రెండు వాల్యూమ్ కీలనూ అయిదు సెకన్ల పాటు నొక్కి, పట్టుకోండి. ChromeVoxను యాక్టివేట్ చేసినప్పుడు, మీకు ఒక క్విక్ టూర్ అందించబడుతుంది.</translation>
<translation id="3402585168444815892">డెమో మోడ్‌కు ఎన్‌రోల్ అవుతోంది</translation>
<translation id="3433621910545056227">అయ్యో!  పరికరం ఇన్‌స్టాలేషన్-సమయ లక్షణాల లాక్‌ను ఏర్పాటు చేయడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="3435896845095436175">ప్రారంభించండి</translation>
<translation id="3462413494201477527">ఖాతా సెటప్‌ను రద్దు చేయాలా?</translation>
<translation id="3473241910002674503">టాబ్లెట్ మోడ్‌లో బటన్‌లతో హోమ్, వెనుకకు, స్విచ్ యాప్‌లను నావిగేట్ చేయండి.</translation>
<translation id="3473479545200714844">స్క్రీన్ మాగ్నిఫైయర్</translation>
<translation id="3491669675709357988">Family Link తల్లిదండ్రుల నియంత్రణల కోసం మీ చిన్నారి ఖాతా సెటప్ చేయబడలేదు. మీరు ఒకసారి సెటప్‌ను పూర్తి చేసిన తర్వాత, తల్లిదండ్రుల నియంత్రణలను జోడించగలరు. తల్లిదండ్రుల నియంత్రణలకు సంబంధించిన సమాచారాన్ని Explore యాప్‌లో చూడగలరు.</translation>
<translation id="350397915809787283">మీకు ఖాతా లేకపోతే, ఒకదాన్ని క్రియేట్ చేయడానికి మొదటి ఆప్షన్‌ను ఎంచుకోండి.</translation>
<translation id="3520824492621090923">కియోస్క్, సంకేత చిహ్నాల పరికరంలో ఎన్‌రోల్ అయినట్లు నిర్ధారించండి?</translation>
<translation id="3547954654003013442">ప్రాక్సీ సెట్టింగ్‌లు</translation>
<translation id="3550915441744863158">Chrome ఆటోమేటిక్‌గా అప్‌డేట్ అవుతుంది కాబట్టి మీ వద్ద ఎప్పుడూ సరికొత్త వెర్షన్ ఉంటుంది</translation>
<translation id="3559533181353831840">సుమారు <ph name="TIME_LEFT" /> మిగిలి ఉంది</translation>
<translation id="3567129848895158510"><ph name="BEGIN_PARAGRAPH1" />ఈ డెమో డివైజ్‌ను ఏ రీటెయిలర్, స్టోర్ నంబర్ కోసం* కాన్ఫిగర్ చేస్తున్నారో ఆ వివరాలను ఎంటర్ చేయండి. <ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీకు స్టోర్ నంబర్ తెలియకపోతే, డెమో మోడ్ ఇన్‌స్టాలేషన్‌ను కొనసాగించడానికి మీరు "0000"ను ఎంటర్ చేయవచ్చు. <ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />*గమనిక: డివైజ్‌ డెమో మోడ్‌కి సంబంధించిన ఏ వెర్షన్‌ను అందుకోవాలో గుర్తించడానికి, డెమో మోడ్ వినియోగాన్ని కొలవడానికి Google ఈ సమాచారాన్ని ఉపయోగిస్తుంది.<ph name="END_PARAGRAPH3" /></translation>
<translation id="3577473026931028326">ఏదో తప్పు జరిగింది. మళ్లీ ట్రై చేయండి.</translation>
<translation id="3577745545227000795"><ph name="DEVICE_OS" /> హార్డ్‌వేర్ డేటా సేకరణ</translation>
<translation id="3602290021589620013">ప్రివ్యూ</translation>
<translation id="3607671391978830431">చిన్నారి కోసం</translation>
<translation id="3627320433825461852">1 నిమిషం కంటే తక్కువ సమయం మిగిలి ఉంది</translation>
<translation id="3635199270495525546">ట్రస్టెడ్ ప్లాట్‌ఫారమ్ మాడ్యూల్ (TPM) గుర్తించబడింది</translation>
<translation id="3650753875413052677">నమోదు చేయడంలో ఎర్రర్ ఏర్పడింది</translation>
<translation id="3661106764436337772">మరింత వేగంగా, మరింత నమ్మకంతో రాయండి</translation>
<translation id="3662207097851752847">మీ ఫోన్‌లో మీ Google ఖాతాను నిర్ధారించండి</translation>
<translation id="3672681487849735243">ఫ్యాక్టరీ ఎర్రర్ గుర్తించబడింది</translation>
<translation id="3673097791729989571">సైన్ ఇన్‌ను <ph name="SAML_DOMAIN" /> హోస్ట్ చేసింది</translation>
<translation id="3673287357837016374">మీ PIN అప్‌డేట్ చేయబడింది</translation>
<translation id="367645871420407123">మీరు రూట్ పాస్‌వర్డ్‌ను డిఫాల్ట్ పరీక్ష చిత్ర విలువకు సెట్ చేయాలనుకుంటే ఖాళీగా వదిలిపెట్టండి</translation>
<translation id="370665806235115550">లోడ్ అవుతోంది...</translation>
<translation id="3712050472459130149">ఖాతాను అప్‌డేట్ చేయడం అవసరం</translation>
<translation id="3733296813637058299">మేము మీ కోసం ఆ యాప్‌లు ఇన్‌స్టాల్ చేస్తాము. మీరు Play Storeలో మీ <ph name="DEVICE_TYPE" /> కోసం మరిన్ని యాప్‌లను కనుగొనవచ్చు.</translation>
<translation id="3740945083753997630">డిస్‌ప్లే, టెక్స్ట్ సైజ్‌ను తగ్గించండి</translation>
<translation id="376841534249795524">మీ <ph name="DEVICE_TYPE" /> డివైజ్‌ను మీరు దేని కోసం ఉపయోగిస్తారు?</translation>
<translation id="3772046291955677288">నేను <ph name="BEGIN_LINK1" />Google సర్వీస్ నియమాలు<ph name="END_LINK1" />, <ph name="BEGIN_LINK2" />Chrome, అలాగే ChromeOS అదనపు సర్వీస్ నియమాలను<ph name="END_LINK2" /> చదివి అంగీకరిస్తున్నాను.</translation>
<translation id="3789841737615482174">ఇన్‌స్టాల్ చేయండి</translation>
<translation id="3800828618615365228">Google Chrome, ChromeOS అదనపు నియమాలు</translation>
<translation id="3828953470056652895">నేను <ph name="BEGIN_LINK1" />Google సర్వీస్ నియమాలు<ph name="END_LINK1" />, <ph name="BEGIN_LINK2" />Chrome, అలాగే ChromeOS అదనపు సర్వీస్ నియమాలు<ph name="END_LINK2" />, అలాగే <ph name="BEGIN_LINK3" />Play సర్వీస్ నియమాలను<ph name="END_LINK3" /> చదివి అంగీకరిస్తున్నాను.</translation>
<translation id="3837569373891539515">వర్తించే వాటన్నింటినీ మీరు ఎంచుకోవచ్చు. మీ <ph name="DEVICE_TYPE" />‌ను సెటప్ చేయడం మీరు పూర్తి చేసిన తర్వాత, సెట్టింగ్‌లలో కూడా మీకు ఈ ఆప్షన్‌లు కనిపిస్తాయి.</translation>
<translation id="385051799172605136">వెనుకకు</translation>
<translation id="3856470183388031602">మీ <ph name="DEVICE_TYPE" />‌లో మీ Google ఖాతాను ఉపయోగించండి</translation>
<translation id="3856800405688283469">సమయ మండలిని ఎంచుకోండి</translation>
<translation id="3893630138897523026">ChromeVox (చదవబడే అభిప్రాయం)</translation>
<translation id="3897746662269329507">మీ <ph name="DEVICE_TYPE" />, వీడియో గేమ్‌ల కోసం బిల్డ్ చేయబడింది. తర్వాత, 'అన్వేషణ' యాప్ తెరవబడుతుంది, అందులో మీరు వందల కొద్దీ తాజా గేమ్‌లను యాక్సెస్ చేయవచ్చు, వీడియో గేమ్‌ల ఆఫర్‌లను చూడవచ్చు, మీ పరికరంతో వచ్చే వీడియో గేమ్ ఫీచర్‌ల గురించి తెలుసుకోవచ్చు.</translation>
<translation id="389901847090970821">కీబోర్డ్‌ను ఎంచుకోండి</translation>
<translation id="3910588685973519483">AIతో వాల్‌పేపర్‌లను క్రియేట్ చేయండి</translation>
<translation id="3924259174674732591">డిస్‌ప్లే, టెక్స్ట్ సైజ్ <ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3950820424414687140">సైన్ ఇన్</translation>
<translation id="397703832102027365">పూర్తి చేస్తోంది...</translation>
<translation id="3983400541576569538">కొన్ని యాప్‌ల డేటాను కోల్పోవచ్చు</translation>
<translation id="3984159763196946143">డెమో మోడ్‌ను ప్రారంభించలేకపోయాము</translation>
<translation id="3988996860813292272">సమయ మండలిని ఎంచుకోండి</translation>
<translation id="3994318741694670028">దురదృష్టవశాత్తూ, తప్పుగా ఫార్మాట్ చేయబడిన హార్డ్‌వేర్ IDతో మీ కంప్యూటర్ కాన్ఫిగర్ చేయబడింది. ఇది సెక్యూరిటీ పరిష్కారాలతో అప్‌డేట్ కాకుండా ChromeOS Flexను నిరోధిస్తుంది, అలాగే మీ కంప్యూటర్ <ph name="BEGIN_BOLD" />హానికరమైన దాడులకు గురి కావచ్చు<ph name="END_BOLD" />.</translation>
<translation id="4002440992267487163">పిన్ సెటప్</translation>
<translation id="403725336528835653">ముందు దీన్ని ట్రై చేయండి</translation>
<translation id="4044883420905480380">మీరు Wi-Fiకి కనెక్ట్ చేసి, మీ Android ఫోన్‌ను ఉపయోగించి <ph name="USER_EMAIL" />‌కు సైన్ ఇన్ చేశారు</translation>
<translation id="4047726037116394521">హోమ్‌కు వెళ్లు</translation>
<translation id="4062561150282203854">మీ <ph name="DEVICE_TYPE" /> యాప్‌లు, సెట్టింగ్‌లు, ఇంకా మరిన్నింటిని సింక్ చేయండి</translation>
<translation id="4089743381329341712">సెటప్ చేసిన తర్వాత ఎంచుకున్న యాప్‌లు ఇన్‌స్టాల్ అవుతాయి. యాప్‌లు &amp; గేమ్‌ల యాప్‌లో తర్వాత మరిన్ని సిఫార్సులను కనుగొనండి.</translation>
<translation id="4104944259562794668">మీరు దానిని తర్వాత సెట్టింగ్‌లు &gt; సెక్యూరిటీ, గోప్యత &gt; లాక్ స్క్రీన్, సైన్ ఇన్ అనే ఆప్షన్‌లో ఎనేబుల్ చేయవచ్చు</translation>
<translation id="4132183752438206707">Google Play Storeలో యాప్‌లను కనుగొనండి</translation>
<translation id="4135746311382563554">Google Chrome, ChromeOS అదనపు సర్వీసు నిబంధనలు</translation>
<translation id="41365691917097717">దీనిని కొనసాగించడం వలన Android యాప్‌లను రూపొందించడానికి, పరీక్షించడానికి ADB డీబగ్గింగ్ ఎనేబుల్ అవుతుంది. ఈ చర్య వలన Google ద్వారా ధృవీకరించబడని Android యాప్‌ల ఇన్‌స్టాలేషన్ అనుమతించబడుతుందని, దీనిని డిజేబుల్ చేయడానికి ఫ్యాక్టరీ రీసెట్ చేయాల్సి ఉంటుందని గుర్తుంచుకోండి.</translation>
<translation id="4165942112764990069"><ph name="USER_EMAIL" />, చెల్లుబాటులో ఉన్న సంస్థకు చెందినది కాదు. మీ అడ్మినిస్ట్రేటర్‌ను కాంటాక్ట్ చేయండి. మీరు అడ్మినిస్ట్రేటర్ అయితే, ఈ సైట్‌ను సందర్శించడం ద్వారా మీరు మీ సంస్థను సెటప్ చేయవచ్చు: g.co/ChromeEnterpriseAccount</translation>
<translation id="4167393659000039775">ఏదైనా డేటా కోల్పోతే దానికి Google ఎటువంటి బాధ్యత వహించదు, అలాగే <ph name="DEVICE_OS" /> సర్టిఫై చేయబడని మోడల్స్‌లో పని చేయకపోవచ్చు. g.co/flex/InstallGuide లో మరింత తెలుసుకోండి.</translation>
<translation id="4209092469652827314">పెద్దది</translation>
<translation id="4213918571089943508">చిన్నారికి చెందిన Google ఖాతా</translation>
<translation id="4228071595943929139">మీ సంస్థకు సంబంధించిన ఈమెయిల్ అడ్రస్‌ను ఉపయోగించండి</translation>
<translation id="4232484478444192782">మీ Android ఫోన్ మీకు సహాయం చేస్తుంది. మీ WiFi, పాస్‌వర్డ్ బదిలీ అవుతున్నాయి.</translation>
<translation id="4242145785130247982">బహుళ క్లయింట్ సర్టిఫికెట్‌లకు మద్దతు లేదు</translation>
<translation id="4242577469625748426">పరికరంలో విధాన సెట్టింగ్‌లను ఇన్‌స్టాల్ చేయడంలో విఫలమైంది: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4250680216510889253">లేదు</translation>
<translation id="4251377547188244181">కియోస్క్, సంకేత చిహ్నాల పరికరంలో ఎన్‌రోల్‌మెంట్</translation>
<translation id="4263223596040212967">మీ కీబోర్డ్ లేఅవుట్‌ను చెక్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="4268490040465852105">ఒకటే Google ఖాతాను మీరు Gmail, YouTube, Chrome, ఇతర Google ప్రోడక్ట్‌లలో ఉపయోగిస్తారు.
        మీ ఖాతాను ఉపయోగించి, మీ అన్ని బుక్‌మార్క్‌లు, ఫైల్స్, మరిన్నింటిని సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="4278498748067682896">మీరు కియోస్క్ &amp; సంకేత చిహ్నాల అప్‌గ్రేడ్‌ను ఉపయోగిస్తారు, ఇది డివైజ్‌ను కియోస్క్ లేదా సంకేత చిహ్నాల మోడ్‌లో మాత్రమే రన్ అయ్యేలా చేస్తుంది. యూజర్‌లు డివైజ్‌లోకి సైన్ ఇన్ చేసే వీలును మీరు కల్పించాలనుకుంటే, దయచేసి వెనుకకు వెళ్లి, Chrome Enterpirse అప్‌గ్రేడ్‌ను ఉపయోగించి ఎన్‌రోల్ అవ్వండి.</translation>
<translation id="4287157641315808225">అవును, ChromeVoxను యాక్టివేట్ చేయి</translation>
<translation id="4289732974614035569">PINను ఎంచుకోండి</translation>
<translation id="4291265871880246274">లాగిన్ డైలాగ్</translation>
<translation id="4305817255990598646">స్విచ్</translation>
<translation id="4309165024397827958">లొకేషన్ అనుమతిని కలిగిన Android యాప్‌లు, సర్వీస్‌లు మీ పరికర లొకేషన్‌ను ఉపయోగించడానికి అనుమతించండి. Google కాలానుగుణంగా లొకేషన్ డేటాను సేకరించవచ్చు, లొకేషన్ ఖచ్చితత్వాన్ని, లొకేషన్-ఆధారిత సర్వీస్‌లను మెరుగుపరచడం కోసం ఈ డేటాను అజ్ఞాతంగా ఉపయోగించవచ్చు.</translation>
<translation id="4317733381297736564">యాప్‌లో కొనుగోళ్లు</translation>
<translation id="4341905082470253054">TPM స్టేటస్‌ను చెక్ చేస్తోంది...</translation>
<translation id="434198521554309404">వేగవంతమైనది. సురక్షితమైనది. శ్రమ లేనిది.</translation>
<translation id="4358643842961018282">మీ డివైజ్ అప్‌డేట్ అయ్యి ఉంది</translation>
<translation id="4370975561335139969">మీరు నమోదు చేసిన ఈమెయిల్‌, పాస్‌వర్డ్ సరిపోలలేదు</translation>
<translation id="4373418556073552953">మీ Android ఫోన్‌తో సైన్ ఇన్ చేయండి</translation>
<translation id="4378556263712303865">పరికరం రిక్వెస్ట్‌</translation>
<translation id="4383048845287221326"><ph name="BEGIN_PARAGRAPH1" />ఆటోమేటిక్ రిపోర్ట్‌లను పంపడానికి మీ ChromeOS డివైజ్‌లను అనుమతించడం ద్వారా, ఏ సమస్యను ముందుగా పరిష్కరించి ChromeOSను మెరుగుపరచాలనే అంశాన్ని నిర్ణయించడం మాకు సులువు అవుతుంది. ChromeOS ఎప్పుడు క్రాష్ అవుతుంది, మీరు ఏ ఫీచర్‌లను ఉపయోగిస్తున్నారు, సాధారణంగా మీరు ఎంత మెమరీని ఉపయోగిస్తారు, Android యాప్‌లో డయాగ్నస్టిక్ &amp; యుసేజ్ (సమస్య విశ్లేషణ, వినియోగ) డేటా వంటి అంశాలు కూడా ఈ రిపోర్ట్‌ల్లో ఉండవచ్చు. కొంత అగ్రిగేటెడ్ (సమగ్ర) డేటా కూడా Google యాప్‌లకు, Android డెవలపర్‌ల వంటి పార్ట్‌నర్‌లకు ఉపయోగపడుతుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీ ChromeOS డివైజ్ సెట్టింగ్స్‌లో ఈ రిపోర్ట్‌లను అనుమతించడాన్ని మీరు ఏ సమయంలోనైనా ప్రారంభించవచ్చు లేదా ఆపివేయవచ్చు. మీరు డొమైన్ అడ్మినిస్ట్రేటర్ అయితే, మీరు ఈ సెట్టింగ్‌ను అడ్మిన్ కన్సోల్‌లో మార్చవచ్చు.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />మీ Google ఖాతా కోసం వెబ్ &amp; యాప్ యాక్టివిటీ సెట్టింగ్‌ను ఆన్ చేసినట్లయితే, మీ Android డేటా మీ Google ఖాతాలో సేవ్ కావచ్చు. మీరు account.google.com సైట్‌లో మీ డేటాను చూడవచ్చు, తొలగించవచ్చు, మీ ఖాతా సెట్టింగ్స్‌ను మార్చవచ్చు.<ph name="END_PARAGRAPH3" /></translation>
<translation id="4385905942116811558">బ్లూటూత్, అలాగే USB పరికరాల కోసం సెర్చ్ చేస్తోంది</translation>
<translation id="4403266582403435904">ఏ సమయంలో అయినా డేటాను సులభంగా రీస్టోర్ చేయండి లేదా పరికరాలను మార్చండి. బ్యాకప్‌లు Googleకు అప్‌లోడ్ అవుతాయి, మీ చిన్నారి Google ఖాతా పాస్‌వర్డ్‌ను ఉపయోగించి ఎన్‌క్రిప్ట్ చేయబడతాయి.</translation>
<translation id="4410545552906060960">మీ డివైజ్‌ను అన్‌లాక్ చేయడానికి పాస్‌వర్డ్‌‌కు బదులుగా నంబర్ (PIN)ను ఉపయోగించండి. తర్వాత మీ PINను సెట్ చేయడానికి, సెట్టింగ్‌లకు వెళ్లండి.</translation>
<translation id="4415213869328311284">మీ <ph name="DEVICE_TYPE" />ను ఉపయోగించడం ప్రారంభించడానికి మీరు సిద్ధంగా ఉన్నారు.</translation>
<translation id="443031431654216610">సంఖ్యాత్మక డిజిట్‌లను మాత్రమే ఉపయోగించండి</translation>
<translation id="4448560527907365660">సేవ్ చేసి మరిన్ని చూడండి</translation>
<translation id="4449948729197510913">మీ యూజర్‌నేమ్ మీ సంస్థ ఎంటర్‌ప్రైజ్ ఖాతాకు చెంది ఉంటుంది. ఖాతాకు పరికరాలను ఎన్‌రోల్ చేయడానికి, మొదట అడ్మిన్ కన్సోల్‌లో డొమైన్ యాజమాన్య హక్కును వెరిఫై చేయండి. వెరిఫై చేయడానికి మీకు ఖాతాలో నిర్వాహక ప్రత్యేకాధికారాలు ఉండాలి.</translation>
<translation id="4450974146388585462">విశ్లేషించు</translation>
<translation id="445099924538929605">మీ డేటాను మరింత సురక్షితంగా స్టోర్ చేయగల ఒక యాక్టివ్ TPMను <ph name="DEVICE_OS" /> గుర్తించింది.</translation>
<translation id="4472298120638043495">మీరు ఇప్పుడు మీ ప్రాధాన్య Google ఖాతా భాష (<ph name="NEW_LOCALE_FROM_GAIA" />)ను ఉపయోగించవచ్చు</translation>
<translation id="4472575034687746823">ప్రారంభించండి</translation>
<translation id="4487489714832036847">సంప్రదాయ సాఫ్ట్‌వేర్‌కు బదులుగా Chromebooks యాప్‌లను ఉపయోగిస్తాయి. పని సామర్థ్యాన్ని పెంచడం, వినోదం ఇంకా మరిన్నింటి కోసం యాప్‌లను పొందండి.</translation>
<translation id="450867954911715010">యాక్సెస్‌ సెట్టింగ్‌లు</translation>
<translation id="4519605771716872386">ఫైల్ సింక్ ఆన్ చేయబడింది</translation>
<translation id="4531924570968473143">మీరు ఎవరిని ఈ <ph name="DEVICE_TYPE" />కు జోడించాలనుకుంటున్నారు?</translation>
<translation id="4566170377336116390">ఎన్‌రోల్ అయ్యాక మీరు స్విచ్ అవ్వాలనుకుంటే, మీ డివైజ్‌ను ఫ్యాక్టరీ రీసెట్ (పవర్‌వాష్) చేయండి.</translation>
<translation id="4567512141633030272">సైన్ ఇన్ ఆప్షన్ తప్పుగా ఉందా?</translation>
<translation id="4567533462991917415">సెట్ అప్ చేసిన తర్వాత మీరు ఎప్పుడైనా మరింత మందిని జోడించవచ్చు. ప్రతి వ్యక్తి వారి ఖాతాను వ్యక్తిగతీకరించుకోవచ్చు అలాగే వారి డేటాను ప్రైవేట్‌గా ఉంచుకోవచ్చు.</translation>
<translation id="4568213207643490790">క్షమించండి, ఈ పరికరంలో Google ఖాతాలకు అనుమతి లేదు.</translation>
<translation id="4611759022973144129">మీ <ph name="DEVICE_TYPE" />కి సైన్ ఇన్ చేయడానికి మీరు ఈ పాస్‌వర్డ్‌ను ఉపయోగించవచ్చు.</translation>
<translation id="4634575639321169635">పని కోసం లేదా వ్యక్తిగత వినియోగం కోసం ఈ డివైజ్‌ను సెటప్ చేయండి</translation>
<translation id="4689235506267737042">మీ డెమో ప్రాధాన్యతలను ఎంచుకోండి</translation>
<translation id="4727847987444062305">నిర్వాహిత గెస్ట్ సెషన్</translation>
<translation id="473775607612524610">అప్‌డేట్‌</translation>
<translation id="473936925429402449"><ph name="TOTAL_ELEMENTS" />లో <ph name="CURRENT_ELEMENT" />వ అదనపు కంటెంట్ ఎంచుకోబడింది</translation>
<translation id="4763757134413542119"><ph name="USER_EMAIL" /> చెల్లుబాటయ్యే Google for Education ఖాతా కాదు. మీ అడ్మినిస్ట్రేటర్‌ను కాంటాక్ట్ చేయండి. మీరు అడ్మినిస్ట్రేటర్ అయితే, ఈ సైట్‌ను సందర్శించడం ద్వారా మీరు మీ సంస్థను సెటప్ చేయవచ్చు: g.co/workspace/edusignup</translation>
<translation id="4780558987886269159">ఆఫీస్ కోసం</translation>
<translation id="4806457879608775995">ఈ నిబంధనలను రివ్యూ చేయండి, మీ డేటాను కంట్రోల్ చేయండి</translation>
<translation id="4809927044794281115">లేత రంగు రూపం</translation>
<translation id="4814327014588285482">స్కిప్ చేసి, నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="4830502475412647084">OS అప్‌డేట్‌ ఇన్‌స్టాల్ చేయబడుతుంది</translation>
<translation id="4837926214103741331">ఈ డివైజ్‌ను ఉపయోగించడానికి మీకు అధికారం లేదు. దయచేసి సైన్-ఇన్ అనుమతి కోసం డివైజ్ ఓనర్‌ను కాంటాక్ట్ చేయండి.</translation>
<translation id="4844333629810439236">ఇతర కీబోర్డ్‌లు</translation>
<translation id="484462545196658690">ఆటో</translation>
<translation id="4864369630010738180">సైన్ ఇన్ అవుతోంది...</translation>
<translation id="4867272607148176509">తల్లిదండ్రులు యాప్‌లను ఆమోదించగలరు లేదా బ్లాక్ చేయగలరు, సమయ పరిమితులను సెట్ చేయగలరు, వెబ్ బ్రౌజింగ్‌ను కంట్రోల్ చేయగలరు. అత్యధిక శాతం స్కూల్ రిసోర్స్‌లను యాక్సెస్ చేయడానికి, తర్వాత ఎప్పుడైనా ఒక స్కూల్ ఖాతాను జోడించవచ్చు.</translation>
<translation id="4877652723592270843">మీరు ChromeOS Flexకి బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను యాక్టివేట్ చేయాలనుకుంటున్నారా? అలా చేయాలనుకుంటే, రెండు వాల్యూమ్ 'కీ'లను ఐదు సెకన్ల పాటు నొక్కి, పట్టుకోండి.</translation>
<translation id="4899696330053002588">యాడ్‌లను కలిగి ఉంది</translation>
<translation id="49027928311173603">సర్వర్ నుండి డౌన్‌లోడ్ చేసిన విధానం చెల్లదు: <ph name="VALIDATION_ERROR" />.</translation>
<translation id="4941246025622441835">డివైజ్‌ను ఎంటర్‌ప్రైజ్ మేనేజ్‌మెంట్ కోసం ఎన్‌రోల్ చేసేటప్పుడు ఈ డివైజ్ రిక్వెస్ట్‌ను ఉపయోగించండి:</translation>
<translation id="4944310289250773232">ఈ ప్రమాణీకరణ సేవ <ph name="SAML_DOMAIN" /> ద్వారా హోస్ట్ చేయబడుతోంది</translation>
<translation id="4955710816792587366">మీ పిన్ ఎంచుకోండి</translation>
<translation id="4965808351167763748">Hangouts Meetను అమలు చేసేలా ఈ డివైజ్‌ను ఖచ్చితంగా సెటప్ చేయాలని అనుకుంటున్నారా?</translation>
<translation id="4987944280765486504">డౌన్‌లోడ్ పూర్తయిన తర్వాత మీ Chromebook రీస్టార్ట్ అవుతుంది, అప్పుడు మీరు సెటప్‌ను కొనసాగించవచ్చు.</translation>
<translation id="5029287942302939687">మీ పాస్‌వర్డ్ సెట్ చేయబడింది</translation>
<translation id="503155457707535043">యాప్‌లు డౌన్‌లోడ్ చేయబడుతున్నాయి</translation>
<translation id="5045550434625856497">సరికాని పాస్‌వర్డ్</translation>
<translation id="5062930723426326933">సైన్-ఇన్ విఫలమైంది, దయచేసి ఇంటర్నెట్‌కు కనెక్ట్ చేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="5085162214018721575">అప్‌డేట్‌ల కోసం చెక్ చేస్తోంది</translation>
<translation id="5097306410549350357">లొకేషన్‌ను ఉపయోగించడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="5107486920067578245"><ph name="BEGIN_PARAGRAPH1" />Google AIతో రాయడం, ప్లాన్ చేయడం, నేర్చుకోవడం, ఇంకా మరెన్నో చేయడానికి Geminiతో చాట్ చేయండి.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />సెటప్ చేసిన తర్వాత, Geminiని ఉపయోగించడం ప్రారంభించడానికి మీ షెల్ఫ్‌లో స్క్రీన్ దిగువున ఉన్న Gemini యాప్‌ను ఎంచుకోండి.<ph name="END_PARAGRAPH2" /></translation>
<translation id="5115309401544567011">దయచేసి మీ <ph name="DEVICE_TYPE" />ని ఛార్జింగ్ పెట్టండి</translation>
<translation id="5145876360421795017">డివైజ్‌ను ఎన్‌రోల్ చేయవద్దు</translation>
<translation id="5147516217412920887">మీ ఫోన్‌లోని సూచనలను ఫాలో అయ్యి, కోడ్‌ను వెరిఫై చేయండి</translation>
<translation id="5160857336552977725">మీ <ph name="DEVICE_TYPE" />కు సైన్ ఇన్ చేయండి</translation>
<translation id="5171185788583376591"><ph name="BEGIN_H3" />డీబగ్గింగ్ ఫీచర్‌లు<ph name="END_H3" />
      <ph name="BR" />
      మీరు మీ డివైజ్‌లో అనుకూల కోడ్‌ను ఇన్‌స్టాల్ చేసి టెస్ట్ చేయడానికి, మీ ChromeOS Flex డివైజ్‌లో డీబగ్గింగ్ ఫీచర్‌లను ఎనేబుల్ చేయవచ్చు.  ఇది వీటిని చేయడానికి మిమ్మల్ని అనుమతిస్తుంది:<ph name="BR" />
      <ph name="BEGIN_LIST" />
        <ph name="LIST_ITEM" />rootfs వెరిఫికేషన్‌ను తీసివేయడానికి; తద్వారా మీరు OS ఫైల్స్‌ను మాడిఫై చేయవచ్చు
        <ph name="LIST_ITEM" />స్టాండర్డ్ టెస్ట్ 'కీ'లను ఉపయోగించి డివైజ్‌కు SSH యాక్సెస్‌ను ఎనేబుల్ చేయడానికి; తద్వారా మీరు డివైజ్‌ను యాక్సెస్ చేయడానికి <ph name="BEGIN_CODE" />'cros flash'<ph name="END_CODE" /> వంటి టూల్స్‌ను ఉపయోగించవచ్చు
        <ph name="LIST_ITEM" />USB నుండి బూట్ చేయడాన్ని ఎనేబుల్ చేయడానికి; తద్వారా మీరు USB డ్రైవర్ నుండి OS ఇమేజ్‌ను ఇన్‌స్టాల్ చేయవచ్చు
        <ph name="LIST_ITEM" />డెవలపర్ అలాగే సిస్టమ్ రూట్ లాగిన్, పాస్‌వర్డ్, రెండింటినీ అనుకూల విలువకు సెట్ చేయడానికి; తద్వారా మీరు డివైజ్‌లోకి మాన్యువల్‌గా SSH చేయవచ్చు
      <ph name="END_LIST" />
      <ph name="BR" />
      ఎనేబుల్ చేసిన తర్వాత, ఎంటర్‌ప్రయిజ్ ద్వారా మేనేజ్ అయ్యే డివైజ్‌లో డేటాను పవర్‌వాష్ చేసిన తర్వాత లేదా పూర్తిగా తొలగించిన తర్వాత కూడా చాలా వరకు డీబగ్గింగ్ ఫీచర్‌లు ఎనేబుల్ అయ్యి ఉంటాయి. అన్ని డీబగ్గింగ్ ఫీచర్‌లను పూర్తిగా డిజేబుల్ చేయడానికి, ChromeOS రికవరీ ప్రాసెస్‌ను పూర్తి చేయండి (https://support.google.com/chromebook/answer/1080595).
      <ph name="BR" />
      <ph name="BR" />
      డీబగ్గింగ్ ఫీచర్‌ల గురించి మరింత సమాచారం కోసం ఈ పేజీకి వెళ్లండి:<ph name="BR" />
      https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
      <ph name="BR" />
      <ph name="BR" />
      <ph name="BEGIN_BOLD" />గమనిక:<ph name="END_BOLD" />  ప్రాసెస్ సమయంలో సిస్టమ్ రీబూట్ అవుతుంది.</translation>
<translation id="5215502535566372932">దేశాన్ని ఎంచుకోండి</translation>
<translation id="5234523649284990414">ChromeOSలో, ChromeVoxలో ఉండే స్క్రీన్ రీడర్‌ను, ప్రధానంగా అంధత్వం ఉన్న వారు, లేదా దృష్టి లోపం ఉన్న వారు, స్క్రీన్ మీద డిస్‌ప్లే అయ్యే టెక్స్ట్‌ను చదవడానికి ఉపయోగిస్తారు, ఇందు కోసం స్పీచ్ సింథసైజర్‌ను లేదా బ్రెయిలీ డిస్‌ప్లేను ఉపయోగించడం జరుగుతుంది. ChromeVoxను ఆన్ చేయడానికి స్పేస్ బార్‌ను నొక్కండి. ChromeVoxను యాక్టివేట్ చేసినప్పుడు, మీకు ఒక క్విక్ టూర్ అందించబడుతుంది.</translation>
<translation id="523505283826916779">యాక్సెస్‌ సెట్టింగ్‌లు</translation>
<translation id="5240931875940563122">Android ఫోన్‌తో సైన్ ఇన్ చేయండి</translation>
<translation id="5255859108402770436">మళ్లీ సైన్ ఇన్ చేయండి</translation>
<translation id="5260508466980570042">క్షమించండి, మీ ఈమెయిల్‌ లేదా పాస్‌వర్డ్ ధృవీకరించబడలేదు. దయచేసి మళ్ళీ ప్రయత్నించండి.</translation>
<translation id="5264252276333215551">మీ యాప్‌ను కియోస్క్ మోడ్‌లో ప్రారంభించడానికి దయచేసి ఇంటర్నెట్‌కు కనెక్ట్ చేయండి.</translation>
<translation id="528208740344463258">Android యాప్‌లను డౌన్‌లోడ్ చేసి, ఉపయోగించడం కోసం, ముందుగా మీరు ఈ అవసరమైన అప్‌డేట్‌ను ఇన్‌స్టాల్ చేయాలి. మీ <ph name="DEVICE_TYPE" /> అప్‌డేట్ అవుతున్న సమయంలో, మీరు దీనిని ఉపయోగించలేరు. ఇన్‌స్టాల్ చేయడం పూర్తయిన తర్వాత, మీ <ph name="DEVICE_TYPE" /> పునఃప్రారంభించబడుతుంది.</translation>
<translation id="5283677936944177147">అయ్యో!  పరికర మోడల్ లేదా క్రమ సంఖ్యను గుర్తించడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="5333896723098573627">యాప్‌లను తీసివేయడానికి, సెట్టింగ్‌లు &gt; యాప్‌లు &gt; Google Play Store &gt; Android ప్రాధాన్యతలను మేనేజ్ చేయండి &gt; యాప్‌లు లేదా యాప్ మేనేజర్‌కు వెళ్లండి. ఆ తర్వాత, మీరు అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్న యాప్‌ను ట్యాప్ చేయండి (మీరు యాప్‌ను కనుగొనడానికి ఎడమ లేదా కుడి వైపునకు స్వైప్ చేయాల్సి ఉంటుంది). ఆపై, అన్ఇన్‌స్టాల్ చేయండి లేదా డిజేబుల్ చేయండిని ట్యాప్ చేయండి.</translation>
<translation id="5355501370336370394">ఎంటర్‌ప్రైజ్ పరికరంలో ఎన్‌రోల్ అవ్వండి</translation>
<translation id="5372529912055771682">సరఫరా చేయబడిన నమోదు మోడ్‌ను, ఆపరేటింగ్ సిస్టమ్ యొక్క ఈ వెర్షన్ మద్దతివ్వదు. మీరు తాజా వెర్షన్‌ను అమలు చేస్తున్నారని దయచేసి నిర్ధారించుకుని, మళ్లీ ట్రై చేయండి.</translation>
<translation id="5397378439569041789">kioskకు లేదా సంకేత చిహ్నాల పరికరంలో ఎన్‌రోల్ అవ్వండి</translation>
<translation id="5397794290049113714">మీరు</translation>
<translation id="5411022484772257615">స్కూల్ ఎన్‌రోల్‌మెంట్‌ను పూర్తి చేయడం సాధ్యపడలేదు</translation>
<translation id="5413640305322530561">సమస్య విశ్లేషణ, వినియోగ డేటా గురించి మరింత తెలుసుకోండి</translation>
<translation id="542750953150239272">కొనసాగించడం ద్వారా, మీరు ఈ పరికరం ఆటోమేటిక్‌గా Google, మీ క్యారియర్, మీ పరికర తయారీదారు నుండి సెల్యులార్ డేటాతో కూడా అప్‌డేట్‌లు, యాప్‌లను డౌన్‌లోడ్ చేసి, ఇన్‌స్టాల్ చేయవచ్చని మీరు అంగీకరిస్తున్నారు. ఈ యాప్‌లలో కొన్ని, 'యాప్‌లోని కొనుగోళ్ల'ను ఆఫర్ చేయవచ్చు.</translation>
<translation id="542948651837270806">విశ్వసనీయ ప్లాట్‌ఫామ్ మాడ్యూల్ ఫర్మ్‌వేర్ కోసం అప్‌డేట్‌ను ఇన్‌స్టాల్ చేయాలి. <ph name="TPM_FIRMWARE_UPDATE_LINK" />ను చూడండి</translation>
<translation id="5448293924669608770">అయ్యో, సైన్ ఇన్ చేయడంలో ఏదో తప్పు జరిగింది</translation>
<translation id="5453829744223920473">మీ చిన్నారి, వారి స్కూల్ యాప్‌లను, బుక్‌మార్క్‌లను, ఇంకా రిసోర్స్‌లన్నింటినీ క్లాస్‌లో ఎలా అయితే ఉపయోగిస్తారో, ఆలాగే ఉపయోగించగలరు. ప్రాథమిక నియమాలను స్కూల్ సెట్ చేస్తుంది.</translation>
<translation id="5463450804024056231"><ph name="DEVICE_TYPE" /> ఈమెయిల్స్ కోసం సైన్ అప్ చేయండి</translation>
<translation id="5473099001878321374">కొనసాగించడం ద్వారా, ఈ పరికరం Google, మీ చిన్నారి క్యారియర్, అలాగే ఈ పరికర తయారీదారు నుండి ఆటోమేటిక్‌గా అప్‌డేట్‌లను, యాప్‌లను డౌన్‌లోడ్ చేసి, ఇన్‌స్టాల్ చేయవచ్చని ఇందుకు సెల్యులార్ డేటా ఉపయోగించబడవచ్చని మీరు అంగీకరిస్తున్నారు. ఈ యాప్‌లలో కొన్ని, 'యాప్‌లో కొనుగోళ్ల'ను ఆఫర్‌ చేయవచ్చు.</translation>
<translation id="5502915260472117187">చిన్నారి</translation>
<translation id="5511823366942919280">మీరు ఖచ్చితంగా ఈ డివైజ్‌ను "షార్క్"గా సెటప్ చేయాలని అనుకుంటున్నారా?</translation>
<translation id="5513807280330619196">క్యాలిక్యులేటర్</translation>
<translation id="5527474464531963247">మీరు మరొక నెట్‌వర్క్‌ను కూడా ఎంచుకోవచ్చు.</translation>
<translation id="5539070192556911367">Googleను చేరుకోవడం సాధ్యం కాలేదు</translation>
<translation id="5549511085333906441">మీ సెటప్‌ను ఎంచుకోండి</translation>
<translation id="5554403733534868102">దీని తర్వాత, అప్‌డేట్‌ల కోసం వేచి ఉండాల్సిన అవసరం లేదు</translation>
<translation id="557722062034137776">మీ డివైజ్‌ను రీసెట్ చేయడం వలన మీ Google ఖాతాలపై లేదా ఈ ఖాతాలకు సింక్ చేయ‌బ‌డిన‌ ఏదైనా డేటాపై ఎటువంటి ప్రభావం ఉండదు. అయితే, మీ డివైజ్‌లో లోకల్‌గా సేవ్ చేయబడిన అన్ని ఫైళ్లు తొలగించబడతాయి.</translation>
<translation id="5600348067066185292">కొన్ని సులభమైన దశలలో ఇన్‌స్టాలేషన్ పూర్తవుతుంది. మీ కంప్యూటర్‌లో ఏవైనా మార్పులను చేసే ముందు మీకు నిర్ధారించుకోవడానికి మరో అవకాశం ఉంటుంది.</translation>
<translation id="5626172233890210551">బదులుగా పాస్‌వర్డ్‌ను ఉపయోగించండి</translation>
<translation id="5631304855083152608"><ph name="BEGIN_PARAGRAPH1" />అత్యుత్తమ ఎక్స్‌పీరియన్స్‌ను అందించడానికి, డివైజ్‌లకు సంబంధించిన హార్డ్‌వేర్ డేటాను <ph name="DEVICE_OS" /> సేకరిస్తుంది. అలాగే ఏ అప్‌డేట్‌లను డెలివరీ చేయాలో నిర్ణయించడం కోసం దీన్ని Googleకు షేర్ చేస్తుంది. మీరు కావాలనుకుంటే, <ph name="DEVICE_OS" /> ఎక్స్‌పీరియన్స్ &amp; సర్వీస్‌లను ఇంప్రూవ్ చేయడానికి, వాటికి సపోర్ట్ ఇవ్వడం వంటి అదనపు ప్రయోజనాల కోసం ఈ డేటాను Google ఉపయోగించేందుకు మీరు అనుమతించవచ్చు.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />అప్‌డేట్‌లను ఫిల్టర్ చేయడానికి Googleకు పంపిన డేటాను, అలాగే మీరు Googleతో డేటాను షేర్ చేయడానికి ఎంచుకున్న ఏ ఇతర సందర్భాలను అయినా చూడటానికి ఈ డివైజ్‌లో లాగిన్ చేసి, chrome://systemలో chromeosflex_inగా లిస్ట్ అయిన ఫీల్డ్‌లను చూడండి.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />Googleకు <ph name="DEVICE_OS" /> షేర్ చేసే డేటా గురించి, దాన్ని ఎలా ఉపయోగిస్తారు అనే దాని గురించి మరిన్ని వివరాల కోసం g.co/flex/HWDataCollectionకు వెళ్లండి.<ph name="END_PARAGRAPH3" /></translation>
<translation id="5636996382092289526">మీరు <ph name="NETWORK_ID" />ను ఉపయోగించడానికి మొదట కొన్నిసెకన్లలో ఆటోమేటిక్‌గా తెరవబడే <ph name="LINK_START" />నెట్‌వర్క్ సైన్ ఇన్ పేజీని సందర్శించాలి<ph name="LINK_END" />. ఇది జరగకపోతే, నెట్‌వర్క్‌ను ఉపయోగించలేరు.</translation>
<translation id="5641608986289282154"><ph name="DEVICE_OS" />ను ఉపయోగించడం ప్రారంభించండి</translation>
<translation id="5655296450510165335">పరికర ఎన్‌రోల్‌మెంట్</translation>
<translation id="565899488479822148">తాజా అప్‌డేట్‌ను ఇన్‌స్టాల్ చేస్తోంది</translation>
<translation id="5659964844710667266">ఈ <ph name="DEVICE_TYPE" /> కోసం పాస్‌వర్డ్‌ను క్రియేట్ చేయండి</translation>
<translation id="5684661240348539843">అసెట్ ఐడెంటిఫైయర్</translation>
<translation id="5684950556880280580">మీ పాస్‌వర్డ్ అప్‌డేట్ చేయబడింది</translation>
<translation id="5687326903064479980">సమయ మండలి</translation>
<translation id="5687935527303996204">మీ పరికరం ప్లగ్-ఇన్ చేసి ఉందని నిర్ధారించుకోండి, అలాగే దాన్ని ఆఫ్ చేయకండి. ఇన్‌స్టాలేషన్‌కు 20 నిమిషాల వరకు సమయం పట్టవచ్చు. ఇన్‌స్టాలేషన్ పూర్తయిన తర్వాత మీ పరికరం ఆటోమేటిక్‌గా షట్ డౌన్ అవుతుంది.</translation>
<translation id="5705882733397021510">వెనుకకు వెళ్లు</translation>
<translation id="5711010025974903573">సర్వీస్ లాగ్‌లు</translation>
<translation id="5762787084360227629">Google ఖాతా సమాచారాన్ని ఎంటర్ చేయండి</translation>
<translation id="5764797882307050727">దయచేసి మీ పరికరంలో కొంత స్థలాన్ని ఖాళీ చేయండి.</translation>
<translation id="5765425701854290211">క్షమించండి, కొన్ని ఫైళ్లు పాడయ్యాయి. అప్‌డేట్ విజయవంతం కాలేదు. మీ సింక్ చేసిన‌ ఫైళ్లు సురక్షితంగా ఉన్నాయి.</translation>
<translation id="5770125698810550803">నావిగేషన్ బటన్‌లను చూపు</translation>
<translation id="5793339252089865437">మీరు మీ మొబైల్ నెట్‌వర్క్ ద్వారా అప్‌డేట్‌ని డౌన్‌లోడ్ చేసినట్లయితే, అధిక ఛార్జ్‌లు చెల్లించాల్సి రావచ్చు.</translation>
<translation id="5799478978078236781"><ph name="DEVICE_TYPE" /> చిట్కాలు, ఆఫర్‌లతో పాటు అప్‌డేట్‌లను పొందండి, ఫీడ్‌బ్యాక్‌ను షేర్ చేయండి.</translation>
<translation id="5800703268655655701">లేత రంగు లేదా ముదురు రంగు రూపాన్ని ఎంచుకోండి</translation>
<translation id="5804259315582798390">లోకల్ డేటా రికవరీని ఎనేబుల్ చేయడం విఫలమైంది</translation>
<translation id="5810809306422959727">తల్లిదండ్రుల నియంత్రణల కోసం ఈ ఖాతాకు అర్హత లేదు</translation>
<translation id="5819206523222900309"><ph name="BEGIN_DESCRIPTION" />మీ డివైజ్‌లను సంస్థలో ఎన్‌రోల్ చేస్తే, ఒకే చోట నుండి మీ డివైజ్‌లన్నింటినీ మేనేజ్ చేసే వీలు ఏర్పడుతుంది. మీ సంస్థ, పలు కారణాలను దృష్టిలో ఉంచుకొని ఎన్‌రోల్ చేసుకోమని కోరవచ్చు:<ph name="END_DESCRIPTION" />
        <ph name="BEGIN_SUBTITLE1" /><ph name="BEGIN_BOLD" />సెక్యూరిటీ మెరుగవుతుంది<ph name="END_BOLD" /><ph name="END_SUBTITLE1" />
        <ph name="BEGIN_DESCRIPTION1" />అదనపు సెక్యూరిటీ సెట్టింగ్‌లను కాన్ఫిగర్ చేయడం ద్వారా, యూజర్‌ల డేటాను, డివైజ్‌ల డేటాను సంస్థ సురక్షితంగా ఉంచగలదు. రిమోట్‌గా రీసెట్ చేయడం లేదా పోయిన డివైజ్‌ను డిజేబుల్ చేయడం వంటి పనులు కూడా మీ సంస్థ చేయగలదు.<ph name="END_DESCRIPTION1" />
        <ph name="BEGIN_SUBTITLE2" /><ph name="BEGIN_BOLD" />ఎక్స్‌పీరియన్స్‌ను అనుకూలంగా మార్చవచ్చు<ph name="END_BOLD" /><ph name="END_SUBTITLE2" />
    <ph name="BEGIN_DESCRIPTION2" />డివైజ్ బూటప్ అయ్యేటప్పుడు, లాగిన్ స్క్రీన్‌పై, అలాగే లాగిన్ అయిన తర్వాత దాని పనితీరును సంస్థ అవసరాలకు అనుగుణంగా మార్చుకోవచ్చు.<ph name="END_DESCRIPTION2" />
        <ph name="BEGIN_SUBTITLE3" /><ph name="BEGIN_BOLD" />సపోర్ట్ అందుతుంది<ph name="END_BOLD" /><ph name="END_SUBTITLE3" />
        <ph name="BEGIN_DESCRIPTION3" />పరిష్కార ప్రక్రియను అందించడానికి, డివైజ్‌ సెషన్‌ను సంస్థ రిమోట్‌గా యాక్సెస్ చేయగలదు.<ph name="END_DESCRIPTION3" />
        <ph name="BEGIN_SUBTITLE4" /><ph name="BEGIN_BOLD" />యాక్సెస్‌ను ఎనేబుల్ చేయండి<ph name="END_BOLD" /><ph name="END_SUBTITLE4" />
        <ph name="BEGIN_DESCRIPTION4" />సంస్థకు చెందిన యాప్‌లు, సర్వీస్‌లు, నెట్‌వర్క్‌లు ఎన్‌రోల్ అయిన డివైజ్‌లలో మాత్రమే అందుబాటులో ఉండే అవకాశం ఉంది.<ph name="END_DESCRIPTION4" /></translation>
<translation id="5834581999798853053">సుమారు <ph name="TIME" /> నిమిషాలు మిగిలి ఉన్నాయి</translation>
<translation id="5852112051279473187">అయ్యో!  ఈ డివైజ్‌ను ఎన్‌రోల్ చేస్తున్నపుడు ఏదో తప్పిదం జరిగింది.  దయచేసి మరల ప్రయత్నించండి లేదా మీ సపోర్ట్ ప్రతినిధిని కాంటాక్ట్ చేయండి.</translation>
<translation id="5852137567692933493">పునఃప్రారంభించి, పవర్‌వాష్ చేయి</translation>
<translation id="5856721540245522153">డీబగ్గింగ్ ఫీచ‌ర్‌లను ప్రారంభించండి</translation>
<translation id="5860033963881614850">ఆఫ్ అయ్యింది</translation>
<translation id="5860491529813859533">ఆన్ చేయండి</translation>
<translation id="5863445608433396414">డీబగ్గింగ్ ఫీచ‌ర్‌లను ప్రారంభించండి</translation>
<translation id="5870086504539785141">యాక్సెస్‌ మెనూను మూసివేయండి</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="5895335062901455404">మీరు మీ Google ఖాతాతో సైన్ ఇన్ చేసినప్పుడు, ఏ ChromeOS Flex పరికరంలోనైనా మీరు సేవ్ చేసిన ప్రాధాన్యతలు, యాక్టివిటీ సిద్ధంగా ఉంటాయి. ఏది సింక్ చేయాలనే దాన్ని, మీరు సెట్టింగ్‌లలో ఎంచుకోవచ్చు.</translation>
<translation id="5916664084637901428">ఆన్‌లో ఉంది</translation>
<translation id="5919305207330938913">సేకరించబడిన మొత్తం డేటా <ph name="BEGIN_LINK" />Google గోప్యతా పాలసీ<ph name="END_LINK" />కి అనుగుణంగా ఉపయోగించబడుతుంది.</translation>
<translation id="5932441198730183141">ఈ Google Meet హార్డ్‌వేర్ డివైజ్‌ను ఎన్‌రోల్ చేయడానికి మీకు తగిన లైసెన్స్‌లు లేవు. మరిన్ని కొనుగోలు చేయడానికి దయచేసి సేల్స్‌ను కాంటాక్ట్ చేయండి. మీకు ఈ మెసేజ్ పొరపాటున వచ్చిందని మీరు విశ్వసిస్తే, దయచేసి సపోర్ట్ విభాగాన్ని కాంటాక్ట్ చేయండి.</translation>
<translation id="5933376509899483611">సమయ మండలి</translation>
<translation id="5939518447894949180">రీసెట్ చేయండి</translation>
<translation id="5948536763493709626">కీబోర్డ్ లేదా మౌస్‌ని కనెక్ట్ చేయండి లేదా మీ టచ్‌స్క్రీన్‌ను ఉపయోగించి సెటప్‌ను కొనసాగించండి. మీరు బ్లూటూత్ పరికరాలను ఉపయోగిస్తుంటే, అవి పెయిర్ చేయడానికి సిద్ధంగా ఉన్నాయని నిర్ధారించుకోండి.</translation>
<translation id="5959471481388474538">నెట్‌వర్క్ అందుబాటులో లేదు</translation>
<translation id="6016178549409952427"><ph name="TOTAL_ELEMENTS" />లో <ph name="CURRENT_ELEMENT" />వ అదనపు కంటెంట్‌కు నావిగేట్ చేయండి</translation>
<translation id="6016972670657536680">'భాష మరియు కీబోర్డ్‌ను ఎంచుకోండి' బటన్‌. ప్రస్తుతం ఎంచుకున్న భాష <ph name="LANGUAGE" />.</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="6042193169866365541">ఒకటే Google ఖాతాను మీరు Gmail, YouTube, Chrome, ఇతర Google ప్రోడక్ట్‌లలో ఉపయోగిస్తారు.
        మీ ఖాతాను ఉపయోగించి, మీ అన్ని బుక్‌మార్క్‌లు, ఫైల్స్, మరిన్నింటిని సులభంగా యాక్సెస్ చేయండి. మీకు ఖాతా లేకపోతే, తర్వాతి స్క్రీన్‌లో ఒక ఖాతాను క్రియేట్ చేయవచ్చు.</translation>
<translation id="6051354611314852653">అయ్యో!  ఈ పరికరం కోసం API యాక్సెస్‌ను ప్రామాణీకరించడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="6055544610007596637">Google Play Store నుండి మీ <ph name="DEVICE_TYPE" /> కోసం యాప్‌లను ఇన్‌స్టాల్ చేయండి</translation>
<translation id="6069464830445383022">మీ Google ఖాతాయే మీ Chromebook సైన్-ఇన్</translation>
<translation id="6071181508177083058">పాస్‌వర్డ్‌ను నిర్ధారించండి</translation>
<translation id="6075731018162044558">అయ్యో!  ఈ పరికరం కోసం దీర్ఘకాల API యాక్సెస్‌ టోకెన్‌ను పొందడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="6093888419484831006">అప్‌డేట్‌ రద్దు చేయడం...</translation>
<translation id="6125479973208104919">దురదృష్టవశాత్తూ, మీరు మీ ఖాతాను ఈ <ph name="DEVICE_TYPE" />కి మళ్లీ జోడించాలి.</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="6170498031581934115">ADB డీబగ్గింగ్‌ను ఎనేబుల్ చేయడం సాధ్యపడలేదు. సెట్టింగ్‌లకు వెళ్లి, ఆపై మళ్లీ ట్రై చేయండి.</translation>
<translation id="6172020488605056255">చదవడంలో సహాయం చేయాడాన్ని ఉపయోగించడానికి రైట్‌-క్లిక్ చేయండి</translation>
<translation id="6173623053897475761">మీ పిన్‌ని మళ్లీ టైప్ చేయండి</translation>
<translation id="6185132558746749656">పరికర స్థానం</translation>
<translation id="6202304368170870640">మీరు మీ పిన్‌ని ఉపయోగించి మీ పరికరంలో సైన్ ఇన్ చేయవచ్చు లేదా అన్‌లాక్ చేయవచ్చు.</translation>
<translation id="6209908325007204267">మీ పరికరంలో Chrome ఎంటర్‌ప్రైజ్ అప్‌గ్రేడ్ ఉంది, కానీ మీ యూజర్‌నేమ్ ఏ ఎంటర్‌ప్రైజ్ ఖాతాకు అనుబంధించబడి లేదు. వేరొక పరికరంలో g.co/ChromeEnterpriseAccountను సందర్శించడం ద్వారా దయచేసి ఒక ఎంటర్‌ప్రైజ్ ఖాతాను క్రియేట్ చేయండి.</translation>
<translation id="623261264391834964">'రాయడంలో సహాయపడు'ను ఉపయోగించడానికి, టెక్స్ట్ బాక్స్‌లో కుడి క్లిక్ చేయండి</translation>
<translation id="6264520534872750757">డివైజ్‌ను ఉపయోగించడం కొనసాగించండి</translation>
<translation id="6280215091796946657">వేరొక ఖాతాతో సైన్ ఇన్ చేయండి</translation>
<translation id="6283823201263716145">డెమో మోడ్ పరికరాలు ఫీచర్‌లను, పనితీరును మెరుగుపరచడంలో సహాయపడటానికి క్రాష్ రిపోర్ట్‌లను, అలాగే సమస్య విశ్లేషణను, వినియోగ డేటాను ఆటోమేటిక్‌గా Googleకు పంపుతాయి.</translation>
<translation id="6287713404380454515">సెక్యూరిటీ కారణాల దృష్ట్యా, మీ అడ్మినిస్ట్రేటర్ మీ డివైజ్ PINను, పాస్‌వర్డ్‌ను డిజేబుల్ చేశారు. ఇప్పటి నుండి, మీ <ph name="MANAGER" /> పాస్‌వర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="6301300352769835063"><ph name="DEVICE_OS" />‌ను మెరుగుపరచడంలో సహాయపడేందుకు మీ హార్డ్‌వేర్ డేటాను ఉపయోగించడానికి Googleకు అనుమతినివ్వండి. మీరు తిరస్కరిస్తే, సరైన అప్‌డేట్‌లను గుర్తించడానికి ఈ డేటా ఇప్పటికీ Googleకు పంపబడుతుంది, కానీ ఇది స్టోర్ చేయబడదు లేదా ఉపయోగించబడదు. g.co/flex/HWDataCollection లో మరింత తెలుసుకోండి.</translation>
<translation id="6308493641021088955"><ph name="EXTENSION_NAME" /> ద్వారా సైన్-ఇన్ అందించబడింది</translation>
<translation id="6314819609899340042">మీరు ఈ <ph name="IDS_SHORT_PRODUCT_NAME" /> పరికరంలో డీబగ్గింగ్ ఫీచ‌ర్‌లను విజయవంతంగా ప్రారంభించారు.</translation>
<translation id="6343262564968371601">Googleను, ఫైల్స్‌ను, యాప్‌లను మరిన్నింటిని సెర్చ్ చేయడం ద్వారా మీరు వెతుకుతున్న దాన్ని కనుగొనండి</translation>
<translation id="635609604405270300">డివైజ్‌ను ఆన్ చేసి ఉంచండి</translation>
<translation id="6363786367719063276">లాగ్‌లను చూడండి</translation>
<translation id="6367097275976877956">ChromeOSకు బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను మీరు యాక్టివేట్ చేసుకోవాలనుకుంటున్నారా? అలా చేయాలనుకుంటే, స్పేస్ బార్‌ను నొక్కండి.</translation>
<translation id="636850387210749493">ఎంటర్‌ప్రైజ్ నమోదు</translation>
<translation id="6380143666419481200">అంగీకరించి, కొనసాగండి</translation>
<translation id="640457954117263537">ChromeOSకు, Android యాప్స్, సర్వీస్‌ల కోసం లొకేషన్‌ను ఉపయోగించండి.</translation>
<translation id="6418311015934520372"><ph name="BEGIN_PARAGRAPH1" />ఆటోమేటిక్ రిపోర్ట్‌లను పంపడానికి మీ ChromeOS డివైజ్‌లను అనుమతించడం ద్వారా, ఏ సమస్యను ముందుగా పరిష్కరించి ChromeOSను మెరుగుపరచాలనే అంశాన్ని నిర్ణయించడం మాకు సులువు అవుతుంది. ChromeOS ఎప్పుడు క్రాష్ అయింది, మీరు ఏ ఫీచర్లను ఉపయోగిస్తున్నారు, సాధారణంగా మీరు ఎంత మెమరీని ఉపయోగిస్తారు వంటి అంశాలు కూడా ఈ రిపోర్ట్‌ల్లో ఉంటాయి.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీ Chrome డివైజ్ సెట్టింగ్స్‌లో ఈ రిపోర్ట్‌లను అనుమతించడాన్ని మీరు ఏ సమయంలోనైనా ప్రారంభించవచ్చు లేదా ఆపివేయవచ్చు. మీరు డొమైన్ అడ్మినిస్ట్రేటర్ అయితే, మీరు ఈ సెట్టింగ్‌ను అడ్మిన్ కన్సోల్‌లో మార్చవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6418511932144861495">కీలకమైన అప్‌డేట్‌ను ఇన్‌స్టాల్ చేయండి</translation>
<translation id="6452251728599530347"><ph name="PERCENT" /> పూర్తయింది</translation>
<translation id="6478849105642611893">క్విక్ ఇన్సర్ట్ కీ Tab కీ కింద ఉంటుంది</translation>
<translation id="6480327114083866287"><ph name="MANAGER" /> ద్వారా మేనేజ్ చేయబడుతోంది</translation>
<translation id="6488384360522318064">భాషను ఎంచుకోండి</translation>
<translation id="6495266441917713704">Wi-Fiని బదిలీ చేయడం సాధ్యపడదు</translation>
<translation id="6515620015470298987">డివైజ్ కాన్ఫిగరేషన్ చెక్ సమస్య కారణంగా సైన్ ఇన్ విఫలమైంది. దయచేసి మీ <ph name="DEVICE_TYPE" />‌ను ఫ్యాక్టరీ రీసెట్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="6519689855001245063">అర్హతను చెక్ చేస్తోంది</translation>
<translation id="6532527800157340614">మీ యాక్సెస్ టోకెన్‌ని పొందడం సాధ్యం కాలేదు కాబట్టి, సైన్ ఇన్ విఫలమైంది. దయచేసి మీ నెట్‌వర్క్ కనెక్షన్‌ను చెక్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="653920215766444089">కర్సర్‌ను నియంత్రించే పరికరం కోసం సెర్చ్ చేస్తోంది</translation>
<translation id="65513682072153627">ఒక సెట్టింగ్ లేదా ఫీచర్‌ను మీ అడ్మినిస్ట్రేటర్ మేనేజ్ చేస్తున్నప్పుడు, మీకు ఈ మేనేజ్ చేసే చిహ్నం కనిపిస్తుంది.</translation>
<translation id="6561726789132298588">enter</translation>
<translation id="6607890859198268021"><ph name="USER_EMAIL" />ను ఇప్పటికే <ph name="DOMAIN" /> మేనేజ్ చేస్తోంది. వేరొక Google ఖాతాతో తల్లిదండ్రుల నియంత్రణలను ఉపయోగించడానికి, సెటప్‌ను పూర్తి చేశాక సైన్ అవుట్ చేసి, ఆపై సైన్ ఇన్ స్క్రీన్‌పై ఉన్న "వ్యక్తిని జోడించండి"ను ఎంచుకోండి.</translation>
<translation id="6642720633335369752">తెరిచి ఉన్న అన్ని యాప్ విండోలనూ చూడటానికి, కింది నుండి పైకి స్వైప్ చేసి, పట్టుకోండి.</translation>
<translation id="6648911618876616409">ఒక ముఖ్యమైన అప్‌డేట్ ఇన్‌స్టాల్ కావడానికి సిద్ధంగా ఉంది. ప్రారంభించడానికి సైన్ ఇన్ చేయండి.</translation>
<translation id="6671497123040790595"><ph name="MANAGER" /> ద్వారా మేనేజ్‌మెంట్ సెటప్ చేయబడుతోంది</translation>
<translation id="6675665718701918026">కర్సర్‌ను నియంత్రించే పరికరం కనెక్ట్ చేయబడింది</translation>
<translation id="667752334740867460">Wi-Fi సమాచారాన్ని అందుకుంటోంది...</translation>
<translation id="6680442031740878064">అందుబాటులో ఉంది: <ph name="AVAILABLE_SPACE" /></translation>
<translation id="6684827949542560880">తాజా అప్‌డేట్‌ను డౌన్‌లోడ్ చేస్తోంది</translation>
<translation id="6722744767592605627">మీరు <ph name="EMAIL" />‌ను రికవర్ చేసుకోవచ్చు, కానీ లోకల్ డేటా తొలగించబడుతుంది.</translation>
<translation id="6748980958975836188">నేను <ph name="BEGIN_LINK1" />Google సర్వీస్ నియమాలు<ph name="END_LINK1" />, <ph name="BEGIN_LINK2" />Chrome, ఇంకా ChromeOS అదనపు సర్వీస్ నియమాలను<ph name="END_LINK2" /> చదివి అంగీకరిస్తున్నాను.</translation>
<translation id="6749473226660745022">Photos</translation>
<translation id="6754918760968695779">క్విక్ ఇన్సర్ట్</translation>
<translation id="6789834167207639931">తర్వాతి స్క్రీన్‌లో మీ Google ఖాతా పాస్‌వర్డ్‌ను మళ్లీ ఎంటర్ చేసి, రికవరీని పూర్తి చేయండి</translation>
<translation id="6797022073000660150"><ph name="BEGIN_PARAGRAPH1" />ఆటోమేటిక్ రిపోర్ట్‌లను పంపడానికి ChromeOS డివైజ్‌లను అనుమతించడం ద్వారా, ఏ సమస్యను ముందుగా పరిష్కరించి, ChromeOSను మెరుగుపరచాలనే అంశంపై నిర్ణయం తీసుకోవడం మాకు సులువు అవుతుంది. ఈ రిపోర్ట్‌ల్లో ChromeOS ఎప్పుడు క్రాష్ అయింది, ఏ ఫీచర్లను ఉపయోగించారు, సాధారణంగా ఎంత మెమరీని ఉపయోగించారు, Android యాప్‌లో డయాగ్నస్టిక్ &amp; యుసేజ్ (సమస్య విశ్లేషణ, వినియోగ) డేటా వంటి వివరాలు ఉంటాయి. కొంత అగ్రిగేటెడ్ (సమగ్ర) డేటా కూడా Google యాప్‌లకు, Android డెవలపర్‌ల వంటి పార్ట్‌నర్‌లకు ఉపయోగపడుతుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీ చిన్నారి ChromeOS డివైజ్ సెట్టింగ్స్‌లో ఈ రిపోర్ట్‌లను అనుమతించడాన్ని మీరు ఏ సమయంలోనైనా ప్రారంభించవచ్చు లేదా ఆపివేయవచ్చు. మీరు డొమైన్ అడ్మినిస్ట్రేటర్ అయితే, మీరు ఈ సెట్టింగ్‌ను అడ్మిన్ కన్సోల్‌లో మార్చవచ్చు.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH4" />మీ చిన్నారి Google ఖాతాకు వెబ్ &amp; యాప్ యాక్టివిటీ సెట్టింగ్‌ను ఆన్ చేసినట్లయితే, మీ చిన్నారి డేటా వారి Google ఖాతాలో సేవ్ కావచ్చు. ఈ సెట్టింగ్స్ గురించి, వాటిని ఎలా అడ్జస్ట్ చేయాలనే దాని గురించి families.google.comలో మరింత తెలుసుకోండి.<ph name="END_PARAGRAPH4" /></translation>
<translation id="6800893479155997609">మీ <ph name="DEVICE_TYPE" /> కోసం టాప్ యాప్‌లు</translation>
<translation id="6818802132960437751">అంతర్నిర్మిత వైరస్ రక్షణ</translation>
<translation id="682971198310367122">Google గోప్యతా పాలసీ</translation>
<translation id="6835762382653651563">దయచేసి మీ <ph name="DEVICE_TYPE" />ని అప్‌డేట్ చేయడానికి ఇంటర్నెట్‌కి కనెక్ట్ చేయండి.</translation>
<translation id="6839916869147598086">సైన్-ఇన్ మార్చబడింది</translation>
<translation id="6852529053326738838">మీ ఖాతాకు అర్హత ఉందో లేదో చెక్ చేయడానికి, మీ సంస్థను అడగండి, లేదా మీ వర్క్ ఈమెయిల్‌తో ఎన్‌రోల్ అవ్వండి.</translation>
<translation id="6867671714894555998">కొత్త కీబోర్డ్‌తో పనులను త్వరగా పూర్తి చేయండి</translation>
<translation id="6881845890692344060">మీ అడ్మినిస్ట్రేటర్ లాగ్ అవుట్ చేశారు. మీరు ఇప్పుడు కంట్రోల్‌లో ఉన్నారు.</translation>
<translation id="6883319974225028188">అయ్యో!  పరికర కాన్ఫిగరేషన్‌ను సేవ్ చేయడంలో సిస్టమ్ విఫలమైంది.</translation>
<translation id="6888831646723563669">కనెక్ట్ అయ్యి, మీ కొత్త <ph name="DEVICE_TYPE" />‌లో ఫీచర్‌లన్నింటినీ ఆస్వాదించండి</translation>
<translation id="6890053850723168825"><ph name="BEGIN_PARAGRAPH1" />యాప్ డేటా అనేది, (డెవలపర్ సెట్టింగ్స్ ఆధారంగా) కాంటాక్ట్‌లు, మెసేజ్‌లు, ఫోటోల వంటి డేటాతో పాటు యాప్ సేవ్ చేసిన ఎలాంటి డేటా అయినా కావచ్చు. బ్యాకప్ డేటా మీ చిన్నారి Drive స్టోరేజ్ కోటాలో కౌంట్ అవదు.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీరు ఈ సర్వీస్‌ను సెట్టింగ్స్‌లో ఆఫ్ చేయవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="6897688156970667447">తక్కువ వెలుతురు ఉన్న దగ్గర సహాయకరంగా ఉంటుంది, బ్యాటరీని సేవ్ చేస్తుంది</translation>
<translation id="6903907808598579934">సింక్‌ను ఆన్ చేయి</translation>
<translation id="6918733588290914545">Android ఫోన్‌తో క్విక్ సెటప్</translation>
<translation id="6920473853105515518">మీ <ph name="DEVICE_TYPE" /> పరికరం ఇంటర్నెట్‌కు కనెక్ట్ అయ్యి ఉందని నిర్ధారించుకుని, మళ్లీ ట్రై చేయండి. మరొక పరికరంలో మీరుplay.google/play-term లింక్‌కు కూడా వెళ్లవచ్చు.</translation>
<translation id="6929126689972602640">పాఠశాల ఖాతాలకు తల్లిదండ్రుల కంట్రోల్స్ సపోర్ట్ చేయబడవు. ఇంట్లో పాఠశాల విద్య కోసం Google Classroom, అలాగే ఇతర వెబ్‌సైట్‌లను యాక్సెస్ చేసేందుకు పాఠశాల ఖాతాను జోడించడానికి, ముందుగా మీ చిన్నారి వ్యక్తిగత ఖాతా నుండి సైన్ ఇన్ చేయండి. మీరు సెటప్‌లో పాఠశాల ఖాతాను తర్వాత జోడించవచ్చు.</translation>
<translation id="6935031746833428401">పరికర మేనేజ్‌మెంట్ గురించి మరింత తెలుసుకోండి</translation>
<translation id="6950351336108213154">డివైజ్ పెరిఫెరల్స్‌ను అప్‌డేట్ చేస్తోంది</translation>
<translation id="6955698182324067397">మీరు ChromeOS డీబగ్గింగ్ ఫీచర్‌లను ఎనేబుల్ చేస్తున్నారు, ఇది sshd daemonను సెటప్ చేస్తుంది అలాగే USB డిస్క్‌ల నుండి బూట్ చేయడాన్ని ఎనేబుల్ చేస్తుంది.</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="6969216690072714773">ఈ పరికరంతో అనుబంధించడానికి కొత్త సమాచారాన్ని ఎంటర్ చేయండి లేదా ఇప్పటికే ఉన్న సమాచారాన్ని అప్‌డేట్ చేయండి.</translation>
<translation id="6981982820502123353">యాక్సెసిబిలిటీ</translation>
<translation id="6984652455487792101">మీరు ప్రాక్సీ సర్వర్‌ను ఉపయోగిస్తుంటే, ప్రాక్సీ సర్వర్ పని చేస్తోందని
    చెక్ చేయడానికి మీ ప్రాక్సీ సెట్టింగ్‌లను చెక్ చేయండి లేదా మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి. మీరు ప్రాక్సీ సర్వర్‌ను ఉపయోగించాల్సిన అవసరం లేదని మీరు అనుకుంటే, మీ <ph name="LINK_START" />ప్రాక్సీ సెట్టింగ్‌ల<ph name="LINK_END" />ను అడ్జస్ట్ చేయండి.</translation>
<translation id="6996245928508281884">మీ ఫోన్ బ్లూటూత్‌ను, Wi-Fiను ఆన్ చేయండి</translation>
<translation id="6996438701394974959">డిస్‌ప్లే, టెక్స్ట్ సైజ్‌ను పెంచండి</translation>
<translation id="6998793565256476099">వీడియో మీటింగ్‌ కోసం డివైజ్‌ను ఎన్‌రోల్ చేయండి</translation>
<translation id="7025082428878635038">సంజ్ఞలతో నావిగేట్ చేయడానికి కొత్త మార్గాన్ని మీకు అందిస్తున్నాము</translation>
<translation id="7034692021407794547">బిల్లింగ్ మేనేజ్‌మెంట్ ప్రత్యేక హక్కులతో ఉన్న అడ్మినిస్ట్రేటర్ మొదట అడ్మిన్ కన్సోల్‌లోని Google Meet హార్డ్‌వేర్ విభాగంలో Google Meet హార్డ్‌వేర్ సర్వీస్ నియమాలను అంగీకరించాలి.</translation>
<translation id="7039951224110875196">చిన్నారి కోసం Google ఖాతాను క్రియేట్ చేయండి</translation>
<translation id="7065223852455347715">ఎంటర్‌ప్రైజ్ ఎన్‌రోల్‌మెంట్ నిరోధించే మోడ్‌లో ఈ డివైజ్ లాక్ చేయబడింది. మీరు డివైజ్ ఎన్‌రోల్ చేయాలనుకుంటే ముందుగా డివైజ్‌ను రికవరీ చేయాలి.</translation>
<translation id="7066572364168923329">మీ <ph name="DEVICE_TYPE" /> సెటప్‌ను ఎంచుకోండి</translation>
<translation id="7077829361966535409">సైన్ ఇన్ పేజీ ప్రస్తుత ప్రాక్సీ సెట్టింగ్‌లను ఉపయోగించి లోడ్ కావడంలో విఫలమైంది. దయచేసి <ph name="GAIA_RELOAD_LINK_START" />మళ్లీ సైన్ ఇన్ చేయడానికి ప్రయత్నించండి<ph name="GAIA_RELOAD_LINK_END" /> లేదా విభిన్న <ph name="PROXY_SETTINGS_LINK_START" />ప్రాక్సీ సెట్టింగ్‌ల<ph name="PROXY_SETTINGS_LINK_END" />ను ఉపయోగించండి.</translation>
<translation id="7088674813905715446">అడ్మినిస్ట్రేటర్, ఈ డివైజ్‌ను డీ-ప్రొవిజన్‌డ్ స్టేటస్‌లో (ఎవరికీ కేటాయించని స్థితిలో) ఉంచారు. ఎన్‌రోల్‌మెంట్ కోసం దీన్ని ఎనేబుల్ చేయడానికి, ఈ డివైజ్‌ను పెండింగ్ స్టేటస్‌లో పెట్టమని మీ అడ్మినిస్ట్రేటర్‌ను అడగండి.</translation>
<translation id="7114054701490058191">పాస్‌‌వర్డ్‌లు సరిపోలలేదు</translation>
<translation id="7135729336746831607">బ్లూటూత్ ఆన్ చేయాలా?</translation>
<translation id="7141105143012495934">మీ ఖాతా వివరాలను తిరిగి పొందలేనందున సైన్-ఇన్ విఫలమైంది. దయచేసి మీ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి లేదా మళ్లీ ట్రై చేయండి.</translation>
<translation id="7144878232160441200">మళ్లీ ట్రై చేయండి</translation>
<translation id="7149839598364933473">ఈ డివైజ్‌ను <ph name="DEVICE_OS" /> డివైజ్‌గా మార్చండి.</translation>
<translation id="7171259390164035663">నమోదు చేసుకోవద్దు</translation>
<translation id="7189451821249468368">ఈ డివైజ్‌ను ఎన్‌రోల్ చేయడానికి మీకు తగిన అప్‌గ్రేడ్‌లు లేవు. దయచేసి మరిన్నింటిని కొనుగోలు చేయడానికి విక్రయ కేంద్రాన్ని కాంటాక్ట్ చేయండి. మీకు ఈ మెసేజ్ పొరపాటున వచ్చిందని మీరు విశ్వసిస్తే, దయచేసి సపోర్ట్ విభాగాన్ని సంప్రదించండి.</translation>
<translation id="7202337678781136582">మీ Android ఫోన్‌తో QR కోడ్‌ను స్కాన్ చేయండి</translation>
<translation id="7228854227189381547">మార్చవద్దు</translation>
<translation id="7230881857327093958">సెటప్ చేసిన తర్వాత మార్పులు వర్తించబడతాయి</translation>
<translation id="7260186537988033909">కియోస్క్, సంకేత చిహ్నాల పరికరంలో ఎన్‌రోల్ అవ్వడం పూర్తయింది</translation>
<translation id="7284411326658527427">ప్రతి వ్యక్తి వారి ఖాతాను వ్యక్తిగతీకరించుకోవచ్చు, అలాగే వారి డేటాను ప్రైవేట్‌గా ఉంచుకోవచ్చు.</translation>
<translation id="7290242001003353852"><ph name="SAML_DOMAIN" /> హోస్ట్ చేసిన ఈ సైన్-ఇన్ సేవ, మీ కెమెరాను యాక్సెస్ చేస్తోంది.</translation>
<translation id="7311005168897771689">మీరు ఆఫ్‌లైన్‌లో ఉన్నప్పుడు మీ Google Drive ఫైల్స్‌ను యాక్సెస్ చేయండి</translation>
<translation id="7317831949569936035">స్కూల్ ఎన్‌రోల్‌మెంట్</translation>
<translation id="7326004502692201767">ఈ <ph name="DEVICE_TYPE" />ను చిన్నారి కోసం సెటప్ చేయండి</translation>
<translation id="732659786514229249">ఈ డివైజ్‌ను మీ సంస్థలో ఎన్‌రోల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="7329154610228416156">సెక్యూర్ కాని URL (<ph name="BLOCKED_URL" />)ను ఉపయోగించేలా కాన్ఫిగర్ చేయబడినందున సైన్-ఇన్ విఫలమైంది. దయచేసి మీ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి.</translation>
<translation id="7345706641791090287">మీ పాస్‌వర్డ్‌ను నిర్ధారించండి</translation>
<translation id="7348093485538360975">ఆన్-స్క్రీన్ కీబోర్డ్</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="7403642243184989645">రిసోర్స్‌ను డౌన్‌లోడ్ చేస్తోంది</translation>
<translation id="7406912950279255498">కలర్ మార్పిడి మోడ్</translation>
<translation id="7416263748877373774">సర్వీస్ నియమాలను లోడ్ చేయడం సాధ్యపడదు. దయచేసి మీ నెట్‌వర్క్ కనెక్షన్‌ను చెక్ చేసి, ఆపై మళ్లీ ట్రై చేయండి.</translation>
<translation id="7475742997309661417">ChromeOSలో, ChromeVoxలో ఉండే స్క్రీన్ రీడర్‌ను, ప్రధానంగా అంధత్వం ఉన్న వారు, లేదా దృష్టి లోపం ఉన్న వారు, స్క్రీన్ మీద డిస్‌ప్లే అయ్యే టెక్స్ట్‌ను చదవడానికి ఉపయోగిస్తారు, ఇందు కోసం స్పీచ్ సింథసైజర్‌ను లేదా బ్రెయిలీ డిస్‌ప్లేను ఉపయోగించడం జరుగుతుంది. ChromeVoxను ఆన్ చేయడానికి రెండు వాల్యూమ్ కీలనూ అయిదు సెకన్ల పాటు నొక్కి, పట్టుకోండి. ChromeVoxను యాక్టివేట్ చేసినప్పుడు, మీకు ఒక క్విక్ టూర్ అందించబడుతుంది.</translation>
<translation id="7476454130948140105">అప్‌డేట్ చేయడానికి తగినంత బ్యాటరీ ఛార్జింగ్ లేదు (<ph name="BATTERY_PERCENT" />%)</translation>
<translation id="7504187084873714912"><ph name="BEGIN_PARAGRAPH1" />ఎన్‌రోల్ చేసే ముందు, మీరు TPMను క్లియర్ చేయాల్సి ఉంటుంది, తద్వారా డివైజ్ యాజమాన్య హక్కును <ph name="DEVICE_OS" /> తీసుకోగలుగుతుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీరు TPM డివైజ్‌ను మొత్తానికి కూడా ఆఫ్ చేయవచ్చు. మీ డేటా, సాఫ్ట్‌వేర్ ఎన్‌క్రిప్షన్ ద్వారా ఇప్పటికీ భద్రంగా స్టోర్ చేయబడుతుంది, కానీ హార్డ్‌వేర్ సపోర్ట్‌ను కలిగి ఉన్న సర్టిఫికెట్‌ల వంటి కొన్ని సెక్యూరిటీ ఫీచర్‌లు డిజేబుల్ అవుతాయి.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />సిస్టమ్ BIOS/UEFI సెట్టింగ్‌లను రీబూట్ చేయడం, ఇంకా ఎంటర్ చేయడం ద్వారా మీరు మీ TPM సెట్టింగ్‌లను మార్చవచ్చు. డివైజ్ మోడల్ ఆధారంగా దశలు మారుతూ ఉంటాయి. మరింత సమాచారం కోసం, మీరు రీబూట్ చేసే ముందు <ph name="DEVICE_OS" /> డాక్యుమెంటేషన్‌ను వేరొక డివైజ్‌లో తెరవండి: g.co/flex/TPMHelp.<ph name="END_PARAGRAPH3" /></translation>
<translation id="7506541170099744506">మీ <ph name="DEVICE_TYPE" /> ఎంటర్‌ప్రైజ్ నిర్వహణ కోసం విజయవంతంగా నమోదు చేయబడింది.</translation>
<translation id="7509097596023256288">మేనేజ్‌మెంట్ సెటప్ చేయబడుతోంది</translation>
<translation id="7543104066686362383">ఈ <ph name="IDS_SHORT_PRODUCT_NAME" /> పరికరంలో డీబగ్గింగ్ ఫీచ‌ర్‌లను ప్రారంభించండి</translation>
<translation id="7544227555407951270">డివైజ్‌ను ఎన్‌రోల్ చేయండి</translation>
<translation id="7549434883223124329">పరికర భాషను మార్చాలా?</translation>
<translation id="7553242001898162573">మీ పాస్‌వర్డ్‌ను నమోదు చేయండి</translation>
<translation id="7556242789364317684">దురదృష్టవశాత్తూ, <ph name="SHORT_PRODUCT_NAME" /> మీ సెట్టింగ్‌లను రికవర్ చేయలేకపోయింది. ఎర్రర్‌ను ఫిక్స్ చేయడానికి, <ph name="SHORT_PRODUCT_NAME" /> మీ డివైజ్‌ను తప్పనిసరిగా పవర్‌వాష్‌తో రీసెట్ చేయాలి.</translation>
<translation id="7560756177962144929">మీ <ph name="DEVICE_TYPE" />‌ను సింక్ చేయండి</translation>
<translation id="7571643774869182231">అప్‌డేట్ కోసం తగినంత స్టోరేజ్‌ లేదు</translation>
<translation id="7616214729753637086">డివైజ్‌ను ఎన్‌రోల్ చేస్తోంది...</translation>
<translation id="7619937211696316184">మెయిన్‌టెనెన్స్ పూర్తయింది</translation>
<translation id="7622114377921274169">ఛార్జింగ్.</translation>
<translation id="7630426712700473382">ఈ పరికరం <ph name="MANAGER" /> ద్వారా మేనేజ్ చేయబడుతోంది, మీరు ప్రతిసారి సైన్ ఇన్ చేయాల్సి ఉంటుంది.</translation>
<translation id="7633724038415831385">ఈ ఒక్క సమయంలో మాత్రమే మీరు అప్‌డేట్ కోసం వేచి ఉండాల్సి వస్తుంది. Chromebookలో, సాఫ్ట్‌వేర్ అప్‌డేట్‌లు బ్యాక్‌గ్రౌండ్‌లోనే జరుగుతాయి.</translation>
<translation id="7639914187072011620">సర్వర్ నుండి SAML మళ్లింపు URLను పొందడంలో విఫలమైంది</translation>
<translation id="7643117827468520640">ఈ నియమాలను రివ్యూ చేయండి</translation>
<translation id="7647504534168186939"><ph name="BEGIN_PARAGRAPH1" />యాప్ డేటా అనేది, (డెవలపర్ సెట్టింగ్స్ ఆధారంగా) కాంటాక్ట్‌లు, మెసేజ్‌లు, ఫోటోల వంటి డేటాతో పాటు యాప్ సేవ్ చేసిన ఎలాంటి డేటా అయినా కావచ్చు. బ్యాకప్ డేటా మీ Drive స్టోరేజ్ కోటాలో భాగంగా కౌంట్ కాదు.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీరు ఈ సర్వీస్‌ను సెట్టింగ్స్‌లో ఆఫ్ చేయవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="7659584679870740384">ఈ డివైజ్‌ను ఉపయోగించడానికి మీకు అధికారం లేదు. దయచేసి సైన్-ఇన్ అనుమతి కోసం అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి.</translation>
<translation id="7660116474961254898">మీ ఫోన్‌లోని సూచనలను ఫాలో అవ్వండి</translation>
<translation id="7661451191293163002">నమోదు ప్రమాణపత్రాన్ని పొందడం సాధ్యపడలేదు.</translation>
<translation id="7666531788977935712">కొనసాగించండి బటన్ ఎనేబుల్ చేయబడింది</translation>
<translation id="7671139479636735732">మీ ఐడియాలను సులభంగా విజువలైజ్ చేయడానికి రైట్-క్లిక్ చేయండి</translation>
<translation id="770831926727930011">మీ లోకల్ డేటాను మీ పాత పాస్‌వర్డ్ భద్రపరుస్తోంది. మీ పాత పాస్‌వర్డ్‌ను ఎంటర్ చేసి, లోకల్ డేటాను రికవర్ చేయండి.</translation>
<translation id="7722040605881499779">అప్‌డేట్ చేయడానికి కావాల్సిన స్థలం: <ph name="NECESSARY_SPACE" /></translation>
<translation id="7737115349420013392">"<ph name="DEVICE_NAME" />"తో పెయిర్ చేస్తోంది ...</translation>
<translation id="7746045113967198252">టెక్స్ట్‌తో సహా మీ స్క్రీన్‌పై ఉన్న ఐటెమ్‌లను, పెద్దగా లేదా చిన్నగా చేయండి. మీరు దీనిని తర్వాత కూడా సెట్టింగ్‌లు &gt; పరికరం &gt; డిస్‌ప్లేలు అనే ఆప్షన్‌లో కనుగొనవచ్చు.</translation>
<translation id="7760176388948986635">లొకేషన్ అనుమతి గల ChromeOS, Android యాప్‌లు, వెబ్‌సైట్‌లు, సర్వీస్‌లకు ఈ పరికర లొకేషన్‌ను ఉపయోగించడానికి అనుమతినివ్వండి. 'లొకేషన్ ఖచ్చితత్వం', Android యాప్‌లు, సర్వీస్‌లకు మరింత ఖచ్చితమైన లొకేషన్ సమాచారాన్ని అందిస్తుంది. దీన్ని చేయడానికి, ఈ పరికరం నుండి Google, పరికర సెన్సార్‌లు, వైర్‌లెస్ సిగ్నల్స్‌కు సంబంధించిన సమాచారాన్ని ప్రాసెస్ చేసి, వైర్‌లెస్ సిగ్నల్ లొకేషన్‌లను క్రౌడ్‌సోర్స్ చేస్తుంది. ఇవి ఏ వ్యక్తినీ గుర్తించకుండా 'లొకేషన్ ఖచ్చితత్వాన్ని', లొకేషన్ ఆధారిత సర్వీస్‌లను మెరుగుపరచడానికి, యూజర్ అవసరాలను తీర్చడానికి Google, థర్డ్-పార్టీల చట్టబద్ధమైన ప్రయోజనాలకు అనుగుణంగా Google సర్వీస్‌లను మెరుగుపరచడానికి, అందించడానికి, మెయిన్‌టెయిన్ వినియోగించబడతాయి.</translation>
<translation id="7784875615510899699">ఈ Google Beam డివైజ్‌ను ఎన్‌రోల్ చేయడానికి మీకు తగిన లైసెన్స్‌లు లేవు. మరిన్ని కొనుగోలు చేయడానికి దయచేసి మీ రీసెల్లర్‌ను సంప్రదించండి. మీకు ఈ మెసేజ్ పొరపాటున వచ్చిందని మీరు భావిస్తే, దయచేసి మీ రీసెల్లర్‌ను సంప్రదించండి.</translation>
<translation id="7791269138074599214">ఇన్‌పుట్ పద్ధతి</translation>
<translation id="7791436592012979144">రివర్స్ స్క్రోలింగ్ ఎనేబుల్ చేయబడింది</translation>
<translation id="7792012425874949788">సైన్ ఇన్ చేయడంలో ఏదో తప్పు జరిగింది</translation>
<translation id="780301667611848630">వద్దు</translation>
<translation id="7803657407897251194">మీ Android పరికరంతో సెటప్‌ను కొనసాగించడానికి, మీ <ph name="DEVICE_TYPE" />‌ను నెట్‌వర్క్‌కు కనెక్ట్ చేయండి</translation>
<translation id="7842692330619197998">మీరు కొత్త ఖాతాను సృష్టించాలనుకుంటే g.co/ChromeEnterpriseAccount లింక్‌ను సందర్శించండి.</translation>
<translation id="7851457902707056880">సైన్-ఇన్ అనేది, యజమాని ఖాతాకు మాత్రమే పరిమితం చేయబడింది. దయచేసి రీబూట్ చేసి యజమాని ఖాతాతో సైన్ ఇన్ చేయండి. మెషీన్ 30 సెకన్లలో ఆటోమేటిక్‌గా రీబూట్ అవుతుంది.</translation>
<translation id="7870730066603611552">సెటప్ చేసిన తర్వాత సింక్ ఎంపికలను రివ్యూ చేయండి</translation>
<translation id="7883792253546618164">ఏ సమయంలో అయినా సబ్‌స్క్రిప్షన్‌ను తీసివేయండి.</translation>
<translation id="7887864092952184874">బ్లూటూత్ మౌస్ జత చేయబడింది</translation>
<translation id="7906440585529721295">లోకల్ డేటా తొలగించబడుతుంది</translation>
<translation id="7910725946105920830">మీ వ్యక్తిగత Google ఖాతాను ఉపయోగించండి</translation>
<translation id="7918257978052780342">నమోదు చేయి</translation>
<translation id="7923516590127538256"><ph name="BEGIN_PARAGRAPH1" />ఆటోమేటిక్ రిపోర్ట్‌లను పంపడానికి ChromeOS డివైజ్‌లను అనుమతించడం ద్వారా, ఏ సమస్యను ముందుగా పరిష్కరించి, ChromeOSను మెరుగుపరచాలనే అంశంపై నిర్ణయం తీసుకోవడం మాకు సులువు అవుతుంది. ఈ రిపోర్ట్‌ల్లో ChromeOS ఎప్పుడు క్రాష్ అయింది, ఏ ఫీచర్లను ఉపయోగించారు, సాధారణంగా ఎంత మెమరీని ఉపయోగించారు వంటి వివరాలు కూడా ఉంటాయి.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />మీ చిన్నారి ChromeOS డివైజ్ సెట్టింగ్స్‌లో ఈ రిపోర్ట్‌లను అనుమతించడాన్ని మీరు ఏ సమయంలోనైనా ప్రారంభించవచ్చు లేదా ఆపివేయవచ్చు. మీరు డొమైన్ అడ్మినిస్ట్రేటర్ అయితే, మీరు ఈ సెట్టింగ్‌ను అడ్మిన్ కన్సోల్‌లో మార్చవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="7939062555109487992">అడ్వాన్స్‌డ్ ఆప్షన్‌లు</translation>
<translation id="7943311690198910993">సైన్ ఇన్ పద్ధతి అప్‌డేట్ చేయబడింది</translation>
<translation id="795240231873601803">వర్క్, స్కూల్ ఖాతాల కోసం ఎంటర్‌ప్రైజ్ ఎన్‌రోల్‌మెంట్‌ను ఉపయోగించండి</translation>
<translation id="7968982339740310781">వివరాలను చూడండి</translation>
<translation id="7975504106303186033">మీరు ఈ Chrome Education డివైజ్‌ను ఎడ్యుకేషన్ ఖాతాలో తప్పనిసరిగా ఎన్‌రోల్ చేయాలి. కొత్త ఖాతా కోసం సైన్ అప్ చేయడానికి, దయచేసి g.co/workspace/edusignupను సందర్శించండి.</translation>
<translation id="7980084013673500153">అసెట్ ID: <ph name="ASSET_ID" /></translation>
<translation id="7981670705071137488">దీని తర్వాత, బ్యాక్‌గ్రౌండ్‌లో సాఫ్ట్‌వేర్ అప్‌డేట్ అవుతుంది. మీరు సెట్టింగ్‌లలో అప్‌డేట్ ప్రాధాన్యతలను రివ్యూ చేయవచ్చు.</translation>
<translation id="7982083145464587921">ఈ ఎర్రర్‌ను ఫిక్స్ చేయడానికి దయచేసి మీ డివైజ్‌ను రీస్టార్ట్ చేయండి.</translation>
<translation id="7988805580376093356">మీ OSను అలానే ఉంచి, USB నుండి <ph name="DEVICE_OS" />‌ను రన్ చేయండి.</translation>
<translation id="7990958035181555539">మీ Android ఫోన్ నుండి WiFiని ఆటోమేటిక్‌గా బదిలీ చేయండి</translation>
<translation id="8022466874160067884">మీ Google ఖాతా, పాస్‌వర్డ్‌ను ఎంటర్ చేయండి</translation>
<translation id="8049029041626250638">కీబోర్డ్ లేదా మౌస్‌ను కనెక్ట్ చేయండి. మీరు బ్లూటూత్ పరికరాలను ఉపయోగిస్తుంటే, అవి పెయిర్ చేయడానికి సిద్ధంగా ఉన్నాయని నిర్ధారించుకోండి.</translation>
<translation id="8054563304616131773">దయచేసి చెల్లుబాటు అయ్యే ఈమెయిల్‌ అడ్రస్‌ను నమోదు చేయండి</translation>
<translation id="8054921503121346576">USB కీబోర్డ్ కనెక్ట్ చేయబడింది</translation>
<translation id="8065144531309810062">మరింత క్రియేటివ్‌గా, మరింత ప్రొడక్టివ్‌గా ఉండటానికి Googleకు చెందిన AI టెక్నాలజీలను ఉపయోగించండి</translation>
<translation id="8082106343289440791">"<ph name="DEVICE_NAME" />"తో పెయిర్ చేయాలా?</translation>
<translation id="8097959162767603171">ముందుగా మీ అడ్మినిస్ట్రేటర్, అడ్మిన్ కన్సోల్‌కి చెందిన, Chrome పరికర లిస్ట్‌లో ఉన్న సర్వీస్ నియమాలను తప్పనిసరిగా అంగీకరించాలి.</translation>
<translation id="8098156986344908134"><ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేసి, హార్డ్ డ్రైవ్‌ను ఫ్యాక్టరీ రీసెట్ చేయాలా?</translation>
<translation id="8098616321286360457">నెట్‌వర్క్ కనెక్షన్ అవసరం</translation>
<translation id="8129265306888404830">మీ సంస్థ (<ph name="EMAIL_DOMAIN" />)కు చెందిన ఈమెయిల్ అడ్రస్‌ను ఉపయోగించడానికి, మీరు ఎంటర్‌ప్రైజ్ ఎన్‌రోల్‌మెంట్‌ను ఉపయోగించాల్సి ఉంటుంది. ఈ పరికరం మీ వ్యక్తిగత వినియోగం కోసం అయితే, మీ వ్యక్తిగత Google ఖాతాతో సైన్ ఇన్ చేయండి.</translation>
<translation id="8131740175452115882">నిర్ధారించు</translation>
<translation id="8146177459103116374">మీరు ఇప్పటికే ఈ పరికరంలో నమోదు చేసి ఉంటే, మీరు <ph name="LINK2_START" />ఇప్పటికే ఉన్న వినియోగదారు వలే సైన్ ఇన్ చేయవచ్చు<ph name="LINK2_END" />.</translation>
<translation id="8146793085009540321">సైన్-ఇన్ విఫలమైంది. దయచేసి మీ నిర్వాహకులను సంప్రదించండి లేదా మళ్లీ ట్రై చేయండి.</translation>
<translation id="8147346945017130012">క్రాష్ రిపోర్ట్‌లు, సమస్య విశ్లేషణలు, వినియోగ డేటాను ఆటోమేటిక్‌గా Googleకు పంపడం ద్వారా Chrome, అలాగే ChromeOS ఫీచర్‌ల పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="8152760814912191567">Zoom కోసం Google Beam</translation>
<translation id="815491593104042026">అయ్యో!  ఇది సురక్షితం కాని URL (<ph name="BLOCKED_URL" />)ను ఉపయోగించే విధంగా కాన్ఫిగర్ చేయబడినందున ప్రామాణీకరణ విఫలమైంది. దయచేసి మీ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి.</translation>
<translation id="8157704005178149728">పర్యవేక్షణను సెటప్ చేస్తోంది</translation>
<translation id="8174047975335711832">డివైజ్ సమాచారం</translation>
<translation id="818985507198861625"><ph name="BEGIN_PARAGRAPH1" />మీ డివైజ్ లొకేషన్‌ను అంచనా వేయడంలో సాయం పొందడానికి Wi-Fi, మొబైల్ నెట్‌వర్క్‌లు, సెన్సర్‌ల వంటి సోర్సులను Google లొకేషన్ సర్వీస్ ఉపయోగిస్తుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />సెట్టింగ్స్ &gt; యాప్‌లు &gt; Google Play Store &gt; Android ప్రిఫరెన్స్‌లను (ప్రాధాన్యతలను) మేనేజ్ చేయండి &gt; సెక్యూరిటీ &amp; లొకేషన్ &gt; లొకేషన్‌కు వెళ్లడం ద్వారా మీ డివైజ్‌లో ఏ సమయంలోనైనా మీరు Android లొకేషన్‌ను ఆఫ్ చేయవచ్చు. అదే మెనూలోని "Google లొకేషన్ ఖచ్చితత్వాన్ని" ఆఫ్ చేయడం ద్వారా Wi‑Fi, మొబైల్ నెట్‌వర్క్‌లతో పాటు Android లొకేషన్ కోసం సెన్సర్‌ల వినియోగాన్ని కూడా ఆఫ్ చేయవచ్చు.<ph name="END_PARAGRAPH2" /></translation>
<translation id="8202160505685531999">దయచేసి మీ <ph name="DEVICE_TYPE" /> ప్రొఫైల్‌ను అప్‌డేట్ చేయ‌డానికి మీ పాస్‌వర్డ్‌ను మళ్లీ నమోదు చేయండి.</translation>
<translation id="822050276545350872">ఇక్కడ నుండి, వేచి ఉండాల్సిన అవసరం లేదు</translation>
<translation id="8239032431519548577">ఎంటర్‌ప్రైజ్ నమోదు పూర్తయింది</translation>
<translation id="8241806945692107836">పరికర కాన్ఫిగరేషన్‌ను గుర్తిస్తోంది...</translation>
<translation id="8242426110754782860">కొనసాగు</translation>
<translation id="826905130698769948">చెల్లని క్లయింట్ సర్టిఫికెట్</translation>
<translation id="8271379370373330993">తల్లిదండ్రులారా, తర్వాత కొన్ని దశలు మీ కోసం. ఖాతాను సెటప్ చేసిన తర్వాత మీరు <ph name="DEVICE_TYPE" />ను చిన్నారికి తిరిగి ఇవ్వవచ్చు.</translation>
<translation id="8274924778568117936">అప్‌డేట్ పూర్తయ్యే వరకు మీ <ph name="DEVICE_TYPE" />ని ఆఫ్ చేయవద్దు లేదా మూసివేయవద్దు. ఇన‌స్ట‌లేష‌న్‌ పూర్తయిన తర్వాత మీ <ph name="DEVICE_TYPE" /> పునఃప్రారంభమవుతుంది.</translation>
<translation id="8281886186245836920">స్కిప్ చేయండి</translation>
<translation id="8289509909262565712"><ph name="DEVICE_OS" />‌కు స్వాగతం</translation>
<translation id="8291942417224950075">వ్యక్తిగత వినియోగం కోసం</translation>
<translation id="8304383784961451596">ఈ డివైజ్‌ను ఉపయోగించడానికి మీకు అనుమతిలేదు. సైన్ ఇన్ అనుమతి కోసం దయచేసి అడ్మినిస్ట్రేటర్‌ను కాంటాక్ట్ చేయండి లేదా Family Link ద్వారా పర్యవేక్షించబడే Google ఖాతాతో సైన్ ఇన్ చేయండి.</translation>
<translation id="8321837372750396788"><ph name="MANAGER" /> ఈ <ph name="DEVICE_TYPE" />ను మేనేజ్ చేస్తుంది.</translation>
<translation id="8339288417038613756">డిస్‌ప్లే, టెక్స్ట్ సైజ్</translation>
<translation id="8354034204605718473">మీ చిన్నారి PIN జోడించబడింది</translation>
<translation id="8360140320636871023">మీ డిస్‌ప్లే రూపాన్ని వ్యక్తిగతీకరించండి</translation>
<translation id="8366396658833131068">మీ నెట్‌వర్క్ కనెక్టివిటీ పునరుద్ధరించబడింది. దయచేసి వేరే నెట్‌వర్క్‌ను ఎంచుకోండి లేదా మీ కియోస్క్ యాప్‌ను ప్రారంభించడానికి కింది 'కొనసాగించండి' బటన్ నొక్కండి.</translation>
<translation id="8401432541486058167">మీ స్మార్ట్ కార్డ్‌కు అనుబంధించబడిన పిన్‌ను అందించండి.</translation>
<translation id="8408270600235826886">Googleతో ఏ డేటా షేర్ చేయబడుతుందో మీరు కంట్రోల్ చేయవచ్చు. మీరు దీనిని సెట్టింగ్‌లలో ఎప్పుడైనా మార్చవచ్చు. <ph name="BEGIN_LINK" />Google గోప్యతా పాలసీకి<ph name="END_LINK" /> అనుగుణంగా డేటా ఉపయోగించబడుతుంది.</translation>
<translation id="8413956290606243087">ChromeOSకు బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను మీరు యాక్టివేట్ చేసుకోవాలనుకుంటున్నారా?</translation>
<translation id="8425768983279799676">మీరు మీ PINను ఉపయోగించి మీ డివైజ్‌ను అన్‌లాక్ చేయవచ్చు.</translation>
<translation id="8428213095426709021">సెట్టింగ్‌లు</translation>
<translation id="843173223122814223">AIతో బ్యాక్‌గ్రౌండ్‌లను క్రియేట్ చేయండి</translation>
<translation id="8452105022015742247">మీ Android ఫోన్ నుండి Google ఖాతా సమాచారం బదిలీ చేయబడుతోంది</translation>
<translation id="8464132254133862871">ఈ వినియోగదారు ఖాతా ఆ సేవ కోసం అర్హత పొందలేదు.</translation>
<translation id="8524841856047224176">వీడియో కాల్స్‌తో పాటు మరిన్నింటి కోసం మీ కెమెరా బ్యాక్‌గ్రౌండ్‌లను వ్యక్తిగతీకరించుకోండి</translation>
<translation id="8527257351549797148">మీ సంస్థలో మీరు ఎన్‌రోల్ చేసుకోవాల్సిన అవసరం ఉండవచ్చు, తద్వారా యాప్‌లను, ఎక్స్‌టెన్షన్‌లను, ఇంకా మరిన్నింటిని మీరు యాక్సెస్ చేయగలరు. దీని వలన సెక్యూరిటీ, పరికర సెట్టింగ్‌ల వంటి వాటిని మేనేజ్ చేసే వీలు కూడా మీ సంస్థకు లభిస్తుంది.</translation>
<translation id="8549316893834449916">మీ Chromebookకు సైన్ ఇన్ చేయడానికి మీరు మీ Google ఖాతాను ఉపయోగిస్తారు – Gmail, Drive, YouTube మరిన్నింటి కోసం మీరు ఉపయోగించే అదే ఖాతా.</translation>
<translation id="8558063527625343224">Google Beamను సెటప్ చేయండి</translation>
<translation id="8569673829373920831"><ph name="APP_NAME" /> గురించి మరింత సమాచారం</translation>
<translation id="8586421813321819377">లొకేషన్ అనుమతి గల ChromeOS, Android యాప్‌లు, వెబ్‌సైట్‌లు, సర్వీస్‌లకు మీ పరికర లొకేషన్‌ను ఉపయోగించడానికి అనుమతినివ్వండి. 'లొకేషన్ ఖచ్చితత్వం', Android యాప్‌లు, సర్వీస్‌లకు మరింత ఖచ్చితమైన లొకేషన్ సమాచారాన్ని అందిస్తుంది. దీన్ని చేయడానికి, మీ పరికరం నుండి Google, పరికర సెన్సార్‌లు, వైర్‌లెస్ సిగ్నల్స్‌కు సంబంధించిన సమాచారాన్ని ప్రాసెస్ చేసి, వైర్‌లెస్ సిగ్నల్ లొకేషన్‌లను క్రౌడ్‌సోర్స్ చేస్తుంది. ఇవి మిమ్మల్ని గుర్తించకుండా 'లొకేషన్ ఖచ్చితత్వాన్ని', లొకేషన్ ఆధారిత సర్వీస్‌లను మెరుగుపరచడానికి, అలాగే యూజర్ అవసరాలను తీర్చడానికి Google, థర్డ్-పార్టీల చట్టబద్ధమైన ప్రయోజనాలకు అనుగుణంగా Google సర్వీస్‌లను మెరుగుపరచడానికి, అందించడానికి, మెయిన్‌టెయిన్ వినియోగించబడతాయి.</translation>
<translation id="8627804903623428808">ఈ నియమాలను రివ్యూ చేయండి, మీ చిన్నారి డేటాను కంట్రోల్ చేయండి</translation>
<translation id="8628232294964836490">మీ ఫోన్‌లోని సూచనలను ఫాలో అయ్యి, QR కోడ్‌ను స్కాన్ చేయండి. మీ ఫోన్ బ్లూటూత్ ఆన్‌లో ఉందని నిర్ధారించుకోండి.
        <ph name="BR" />
    <ph name="BR" />
    సమీపంలోని డివైజ్‌లకు <ph name="QUICK_START_DEVICE_DISPLAY_NAME" />‌గా కనిపిస్తుంది...</translation>
<translation id="8637688295594795546">సిస్టమ్ అప్‌డేట్‌ అందుబాటులో ఉంది. డౌన్‌లోడ్ చేయ‌డానికి సిద్ధం చేస్తోంది...</translation>
<translation id="8655972064210167941">మీ పాస్‌వర్డ్‌ను వెరిఫై చేయలేకపోవడం వల్ల సైన్-ఇన్ విఫలమైంది. దయచేసి మీ అడ్మినిస్ట్రేటర్‌ను సంప్రదించండి లేదా మళ్లీ ట్రై చేయండి.</translation>
<translation id="8661876674803386786"><ph name="BEGIN_PARAGRAPH1" />'లొకేషన్ ఖచ్చితత్వం' ఆన్‌లో ఉన్నప్పుడు, Wi-Fi యాక్సెస్ పాయింట్లు, సెల్యులార్ నెట్‌వర్క్ టవర్‌ల వంటి వైర్‌లెస్ సిగ్నల్స్‌తో పాటు యాక్సిలెరోమీటర్, గైరోస్కోప్ వంటి డివైజ్ సెన్సర్ డేటాకు సంబంధించిన సమాచారాన్ని ఉపయోగించి మరింత ఖచ్చితమైన డివైజ్ లొకేషన్‌ను అంచనా వేస్తారు. లొకేషన్ ఆధారిత ఫీచర్లను అందించడానికి Android యాప్‌లు &amp; సర్వీస్‌లు దీన్ని ఉపయోగిస్తాయి. ఇలా చేసేందుకు గానూ, క్రౌడ్‌సోర్స్ చేసిన వైర్‌లెస్ సిగ్నల్ లొకేషన్‌లకు కంట్రిబ్యూట్ చేయడానికి మీకు సమీపంలో ఉన్న డివైజ్ సెన్సర్‌లు, వైర్‌లెస్ సిగ్నల్స్ సమాచారాన్ని Google కాలానుగుణంగా సేకరిస్తుంది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />Google మిమ్మల్ని గుర్తించకుండా ఈ సమాచారాన్ని: 'లొకేషన్ ఖచ్చితత్వాన్ని', లొకేషన్ ఆధారిత సర్వీస్‌లను మెరుగుపరచడానికి, Google సర్వీస్‌లను మెరుగుపరచడానికి, అందించడానికి, మెయింటెయిన్ చేయడానికి ఉపయోగిస్తుంది. యూజర్ అవసరాలను తీర్చడానికి Googleతో పాటు థర్డ్-పార్టీల చట్టబద్ధమైన ప్రయోజనాల ఆధారంగా మేము ఈ సమాచారాన్ని ప్రాసెస్ చేస్తాము.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />మీరు సెట్టింగ్స్ కింద ఉన్న మీ డివైజ్ లొకేషన్ సెట్టింగ్స్ &gt; గోప్యత &amp; సెక్యూరిటీ &gt; గోప్యతా కంట్రోల్స్ &gt; లొకేషన్ యాక్సెస్ &gt; అడ్వాన్స్‌డ్ లొకేషన్ సెట్టింగ్స్‌లో ఏ సమయంలోనైనా 'లొకేషన్ ఖచ్చితత్వాన్ని' ఆఫ్ చేయవచ్చు. లొకేషన్ ఖచ్చితత్వం ఆఫ్‌లో ఉంటే, లొకేషన్ ఖచ్చితత్వ డేటా ఏదీ కలెక్ట్ కాదు. మీ డివైజ్ లొకేషన్‌ను గుర్తించడానికి, Android యాప్‌లు &amp; సర్వీస్‌లు (అందుబాటులో ఉంటే) IP అడ్రస్‌ను మాత్రమే ఉపయోగిస్తాయి. దీనివల్ల, Google Maps లాంటి Android యాప్‌లు &amp; సర్వీస్‌లలో లొకేషన్లు అందుబాటులో ఉండటం పైన, అలాగే వాటి కచ్చితత్వం పైన ప్రభావం పడే అవకాశం ఉంది.<ph name="END_PARAGRAPH3" /></translation>
<translation id="8674903726754070732">దురదృష్టవశాత్తూ, తప్పుగా ఫార్మాట్ చేయబడిన హార్డ్‌వేర్ IDతో మీ కంప్యూటర్ కాన్ఫిగర్ చేయబడింది. ఇది సెక్యూరిటీ పరిష్కారాలతో అప్‌డేట్ కాకుండా ChromeOSను నిరోధిస్తుంది, అలాగే మీ కంప్యూటర్ <ph name="BEGIN_BOLD" />హానికరమైన సాఫ్ట్‌వేర్ దాడులకు గురి కావచ్చు<ph name="END_BOLD" />.</translation>
<translation id="8675704450909805533"><ph name="DEVICE_OS" />‌ను ఇన్‌స్టాల్ చేయడానికి ఇన్‌స్టాలర్ సరైన గమ్యస్థానాన్ని కనుగొనలేకపోయారు.</translation>
<translation id="8695139659682234808">సెటప్ పూర్తి అయ్యాక తల్లిదండ్రుల నియంత్రణలను జోడించండి</translation>
<translation id="8698269656364382265">మునుపటి స్క్రీన్‌కు తిరిగి వెళ్లడానికి, ఎడమ వైపు నుండి స్వైప్ చేయండి.</translation>
<translation id="8718994464069323380">టచ్ స్క్రీన్ గుర్తించబడింది</translation>
<translation id="8725066075913043281">మళ్ళీ ప్రయత్నించండి</translation>
<translation id="8726206820263995930">విధాన సెట్టింగ్‌లను సర్వర్ నుండి పొందుతున్నప్పుడు ఎర్రర్: <ph name="CLIENT_ERROR" />.</translation>
<translation id="8730621377337864115">పూర్తయింది</translation>
<translation id="8740086188450289493">Google ఖాతా పాస్‌వర్డ్‌ను ఉపయోగించండి</translation>
<translation id="8740247629089392745">మీరు ఈ Chromebookను <ph name="SUPERVISED_USER_NAME" />కు ఇవ్వవచ్చు. సెటప్ దాదాపు పూర్తయింది, మరిన్ని విషయాలను తెలుసుకునే సమయం ఆసన్నమైంది.</translation>
<translation id="8759753423332885148">మరింత తెలుసుకోండి.</translation>
<translation id="8762886931014513155">మీ <ph name="DEVICE_TYPE" />ని అప్‌డేట్ చేయాలి</translation>
<translation id="8777628254805677039">మూల పాస్‌వర్డ్</translation>
<translation id="877985182522063539">A4</translation>
<translation id="8783834180813871000">బ్లూటూత్ పెయిరింగ్ కోడ్‌ను టైప్ చేసి, ఆపై Return లేదా Enter నొక్కండి.</translation>
<translation id="8794548468611058947">సైన్ ఇన్ చేయడానికి మీ Google ఖాతా పాస్‌వర్డ్‌ను ఎంటర్ చేయడానికి బదులుగా, మీరు ఈ <ph name="DEVICE_TYPE" /> కోసం PINను క్రియేట్ చేయవచ్చు</translation>
<translation id="8830779999439981481">అప్‌డేట్‌లను వర్తింపజేయడానికి రీస్టార్ట్ అవుతోంది</translation>
<translation id="8830796635868321089">ప్రస్తుత ప్రాక్సీ సెట్టింగ్‌లను ఉపయోగించి అప్‌‌డేట్‌ను చెక్ చేయడం విఫలమైంది. దయచేసి మీ <ph name="PROXY_SETTINGS_LINK_START" />ప్రాక్సీ సెట్టింగ్‌ల<ph name="PROXY_SETTINGS_LINK_END" />ను సర్దుబాటు చేయండి.</translation>
<translation id="8855977033756560989">ఈ Chromebook ఎంటర్‌ప్రైజ్ డివైజ్ అనేది Chrome ఎంటర్‌ప్రైజ్ అప్‌గ్రేడ్‌తో బండిల్ చేయబడింది. ఎంటర్‌ప్రైజ్ సామర్థ్యాల నుంచి ప్రయోజనం పొందడానికి, ఈ డివైజ్‌ను Google అడ్మిన్ ఖాతాతో ఎన్‌రోల్ చేయండి.</translation>
<translation id="885746075120788020">మీరు మీ Google ఖాతాతో సైన్ ఇన్ చేసినప్పుడు, ఏ ChromeOS పరికరంలోనైనా మీరు సేవ్ చేసిన ప్రాధాన్యతలు, యాక్టివిటీ సిద్ధంగా ఉంటాయి. ఏది సింక్ చేయాలనే దాన్ని, మీరు సెట్టింగ్‌లలో ఎంచుకోవచ్చు.</translation>
<translation id="8868333925931032127">డెమో మోడ్‌ను ప్రారంభిస్తోంది</translation>
<translation id="8875221558267407626">కంటెంట్‌ను సారాంశీకరించండి, క్లిష్టమైన భాషను సులభతరం చేయండి, లేదా ప్రశ్నలను అడగండి</translation>
<translation id="8907701755790961703">దయచేసి దేశాన్ని ఎంచుకోండి</translation>
<translation id="8913163265790894442">మీ ఫోన్‌తో <ph name="DEVICE_TYPE" />‌ను సులభంగా సెటప్ చేయండి. మీ పాస్‌వర్డ్‌లను మాన్యువల్‌గా ఎంటర్ చేయకుండానే మీ Wi-Fiను, Google ఖాతాను మీరు జోడించవచ్చు.
        <ph name="BR" />
        <ph name="BR" />
        <ph name="DEVICE_TYPE" />‌లా కనబడుతుంది...</translation>
<translation id="8934732568177537184">కొనసాగించండి</translation>
<translation id="8946359700442089734">డీబగ్గింగ్ ఫీచ‌ర్‌లు ఈ <ph name="IDS_SHORT_PRODUCT_NAME" /> పరికరంలో పూర్తిగా ప్రారంభించబడలేదు.</translation>
<translation id="8965037249707889821">పాత పాస్‌వర్డ్‌ను నమోదు చేయండి</translation>
<translation id="8968906873893164556">సెటప్ కోసం ఉపయోగించాల్సిన ఖాతాను ఎంచుకోండి</translation>
<translation id="8973596347849323817">మీ అవసరాలకు అనుగుణంగా ఈ డివైజ్‌ను మీరు అనుకూలంగా మార్చుకోవచ్చు. ఈ యాక్సెస్ చేయగల ఫీచర్లను సెట్టింగ్స్‌లో తర్వాత మార్చవచ్చు.</translation>
<translation id="8975396729541388937">మీరు అందుకునే ఇమెయిల్‌లలోని లింక్‌ను క్లిక్ చేయడం ద్వారా ఎప్పుడైనా సబ్‌స్క్రిప్షన్‌ను తీసివేయవచ్చు.</translation>
<translation id="8987305927843254629">ప్రతి వ్యక్తి వారి ఎక్స్‌పీరియన్స్‌ను వ్యక్తిగతీకరించుకోవచ్చు, వారి డేటాను ప్రైవేట్‌గా ఉంచుకోవచ్చు.</translation>
<translation id="8993059306046735527">మీరు మీ <ph name="DEVICE_TYPE" /> పాస్‌వర్డ్‌ను మర్చిపోయినా, మీ లోకల్ డేటాను రీస్టోర్ చేయవచ్చు. మీరు మీ Google ఖాతాకు సైన్ ఇన్ చేయాల్సి ఉంటుంది లేదా ఖాతా రికవరీని ఉపయోగించాల్సి ఉంటుంది.</translation>
<translation id="9018218886431812662">ఇన్‌స్టాలేషన్ పూర్తయింది</translation>
<translation id="9033765790910064284">ఏమైనప్పటికీ కొనసాగించండి</translation>
<translation id="903480517321259405">PINను మళ్లీ టైప్ చేయండి</translation>
<translation id="9040473193163777637">ChromeOSకు బిల్ట్-ఇన్ స్క్రీన్ రీడర్ అయిన ChromeVoxను మీరు యాక్టివేట్ చేసుకోవాలనుకుంటున్నారా? అలా చేయాలనుకుంటే, రెండు వాల్యూమ్ 'కీ'లను ఐదు సెకన్ల పాటు నొక్కి, పట్టుకోండి.</translation>
<translation id="9068298336633421551">లొకేషన్ అనుమతిని కలిగిన Android యాప్‌లు, సర్వీస్‌లు ఈ పరికర లొకేషన్‌ను ఉపయోగించడానికి అనుమతించండి. Google కాలానుగుణంగా లొకేషన్ డేటాను సేకరించవచ్చు, లొకేషన్ ఖచ్చితత్వాన్ని, లొకేషన్-ఆధారిత సర్వీస్‌లను మెరుగుపరచడం కోసం ఈ డేటాను అజ్ఞాతంగా ఉపయోగించవచ్చు.</translation>
<translation id="9074836595010225693">USB మౌస్ కనెక్ట్ చేయబడింది</translation>
<translation id="9076523132036239772">క్షమించండి, మీ ఈమెయిల్‌ లేదా పాస్‌వర్డ్ ధృవీకరించబడలేదు. మొదట నెట్‌వర్క్‌కి కనెక్ట్ చేయడానికి ప్రయత్నించండి.</translation>
<translation id="9089959054554410481">టచ్‌ప్యాడ్ స్క్రోలింగ్ దిశను మార్చండి</translation>
<translation id="9158715103698450907">అయ్యో!  ప్రామాణీకరణ సమయంలో నెట్‌వర్క్ కమ్యూనికేషన్ సమస్య ఏర్పడింది.  దయచేసి మీ నెట్‌వర్క్ కనెక్షన్‌ను చెక్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="9186963452600581158">చిన్నారి Google ఖాతాతో సైన్ ఇన్ చేయండి</translation>
<translation id="919686179725692564">మీ యాప్‌లను బ్యాకప్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="9214520840402538427">అయ్యో!  ఇన‌స్ట‌లేష‌న్-సమయ లక్షణాల ప్రారంభ సమయం ముగిసింది.  దయచేసి మీ మద్దతు ప్రతినిధిని సంప్రదించండి.</translation>
<translation id="9217002308921247002"><ph name="BEGIN_PARAGRAPH1" /><ph name="DEVICE_TYPE" />‌కు మాత్రమే ప్రత్యేకమైనది.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />జెనరేటివ్ AI ప్రయోగాత్మకమైనది, ఇంకా ప్రారంభ స్థాయి అభివృద్ధి దశలోనే ఉంది, ప్రస్తుతానికి అది పరిమిత స్థాయిలో అందుబాటులో ఉంది.<ph name="END_PARAGRAPH2" /></translation>
<translation id="936479314588646618">మీ ఫోన్‌తో <ph name="DEVICE_TYPE" />‌ను సులభంగా సెటప్ చేయండి. మీరు మీ పాస్‌వర్డ్‌ను మాన్యువల్‌గా ఎంటర్ చేయకుండానే మీ Google ఖాతాను జోడించవచ్చు.
        <ph name="BR" />
        <ph name="BR" />
        <ph name="DEVICE_TYPE" />‌లా కనబడుతుంది...</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="951991426597076286">తిరస్కరించు</translation>
<translation id="954749761428814584">భాష, ఇన్‌పుట్ పద్ధతి</translation>
<translation id="960987915827980018">సుమారు 1 గంట మిగిలి ఉంది</translation>
<translation id="995420352808264005">డివైజ్ ఎన్‌రోల్‌మెంట్ రకాన్ని ఎంచుకోండి</translation>
</translationbundle>