<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1005333234656240382">გსურთ ADB გამართვის ჩართვა?</translation>
<translation id="1076766328672150609">თქვენს შვილს მოწყობილობის განბლოკვა PIN-კოდის მეშვეობით შეუძლია.</translation>
<translation id="1097658378307015415">შესვლამდე, შედით სტუმრის სტატუსით <ph name="NETWORK_ID" /> ქსელის გააქტიურების მიზნით</translation>
<translation id="1111932478203988717">ამ PIN-კოდის გამოყენებით თქვენს ბავშვს შეუძლია თავის ტელეფონში შესვლა</translation>
<translation id="1122587596907914265">შექმენით უნიკალური სტილის მქონე ფონები</translation>
<translation id="1131201598497838573">თქვენი ბავშვის PIN-კოდი განახლდა</translation>
<translation id="1147322039136785890">ახლა <ph name="SUPERVISED_USER_NAME" />-ის ჯერია</translation>
<translation id="1176864681932214421">სურათების შექმნა ხელოვნური ინტელექტის დახმარებით</translation>
<translation id="1177073277575830464">Android-ის სწრაფი დაყენება დასრულდა. გააგრძელეთ დაყენება თქვენს <ph name="DEVICE_TYPE" />-ზე.</translation>
<translation id="1179902906564467236">მიჰყევით ინსტრუქციას ტელეფონზე ან გამოიყენეთ კამერის აპი</translation>
<translation id="1185924365081634987">თქვენ აგრეთვე შეგიძლიათ სცადოთ <ph name="GUEST_SIGNIN_LINK_START" />დათვალიერება სტუმრის სახით<ph name="GUEST_SIGNIN_LINK_END" />, რომ გამოასწოროთ ქსელის შცდომა.</translation>
<translation id="1201402288615127009">შემდეგი</translation>
<translation id="1217114730239853757">გსურთ, გაააქტიუროთ ChromeVox, ChromeOS Flex-ში ჩაშენებული ეკრანის წამკითხველი? ამისთვის დააჭირეთ შორისის კლავიშს.</translation>
<translation id="1222835797152767346">დააყენეთ PIN-კოდი, სისტემაში უფრო მარტივად რომ შეხვიდეთ</translation>
<translation id="1272978324304772054">ამ მომხმარებლის ანგარიში არ მიეკუთვნება იმ დომეინს, რომელზეც რეგისტრირებულია მოწყობილობა. თუ გსურთ სხვა დომეინზე რეგისტრაცია, ჯერ უნდა გაიაროთ მოწყობილობის აღდგენის პროცედურა.</translation>
<translation id="1307559529304613120">სისტემამ ვერ შეინახა გრძელვადიანი API წვდომის ჟეტონი ამ მოწყობილობისთვის.</translation>
<translation id="1346669614038013595"><ph name="BEGIN_H3" />შეცდომების გამართვის ფუნქციები<ph name="END_H3" />
          <ph name="BR" />
          თქვენს ChromeOS მოწყობილობაზე, თქვენი საკუთარი კოდის ინსტალაციისთვის და ტესტირებისთვის, შეგიძლიათ ჩართოთ შეცდომების გამართვის ფუნქციები. მათი მეშვეობით თქვენ შეგეძლებათ:<ph name="BR" />
          <ph name="BEGIN_LIST" />
            <ph name="LIST_ITEM" />RootFS დადასტურების გაუქმება ოპერაციული სისტემის ფაილების შესაცვლელად
            <ph name="LIST_ITEM" />მოწყობილობაზე სტანდარტული სატესტო გასაღებების მეშვეობით SSH-წვდომის ჩართვა ისეთი ხელსაწყოების გამოსაყენებლად, როგორიცაა <ph name="BEGIN_CODE" />Cros Flash<ph name="END_CODE" />
            <ph name="LIST_ITEM" />USB-დან ჩატვირთვის ჩართვა USB დისკიდან ოპერაციული სისტემის იმიჯის ინსტალაციისთვის
            <ph name="LIST_ITEM" />დეველოპერისა და სისტემის ძირეული შესვლის პაროლების დაყენება სასურველ მნიშვნელობაზე მოწყობილობაში SSH-ის მეშვეობით ხელით შესასვლელად
          <ph name="END_LIST" />
          <ph name="BR" />
          შეცდომების გამართვის ფუნქციების უმეტესობა ჩართული დარჩება კორპორაციულ მოწყობილობაზე Powerwash-ის შესრულების ან მონაცემების ამოშლის შემდეგაც კი. შეცდომების გამართვის ფუნქციების სრულად გამოსართავად საჭიროა ChromeOS-ის აღდგენის პროცესის გაშვება (https://support.google.com/chromebook/answer/1080595).
          <ph name="BR" />
          <ph name="BR" />
          შეცდომების გამართვის ფუნქციების შესახებ დამატებითი ინფორმაციისთვის გადადით ბმულზე:<ph name="BR" />
          https://www.chromium.org/chromium-os/how-tos-and-troubleshooting/debugging-features
          <ph name="BR" />
          <ph name="BR" />
          <ph name="BEGIN_BOLD" />შენიშვნა:<ph name="END_BOLD" /> პროცესის მსვლელობისას სისტემა გადაიტვირთება.</translation>
<translation id="1347625331607114917">დაადასტურეთ კოდი თქვენს Android-ტელეფონზე</translation>
<translation id="1347975661240122359">განახლება დაიწყება მაშინ, როცა ბატარეა <ph name="BATTERY_LEVEL" />%-ს მიაღწევს.</translation>
<translation id="1375557162880614858">გსურთ, გაააქტიუროთ ChromeVox, ChromeOS Flex-ში ჩაშენებული ეკრანის წამკითხველი?</translation>
<translation id="1375938286942050085">პარამეტრების დაყენება დასრულდა! მომდევნო ეტაპზე თქვენს მოწყობილობას თამაშისთვის მოამზადებთ</translation>
<translation id="1377600615067678409">გამოტოვება</translation>
<translation id="1399261165075500043">Google Play-ს მომსახურების პირობები ვერ ჩაიტვირთა</translation>
<translation id="1400243387594338234">ამ PIN-კოდის გამოყენებით შეგიძლიათ თქვენს ტელეფონში შესვლა</translation>
<translation id="1417497355604638350">დიაგნოსტიკური და გამოყენების მონაცემების გაგზავნა.</translation>
<translation id="1418882096915998312">მიმდინარეობს Enterprise რეგისტრაცია</translation>
<translation id="1426410128494586442">დიახ</translation>
<translation id="1440090277117135316">სასწავლებელში რეგისტრაცია დასრულდა</translation>
<translation id="1473927070149284123">ცადეთ თავიდან ან დაუკავშირდით ქსელს ხელით</translation>
<translation id="1503556098270577657">თქვენ შეხვედით <ph name="USER_EMAIL" />-ში Android ტელეფონის გამოყენებით</translation>
<translation id="1521442365706402292">სერთიფიკატების მართვა</translation>
<translation id="1540605929960647700">დემო-რეჟიმის ჩართვა</translation>
<translation id="1572876035008611720">შეიყვანეთ თქვენი ელფოსტა</translation>
<translation id="1642494467033190216">ძირეული დაცვის მოხსნა და გადატვირთვა საჭირო მანამ, სანამ ჩართავთ სხვა გამართვის ფუნქციებს.</translation>
<translation id="1668435968811469751">ხელით რეგისტრაცია</translation>
<translation id="1678919064276516737">თქვენ მიერ შეყვანილი ელფოსტა და PIN-კოდი არ ემთხვევა</translation>
<translation id="1692115862433274081">სხვა ანგარიშის გამოყენება</translation>
<translation id="1695487653372841667">თქვენ შეგიძლიათ გააკონტროლოთ, რა მონაცემები გაზიარდეს Google-თან. ამის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებში.</translation>
<translation id="169675691788639886">მოწყობილობისთვის კონფიგურირებულია SSH სერვერი. არ შეხვიდეთ სისტემაში სენსიტიური ანგარიშების მეშვეობით.</translation>
<translation id="1730666151302379551">ძველი პაროლი დამავიწყდა</translation>
<translation id="177053719077591686">Android აპების სარეზერვო ასლების შექმნა Google Drive-ზე.</translation>
<translation id="1806335016774576568">სხვა გახსნილ აპზე გადართვა</translation>
<translation id="1826192255355608658">შეასრულეთ თქვენი Chrome ბრაუზერის სანიშნეების, პაროლების, ისტორიისა და სხვა კონტენტის სინქრონიზაცია</translation>
<translation id="1831848493690504725">დაკავშირებული ქსელის მეშვეობით Google-თან კავშირის დამყარება ვერ მოხერხდა. აირჩიეთ განსხვავებული ქსელი, ან შეამოწმეთ თქვენი ქსელისა თუ პროქსი-სერვერის პარამეტრები (თუ პროქსი-სერვერს იყენებთ).</translation>
<translation id="1842766183094193446">ნამდვილად გსურთ დემო-რეჟიმის ჩართვა?</translation>
<translation id="1845060436536902492">ეკრანის წამკითხველი ChromeOS Flex-ზე, ChromeVox, ძირითადად გამოიყენება სიბრმავის ან სუსტი მხედველობის მქონე ადამიანების მიერ ეკრანზე ნაჩვენები ტესტის წასაკითხად მეტყველების სინთეზატორის ან ბრაილის ეკრანის გამოყენებით. ChromeVox-ის ჩასართავად დააჭირეთ შორისის კლავიშს. როცა ChromeVox გააქტიურდება, მის მოკლე ტურს შემოგთავაზებთ.</translation>
<translation id="1868617395637139709">მდებარეობის გამოყენება Android აპებისა და სერვისებისთვის.</translation>
<translation id="189035593835762169">წესები და პირობები</translation>
<translation id="1987574314042117472">აირჩიეთ და დააინსტალირეთ პოპულარული აპები</translation>
<translation id="1991829061375381344">ამ Google Meet აპარატურული მოწყობილობის რეგისტრაციისთვის არასაკმარისი ლიცენზიები გაქვთ. დამატებითი ინფორმაციისთვის დაუკავშირდით თქვენს რესელერს. თუ ფიქრობთ, რომ ამ შეტყობინებას შეცდომით ხედავთ, დაუკავშირდით თქვენს რესელერს.</translation>
<translation id="2040460856718599782">უი! რაღაც არასწორად წავიდა თქვენი ავტორიზაციის დროს. გთხოვთ, გადაამოწმოთ თქვენი შესვლის მონაცემები და ხელახლა სცადოთ.</translation>
<translation id="2052572566310583903">თქვენს სხვა მოწყობილობებზე დაინსტალირებული</translation>
<translation id="2088092308059522196">რეგისტრაცია მხარდაჭერილი იქნება მხოლოდ მაშინ, როცა <ph name="DEVICE_OS" /> დაინსტალირდება.</translation>
<translation id="208928984520943006">მთავარ ეკრანზე ნებისმიერ დროს გადასასვლელად გადაფურცლეთ ქვემოდან ზემოთ.</translation>
<translation id="2090165459409185032">თქვენი ანგარიშის ინფორმაციის აღსადგენად, ეწვიეთ: google.com/accounts/recovery</translation>
<translation id="2157779167749714207">თქვენს <ph name="DEVICE_TYPE" />-ს მოჰყვება Gemini</translation>
<translation id="2163470535490402084"><ph name="DEVICE_TYPE" />-ის მეშვეობით შესასვლელად, გთხოვთ, დაუკავშირდეთ ინტერნეტს.</translation>
<translation id="2178585470774851578">თქვენ აპირებთ, ჩართოთ ChromeOS Flex-ის გამართვის ფუნქციები, რომელთა მიერაც დაყენდება sshd daemon და გააქტიურდება ჩატვირთვა USB დისკებიდან.</translation>
<translation id="2219081237089444028">დააყენეთ <ph name="DEVICE_TYPE" />-ის პაროლი, სისტემაში უფრო მარტივად რომ შეხვიდეთ</translation>
<translation id="2296022312651137376"><ph name="DOMAIN_NAME" /> მოითხოვს, რომ <ph name="EMAIL" />-ში შესვლისას მოწყობილობა ონლაინ რეჟიმში იყოს</translation>
<translation id="2317842250900878657"><ph name="PROGRESS_PERCENT" />% შესრულდა</translation>
<translation id="2319072477089403627">მიმდინარეობს თქვენს Android ტელეფონთან დაკავშირება...</translation>
<translation id="2328137272841210255">თქვენი PIN-ის აღდგენა</translation>
<translation id="2342180549977909852">თქვენს შვილს შეუძლია გამოიყენოს ციფრები (PIN-კოდი) პაროლის ნაცვლად ამ მოწყობილობის განსაბლოკად. PIN-კოდის მოგვიანებით დასაყენებლად გადადით პარამეტრებზე.</translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="2387052489799050037">მთავარზე გადასვლა</translation>
<translation id="2395616325548404795">თქვენი <ph name="DEVICE_TYPE" /> წარმატებით დარეგისტრირდა კორპორატიული მართვისთვის, თუმცა მისი საინვენტარო და მდებარეობის ინფორმაცია ვერ გაიგზავნა. გთხოვთ, ხელით შეიყვანოთ ეს ინფორმაცია ამ მოწყობილობის ადმინისტრატორის კონსოლიდან.</translation>
<translation id="2408955596600435184">შეიყვანეთ თქვენი PIN-კოდი</translation>
<translation id="243179355394256322">თქვენი ორგანიზაცია მოწყობილობების რეგისტრაციის ნებას მხოლოდ ავტორიზებულ მომხმარებლებს რთავს. ამ მომხმარებელს არ აქვს მოწყობილობების რეგისტრაციის უფლება. შეამოწმეთ ადმინისტრატორის კონსოლის „მომხმარებლების“ სექციაში, აქვს თუ არა ამ მომხმარებელს „Google Meet აპარატურის რეგისტრაციის“ პრივილეგია.</translation>
