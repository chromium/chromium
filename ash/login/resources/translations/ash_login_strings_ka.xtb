<translation id="623261264391834964">გამოიყენეთ მარჯვენა დაწკაპუნება ტექსტის ველში, „დაწერაში დახმარებით“ რომ ისარგებლოთ</translation>
<translation id="6280215091796946657">სისტემაში სხვა ანგარიშით შესვლა</translation>
<translation id="6283823201263716145">დემო-რეჟიმში მოწყობილობები ავტომატურად უგზავნის Google-ს ავარიულად გათიშვის ანგარიშებს, დიაგნოსტიკურ და გამოყენების მონაცემებს, ფუნქციებისა და ეფექტურობის გაუმჯობესების მიზნით.</translation>
<translation id="6287713404380454515">უსაფრთხოების მიზნით, თქვენმა ადმინისტრატორმა გათიშა თქვენი მოწყობილობის PIN-კოდი და პაროლი. ამიერიდან გამოიყენეთ თქვენი <ph name="MANAGER" />-ის პაროლი.</translation>
<translation id="6301300352769835063">მიეცით საშუალება Google-ს, გამოიყენოს თქვენი აპარატურის მონაცემები, <ph name="DEVICE_OS" />-ის გაუმჯობესების ხელშეწყობის მიზნით. უარყოფის შემთხვევაში, აღნიშნული მონაცემები მაინც გაეგზავნება Google-ს სათანადო განახლებების დასადგენად, თუმცა სხვა მიზნით არც შეინახება და არც გამოყენებული იქნება. დამატებითი ინფორმაცია ხელმისაწვდომია მისამართზე g.co/flex/HWDataCollection.</translation>
<translation id="6308493641021088955">შესვლას უზრუნველყოფს <ph name="EXTENSION_NAME" /></translation>
<translation id="6314819609899340042">თქვენ წარმატებით ჩართეთ ხარვეზის აღმოფხვრის თვისებები ამ <ph name="IDS_SHORT_PRODUCT_NAME" /> მოწყობილობაზე.</translation>
<translation id="635609604405270300">მოწყობილობის ჩართულად შენარჩუნება</translation>
<translation id="6367097275976877956">გსურთ, გაააქტიუროთ ChromeVox, ChromeOS-ში ჩაშენებული ეკრანის წამკითხველი? ამისთვის დააჭირეთ შორისის კლავიშს.</translation>
<translation id="636850387210749493">ორგანიზაციის რეგისტრაცია</translation>
<translation id="6380143666419481200">დათანხმება და გაგრძელება</translation>
<translation id="640457954117263537">მდებარეობის გამოყენება ChromeOS-ისა და Android აპებისა თუ სერვისებისთვის.</translation>
<translation id="6418511932144861495">კრიტიკული განახლების ინსტალაცია</translation>
<translation id="6480327114083866287">მართავს <ph name="MANAGER" /></translation>
<translation id="6495266441917713704">Wi-Fi-ს გადატანა ვერ მოხერხდა</translation>
<translation id="6515620015470298987">შესვლა ვერ მოხერხდა მოწყობილობის კონფიგურაციის შემოწმების შედეგად გამოვლენილი პრობლემის გამო. შეასრულეთ Powerwash თქვენს <ph name="DEVICE_TYPE" />-ზე და ცადეთ ხელახლა.</translation>
<translation id="6519689855001245063">მიმდინარეობს დასაშვებობის შემოწმება</translation>
<translation id="6532527800157340614">შესვლა ვერ მოხერხდა, რადგან წვდომის ჟეტონი ვერ მოვიძიეთ. შეამოწმეთ თქვენი კავშირი ქსელთან და ცადეთ ხელახლა.</translation>
<translation id="65513682072153627">ხატულას „მართული“ იხილავთ მაშინ, როცა პარამეტრს ან ფუნქციას მართავს თქვენი ადმინისტრატორი.</translation>
<translation id="6607890859198268021"><ph name="USER_EMAIL" />-ს უკვე მართავს <ph name="DOMAIN" />. მშობელთა მიერ კონტროლის სხვა Google ანგარიშისთვის გამოსაყენებლად გამოდით სისტემიდან დაყენების დასრულების შემდეგ, შესვლის ეკრანზე კი აირჩიეთ „ადამიანის დამატება“.</translation>
<translation id="6642720633335369752">აპების ყველა გახსნილი ფანჯრის სანახავად გადაფურცლეთ ქვემოდან ზემოთ და არ აუშვათ თითი.</translation>
<translation id="6648911618876616409">კრიტიკული განახლება მზად არის ინსტალაციისთვის. დასაწყებად შედით სისტემაში.</translation>
<translation id="6671497123040790595">მიმდინარეობს <ph name="MANAGER" />-ის მიერ მართვის დაყენება</translation>
<translation id="667752334740867460">მიმდინარეობს Wi-Fi ქსელის ინფორმაციის მიღება...</translation>
<translation id="6680442031740878064">ხელმისაწვდომია: <ph name="AVAILABLE_SPACE" /></translation>
<translation id="6722744767592605627"><ph name="EMAIL" /> შეგიძლიათ აღადგინოთ, თუმცა ადგილობრივი მონაცემები წაიშლება.</translation>
<translation id="6748980958975836188">წავიკითხე <ph name="BEGIN_LINK1" />Google-ის მომსახურების პირობები<ph name="END_LINK1" />, ასევე, <ph name="BEGIN_LINK2" />Chrome-ისა და ChromeOS-ის მომსახურების დამატებითი პირობები<ph name="END_LINK2" /> და ვეთანხმები მათ.</translation>
<translation id="6789834167207639931">აღდგენის დასასტულებლად შეიყვანეთ თქვენი Google ანგარიშის პაროლი მომდევნო ეკრანზე</translation>
<translation id="6800893479155997609">რჩეული აპები თქვენი <ph name="DEVICE_TYPE" />-ისთვის</translation>
<translation id="682971198310367122">Google-ის კონფიდენციალურობის დებულება</translation>
<translation id="6835762382653651563"><ph name="DEVICE_TYPE" />-ის განსაახლებლად, გთხოვთ, დაუკავშირდეთ ინტერნეტს.</translation>
<translation id="6839916869147598086">სისტემაში შესვლა შეიცვალა</translation>
<translation id="6883319974225028188">უი!  სისტემამ მოწყობილობის კონფიგურაცია ვერ შეინახა.</translation>
<translation id="6903907808598579934">სინქრონიზაციის ჩართვა</translation>
<translation id="6918733588290914545">სწრაფი დაყენება Android ტელეფონით</translation>
<translation id="6920473853105515518">დარწმუნდით, რომ თქვენი <ph name="DEVICE_TYPE" /> დაკავშირებულია ინტერნეტთან და ცადეთ ხელახლა. ამას გარდა, შეგიძლიათ მოინახულოთ play.google/play-terms სხვა მოწყობილობიდან.</translation>
<translation id="6955698182324067397">თქვენ აპირებთ, ჩართოთ ChromeOS-ის გამართვის ფუნქციები, რომელთა მიერაც დაყენდება sshd daemon და გააქტიურდება ჩატვირთვა USB დისკებიდან.</translation>
<translation id="6965382102122355670">კარგი</translation>
<translation id="6969216690072714773">შეიყვანეთ ახალი ან განაახლეთ არსებული ინფორმაცია, რომელიც ამ მოწყობილობასთან იქნება დაკავშირებული.</translation>
<translation id="6981982820502123353">სპეციალური შესაძლებლობები</translation>
<translation id="6984652455487792101">თუ იყენებთ პროქსი-სერვერს, შეამოწმეთ პროქსი-სერვერის პარამეტრები ან
        დაუკავშირდით ქსელის ადმინისტრატორს და შეამოწმეთ, რომ პროქსი-სერვერი
        მუშაობს. თუ ფიქრობთ, რომ არ იყენებთ
        პროქსი-სერვერს, დაარეგულირეთ <ph name="LINK_START" />პროქსი-სერვერის პარამეტრები<ph name="LINK_END" />.</translation>
<translation id="6996245928508281884">ჩართეთ თქვენი ტელეფონის Bluetooth და Wi-Fi</translation>
<translation id="7025082428878635038">წარმოგიდგენთ ჟესტებით ნავიგაციის ახალ ხერხს</translation>
<translation id="7034692021407794547">პირველ რიგში, ბილინგის მართვის პრივილეგიების მქონე ადმინისტრატორი უნდა დაეთანხმოს Google Meet აპარატურის მომსახურების პირობებს, რომლებიც მოცემულია ადმინისტრატორის კონსოლის „Google Meet აპარატურის“ სექციაში.</translation>
<translation id="7065223852455347715">ეს მოწყობილობა იმგვარადაა ჩაკეტილი, რომ მისი ორგანიზაციაში რეგისტრაცია შეუძლებელია.  თუ მოწყობილობის რეგისტრაცია გსურთ, ჯერ უნდა გაიაროთ მოწყობილობის აღდგენა.</translation>
<translation id="7077829361966535409">ვერ მოხერხდა სისტემაში შესვლის გვერდის ჩამოტვირთვა არსებული პროქსი პარამეტრების გამოყენებით. გთხოვთ <ph name="GAIA_RELOAD_LINK_START" />სდაცეთ შესვლა კიდევ ერთხელ<ph name="GAIA_RELOAD_LINK_END" />, ან გამოიყენეთ სხვა <ph name="PROXY_SETTINGS_LINK_START" />პროქსის პარამეტრები<ph name="PROXY_SETTINGS_LINK_END" />.</translation>
<translation id="7088674813905715446">ეს მოწყობილობა გადაყვანილია დეინიციალიზაციის მდგომარეობაში ამინისტრატორის მიერ. იმისათვის, რომ ჩართოთ ის სიაში, სთხოვეთ ადმინისტრატორს, გადაიყვანოს მოწყობილობა მომლოდინე მდგომარეობაში.</translation>
<translation id="7114054701490058191">პაროლები არ ემთხვევა</translation>
<translation id="7135729336746831607">გსურთ Bluetooth-ის ჩართვა?</translation>
<translation id="7141105143012495934">შესვლა ვერ მოხერხდა, რადგან თქვენი ანგარიშის შესახებ დეტალების მიღება შეუძლებელია. გთხოვთ, დაუკავშირდეთ ადმინისტრატორს ან სცადოთ ხელახლა.</translation>
<translation id="7144878232160441200">გაიმეორეთ</translation>
<translation id="7189451821249468368">ამ მოწყობილობის რეგისტრაციისთვის საკმარისად განახლებული ვერსია არ გაქვთ. დამატებითი განახლებების შესაძენად დაუკავშირდით გაყიდვების სამსახურს. თუ თვლით, რომ ეს შეტყობინება შეცდომით მიიღეთ, დაუკავშირდით მხარდაჭერის სამსახურს.</translation>
<translation id="7202337678781136582">დაასკანირეთ QR-კოდი თქვენი Android-ტელეფონით</translation>
<translation id="7260186537988033909">მოწყობილობა-ჯიხურის ან მიმთითებელი მოწყობილობის რეგისტრაცია დასრულდა</translation>
<translation id="7290242001003353852">სისტემაში შესვლის ამ სერვისს, რომლის ჰოსტინგსაც <ph name="SAML_DOMAIN" /> უზრუნველყოფს, თქვენს კამერაზე წვდომა აქვს.</translation>
<translation id="7317831949569936035">სასწავლებელში რეგისტრაცია</translation>
<translation id="7329154610228416156">შესვლა ვერ მოხერხდა, რადგან იგი არაუსაფრთხო URL-ის (<ph name="BLOCKED_URL" />) მეშვეობით დაკონფიგურირდა. გთხოვთ, დაუკავშირდეთ ადმინისტრატორს.</translation>
<translation id="7345706641791090287">დაადასტურეთ თქვენი პაროლი</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="7416263748877373774">მომსახურების პირობები ვერ ჩაიტვირთა. შეამოწმეთ კავშირი ქსელთან და ცადეთ ხელახლა.</translation>
<translation id="7475742997309661417">ეკრანის წამკითხველი ChromeOS-ზე, ChromeVox, ძირითადად გამოიყენება სიბრმავის ან სუსტი მხედველობის მქონე ადამიანების მიერ ეკრანზე ნაჩვენები ტესტის წასაკითხად მეტყველების სინთეზატორის ან ბრაილის ეკრანის გამოყენებით. ChromeVox-ის ჩასართავად დააჭირეთ ხმის ორივე ღილაკს ხუთი წამის განმავლობაში. როცა ChromeVox გააქტიურდება, მის მოკლე ტურს შემოგთავაზებთ.</translation>
<translation id="7476454130948140105">ბატარეა არასაკმარისად დამუხტულია განახლებისთვის (<ph name="BATTERY_PERCENT" />%)</translation>
<translation id="7504187084873714912"><ph name="BEGIN_PARAGRAPH1" />რეგისტრაციამდე უნდა გაიაროთ TPM-ის შემოწმება, რომ <ph name="DEVICE_OS" /> მოწყობილობის მფლობელი გახდეს.<ph name="END_PARAGRAPH1" />
        <ph name="BEGIN_PARAGRAPH2" />სურვილისამებრ, TPM მოწყობილობის მთლიანად გამორთვა შეგიძლიათ. თქვენი მონაცემები უსაფრთხოდ შეინახება პროგრამული უზრუნველყოფის დაშიფვრის მეშვეობით, თუმცა უსაფრთხოების ზოგიერთი ფუნქცია, როგორიცაა აპარატურით უზრუნველყოფილი სერტიფიკატები, გაითიშება.<ph name="END_PARAGRAPH2" />
        <ph name="BEGIN_PARAGRAPH3" />თქვენი TPM პარამეტრების შესაცვლელად გადატვირთეთ მოწყობილობა და შედით სისტემის BIOS/UEFI პარამეტრებში. მოქმედებათა მიმდევრობა განსხვავდება მოწყობილობის მოდელის მიხედვით. დამატებითი ინფორმაციისთვის მოწყობილობის გადატვირთვამდე გაეცანით <ph name="DEVICE_OS" />-ის დოკუმენტაციას სხვა მოწყობილობიდან: g.co/flex/TPMHelp.<ph name="END_PARAGRAPH3" /></translation>
<translation id="7506541170099744506">თქვენი <ph name="DEVICE_TYPE" /> წარმატებით დარეგისტრირდა კორპორატიული მართვისთვის.</translation>
