      <message name="IDS_CONSOLIDATED_CONSENT_PRIVACY_POLICY_TITLE" desc="Text of the Link to Goolge Privacy Policy in opt-in screen">
        Google privacy policy
      </message>
      <message name="IDS_CONSOLIDATED_CONSENT_PLAY_LOAD_ERROR_TITLE" desc="Text of the Link to Goolge Privacy Policy in opt-in screen">
