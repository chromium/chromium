      <message name="IDS_CONSUMER_UPDATE_CELLULAR_TITLE" desc="Title of the dialog shown to the user in ChromeOS OOBE before consumer update is attempted if the ChromeOS device is connected to a cellular/metered network. The dialog warns the user that procceeding with OOBE on a mobile network can cause overage charges.">
        Software update available
      </message>
      <message name="IDS_CONSUMER_UPDATE_SKIP_BUTTON" desc="Label on the button that skip the consumer update screen.">
        Skip and remind me later
      </message>
      <message name="IDS_CONSUMER_UPDATE_PROGRESS_TITLE" desc="Title of the dialog shown to the user  consumer update screen when update in progress.">
