module golden;

interface Primary {
  PassRemote(pending_associated_remote<RemoteFromJs> remote);
  PassReceiver(pending_associated_receiver<ReceiverFromJs> receiver);
  ReturnRemote() => (pending_associated_remote<RemoteFromBrowser> remote);
  ReturnReceiver() => (pending_associated_receiver<ReceiverFromBrowser> receiver);

  [Sync]
  SyncReturnReceiver()
      => (pending_associated_receiver<ReceiverFromBrowser> receiver);
  [Sync]
  SyncReturnRemote() => (pending_associated_remote<RemoteFromBrowser> remote);
};

interface RemoteFromJs {};

interface ReceiverFromJs {};

interface RemoteFromBrowser {};

interface ReceiverFromBrowser {};
