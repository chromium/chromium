module golden;

interface Primary {
  Get(array<Entry> token_arr, int32 index) => (Entry result);
  GetNestedArray(array<array<Entry>> token_arr, int32 index) => (array<Entry> result);

  [Sync]
  SyncGetNestedArray(array<array<Entry>> token_arr, int32 index) => (array<Entry> result);
  [Sync]
  SyncGetBools() => (array<bool> bools);
  [Sync]
  SyncGetStrings() => (array<string> strings);

  GetBools() => (array<bool> bools);
  GetStrings() => (array<string> strings);
  PassFloats(array<float> floats);
  PassInts(array<int32> ints);
  PassUInts(array<uint32> ints);
  GetBrowserMadeEntries() => (array<BrowserMadeEntry> entries);

  // `array<OrderedEntry>` is first seen in a response, then in a parameter. Ensures
  // that visit order doesn't affect the content of profiles.
  GetOrderedEntries() => (array<OrderedEntry> entries);
  PassOrderedEntries(array<OrderedEntry> entries);
};

struct Entry {};

struct BrowserMadeEntry {
  uint8 data;
};

struct OrderedEntry {
  uint8 data;
};
