module external;

import "nested-external-interface.test-mojom";

// This interface exists to test how the generated profiles and HTML files
// handle imported interfaces.
//
// TODO(crbug.com/570690240): Move this interface to another directory once the
// golden file generator supports importing modules in other directories
// without also generating a Fuzzilli profile and HTML file for mojom files in
// those directories.
interface Primary {
    PassNestedReceiver(pending_receiver<nested_external.Primary> receiver);
};
