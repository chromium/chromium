module golden;

// Only maximal chains get a generator: there is none for `GetMiddle` alone,
// since its chain continues through `Middle.GetLeaf`, and none for
// `Middle.GetLeaf` alone, since its chain can start at `Primary.GetMiddle`.
interface Primary {
  GetMiddle() => (pending_remote<Middle> middle);
  GetLeafInStruct() => (ReplyStruct reply);
  BindMiddle(int32 unused, pending_associated_receiver<Middle> middle);
  PassObserver(pending_remote<Observer> remote);
};

struct ReplyStruct {
  ReplyUnion? value;
};

union ReplyUnion {
  int32 unused;
  pending_remote<Leaf> leaf;
};

interface Middle {
  GetLeaf() => (pending_remote<Leaf> leaf);
  GetPrimary() => (pending_remote<Primary> primary);
  BindLeaf(pending_receiver<Leaf> leaf);
  BindPrimary(pending_receiver<Primary> primary);
};

interface Observer {
  PassNonPrimaryRoot(pending_remote<NonPrimaryRoot> remote);
};

interface NonPrimaryRoot {
  BindLeaf(pending_receiver<Leaf> leaf);
};

interface Leaf {};
