module golden;

interface Primary {
  UseUnion(SimpleUnion param);
  GetUnion(bool flag) => (SimpleUnion result);

  [Sync]
  SyncGetUnion(bool flag) => (SimpleUnion result);
};

union SimpleUnion {
  array<int64> arr;
  Token token;
  bool flag;
};

struct Token {
  uint8 data;
};
