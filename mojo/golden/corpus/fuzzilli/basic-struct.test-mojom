module golden;

interface Primary {
  UseStruct(LargeStruct struct_param, uint64 id);
  GetStruct(string value) => (SimpleStruct result);

  [Sync]
  SyncGetStruct(string value) => (SimpleStruct result);
};

struct LargeStruct {
  uint64 id;
  string value;
  SimpleStruct residence;
  string? optional_field;
  bool valid;
  SimpleUnion data;
};

struct SimpleStruct {
  string field;
};

union SimpleUnion {
  array<int64> arr;
  int16 val;
  bool flag;
};
