private let mojoBuiltins: [String: ILType] = [
    /// Profiles declare this method, a wrapper method around `getRemote` that follows
    /// the Singleton pattern, in `codePrefix`. This method ensures: (1) `getRemote`
    /// is only called once, and (2) the remote is saved to a global variable so it
    /// can be closed at the end of the program.
    "getOrCreatePrimaryRemote": .function([] => .jsGoldenPrimaryRemote),
    /// Declared in `codePrefix`. `MojoAsyncFunctionGenerator` pushes the promise
    /// of every async function it emits, and `codeSuffix` awaits them all. Typed
    /// as an opaque object Fuzzilli does not use it as a general-purpose array.
    "mojoAsyncFunctionPromises": .object(withMethods: ["push"]),
    "golden.ReceiverFromJsViaRemoteFromJsRemote":
       .constructor([] => .jsGoldenReceiverFromJsViaRemoteFromJsRemote),
    "golden.ReceiverFromJsRemote":
       .constructor([] => .jsGoldenReceiverFromJsRemote),
    "golden.ReceiverFromJsViaReceiverFromJsRemote":
       .constructor([] => .jsGoldenReceiverFromJsViaReceiverFromJsRemote),
    "golden.ReceiverFromJsViaRemoteFromBrowserRemote":
       .constructor([] => .jsGoldenReceiverFromJsViaRemoteFromBrowserRemote),
    "golden.ReceiverFromJsViaReceiverFromBrowserRemote":
       .constructor([] => .jsGoldenReceiverFromJsViaReceiverFromBrowserRemote),
    "golden.RemoteFromJsCallbackRouter":
       .constructor([] => .jsGoldenRemoteFromJsCallbackRouter),
    "golden.ReceiverFromBrowserViaRemoteFromJsCallbackRouter":
       .constructor([] => .jsGoldenReceiverFromBrowserViaRemoteFromJsCallbackRouter),
    "golden.RemoteFromJsViaRemoteFromJsCallbackRouter":
       .constructor([] => .jsGoldenRemoteFromJsViaRemoteFromJsCallbackRouter),
    "golden.RemoteFromJsViaReceiverFromJsCallbackRouter":
       .constructor([] => .jsGoldenRemoteFromJsViaReceiverFromJsCallbackRouter),
    "golden.ReceiverFromBrowserViaReceiverFromJsCallbackRouter":
       .constructor([] => .jsGoldenReceiverFromBrowserViaReceiverFromJsCallbackRouter),
    "golden.RemoteFromJsViaRemoteFromBrowserCallbackRouter":
       .constructor([] => .jsGoldenRemoteFromJsViaRemoteFromBrowserCallbackRouter),
    "golden.ReceiverFromBrowserViaRemoteFromBrowserCallbackRouter":
       .constructor([] => .jsGoldenReceiverFromBrowserViaRemoteFromBrowserCallbackRouter),
    "golden.ReceiverFromBrowserCallbackRouter":
       .constructor([] => .jsGoldenReceiverFromBrowserCallbackRouter),
    "golden.ReceiverFromBrowserViaReceiverFromBrowserCallbackRouter":
       .constructor([] => .jsGoldenReceiverFromBrowserViaReceiverFromBrowserCallbackRouter),
    "golden.RemoteFromJsViaReceiverFromBrowserCallbackRouter":
       .constructor([] => .jsGoldenRemoteFromJsViaReceiverFromBrowserCallbackRouter),
    "golden.MixedRemoteFromJsCallbackRouter":
       .constructor([] => .jsGoldenMixedRemoteFromJsCallbackRouter),
]

private let keepGenerators = [
    "IntegerGenerator", "StringGenerator", "TernaryOperationGenerator",
    "PlainFunctionGenerator", "SubroutineReturnGenerator", "TryCatchGenerator",
]

private let mojoDisabledGenerators: [String] = CodeGenerators.map { $0.name }
    .filter {
        !keepGenerators.contains($0)
    }

let mojoPrimaryProfile = Profile(
    processArgs: { _ in return [] },
    processArgsReference: nil,
    processEnv: [
        "ASAN_OPTIONS": "detect_odr_violation=0:abort_on_error=1", "DISPLAY": ":20",
    ],
    maxExecsBeforeRespawn: 50,
    timeout: Timeout.interval(11000, 11000),
    // The first statement tells js_in_process_fuzzer which Mojo scripts page to
    // load before running the program.
    codePrefix: """
        // --- Begin program prefix ---
        'mojo-scripts-page: /gen/complex-interface.test-mojom-scripts-page.html';
        let globalRemote = null;
        const mojoAsyncFunctionPromises = [];
        function getOrCreatePrimaryRemote() {
            if (!globalRemote) {
                globalRemote = golden.Primary.getRemote();
            }
            return globalRemote;
        }
        // --- End program prefix ---
        """,
    codeSuffix: """
        // --- Begin program suffix ---
        // ExecJs awaits the promise returned by the last statement, so the
        // async functions run to completion (including code after `await`)
        // before the primary remote is closed. The leading `;` stops this from
        // being parsed as a call on the program's last line.
        ;(async () => {
            await Promise.allSettled(mojoAsyncFunctionPromises);
            if (globalRemote) {globalRemote.$.close()}
        })();
        // --- End program suffix ---
        """,
    ecmaVersion: v8Profile.ecmaVersion,
    startupTests: [
        ("fuzzilli('FUZZILLI_PRINT', 'test')", .shouldSucceed),
        (
            """
            if (typeof golden == 'undefined' \
            || golden?.Primary === undefined) \
            throw 'Primary not found'
            """,
            .shouldSucceed
        ),
    ] + v8Profile.startupTests,
    additionalCodeGenerators: [
        (MojoMethodCallGenerator, 10000),
        (MojoPropertyRetrievalGenerator, 10000),
        (MojoGoldenRemoteFromJsRouterListenerGenerator, 5000),
        (MojoGoldenReceiverFromBrowserRouterListenerGenerator, 5000),
    ] + commonMojoCodeGenerators,
    additionalProgramTemplates: WeightedList([]),
    disabledCodeGenerators: mojoDisabledGenerators,
    disabledMutators: [
        "ExplorationMutator", "ProbingMutator", "PropertyAccessorMutator"
    ],
    additionalBuiltins: mojoBuiltins.merging(commonMojoBuiltins) { (existing, _) in existing },
    additionalObjectGroups: mojoObjectGroups,
    additionalEnumerations: [
    ] + commonMojoEnumerations,
    additionalOptionsBags: [] + commonMojoOptionsBags,
    optionalPostProcessor: nil
)