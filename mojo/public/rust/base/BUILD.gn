import("//build/rust/rust_static_library.gni")

# Rust support code for the typemaps of `mojo_base` mojom types, analogous to
# //mojo/public/cpp/base for C++.

# Exposes the C++ validation checks for `mojo_base.mojom.ReadOnlyFile` to the
# Rust typemap in //mojo/public/mojom/base.
rust_static_library("read_only_file_checks") {
  crate_root = "read_only_file_checks.rs"
  sources = [ "read_only_file_checks.rs" ]
  cxx_bindings = [ "read_only_file_checks.rs" ]
  allow_unsafe = true

  deps = [
    "//base",
    "//base:file",
    "//mojo/public/cpp/base:shared_typemap_traits",
  ]

  visibility = [ "//mojo/public/mojom/base:*" ]
}
