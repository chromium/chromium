{%- from "enum.tmpl" import declare_enum -%}
{%- from "union.tmpl" import declare_union -%}
{%- from "struct.tmpl" import declare_struct -%}
{%- from "interface.tmpl" import declare_interface -%}

// Generated by //mojo/public/tools/bindings/generators/mojom_rust_generator.py
// from {{module.path}}

#![allow(non_camel_case_types)]
#![allow(non_snake_case)]
#![allow(non_upper_case_globals)]
{#- TODO(crbug.com/500058268): See if we can only add imports that are actually needed #}
#![allow(unused_imports)]

chromium::import! {
    "//mojo/public/rust/mojom_value_parser";
    "//mojo/public/rust/bindings";
    "//mojo/public/rust/system";
{% for imprt in imports %}
    "{{imprt.target}}" as {{imprt.alias}};
{%- endfor %}
}

use std::collections::HashMap;
use ordered_float::OrderedFloat;
use bindings::interface::{Registrar, ResponseSender};

use mojom_value_parser::*;

{% for enum in module.enums %}
{{ declare_enum(enum.name, enum) }}
{% endfor -%}

{# Comment for whitespace purposes #}
{% for struct in module.structs %}
{%- for enum in struct.enums %}
{{- declare_enum(struct.name ~ "_" ~ enum.name, enum) }}
{# Comment for whitespace purposes #}
{% endfor %}
{%- endfor -%}

{% for interface in module.interfaces %}
{%- for enum in interface.enums %}
{{- declare_enum(interface.name ~ "_" ~ enum.name, enum) }}
{# Comment for whitespace purposes #}
{% endfor %}
{%- endfor -%}

{% for union in module.unions %}
{{ declare_union(union.name, union) }}
{% endfor -%}

{% for struct in module.structs %}
{{ declare_struct(struct.name, struct, true) }}
{% endfor -%}

{% for interface in module.interfaces %}
{{ declare_interface(interface) }}
{%- endfor -%}

{% for traits in typemaps_to_include %}
#[path = r"{{traits.path}}"]
mod {{traits.name}};
pub use {{traits.name}}::*;
{% endfor %}

{% for t in typemapped_types %}
impl<__MojomContext> mojom_value_parser::MojomParse<{{t.mojom_name}}, __MojomContext> for {{t.rust_name}}
where
    {{t.mojom_name}}: mojom_value_parser::MojomParse<{{t.mojom_name}}, __MojomContext>,
{
    fn mojom_type() -> mojom_value_parser::MojomType {
        <{{t.mojom_name}} as mojom_value_parser::MojomParse<{{t.mojom_name}}, __MojomContext>>::mojom_type()
    }

    fn into_mojom_value(self, context: &__MojomContext) -> mojom_value_parser::MojomValue {
        let wire_val: {{t.mojom_name}} = self.into();
        <{{t.mojom_name}} as mojom_value_parser::MojomParse<{{t.mojom_name}}, __MojomContext>>::into_mojom_value(wire_val, context)
    }

    fn try_from_mojom_value(val: mojom_value_parser::MojomValue, context: &__MojomContext) -> anyhow::Result<Self> {
        let wire_val: {{t.mojom_name}} = <{{t.mojom_name}} as mojom_value_parser::MojomParse<{{t.mojom_name}}, __MojomContext>>::try_from_mojom_value(val, context)?;
        std::convert::TryInto::try_into(wire_val).map_err(Into::into)
    }
}
{% endfor %}