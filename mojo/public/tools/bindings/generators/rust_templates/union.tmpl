{% macro declare_union(name, union) -%}

{%- set traits = union|derivable_traits -%}

{# Debug is included for convenience, testing, and debugging. -#}
#[derive(Debug, MojomParse)]
{%- if traits %}
#[derive({{traits|join(", ")}})]
{%- endif %}
pub enum {{name}} {
{%- for field in union.fields %}
{%- set parse_as = field.kind|get_parse_as_type %}
{%- if parse_as %}
  #[mojom(parse_as = "{{parse_as}}")]
{%- endif %}
  {{field.name}}({{field.kind|to_rust_type}}),
{%- endfor %}
}

{%- endmacro -%}