{%  if generate_closure_exports -%}
goog.provide('{{module.namespace}}.{{union.name}}');
{% endif %}

mojo.internal.Union(
    {{module.namespace}}.{{union.name}}Spec.$, '{{union.name}}',
    {
{%- for field in union.fields %}
      '{{field.name}}': {
        'ordinal': {{field.ordinal}},
        'type': {{field.kind|lite_js_type}},
{%-    if field.kind.is_nullable %}
        'nullable': true,
{%-    endif %}
      },
{%- endfor %}
    });

/**
 * @typedef { {
{%- for field in union.fields %}
 *   {{field.name}}: ({{field.kind|lite_closure_type_with_nullability}}|undefined),
{%-  endfor %}
 * } }
 */
{{module.namespace}}.{{union.name}};

{#--- Fuzzing #}
{%- if generate_fuzzing %}
/**
 * Fuzzing-only constructors, one per union variant. `new {{union.name}}.foo(x)`
 * returns the plain object `{foo: x}`, which is how unions are represented in
 * these bindings. Fuzzers can then produce unions through typed constructor
 * calls instead of object literals that lack type information.
 * @const
 */
{{module.namespace}}.{{union.name}} = {
{%- for field in union.fields %}
  '{{field.name}}': function(value) {
    return {'{{field.name}}': value};
  },
{%- endfor %}
};
{%- endif %}
