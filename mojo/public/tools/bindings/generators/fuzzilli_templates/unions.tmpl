{%- import "macros.tmpl" as macros -%}

extension ILType {
{%- for union in unions %}
    fileprivate static let {{union|format_il_type}}: ILType = .object(
        ofGroup: "{{union|fully_qualified_name}}",
        withProperties: [
        {%- for field in union.fields %}
            "{{field.name}}",
        {%- endfor %}
        ])
    {%- for field in union.fields %}
    fileprivate static let {{union|format_il_type}}
        {{- field.name|to_camel}}Constructor: ILType = .constructor(
        [{{macros.to_fuzzilli_parameter(field)}}] => .{{union|format_il_type}})
    {%- endfor %}
{%- endfor %}
}

extension ObjectGroup {
{%- for union in unions %}
    fileprivate static let {{union|format_unique_name|to_camel(True)}} = ObjectGroup(
        name: "{{union|fully_qualified_name}}",
        instanceType: .{{union|format_il_type}},
        properties: [
            {%- for field in union.fields %}
            "{{field.name}}": .{{field.kind|format_il_type}},
            {%- endfor %}
        ],
        methods: [:]
    )
{%- endfor %}
}
