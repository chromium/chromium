/// Every ObjectGroup registered by this profile. Also used by `isTargetObject`
/// to decide which variables the Mojo generators operate on.
private let mojoObjectGroups: [ObjectGroup] = [
{%- for remote in interface_remotes %}
    .{{remote|format_unique_name|to_camel(True)}}Remote,
    .{{remote|format_unique_name|to_camel(True)}}RemoteWrapper,
{%- if remote in interface_pending_receivers %}
    .{{remote|format_unique_name|to_camel(True)}}PendingReceiver,
{%- endif %}
{%- if remote in interface_associated_pending_receivers %}
    .{{remote|format_unique_name|to_camel(True)}}PendingAssociatedReceiver,
{%- endif %}
{%- endfor %}
{%- for receiver in interface_receivers %}
    .{{receiver|format_unique_name|to_camel(True)}}CallbackRouter,
    .{{receiver|format_unique_name|to_camel(True)}}CallbackRouterReceiverHelper,
{%- if receiver in interface_pending_receivers or
       receiver in interface_associated_pending_receivers %}
    .{{receiver|format_unique_name|to_camel(True)}}ReceiverEndpoint,
{%- endif %}
{%- if receiver in interface_pending_receivers or
       receiver in interface_pending_remotes %}
    .{{receiver|format_unique_name|to_camel(True)}}PendingReceiver,
{%- endif %}
{%- if receiver in interface_pending_remotes %}
    .{{receiver|format_unique_name|to_camel(True)}}PendingRemote,
{%- endif %}
{%- if receiver in interface_associated_pending_receivers or
       receiver in interface_associated_pending_remotes %}
    .{{receiver|format_unique_name|to_camel(True)}}PendingAssociatedReceiver,
{%- endif %}
{%- if receiver in interface_associated_pending_remotes %}
    .{{receiver|format_unique_name|to_camel(True)}}PendingAssociatedRemote,
{%- endif %}
{%- if receiver in interface_pending_remotes or
       receiver in interface_associated_pending_remotes %}
    .{{receiver|format_unique_name|to_camel(True)}}RemoteWrapper,
{%- endif %}
    {%- for method in receiver.methods %}
    .{{(method|callback_receiver_name)|to_camel(True)}},
    {%- endfor %}
{%- endfor %}
{%- for struct in structs + response_structs %}
    .{{struct|format_unique_name|to_camel(True)}},
{%- endfor %}
{%- for union in unions %}
    .{{union|format_unique_name|to_camel(True)}},
{%- endfor %}
] + commonMojoObjectGroups

private let mojoBuiltins: [String: ILType] = [
    /// Profiles declare this method, a wrapper method around `getRemote` that follows
    /// the Singleton pattern, in `codePrefix`. This method ensures: (1) `getRemote`
    /// is only called once, and (2) the remote is saved to a global variable so it
    /// can be closed at the end of the program.
    "getOrCreatePrimaryRemote": .function([] => .{{primary|format_il_type}}),
    /// Declared in `codePrefix`. `MojoAsyncFunctionGenerator` pushes the promise
    /// of every async function it emits, and `codeSuffix` awaits them all. Typed
    /// as an opaque object Fuzzilli does not use it as a general-purpose array.
    "mojoAsyncFunctionPromises": .object(withMethods: ["push"]),
{%- for remote in interface_remotes %}
    {#- TODO(crbug.com/522372048): Primary interfaces can also be used as non-primary
        interfaces. Add support for this use case. #}
    {%- if remote != primary and
        (remote in interface_pending_receivers or
         remote in interface_associated_pending_receivers) %}
    "{{remote|fully_qualified_name}}Remote":
       .constructor([] => .{{remote|format_il_type}}),
    {%- endif %}
{%- endfor %}
{%- for receiver in interface_receivers %}
    "{{receiver|fully_qualified_name}}CallbackRouter":
       .constructor([] => .js{{receiver|format_unique_name}}CallbackRouter),
{%- endfor %}
{%- for struct in structs %}
    "{{struct|fully_qualified_name}}": .{{struct|format_il_type}}Constructor,
{%- endfor %}
{%- for union in unions %}
    {%- for field in union.fields %}
    "{{union|fully_qualified_name}}.{{field.name}}": .{{union|format_il_type}}
        {{- field.name|to_camel}}Constructor,
    {%- endfor %}
{%- endfor %}
]

private let keepGenerators = [
    "IntegerGenerator", "StringGenerator", "TernaryOperationGenerator",
    "PlainFunctionGenerator", "SubroutineReturnGenerator", "TryCatchGenerator",
]

private let mojoDisabledGenerators: [String] = CodeGenerators.map { $0.name }
    .filter {
        !keepGenerators.contains($0)
    }

let mojo{{primary.name}}Profile = Profile(
    processArgs: { _ in return [] },
    processArgsReference: nil,
    processEnv: [
        "ASAN_OPTIONS": "detect_odr_violation=0:abort_on_error=1", "DISPLAY": ":20",
    ],
    maxExecsBeforeRespawn: 50,
    timeout: Timeout.interval(11000, 11000),
    // The first statement tells js_in_process_fuzzer which Mojo scripts page to
    // load before running the program.
    codePrefix: """
        // --- Begin program prefix ---
        'mojo-scripts-page: /gen/{{mojo_scripts_page_path}}';
        let globalRemote = null;
        const mojoAsyncFunctionPromises = [];
        function getOrCreatePrimaryRemote() {
            if (!globalRemote) {
                globalRemote = {{primary|fully_qualified_name}}.getRemote();
            }
            return globalRemote;
        }
        // --- End program prefix ---
        """,
    codeSuffix: """
        // --- Begin program suffix ---
        // ExecJs awaits the promise returned by the last statement, so the
        // async functions run to completion (including code after `await`)
        // before the primary remote is closed. The leading `;` stops this from
        // being parsed as a call on the program's last line.
        ;(async () => {
            await Promise.allSettled(mojoAsyncFunctionPromises);
            if (globalRemote) {globalRemote.$.close()}
        })();
        // --- End program suffix ---
        """,
    ecmaVersion: v8Profile.ecmaVersion,
    startupTests: [
        ("fuzzilli('FUZZILLI_PRINT', 'test')", .shouldSucceed),
        (
            """
            if (typeof {{(primary.module.namespace|namespace_as_array)[0]}} == 'undefined' \
            || {{((primary.module.namespace|namespace_as_array)+ [primary.name]) | join('?.')}} === undefined) \
            throw '{{primary.name}} not found'
            """,
            .shouldSucceed
        ),
    ] + v8Profile.startupTests,
    additionalCodeGenerators: [
        (MojoMethodCallGenerator, 10000),
        (MojoPropertyRetrievalGenerator, 10000),
{%- for receiver in interface_receivers %}
    {%- if receiver.methods %}
        (Mojo{{receiver|format_unique_name}}RouterListenerGenerator, 5000),
    {%- endif %}
{%- endfor %}
{%- for array in arrays %}
        (Mojo{{array|format_unique_name}}Generator, 1),
{%- endfor %}
{%- for m in maps %}
        (Mojo{{m|format_unique_name}}Generator, 1),
{%- endfor %}
    ] + commonMojoCodeGenerators,
    additionalProgramTemplates: WeightedList([]),
    disabledCodeGenerators: mojoDisabledGenerators,
    disabledMutators: [
        "ExplorationMutator", "ProbingMutator", "PropertyAccessorMutator"
    ],
    additionalBuiltins: mojoBuiltins.merging(commonMojoBuiltins) { (existing, _) in existing },
    additionalObjectGroups: mojoObjectGroups,
    additionalEnumerations: [
{%- for enum in enums %}
        .{{enum|format_il_type}},
{%- endfor %}
    ] + commonMojoEnumerations,
    additionalOptionsBags: [] + commonMojoOptionsBags,
    optionalPostProcessor: nil
)
