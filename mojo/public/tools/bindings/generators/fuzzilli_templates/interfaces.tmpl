{%- import "macros.tmpl" as macros -%}

extension ILType {
{%- for remote in interface_remotes %}
    // {{remote.name}}
    fileprivate static let {{remote|format_il_type}}: ILType = .object(
        ofGroup: "{{remote|fully_qualified_name}}Remote",
        withProperties: ["$"],
        withMethods: [
            {%- for method in remote.methods %}
            "{{method.name}}",
            {%- endfor %}
        ])
    fileprivate static let js{{remote|format_unique_name}}RemoteWrapper: ILType = .object(
        ofGroup: "{{remote|fully_qualified_name}}RemoteWrapper",
        withMethods: [
          "close",
          "isBound",
          {%- if remote in interface_pending_receivers %}
          "bindNewPipeAndPassReceiver",
          {%- endif %}
          {%- if remote in interface_associated_pending_receivers %}
          "associateAndPassReceiver",
          {%- endif %}
        ])

    {%- if remote in interface_pending_receivers %}
    fileprivate static let js{{remote|format_unique_name}}PendingReceiver: ILType = .object(
        ofGroup: "{{remote|fully_qualified_name}}PendingReceiver")
    {%- endif %}
    {%- if remote in interface_associated_pending_receivers %}
    fileprivate static let js{{remote|format_unique_name}}PendingAssociatedReceiver: ILType = .object(
        ofGroup: "{{remote|fully_qualified_name}}PendingAssociatedReceiver")
    {%- endif %}
{% endfor -%}
{%- for receiver in interface_receivers %}
    // {{receiver.name}}
    fileprivate static let js{{receiver|format_unique_name}}CallbackRouter: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}CallbackRouter",
        withProperties: [
            "$",
            {%- for method in receiver.methods %}
            "{{method.name}}",
            {%- endfor %}
        ])
    fileprivate static let js{{receiver|format_unique_name}}CallbackRouterReceiverHelper: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}CallbackRouterReceiverHelper",
        withMethods: [
          "close",
          {%- if receiver in interface_pending_receivers or
                 receiver in interface_associated_pending_receivers %}
          "bindHandle",
          {%- endif %}
          {%- if receiver in interface_pending_remotes %}
          "bindNewPipeAndPassRemote",
          {%- endif %}
          {%- if receiver in interface_associated_pending_remotes %}
          "associateAndPassRemote",
          {%- endif %}
        ])
    {%- if receiver in interface_pending_receivers or
           receiver in interface_associated_pending_receivers %}
    fileprivate static let js{{receiver|format_unique_name}}ReceiverEndpoint: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}ReceiverEndpoint")
    {%- endif %}
    {#- When JS creates a pending remote, its `RemoteWrapper` can, in turn,
        create a pending receiver. #}
    {%- if receiver in interface_pending_receivers or
           receiver in interface_pending_remotes %}
    fileprivate static let js{{receiver|format_unique_name}}PendingReceiver: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}PendingReceiver"
        {%- if receiver in interface_pending_receivers or
               receiver in interface_associated_pending_receivers %},
        withProperties: ["handle"]
        {%- endif %})
    {%- endif %}
    {%- if receiver in interface_pending_remotes %}
    fileprivate static let js{{receiver|format_unique_name}}PendingRemote: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}PendingRemote",
        withProperties: ["$"])
    {%- endif %}
    {%- if receiver in interface_associated_pending_receivers or
           receiver in interface_associated_pending_remotes %}
    fileprivate static let js{{receiver|format_unique_name}}PendingAssociatedReceiver: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}PendingAssociatedReceiver"
        {%- if receiver in interface_pending_receivers or
               receiver in interface_associated_pending_receivers %},
        withProperties: ["handle"]
        {%- endif %})
    {%- endif %}
    {%- if receiver in interface_associated_pending_remotes %}
    fileprivate static let js{{receiver|format_unique_name}}PendingAssociatedRemote: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}PendingAssociatedRemote",
        withProperties: ["$"])
    {%- endif %}
    {%- if receiver in interface_pending_remotes or
           receiver in interface_associated_pending_remotes %}
    fileprivate static let js{{receiver|format_unique_name}}RemoteWrapper: ILType = .object(
        ofGroup: "{{receiver|fully_qualified_name}}RemoteWrapper",
        withMethods: [
          "close",
          "isBound",
          {%- if receiver in interface_pending_remotes %}
          "bindNewPipeAndPassReceiver",
          {%- endif %}
          {%- if receiver in interface_associated_pending_remotes %}
          "associateAndPassReceiver",
          {%- endif %}
        ])
    {%- endif %}
    {%- for method in receiver.methods %}
    fileprivate static let js{{method|callback_receiver_name}}: ILType = .object(
        ofGroup: "{{method|callback_receiver_name}}",
        withMethods: ["addListener"])
    {%- endfor %}
{% endfor -%}
}

extension ObjectGroup {
{%- for remote in interface_remotes %}
    // {{remote.name}}
    fileprivate static let {{remote|format_unique_name|to_camel(True)}}Remote = ObjectGroup(
        name: "{{remote|fully_qualified_name}}Remote",
        instanceType: .{{remote|format_il_type}},
        properties: ["$": .js{{remote|format_unique_name}}RemoteWrapper],
        {%- if remote.methods %}
        methods: [
        {%- for method in remote.methods %}
            "{{method.name}}": [
            {%- for parameter in method.parameters %}
                {{ macros.to_fuzzilli_parameter(parameter) }},
            {%- endfor %}
            {#-
                The `{{ "" }}` preserves a whitespace between `=>` and the return type. The
                whitespace is necessary to avoid a syntax error.
            #}
            ] => {{ "" }}
            {%- if method.response_param_struct -%}
                .jsPromise(resolvingTo: .{{method.response_param_struct|format_il_type}})
            {%- else -%}
                .undefined
            {%- endif %},
        {%- endfor %}
        ]
        {%- else %}
        methods: [:]
        {%- endif %}
    )

    fileprivate static let {{remote|format_unique_name|to_camel(True)}}RemoteWrapper = ObjectGroup(
        name: "{{remote|fully_qualified_name}}RemoteWrapper",
        instanceType: .js{{remote|format_unique_name}}RemoteWrapper,
        properties: [:],
        methods: [
            "close": [] => .undefined,
            "isBound": [] => .boolean,
            {%- if remote in interface_pending_receivers %}
            "bindNewPipeAndPassReceiver": [] => .js{{remote|format_unique_name}}PendingReceiver,
            {%- endif %}
            {%- if remote in interface_associated_pending_receivers %}
            "associateAndPassReceiver": [] => .js{{remote|format_unique_name}}PendingAssociatedReceiver,
            {%- endif %}
        ])

    {%- if remote in interface_pending_receivers %}
    fileprivate static let {{remote|format_unique_name|to_camel(True)}}PendingReceiver = ObjectGroup(
        name: "{{remote|fully_qualified_name}}PendingReceiver",
        instanceType: .js{{remote|format_unique_name}}PendingReceiver,
        properties: [:],
        methods: [:]
    )
    {%- endif %}
    {%- if remote in interface_associated_pending_receivers %}
    fileprivate static let {{remote|format_unique_name|to_camel(True)}}PendingAssociatedReceiver = ObjectGroup(
        name: "{{remote|fully_qualified_name}}PendingAssociatedReceiver",
        instanceType: .js{{remote|format_unique_name}}PendingAssociatedReceiver,
        properties: [:],
        methods: [:]
    )
    {%- endif %}
{% endfor -%}
{%- for receiver in interface_receivers %}
    // {{receiver.name}}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}CallbackRouter = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}CallbackRouter",
        instanceType: .js{{receiver|format_unique_name}}CallbackRouter,
        properties: [
            "$": .js{{receiver|format_unique_name}}CallbackRouterReceiverHelper,
            {%- for method in receiver.methods %}
            "{{method.name}}": .js{{method|callback_receiver_name}},
            {%- endfor %}
        ],
        methods: [:]
    )
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}CallbackRouterReceiverHelper = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}CallbackRouterReceiverHelper",
        instanceType: .js{{receiver|format_unique_name}}CallbackRouterReceiverHelper,
        properties: [:],
        methods: [
            "close": [] => .undefined,
            {%- if receiver in interface_pending_receivers or
                   receiver in interface_associated_pending_receivers %}
            "bindHandle": [.plain(.js{{receiver|format_unique_name}}ReceiverEndpoint)] => .undefined,
            {%- endif %}
            {%- if receiver in interface_pending_remotes %}
            "bindNewPipeAndPassRemote": [] => .js{{receiver|format_unique_name}}PendingRemote,
            {%- endif %}
            {%- if receiver in interface_associated_pending_remotes %}
            "associateAndPassRemote": [] => .js{{receiver|format_unique_name}}PendingAssociatedRemote,
            {%- endif %}
        ])
    {%- for method in receiver.methods %}

    fileprivate static let {{method|callback_receiver_name|to_camel(True)}} = ObjectGroup(
        name: "{{method|callback_receiver_name}}",
        instanceType: .js{{method|callback_receiver_name}},
        properties: [:],
        methods: [
            "addListener": [
                .plain(
                    .function(
                        [
                        {%- for parameter in method.parameters %}
                            {{ macros.to_fuzzilli_parameter(parameter) }},
                        {%- endfor %}
                        ] => .undefined))
            ] => .integer,
        ])
    {%- endfor %}
    {%- if receiver in interface_pending_receivers or
           receiver in interface_associated_pending_receivers %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}ReceiverEndpoint = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}ReceiverEndpoint",
        instanceType: .js{{receiver|format_unique_name}}ReceiverEndpoint,
        properties: [:],
        methods: [:]
    )
    {%- endif %}
    {#- When JS creates a pending remote, its `RemoteWrapper` can, in turn,
        create a pending receiver. #}
    {%- if receiver in interface_pending_receivers or
           receiver in interface_pending_remotes %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}PendingReceiver = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}PendingReceiver",
        instanceType: .js{{receiver|format_unique_name}}PendingReceiver,
        {%- if receiver in interface_pending_receivers or
               receiver in interface_associated_pending_receivers %}
        properties: ["handle": .js{{receiver|format_unique_name}}ReceiverEndpoint],
        {%- else %}
        properties: [:],
        {%- endif %}
        methods: [:]
    )
    {%- endif %}
    {%- if receiver in interface_pending_remotes %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}PendingRemote = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}PendingRemote",
        instanceType: .js{{receiver|format_unique_name}}PendingRemote,
        properties: ["$": .js{{receiver|format_unique_name}}RemoteWrapper],
        methods: [:]
    )
    {%- endif %}
    {%- if receiver in interface_associated_pending_receivers or
           receiver in interface_associated_pending_remotes %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}PendingAssociatedReceiver = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}PendingAssociatedReceiver",
        instanceType: .js{{receiver|format_unique_name}}PendingAssociatedReceiver,
        {%- if receiver in interface_pending_receivers or
               receiver in interface_associated_pending_receivers %}
        properties: ["handle": .js{{receiver|format_unique_name}}ReceiverEndpoint],
        {%- else %}
        properties: [:],
        {%- endif %}
        methods: [:]
    )
    {%- endif %}
    {%- if receiver in interface_associated_pending_remotes %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}PendingAssociatedRemote = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}PendingAssociatedRemote",
        instanceType: .js{{receiver|format_unique_name}}PendingAssociatedRemote,
        properties: ["$": .js{{receiver|format_unique_name}}RemoteWrapper],
        methods: [:]
    )
    {%- endif %}
    {%- if receiver in interface_pending_remotes or
           receiver in interface_associated_pending_remotes %}
    fileprivate static let {{receiver|format_unique_name|to_camel(True)}}RemoteWrapper = ObjectGroup(
        name: "{{receiver|fully_qualified_name}}RemoteWrapper",
        instanceType: .js{{receiver|format_unique_name}}RemoteWrapper,
        properties: [:],
        methods: [
            "close": [] => .undefined,
            "isBound": [] => .boolean,
            {%- if receiver in interface_pending_remotes %}
            "bindNewPipeAndPassReceiver": [] => .js{{receiver|format_unique_name}}PendingReceiver,
            {%- endif %}
            {%- if receiver in interface_associated_pending_remotes %}
            {#- TODO(crbug.com/532195391): Investigate associateAndPassReceiver impact on correctness #}
            "associateAndPassReceiver": [] => .js{{receiver|format_unique_name}}PendingAssociatedReceiver,
            {%- endif %}
        ])
    {%- endif %}
{% endfor -%}
}
