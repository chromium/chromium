/// Follows a chain of calls from a remote that culminates in a remote. Each call
/// either returns a remote in its reply, or takes a receiver for a new remote.
/// There may also be remotes retrieved along the chain, which Fuzzilli can
/// interact with as well.
///
    {%- endif %}
/// Chain{{loop.index}}:
    {%- for step in chain %}
        {%- if step|is_reply_step %}
///   {{step.method.interface.name}}.{{step.method.name}}().{{step.path|join(".")}}
        {%- else %}
///   {{step.method.interface.name}}.{{step.method.name}}({{step.remote.name}} receiver)
        {%- endif %}
    {%- endfor %}
    {%- set root = chain[0].method.interface %}
    {%- set from_primary = root|format_unique_name == primary|format_unique_name %}
    {%- if from_primary %}
private let MojoReplyChain{{loop.index}}Generator = CodeGenerator(
    "MojoReplyChain{{loop.index}}Generator", inContext: .single(.async)
) { b{% if not from_primary %}, root{% endif %} in
    var remote = b.callFunction(
        b.createNamedVariable(forBuiltin: "getOrCreatePrimaryRemote"), withArgs: [])
    {%- else %}
private let MojoReplyChain{{loop.index}}Generator = CodeGenerator(
    "MojoReplyChain{{loop.index}}Generator", inContext: .single(.async),
    inputs: .required(.{{root|format_il_type}})
) { b{% if not from_primary %}, root{% endif %} in
    var remote = root
    {%- endif %}
    {%- for step in chain %}
        {%- if step|is_reply_step %}
    remote = awaitRemoteChain(b, "{{step.method.name}}", on: remote, at: ["{{step.path|join('", "')}}"])
        {%- else %}
    remote = passReceiver(
        b, "{{step.method.name}}", on: remote, at: {{step.param_index}},
        constructor: "{{step.remote|fully_qualified_name}}Remote", bind: "{{step.bind_function}}")
        {%- endif %}
    {%- endfor %}
}
{%- endfor %}
