/// Names of the ObjectGroups whose `addListener` method registers a listener
/// on a CallbackRouter.
private let mojoCallbackReceiverGroups: Set<String> = [
{%- for receiver in js_implemented_interfaces %}
    {%- for method in receiver.methods %}
    ObjectGroup.{{(method|callback_receiver_name)|to_camel(True)}}.name,
    {%- endfor %}
{%- endfor %}
]

/// Names of the ObjectGroups registered by this profile that the Mojo
/// generators operate on. The CallbackReceivers are left out: their
/// `addListener` calls are left to the router listener generators, which build
/// proper listeners.
private let mojoTargetGroups = Set(mojoObjectGroups.map { $0.name })
    .subtracting(mojoCallbackReceiverGroups)

private func isTargetObject(type: ILType) -> Bool {
    guard type.Is(.object()), let group = type.group else { return false }
    return mojoTargetGroups.contains(group)
}

/// Picks a Mojo variable whose type satisfies `predicate`. It picks an object
/// group first, and then a variable of that group, so that each interface in
/// scope gets the same share of picks, regardless of many variables hold it.
private func findTargetVariable(
    _ b: ProgramBuilder, where predicate: (ILType) -> Bool
) -> Variable? {
    let groups = Set(b.visibleVariables.compactMap { v -> String? in
        let type = b.type(of: v)
        return isTargetObject(type: type) && predicate(type) ? type.group : nil
    })
    guard let group = groups.randomElement() else { return nil }
    return b.findVariable {
        let type = b.type(of: $0)
        return type.group == group && predicate(type)
    }
}

/// Mojo variant of the builtin `MethodCallGenerator` that operates only on
/// "Mojo" objects instead of all the objects in the JavaScript environment,
/// most of which are unrelated to the interface. This generator emits random
/// method calls, generating any arguments that are not available.
private let MojoMethodCallGenerator = CodeGenerator("MojoMethodCallGenerator") {
    b in
    // If we can't find a Mojo object in scope, create the {{primary.name}} remote
    guard let obj = findTargetVariable(b, where: { !$0.methods.isEmpty }) else {
        let getRemoteFunc = b.createNamedVariable(forBuiltin: "getOrCreatePrimaryRemote")
        b.callFunction(getRemoteFunc, withArgs: [])
        return
    }

    let methodName = b.type(of: obj).randomMethod()!
    let signatures = b.methodSignatures(of: methodName, on: obj)
    let signature = chooseUniform(from: signatures)
    let arguments = b.findOrGenerateArguments(forSignature: signature, maxNumberOfVariablesToGenerate: 1000)
    b.callMethod(methodName, on: obj, withArgs: arguments, guard: false)
}

/// Mojo variant of the builtin `PropertyRetrievalGenerator` that operates only
/// on "Mojo" objects instead of all the objects in the JavaScript environment,
/// most of which are unrelated to the interface. This generator emits random
/// property retrievals.
private let MojoPropertyRetrievalGenerator = CodeGenerator(
    "MojoPropertyRetrievalGenerator"
) { b in
    guard let obj = findTargetVariable(b, where: { !$0.properties.isEmpty }) else { return }

    let propertyName = b.type(of: obj).randomProperty()!
    b.getProperty(propertyName, of: obj)
}

{%- for receiver in js_implemented_interfaces %}
    {%- if receiver.methods %}

/// Generates a call to add a callback to the {{
        receiver|format_unique_name|to_camel(true)}}CallbackRouter.
///
/// The callback has one parameter, specified with `.parameters(n: 1)`. `build(n: 5)`
/// then tells Fuzzilli to populate the callback body with five random expressions.
private let Mojo{{receiver|format_unique_name}}RouterListenerGenerator = CodeGenerator(
    "Mojo{{receiver|format_unique_name}}RouterListenerGenerator",
    inputs: .required(.js{{receiver|format_unique_name}}CallbackRouter)
) { b, router in
    guard
        let eventName = ILType.js{{receiver|format_unique_name}}CallbackRouter.properties
            .subtracting(["$"])
            .randomElement()
    else {
        return
    }

    let listenerHost = b.getProperty(eventName, of: router)
    let callback = b.buildPlainFunction(with: .parameters(n: 1)) { args in
        if probability(0.2) {
            b.buildIf(args[0]) {
                let wrapper = b.getProperty("$", of: args[0])
                b.callMethod("close", on: wrapper, withArgs: [])
            }
        }
        b.build(n: 5)
    }
    b.callMethod("addListener", on: listenerHost, withArgs: [callback])
}
    {%- endif %}
{%- endfor %}
{%- if remote_chains %}

/// Awaits a call to `method` on `remote` and returns the remote at `path` in
/// the reply. Replies may hold null structs, unset union fields and null
/// remotes, so the call and the property retrievals use optional chaining: the
/// rest of the chain gets `undefined` instead of throwing.
private func awaitRemoteChain(
    _ b: ProgramBuilder, _ method: String, on remote: Variable, at path: [String]
) -> Variable {
    let signature = b.methodSignatures(of: method, on: remote)[0]
    let arguments = b.findOrGenerateArguments(
                        forSignature: signature,
                        maxNumberOfVariablesToGenerate: 1000)
    var value = b.await(b.callMethod(
        method, on: remote, withArgs: arguments, guard: false, isReceiverOptional: true))
    for property in path {
        value = b.getProperty(property, of: value, isReceiverOptional: true)
    }
    return value
}
{%- endif %}
{%- for chain in remote_chains %}
    {%- if loop.first %}
/// Follows a chain of replies from a remote that culminates in a remote. There
/// may also be remotes retrieved along the chain, which Fuzzilli can interact
/// with as well.
///
    {%- endif %}
/// Chain{{loop.index}}:
    {%- for method, path in chain %}
///   {{method.interface.name}}.{{method.name}}().{{path|join(".")}}
    {%- endfor %}
    {%- set root = chain[0][0].interface %}
    {%- set from_primary = root|format_unique_name == primary|format_unique_name %}
    {%- if from_primary %}
private let MojoReplyChain{{loop.index}}Generator = CodeGenerator(
    "MojoReplyChain{{loop.index}}Generator", inContext: .single(.async)
) { b{% if not from_primary %}, root{% endif %} in
    var remote = b.callFunction(
        b.createNamedVariable(forBuiltin: "getOrCreatePrimaryRemote"), withArgs: [])
    {%- else %}
private let MojoReplyChain{{loop.index}}Generator = CodeGenerator(
    "MojoReplyChain{{loop.index}}Generator", inContext: .single(.async),
    inputs: .required(.{{root|format_il_type}})
) { b{% if not from_primary %}, root{% endif %} in
    var remote = root
    {%- endif %}
    {%- for method, path in chain %}
    remote = awaitRemoteChain(b, "{{method.name}}", on: remote, at: ["{{path|join('", "')}}"])
    {%- endfor %}
}
{%- endfor %}
