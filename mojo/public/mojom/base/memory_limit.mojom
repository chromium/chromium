module mojo_base.mojom;

// Corresponds to `base::MemoryLimit` in base/memory_coordinator/memory_limit.h.
struct MemoryLimit {
  // A percentage representing the memory limit relative to baseline (100%).
  // Must be non-negative (>= 0). Values over 100% are supported.
  int32 percentage;
};
