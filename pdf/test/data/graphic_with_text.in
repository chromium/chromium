{{header}}
% Exercises detection of Form XObjects that combine graphics and visible text.
%
% The page contains:
% - Plain body text before the form ("Before graphic")
% - /Fm1: A Form XObject with a nested form drawing a rectangle path (/Fm1Box)
%   and visible text ("Inside graphic"), which qualifies as a graphic.
% - /Fm2: A Form XObject with text only ("Text only form"), which does not
%   qualify as a graphic.
% - /Fm3: A Form XObject with a path and invisible text (3 Tr), which does not
%   qualify as a graphic.
% - Plain body text after the forms ("After graphic")
{{object 1 0}} <<
  /Type /Catalog
  /Pages 2 0 R
>>
endobj
{{object 2 0}} <<
  /Type /Pages
  /MediaBox [0 0 400 400]
  /Count 1
  /Kids [3 0 R]
>>
endobj
{{object 3 0}} <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /Fm1 6 0 R
      /Fm2 7 0 R
      /Fm3 8 0 R
    >>
  >>
  /Contents 5 0 R
>>
endobj
{{object 4 0}} <<
  /Type /Font
  /Subtype /Type1
  /BaseFont /Times-Roman
>>
endobj
{{object 5 0}} <<
  {{streamlen}}
>>
stream
BT
/F1 12 Tf
20 350 Td
(Before graphic) Tj
ET
q
/Fm1 Do
Q
q
/Fm2 Do
Q
q
/Fm3 Do
Q
BT
/F1 12 Tf
20 50 Td
(After graphic) Tj
ET
endstream
endobj
{{object 6 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 200 100]
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /Fm1Box 9 0 R
    >>
  >>
  {{streamlen}}
>>
stream
q
/Fm1Box Do
Q
BT
/F1 12 Tf
60 220 Td
(Inside graphic) Tj
ET
endstream
endobj
{{object 7 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 200 100]
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
  >>
  {{streamlen}}
>>
stream
BT
/F1 12 Tf
20 150 Td
(Text only form) Tj
ET
endstream
endobj
{{object 8 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 200 100]
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
  >>
  {{streamlen}}
>>
stream
50 70 120 20 re S
BT
/F1 12 Tf
3 Tr
60 75 Td
(Invisible text) Tj
ET
endstream
endobj
{{object 9 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 200 100]
  {{streamlen}}
>>
stream
50 200 120 60 re S
endstream
endobj
{{xref}}
{{trailer}}
{{startxref}}
