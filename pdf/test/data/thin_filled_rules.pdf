%PDF-1.7
% ò¤ô
% Exercises extraction of filled, axis-aligned rectangles, such as table borders
% drawn by Skia/PDF.
%
% The page contains:
% 1. Simple horizontal rules (three fill-only rectangles)
% 2. Two rules in one path
% 3. Skia-style closed rectangle under a flipped matrix (M L L L L(close))
% 4. Skia-style unclosed rectangle under a flipped matrix (M L L L)
% 5. Unclosed rectangle whose last point lies on its implicit closing edge
% 6. Vertical rule
% 7. Rectangles of other sizes:
%    - A thick filled rectangle
%    - A thin but short filled rectangle
%    - A filled rectangle over 4 px thick
% 8. Rectangle in a path with a curved subpath
% 9. Shapes that must be ignored:
%    - A thin filled rectangle rotated 30 degrees
%    - A stroked rectangle
%    - A thin filled rectangle with a transparent fill (/ca 0)
%    - A thin L-shape
%    - A rectangle with a curved edge
1 0 obj <<
  /Type /Catalog
  /Pages 2 0 R
>>
endobj
2 0 obj <<
  /Type /Pages
  /MediaBox [0 0 400 400]
  /Count 1
  /Kids [3 0 R]
>>
endobj
3 0 obj <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /ExtGState <<
      /GS1 5 0 R
    >>
  >>
  /Contents 4 0 R
>>
endobj
4 0 obj <<
  /Length 1189
>>
stream
% 1. Simple horizontal rules
50 300 300 0.8 re f
50 280 300 0.5 re f
50 240 300 0.8 re f
% 2. Two rules in one path
50 200 300 0.5 re
50 180 300 0.5 re
f
