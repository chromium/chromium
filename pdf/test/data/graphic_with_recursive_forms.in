{{header}}
% Exercises graphic detection on pathological Form XObject nesting.
%
% /FmDeep1 through /FmDeep32 form a chain in which each form only invokes
% the next, and /FmDeep32 draws a rectangle path. The page contains:
% - Plain body text before the forms ("Before graphic")
% - /FmTooDeep: A Form XObject with visible text ("Too deep graphic") that
%   enters the chain at /FmDeep1, putting the path 32 levels down, beyond
%   kMaxFormDepth in pdfium_page.cc. This does not qualify as a graphic.
% - /FmDeep: A Form XObject with visible text ("Deep graphic") that enters the
%   chain at /FmDeep2, putting the path 31 levels down. This qualifies as a
%   graphic.
% - /FmLoop: A Form XObject drawing a rectangle path and invoking itself. It
%   has no text, so it does not qualify as a graphic, but it must not hang.
% - Plain body text after the forms ("After graphic")
{{object 1 0}} <<
  /Type /Catalog
  /Pages 2 0 R
>>
endobj
{{object 2 0}} <<
  /Type /Pages
  /MediaBox [0 0 400 400]
  /Count 1
  /Kids [3 0 R]
>>
endobj
{{object 3 0}} <<
  /Type /Page
  /Parent 2 0 R
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /FmLoop 6 0 R
      /FmDeep 7 0 R
      /FmTooDeep 8 0 R
    >>
  >>
  /Contents 5 0 R
>>
endobj
{{object 4 0}} <<
  /Type /Font
  /Subtype /Type1
  /BaseFont /Times-Roman
>>
endobj
{{object 5 0}} <<
  {{streamlen}}
>>
stream
BT
/F1 12 Tf
20 350 Td
(Before graphic) Tj
ET
q
/FmTooDeep Do
Q
q
/FmDeep Do
Q
q
/FmLoop Do
Q
BT
/F1 12 Tf
20 50 Td
(After graphic) Tj
ET
endstream
endobj
{{object 6 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 400 400]
  /Resources <<
    /XObject <<
      /FmLoop 6 0 R
    >>
  >>
  {{streamlen}}
>>
stream
250 100 120 60 re S
/FmLoop Do
endstream
endobj
{{object 7 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 400 400]
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /FmDeep2 10 0 R
    >>
  >>
  {{streamlen}}
>>
stream
BT
/F1 12 Tf
60 120 Td
(Deep graphic) Tj
ET
/FmDeep2 Do
endstream
endobj
{{object 8 0}} <<
  /Type /XObject
  /Subtype /Form
  /BBox [0 0 400 400]
  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /FmDeep1 9 0 R
    >>
  >>
  {{streamlen}}
>>
stream
BT
/F1 12 Tf
60 220 Td
(Too deep graphic) Tj
ET
1 0 0 1 0 100 cm
/FmDeep1 Do
endstream
endobj
