  /Resources <<
    /Font <<
      /F1 4 0 R
    >>
    /XObject <<
      /Fm1 6 0 R
      /Fm2 7 0 R
      /Fm3 8 0 R
    >>
  >>
  /Contents 5 0 R
>>
endobj
4 0 obj <<
  /Type /Font
  /Subtype /Type1
  /BaseFont /Times-Roman
>>
endobj
5 0 obj <<
  /Length 125
>>
