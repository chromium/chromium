import("//build/config/android/channel.gni")
import("//build/config/android/config.gni")
import("//build/config/chrome_build.gni")
import("//build/config/compiler/pgo/pgo.gni")

declare_args() {
  # Show a launcher icon to open WebView developer UI. This is enabled by
  # default for all prestable builds.
  webview_devui_show_icon =
      android_channel != "stable" && !use_stable_package_name
}

# We can't include an icon for anything with the Stable channel package name
# because it confuses work profiles.
assert(!webview_devui_show_icon || !use_stable_package_name,
       "webview_devui_show_icon is incompatible with use_stable_package_name")

upstream_only_webview_deps = [
  "//android_webview/nonembedded:devui_banner_resources",
  "//android_webview/nonembedded:icon_resources",
]

use_webview_pgo_profile = current_cpu == "arm64" && chrome_pgo_phase == 2
use_webview_pgo_profile_default_toolchain =
    target_cpu == "arm64" && chrome_pgo_phase_default_toolchain == 2

if (use_webview_pgo_profile_default_toolchain) {
  webview_toolchain = "//build/toolchain/android:android_clang_arm64_webview"
}
