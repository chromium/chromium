module devtools_media_encoding_service.mojom;

import "media/mojo/mojom/media_types.mojom";
import "mojo/public/mojom/base/time.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// Client interface to receive encoded and multiplexed media chunks from the
// encoding server, as well as a lifecycle notification when the recording stops.
interface DevToolsMediaEncodingServiceClient {
  // Receives a chunk of encoded and multiplexed media stream data (e.g., MP4).
  OnData(array<uint8> data);

  // Receives a single encoded video frame chunk when encoding with
  // `Output.kEncodedFrames`. `data` and `timestamp` come from the sandboxed
  // utility process: browser-side implementations treat `data` as opaque bytes
  // (never parsing or decoding it) and match `timestamp` against
  // browser-recorded frames rather than trusting it directly.
  OnEncodedVideoFrame(array<uint8> data,
                      bool key_frame,
                      mojo_base.mojom.TimeDelta timestamp);

  // Invoked when recording has stopped, all active encoders have flushed, and
  // any final data has been delivered.
  OnClosed();
};

// Output format produced by DevToolsMediaEncodingService.
enum Output {
  // Multiplexed MP4 chunks delivered via
  // DevToolsMediaEncodingServiceClient.OnData().
  kMp4,
  // Containerless encoded video frames delivered via OnEncodedVideoFrame().
  // Used by DevTools tracing (devtools.video_screenshot) so each frame retains
  // its 1:1 compositor metadata without an MP4 muxer or the 1s idle keep-alive
  // timer used by MediaRecorder, and can be decoded directly via WebCodecs.
  kEncodedFrames,
};

// Latency vs quality trade-off for the video encoder.
enum LatencyMode {
  kRealtime,
  kQuality,
};

// Configuration options for DevToolsMediaEncodingService.StartRecording().
struct RecordingOptions {
  Output output = Output.kMp4;
  // Expected frames per second (0 uses an output-specific default).
  uint32 frame_rate = 0;
  // Whether audio buffers will be recorded and multiplexed (only valid when
  // `output` is `kMp4`).
  bool record_audio = false;
  LatencyMode latency_mode = LatencyMode.kRealtime;
  // Maximum frames between keyframes (0 uses an output-specific default).
  uint32 keyframe_interval = 0;
};

// A utility-process service used by DevTools to encode raw video frames and
// audio buffers into compressed formats (e.g., AV1, Opus) and multiplex them
// into a media container (e.g., MP4).
//
// Trust boundary: This interface is implemented in the utility process and
// called by the browser process. DevToolsMediaEncodingServiceClient is
// implemented in the browser process.
[ServiceSandbox=sandbox.mojom.Sandbox.kUtility]
interface DevToolsMediaEncodingService {
  // Initializes the recording session and binds the client for receiving data.
  StartRecording(pending_remote<DevToolsMediaEncodingServiceClient> client,
                 RecordingOptions options);

  // Submits a raw video frame to be encoded and multiplexed into the stream.
  RecordVideoFrame(media.mojom.VideoFrame frame);

  // Submits a raw audio buffer to be encoded and multiplexed into the stream.
  RecordAudioBuffer(media.mojom.AudioBuffer buffer);

  // Flushes active encoders, completes multiplexing, delivers final data chunks
  // to the client, and invokes OnClosed() on the client.
  StopRecording();
};
