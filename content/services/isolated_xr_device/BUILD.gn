import("//device/vr/buildflags/buildflags.gni")

source_set("lib") {
  sources = [
    "xr_device_service.cc",
    "xr_device_service.h",
    "xr_runtime_provider.cc",
    "xr_runtime_provider.h",
  ]

  configs += [ "//content:content_implementation" ]

  if (enable_openxr) {
    configs += [ "//third_party/openxr:config" ]
  }

  deps = [
    "//base",
    "//content/public/common:common_sources",
    "//device/base",
    "//device/vr",
    "//device/vr:vr_base",
    "//device/vr/public/mojom:isolated_xr_service",
    "//services/viz/public/cpp/gpu",
  ]
}

if (is_linux) {
  # Pre-sandbox hook for the XR Device Service (kXrCompositing) on Linux.
  # Loads the OpenXR runtime and grants the broker file access the runtime
  # needs before the sandbox seals.
  source_set("xr_sandbox_hook") {
    sources = [
      "xr_sandbox_hook_linux.cc",
      "xr_sandbox_hook_linux.h",
    ]

    deps = [
      "//base",
      "//sandbox/linux:sandbox_services",
    ]

    public_deps = [ "//sandbox/policy" ]
  }
}
