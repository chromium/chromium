import("//chromecast/build/tests/cast_test.gni")
import("//chromecast/chromecast.gni")
import("//chromecast/starboard/starboard.gni")
import("//testing/test.gni")

if (!remove_starboard_headers) {
  import(
      "//chromecast/starboard/third_party/starboard/sabi/base_configuration.gni")
}

# This is necessary until code under //chromecast/starboard/media/renderer is
# hooked up to production code. This way, gn can find those test targets.
cast_test_group("starboard_renderer_tests") {
  tests =
      [ "//chromecast/starboard/media/renderer:starboard_renderer_unittests" ]
}

source_set("starboard") {
  public = [
    "media_pipeline_backend_starboard.h",
    "starboard_audio_decoder.h",
    "starboard_decoder.h",
    "starboard_video_decoder.h",
    "starboard_video_plane.h",
  ]
  sources = [
    "cast_media_starboard.cc",
    "media_pipeline_backend_starboard.cc",
    "starboard_audio_decoder.cc",
    "starboard_decoder.cc",
    "starboard_video_decoder.cc",
    "starboard_video_plane.cc",
    "starboard_volume_control.cc",
  ]
  public_deps = [
    ":drm_util",
    ":starboard_api_wrapper",
    "//base",
    "//chromecast/public",
    "//chromecast/public/media",
    "//chromecast/starboard/chromecast/starboard_cast_api:cast_starboard_api_types",
    "//chromecast/starboard/media/cdm:starboard_drm_wrapper",
  ]
  deps = [
    ":mime_utils",
    ":starboard_resampler",
    "//chromecast/base",
    "//chromecast/starboard/chromecast/starboard_adapter",
    "//chromecast/starboard/media/cdm:starboard_drm_key_tracker",
    "//media",
    "//ui/display",
    "//ui/gfx/geometry",
  ]
}

source_set("starboard_resampler") {
  public = [ "starboard_resampler.h" ]
  sources = [ "starboard_resampler.cc" ]
  public_deps = [
    "//base",
    "//chromecast/public/media",
    "//chromecast/starboard/chromecast/starboard_cast_api:cast_starboard_api_types",
    "//media",
  ]
}

source_set("drm_util") {
  public = [ "drm_util.h" ]
  sources = [ "drm_util.cc" ]
  public_deps = [
    ":starboard_api_wrapper",
    "//chromecast/public/media",
    "//media",
  ]
}

source_set("mock_starboard_api_wrapper") {
  testonly = true
  public = [ "mock_starboard_api_wrapper.h" ]
  sources = [ "mock_starboard_api_wrapper.cc" ]
  public_deps = [
    ":starboard_api_wrapper",
    "//testing/gmock",
  ]
}

cast_source_set("starboard_api_wrapper_headers") {
  sources = [
    "starboard_api_wrapper.cc",
    "starboard_api_wrapper.h",
  ]
  public_deps = [ "//base" ]
}

cast_source_set("starboard_api_wrapper") {
  sources = []
  deps = [ ":starboard_api_wrapper_headers" ]
  public_deps = [
    ":starboard_api_wrapper_headers",
    "//base",
  ]

  # TODO(b/333131992): remove this case.
  if (remove_starboard_headers) {
    sources += [ "starboard_api_wrapper_dummy.cc" ]
  } else {
    sources += [ "starboard_api_wrapper_proxy.cc" ]
    deps += [ "//chromecast/starboard:starboard_adapter_loader" ]
  }
}

if (!remove_starboard_headers) {
  template("starboard_api_wrapper_versioned_impl") {
    version = invoker.version
    if (version >= 15) {
      wrapper_source = "starboard_api_wrapper_15.cc"
    } else {
      wrapper_source = "starboard_api_wrapper_14.cc"
    }

    cast_source_set(target_name) {
      sources = [
        "starboard_api_wrapper_base.cc",
        "starboard_api_wrapper_base.h",
        wrapper_source,
      ]
      deps = [
        "//chromecast/common:timing_tracker",
        "//chromecast/starboard/chromecast/starboard_adapter:starboard_adapter_public",
      ]
      public_deps = [
        ":starboard_api_wrapper_headers",
        "//base",
        "//chromecast/starboard/third_party/starboard/public",
      ]
      cflags = [
        "-USB_API_VERSION",
        "-DSB_API_VERSION=$version",
      ]
    }
  }

  starboard_api_wrapper_versioned_impl("starboard_api_wrapper_impl_14") {
    version = 14
  }

  starboard_api_wrapper_versioned_impl("starboard_api_wrapper_impl_15") {
    version = 15
  }

  starboard_api_wrapper_versioned_impl("starboard_api_wrapper_impl_16") {
    version = 16
  }

  starboard_api_wrapper_versioned_impl("starboard_api_wrapper_impl_17") {
    version = 17
  }
}

cast_source_set("mime_utils") {
  sources = [
    "mime_utils.cc",
    "mime_utils.h",
  ]
  public_deps = [
    "//chromecast/public/media",
    "//media",
  ]
  deps = [
    "//base",
    "//chromecast/media/base:media_codec_support",
