}

source_set("test_matchers") {
  testonly = true
  public = [ "test_matchers.h" ]
  sources = [ "test_matchers.cc" ]
  public_deps = [
    ":starboard_api_wrapper",
    "//testing/gmock",
  ]
}

test("starboard_media_unittests") {
  sources = [
    "drm_util_test.cc",
