group("providers") {
  deps = [
    ":cobalt",
    ":navigation",
    ":zoom",
  ]
}

source_set("navigation") {
  sources = [ "web_navigation.mm" ]
  deps = [ "//ios/public/provider/web:navigation" ]
  frameworks = [ "WebKit.framework" ]
}

source_set("cobalt") {
  sources = [ "web_cobalt.mm" ]
  deps = [ "//ios/public/provider/web:cobalt" ]
}

source_set("zoom") {
  sources = [ "web_zoom.mm" ]
  deps = [ "//ios/public/provider/web:zoom" ]
  frameworks = [ "WebKit.framework" ]
}
