source_set("spinners") {
  sources = [
    "spinning_overlay_coordinator.h",
    "spinning_overlay_coordinator.mm",
    "spinning_overlay_mediator.h",
    "spinning_overlay_mediator.mm",
    "spinning_overlay_view.h",
    "spinning_overlay_view.mm",
    "spinning_overlay_view_delegate.h",
  ]

  deps = [
    "//base",
    "//ios/chrome/browser/overlays/model",
    "//ios/chrome/browser/overlays/model/public/web_content_area",
    "//ios/chrome/browser/overlays/ui_bundled:coordinators",
    "//ios/chrome/browser/shared/model/browser",
    "//ios/chrome/browser/shared/ui/util",
    "//ios/chrome/common/ui/colors",
    "//ios/chrome/common/ui/util",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "spinning_overlay_coordinator_unittest.mm",
    "spinning_overlay_mediator_unittest.mm",
  ]

  deps = [
    ":spinners",
    "//base/test:test_support",
    "//ios/chrome/browser/overlays/model",
    "//ios/chrome/browser/overlays/model/public/web_content_area",
    "//ios/chrome/browser/overlays/model/test",
    "//ios/chrome/browser/overlays/ui_bundled/test",
    "//ios/chrome/browser/shared/model/browser/test:test_support",
    "//ios/chrome/browser/shared/model/profile/test",
    "//ios/chrome/test:test_support",
    "//ios/web/public/test",
    "//testing/gtest",
  ]
}
