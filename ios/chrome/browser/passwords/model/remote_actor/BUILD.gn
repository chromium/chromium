    "//components/password_manager/core/browser/remote_actor",
    "//crypto",
    "//ios/chrome/browser/passwords/model/remote_actor/proto",
    "//testing/gtest",
    "//url",
  ]
  frameworks = [
    "Foundation.framework",
    "Security.framework",
  ]
}
