source_set("remote_actor") {
  sources = [
    "ios_chrome_remote_actor_credential_sharing_service_factory.h",
    "ios_chrome_remote_actor_credential_sharing_service_factory.mm",
    "remote_actor_credential_sharing_delegate_bridge.h",
    "remote_actor_credential_sharing_delegate_bridge.mm",
    "remote_actor_keychain_util.h",
    "remote_actor_keychain_util.mm",
    "remote_actor_payload_parser.h",
    "remote_actor_payload_parser.mm",
  ]
  public_deps = [
    "//base",
    "//components/password_manager/core/browser/remote_actor",
    "//ios/chrome/browser/passwords/model/remote_actor/proto",
    "//ios/chrome/browser/shared/model/profile:profile_keyed_service_factory",
  ]
  deps = [
    "//components/keyed_service/core",
    "//components/password_manager/core/browser:password_form",
    "//components/password_manager/core/common",
    "//crypto",
