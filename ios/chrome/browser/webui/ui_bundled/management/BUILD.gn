  deps = [
    "//base",
    "//components/device_signals/core/browser",
    "//components/enterprise",
    "//components/enterprise/connectors/core",
    "//components/enterprise/net/core",
    "//components/policy/core/common",
    "//components/policy/proto",
    "//components/prefs",
    "//components/resources",
    "//components/strings",
    "//ios/chrome/app/strings",
    "//ios/chrome/browser/enterprise/connectors",
    "//ios/chrome/browser/enterprise/connectors:util",
    "//ios/chrome/browser/enterprise/signals/model",
    "//ios/chrome/browser/policy/model",
    "//ios/chrome/browser/policy/ui_bundled:management_util",
    "//ios/chrome/browser/shared/model/application_context",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/shared/model/url:constants",
    "//ios/chrome/browser/signin/model",
    "//ios/chrome/browser/signin/model:authentication_service_factory",
