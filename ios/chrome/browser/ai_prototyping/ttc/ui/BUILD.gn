source_set("ui") {
  sources = [
    "ttc_consumer.h",
    "ttc_mutator.h",
    "ttc_view_controller.h",
    "ttc_view_controller.mm",
    "ttc_voice_plate_consumer.h",
    "ttc_voice_plate_mutator.h",
    "ttc_voice_plate_view.h",
    "ttc_voice_plate_view.mm",
    "ttc_waveform_view.h",
    "ttc_waveform_view.mm",
  ]
  deps = [
    "//base",
    "//ios/chrome/browser/ai_prototyping/ui",
    "//ios/chrome/browser/ai_prototyping/utils",
    "//ios/chrome/browser/shared/ui/symbols",
    "//ios/chrome/common/ui/colors",
    "//ios/chrome/common/ui/util",
  ]
  frameworks = [
    "QuartzCore.framework",
    "UIKit.framework",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ttc_voice_plate_view_unittest.mm",
    "ttc_waveform_view_unittest.mm",
  ]
  deps = [
    ":ui",
    "//base",
    "//base/test:test_support",
    "//ios/chrome/common/ui/colors",
    "//testing/gtest",
    "//third_party/ocmock",
  ]
}
