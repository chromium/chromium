    ":model",
    "//base",
    "//base/test:test_support",
    "//components/keyed_service/core",
    "//ios/chrome/browser/ai_prototyping/ttc/model/audio",
    "//ios/chrome/browser/shared/model/profile/test",
    "//ios/chrome/browser/shared/public/features",
    "//ios/chrome/test/providers/intelligence",
    "//ios/public/provider/chrome/browser/intelligence:intelligence_api",
    "//ios/web/public/test",
    "//testing/gtest",
    "//third_party/ocmock",
  ]
  frameworks = [
    "Foundation.framework",
    "UIKit.framework",
  ]
}
