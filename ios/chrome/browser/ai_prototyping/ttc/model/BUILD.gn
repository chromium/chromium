source_set("model") {
  sources = [
    "ttc_backend.h",
    "ttc_conversation.h",
    "ttc_conversation.mm",
    "ttc_conversation_delegate.h",
    "ttc_error_codes.h",
    "ttc_error_codes.mm",
    "ttc_keyed_service.h",
    "ttc_keyed_service.mm",
    "ttc_keyed_service_factory.h",
    "ttc_keyed_service_factory.mm",
    "ttc_session_controller.h",
    "ttc_session_controller.mm",
    "ttc_session_controller_observer.h",
    "ttc_states.h",
    "ttc_websocket_backend+Testing.h",
    "ttc_websocket_backend.h",
    "ttc_websocket_backend.mm",
  ]
  deps = [
    "//base",
    "//components/keyed_service/core",
    "//ios/chrome/browser/ai_prototyping/ttc/model/audio",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/shared/model/profile:profile_keyed_service_factory",
    "//ios/chrome/browser/shared/public/features",
    "//ios/public/provider/chrome/browser/intelligence:intelligence_api",
    "//url",
  ]
  frameworks = [
    "Foundation.framework",
    "UIKit.framework",
  ]
}

