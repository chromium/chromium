source_set("model") {
  sources = [
    "ttc_audio_engine.h",
    "ttc_audio_engine.mm",
    "ttc_audio_engine_delegate.h",
    "ttc_audio_metrics.h",
    "ttc_audio_metrics.mm",
    "ttc_audio_player.h",
    "ttc_audio_player.mm",
    "ttc_audio_player_delegate.h",
    "ttc_audio_recorder.h",
    "ttc_audio_recorder.mm",
    "ttc_audio_recorder_delegate.h",
  ]
  deps = [
    "//base",
    "//ios/web/public/thread",
  ]
  frameworks = [
    "AVFAudio.framework",
    "Accelerate.framework",
    "Foundation.framework",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ttc_audio_engine_unittest.mm",
    "ttc_audio_metrics_unittest.mm",
    "ttc_audio_player_unittest.mm",
    "ttc_audio_recorder_unittest.mm",
  ]
  deps = [
    ":model",
    "//base",
    "//base/test:test_support",
    "//ios/web/public/test",
    "//testing/gtest",
  ]
  frameworks = [
    "AVFAudio.framework",
    "Foundation.framework",
  ]
}
