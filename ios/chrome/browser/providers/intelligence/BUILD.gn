source_set("chromium_intelligence") {
  sources = [
    "classification_metrics_tab_helper_api.mm",
    "page_classification_api.mm",
    "page_context_wrapper_api.mm",
    "ttc_api.mm",
  ]
  deps = [
    "//ios/public/provider/chrome/browser/intelligence:intelligence_api",
