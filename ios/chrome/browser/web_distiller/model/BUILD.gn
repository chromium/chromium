    "distiller_service_factory_unittest.mm",
    "distiller_service_unittest.mm",
  ]
  deps = [
    ":model",
    "//base/test:test_support",
    "//ios/chrome/browser/shared/model/profile/test",
    "//ios/web/public/test",
    "//testing/gtest",
  ]
}
