import("//build/config/ios/rules.gni")

bundle_data_xcassets("assets") {
  catalog = "Assets.xcassets"
  sources = [
    "Assets.xcassets/Contents.json",
    "Assets.xcassets/ntp_theme_tip.imageset/Contents.json",
    "Assets.xcassets/ntp_theme_tip.imageset/ntp_theme_tip.png",
    "Assets.xcassets/ntp_theme_tip.imageset/ntp_theme_tip@2x.png",
    "Assets.xcassets/ntp_theme_tip.imageset/ntp_theme_tip@3x.png",
  ]
}

bundle_data("resources") {
  sources = [
    "ntp_customization.json",
    "save_passwords.json",
    "save_passwords_darkmode.json",
    "use_autofill.json",
  ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  public_deps = [ ":assets" ]
}
