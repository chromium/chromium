    "badge_type.h",
    "location_bar_badge_configuration.h",
    "location_bar_badge_configuration.mm",
    "location_bar_badge_tab_helper.h",
    "location_bar_badge_tab_helper.mm",
    "location_bar_badge_tab_helper_observer.h",
    "location_bar_badge_tab_helper_observer_bridge.h",
    "location_bar_badge_tab_helper_observer_bridge.mm",
    "location_bar_badge_util.h",
    "location_bar_badge_util.mm",
