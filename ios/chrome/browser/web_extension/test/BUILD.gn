source_set("eg_app_support+eg2") {
  configs += [ "//build/config/ios:xctest_config" ]
  testonly = true
  sources = [
    "web_extension_app_interface.h",
    "web_extension_app_interface.mm",
  ]
  deps = [
    "//base",
    "//ios/chrome/app",
    "//ios/chrome/app:app_internal",
    "//ios/chrome/app/application_delegate:app_state",
    "//ios/chrome/app/profile",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/web_extension/model:test_support",
    "//ios/chrome/test/app:test_support",
    "//ios/chrome/test/earl_grey:switches",
  ]
}

source_set("eg_test_support+eg2") {
  configs += [ "//build/config/ios:xctest_config" ]
  testonly = true
  sources = [
    "web_extension_app_interface.h",
    "web_extension_app_interface_stub.mm",
  ]
  deps = [ "//ios/testing/earl_grey:eg_test_support+eg2" ]
}

source_set("eg2_tests") {
  configs += [ "//build/config/ios:xctest_config" ]
  testonly = true
  sources = [ "web_extension_startup_egtest.mm" ]
  deps = [
    ":eg_test_support+eg2",
    "//base",
    "//base/test:test_support",
    "//ios/chrome/test/earl_grey:eg_test_support+eg2",
    "//ios/chrome/test/earl_grey:switches",
    "//ios/testing/earl_grey:eg_test_support+eg2",
    "//ios/testing/earl_grey:launch_configuration",
  ]
  frameworks = [ "UIKit.framework" ]
}
