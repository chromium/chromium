source_set("model") {
  sources = [
    "extension_service.h",
    "extension_service.mm",
    "extension_service_factory.h",
    "extension_service_factory.mm",
  ]
  deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/universal_optout",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/shared/model/profile:profile_keyed_service_factory",
    "//ios/chrome/browser/universal_optout/model",
    "//ios/web/public/extension",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "extension_service_unittest.mm" ]
  deps = [
    ":model",
    "//base",
    "//base/test:test_support",
    "//components/metrics",
    "//components/metrics:test_support",
    "//components/prefs:test_support",
    "//components/signin/public/identity_manager:test_support",
    "//components/universal_optout",
    "//components/variations:test_support",
    "//ios/chrome/browser/shared/model/profile/test",
    "//ios/chrome/browser/universal_optout/model",
    "//ios/chrome/test:test_support",
    "//ios/web/public/extension",
    "//ios/web/public/test",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
