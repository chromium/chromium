source_set("screen_provider") {
  sources = [
    "screen_provider.h",
    "screen_provider.mm",
  ]
  public_deps = [ ":screen_type" ]
  frameworks = [ "Foundation.framework" ]
}

source_set("screen_provider_protected") {
  sources = [ "screen_provider+protected.h" ]
  public_deps = [ ":screen_provider" ]
}

source_set("screen_type") {
  sources = [ "screen_type.h" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "screen_provider_unittest.mm" ]
  deps = [
    ":screen_provider",
    ":screen_provider_protected",
    ":screen_type",
    "//testing/gtest",
  ]
}
