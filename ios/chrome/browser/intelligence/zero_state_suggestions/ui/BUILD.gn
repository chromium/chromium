source_set("ui") {
  sources = [
    "gemini_zero_state_consumer.h",
    "gemini_zero_state_mutator.h",
    "gemini_zero_state_view_controller.h",
    "gemini_zero_state_view_controller.mm",
  ]

  deps = [
    "//base",
    "//ios/chrome/common/ui/colors",
    "//ios/chrome/common/ui/util",
  ]
  public_deps = [ "//ios/chrome/browser/intelligence/zero_state_suggestions" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "gemini_zero_state_view_controller_unittest.mm" ]
  deps = [
    ":ui",
    "//base",
    "//ios/chrome/browser/intelligence/zero_state_suggestions",
    "//testing/gtest",
    "//third_party/ocmock",
  ]
}
