source_set("constants") {
  sources = [ "intelligence_ui_constants.h" ]
  frameworks = [ "CoreGraphics.framework" ]
}

source_set("ui") {
  sources = [
    "gradient_activity_indicator_view.h",
    "gradient_activity_indicator_view.mm",
    "intelligence_header_item.h",
    "intelligence_header_item.mm",
    "intelligence_header_view.h",
    "intelligence_header_view.mm",
  ]
  deps = [
    ":constants",
    "//base",
    "//ios/chrome/browser/shared/ui:buildflags",
    "//ios/chrome/browser/shared/ui/symbols",
    "//ios/chrome/browser/shared/ui/util",
    "//ios/chrome/common/ui/colors",
    "//ios/chrome/common/ui/util",
  ]
  frameworks = [
    "QuartzCore.framework",
    "UIKit.framework",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "intelligence_header_view_unittest.mm" ]
  deps = [
    ":ui",
    "//ios/chrome/browser/shared/ui/symbols",
    "//ios/chrome/test/app:test_support",
    "//testing/gtest",
  ]
  frameworks = [
    "QuartzCore.framework",
    "UIKit.framework",
  ]
}
