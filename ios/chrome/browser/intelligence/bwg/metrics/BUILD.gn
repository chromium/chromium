source_set("metrics") {
  sources = [
    "gemini_metrics.h",
    "gemini_metrics.mm",
    "gemini_session_metrics_manager.h",
    "gemini_session_metrics_manager.mm",
  ]
  deps = [
    "//base",
    "//components/contextual_cueing",
    "//components/optimization_guide/core",
    "//ios/chrome/browser/assistant/ui:detent",
    "//ios/chrome/browser/intelligence/bwg/utils:constants",
    "//ios/public/provider/chrome/browser/bwg:gemini_api",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "gemini_metrics_unittest.mm",
    "gemini_session_metrics_manager_unittest.mm",
  ]
  deps = [
    ":metrics",
    "//base",
    "//base/test:test_support",
    "//components/contextual_cueing",
    "//components/optimization_guide/core",
    "//ios/chrome/browser/assistant/ui:detent",
    "//ios/chrome/browser/intelligence/bwg/utils:constants",
    "//ios/public/provider/chrome/browser/bwg:gemini_api",
    "//testing/gtest",
  ]
}
