import("//ios/web/public/js_messaging/optimize_ts.gni")

optimize_ts("client_side_detection_ts") {
  visibility = [ ":client_side_detection" ]

  sources = [ "resources/client_side_detection.ts" ]
  deps = [ "//ios/web/public/js_messaging:util_scripts" ]
}

source_set("client_side_detection") {
  sources = [
    "client_side_detection_java_script_feature.h",
    "client_side_detection_java_script_feature.mm",
    "client_side_detection_service.h",
    "client_side_detection_service.mm",
    "client_side_detection_service_factory.h",
    "client_side_detection_service_factory.mm",
  ]

  deps = [
    ":client_side_detection_ts",
    "//base",
    "//components/optimization_guide/core:prediction",
    "//components/prefs",
    "//components/safe_browsing/core/browser",
    "//components/safe_browsing/core/common",
    "//components/safe_browsing/core/common:features",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/safe_browsing/core/common/phishing_classifier",
    "//components/safe_browsing/core/common/proto:csd_proto",
    "//components/safe_browsing/ios/browser/web_ui",
    "//ios/chrome/browser/optimization_guide/model",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/browser/shared/model/profile:profile_keyed_service_factory",
    "//ios/web/public",
    "//ios/web/public/js_messaging",
    "//services/network/public/cpp",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "client_side_detection_java_script_feature_unittest.mm",
    "client_side_detection_service_factory_unittest.mm",
    "client_side_detection_service_unittest.mm",
  ]

  deps = [
    ":client_side_detection",
    "//base",
    "//base/test:test_support",
    "//components/optimization_guide/core:prediction",
    "//components/prefs:test_support",
    "//components/safe_browsing/core/browser",
    "//components/safe_browsing/core/common",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/safe_browsing/core/common/phishing_classifier",
    "//components/safe_browsing/core/common/proto:csd_proto",
    "//components/safe_browsing/ios/browser/web_ui",
    "//ios/chrome/browser/optimization_guide/model",
    "//ios/chrome/browser/shared/model/profile/test",
    "//ios/chrome/test:test_support",
    "//ios/web/public/js_messaging",
    "//ios/web/public/test",
    "//net:test_support",
    "//services/network:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
