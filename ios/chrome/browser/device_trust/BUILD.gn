import("//ios/web/public/js_messaging/optimize_ts.gni")

optimize_ts("device_trust_api_ts") {
  sources = [ "device_trust.ts" ]
  deps = [
    "//ios/web/public/js_messaging:gcrweb",
    "//ios/web/public/js_messaging:util_scripts",
  ]
}

source_set("device_trust") {
  sources = [
    "device_trust_java_script_feature.h",
    "device_trust_java_script_feature.mm",
  ]

  deps = [
    ":device_trust_api_ts",
    "//base",
    "//ios/web/public",
    "//ios/web/public/js_messaging",
  ]
}

source_set("unit_tests") {
  testonly = true
  check_includes = true
  sources = [
    "device_trust_java_script_feature_unittest.mm",
    "device_trust_js_unittest.mm",
  ]
  deps = [
    ":device_trust",
    "//base",
    "//base/test:test_support",
    "//ios/chrome/test:ios_chrome_test_with_web_state",
    "//ios/web/public/js_messaging",
    "//ios/web/public/test",
    "//ios/web/public/test:javascript_test",
    "//testing/gtest",
    "//url",
  ]
}
