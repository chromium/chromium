source_set("eg_app_support+eg2") {
  testonly = true
  sources = [
    "data_protection_app_interface.h",
    "data_protection_app_interface.mm",
  ]
  deps = [
    "//base",
    "//components/prefs",
    "//ios/chrome/browser/enterprise/data_protection/model",
    "//ios/chrome/browser/enterprise/data_protection/public:pref_names",
    "//ios/chrome/browser/enterprise/data_protection/ui",
    "//ios/chrome/browser/overlays/model",
    "//ios/chrome/browser/shared/model/profile",
    "//ios/chrome/test/app:test_support",
    "//ios/web/public",
  ]
}

source_set("eg_test_support+eg2") {
  testonly = true
  sources = [
    "data_protection_app_interface.h",
    "data_protection_app_interface_stub.mm",
  ]
  deps = [ "//ios/testing/earl_grey:eg_test_support+eg2" ]
}

source_set("eg2_tests") {
  configs += [ "//build/config/ios:xctest_config" ]
  testonly = true
  sources = [ "data_protection_egtest.mm" ]
  deps = [
    ":eg_test_support+eg2",
    "//base/test:test_support",
    "//ios/chrome/browser/enterprise/data_protection/public:features",
    "//ios/chrome/test/earl_grey:eg_test_support+eg2",
    "//ios/testing/earl_grey:eg_test_support+eg2",
    "//net:test_support",
  ]
  frameworks = [ "UIKit.framework" ]
}
