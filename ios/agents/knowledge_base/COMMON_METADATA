agentic_review {
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*\\.(?:h|mm)"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "@property[^;\\n]*\\b(?:Browser|ProfileIOS|AppState|ProfileState|SceneState|ApplicationContext|CommandDispatcher)\\s*\\*"
    content_patterns: "-\\s*\\([^)]*\\)\\s*initWith[^;]*\\b(?:Browser|ProfileIOS|AppState|ProfileState|SceneState|ApplicationContext|CommandDispatcher)\\s*\\*"
    content_patterns: "\\bHandlerForProtocol\\s*\\(\\s*(?:self\\.)?_?(?:commandD|d)ispatcher\\b"
    content_patterns: "\\bGetApplicationContext\\s*\\(\\s*\\)"
    content_patterns: "\\b[A-Za-z0-9_]+(?:Service)?Factory::GetFor(?:Profile|BrowserState)\\b"
    content_patterns: "\\b(?:(?:base::)?raw_ptr<\\s*(?:const\\s+)?(?:Browser|ProfileIOS|ApplicationContext)\\s*>|(?:AppState|Browser|CommandDispatcher|ProfileIOS|ProfileState|SceneState|ApplicationContext)\\s*\\*)\\s*_[a-zA-Z0-9_]+\\s*;"
    rules: "ios/agents/knowledge_base/rules/chrome/line-in-the-sand-no-backbone-containers-in-mediators.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*_(?:mediator|browser_agent|tab_helper|service)(?:_impl)?\\.(?:cc|mm)"
    path_expression_exclusion: "ios/(?:.*/)?[^/]*test[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "ios/(?:.*/)?fakes?/(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "ios/(?:.*/)?test/(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "ios/third_party/.*"
    rules: "ios/agents/knowledge_base/rules/general/add-unit-tests-for-new-mediators-and-model-classes.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*\\.(?:h|mm)"
    path_expression_exclusion: ".*/test/.*"
    path_expression_exclusion: ".*_(?:egtest|unittest)\\.mm"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "\\bNSTimer\\b"
    content_patterns: "\\b(?:scheduledT|t)imerWithTimeInterval\\b"
    content_patterns: "\\bbase::(?:OneShotTimer|RepeatingTimer|RetainingOneShotTimer)\\b"
    rules: "ios/agents/knowledge_base/rules/general/invalidate-timers-in-teardown.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*\\.mm"
    path_expression_exclusion: ".*/test/.*"
    path_expression_exclusion: ".*_(?:egtest|unittest)\\.mm"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "\\.(?:text|title|placeholder|accessibilityLabel|accessibilityHint|accessibilityValue)\\s*=\\s*@\"[^\"]*[A-Za-z]"
    content_patterns: "\\bsetTitle:\\s*@\"[^\"]*[A-Za-z]"
    content_patterns: "\\b(?:actionWithTitle|alertControllerWithTitle|menuWithTitle):\\s*@\"[^\"]*[A-Za-z]"
    content_patterns: "\\bmessage:\\s*@\"[^\"]*[A-Za-z]"
    rules: "ios/agents/knowledge_base/rules/general/localize-user-visible-strings.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?(?:coordinator/(?:.*/)?[^/]*|[^/]*_(?:coordinator|mediator))\\.(?:h|mm)"
    path_expression_exclusion: "ios/(?:.*/)?[^/]*test[^/]*\\.(?:h|mm)"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "\\bstd::(?:vector|set|list|deque)<\\s*(?:(?:const\\s+)?[A-Za-z0-9_:]+\\s*\\*|(?:base::)?raw_ptr<\\s*(?:const\\s+)?[A-Za-z0-9_:]+\\s*>)\\s*>"
    content_patterns: "\\bstd::(?:unordered_)?map<[^,<>]+,\\s*(?:(?:const\\s+)?[A-Za-z0-9_:]+\\s*\\*|(?:base::)?raw_ptr<\\s*(?:const\\s+)?[A-Za-z0-9_:]+\\s*>)\\s*>"
    content_patterns: "\\b(?:base::)?raw_ptr<\\s*(?:const\\s+)?[A-Za-z0-9_:]*(?:Entry|Item|Form|Suggestion|Credential|Node)\\s*>"
    content_patterns: "\\bconst\\s+[A-Za-z0-9_:]*(?:Entry|Item|Form|Suggestion|Credential|Node)\\s*\\*\\s*_[a-zA-Z0-9_]+\\s*;"
    rules: "ios/agents/knowledge_base/rules/chrome/mediators-store-owned-values-not-pointers-into-model-caches.md"
  }
  capability_groups {
    path_expression: "ios/chrome/browser/(?:.*/)?(?:ui/(?:.*/)?[^/]*|ui_bundled/(?:.*/)?[^/]*(?:view_controller|_view|_cell)[^/]*)\\.(?:h|mm)"
    path_expression_exclusion: "ios/(?:.*/)?[^/]*(?:coordinator|mediator)[^/]*\\.(?:h|mm)"
    path_expression_exclusion: "ios/(?:.*/)?[^/]*test[^/]*\\.(?:h|mm)"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "@property[^;\\n]*\\b(?:AppState|Browser|CommandDispatcher|ProfileIOS|ProfileState|SceneState|WebStateList|web::WebState|[A-Za-z0-9_]*(?:BrowserAgent|TabHelper|Service))\\s*\\*"
    content_patterns: "-\\s*\\([^)]*\\)\\s*init[^;{]*\\b(?:AppState|Browser|CommandDispatcher|ProfileIOS|ProfileState|SceneState|WebStateList|web::WebState|[A-Za-z0-9_]*(?:BrowserAgent|TabHelper|Service))\\s*\\*"
    content_patterns: "\\b(?:(?:base::)?raw_ptr<\\s*(?:const\\s+)?(?:AppState|Browser|CommandDispatcher|ProfileIOS|ProfileState|SceneState|WebStateList|web::WebState|[A-Za-z0-9_:]*(?:BrowserAgent|TabHelper|Service))\\s*>|(?:AppState|Browser|CommandDispatcher|ProfileIOS|ProfileState|SceneState|WebStateList|web::WebState|[A-Za-z0-9_:]*(?:BrowserAgent|TabHelper|Service))\\s*\\*)\\s*_[a-zA-Z0-9_]+\\s*;"
    rules: "ios/agents/knowledge_base/rules/chrome/no-model-objects-in-view-controllers-or-views.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "@synchronized\\s*\\("
    content_patterns: "@property\\s*\\([^)]*\\batomic\\b"
    content_patterns: "\\b(?:base::Lock|base::AutoLock|std::mutex|std::lock_guard|NSLock|NSRecursiveLock|os_unfair_lock)\\b"
    rules: "ios/agents/knowledge_base/rules/general/no-multithreaded-objects.md"
  }
  capability_groups {
    path_expression: "ios/(?:.*/)?[^/]*\\.mm"
    path_expression_exclusion: ".*/test/.*"
    path_expression_exclusion: ".*_(?:egtest|unittest)\\.mm"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "\\baccessibility(?:Label|Value)\\s*=[^;]*@\"[^\"]*\\b(?:[Ss]elected|[Uu]nselected|[Dd]isabled|[Ee]nabled|[Cc]hecked|[Oo]n|[Oo]ff)\\b"
    content_patterns: "\\baccessibility(?:Label|Value)\\s*=[^;]*\\bIDS_[A-Z0-9_]*(?:SELECTED|DISABLED|ENABLED|CHECKED|_ON|_OFF)\\b"
    content_patterns: "\\baccessibility(?:Label|Value)\\s*=[^;]*\\b(?:stringWithFormat|stringByAppendingString)\\b"
    rules: "ios/agents/knowledge_base/rules/general/use-system-accessibility-traits-for-state.md"
  }
  capability_groups {
    path_expression: "ios/chrome/(?:.*/)?[^/]*_unittest\\.mm"
    path_expression_exclusion: "ios/third_party/.*"
    content_patterns: "\\bfor\\s*\\(\\s*(?:__(?:strong|weak)\\s+)?(?:[A-Z]\\w*\\s*\\*|id)\\s*\\w+\\s+in\\s+[^)]*\\.subviews\\b"
    content_patterns: "\\.subviews\\s+enumerateObjectsUsingBlock\\b"
    content_patterns: "\\b[A-Z]\\w*(?:<[^>]*>)?\\s*\\*\\s*Find[A-Z]\\w*\\s*\\(\\s*UIView\\s*\\*"
    rules: "ios/agents/knowledge_base/rules/chrome/use-uikit-test-util-for-view-lookup.md"
  }
}
