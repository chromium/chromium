{
  "GPU FYI Mac Builder (dbg)": {},
  "Mac FYI Retina Debug (AMD)": {
    "gtest_tests": [
      {
        "merge": {
          "script": "//testing/merge_scripts/standard_gtest_merge.py"
        },
        "module_name": "//gpu:gpu_unittests",
        "module_scheme": "gtest",
        "name": "gpu_unittests",
        "swarming": {
          "containment_type": "AUTO",
          "dimensions": {
            "cpu": "x86-64",
            "display_attached": "1",
