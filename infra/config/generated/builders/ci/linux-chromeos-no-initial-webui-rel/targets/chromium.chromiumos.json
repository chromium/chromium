{
  "linux-chromeos-no-initial-webui-rel": {
    "gtest_tests": [
      {
        "args": [
          "--disable-features=InitialWebUI,WebUIReloadButton,SkipIPCChannelPausingForNonGuests,WebUIInProcessResourceLoadingV2,InitialWebUISyncNavStartToCommit"
        ],
        "isolate_profile_data": true,
        "merge": {
          "script": "//testing/merge_scripts/standard_gtest_merge.py"
        },
        "module_name": "//chrome/test:browser_tests",
        "module_scheme": "gtest",
        "name": "browser_tests",
        "swarming": {
          "dimensions": {
            "cpu": "x86-64",
            "kvm": "1",
            "os": "Ubuntu-22.04"
          },
          "optional_dimensions": {
            "30": {
              "cpu": "x86-64-e4"
            }
          },
          "service_account": "chromium-tester@chops-service-accounts.iam.gserviceaccount.com",
          "shards": 14
        },
        "test": "browser_tests",
        "test_id_prefix": "ninja://chrome/test:browser_tests/"
      },
      {
        "args": [
          "--disable-features=InitialWebUI,WebUIReloadButton,SkipIPCChannelPausingForNonGuests,WebUIInProcessResourceLoadingV2,InitialWebUISyncNavStartToCommit"
        ],
        "isolate_profile_data": true,
        "merge": {
          "script": "//testing/merge_scripts/standard_gtest_merge.py"
        },
        "module_name": "//chrome/test:interactive_ui_tests",
        "module_scheme": "gtest",
        "name": "interactive_ui_tests",
        "swarming": {
          "dimensions": {
            "cpu": "x86-64",
            "os": "Ubuntu-22.04"
          },
          "service_account": "chromium-tester@chops-service-accounts.iam.gserviceaccount.com",
          "shards": 3
        },
        "test": "interactive_ui_tests",
        "test_id_prefix": "ninja://chrome/test:interactive_ui_tests/"
      },
      {
        "args": [
          "--disable-features=InitialWebUI,WebUIReloadButton,SkipIPCChannelPausingForNonGuests,WebUIInProcessResourceLoadingV2,InitialWebUISyncNavStartToCommit"
        ],
        "isolate_profile_data": true,
        "merge": {
          "script": "//testing/merge_scripts/standard_gtest_merge.py"
        },
        "module_name": "//chrome/test:unit_tests",
        "module_scheme": "gtest",
