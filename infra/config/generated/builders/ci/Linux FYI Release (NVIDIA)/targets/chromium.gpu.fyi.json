          "-v",
          "--stable-jobs",
          "--extra-browser-args=--enable-logging=stderr --js-flags=--expose-gc",
          "--enforce-browser-version",
          "--jobs=4"
        ],
        "merge": {
          "script": "//testing/merge_scripts/standard_isolated_script_merge.py"
