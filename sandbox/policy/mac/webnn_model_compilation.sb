; --- The contents of common.sb implicitly included here. ---

; Following rules allow the WebNN Compiler process to read and write to the
; temporary directory where CoreML writes compiled model files.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.membership"))

; Needed by NSFileManager's URLForDirectory with NSItemReplacementDirectory.
(allow file-read* file-write-create file-write-data file-write-owner
      (subpath (string-append (param darwin-user-temp-dir) "/TemporaryItems/")))

; Needed by MLModel's compileModelAtURL family of functions.
(allow file-read* file-write-create file-write-unlink
      (subpath (param darwin-user-temp-dir)))

; The browser process copies the compiled model created by the compiler
; process to the webnn_gpu_protected subdirectory which prevents the
; compiler process from accessing the compiled model after it has been copied.
; `file-write-create` and `file-write-unlink` must be listed explicitly because
; Seatbelt prioritizes specific operations from the earlier `allow` rule on
; `darwin-user-temp-dir` over the `file-write*` wildcard in a later `deny` rule.
(deny file-read* file-write* file-write-create file-write-unlink
  (subpath (string-append (param darwin-user-temp-dir) "/webnn_gpu_protected"))
)

(deny file-write-create (vnode-type SYMLINK))

(deny file-write-unlink
  (literal (string-append (param darwin-user-temp-dir) "/webnn_compiler_protected"))
)
