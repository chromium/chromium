LIBRARY  "kernel32.dll"

; Fake import library for kernel32.dll, intended to be scoped to APIs allowed by
; basic_sandbox.def

EXPORTS
  CloseHandle
  GetProcAddress
  GetModuleHandleW
  GetModuleHandleExW
  LoadLibraryW
  GetModuleFileNameW
  GetCommandLineW

  SetLastError

  AcquireSRWLockExclusive
  ReleaseSRWLockExclusive
  SleepConditionVariableSRW
  WakeAllConditionVariable
  InitOnceExecuteOnce

  InitializeCriticalSection
  EnterCriticalSection
  LeaveCriticalSection

  GetCurrentThreadId
  GetCurrentProcessId
  RtlCaptureStackBackTrace
  OutputDebugStringW

  WriteFile

; TODO: Not in basic_sandbox.def, used for logging
  CreateFileW
