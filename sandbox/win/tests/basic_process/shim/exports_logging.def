LIBRARY  "apifw.dll"

; Test-only Windows API-call logging shim.
;
; The Basic Process EchoService fixture rewrites one content_shell.exe copy to
; bind against apifw.dll. Exports are grouped by role:
;
;   = module.Name      forwarded directly, not logged (allowlisted).
;   = Apifw*           thunk in thunks_*.cc: logs and/or modifies, then
;                      forwards (not on the allowlist).
;   = ApifwNotReached  exported but never observed; logs + NOTREACHED().
;
; *** KEEP THIS FILE SORTED AT ALL TIMES ***
; Within each section, entries are sorted case-insensitively by name. Run
; check_import_coverage.py to verify every rewritten import is covered.

EXPORTS

;---------------------------------------------------------------------------
; Forwarded directly to kernel32/ntdll/winmm (= module.Name).
; The PE loader resolves the forward, so these calls are not logged. Every
; name here is on the basic-process allowlist (basic_sandbox.def).
