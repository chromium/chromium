;
; Basic-process API allowlist.
;
; This is the in-repo source of truth for the set of Windows APIs that are
; reachable inside the basic process. It drives two generated/audited outputs
; (see sandbox/win/tests/basic_process/tools/):
;
;   * audit_allowlist_coverage.py verifies at build time that the routing in
;     shim/exports_logging.def agrees with this allowlist: every name that is
;     direct-forwarded there (silently, unlogged) must appear below, and no
;     name below may be routed to the ApifwNotReached crash-sink. The build
;     fails if the two files drift. (The allowlist is a superset: a name may
;     appear below without being exported by apifw.dll if chrome.dll never
;     imports it.)

;
; Error
;
    GetLastError
    SetLastError

;
; Vectored exception handling
;
    AddVectoredContinueHandler
    AddVectoredExceptionHandler
    RemoveVectoredContinueHandler
    RemoveVectoredExceptionHandler
    SetUnhandledExceptionFilter
    UnhandledExceptionFilter

;
; Heap lifecycle
;
    HeapCreate
    HeapDestroy
    GetProcessHeap

;
; Heap allocation
;
    HeapAlloc
    HeapFree
    HeapReAlloc
    HeapSize
    HeapQueryInformation
    HeapSetInformation

;
; Process
;
    GetCurrentProcess
    GetCurrentProcessId
    TerminateProcess
    IsProcessorFeaturePresent
    ExitProcess
    GetCurrentProcessorNumber
    GetCurrentProcessorNumberEx
    GetCurrentThreadStackLimits

;
; String encoding
;
; CodePage must be CP_UTF7 or CP_UTF8, not CP_ACP.
; CP_UTF8 ignores WC_NO_BEST_FIT_CHARS | WC_COMPOSITECHECK | WC_DEFAULTCHAR |
; WC_DISCARDNS | WC_SEPCHARS instead of rejecting them.
    WideCharToMultiByte
; CodePage must be CP_UTF7 or CP_UTF8, not CP_ACP.
; CP_UTF8 ignores MB_COMPOSITE | MB_PRECOMPOSED | MB_USEGLYPHCHARS
; instead of rejecting them.
    MultiByteToWideChar

;
; Thread
;
    GetCurrentThread
    GetCurrentThreadId
    ExitThread
    CreateThread
    CreateRemoteThread
; lpAttributeList may contain only
; PROC_THREAD_ATTRIBUTE_ENABLE_OPTIONAL_XSTATE_FEATURES (AMD64).
    CreateRemoteThreadEx
    TerminateThread
    InitializeProcThreadAttributeList
; For thread creation, Attribute must be
; PROC_THREAD_ATTRIBUTE_ENABLE_OPTIONAL_XSTATE_FEATURES (AMD64).
    UpdateProcThreadAttribute
    DeleteProcThreadAttributeList

;
; SRW locks
;
    InitializeSRWLock
    AcquireSRWLockExclusive
    AcquireSRWLockShared
    ReleaseSRWLockExclusive
    ReleaseSRWLockShared
    TryAcquireSRWLockExclusive
    TryAcquireSRWLockShared

;
; Critical sections
;
    InitializeCriticalSection
    InitializeCriticalSectionAndSpinCount
    DeleteCriticalSection
    EnterCriticalSection
    LeaveCriticalSection
    TryEnterCriticalSection
    SetCriticalSectionSpinCount

;
; Wait / Wake / Sleep
;
    WaitOnAddress
    WakeByAddressAll
    WakeByAddressSingle
    WaitForSingleObject
    WaitForSingleObjectEx
    WaitForMultipleObjects
    WaitForMultipleObjectsEx
    Sleep
    SleepEx

;
; Condition variables
;
    InitializeConditionVariable
    SleepConditionVariableCS
    SleepConditionVariableSRW
    WakeAllConditionVariable
    WakeConditionVariable

;
; Synchronization barriers
;
    InitializeSynchronizationBarrier
    EnterSynchronizationBarrier
    DeleteSynchronizationBarrier

;
; One-time initialization
;
    InitOnceInitialize
    InitOnceExecuteOnce
    InitOnceBeginInitialize
    InitOnceComplete

;
; Events
;
    SetEvent
    ResetEvent

;
; Interlocked SList
;
    InitializeSListHead
    InterlockedFlushSList
    InterlockedPopEntrySList
    InterlockedPushEntrySList
    QueryDepthSList
    InterlockedPushListSList
    InterlockedPushListSListEx

;
; Performance counters
;
    QueryPerformanceCounter
    QueryPerformanceFrequency

;
; Debug
;
    DebugBreak
    OutputDebugStringW

;
; Miscellaneous
;
    RaiseException
; pContextRecord and dwFlags are ignored.
    RaiseFailFastException
    GetStdHandle
    GetTickCount64

;
; XState (AMD64 only)
;
    GetEnabledXStateFeatures
    GetXStateFeaturesMask
    LocateXStateFeature

;
; Virtual memory
;
    VirtualAlloc
    VirtualAllocEx
    VirtualAllocExNuma
    VirtualAlloc2
    VirtualFree
    VirtualFreeEx
    VirtualProtect
    VirtualProtectEx
    VirtualQuery
    VirtualQueryEx
    MapViewOfFile
    MapViewOfFileEx
    MapViewOfFileNuma2
    MapViewOfFile3
    UnmapViewOfFile
    UnmapViewOfFileEx
    UnmapViewOfFile2
    QueryVirtualMemoryInformation

;
; Module
;
    DisableThreadLibraryCalls
    GetModuleHandleExW
    GetProcAddress
; lpLibFileName must name a pre-staged DLL; directory components are ignored.
; dwFlags may contain only DONT_RESOLVE_DLL_REFERENCES |
; LOAD_LIBRARY_REQUIRE_SIGNED_TARGET.
    LoadLibraryExW
; lpLibFileName must name a pre-staged DLL; directory components are ignored.
    LoadLibraryW
    FreeLibrary

;
; I/O
;
    CloseHandle
    ReadFile
    WriteFile
    ReadFileEx
    WriteFileEx
    GetOverlappedResult
    GetOverlappedResultEx
    FlushFileBuffers

;
; System time / tick count
;
    GetSystemTimeAsFileTime
    GetSystemTimePreciseAsFileTime
    GetSystemTime
    SystemTimeToFileTime
    FileTimeToSystemTime
    GetTickCount
    timeGetTime
    timeGetSystemTime

;
; Exception handling
;
    RtlRaiseException
    RtlUnwind
    RtlUnwindEx

;
; Thread-Local Storage (TLS)
;
    TlsAlloc
    TlsFree
    TlsGetValue
    TlsSetValue

;
; Critical section extended init
;
    InitializeCriticalSectionEx

;
; Pointer encoding
;
    EncodePointer
    DecodePointer

;
;   Other
;
    RtlPcToFileHeader
    RtlLookupFunctionEntry
    RtlCaptureContext
    RtlVirtualUnwind

;
;   Startup/Module Info
;

    GetCommandLineW
    GetModuleHandleW
    IsDebuggerPresent
    GetStartupInfoW
    GetModuleFileNameW

;
; Fiber-Local Storage (FLS)
;
    FlsAlloc
    FlsFree
    FlsGetValue
    FlsSetValue

;
; Environment
;
    GetEnvironmentStringsW
    FreeEnvironmentStringsW
; lpName must not name a pseudo-environment variable (e.g. "=C:").
    GetEnvironmentVariableW

;
; Stack trace
;
    RtlCaptureStackBackTrace

;
; Dynamic function tables
;
    RtlAddGrowableFunctionTable
    RtlGrowFunctionTable
    RtlDeleteGrowableFunctionTable
    RtlDeleteFunctionTable
    RtlInstallFunctionTableCallback

;
; Flush
;
    FlushInstructionCache
