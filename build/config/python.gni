import("//build/config/cronet/config.gni")

# Creates a group() that lists Python sources as |data|.
# Having such targets serves two purposes:
# 1) Causes files to be included in runtime_deps, so that they are uploaded to
#    swarming when running tests remotely.
# 2) Causes "gn analyze" to know about all Python inputs so that tests will be
#    re-run when relevant Python files change.
#
# All non-trivial Python scripts should use a "pydeps" file to track their
# sources. To create a .pydep file for a target in //example:
#
#   build/print_python_deps.py \
#       --root example \
#       --output example/$target_name.pydeps \
#       path/to/your/script.py
#
# Keep the .pydep file up-to-date by adding to //PRESUBMIT.py under one of:
#     _ANDROID_SPECIFIC_PYDEPS_FILES, _GENERIC_PYDEPS_FILES
#
# Variables
#   pydeps_file: Path to .pydeps file to read sources from (optional).
#   data: Additional files to include in data. E.g. non-.py files needed by the
#         library, or .py files that are conditionally / lazily imported.
#
# Example
#   python_library("my_library_py") {
#      pydeps_file = "my_library.pydeps"
#      data = [ "foo.dat" ]
#   }
template("python_library") {
  group(target_name) {
    forward_variables_from(invoker,
                           [
                             "data_deps",
                             "deps",
                             "testonly",
                             "visibility",
                           ])

    if (defined(invoker.pydeps_file)) {
      # Read and filter out comments.
      _pydeps_lines = read_file(invoker.pydeps_file, "list lines")
      _pydeps_entries = filter_exclude(_pydeps_lines, [ "#*" ])

      # Dependencies are listed relative to the pydeps file directory, but data
      # parameter expects paths that are relative to the current BUILD.gn
      _script_dir = get_path_info(invoker.pydeps_file, "dir")
      _rebased_pydeps_entries = rebase_path(_pydeps_entries, ".", _script_dir)

      # Even though the .pydep file is not used at runtime, it must be added
      # so that "gn analyze" will mark the target as changed when .py files
      # are removed but none are added or modified.
      data = _rebased_pydeps_entries + [ invoker.pydeps_file ]
    } else {
      data = []
    }
    if (defined(invoker.data)) {
      data += invoker.data
    }
  }
}

# Creates a .pyz archive at "$target_out_dir/$target_name.pyz" in
# $default_toolchain containing precompiled .pyc files for |script| and its
# module dependencies. Evaluated as a no-op in secondary toolchains so callers
# in any toolchain can use python_action().
#
# Variables
#   script: (required) Path to the entry-point .py script.
#   pydeps_file: (optional) Path to .pydeps file. Defaults to "${script}deps"
#       when |inputs| is not set.
#   inputs: (optional) List of .py files to bundle into the archive.
#   deps, public_deps, testonly, visibility: Normal meaning.
#
# Limitations
#   Bundled modules are loaded by a minimal importer that does not support
#   pkgutil.iter_modules() or importlib.resources. inspect.getsource() works
#   only when .py files exist on disk (i.e. not on remote builders).
#
# Example
#   python_binary("my_tool") {
#     script = "my_tool.py"
#   }
template("python_binary") {
  if ((defined(invoker._in_current_toolchain) &&
       invoker._in_current_toolchain) ||
      current_toolchain == default_toolchain) {
    action(target_name) {
      forward_variables_from(invoker,
                             [
                               "deps",
                               "public_deps",
                               "testonly",
                               "visibility",
                             ])
      _output = "$target_out_dir/$target_name.pyz"

      script = "//build/create_pyz.py"
      depfile = "$target_gen_dir/$target_name.d"

      # Read .pydeps directly since python_binary() cannot itself use
      # python_binary() / action_with_pydeps().
      _create_pyz_pydeps =
          filter_exclude(read_file("//build/create_pyz.pydeps", "list lines"),
                         [ "#*" ])
      inputs =
          [ invoker.script ] + rebase_path(_create_pyz_pydeps, ".", "//build")
      outputs = [ _output ]

      args = [
        "--script",
        rebase_path(invoker.script, root_build_dir),
        "--output",
        rebase_path(_output, root_build_dir),
        "--depfile",
        rebase_path(depfile, root_build_dir),
      ]

      _py_inputs = []
      if (defined(invoker.pydeps_file) || !defined(invoker.inputs)) {
        if (defined(invoker.pydeps_file)) {
          _pydeps_file = invoker.pydeps_file
        } else {
          _pydeps_file = "${invoker.script}deps"
        }
        _pydeps_lines = read_file(_pydeps_file, "list lines")
        _pydeps_entries = filter_exclude(_pydeps_lines, [ "#*" ])
        _pydeps_dir = get_path_info(_pydeps_file, "dir")
        _py_inputs += rebase_path(_pydeps_entries, ".", _pydeps_dir)
        inputs += [ _pydeps_file ]
        args += [
          "--pydeps",
          rebase_path(_pydeps_file, root_build_dir),
        ]
      }

      if (defined(invoker.inputs)) {
        _py_inputs += invoker.inputs
        _rebased_inputs = rebase_path(invoker.inputs, root_build_dir)
        args += [ "--inputs=$_rebased_inputs" ]
      }

      inputs += _py_inputs

      if (is_cronet_build) {
        metadata = {
          # Used by Cronet's gn2bp to invoke the underlying .py script directly
          # instead of building a .pyz archive.
          python_binary_script = [ get_path_info(invoker.script, "abspath") ]
          python_binary_inputs = get_path_info(_py_inputs, "abspath")
        }
      }
    }
  } else {
    not_needed([ "target_name" ])
    not_needed(invoker, "*")
  }
}

template("_python_action") {
  target(invoker._action_type, target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "_action_type",
                             "python_binary",
                           ])
    _python_binary = "${invoker.python_binary}($default_toolchain)"
    _pyz_name = get_label_info(_python_binary, "name")
    script =
        get_label_info(_python_binary, "target_out_dir") + "/$_pyz_name.pyz"
    if (!defined(deps)) {
      deps = []
    }
    deps += [ _python_binary ]
  }
}

# An action() that executes a python_binary() .pyz archive built in
# $default_toolchain.
#
# Variables
#   python_binary: (required) Label of the python_binary() target (without
#       toolchain).
#   All other action() variables are forwarded.
template("python_action") {
  _python_action(target_name) {
    forward_variables_from(invoker, TESTONLY_AND_VISIBILITY)
    forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY)
    _action_type = "action"
  }
}

# An action_foreach() that executes a python_binary() .pyz archive built in
# $default_toolchain.
#
# Variables
#   python_binary: (required) Label of the python_binary() target (without
#       toolchain).
#   All other action_foreach() variables are forwarded.
template("python_action_foreach") {
  _python_action(target_name) {
    forward_variables_from(invoker, TESTONLY_AND_VISIBILITY)
    forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY)
    _action_type = "action_foreach"
  }
}

# A template used for one-off actions that execute a Python script with an
# associated .pydeps file, packaging it into a .pyz via python_binary().
# For scripts invoked multiple times (e.g. from a template), define a shared
# python_binary() and use python_action() / python_action_foreach() instead.
#
# - |script| must point to a Python script (e.g. "//build/.../foo.py") that has
#   a corresponding .pydeps file in the source tree (e.g.
#   "//build/.../foo.pydeps").
#
# - The .pydeps file contains a list of python dependencies (imports really)
#   and is generated _manually_ by using a command like:
#
#     build/print_python_deps.py --inplace build/android/gyp/foo.py
#
# Example
#   action_with_pydeps("create_foo") {
#     script = "myscript.py"
#     args = [...]
#   }
template("action_with_pydeps") {
  _main_target_name = target_name
  _pyz_target = "${target_name}__pyz"

  # Build in current_toolchain rather than default_toolchain so callers inside
  # toolchain-conditional blocks (e.g. host_toolchain) still define the target.
  python_binary(_pyz_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":$_main_target_name" ]
    script = invoker.script
    _in_current_toolchain = true
  }

  action(target_name) {
    # Ensure that testonly and visibility are forwarded explicitly so recursive
    # lookups find enclosing-scope definitions. See https://crbug.com/862232
    forward_variables_from(invoker, TESTONLY_AND_VISIBILITY)
    forward_variables_from(invoker, "*", TESTONLY_AND_VISIBILITY + [ "script" ])
    script = "$target_out_dir/$_pyz_target.pyz"
    if (!defined(deps)) {
      deps = []
    }
    deps += [ ":$_pyz_target" ]
  }
}
