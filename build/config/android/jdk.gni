import("//build/toolchain/rbe.gni")

if (host_os == "mac") {
  android_jdk_home = "//third_party/jdk/current/Contents/Home"
} else {
  android_jdk_home = "//third_party/jdk/current"
}

# JDK files that Java actions depend on, relative to the JDK home.
_jdk_files = [
  "bin/java",
  "bin/java.chromium",
  "bin/javac",
  "conf/logging.properties",
  "conf/security/java.security",
  "lib/ct.sym",
  "lib/jrt-fs.jar",
  "lib/jvm.cfg",
  "lib/modules",
  "lib/server/classes.jsa",
  "lib/tzdb.dat",
]
_jdk_libs = [
  "lib/libawt",
  "lib/libjava",
  "lib/libjimage",
  "lib/libjli",
  "lib/libmanagement",
  "lib/libmanagement_ext",
  "lib/libnet",
  "lib/libnio",
  "lib/libverify",
  "lib/libzip",
  "lib/server/libjvm",
]

# Not shipped by the macOS JDK.
_linux_only_jdk_libs = [
  "lib/libawt_headless",
  "lib/libawt_xawt",
  "lib/libjsvml",
]

# The host JDK, plus the Linux JDK that remote Java actions use when the host
# isn't Linux.
_jdks = [
  {
    home = android_jdk_home
    is_linux_jdk = host_os != "mac"
  },
]
if (use_remoteexec && host_os != "linux") {
  _jdks += [
    {
      home = "//third_party/jdk/linux-amd64"
      is_linux_jdk = true
    },
  ]
}

# Actions that use java should add this as inputs so that they are rebuilt
# when the JDK changes, and so that remote execution uploads the JDK.
java_paths_for_inputs = []
foreach(_jdk, _jdks) {
  _libs = []
  _libs = _jdk_libs
  _ext = ".dylib"
  if (_jdk.is_linux_jdk) {
    _libs += _linux_only_jdk_libs
    _ext = ".so"
  }
  foreach(_file, _jdk_files) {
    java_paths_for_inputs += [ "${_jdk.home}/$_file" ]
  }
  foreach(_lib, _libs) {
    java_paths_for_inputs += [ "${_jdk.home}/$_lib$_ext" ]
  }
}

# GraalVM native-images are used in place of .jar files on linux-x64 hosts, and
# by remote actions (which always run on linux-x64, using the Linux JDK).
if (host_os == "linux") {
  _native_image_jdk_home = android_jdk_home
} else {
  _native_image_jdk_home = "//third_party/jdk/linux-amd64"
}

# Actions that can use a GraalVM native-image should always list it (and
# native_image_java_paths_for_inputs) as inputs since remote actions use it, and
# list its .jar and java_paths_for_inputs only when this is false (when local
# actions use the JVM).
use_native_image_inputs = host_os == "linux" && host_cpu == "x64"

# JDK files that native-images read via -Djava.home.
native_image_java_paths_for_inputs = [
  "$_native_image_jdk_home/lib/ct.sym",
  "$_native_image_jdk_home/lib/jrt-fs.jar",
  "$_native_image_jdk_home/lib/modules",
]

javac_paths_for_inputs = native_image_java_paths_for_inputs

# Non-x64 Linux JDKs do not ship javac-graalvm.
if (host_os != "linux" || host_cpu == "x64") {
  javac_paths_for_inputs += [ "$_native_image_jdk_home/bin/javac-graalvm" ]
}
if (!use_native_image_inputs) {
  # Local actions on other hosts run javac on the JVM.
  javac_paths_for_inputs += java_paths_for_inputs
}
