import("//build/config/apple/arch.gni")
import("//build/config/apple/symbols.gni")

# The ldflags referenced below are handled by
# //build/toolchain/apple/linker_driver.py.
# Remove this config if a target wishes to change the arguments passed to the
# strip command during linking. This config by default strips all symbols
# from a binary, but some targets may wish to specify an exports file to
# preserve specific symbols.
config("strip_all") {
  if (enable_stripping) {
    ldflags = [ "-Wcrl,strip,-x,-S" ]
  }
}

# Skip dSYM generation and intermediate LTO object emission for build-time
# executables that never need symbolication, writing empty stub files at the
# toolchain's declared .dSYM output paths instead.
config("no_dsym") {
  if (enable_dsyms) {
    _archs_mapping_os = archs_mapping[current_os]
    _archs_mapping_os_cpu = _archs_mapping_os[current_cpu]
    _dsym_arch = _archs_mapping_os_cpu.dsym_arch
    ldflags = [ "-Wcrl,nodsym,${_dsym_arch}" ]
  }
}
