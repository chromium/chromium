import("//build/config/c++/c++.gni")
import("//build/rust/rust_api_from_cpp.gni")
import("//build/rust/rust_static_library.gni")
import("//build_overrides/crubit.gni")

# Public C++ APIs provided by Crubit.
group("crubit") {
  public_configs = [ ":public_config" ]
  public_deps = [
    "$crubit_src_dir/support:support_cpp",
    "$crubit_src_dir/support/rs_std:rs_std_cpp",
    "//build/rust/std:std_bindings",
  ]
}

config("public_config") {
  visibility = [ ":*" ]

  # `include_dirs` below help ensure that Chromium can use the same
  # `#include` paths as other Crubit clients like google3 - e.g.
  # `#include "third_party/crubit/support/rs_std/slice_ref.h"`.
  include_dirs = [ "${rust_crubit_root}/lib" ]
}

# The `cref` crate provides `CRef<T>` and `CMut<T>` - Rust types that represent
# C++ references returned by functions from `rust_api_from_cpp` bindings.  Rust
# code that needs to name these types (e.g. to call `CRef::unchanging`) should
# depend on this target.
group("cref") {
  public_deps = [ "$crubit_src_dir/support:cref" ]
}

# Dependencies of the `.h` file generated by `cpp_api_from_rust`.
group("cpp_api_from_rust_bindings_cpp_deps") {
  public_configs = [ ":public_config" ]
  public_deps = [ "$crubit_src_dir:cpp_api_from_rust_bindings_cpp_deps" ]
}

# Dependencies of the `.rs` file generated by `cpp_api_from_rust`.
group("cpp_api_from_rust_bindings_rs_deps") {
  public_deps = [ "$crubit_src_dir:cpp_api_from_rust_bindings_rs_deps" ]
}

# Dependencies of the `.cc` file generated by `rust_api_from_cpp`.
group("rust_api_from_cpp_bindings_cpp_deps") {
  public_configs = [ ":public_config" ]
  public_deps = [ "$crubit_src_dir:rust_api_from_cpp_bindings_cpp_deps" ]
}

# Dependencies of the `.rs` file generated by `rust_api_from_cpp`.
group("rust_api_from_cpp_bindings_rs_deps") {
  public_deps = [
    "$crubit_src_dir:rust_api_from_cpp_bindings_rs_deps",

    # The generated `.rs` files also refer to these crates (e.g. to
    # `cxx::ExternType`).  They are not part of Crubit's `support` libraries.
    "//third_party/rust/cxx/v1:lib",
    "//third_party/rust/static_assertions/v1:lib",
  ]
}

# This config is injected via `//build_overrides/crubit.gni`.
#
# The `_allowed_features` list below is based on
# https://github.com/google/crubit/blob/main/docs/overview/unstable_features.md
config("allow_unstable_features_required_by_crubit") {
  _allowed_features = [
    "abi_vectorcall",
    "adt_const_params",
    "allocator_api",
    "allow_internal_unstable",
    "arbitrary_self_types",
    "auto_traits",
    "c_variadic",
    "cfg_accessible",
    "cfg_sanitize",
    "cfi_encoding",
    "custom_inner_attributes",
    "extern_types",
    "impl_trait_in_assoc_type",
    "negative_impls",
    "never_type",
    "proc_macro_hygiene",
    "sized_hierarchy",
    "stmt_expr_attributes",
    "super_let",
    "unsized_const_params",
  ]
  rustflags = [ "-Zallow-features=" + string_join(",", _allowed_features) ]
}

if (enable_rust_api_from_cpp) {
  # `cc_std` below refers to the in-tree libc++ headers (and Crubit's
  # hand-written `cc_std_impl/*.rs` files assume libc++ layout of standard
  # library types).
  assert(use_custom_libcxx,
         "`rust_api_from_cpp` requires `use_custom_libcxx = true`")

  rust_api_from_cpp("cc_std") {
    bindings_target = ":cc_std_empty_target"
    override_crate_name = "cc_std"

    # Other Rust code should depend on `:cpp_std` instead (see below).
    visibility = [ ":*" ]

    # Not a GN label in Chromium - this is the label that Crubit expects for
    # bindings of the C++ standard library.
    override_target_label = "//third_party/crubit/support/cc_std:cc_std"

    # Other C++ standard library types to cover (in dependency order):
    # TODO(crbug.com/40226863): std::shared_ptr.
    # TODO(crbug.com/40226863): std::string_view (+lossy_utf8, slice_ptr).
    # TODO(crbug.com/40226863): std::string (needs std::string_view).
    # TODO(crbug.com/40226863): Other headers from Crubit's `headers.bzl`.
    public_headers = [
      "${libcxx_prefix}/include/memory",
      "${libcxx_prefix}/include/optional",
      "${libcxx_prefix}/include/vector",

      # Helpers used by `allocator.rs` (e.g. `cpp_new` and `cpp_delete`).
      "${crubit_src_dir}/support/cc_std_impl/allocator.h",
    ]

    # Some standard library types (e.g. `std::unique_ptr`) are defined in
    # internal libc++ headers.
    #
    # TODO(crbug.com/40226863): Cover all libc++ headers (e.g. `libcxx_headers`
    # from `//buildtools/third_party/libc++/libcxx_headers.gni`).  This requires
    # first covering all the public headers from Crubit's `headers.bzl`
    # (otherwise the generated C++ code may refer to types like
    # `std::input_iterator_tag` without including their public header).
    internal_headers = [
      "${libcxx_prefix}/include/__memory/unique_ptr.h",
      "${libcxx_prefix}/include/__optional/optional.h",
      "${libcxx_prefix}/include/__vector/vector.h",
    ]

    # Hand-written Rust types (e.g. `cc_std::std::optional<T>`) that
    # Crubit-generated code expects in the `std` module.
    extra_rust_source_groups = [
      {
        sources = [
          "${crubit_src_dir}/support/cc_std_impl/allocator.rs",
          "${crubit_src_dir}/support/cc_std_impl/non_null.rs",
          "${crubit_src_dir}/support/cc_std_impl/optional.rs",
          "${crubit_src_dir}/support/cc_std_impl/unique_ptr.rs",
          "${crubit_src_dir}/support/cc_std_impl/vector.rs",
          "${crubit_src_dir}/support/cc_std_impl/vector_partial_eq.rs",
        ]
        mod = "std"
      },
    ]

    # Chromium's libc++ uses the size-based `std::vector` layout (see
    # `_LIBCPP_ABI_VECTOR_LAYOUT_SIZE_BASED` in libc++'s
    # `__configuration/abi.h`).  `vector.rs` supports this layout only when the
    # `len_capacity_encoding` feature is enabled.
    crate_features = [ "len_capacity_encoding" ]
  }

  source_set("cc_std_empty_target") {
    # Empty target to satisfy `rust_api_from_cpp` which requires
    # mandatory `bindings_target` (C++ standard library is special
    # in that it doesn't need an explicit target).
  }

  # Implicit dependency of all `rust_api_from_cpp` targets (see
  # `//build/rust/rust_api_from_cpp.gni`).  Crubit-generated Rust code refers
  # to C++ standard library types via the `cc_std` crate.
  #
  # This `group` has no `visibility` restrictions, because `rust_api_from_cpp`
  # targets can be defined in any directory.  Instead, it has an icky,
  # internal name to discourage depending on it, and to promote depending on
  # the `:cpp_std` target.
  group("internal_cc_std_for_generated_bindings") {
    # `public_deps` (rather than `deps`) are needed to make `cc_std` an
    # `--extern` crate of the generated bindings.
    public_deps = [ ":cc_std" ]
  }

  # The `cpp_std` crate re-exports the items of `cc_std::std`.  Rust code that
  # needs to name C++ standard library types should depend on this target and
  # use shorter paths (e.g. `cpp_std::vector<T>` instead of
  # `cc_std::std::vector<T>`).
  #
  # `cpp_std` is defined here (rather than in Crubit's generated
  # `$crubit_src_dir/support/BUILD.gn`), because it depends on `:cc_std`
  # which is built by Chromium (via `rust_api_from_cpp("cc_std")` above).
  rust_static_library("cpp_std") {
    crate_name = "cpp_std"
    crate_root = "${crubit_src_dir}/support/cpp_std.rs"
    sources = [ crate_root ]
    deps = [ ":cc_std" ]

    # `cpp_std.rs` comes from Crubit (rather than from Chromium).
    no_chromium_prelude = true
    no_clippy = true
    configs -= crubit_gn_configs_to_remove
    configs += crubit_gn_support_configs_to_add
  }
}
