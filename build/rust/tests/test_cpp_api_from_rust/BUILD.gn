import("//build/rust/rust_static_library.gni")

rust_static_library("other_lib") {
  crate_root = "other.rs"
  sources = [ crate_root ]
  testonly = true
  cpp_api_from_rust = {
    target_name = "other_lib_bindings"
    cpp_namespace = "other_lib"
  }
}

rust_static_library("rust_lib") {
  crate_root = "lib.rs"
  sources = [ crate_root ]
  testonly = true
  cpp_api_from_rust = {
    target_name = "rust_lib_bindings"
    cpp_namespace = "rust_lib"
    deps = [ ":other_lib_bindings" ]
  }
  deps = [ ":other_lib" ]
}

source_set("test_cpp_api_from_rust") {
  sources = [ "unittests.cc" ]
  deps = [
    ":rust_lib_bindings",
    ":target_depending_only_on_bindings",
    "//base",
    "//build/rust/crubit",
    "//testing/gmock",
    "//testing/gtest",
  ]
  testonly = true
}

# Separate target to keep `deps` as small as possible - this target should only
# depend on `:rust_lib_bindings`.  Small `deps` were originally required to
# repro https://crbug.com/546044516
source_set("target_depending_only_on_bindings") {
  sources = [ "target_depending_only_on_bindings.cc" ]
  deps = [ ":rust_lib_bindings" ]
  testonly = true
}
