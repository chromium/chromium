import("//build/config/rust.gni")
import("//build/rust/gni_impl/crubit_shared_args.gni")
import("//build/rust/gni_impl/libclang_args.gni")
import("//build/rust/rust_static_library.gni")
import("//build/toolchain/kythe.gni")
import("//build_overrides/crubit.gni")

# Crubit features enabled for all `rust_api_from_cpp` targets.
# See also: https://github.com/google/crubit/blob/main/features/README.md
_globally_enabled_crubit_features = [
  "supported",

  # `assume_lifetimes` makes Crubit apply Rust's lifetime elision rules to C++
  # references (e.g. `this` becomes `&self`).  This will become the default
  # Crubit behavior "soon", but for now this is an opt-in (to enable
  # incremental migration of other Crubit clients).  For more details see the
  # "References and lifetimes" section in
  # `docs/rust/crubit/rust_api_from_cpp.md`.
  "assume_lifetimes",

  # `layout_compat_optional` makes Crubit represent `std::optional<T>` as
  # layout-compatible `cc_std::std::optional<T>` (rather than bridging it to
  # Rust's `Option<T>`) in by-value positions (e.g. in function parameters).
  # This will become the default Crubit behavior "soon", but for now this is an
  # opt-in (to enable incremental migration of other Crubit clients).
  "layout_compat_optional",

  # `template_instantiation` makes Crubit generate bindings for class template
  # specializations (e.g. `base::IdType64<FooTag>`) used by the C++ headers.
  "template_instantiation",

  # Other features to consider enabling by default:
  # TODO(crbug.com/40226863): Consider enabling `forward_declare`.
  # TODO(crbug.com/40226863): Consider enabling `layout_compat_string`.
  # TODO(crbug.com/40226863): Consider enabling `layout_compat_tuple`.
]

# Template to generate and build Rust bindings for a set of C++ headers using
# Crubit's `rust_api_from_cpp` (aka `rs_bindings_from_cc`) tool.  For
# additional instructions and examples for using this template please see
# `//docs/rust/crubit/rust_api_from_cpp.md`.
#
# This template expands into a `rust_static_library` containing the Rust crate
# that provides Rust APIs wrapping/binding C++ API from `public_headers`.  (It
# also expands to some internal targets - e.g. C++ `source_set` with C++ thunks
# needed to support the bindings.)
#
# The generated `out/.../gen/.../<target>.rs` can be inspected to see:
# * The shape of the generated bindings (i.e. the Rust APIs that correspond to
#   or wrap the C++ APIs from `public_headers`)
# * The comments that describe errors that may have prevented generating
#   additional bindings
#
# Parameters:
#
#   bindings_target:
#     The C++ target (e.g. a `source_set`) that Rust bindings should be
#     generated for.
#
#     `public_configs` of `bindings_target` (e.g. providing `-D` or `-I` flags)
#     are used when parsing `public_headers` and when compiling the generated
#     C++ thunks.
#
#   public_headers:
#     A list of .h files to generate bindings for.
#
#     Implementation note: This doesn't just take *all* the headers of the
#     `bindings_target`, because typically only a *subset* of headers provides
#     the *public* API that bindings are needed for.
#
#   bindings_deps: (optional)
#     Other `rust_api_from_cpp` targets that the bindings need to depend on.
#
#     `//docs/rust/crubit/rust_api_from_cpp.md` contains more info and
#     examples, but basically, if public APIs from `public_headers` depend on
#     types from other targets, then `bindings_deps` should list the
#     `rust_api_from_cpp` targets that generate bindings for types from these
#     other targets.
#
#     This may also list `cpp_api_from_rust` targets (i.e. C++ bindings of Rust
#     crates; see the `cpp_api_from_rust` parameter of `rust_static_library`).
#     This way, Rust types used in `public_headers` are exposed to Rust as the
#     original Rust types.
#
#   extra_rust_sources: (optional)
#     A list of hand-written `.rs` files to merge into the generated bindings
#     crate.  This can be used to implement traits for the types from the
#     generated bindings (e.g. `impl TryFrom<CppType> for std::time::Duration`).
#     Such trait impls can't be defined in other crates because of Rust's
#     orphan rule (see
#     https://doc.rust-lang.org/reference/items/implementations.html#r-items.impl.trait.orphan-rule).
#
#     Each file becomes a private module at the root of the crate, and all its
#     items are re-exported (via `pub use`) into the root of the crate.
#
#     See `//docs/rust/crubit/rust_api_from_cpp.md` for more info and examples.
#
#   extra_rust_source_groups: (optional)
#     Like `extra_rust_sources`, but places the files into nested modules of
#     the generated bindings crate (both attributes can be used together).
#     A list of scopes (i.e. "GN dictionaries"), where each scope has the
#     following attributes:
#       * `sources`: a list of `.rs` files (same semantics as
#         `extra_rust_sources`, except that the files are placed into `mod`).
#       * `mod`: a Rust module path (e.g. `"foo::bar"` for the C++ namespace
#         `foo::bar`).  The files are placed into this module of the generated
#         bindings (the module has to exist there).  Use `extra_rust_sources`
#         to place files at the root of the crate.
#
#     This should be needed only rarely (e.g. when hand-written sources need
#     to provide items that Crubit-generated code expects at a specific module
#     path).
#
#   override_target_label, override_crate_name: (optional)
#     Internal parameters, used only by `//build/rust/crubit:cc_std` (bindings
#     for the C++ standard library) to provide the target label and crate name
#     that Crubit expects for `cc_std`.
#
#   internal_headers: (optional)
#     Internal parameter, used only by `//build/rust/crubit:cc_std`.  A list of
#     internal .h files of the target (e.g. `__memory/unique_ptr.h` from
#     libc++).  Unlike `public_headers`, these headers are not `#include`d
#     directly by the generated code.  But Crubit needs to know that C++
#     declarations from these headers (e.g. `std::unique_ptr`) belong to this
#     target.
#
#   crate_features: (optional)
#     Internal parameter, used only by `//build/rust/crubit:cc_std`.  A list of
#     Cargo-style features (i.e. `--cfg feature="..."`) for compiling the
#     generated bindings crate.  Crubit-generated code doesn't check any
#     features, so this is only useful for hand-written Rust sources (e.g.
#     `len_capacity_encoding` for `vector.rs`).
template("rust_api_from_cpp") {
  assert(enable_rust_api_from_cpp)
  assert(enable_rust)
  assert(rust_crubit_root != "", rust_crubit_root_missing_message)

  # PDFium, V8 and other "2nd-party" Chromium projects don't yet have their own
  # `//build_overrides/crubit.gni` build file.  Until this is fixed, we assert
  # that `rust_api_from_cpp` template can only be used in Chromium builds.
  assert(build_with_chromium)

  # Mandatory parameter: bindings_target.
  assert(defined(invoker.bindings_target),
         "Must specify the C/C++ target to make bindings for.")
  _bindings_target = invoker.bindings_target

  # Mandatory/unavoidable parameter: target_name
  _lib_target_name = target_name
  if (defined(invoker.override_target_label)) {
    _current_lib_target_full_label = invoker.override_target_label
  } else {
    _current_lib_target_full_label =
        get_label_info(":${_lib_target_name}", "label_no_toolchain")
  }
  _cc_impl_target_name = "${_lib_target_name}_cc_impl"

  # Mandatory parameter: public_headers.
  assert(defined(invoker.public_headers),
         "Must specify the public C/C++ headers to make bindings for.")
  _rebased_public_headers = []
  foreach(hdr, invoker.public_headers) {
    _rebased_public_headers += [ rebase_path(hdr, root_build_dir) ]
  }

  _rebased_target_headers = _rebased_public_headers
  if (defined(invoker.internal_headers)) {
    _rebased_target_headers +=
        rebase_path(invoker.internal_headers, root_build_dir)
  }

  # Optional parameter: testonly.
  _testonly = false
  if (defined(invoker.testonly)) {
    _testonly = invoker.testonly
  }

  # Optional parameter: visibility.
  if (defined(invoker.visibility)) {
    _visibility = invoker.visibility
  }

  # Optional parameter: bindings_deps.
  #
  # TODO(crbug.com/40226863): Can we somehow assert that `_bindings_deps` only
  # contains targets created via `rust_api_from_cpp`?
  _bindings_deps = []
  if (defined(invoker.bindings_deps)) {
    _bindings_deps = invoker.bindings_deps
  }

  # Bindings of the C++ standard library are an implicit dependency of all
  # other `rust_api_from_cpp` targets (similarly to how `cpp_api_from_rust`
  # injects `//build/rust/std:std_bindings`).
  #
  # `visibility` of the `cc_std` target is restricted (to make other Rust code
  # use `cpp_std` instead), and therefore the generated Rust library depends
  # on `cc_std` via `internal_cc_std_for_generated_bindings`.
  _cc_std_target = "//build/rust/crubit:cc_std"
  _bindings_rs_deps = _bindings_deps
  if (get_label_info(":${_lib_target_name}", "label_no_toolchain") !=
      _cc_std_target) {
    _bindings_deps += [ _cc_std_target ]
    _bindings_rs_deps +=
        [ "//build/rust/crubit:internal_cc_std_for_generated_bindings" ]
  }

  # Optional parameters: extra_rust_sources and extra_rust_source_groups.
  #
  # Crubit emits each `--extra_rs_srcs` path into a `#[path = ...]` attribute
  # in the generated `.rs` file.  Such paths are resolved [1] by `rustc`
  # relative to the directory of the generated `.rs` file - extended with
  # subdirectories that correspond to the nested module (e.g. `foo/bar/` for
  # `--extra_rs_srcs=path=foo::bar`).
  #
  # Sources placed at the root of the crate are used in place (their paths are
  # rebased onto `target_gen_dir`).  When placing sources into a nested module,
  # rebasing onto a `foo/bar/` subdirectory wouldn't work (because the
  # subdirectory doesn't exist), and therefore a `copy` action puts such
  # sources into the subdirectory.
  #
  # [1] https://doc.rust-lang.org/reference/items/modules.html#the-path-attribute:~:text=the%20file%20path%20is%20relative%20to%20the%20directory%20the%20source%20file%20is%20located
  _extra_rust_sources = []  # Files (or their copies) to compile.
  _extra_rs_srcs_flag_values = []  # Entries of `--extra_rs_srcs`.
  if (defined(invoker.extra_rust_sources)) {
    _extra_rust_sources += invoker.extra_rust_sources
    _extra_rs_srcs_flag_values +=
        rebase_path(invoker.extra_rust_sources, target_gen_dir)
  }

  _extra_rust_source_groups = []
  if (defined(invoker.extra_rust_source_groups)) {
    _extra_rust_source_groups = invoker.extra_rust_source_groups
  }
  _extra_rs_srcs_copy_targets = []
  _extra_rs_srcs_remap_flags = []
  foreach(_group, _extra_rust_source_groups) {
    # Catch typos (e.g. `mods = ...`) that would otherwise be silently ignored.
    _unexpected = {
      forward_variables_from(_group,
                             "*",
                             [
                               "mod",
                               "sources",
                             ])
    }
    assert(_unexpected == {
               },
           "Unexpected `extra_rust_source_groups` attributes: ${_unexpected}")
    assert(defined(_group.sources) && defined(_group.mod),
           "Each `extra_rust_source_groups` entry needs `sources` and `mod`")
    _mod = _group.mod
    assert(_mod != "",
           "Use `extra_rust_sources` to place sources at the crate root")
    _mod_dir = "${target_gen_dir}/" + string_replace(_mod, "::", "/")
    _copy_dir = "${_mod_dir}/${_lib_target_name}"

    # Note that this requires at most one group per `mod` (otherwise GN
    # reports a duplicate target).
    _copy_target_name = "${_lib_target_name}_extra_rust_sources_" +
                        string_replace(_mod, "::", "_")

    copy(_copy_target_name) {
      testonly = _testonly
      visibility = [ ":${_lib_target_name}" ]
      sources = _group.sources
      outputs = [ "${_copy_dir}/" +
                  "{{source_root_relative_dir}}/{{source_file_part}}" ]
    }

    foreach(_src, get_target_outputs(":${_copy_target_name}")) {
      _extra_rust_sources += [ _src ]
      _extra_rs_srcs_flag_values += [ rebase_path(_src, _mod_dir) + "=${_mod}" ]
    }
    _extra_rs_srcs_copy_targets += [ ":${_copy_target_name}" ]

    # Make compiler diagnostics point at the original sources (rather than at
    # their copies).
    _extra_rs_srcs_remap_flags +=
        [ "--remap-path-prefix=" + rebase_path(_copy_dir, root_build_dir) +
          "=" + rebase_path("//", root_build_dir) ]
  }

  # Various names and paths that are shared across multiple targets defined
  # in the template here.
  _gen_bindings_target_name = "${_lib_target_name}_gen_bindings"
  _gen_metadata_target_name = "${_lib_target_name}_gen_metadata"
  _metadata_target_name = "${_lib_target_name}_crubit_metadata"
  _metadata_path = "${target_gen_dir}/${_lib_target_name}_meta.json"
  _flagfile_path = "${target_out_dir}/${_gen_bindings_target_name}.flagfile"
  _rs_out_path = "${target_gen_dir}/${_lib_target_name}.rs"
  _cc_out_path = "${target_gen_dir}/${_lib_target_name}_impl.cc"

  # Crubit needs to know the crate name of the generated bindings (and of their
  # `_bindings_deps`) to refer to them from the generated code - see `c` below.
  #
  # NOTE: TargetName=>CrateName mangling algorithm should be kept in sync with
  # `rust_target.gni` (see the NOTE there; `chromium::import!` relies on it).
  if (defined(invoker.override_crate_name)) {
    _lib_target_crate_name = invoker.override_crate_name
  } else {
    _dir_hash = string_hash(get_label_info(":${_lib_target_name}", "dir"))
    _lib_target_crate_name = "${_lib_target_name}_${_dir_hash}"
  }

  # Metadata targets (see `_metadata_target_name` below) of `_bindings_deps`.
  _bindings_deps_metadata_targets = []
  foreach(_dep, _bindings_deps) {
    _dep_dir = get_label_info(_dep, "dir")
    _dep_name = get_label_info(_dep, "name")
    _dep_toolchain = get_label_info(_dep, "toolchain")
    _bindings_deps_metadata_targets +=
        [ "${_dep_dir}:${_dep_name}_crubit_metadata(${_dep_toolchain})" ]
  }

  # Calculating the `--target_args` snippet for the *current* target
  # and putting it into GN's `metadata`.
  #
  # This is a pure metadata target: it only depends on the metadata targets of
  # `_bindings_deps` (and not on any actions or libraries).  This way, when
  # generating bindings that depend on this target, `rs_bindings_from_cc`
  # doesn't wait for the bindings of this target to be generated and compiled.
  group(_metadata_target_name) {
    testonly = _testonly
    deps = _bindings_deps_metadata_targets

    metadata = {
      # The data below corresponds to a single-target entry inside
      # `--target_args` cmdline argument of `rs_bindings_from_cc`.  The field
      # names (`t` = target, `h` = headers, `f` = features, `c` = crate name)
      # are defined by Crubit - see `--target_args` in
      # https://github.com/google/crubit/blob/main/rs_bindings_from_cc/cmdline.cc
      crubit_target_and_args = [
        {
          t = _current_lib_target_full_label
          h = _rebased_target_headers
          f = _globally_enabled_crubit_features
          c = _lib_target_crate_name
        },
      ]

      # The data below is consumed by `cpp_api_from_rust` when this target is
      # listed in `cpp_api_from_rust.bindings_deps` (of a Rust library that
      # uses C++ types from this target in its public APIs).  This lets C++
      # bindings of such Rust APIs refer to the original C++ types (and
      # `#include` the original C++ headers).
      crate_header = []
      foreach(_hdr, invoker.public_headers) {
        crate_header += [ "--crate-header=${_lib_target_crate_name}=" +
                          rebase_path(_hdr, "//") ]
      }
    }
  }

  # Gathering `--target_args` data from *all* transitive dependencies and
  # putting them into the file at `_metadata_path`.
  #
  # The metadata walk only visits the metadata targets (and therefore doesn't
  # care about all the `deps` or `public_deps` of the `_bindings_target`; see
  # also the doc comment about `rust_api_from_cpp.bindings_deps` attribute at
  # the top of this file).
  generated_file(_gen_metadata_target_name) {
    testonly = _testonly
    visibility = [ ":${_gen_bindings_target_name}" ]

    deps = [ ":${_metadata_target_name}" ]

    outputs = [ _metadata_path ]
    output_conversion = "json"
    data_keys = [ "crubit_target_and_args" ]
  }

  source_set(_cc_impl_target_name) {
    testonly = _testonly
    visibility = [ ":${_lib_target_name}" ]

    sources = [ _cc_out_path ]
    deps = [
      ":${_gen_bindings_target_name}",
      "//build/rust/crubit:rust_api_from_cpp_bindings_cpp_deps",
      _bindings_target,
    ]

    # Chromium already covers `chromium/src/` and `out/Release/gen` in the
    # include path, but we need to explicitly add `out/Release` below.  This
    # is needed, because `--public_headers` passed to Crubit use paths relative
    # to the `out/Release` directory.  See also b/239238801.
    include_dirs = [ root_build_dir ]

    configs -= crubit_gn_configs_to_remove
    configs += crubit_gn_support_configs_to_add
  }

  # Exposing the generated Rust bindings.
  rust_static_library(_lib_target_name) {
    testonly = _testonly
    if (defined(_visibility)) {
      visibility = _visibility
    }

    deps = _bindings_rs_deps
    deps += [
      ":${_cc_impl_target_name}",
      ":${_gen_bindings_target_name}",
      "//build/rust/crubit:rust_api_from_cpp_bindings_rs_deps",
    ]

    # Explicitly setting `crate_name` guarantees that it matches the name passed
    # to Crubit (via `c` in the metadata above).
    crate_name = _lib_target_crate_name
    crate_root = _rs_out_path
    sources = [ crate_root ] + _extra_rust_sources
    deps += _extra_rs_srcs_copy_targets
    rustflags = _extra_rs_srcs_remap_flags

    if (defined(invoker.crate_features)) {
      features = invoker.crate_features
    }

    # Crubit-generated crates are Chromium-agnostic, so they shouldn't use
    # Chromium-specific dependencies nor lints.
    no_allocator_crate = true
    no_chromium_prelude = true
    no_clippy = true

    # Allow `unsafe` for FFI.
    allow_unsafe = true

    # Crubit-generated bindings are not Chromium code, and they rely on some
    # unstable features.
    configs -= crubit_gn_configs_to_remove
    configs += crubit_gn_support_configs_to_add
  }

  # Invoking Crubit's `rs_bindings_from_cc` tool to generate Rust bindings.
  action(_gen_bindings_target_name) {
    testonly = _testonly
    visibility = [
      ":${_cc_impl_target_name}",
      ":${_lib_target_name}",
    ]

    script = "//build/rust/gni_impl/rust_api_from_cpp_wrapper.py"
    inputs = [
      "//build/rust/gni_impl/filter_clang_args.py",
      _metadata_path,
      rust_api_from_cpp_exe_path,
    ]

    # Public headers are inputs to this action rather than sources,
    # so GN does not consider this target an owner of the headers.
    # Headers that are only included indirectly are covered by `depfile`.
    inputs += invoker.public_headers
    outputs = [
      _rs_out_path,
      _cc_out_path,

      # Written by `rust_api_from_cpp_wrapper.py` (see `--flagfile-path`).
      _flagfile_path,
    ]
    depfile = "${target_out_dir}/${_gen_bindings_target_name}.d"

    # Depending on `_bindings_target` provides its `public_configs` (e.g.
    # `{{defines}}` and `{{include_dirs}}` needed to parse `public_headers`) and
    # ensures that headers generated by its dependencies exist.
    deps = [
      ":${_gen_metadata_target_name}",
      _bindings_target,
    ]
    args = [
      # `rust_api_from_cpp_wrapper.py` flags:
      "--rust-api-from-cpp-exe-path",
      rebase_path(rust_api_from_cpp_exe_path, root_build_dir),
      "--flagfile-path",
      rebase_path(_flagfile_path, root_build_dir),
      "--target-args-path",
      rebase_path(_metadata_path, root_build_dir),

      # This `--` is consumed by `argparse` in the wrapper script.  The second
      # `--` (further below) separates `rs_bindings_from_cc` flags from Clang
      # args.
      "--",

      # `rs_bindings_from_cc` flags (written into the flagfile):
      "--rs_out=" + rebase_path(_rs_out_path, root_build_dir),
      "--cc_out=" + rebase_path(_cc_out_path, root_build_dir),
      "--public_headers=" + string_join(",", _rebased_public_headers),
      "--target=${_current_lib_target_full_label}",
      "--crubit_support_path_format=${crubit_support_path_format}",
    ]
    if (defined(rustfmt_exe_path)) {
      inputs += [
        rustfmt_exe_path,
        rustfmt_config_path,
      ]
      args += [
        "--rustfmt_exe_path=" + rebase_path(rustfmt_exe_path, root_build_dir),
        "--rustfmt_config_path=" +
            rebase_path(rustfmt_config_path, root_build_dir),
      ]
    }

    if (_extra_rs_srcs_flag_values != []) {
      args +=
          [ "--extra_rs_srcs=" + string_join(",", _extra_rs_srcs_flag_values) ]
    }

    # TODO(https://crbug.com/40226863): Use
    # `rust_enable_generated_code_formatting` (see https://crrev.com/c/8494684)
    # to decide whether to format the impl/thunks-containing C++ files (i.e.
    # whether to pass `clang_format_exe_path` below).
    if (defined(clang_format_exe_path)) {
      inputs += [ clang_format_exe_path ]
      args += [ "--clang_format_exe_path=" +
                rebase_path(clang_format_exe_path, root_build_dir) ]
    }

    if (enable_kythe_annotations) {
      args += [
        "--kythe_annotations",
        "--kythe_default_corpus=${kythe_corpus}",
      ]
    }

    # Several important compiler flags come from default_compiler_configs
    # (and those may not be inherited via `public_configs` of `bindings_target`)
    configs = default_compiler_configs
    args += [ "--" ] + libclang_args_for_cpp

    # TODO(crbug.com/40226863): Remove after rolling Crubit to a version that
    # supports the `type_visibility` attribute that libc++ uses on
    # `namespace std` (without this, Crubit can't generate bindings for any
    # items in `namespace std` - e.g. for `std::optional`).  See the WIP PR at
    # https://github.com/google/crubit/pull/2361
    args += [ "-D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS" ]

    # Clang args that write the `depfile`.  `-MT` sets the target inside the
    # depfile to the first output of the action (as expected by Ninja and
    # Siso).
    args += [
      "${clang_flag_prefix}-MD",
      "${clang_flag_prefix}-MF" + rebase_path(depfile, root_build_dir),
      "${clang_flag_prefix}-MT" + rebase_path(_rs_out_path, root_build_dir),
    ]
  }
}
