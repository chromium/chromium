import("//build/config/rust.gni")
import("//build/rust/gni_impl/rustc_print_cfg.gni")

# This `action` is meant to be run *once* per build and generates the response
# file used by the `allow_all_warnings_config` below.  The response file is
# generated (rather than maintained by hand), because otherwise it would be
# difficult to notice that a `rustc` roll has introduced new lints.
action("gen_allow_all_warnings_rsp") {
  visibility = [ ":*" ]

  script = "gen_allow_all_warnings_rsp.py"
  outputs = [ "$target_gen_dir/allow_all_warnings.rsp" ]
  args = [
    "--rust-prefix",
    rebase_path("${rust_sysroot}/bin", root_build_dir),
    "--output-path",
    rebase_path(outputs[0], root_build_dir),
  ]
  inputs = [ "rustc_print_cfg.py" ]  # Imported by the `script` above.
  if (host_os == "win") {
    inputs += [ "${rust_sysroot}/bin/rustc.exe" ]
  } else {
    inputs += [ "${rust_sysroot}/bin/rustc" ]
  }
}

# Implementation detail of the `allow_all_warnings` group below (targets should
# depend on the group, so that the response file below also gets generated).
config("allow_all_warnings_config") {
  visibility = [ ":*" ]

  rustflags = [ "-Awarnings" ]

  # Ideally we would just use `-Awarnings` or `--cap-lints=allow`, but this
  # interacts in undesirable ways with other requirements - see
  # https://github.com/rust-lang/rust/issues/143108 for more context.
  # So, to work around that, we explicitly allow individual warnings
  # (because `-Amore-specific-warning` will win over
  # the less specific `#![deny(warnings)]`).
  #
  # TODO(https://crbug.com/428207407): Stop suppressing individual warnings
  # once a single flag can reliably suppress all warnings.
  _rsp_paths = get_target_outputs(":gen_allow_all_warnings_rsp")
  _rsp_path = _rsp_paths[0]
  rustflags += [ "@" + rebase_path(_rsp_path, root_build_dir) ]
  inputs = [ _rsp_path ]
}

# The `allow_all_warnings` is meant to be used for suppressing warnings in
# third-party crates coming from crates.io (ones under `//third_party/rust`).
# Note that Chromium still wants to deny most warnings in some notionally
# "third-party" code like `//third_party/skia` or `//third_party/crabbyavif`.
#
# Targets `deps`-ing on this group inherit `allow_all_warnings_config` (and
# also get the response file that the config points at).
group("allow_all_warnings") {
  public_configs = [ ":allow_all_warnings_config" ]

  # `public_deps` (rather than `deps`), because the response file generated by
  # the action is an `inputs` entry of the targets that depend on this group.
  public_deps = [ ":gen_allow_all_warnings_rsp" ]
}

# This `action` is meant to be run *once* per build and stashes the output
# of `rustc --print=cfg --target=$rust_abi_target` into `rustc_print_cfg_path`.
#
# Scripts that need to be aware of Rust configuration (e.g. is `target_family =
# "unix"` set) should 1) depend on this target, and 2) use
# `rustc_print_cfg_path` as one of their `inputs` (after `import`-ing that
# variable from `//build/rust/gni_impl/rustc_print_cfg.gni`).
action("rustc_print_cfg") {
  script = "rustc_print_cfg.py"
  args = [
    "--rust-prefix",
    rebase_path("${rust_sysroot}/bin", root_build_dir),
    "--target",
    rust_abi_target,
    "--output-path",
    rebase_path(rustc_print_cfg_path, root_build_dir),
  ]
  inputs = []
  if (host_os == "win") {
    inputs += [ "${rust_sysroot}/bin/rustc.exe" ]
  } else {
    inputs += [ "${rust_sysroot}/bin/rustc" ]
  }
  outputs = [ rustc_print_cfg_path ]
}
