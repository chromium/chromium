import("//build/config/rust.gni")
import("//build/rust/gni_impl/crubit_shared_args.gni")
import("//build/toolchain/kythe.gni")

# Crubit features enabled for all `cpp_api_from_rust` targets.
# See also: https://github.com/google/crubit/blob/main/features/README.md
_globally_enabled_crubit_features = [
  # TODO(b/558605603): Remove this feature from the list once it becomes the
  # default in Crubit.
  "always_specialize_generics_in_cpp_api_from_rust",
]

# Defines a C++ `source_set` (and supporting targets) that contains C++
# bindings for using/calling-into a given Rust crate.
#
# `cpp_api_from_rust.gni` should only be `import`ed from
# `gni_impl/rust_target.gni`.  The public way to use these bindings is the
# `cpp_api_from_rust` parameter of `rust_static_library` and/or `cargo_crate`
# templates.
#
# Parameters
#
#   rust_target
#     Label of the Rust library to generate the bindings for.
#
#   use_rmeta_interface (optional, default = false)
#     When `false`, Crubit compiles the crate from its sources, using the same
#     arguments as `rustc` (see `rustc_env_and_flags` and `sources`).
#
#     When `true`, Crubit reads the crate metadata from an `.rmeta` file
#     instead.  Currently this mode only supports crates that `rustc` can find
#     on its own (e.g. crates from a prebuilt Rust standard library in the
#     sysroot).
#
#     TODO(https://crbug.com/549864599,
#     https://gn.issues.chromium.org/490160737): Use this mode also for crates
#     built by GN, once we can get paths to rmeta files in GN.
#
#   rustc_env_and_flags (required if `use_rmeta_interface` is `false`)
#     Path to the `.rustflags.json` file generated by an earlier invocation
#     of `rustc`.  (`cpp_api_from_rust` needs to be invoked with the same
#     arguments, target platform, etc. as `rust_target`.)
#
#   crate_name
#     Name (potentially mangled/auto-generated) of the crate that `rust_target`
#     is built into.
#
#   h_out
#     Path where the generated `.h` file should be written.
#
#   original_attributes
#     The original `cc_bindings_from_rs = { ... }` dictionary (the value of
#     the `cc_bindings_from_rs` attribute of a target like
#     `rust_static_library`).
#
#   sources
#   deps
#     When `use_rmeta_interface` is `false`: dependencies for compiling
#     `rust_target`.
#
#     When `use_rmeta_interface` is `true`: files that change together with
#     the `.rmeta` files read by Crubit (and the targets that generate these
#     files).  This makes sure that the bindings are re-generated when the
#     `.rmeta` files change (e.g. when the Rust toolchain changes).
#
#
template("cpp_api_from_rust") {
  assert(enable_rust)
  assert(rust_crubit_root != "", rust_crubit_root_missing_message)

  # PDFium, V8 and other "2nd-party" Chromium projects don't yet have their own
  # `//build_overrides/crubit.gni` build file.  Until this is fixed, we assert
  # that `cpp_api_from_rust` template can only be used in Chromium builds.
  assert(build_with_chromium)

  _rspgen_target_name = "${target_name}_crubit_rspgen"
  _action_target_name = "${target_name}_crubit_action"
  _rust_impl_target_name = "${target_name}_crubit_impl"
  _h_target_name = target_name
  _metadata_target_name = "${target_name}_crubit_metadata"

  _use_rmeta_interface =
      defined(invoker.use_rmeta_interface) && invoker.use_rmeta_interface
  if (!_use_rmeta_interface) {
    assert(defined(invoker.rustc_env_and_flags))
  }
  assert(defined(invoker.deps))
  assert(defined(invoker.sources))
  assert(defined(invoker.rust_target))
  assert(defined(invoker.original_attributes))
  assert(defined(invoker.crate_name))
  assert(defined(invoker.h_out))
  _crate_name = invoker.crate_name
  _rust_target = invoker.rust_target
  _rust_target_dir = get_label_info(_rust_target, "dir")
  _h_out = invoker.h_out
  _rs_out = "${_h_out}.impl.rs"

  _original_attributes = invoker.original_attributes
  assert(defined(_original_attributes.cpp_namespace))
  _cpp_namespace = _original_attributes.cpp_namespace

  if (!defined(_original_attributes.deps)) {
    _original_attributes.deps = []
  }
  _is_rust_stdlib_target = _rust_target_dir == "//build/rust/std/rules" ||
                           _rust_target_dir == "//build/rust/std"
  if (!_is_rust_stdlib_target) {
    _original_attributes.deps += [ "//build/rust/std:std_bindings" ]
  }

  _action_rsp_path = "$target_out_dir/$_action_target_name.rsp"

  # A pure metadata target with no dependencies or actions. This allows
  # `_rspgen_target_name` to collect header and namespace information at
  # `gn gen` time without introducing Ninja-level build-time serialization
  # on upstream Crubit header generation actions.
  group(_metadata_target_name) {
    forward_variables_from(invoker, [ "testonly" ])
    _gen_dir_relative_h_out = rebase_path(_h_out, root_gen_dir)
    _crate_feature = []
    foreach(_feature, _globally_enabled_crubit_features) {
      _crate_feature += [ "--crate-feature=${_crate_name}=${_feature}" ]
    }
    metadata = {
      crate_feature = _crate_feature
      crate_header =
          [ "--crate-header=${_crate_name}=${_gen_dir_relative_h_out}" ]
      crate_namespace = [ "--crate-namespace=${_crate_name}=${_cpp_namespace}" ]
    }
  }

  # Metadata targets (see `_metadata_target_name` above) of the dependencies.
  _rspgen_deps = []
  foreach(_dep, _original_attributes.deps) {
    _dep_dir = get_label_info(_dep, "dir")
    _dep_name = get_label_info(_dep, "name")
    _dep_toolchain = get_label_info(_dep, "toolchain")
    _rspgen_deps +=
        [ "${_dep_dir}:${_dep_name}_crubit_metadata(${_dep_toolchain})" ]
  }

  generated_file(_rspgen_target_name) {
    forward_variables_from(invoker, [ "testonly" ])
    deps = _rspgen_deps
    outputs = [ _action_rsp_path ]
    data_keys = [
      "crate_feature",
      "crate_header",
      "crate_namespace",
    ]
    walk_keys = []  # Only metadata of direct, non-transitive `deps`.
    visibility = [ ":${_action_target_name}" ]
  }

  action(_action_target_name) {
    forward_variables_from(invoker,
                           [
                             "sources",
                             "deps",
                             "testonly",
                           ])
    deps += [ ":${_rspgen_target_name}" ]

    visibility = [
      ":$_h_target_name",
      ":$_rust_impl_target_name",
    ]

    script = "//build/rust/gni_impl/cpp_api_from_rust_wrapper.py"
    inputs = rustc_wrapper_inputs
    inputs += [
      _action_rsp_path,
      cpp_api_from_rust_exe_path,
    ]
    outputs = [
      _h_out,
      _rs_out,
    ]

    # `cpp_api_from_rust_wrapper.py` flags:
    args = [
      "--cpp-api-from-rust-exe-path",
      rebase_path(cpp_api_from_rust_exe_path, root_build_dir),
    ]
    if (!_use_rmeta_interface) {
      args += [
        "--rustc-env-and-flags",
        rebase_path(invoker.rustc_env_and_flags, root_build_dir),
      ]

      # With a prebuilt stdlib, `rustc` uses its default sysroot (and
      # therefore `rustc_env_and_flags` don't contain `--sysroot`).  The
      # default sysroot of Crubit may be different (e.g. when `rust_crubit_root`
      # and `rust_sysroot` point to different directories), so it has to be
      # passed explicitly.
      if (rust_prebuilt_stdlib) {
        args += [ "--extra-rustc-flag=--sysroot=" +
                  rebase_path(rust_sysroot, root_build_dir) ]
      }
    }
    args += [ "@" + rebase_path(_action_rsp_path, root_build_dir) ]

    # `cpp_api_from_rust` flags:
    args += [ "--" ]
    if (_use_rmeta_interface) {
      args += [
        "--enable-rmeta-interface=true",
        "--source-crate-name",
        _crate_name,
        "--sysroot",
        rebase_path(rust_sysroot, root_build_dir),
        "--target",
        rust_abi_target,
      ]
    } else {
      args += [
        # TODO(https://crbug.com/549864599,
        # https://gn.issues.chromium.org/490160737): Enable this interface once
        # we can get paths to rmeta files in GN.
        "--enable-rmeta-interface=false",
      ]
    }
    args += [
      "--h-out",
      rebase_path(_h_out, root_build_dir),

      "--rs-out",
      rebase_path(_rs_out, root_build_dir),

      # TODO(https://crbug.com/539569491): Remove this flag once/when it no
      # longer works.  (Crubit will remove this flag once its clients no longer
      # depend on the old behavior.)
      "--portable-abi-compatible",

      "--crubit-support-path-format",
      crubit_support_path_format,
    ]
    if (defined(rustfmt_exe_path)) {
      inputs += [
        rustfmt_exe_path,
        rustfmt_config_path,
      ]
      args += [
        "--rustfmt-exe-path",
        rebase_path(rustfmt_exe_path, root_build_dir),

        "--rustfmt-config-path",
        rebase_path(rustfmt_config_path, root_build_dir),
      ]
    }
    args += [
      "--crate-namespace",
      "self=${_cpp_namespace}",
    ]
    foreach(_feature, _globally_enabled_crubit_features) {
      args += [
        "--crate-feature",
        "self=${_feature}",
      ]
    }
    if (defined(clang_format_exe_path)) {
      inputs += [ clang_format_exe_path ]
      args += [
        "--clang-format-exe-path",
        rebase_path(clang_format_exe_path, root_build_dir),
      ]
    }
    if (enable_kythe_annotations) {
      args += [
        "--kythe-annotations",
        "--kythe-default-corpus",
        kythe_corpus,
      ]
    }
  }

  # Using `rust_library` instead of `rust_static_library` to minimize
  # dependencies of `cpp_api_from_rust.gni` (otherwise `import`ing
  # `cpp_api_from_rust.gni` from `rust_target.gni` would lead to
  # a cycle).
  rust_library(_rust_impl_target_name) {
    forward_variables_from(invoker,
                           [
                             "deps",
                             "testonly",
                           ])
    if (!defined(deps)) {
      deps = []
    }
    deps += [
      ":$_action_target_name",
      "//build/rust/crubit:cpp_api_from_rust_bindings_rs_deps",
      _rust_target,
    ]
    visibility = [ ":$_h_target_name" ]

    # Without going through `rust_static_library` / `rust_target` we have to
    # implement our own little mangling scheme.  Thankfully, the only user
    # of this crate is `_h_target_name`, which only consumes C ABI top-level
    # entrypoints - this means that the crate name isn't used / doesn't leak
    # anywhere.  And therefore it doesn't matter what kind of mangling we do,
    # as long as we ensure that it is globally unique.  (Note that
    # `_rust_target` is not necessarily unique - e.g. with
    # `use_rmeta_interface`, `//build/rust/std:std` is shared by all the
    # crates of a prebuilt Rust standard library.  This is why
    # `_h_target_name` is used as `_crate_name_base` below.)
    _crate_name_base = _h_target_name
    _crate_name_suffix =
        string_hash(get_label_info(_crate_name_base, "label_with_toolchain"))
    crate_name = "${_crate_name_base}_crubit_${_crate_name_suffix}"
    output_name = crate_name

    crate_root = _rs_out
    sources = [ crate_root ]
    configs += [ "//build/rust:default_edition" ]
  }

  source_set(_h_target_name) {
    forward_variables_from(invoker, TESTONLY_AND_VISIBILITY)

    forward_variables_from(_original_attributes, [ "deps" ])
    if (!defined(deps)) {
      deps = []
    }
    deps += [
      ":$_action_target_name",
      ":$_rust_impl_target_name",
    ]

    # `**public**_deps` to propagate `include_dirs` for including Crubit
    # support libraries.
    public_deps = [ "//build/rust/crubit:cpp_api_from_rust_bindings_cpp_deps" ]

    public = [ _h_out ]
  }
}
