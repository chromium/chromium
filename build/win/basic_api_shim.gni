import("//build/config/sanitizers/sanitizers.gni")

declare_args() {
  # Builds the Windows Basic Process API shim test fixture. See
  # crbug.com/533049438
  is_basic_api_shim = false
}

if (is_basic_api_shim) {
  assert(is_win, "is_basic_api_shim is only supported on Windows.")

  # Component builds move audited imports out of the original binary.
  assert(!is_component_build,
         "is_basic_api_shim does not support component builds.")

  # ASan adds runtime imports and intercepts audited calls.
  assert(!is_asan, "is_basic_api_shim does not support ASan.")
}
