#include <optional>
#include <string_view>

#include "base/containers/span.h"

namespace file_types_data {

// Returns the MIME type for a lowercase file extension, e.g. "image/jpeg" for
// ".jpg", or std::nullopt if the extension is unknown.
std::optional<std::string_view> GetMimeTypeForExtension(
    std::string_view extension);

// Returns all the MIME types for Documents, e.g. "text/plain",
// "application/vnd.google-apps.document" and "application/pdf".
base::span<const std::string_view> GetDocumentMimeTypes();

// Returns whether `mime_type` is one of GetDocumentMimeTypes().
bool IsDocumentMimeType(std::string_view mime_type);

}  // namespace file_types_data

