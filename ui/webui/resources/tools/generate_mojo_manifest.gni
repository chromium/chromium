template("generate_mojo_manifest") {
  action(target_name) {
    script = "//ui/webui/resources/tools/generate_mojo_manifest.py"
    forward_variables_from(invoker,
                           [
                             "deps",
                             "public_deps",
                             "testonly",
                             "visibility",
                           ])

    inputs = []
    outputs = [ invoker.out_manifest ]

    has_in_files = defined(invoker.in_files) && invoker.in_files != []
    has_dep_manifests =
        defined(invoker.dep_manifests) && invoker.dep_manifests != []
    assert(
        has_in_files || has_dep_manifests,
        "generate_mojo_manifest() requires 'in_files' or 'dep_manifests' to be non-empty.")

    args = [
      "--out_manifest",
      rebase_path(invoker.out_manifest, root_build_dir),
    ]

    if (has_in_files) {
      assert(
          defined(invoker.base_dir),
          "generate_mojo_manifest() requires 'base_dir' when 'in_files' is specified.")
      foreach(f, invoker.in_files) {
        assert(
            get_path_info(f, "extension") == "js",
            "generate_mojo_manifest() 'in_files' must be '.js' files, got '${f}'.")
      }
      dts_dir = invoker.base_dir
      if (defined(invoker.dts_dir)) {
        dts_dir = invoker.dts_dir
      }

      args += [
                "--base_dir",
                rebase_path(invoker.base_dir, root_build_dir),
                "--dts_dir",
                rebase_path(dts_dir, root_build_dir),
                "--in_files",
              ] + invoker.in_files

      if (defined(invoker.import_path_prefix) &&
          invoker.import_path_prefix != "") {
        args += [
          "--import_path_prefix",
          invoker.import_path_prefix,
        ]
      }
      if (defined(invoker.serve_path_prefix) &&
          invoker.serve_path_prefix != "") {
        args += [
          "--serve_path_prefix",
          invoker.serve_path_prefix,
        ]
      }
    } else {
      not_needed(invoker,
                 [
                   "base_dir",
                   "dts_dir",
                   "import_path_prefix",
                   "serve_path_prefix",
                 ])
    }

    if (has_dep_manifests) {
      inputs += invoker.dep_manifests
      args += [ "--dep_manifests" ] +
              rebase_path(invoker.dep_manifests, root_build_dir)
    }
  }
}
