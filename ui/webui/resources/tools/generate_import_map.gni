template("generate_import_map") {
  assert(defined(invoker.in_files) && invoker.in_files != [],
         "generate_import_map() requires 'in_files' to be non-empty.")

  action(target_name) {
    script = "//ui/webui/resources/tools/generate_import_map.py"

    forward_variables_from(invoker,
                           [
                             "deps",
                             "testonly",
                             "visibility",
                           ])

    in_folder = "."
    if (defined(invoker.in_folder)) {
      in_folder = invoker.in_folder
    }

    out_folder = target_gen_dir
    if (defined(invoker.out_folder)) {
      out_folder = invoker.out_folder
    }

    inputs = []
    outputs = []
    foreach(_in_file, invoker.in_files) {
      assert(
          get_path_info(_in_file, "extension") == "html",
          "generate_import_map() 'in_files' must be '.html' files, got '${_in_file}'.")
      assert(
          _in_file != "test_loader.html",
          "'test_loader.html' is automatically generated by generate_import_map() and must not be listed in 'in_files'.")
      inputs += [ "$in_folder/${_in_file}" ]
      outputs += [ "$out_folder/${_in_file}" ]
    }
    outputs += [ "$out_folder/test_loader.html" ]

    args = [
             "--in_folder",
             rebase_path(in_folder, root_build_dir),
             "--out_folder",
             rebase_path(out_folder, root_build_dir),
             "--in_files",
           ] + invoker.in_files

    if (defined(invoker.out_manifest)) {
      outputs += [ invoker.out_manifest ]
      args += [
        "--out_manifest",
        rebase_path(invoker.out_manifest, root_build_dir),
      ]
    }

    if (defined(invoker.manifest_files) && invoker.manifest_files != []) {
      assert(
          defined(invoker.deps) && invoker.deps != [],
          "generate_import_map() requires 'deps' when 'manifest_files' is non-empty.")
      inputs += invoker.manifest_files
      args += [ "--manifest_files" ] +
              rebase_path(invoker.manifest_files, root_build_dir)
    }
  }
}
