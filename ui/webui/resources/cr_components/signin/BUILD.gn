import("//mojo/public/tools/bindings/mojom.gni")
import("//ui/webui/resources/tools/build_webui.gni")

assert(enable_dice_support)

mojom("mojo_bindings") {
  sources = [ "signin.mojom" ]
  webui_module_path = "chrome://resources/cr_components/signin/"
}

build_webui("build") {
  grd_prefix = "cr_components_signin"

  ts_files = [ "signin.ts" ]

  mojo_files_deps = [ ":mojo_bindings_ts__generator" ]
  mojo_files = [ "$target_gen_dir/signin.mojom-webui.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  generate_grdp = true
  grd_resource_path_prefix = rebase_path(".", "//ui/webui/resources")
}
