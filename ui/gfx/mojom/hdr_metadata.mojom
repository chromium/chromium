module gfx.mojom;

import "skia/public/mojom/hdr_metadata.mojom";
import "skia/public/mojom/skcolorspace_primaries.mojom";

// Mojo equivalent of gfx::HDRMetadata.
struct HDRMetadata {
  skia.mojom.SkHdrMasteringDisplayColorVolume? mdcv;
  skia.mojom.SkHdrContentLightLevelInformation? clli;
  skia.mojom.SkHdrAdaptiveGlobalToneMap? agtm;
};
