module ui.mojom;

// TODO(rockot/ben): This definitely seems like the wrong layer for a
// "window open disposition" concept. It's here to support existing uses of
// ui::WindowOpenDisposition.
//
// //ui/base/window_open_disposition.h aliases this as `WindowOpenDisposition`
// until all clients have been migrated (crbug.com/373551504).
// These values are persisted (e.g. app restore data), logged to UKM and passed
// to and from Java as integers. Entries must not be renumbered.
enum WindowOpenDisposition {
  kUnknown = 0,
  kCurrentTab = 1,
  // Indicates that only one tab with the url should exist in the same window.
  kSingletonTab = 2,
  kNewForegroundTab = 3,
  kNewBackgroundTab = 4,
  kNewPopup = 5,
  kNewWindow = 6,
  kSaveToDisk = 7,
  kOffTheRecord = 8,
  kIgnoreAction = 9,
  // Activates an existing tab containing the url, rather than navigating.
  // This is similar to kSingletonTab, but searches across all windows from
  // the current profile and anonymity (instead of just the current one);
  // closes the current tab on switching if the current tab was the NTP with
  // no session history; and behaves like kCurrentTab instead of
  // kNewForegroundTab when no existing tab is found.
  kSwitchToTab = 10,
  // Creates a new document picture-in-picture window showing a child WebView.
  kNewPictureInPicture = 11,
  // Opens a link in a split view alongside the current tab.
  kNewSplitView = 12,
};

// Click information needed to determine user's desired window disposition using
// ui::DispositionFromClick().
struct ClickModifiers {
  bool middle_button;
  bool alt_key;
  bool ctrl_key;
  bool meta_key;
  bool shift_key;
};
