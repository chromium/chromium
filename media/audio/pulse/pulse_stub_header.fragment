// The extra include header needed in the generated stub file for defining
// various Pulse types.

extern "C" {

#include <pulse/pulseaudio.h>

#if PA_MAJOR > 12
using const_pa_context_ptr = const pa_context*;
using const_pa_operation_ptr = const pa_operation*;
using const_pa_proplist_ptr = const pa_proplist*;
using const_pa_stream_ptr = const pa_stream*;
#else
using const_pa_context_ptr = pa_context*;
using const_pa_operation_ptr = pa_operation*;
using const_pa_proplist_ptr = pa_proplist*;
using const_pa_stream_ptr = pa_stream*;
#endif
}
