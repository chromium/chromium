import("//build/config/compiler/compiler.gni")
import("//media/media_options.gni")

source_set("voice_isolation") {
  visibility = [ "//media/webrtc/*" ]

  sources = [
    "passthrough_voice_isolation.cc",
    "passthrough_voice_isolation.h",
    "voice_isolation.cc",
    "voice_isolation.h",
    "voice_isolation_component.cc",
    "voice_isolation_component.h",
  ]

  defines = [ "IS_MEDIA_WEBRTC_IMPL" ]

  deps = [ "//third_party/tflite:tflite_public_headers" ]

  public_deps = [
    "//base",
    "//media",
    "//third_party/tflite",
  ]
}

source_set("unit_tests") {
  testonly = true
  deps = [
    "//media/webrtc",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/tflite",
  ]
  sources = [
    "passthrough_voice_isolation_unittest.cc",
    "voice_isolation_unittest.cc",
  ]
}
