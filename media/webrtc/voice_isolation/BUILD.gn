import("//build/config/compiler/compiler.gni")
import("//media/media_options.gni")

source_set("voice_isolation") {
  visibility = [ "//media/webrtc/*" ]

  sources = [
    "band_split_voice_isolation.cc",
    "band_split_voice_isolation.h",
    "passthrough_voice_isolation.cc",
    "passthrough_voice_isolation.h",
    "stft_voice_isolation.cc",
    "stft_voice_isolation.h",
    "tflite_voice_isolation.cc",
    "tflite_voice_isolation.h",
    "voice_isolation.cc",
    "voice_isolation.h",
    "voice_isolation_component.cc",
    "voice_isolation_component.h",
  ]

  defines = [ "IS_MEDIA_WEBRTC_IMPL" ]

  deps = [
    "//third_party/tflite:buildflags",
    "//third_party/tflite:tflite_public_headers",
  ]

  public_deps = [
    "//base",
    "//components/optimization_guide/core/inference:op_resolver",
    "//media",
    "//third_party/pffft",
    "//third_party/tflite",
  ]
}

source_set("mock_voice_isolation") {
  testonly = true
  sources = [
    "mock_voice_isolation.cc",
    "mock_voice_isolation.h",
  ]
  deps = [
    "//media/webrtc",
    "//testing/gmock",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "voice_isolation_test_utils.cc",
    "voice_isolation_test_utils.h",
  ]
  deps = [ "//base" ]
  public_deps = [
    "//third_party/flatbuffers",
    "//third_party/tflite",
  ]
  data = [
    "test_model_1_2_160_2.tflite",
    "test_model_stateful_1_2_160_2.tflite",
  ]
}

source_set("unit_tests") {
  testonly = true
  deps = [
    ":mock_voice_isolation",
    ":test_support",
    "//base/test:test_support",
    "//media/webrtc",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/flatbuffers",
    "//third_party/tflite",
  ]
  sources = [
    "band_split_voice_isolation_unittest.cc",
    "passthrough_voice_isolation_unittest.cc",
    "stft_voice_isolation_unittest.cc",
    "tflite_voice_isolation_unittest.cc",
    "voice_isolation_unittest.cc",
  ]
}

if (chrome_wide_echo_cancellation_supported) {
  executable("voice_isolation_wav_tool") {
    testonly = true
    sources = [ "voice_isolation_wav_tool.cc" ]
    deps = [
      "//base",
      "//components/optimization_guide/core/inference:op_resolver",
      "//media/webrtc",
    ]
  }
}
