import("//remoting/host/installer/win/host_payload_files.gni")

_payload_header = "$target_gen_dir/payload_files.h"
_header_lines = [
  "// Generated by //remoting/host/installer/win/setup/BUILD.gn.",
  "// DO NOT EDIT.",
  "",
  "#ifndef REMOTING_HOST_INSTALLER_WIN_SETUP_PAYLOAD_FILES_H_",
  "#define REMOTING_HOST_INSTALLER_WIN_SETUP_PAYLOAD_FILES_H_",
  "",
  "#include <array>",
  "",
  "namespace remoting::installer {",
  "",
  "inline constexpr auto kPayloadFiles = std::to_array<const wchar_t*>({",
]

foreach(_file, remoting_win_host_payload_files) {
  _header_lines += [ "    L\"$_file\"," ]
}

_header_lines += [
  "});",
  "",
  "}  // namespace remoting::installer",
  "",
  "#endif  // REMOTING_HOST_INSTALLER_WIN_SETUP_PAYLOAD_FILES_H_",
]

write_file(_payload_header, _header_lines)

_nm_entries_header = "$target_gen_dir/native_messaging_entries.h"
_nm_header_lines = [
  "// Generated by //remoting/host/installer/win/setup/BUILD.gn.",
  "// DO NOT EDIT.",
  "",
  "#ifndef REMOTING_HOST_INSTALLER_WIN_SETUP_NATIVE_MESSAGING_ENTRIES_H_",
  "#define REMOTING_HOST_INSTALLER_WIN_SETUP_NATIVE_MESSAGING_ENTRIES_H_",
  "",
  "#include <array>",
  "",
  "namespace remoting::installer {",
  "",
  "inline constexpr wchar_t kChromeNativeMessagingKeyPath[] =",
  "    L\"SOFTWARE\\\\Google\\\\chrome\\\\NativeMessagingHosts\";",
  "inline constexpr wchar_t kFirefoxNativeMessagingKeyPath[] =",
  "    L\"SOFTWARE\\\\Mozilla\\\\NativeMessagingHosts\";",
  "",
  "struct NativeMessagingEntry {",
  "  const wchar_t* registry_parent_path;",
  "  const wchar_t* host_name;",
  "  const wchar_t* manifest_file_name;",
  "};",
  "",
  "inline constexpr auto kNativeMessagingEntries =",
  "    std::to_array<NativeMessagingEntry>({",
]

foreach(_entry, remoting_win_native_messaging_entries) {
  if (_entry.browser == "chrome") {
    _key = "kChromeNativeMessagingKeyPath"
  } else if (_entry.browser == "firefox") {
    _key = "kFirefoxNativeMessagingKeyPath"
  } else {
    assert(false, "Unknown browser: " + _entry.browser)
  }
  _nm_header_lines += [
    "        {$_key,",
    "         L\"${_entry.host_name}\",",
    "         L\"${_entry.manifest_name}\"},",
  ]
}

_nm_header_lines += [
  "    });",
  "",
  "}  // namespace remoting::installer",
  "",
  "#endif  // REMOTING_HOST_INSTALLER_WIN_SETUP_NATIVE_MESSAGING_ENTRIES_H_",
]

write_file(_nm_entries_header, _nm_header_lines)

source_set("payload_files_header") {
  sources = [
    _nm_entries_header,
    _payload_header,
  ]
}

source_set("setup_lib") {
  sources = [
    "file_util.cc",
    "file_util.h",
    "file_work_items.cc",
    "file_work_items.h",
    "installer_constants.cc",
    "installer_constants.h",
    "registry_util.cc",
    "registry_util.h",
    "registry_work_items.cc",
    "registry_work_items.h",
    "service_util.cc",
    "service_util.h",
    "service_work_items.cc",
    "service_work_items.h",
    "setup_work_items.cc",
    "setup_work_items.h",
  ]

  public_deps = [
    ":payload_files_header",
    "//base",
    "//build:branding_buildflags",
    "//chrome/installer/util:work_item",
