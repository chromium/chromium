source_set("setup_lib") {
  sources = [
    "installer_constants.cc",
    "installer_constants.h",
    "service_util.cc",
    "service_util.h",
  ]

  public_deps = [
    "//base",
    "//build:branding_buildflags",
    "//remoting/base",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "installer_constants_unittest.cc",
    "service_util_unittest.cc",
  ]

  deps = [
    ":setup_lib",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
