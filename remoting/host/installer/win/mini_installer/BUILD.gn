assert(is_win)

source_set("lib") {
  sources = [
    "mini_installer.cc",
    "mini_installer.h",
    "mini_installer_constants.h",
  ]

  public_deps = [ "//base" ]

  deps = [ "//chrome/installer/util:metainstaller_utils" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "mini_installer_unittest.cc" ]

  deps = [
    ":lib",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
