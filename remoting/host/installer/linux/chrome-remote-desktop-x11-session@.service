[Unit]
Description=Chrome Remote Desktop X11 session for %i
# Wait until user logins are allowed. Otherwise, pam_systemd may time out
# waiting for user@<uid>.service during boot, leaving the session without
# XDG_RUNTIME_DIR. See b/149144987.
After=systemd-user-sessions.service
# The single-process host manages its own session, so it cannot run at the same
# time as this service for the same user.
Conflicts=chrome-remote-desktop@%i.service

[Service]
Type=simple
User=%i
Environment=XDG_SESSION_CLASS=user XDG_SESSION_TYPE=x11
# The multi-process host identifies CRD-managed sessions by this PAM service
# name. See UserDesktopSessionBackend::SelectBestGraphicalSession().
PAMName=chrome-remote-desktop
# Ideally, PAM_TTY would be set to the X display, but we don't yet know what
# display we'll be using. Leaving it unset has been known to break some PAM
# modules (the pam_systemd documentation explicitly calls out pam_time and
# pam_access, though they appear to have since been fixed) so the below sets
# it to a fake value. There is some precedent for this, as SSH and cron set
# PAM_TTY to "ssh" and "cron" (respectively) for similar reasons. This also has
# the side effect of making CRD sessions easy to spot in the output of
# loginctl.
#
# Unfortunately, systemd doesn't provide a way to set PAM_TTY explicitly, but it
# will set it to the value of TTYPath, if present. TTYPath must be an absolute
# path, but /dev/ will get stripped off by pam_systemd when it copies the value
# from PAM_TTY to the logind session information. Setting this to a nonexistent
# path seems not to cause issues as long as none of the Standard*= options are
# set to "tty".
TTYPath=/dev/chrome-remote-desktop
ExecStart=/opt/google/chrome-remote-desktop/desktop-session --type=x11 --new-session
# Only send SIGTERM to the script, so that it can tear down the X server and
# session in order and clean up the systemd user environment. Any remaining
# processes are sent SIGKILL afterwards.
KillMode=mixed
# In the worst case, cleanup() can take longer than the default 90 seconds to
# terminate all session processes.
TimeoutStopSec=120
# Log output to the journal
StandardOutput=journal
# Use same fd as stdout
StandardError=inherit
# Must be kept in sync with RELAUNCH_EXIT_CODE in shared_lib.py
RestartForceExitStatus=41

[Install]
WantedBy=multi-user.target
