module remoting.mojom;

import "remoting/host/mojom/chromoting_host_services.mojom";
import "remoting/host/mojom/common.mojom";
import "remoting/host/mojom/desktop_session.mojom";
import "remoting/host/mojom/webrtc_types.mojom";

// LINT.IfChange(SessionDescription)
// WebRTC Session Description (SDP) type.
// Maps to C++ enum: `::remoting::SessionDescription::Type`
// (defined in remoting/signaling/jingle_data_structures.h).
enum SdpType {
  kUnspecified,
  kOffer,
  kAnswer,
};

// Represents a WebRTC Session Description Protocol (SDP) payload. The protocol
// is defined in RFC 4566.
// Maps to C++ type: `::remoting::SessionDescription`
// (defined in remoting/signaling/jingle_data_structures.h).
struct SessionDescription {
  SdpType type;
  string sdp;
  array<uint8> signature;
};
// LINT.ThenChange(//remoting/signaling/jingle_data_structures.h:SessionDescription)

// LINT.IfChange(NamedCandidate)
// Represents an individual ICE (Interactive Connectivity Establishment,
// RFC 8445) candidate with its associated media stream identifier (`sdp_mid`).
// An ICE candidate defines a potential network transport address (IP, port, and
// protocol) for peer-to-peer communication.
// Maps to C++ type: `::remoting::IceTransportInfo::NamedCandidate`
// (defined in remoting/signaling/jingle_data_structures.h).
struct NamedCandidate {
  string sdp_mid;
  // The zero-based index of the Media Descriptions ("m=") in the SDP associated
  // with this candidate, if available; null if only sdp_mid is provided by the
  // signaling peer.
  int32? sdp_m_line_index;
  WebrtcCandidate candidate;
};
// LINT.ThenChange(//remoting/signaling/jingle_data_structures.h:NamedCandidate)

// LINT.IfChange(JingleTransportInfo)
// Represents structured Jingle transport parameters. Used in Trickle ICE
// (RFC 8838): initial message carries `session_description` and initial
// candidates; subsequent messages asynchronously stream newly discovered
// candidates with `session_description` set to null.
// Maps to C++ type: `::remoting::JingleTransportInfo`
// (defined in remoting/signaling/jingle_data_structures.h).
struct JingleTransportInfo {
  array<NamedCandidate> candidates;
  // The WebRTC Session Description (SDP) payload if this transport-info
  // stanza conveys an offer/answer session description; null if this message
  // conveys only incremental ICE candidates.
  SessionDescription? session_description;
};
// LINT.ThenChange(//remoting/signaling/jingle_data_structures.h:JingleTransportInfo)

// Interface implemented in the high-privilege daemon process (`DaemonProcess`).
// Used by the Network process to spawn or bootstrap a Peer Connection session.
//
// Callee: High-privilege Daemon Process (`remoting::DaemonProcess`).
// Caller: Trusted Network Process (`remoting::IpcPeerSessionFactory`).
[EnableIf=is_win|is_linux]
interface PeerSessionManager {
  // Launches a peer session and binds `peer_session_receiver`.
  LaunchPeerSession(
      pending_receiver<PeerSession> peer_session_receiver);
};

// LINT.IfChange(peer_session_event_handler)
// Mirror of remoting::PeerSession::EventHandler.
// Implemented by the Network process and called by the Peer Connection process.
[EnableIf=is_win|is_linux]
interface PeerSessionEventHandler {
  // Called after all channels have been connected.
  OnSessionChannelsConnected();

  // Called when the session has closed or failed. `error_details` is a
  // human-readable diagnostic string intended for logging/debugging only and
  // must not be parsed programmatically.
  OnSessionClosed(ProtocolErrorCode error,
                  string error_details,
                  SourceLocation error_location);

  // Called on notification of a route change event when a channel is connected.
  OnSessionRouteChange(string channel_name, TransportRoute route);
};
// LINT.ThenChange(//remoting/host/peer_session.h:peer_session_event_handler)

// A session interface implemented by the Peer Connection process.
// If the caller drops the remote, the disconnect handler terminates the Peer
// Connection process.
//
// Callee: Untrusted Peer Connection Process (`PeerConnectionProcess`).
// Caller: Network Process (`IpcPeerSession`).
[EnableIf=is_win|is_linux]
interface PeerSession {
  // Starts the peer session.
  Start(pending_remote<PeerSessionEventHandler> event_handler,
        string client_jid,
        pending_remote<DesktopSession> control_remote,
        pending_receiver<DesktopSessionEvents> events_receiver,
        DesktopEnvironmentOptions desktop_environment_options,
        SessionPolicies session_policies,
        SessionOptions session_options);

  // Disconnects the peer session and tears down transport and desktop
  // resources. `error_details` is a human-readable diagnostic string intended
  // for logging/debugging only and must not be parsed programmatically.
  DisconnectSession(ProtocolErrorCode error,
                    string error_details,
                    SourceLocation error_location);

  // Connects a ChromotingSessionServices client.
  OnSessionServicesClientConnected(
      pending_receiver<ChromotingSessionServices> receiver);
};

// Associated interface used by the Daemon to control the PC process.
//
// Callee: Untrusted Peer Connection Process (`PeerConnectionProcess`).
// Caller: Privileged Daemon Process (`remoting::DaemonProcess`).
[EnableIf=is_win|is_linux]
interface PeerConnectionProcessControl {
  // Binds the `PeerSession` receiver in the PC process.
  BindPeerSession(pending_receiver<PeerSession> session_receiver);
};
