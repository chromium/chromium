import("//remoting/build/config/remoting_build.gni")

source_set("crash") {
  public_deps = []
  if (is_linux || is_win) {
    public_deps += [ ":crashpad" ]
  }
}

if (is_linux || is_win) {
  static_library("crashpad_db_mgr") {
    sources = [
      "crashpad_database_manager.cc",
      "crashpad_database_manager.h",
    ]
    deps = [
      "//base",
      "//remoting/base:os_utils",
      "//third_party/crashpad/crashpad/util",
    ]
    public_deps = [ "//third_party/crashpad/crashpad/client" ]
  }

  static_library("crashpad") {
    sources = [
      "crash_reporting_crashpad.cc",
      "crash_reporting_crashpad.h",
    ]
    if (is_linux) {
      sources += [
        "crashpad_linux.cc",
        "crashpad_linux.h",
      ]
    }
    if (is_win) {
      sources += [
        "crashpad_win.cc",
        "crashpad_win.h",
      ]
    }

    configs += [ "//remoting/build/config:host_implementation" ]

    deps = [
      ":crashpad_db_mgr",
      "//base",
      "//remoting/base:logging",
      "//remoting/base:os_utils",
      "//remoting/base:remoting_base_version",
      "//third_party/crashpad/crashpad/client",
      "//third_party/crashpad/crashpad/util",
    ]
  }
}
