module gpu.mojom;

import "gpu/ipc/common/mailbox.mojom";
import "gpu/ipc/common/shared_image_metadata.mojom";
import "gpu/ipc/common/sync_token.mojom";
import "ui/gfx/mojom/buffer_types.mojom";

// gpu::SharedImageExportResult
struct SharedImageExportResult {
  // SyncToken for the latest write access performed by the importer after
  // import, or empty if the importer did not write to the SharedImage (and
  // always empty when automatic SyncToken management is disabled).
  gpu.mojom.SyncToken write_sync_token;

  // SyncTokens for read accesses performed after the latest write. When
  // automatic SyncToken management is disabled, holds the caller-supplied
  // release SyncToken(s).
  array<gpu.mojom.SyncToken> read_sync_tokens;
};

// gpu::ExportedSharedImage
struct ExportedSharedImage {
  gpu.mojom.Mailbox mailbox;
  gpu.mojom.SharedImageMetadata metadata;
  gpu.mojom.SyncToken creation_sync_token;

  // SyncToken for the latest write access to the SharedImage prior to export.
  // Empty when automatic SyncToken management is disabled.
  gpu.mojom.SyncToken write_sync_token;

  // SyncTokens for read accesses performed since the latest write prior to
  // export. Empty when automatic SyncToken management is disabled.
  array<gpu.mojom.SyncToken> read_sync_tokens;
  string debug_label;

  // Optional params as they are only needed when passed over VideoFrame
  // GpuMemoryBuffers for exporting/importing mappable shared images.
  // For other cases, when exporting/importing ClientSharedImage,
  // passing these params is not needed.
  gfx.mojom.GpuMemoryBufferHandle? buffer_handle;
  gfx.mojom.BufferUsage? buffer_usage;

  // Necessary to allow the ClientSharedImage that is created from this
  // ExportedSharedImage to use the correct GL texture target.
  uint32 texture_target;

  bool is_software;
};
