// Example WebIDL schema which is invalid as it uses a nullable type on a
// dictionary member, which is not currently supported.
dictionary TestDictionary {
  DOMString? invalidNullableMember;
};

interface TestWebIdl {
  static undefined dummyFunction(TestDictionary dict);
};

partial interface Browser {
  static attribute TestWebIdl testWebIdl;
};
