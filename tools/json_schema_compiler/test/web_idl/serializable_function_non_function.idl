// Example WebIDL schema which is invalid as it uses the [serializableFunction]
// extended attribute on a non-function dictionary member.
dictionary TestDictionary {
  [serializableFunction] DOMString invalidMember;
};

interface TestWebIdl {
  static undefined dummyFunction(TestDictionary dict);
};

partial interface Browser {
  static attribute TestWebIdl testWebIdl;
};
