import("//build/config/clang/clang.gni")
import("//build/config/python.gni")
import("//build/config/vpython.gni")
import("//testing/test.gni")

# Use the following import to find other suffixes as needed. The suffixes start
# with _android. Since there are only two targets here, prefer to duplicate for
# now instead of using a variable for better searchability.
# import("//tools/perf/chrome_telemetry_build/android_browser_types.gni")

python_library("generate_profile_py") {
  testonly = true
  pydeps_file = "//tools/pgo/generate_profile.pydeps"
  data = vpython_spec_files
}

python_library("generate_profile_webview_py") {
  testonly = true
  pydeps_file = "//tools/pgo/generate_profile_webview.pydeps"
  data = vpython_spec_files
}

template("generate_profile_test") {
  not_needed(invoker, "*")

  script_test(target_name) {
    script = "//tools/pgo/generate_profile.py"

    if (is_android) {
      # Stream logcat from device (doesn't seem to fully work yet).
      enable_android_wrapper = true
    }

    args = [
      # Assume that we are running this script from the output directory.
      "--builddir",
      ".",
      "--target-arch",
      target_cpu,
    ]

    if (is_android) {
      args += [
        "--android-browser",
        invoker.browser_name,
      ]
    }

    deps = [ ":generate_profile_py" ]

    data_deps = [
      # From performance_test_suite_template_base:
      "//components:components_perftests",
      "//testing:run_perf_test",
      "//third_party/dawn/src/tint/cmd/bench:bench_cmd",
    ]

    if (is_android) {
      data_deps += [
        "//chrome/test:telemetry_perf_tests${invoker.suffix}",

        # Needed by the browser wrapper script to install bundles, see
        # add_java_to_path in generate_profile.py.
        "//third_party/jdk:java_data",
      ]
    } else {
      data_deps += [ "//chrome/test:telemetry_perf_tests" ]
    }

    # This avoids generate_profile.py attempting to download it on demand.
    if (is_win) {
      data = [ "${clang_base_path}/bin/llvm-profdata.exe" ]
    } else {
      data = [ "${clang_base_path}/bin/llvm-profdata" ]
    }
  }
}

if (is_android) {
  generate_profile_test("generate_profile_android_chrome_bundle") {
    browser_name = "android-chromium-bundle"
    suffix = "_android_chrome_bundle"
  }

  if (defined(android_app_secondary_abi)) {
    script_test("generate_profile_android_webview_64") {
      script = "//tools/pgo/generate_profile_webview.py"

      # Stream logcat from device (doesn't seem to fully work yet).
      enable_android_wrapper = true

      args = [
        # Assume that we are running this script from the output directory.
        "--builddir",
        ".",
      ]

      deps = [ ":generate_profile_webview_py" ]

      data_deps = []
      if (enable_chrome_android_internal) {
        data_deps += [ "//chrome/test:telemetry_perf_tests_android_clank_webview_64_32_bundle" ]
      } else {
        data_deps +=
            [ "//chrome/test:telemetry_perf_tests_android_webview_bundle" ]
      }

      # This avoids generate_profile_webview.py attempting to download it on
      # demand.
      data = [ "${clang_base_path}/bin/llvm-profdata" ]
    }
  }
} else {
  generate_profile_test("generate_profile") {
  }
}
