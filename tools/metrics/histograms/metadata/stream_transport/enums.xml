<histogram-configuration>

<enums>

<!-- LINT.IfChange(StreamTransportPayloadDropReason) -->

<enum name="StreamTransportPayloadDropReason">
  <int value="0" label="Unspecified or unknown payload type"/>
  <int value="1" label="Any.type_url did not match the payload type"/>
  <int value="2" label="No handler factory registered for the payload type"/>
  <int value="3" label="Dispatch to the handler failed"/>
</enum>

<!-- LINT.ThenChange(//components/stream_transport/internal/metrics_utils.h:DownstreamPayloadDropReason) -->

<!-- LINT.IfChange(StreamTransportSessionInitIngressSource) -->

<enum name="StreamTransportSessionInitIngressSource">
  <int value="0" label="Unspecified"/>
  <int value="1" label="FcmPush"/>
  <int value="2" label="WatchSessionsStream"/>
  <int value="3" label="LocalChromeIngest"/>
</enum>

<!-- LINT.ThenChange(//components/stream_transport/public/common.h:InitIngressSource) -->

</enums>

</histogram-configuration>
