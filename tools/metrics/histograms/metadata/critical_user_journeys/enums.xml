<!--
This file defines enums used in Critical User Journey histograms.
-->

<histogram-configuration>

<enums>

<!-- Define the steps for your journeys below! -->

<!-- LINT.IfChange(ClearBrowsingHistoryJourneySteps) -->

<enum name="ClearBrowsingHistoryJourneySteps">
  <int value="1" label="Open clear browsing data dialog via accelerator"/>
  <int value="2" label="Activate app menu toolbar button"/>
  <int value="3" label="Show clear browsing data settings dialog"/>
  <int value="4" label="Clear browsing data history event"/>
  <int value="5" label="Dismiss clear browsing data settings dialog"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:ClearBrowsingHistoryJourneySteps) -->

<!-- LINT.IfChange(CriticalUserJourneyHaTSEvent) -->

<!-- Tracks HaTS survey events for Critical User Journeys -->

<enum name="CriticalUserJourneyHaTSEvent">
  <int value="0" label="Survey Triggered"/>
  <int value="1" label="Survey Shown"/>
  <int value="2" label="Survey Failed to Show"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_service.h:CriticalUserJourneyHaTSEvent) -->

<!-- LINT.IfChange(CriticalUserJourneyResult) -->

<enum name="CriticalUserJourneyResult">
  <int value="0" label="Completed"/>
  <int value="1" label="Aborted"/>
  <int value="2" label="Timed Out"/>
  <int value="3" label="Abandoned via exit branch"/>
  <int value="4" label="Exit branch reached below minimum dwell time"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_session.h:JourneyResult) -->

<!-- LINT.IfChange(CustomizeChromeJourneySteps) -->

<enum name="CustomizeChromeJourneySteps">
  <int value="1" label="Customize Chrome side panel shown"/>
  <int value="2" label="Theme or color selected"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:CustomizeChromeJourneySteps) -->

<!-- LINT.IfChange(PinExtensionJourneySteps) -->

<enum name="PinExtensionJourneySteps">
  <int value="1" label="Clicked the extensions toolbar button"/>
  <int value="2" label="Pin extension via menu item"/>
  <int value="3" label="Pin the extension via the side panel pin button"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:PinExtensionJourneySteps) -->

<!-- LINT.IfChange(ReadAnythingJourneySteps) -->

<enum name="ReadAnythingJourneySteps">
  <int value="1" label="Open Reading Mode"/>
  <int value="2" label="Reading Mode view shown"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:ReadAnythingJourneySteps) -->

<!-- LINT.IfChange(SettingsAppearanceThemesJourneySteps) -->

<enum name="SettingsAppearanceThemesJourneySteps">
  <int value="1" label="Appearance nav menu item clicked"/>
  <int value="2" label="Appearance color tile selected"/>
  <int value="3" label="Appearance theme changed"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsAppearanceThemesJourneySteps) -->

<!-- LINT.IfChange(SettingsClearBrowsingDataJourneySteps) -->

<enum name="SettingsClearBrowsingDataJourneySteps">
  <int value="1" label="Clear browsing data row clicked"/>
  <int value="2" label="Clear browsing data confirm button clicked"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsClearBrowsingDataJourneySteps) -->

<!-- LINT.IfChange(SettingsNavIAJourneySteps) -->

<enum name="SettingsNavIAJourneySteps">
  <int value="1" label="Settings page loaded"/>
  <int value="2" label="Settings nav category clicked"/>
  <int value="3" label="Setting state changed"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsNavIAJourneySteps) -->

<!-- LINT.IfChange(SettingsSearchEngineJourneySteps) -->

<enum name="SettingsSearchEngineJourneySteps">
  <int value="1" label="Search engine nav menu item clicked"/>
  <int value="2" label="Default search engine changed"/>
  <int value="3" label="Search shortcuts toggled"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsSearchEngineJourneySteps) -->

<!-- LINT.IfChange(SettingsSitesDashboardJourneySteps) -->

<enum name="SettingsSitesDashboardJourneySteps">
  <int value="1" label="Sites nav menu item clicked"/>
  <int value="2" label="Site permission category clicked"/>
  <int value="3" label="Site permission changed"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsSitesDashboardJourneySteps) -->

<!-- LINT.IfChange(SettingsSuperchargedSearchJourneySteps) -->

<enum name="SettingsSuperchargedSearchJourneySteps">
  <int value="1" label="Settings search box shown"/>
  <int value="2" label="Settings search query entered"/>
  <int value="3" label="Settings search result clicked"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:SettingsSuperchargedSearchJourneySteps) -->

<!-- LINT.IfChange(TabSearchJourneySteps) -->

<enum name="TabSearchJourneySteps">
  <int value="1" label="Open Tab Search"/>
  <int value="2" label="Tab Search bubble shown"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:TabSearchJourneySteps) -->

<!-- LINT.IfChange(ViewDownloadedFileFromAppMenuJourneySteps) -->

<enum name="ViewDownloadedFileFromAppMenuJourneySteps">
  <int value="1" label="Finish download"/>
  <int value="2" label="App menu button clicked"/>
  <int value="3" label="Downloads menu item clicked"/>
  <int value="4" label="Downloaded file clicked"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:ViewDownloadedFileFromAppMenuJourneySteps) -->

<!-- LINT.IfChange(ViewDownloadedFileJourneySteps) -->

<enum name="ViewDownloadedFileJourneySteps">
  <int value="1" label="Finish download"/>
  <int value="2" label="Download bubble appears"/>
  <int value="3" label="User clicked download bubble"/>
  <int value="4" label="Click downloaded file"/>
</enum>

<!-- LINT.ThenChange(//chrome/browser/metrics/critical_user_journeys/critical_user_journey_registry.h:ViewDownloadedFileJourneySteps) -->

</enums>

</histogram-configuration>
