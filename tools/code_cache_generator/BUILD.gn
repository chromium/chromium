# Targets in this file are used to create compiled bytecode for chromium bundled
# JS scripts at build time. The resulting compiled bytecode can be used during
# runtime to improve load performance.

import("//build/buildflag_header.gni")
import("//build/config/c++/c++.gni")
import("//build/config/compiler/compiler.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//v8/gni/snapshot_toolchain.gni")

if (is_android) {
  import("//build/config/android/rules.gni")
}

# The generator runs on the build host. Code cache actions use the copy built
# in the V8 snapshot toolchain, like v8_context_snapshot_generator, and pass it
# the target's snapshot. The default-toolchain copy serves the Python unit
# tests, which run it next to the snapshot in the root build directory.
if (v8_snapshot_toolchain == current_toolchain ||
    current_toolchain == default_toolchain) {
  executable("code_cache_generator") {
    sources = [ "code_cache_generator.cc" ]

    deps = [
      "//gin",
      "//mojo/core/embedder",
      "//third_party/blink/public:blink",
      "//tools/v8_context_snapshot:buildflags",
      "//v8",
    ]
    data = []

    if (v8_use_external_startup_data &&
        current_toolchain == default_toolchain) {
      if (use_v8_context_snapshot) {
        data += [ "$root_out_dir/$v8_context_snapshot_filename" ]
      }
      if (!use_v8_context_snapshot || include_both_v8_snapshots) {
        data += [ "$root_out_dir/snapshot_blob.bin" ]
      }
    }

    configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
    configs += [
      "//build/config/compiler:thinlto_optimize_none",
      "//v8:external_startup_data",
    ]

    # This binary only runs at build time to generate WebUI code caches; skip
    # debug info emission (including split DWARF .dwo files) and slow shipping
    # linker optimizations.
    if (!is_win && !is_apple) {
      configs -= [ "//build/config/compiler:default_symbols" ]
      configs += [
        "//build/config/compiler:no_symbols",
        "//build/config/compiler:strip_debug",
      ]
      if (use_lld || linker_path != "") {
        ldflags = [
          "-Wl,-O0",
          "-Wl,--build-id=none",
        ]
      }
    } else if (is_apple) {
      configs -= [ "//build/config/apple:strip_all" ]
      configs += [ "//build/config/apple:no_dsym" ]
      if (use_lld) {
        ldflags = [
          "-Wl,--no-deduplicate-strings",
          "-Wl,-no-deduplicate-symbol-strings",
        ]
      }
    }
  }
}
