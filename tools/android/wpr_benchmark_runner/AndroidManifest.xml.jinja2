<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.chromium.wpr_benchmark_runner"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.INTERNET"/>
    <queries>
        <package android:name="{{ browser_package_name }}"/>
    </queries>
    <application android:label="On-Device WPR Benchmarks"
        android:debuggable="true"
        android:extractNativeLibs="true"/>
    <instrumentation
        android:name="org.chromium.wpr_benchmark_runner.WprBenchmarkInstrumentation"
        android:targetPackage="org.chromium.wpr_benchmark_runner"/>
</manifest>
