# Configuration for an Android 17 Desktop (Preview) AVD on android-desktop on x86_64

emulator_package {
  package_name: "chromium/third_party/android_sdk/public/emulator/linux-amd64"
  version: "1wluGeFAvaG_R0ZiZFeHaUjZX67-6le7pI-PAqbFq10C"  # 37.2.12 (Stable)
}

system_image_package {
  package_name: "chromium/third_party/android_sdk/public/system-images/android-37.1/android-desktop/x86_64"
  version: "zgsdjqqW5U0EKiv1kKIH_KkzZ9MaIDb1M4UB33oh2PwC"  # r1, CLE3.260929.004
}
system_image_name: "system-images;android-37.1;android-desktop;x86_64"

avd_package {
  package_name: "chromium/third_party/android_sdk/public/avds/android-37.1/android-desktop/x86_64"
}
avd_name: "android_37_desktop_x64"

avd_settings {
  # The same as "Desktop (Preview)" in Android Studio (2880x1800 @ 240 dpi, 16:10, 1920x1200 dp)
  screen {
    density: 240
    height: 1800
    width: 2880
  }
  advanced_features {
    key: "GLESDynamicVersion"
    value: "on"
  }
  # The guest can't open the emulator's UWB virtio port, so
  # android.hardware.uwb-service crash-loops (~every 5s) and floods tests with
  # tombstones. Desktop doesn't need UWB. See crbug.com/571651034.
  advanced_features {
    key: "Uwb"
    value: "off"
  }
  # Desktop system images enable VirtioMouse (relative coordinates + mouse
  # capture, crbug.com/459987603) to support multi-display cursor movement and
  # pure SOURCE_MOUSE events. However, mouse capture/repositioning breaks cursor
  # tracking on Wayland and Chrome Remote Desktop (crbug.com/524088899). Since
  # Clank currently does not have tests that require multi-display, switch to
  # VirtioTablet (crbug.com/562275578) for 1:1 absolute coordinates while still
  # supporting mouse hover, right/middle click, and scroll wheel on a single
  # display.
  advanced_features {
    key: "VirtioMouse"
    value: "off"
  }
  advanced_features {
    key: "VirtioTablet"
    value: "on"
  }
  # 4GB RAM for 34+ API AVDs
  ram_size: 4096
}
avd_variants {
  key: "swarming"
  value {
    avd_properties {
      key: "disk.dataPartition.size"
      value: "4G"
    }
  }
}
avd_variants {
  key: "local"
  value {
    avd_properties {
      key: "disk.dataPartition.size"
      value: "12G"
    }
  }
}

avd_launch_settings {
  gpu_mode: "swangle_indirect"
}
