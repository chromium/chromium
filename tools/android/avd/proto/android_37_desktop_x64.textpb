# Configuration for an Android 17 Desktop (Preview) AVD on android-desktop on x86_64

emulator_package {
  package_name: "chromium/third_party/android_sdk/public/emulator/linux-amd64"
  version: "1wluGeFAvaG_R0ZiZFeHaUjZX67-6le7pI-PAqbFq10C"  # 37.2.12 (Stable)
}

system_image_package {
  package_name: "chromium/third_party/android_sdk/public/system-images/android-37.1/android-desktop/x86_64"
  version: "zgsdjqqW5U0EKiv1kKIH_KkzZ9MaIDb1M4UB33oh2PwC"  # r1, CLE3.260929.004
}
system_image_name: "system-images;android-37.1;android-desktop;x86_64"

avd_package {
  package_name: "chromium/third_party/android_sdk/public/avds/android-37.1/android-desktop/x86_64"
  version: "sZ_V_R6hSP7ywMhn8S_K0JeJv61ceZ4jP8FyY-RczdsC"
}
avd_name: "android_37_desktop_x64"

avd_launch_settings {
  gpu_mode: "swangle_indirect"
}
