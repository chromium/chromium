# Configuration for an Android 17 AVD on google_apis_ps16k on x86_64

emulator_package {
  package_name: "chromium/third_party/android_sdk/public/emulator/linux-amd64"
  version: "iC68PzTvR0H3ep-hBsHaSK6w5Fh8EDpjDneGgAVDc9IC"  # 37.1.11 (Stable)
}

system_image_package {
  package_name: "chromium/third_party/android_sdk/public/system-images/android-37.2/google_apis_ps16k/x86_64"
  version: "zFUkg7QFoqKulhiuIpk-Z3JlRw4FIAHszmenSVr18PMC"  # r7, CP41.260831.015
}
system_image_name: "system-images;android-37.2;google_apis_ps16k;x86_64"

avd_package {
  package_name: "chromium/third_party/android_sdk/public/avds/android-37.2/google_apis_ps16k/x86_64"
  version: "qY3a_rH4Jqez6QanU92hC4NH0r_2iN73cebTSO-vdSYC"
}
avd_name: "android_37_google_apis_ps16k_x64"

avd_launch_settings {
  gpu_mode: "swangle_indirect"
}
