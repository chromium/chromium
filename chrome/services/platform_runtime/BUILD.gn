source_set("platform_runtime") {
  public = [ "platform_runtime_service_impl.h" ]
  sources = [ "platform_runtime_service_impl.cc" ]

  public_deps = [
    "//base",
    "//chrome/common/request_header_integrity:mojom",
    "//mojo/public/cpp/bindings",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "platform_runtime_service_impl_unittest.cc" ]

  deps = [
    ":platform_runtime",
    "//base/test:test_support",
    "//testing/gtest",
  ]

  data_deps = [ ":platform_runtime_test_lib" ]
}

if (is_mac) {
  _target_type = "shared_library"
} else {
  _target_type = "loadable_module"
}

target(_target_type, "platform_runtime_test_lib") {
  testonly = true
  sources = [ "platform_runtime_test_lib.cc" ]
  deps = [ "//base:compiler_specific" ]
}
