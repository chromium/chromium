import("//media/media_options.gni")

# This service only exists to serve media remoting redirection.
assert(enable_media_remoting_redirection)

source_set("redirection_service") {
  sources = [
    "redirection_remoting_sender.cc",
    "redirection_remoting_sender.h",
    "redirection_rpc_dispatcher.cc",
    "redirection_rpc_dispatcher.h",
    "redirection_service.cc",
    "redirection_service.h",
  ]

  public_deps = [ "//base" ]

  deps = [
    "//chrome/services/redirection/public/mojom",
    "//components/mirroring/service:mirroring_service",
    "//media",
    "//media/cast/openscreen:decoder_buffer_reader",
    "//media/mojo/mojom:remoting",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//third_party/microsoft_multimedia_redirection:mmr",
    "//third_party/openscreen/src/cast/streaming:remoting_proto",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "fake_mmr_objects.cc",
    "fake_mmr_objects.h",
    "redirection_remoting_sender_unittest.cc",
    "redirection_rpc_dispatcher_unittest.cc",
  ]

  deps = [
    ":redirection_service",
    "//base",
    "//base/test:test_support",
    "//media",
    "//media/mojo/common",
    "//media/mojo/mojom:remoting",
    "//mojo/public/cpp/system",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/microsoft_multimedia_redirection:mmr",
    "//third_party/openscreen/src/cast/streaming:remoting_proto",
  ]
}
