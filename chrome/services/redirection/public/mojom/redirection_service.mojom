module redirection.mojom;

import "media/mojo/mojom/remoting_common.mojom";
import "sandbox/policy/mojom/context.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// Control interface for the redirection session backing a single remoting
// source. The session in the utility process lives as long as this pipe is
// open; closing the pipe tears it down.
interface RedirectionSessionHost {
};

// This interface is used to discover and control a Multimedia Redirection (MMR)
// session, which redirects remoted video playback to a platform-provided
// redirection sink.
[ServiceSandbox=sandbox.mojom.Sandbox.kService]
interface RedirectionService {
  // Starts the redirection service and returns the metadata describing the
  // redirection sink it exposes.
  [AllowedContext=sandbox.mojom.Context.kBrowser]
  Start() => (media.mojom.RemotingSinkMetadata sink_metadata);
};
