group("browser_actuator") {
  public_deps = [ ":factory" ]
}

source_set("factory") {
  sources = [
    "browser_actuator_service_factory.cc",
    "browser_actuator_service_factory.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/stream_transport",
    "//chrome/browser/sync:factories",
    "//components/browser_actuator/internal",
    "//components/browser_actuator/internal:transport_handler",
    "//components/browser_actuator/public",
    "//components/keyed_service/core",
    "//components/stream_transport/public",
    "//components/stream_transport/public:service",
    "//components/sync_device_info",
    "//content/public/browser",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "browser_actuator_service_factory_unittest.cc" ]

  deps = [
    ":browser_actuator",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/stream_transport",
    "//chrome/browser/sync:factories",
    "//chrome/test:test_support",
    "//components/browser_actuator/internal/proto:task_ingress_proto",
    "//components/browser_actuator/public",
    "//components/browser_actuator/public/proto:auto_password_change_proto",
    "//components/keyed_service/core",
    "//components/stream_transport/public",
    "//components/stream_transport/public:service",
    "//components/sync_device_info",
    "//components/sync_device_info:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/protobuf:protobuf_lite",
  ]
}
