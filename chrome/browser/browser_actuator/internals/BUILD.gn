import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "browser_actuator_internals.mojom" ]
  webui_module_path = "/"
  public_deps = [ "//mojo/public/mojom/base" ]

  cpp_typemaps = [
    {
      types = [
        {
          mojom = "browser_actuator_internals.mojom.RecordedEvent"
          cpp = "::browser_actuator::transport::SessionEventSnapshot"
        },
        {
          mojom = "browser_actuator_internals.mojom.SessionSummary"
          cpp = "::browser_actuator::transport::SessionSnapshot"
        },
      ]
      traits_headers = [ "browser_actuator_internals_mojom_traits.h" ]
      traits_sources = [ "browser_actuator_internals_mojom_traits.cc" ]
      traits_public_deps = [
        "//base",
        "//components/browser_actuator/internal/transport:session_stream_recorder",
        "//mojo/public/cpp/base",
      ]
    },
  ]
}

source_set("internals") {
  sources = [
    "browser_actuator_internals_ui.cc",
    "browser_actuator_internals_ui_mojo_impl.cc",
    "browser_actuator_internals_ui_mojo_impl.h",
  ]
  public = [ "browser_actuator_internals_ui.h" ]
  friend = [ ":unit_tests" ]
  public_deps = [
    ":mojo_bindings",
    "//content/public/browser",
    "//ui/webui",
  ]
  deps = [
    "//base",
    "//chrome/browser/browser_actuator/transport",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/browser_actuator_internals:resources",
    "//components/browser_actuator/internal/transport:session_stream_recorder",
    "//components/browser_actuator/public:feature_list",
    "//components/browser_actuator/public/transport:service",
    "//content/public/common",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "browser_actuator_internals_mojom_traits_unittest.cc",
    "browser_actuator_internals_ui_mojo_impl_unittest.cc",
  ]
  deps = [
    ":internals",
    ":mojo_bindings",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/browser_actuator/transport",
    "//chrome/test:test_support",
    "//components/browser_actuator/internal/transport:session_stream_recorder",
    "//components/browser_actuator/internal/transport/proto",
    "//components/browser_actuator/public:feature_list",
    "//components/browser_actuator/public/transport",
    "//components/browser_actuator/public/transport:service",
    "//content/test:test_support",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/test_support:test_utils",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "browser_actuator_internals_ui_browsertest.cc" ]
    deps = [
      ":internals",
      "//base/test:test_support",
      "//chrome/test:test_support",
      "//components/browser_actuator/public:feature_list",
      "//components/prefs",
      "//components/webui/chrome_urls",
      "//content/public/browser",
      "//content/test:test_support",
      "//mojo/public/cpp/bindings",
      "//testing/gtest",
      "//url",
    ]
  }
}
