assert(is_mac)

# Header-only. Names shared by the co-location proof, the profile registry and
# the local-actuation Mach service.
source_set("names") {
  sources = [ "local_actuation_names.h" ]

  public_deps = [ "//chrome/common:version_header" ]
}

# Computes the launchd bootstrap name of the local-actuation Mach service. A
# separate target lets `profile_registry` use the name without depending on
# the Mach server.
source_set("service_name") {
  sources = [
    "local_actuation_service_name.h",
    "local_actuation_service_name.mm",
  ]

  deps = [
    "//base",
    "//crypto",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "local_actuation_service_name_unittest.cc" ]

  deps = [
    ":service_name",
    "//base",
    "//testing/gtest",
  ]
}
