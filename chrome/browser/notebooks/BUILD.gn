group("notebooks") {
  public_deps = [ ":factory" ]
}

source_set("factory") {
  sources = [
    "notebooks_service_factory.cc",
    "notebooks_service_factory.h",
  ]

  public_deps = [ "//chrome/browser/profiles:profile" ]

  deps = [
    "//base",
    "//components/keyed_service/content",
    "//components/notebooks/internal",
    "//components/notebooks/public",
    "//content/public/browser",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "notebooks_service_factory_unittest.cc" ]

  deps = [
    ":notebooks",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/notebooks/public",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
