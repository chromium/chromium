import("//build/config/android/rules.gni")
import("//chrome/android/features/android_library_factory_tmpl.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_library_factory("factory_java") {
  deps = [ "//components/browser_ui/settings/android:java" ]

  sources = [ "android/java/src/org/chromium/chrome/browser/settings/SettingsNavigationFactory.java" ]
}

android_library("search_java") {
  srcjar_deps = [ ":jni_headers" ]
  sources = [
    "search/java/src/org/chromium/chrome/browser/settings/search/ChromeBaseSearchIndexProvider.java",
    "search/java/src/org/chromium/chrome/browser/settings/search/ChromeSearchIndexProvider.java",
    "search/java/src/org/chromium/chrome/browser/settings/search/RecentSearchQueue.java",
  ]

  deps = [
    "//base:base_java",
    "//base:base_shared_preferences_java",
    "//chrome/browser/flags:java",
    "//chrome/browser/preferences:java",
    "//chrome/browser/profiles/android:java",
    "//components/browser_ui/settings/android:java",
    "//components/cached_flags:java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_preference_preference_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

generate_jni("jni_headers") {
  sources = [ "search/java/src/org/chromium/chrome/browser/settings/search/RecentSearchQueue.java" ]
}

android_library("internal_java") {
  deps = [
    "//base:resetters_java",

    # Exception: depends on :chrome_java for SettingsNavigationImpl.
    "//chrome/android:chrome_java",
    "//components/browser_ui/settings/android:java",
  ]

  sources = [ "android/java/src/org/chromium/chrome/browser/settings/SettingsNavigationFactory.java" ]
}

# Avoid circular dependencies for this small, widely-used helper class.
android_library("settings_in_tab_java") {
  sources = [
    "android/java/src/org/chromium/chrome/browser/settings/SettingsInTab.java",
  ]
  deps = [
    "//base:base_java",
    "//chrome/browser/flags:java",
    "//ui/android:ui_no_recycler_view_java",
  ]
}

android_library("java") {
  sources = [
    "android/java/src/org/chromium/chrome/browser/settings/ActivityUtil.java",
    "android/java/src/org/chromium/chrome/browser/settings/ChromeBaseSettingsFragment.java",
    "android/java/src/org/chromium/chrome/browser/settings/ChromeManagedPreferenceDelegate.java",
    "android/java/src/org/chromium/chrome/browser/settings/FaviconLoader.java",
    "android/java/src/org/chromium/chrome/browser/settings/ProfileDependentSetting.java",
    "android/java/src/org/chromium/chrome/browser/settings/SettingsActivityInterface.java",
    "android/java/src/org/chromium/chrome/browser/settings/SettingsPage.java",
  ]
  public_deps = [
    ":factory_java",
    ":search_java",
  ]
  deps = [
    ":settings_in_tab_java",
    "//base:base_java",
    "//chrome/android:chrome_app_java_resources",
    "//chrome/browser/feedback/android:factory_java",
    "//chrome/browser/feedback/android:java",
    "//chrome/browser/flags:java",
    "//chrome/browser/preferences:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/ui/android/favicon:java",
    "//chrome/browser/ui/android/native_page:java",
    "//components/browser_ui/settings/android:java",
    "//components/browser_ui/settings/android:managed_prefs_java_resources",
    "//components/browser_ui/styles/android:java",
    "//components/browser_ui/widget/android:java",
    "//components/embedder_support/android:util_java",
    "//components/favicon/android:java",
    "//components/prefs/android:java",
    "//components/user_prefs/android:java",
    "//content/public/android:content_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_constraintlayout_constraintlayout_java",
    "//third_party/androidx:androidx_fragment_fragment_java",
    "//third_party/androidx:androidx_preference_preference_java",
    "//ui/android:ui_no_recycler_view_java",
    "//url:gurl_java",
  ]
  resources_package = "org.chromium.chrome.browser.settings"
}

android_library("test_support_java") {
  testonly = true

  sources = [
    "android/java/src/org/chromium/chrome/browser/settings/SettingsActivityTestRule.java",
    "android/java/src/org/chromium/chrome/browser/settings/SettingsInTabTestActivity.java",
    "android/java/src/org/chromium/chrome/browser/settings/SettingsTestRule.java",
  ]

  deps = [
    ":settings_in_tab_java",
    "//base:base_java",
    "//base:base_java_test_support",
    "//chrome/android:chrome_java",
    "//chrome/browser/android/lifecycle:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/settings:java",
    "//chrome/browser/tab:java",
    "//chrome/browser/ui/messages/android:java",
    "//chrome/test/android:chrome_java_test_support_common",
    "//components/browser_ui/bottomsheet/android:factory_java",
    "//components/browser_ui/bottomsheet/android:java",
    "//components/browser_ui/bottomsheet/android:manager_java",
    "//components/browser_ui/desktop_windowing/android:java",
    "//components/browser_ui/modaldialog/android:java",
    "//components/browser_ui/settings/android:java",
    "//components/browser_ui/widget/android:java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_fragment_fragment_java",
    "//third_party/androidx:androidx_test_core_java",
    "//third_party/androidx:androidx_test_monitor_java",
    "//third_party/junit",
    "//ui/android:ui_java",
    "//ui/android:ui_no_recycler_view_java",
  ]
}

android_library("junit_test_support") {
  testonly = true
  sources = [
    "android/java/src/org/chromium/chrome/browser/settings/TestEmbeddableFragment.java",
    "android/java/src/org/chromium/chrome/browser/settings/TestStandaloneFragment.java",
  ]
  deps = [
    ":junit_test_resources",
    "//base:base_java",
    "//base:base_java_test_support",
    "//components/browser_ui/settings/android:java",
    "//components/browser_ui/widget/android:java",
    "//third_party/androidx:androidx_annotation_annotation_jvm_java",
    "//third_party/androidx:androidx_fragment_fragment_java",
    "//third_party/androidx:androidx_preference_preference_java",
  ]
  resources_package = "org.chromium.chrome.browser.settings"
}

android_resources("junit_test_resources") {
  testonly = true
  sources = [ "android/java/res/xml/test_settings_fragment.xml" ]
}
