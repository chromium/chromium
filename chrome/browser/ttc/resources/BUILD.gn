import("//build/config/chrome_build.gni")
import("//chrome/browser/ttc/core/buildflags.gni")
import("//ui/webui/resources/tools/build_webui.gni")

assert(enable_ttc_webui)

build_webui("build") {
  grd_prefix = "ai_overlay_dialog_untrusted"

  static_files = [
    "ai_overlay_dialog.html",
    "eval/eval.html",
    "notes/notes.html",
  ]

  css_files = [
    "app.css",
    "notes/app.css",
  ]

  web_component_files = [ "app.ts" ]

  ts_files = [
    "audio_capturer.ts",
    "audio_player.ts",
    "audio_processor.ts",
    "audio_utils.ts",
    "caption_block_manager.ts",
    "eval/eval_app.ts",
    "journal.ts",
    "local_speech_recognition.ts",
    "logging.ts",
    "notes/app.html.ts",
    "notes/app.ts",
    "notes/browser_proxy.ts",
    "page_context_manager.ts",
  ]

  if (is_chrome_branded) {
    preprocessor_defines = [ "enable_ttc_built_in_key=true" ]
    ts_files += [
      "internal/api_session.ts",
      "internal/conversation.ts",
      "internal/page_context_verbalizer.ts",
      "internal/persona.ts",
      "internal/test_api.ts",
      "internal/tools/tool_executor.ts",
    ]
  }

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps = [
    "//chrome/browser/ttc/core:mojo_bindings_ts__generator",
    "//chrome/browser/ui/webui/ai_overlay_dialog:mojo_bindings_ts__generator",
    "//chrome/browser/ui/webui/ai_overlay_dialog/tools:generate_tool_definitions",
    "//chrome/browser/ui/webui/ai_overlay_dialog/tools:mojo_bindings_ts__generator",
    "//third_party/blink/public/mojom:dom_node_id_ts__generator",
  ]
  mojo_files = [
    "$root_gen_dir/chrome/browser/ttc/core/eval_harness.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/ui/webui/ai_overlay_dialog/ai_overlay_dialog.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/ui/webui/ai_overlay_dialog/tools/generated_tool_definitions.ts",
    "$root_gen_dir/chrome/browser/ui/webui/ai_overlay_dialog/tools/tools.mojom-webui.ts",
    "$root_gen_dir/third_party/blink/public/mojom/dom/dom_node_id.mojom-webui.ts",
  ]

  ts_composite = true

  webui_context_type = "untrusted"
}
