  sources = [
    "java/src/org/chromium/chrome/browser/ttc/settings/TtcSettings.java",
    "java/src/org/chromium/chrome/browser/ttc/settings/TtcSettingsUtils.java",
  ]
  deps = [
    ":java",
    ":java_resources",
    "//base:base_java",
    "//base:supplier_java",
    "//build/android:build_java",
    "//chrome/browser/preferences:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/settings:java",
    "//chrome/browser/settings:search_java",
    "//chrome/browser/ui/android/strings:ui_strings_grd",
    "//chrome/browser/ui/android/toolbar:adaptive_features_java",
    "//chrome/browser/ui/android/toolbar:optional_button_java",
    "//components/browser_ui/settings/android:java",
    "//components/prefs/android:java",
    "//components/user_prefs/android:java",
    "//content/public/android:content_full_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_preference_preference_java",
  ]
  resources_package = "org.chromium.chrome.browser.ttc"
}

