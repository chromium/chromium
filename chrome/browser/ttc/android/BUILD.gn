# The TTC toolbar button's state, shared with the toolbar. Its own target so
# that the toolbar doesn't depend on the rest of the TTC session UI.
android_library("entry_point_java") {
  sources = [ "java/src/org/chromium/chrome/browser/ttc/TtcEntryPoint.java" ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//ui/android:ui_no_recycler_view_java",
  ]
}

android_resources("java_resources") {
  sources = [
    "java/res/drawable/ttc_session_pill_background.xml",
    "java/res/drawable/ttc_voice_plate_pause_background.xml",
    "java/res/layout/ttc_session_pill.xml",
    "java/res/layout/ttc_voice_plate.xml",
    "java/res/values/dimens.xml",
    "java/res/xml/ttc_settings.xml",
  ]
  deps = [
    "//chrome/app:java_strings_grd",
    "//chrome/browser/ui/android/strings:ui_strings_grd",
    "//components/browser_ui/strings/android:browser_ui_strings_grd",
    "//components/browser_ui/styles/android:java_resources",
    "//components/browser_ui/widget/android:java_resources",
  ]
}

# The TTC settings page. Separate from :java so that the session UI, and the
# toolbar that depends on it, don't depend on settings.
