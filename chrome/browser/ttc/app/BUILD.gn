# The headers in public are the only ones that should be accessible from
# core. This is enforced via DEPS.
source_set("public") {
  public = [
    "public/conversation.h",
    "public/make_conversation.h",
  ]
  public_deps = [
    "//base",
    "//components/actor/public/mojom:mojo_bindings",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/ttc/app/public",
    "//url",
  ]
}

source_set("app") {
  public = [ "audio_controller.h" ]
  public_deps = [
    ":public",
    "//base",
    "//chrome/browser/optimization_guide",
    "//components/optimization_guide/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/ttc/app",
    "//components/ttc/app/public",
    "//media",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "audio_controller.cc",
    "conversation_impl.cc",
    "conversation_impl.h",
    "make_conversation.cc",
  ]
  public_deps = [ "//components/ttc/app:impl" ]
  deps = [
    ":app",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ttc/core",
    "//components/ttc/app",
    "//components/ttc/app/public",
    "//content/public/browser",
    "//services/audio/public/cpp",
  ]
}

source_set("test_support") {
  testonly = true
  public_deps = [ "//components/ttc/app:test_support" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "audio_controller_unittest.cc",
    "conversation_impl_unittest.cc",
  ]
  deps = [
    ":app",
    ":impl",
    ":test_support",
    "//base/test:test_support",
    "//chrome/browser/optimization_guide:test_support",
    "//chrome/browser/ttc/core",
    "//chrome/test:test_support",
    "//components/actor/core:journal",
    "//components/actor/core:task_id",
    "//components/ttc/app",
    "//components/ttc/app:test_support",
    "//components/ttc/app/public",
    "//content/test:test_support",
    "//media",
    "//media:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

if (!is_android) {
  source_set("browser_test_support") {
    testonly = true
    sources = [
      "app_browser_test_base.cc",
      "app_browser_test_base.h",
    ]
    public_deps = [
      ":app",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/optimization_guide:test_support",
      "//chrome/test:test_support",
      "//components/ttc/app",
      "//content/public/browser",
      "//media",
      "//media:test_support",
      "//media/mojo/mojom",
      "//mojo/public/cpp/bindings",
      "//testing/gmock",
      "//third_party/protobuf:protobuf_lite",
    ]
    deps = [
      ":impl",
      "//chrome/browser/optimization_guide",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ttc/core",
      "//chrome/browser/ttc/core:impl",
      "//components/keyed_service/core",
      "//components/optimization_guide/core",
      "//net:test_support",
      "//testing/gtest",
    ]
  }

  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "audio_controller_browsertest.cc",
      "protocol_browsertest.cc",
    ]
    deps = [
      ":app",
      ":browser_test_support",
      ":impl",
      "//base",
      "//chrome/browser/optimization_guide:test_support",
      "//chrome/browser/ttc/core",
      "//chrome/browser/ttc/core:impl",
      "//chrome/test:test_support",
      "//components/optimization_guide/proto:optimization_guide_proto",
      "//components/ttc/app",
      "//content/test:browsertest_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
