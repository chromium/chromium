source_set("launchpad") {
  sources = [
    "features.cc",
    "features.h",
    "launchpad_service.cc",
    "launchpad_service.h",
    "launchpad_service_factory.cc",
    "launchpad_service_factory.h",
    "launchpad_task.h",
    "tasks_store.cc",
    "tasks_store.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//url",
  ]

  deps = [
    "//chrome/browser/glic",
    "//chrome/browser/personal_context",
    "//components/personal_context/core",
    "//components/personal_context/proto:personal_context_proto",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "launchpad_service_factory_unittest.cc",
    "launchpad_service_unittest.cc",
    "tasks_store_unittest.cc",
  ]
  deps = [
    ":launchpad",
    "//base/test:test_support",
    "//chrome/browser/glic",
    "//chrome/browser/glic/test_support",
    "//chrome/browser/personal_context",
    "//chrome/browser/signin",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//chrome/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//components/personal_context/core",
    "//components/personal_context/core:test_support",
    "//components/personal_context/proto:personal_context_proto",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
