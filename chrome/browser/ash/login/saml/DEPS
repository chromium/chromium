include_rules = [
  # ChromeOS should not depend on //chrome. See //docs/chromeos/code.md for
  # details.
  "-chrome",

  # Existing dependencies within //chrome. There is an active effort to
  # refactor //chrome/browser/ash to break these dependencies; see b/332804822.
  # Whenever possible, avoid adding new //chrome dependencies to this list.
  #
  # Files residing in certain directories (e.g., //chrome/browser) are listed
  # individually. Other dependencies within //chrome are listed on a per-
  # directory basis. See //tools/chromeos/gen_deps.sh for details.
  "+chrome/browser/ash/attestation",
  "+chrome/browser/ash/certificate_provider",
  "+chrome/browser/ash/floating_sso",
  "+chrome/browser/ash/login",
  "+chrome/browser/ash/net",
  "+chrome/browser/ash/policy/affiliation",
  "+chrome/browser/ash/policy/core",
  "+chrome/browser/ash/profiles",
  "+chrome/browser/ash/settings",
  "+chrome/browser/profiles",
  "+chrome/browser/ui/ash/login",
  "+chrome/browser/ui/webui/ash/in_session_password_change",
  "+chrome/browser/ui/webui/ash/lock_screen_reauth",
  "+chrome/browser/ui/webui/ash/login",
  "+chrome/common/chrome_paths.h",
  "+chrome/test/base",
]

specific_include_rules = {
  # Only tests need these //chrome dependencies.
  "saml_browsertest\\.cc": [
    "+chrome/browser/content_settings",
  ],
  # Only tests need //chrome/browser/policy.
  "security_token_saml_test\\.(cc|h)": [
    "+chrome/browser/policy/extension_force_install_mixin.h",
  ],
  "(lockscreen_reauth_dialog_test_helper\\.cc|saml_browsertest\\.cc)": [
    "+chrome/browser/ui/webui/signin",
  ],
  "password_sync_token_verifier_factory\\.cc": [
    "+chrome/browser/browser_process.h",
  ],
  ".*test\\.cc": [
    "+chrome/browser/browser_process.h",
  ],
  # The keyed service factories inject the IdentityManager into the services
  # they build, and must DependsOn() IdentityManagerFactory so it outlives
  # them. Tests construct those services directly and resolve the
  # IdentityManager the same way production does.
  "(password_sync_token_verifier_factory|.*unittest|.*browsertest)\\.cc": [
    "+chrome/browser/signin",
  ],
}
