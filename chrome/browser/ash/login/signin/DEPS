include_rules = [
  # ChromeOS should not depend on //chrome. See //docs/chromeos/code.md for
  # details.
  "-chrome",

  # Existing dependencies within //chrome. There is an active effort to
  # refactor //chrome/browser/ash to break these dependencies; see b/332804822.
  # Whenever possible, avoid adding new //chrome dependencies to this list.
  #
  # Files residing in certain directories (e.g., //chrome/browser) are listed
  # individually. Other dependencies within //chrome are listed on a per-
  # directory basis. See //tools/chromeos/gen_deps.sh for details.
  "+chrome/browser/ash/account_manager",
  "+chrome/browser/ash/login",
  "+chrome/browser/ash/profiles",
  "+chrome/browser/browser_process.h",
  "+chrome/browser/extensions/scoped_test_mv2_enabler.h",
  "+chrome/browser/profiles",
  "+chrome/browser/sync",
  "+chrome/browser/ui/ash/login",
  "+chrome/browser/ui/ash/multi_user",
  "+chrome/browser/ui/scoped_tabbed_browser_displayer.h",
  "+chrome/browser/ui/webui/ash/login",
  "+chrome/browser/ui/webui/signin/ash",
  "+chrome/common/chrome_paths.h",
  "+chrome/grit",
]

specific_include_rules = {
  # The keyed-service factories are the //chrome seam: they DependsOn() the
  # Profile-keyed //chrome factories and pass the resulting //components
  # objects (signin::IdentityManager, AccountReconcilor,
  # SigninErrorController) into the ash classes they build.
  "(auth_error_observer|oauth2_login_manager|signin_error_notifier|token_handle_service)_factory\\.cc": [
    "+chrome/browser/signin",
  ],

  # TODO(crbug.com/387248794): LegacyTokenHandleFetcher's shutdown-notifier
  # factory lives in this same file, so the factory dependency cannot be
  # injected away from it.
  "legacy_token_handle_fetcher\\.cc": [
    "+chrome/browser/signin/identity_manager_factory.h",
  ],

  # AccountReconcilor is looked up lazily on purpose: injecting it from the
  # factory would create it -- and start a reconcile cycle -- as soon as
  # OAuth2LoginManager is built.
  "oauth2_login_manager\\.cc": [
    "+chrome/browser/signin/account_reconcilor_factory.h",
  ],

  ".*(unittest|browsertest)\\.cc": [
    "+chrome/browser/signin",
  ],

  # The keyed-service factory is the //chrome seam: it DependsOn() the
  # Profile-keyed SupervisedUserServiceFactory and passes the resulting
  # supervised_user::SupervisedUserService (//components) into
  # SigninErrorNotifier. The unit test drives the same factory to set the
  # service up.
  "signin_error_notifier_(factory|unittest)\\.cc": [
    "+chrome/browser/supervised_user",
  ],

  "oauth2_browsertest\\.cc": [
    "+chrome/browser/lifetime/termination_notification.h",
  ],
}
