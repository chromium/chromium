  "+chrome/browser/web_applications/web_app_install_info.h",
  "+chrome/common/chrome_constants.h",
  "+chrome/common/chrome_paths.h",
  "+chrome/common/extensions",
  "+chrome/test/base",

  # Dependencies outside of //chrome:
  "+components/app_icon_loader",
]

specific_include_rules = {
  "app_service_app_item_browsertest\\.cc": [
    "+ash/app_list/app_list_controller_impl.h",
    "+ash/app_list/app_list_model_provider.h",
    "+ash/shell.h",
  ],

  ".*unittest\\.cc": [
    "+chrome/browser/global_features.h",
  ],

  ".*browsertest\\.cc": [
    "+chrome/browser/browser_process.h",
  ],

  "app_list_sort_browsertest\\.cc": [
    "+ash/app_list/app_list_model_provider.h",
    "+ash/app_list/views/app_list_item_view.h",
    "+ash/app_list/views/apps_grid_view.h",
    "+ash/shell.h",
  ],

  "app_list_syncable_service_unittest\\.cc": [
    "+cc/base/math_util.h",
    "+chrome/browser/ui/settings_window_manager_chromeos.h",
  ],

  "app_list_client_impl\\.cc": [
    "+chrome/grit",
  ],

  # Tests still need to install TemplateURLService through the //chrome-side
  # Profile-keyed factory because ChromeAutocompleteProviderClient (constructed
  # inside OmniboxProvider) calls TemplateURLServiceFactory::GetForProfile()
  # unconditionally. Production code reaches the service through the
  # //chromeos/ash/components/search_engines interface.
  "app_list_client_impl_browsertest\\.cc": [
    "+chrome/browser/search_engines",
    "+chrome/browser/ui/browser_window.h",
    "+chrome/browser/ui/settings_window_manager_chromeos.h",
    "+ui/message_center/test/message_center_waiter.h",
  ],
}
