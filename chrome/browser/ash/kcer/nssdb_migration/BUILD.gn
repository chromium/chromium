assert(is_chromeos)

static_library("nssdb_migration") {
  sources = [
    "pkcs12_migrator.cc",
    "pkcs12_migrator.h",
  ]

  deps = [
    "//ash/constants",
    "//base",
    "//chrome/browser/ash/profiles",
    "//chrome/browser/net",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//chromeos/ash/components/browser_context_helper",
    "//chromeos/ash/components/kcer",
    "//chromeos/ash/components/network",
    "//chromeos/ash/components/tpm",
    "//chromeos/constants",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/user_manager",
    "//content/public/browser",
    "//crypto",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "pkcs12_migrator_unittest.cc" ]

  deps = [
    ":nssdb_migration",
    "//ash/constants",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ash/kcer",
    "//chrome/browser/ash/login/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//chromeos/ash/components/browser_context_helper",
    "//chromeos/ash/components/kcer",
    "//chromeos/ash/components/kcer:test_support",
    "//chromeos/constants",
    "//components/account_id:test_support",
    "//components/prefs",
    "//components/session_manager/test:test_support",
    "//components/sync_preferences",
    "//google_apis",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
