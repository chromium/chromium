assert(is_chromeos)

static_library("wallpaper_handlers") {
  sources = [
    "google_photos_wallpaper_handlers.cc",
    "google_photos_wallpaper_handlers.h",
    "wallpaper_fetcher_delegate.cc",
    "wallpaper_fetcher_delegate.h",
    "wallpaper_handlers.cc",
    "wallpaper_handlers.h",
    "wallpaper_prefs.cc",
    "wallpaper_prefs.h",
  ]

  deps = [
    "//ash",
    "//ash/webui/personalization_app/mojom",
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles",
    "//chromeos/ash/components/signin:identity_manager_provider",
    "//components/application_locale_storage",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]
}

static_library("test_support") {
  testonly = true

  sources = [
    "fake_wallpaper_handlers.cc",
    "fake_wallpaper_handlers.h",
    "mock_google_photos_wallpaper_handlers.cc",
    "mock_google_photos_wallpaper_handlers.h",
    "test_wallpaper_fetcher_delegate.cc",
    "test_wallpaper_fetcher_delegate.h",
  ]

  deps = [
    ":wallpaper_handlers",
    "//ash",
    "//ash/webui/personalization_app/mojom",
    "//chrome/browser/profiles",
    "//testing/gmock",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "google_photos_wallpaper_handlers_unittest.cc" ]

  deps = [
    ":wallpaper_handlers",
    "//ash:test_support",
    "//ash/webui/personalization_app/mojom",
    "//base/test:test_support",
    "//chrome/browser:global_features",
    "//chrome/browser/ash/login/test:test_support",
    "//chrome/browser/ash/settings:test_support",
    "//chrome/browser/signin",
    "//chrome/test:test_support",
    "//chrome/test:test_support_unit",
    "//chrome/test/base:testing_browser_process",
    "//chromeos/ash/components/browser_context_helper",
    "//chromeos/ash/components/signin:test_support",
    "//components/account_id:test_support",
    "//components/session_manager/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
  ]
}
