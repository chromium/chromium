source_set("device_signals_consent") {
  public = [ "consent_dialog_coordinator.h" ]
  public_deps = [
    "//base",
    "//components/prefs",
  ]
}

source_set("impl") {
  sources = [ "consent_dialog_coordinator.cc" ]
  public_deps = [ ":device_signals_consent" ]
  deps = [
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser:browser_features",
    "//chrome/browser/enterprise/browser_management:management_identity",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:managed_ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/dialogs:browser_dialogs",
    "//chrome/browser/ui/views:layout_provider",
    "//components/device_signals/core/browser",
    "//components/prefs",
    "//components/vector_icons",
    "//ui/base",
    "//ui/base/mojom",
    "//ui/views",
  ]
  if (!is_chromeos) {
    deps += [ "//chrome/browser/ui/profiles" ]
  }
}
