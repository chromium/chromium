import("//ui/webui/webui_features.gni")

assert(enable_webui_ntp)
assert(!is_android)

# Separate from //chrome/browser/ui/views/side_panel to avoid a cycle:
# //chrome/browser/ui/side_panel:side_panel_views_dependent ->
# //chrome/browser/ui/views/side_panel:side_panel ->
# //chrome/browser/ui/customize_chrome ->
# //chrome/browser/ui/side_panel:side_panel_views_dependent
#
# - views/side_panel (if it contained these files) would depend on customize_chrome
#   (base target containing SidePanelController).
# - customize_chrome must depend on side_panel_views_dependent (uses SidePanelEntry).
source_set("customize_chrome") {
  sources = [
    "customize_chrome_utils.cc",
    "customize_chrome_utils.h",
    "side_panel_controller_views.cc",
    "side_panel_controller_views.h",
  ]
  public_deps = [ "//chrome/browser/ui/customize_chrome:customize_chrome_base" ]
  deps = [
    "//chrome/browser/extensions",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/side_panel:side_panel_views_dependent",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/side_panel",
    "//chrome/browser/ui/webui/new_tab_page",
    "//chrome/browser/ui/webui/side_panel/customize_chrome:customize_chrome_ui",
    "//ui/views",
  ]
}
