import("//build/config/ui.gni")

assert(toolkit_views)

source_set("installer_base") {
  public = [
    "callback_delayer.h",
    "isolated_web_app_installer_model.h",
    "isolated_web_app_installer_view.h",
    "uninstall_sub_app_identity_view.h",
  ]

  sources = [
    "callback_delayer.cc",
    "isolated_web_app_installer_model.cc",
    "isolated_web_app_installer_view.cc",
    "uninstall_sub_app_identity_view.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/web_applications",
    "//components/webapps/isolated_web_apps",
    "//ui/base",
    "//ui/views",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/web_apps",
    "//chrome/browser/ui/web_applications",
    "//skia",
    "//ui/gfx",
    "//url",
  ]
}

source_set("user_installability_checker") {
  public = [ "isolated_web_app_user_installability_checker.h" ]
  sources = [ "isolated_web_app_user_installability_checker.cc" ]
  public_deps = [
    "//base",
    "//chrome/browser/web_applications",
    "//components/webapps/isolated_web_apps",
  ]
  deps = [ "//chrome/browser/profiles:profile" ]
}

if (is_chromeos) {
  source_set("multi_capture_notification_details_view") {
    public = [ "multi_capture_notification_details_view.h" ]
    sources = [ "multi_capture_notification_details_view.cc" ]
    public_deps = [
      "//base",
      "//ui/gfx",
      "//ui/views",
    ]
    deps = [
      "//chrome/app:generated_resources",
      "//chrome/app/vector_icons",
      "//components/vector_icons",
      "//ui/base",
      "//ui/color",
    ]
  }
}
