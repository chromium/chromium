import("//build/config/ui.gni")

if (toolkit_views) {
  source_set("system_app_accessible_name") {
    public = [ "system_app_accessible_name.h" ]
    sources = [ "system_app_accessible_name.cc" ]
    public_deps = [
      "//ui/base",
      "//ui/views",
    ]
    deps = [
      "//chrome/browser/ui/views:layout_provider",
      "//skia",
      "//ui/accessibility",
    ]
  }

  source_set("web_app_frame_toolbar_utils") {
    public = [ "web_app_frame_toolbar_utils.h" ]
    sources = [ "web_app_frame_toolbar_utils.cc" ]
    public_deps = [
      "//build:buildflag_header_h",
      "//ui/views",
    ]
    deps = [
      "//chrome/browser/ui/views/frame:toolbar_button_provider",
      "//chrome/browser/ui/views/toolbar",
    ]
  }

  source_set("web_app_content_settings_container") {
    public = [ "web_app_content_settings_container.h" ]
    sources = [ "web_app_content_settings_container.cc" ]
    public_deps = [
      "//base",
      "//chrome/browser/ui/views/location_bar",
      "//chrome/browser/ui/views/location_bar:icon_label_bubble",
      "//skia",
      "//ui/base/metadata",
      "//ui/views",
    ]
    deps = [
      "//chrome/browser/ui/browser_window",
      "//ui/base",
      "//ui/compositor",
    ]
  }

  source_set("test_support") {
    testonly = true

    sources = [
      "web_app_frame_toolbar_test_helper.cc",
      "web_app_frame_toolbar_test_helper.h",
    ]

    public_deps = [
      "//base",
      "//components/webapps/common",
      "//content/public/browser",
    ]

    deps = [
      "//base/test:test_support",
      "//chrome/browser/ui/web_applications:launch_utils",
      "//chrome/browser/web_applications",
      "//chrome/browser/web_applications:web_applications_test_support",
      "//chrome/browser/web_applications/isolated_web_apps:isolated_web_apps_no_pwa_core_deps",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/permissions",
      "//content/test:test_support",
      "//net:test_support",
      "//ui/base",
      "//ui/views",
    ]
  }
}
