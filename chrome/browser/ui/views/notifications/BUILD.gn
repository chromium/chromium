import("//build/config/ui.gni")

# request_pin_view_chromeos is only built on ChromeOS.
assert(is_chromeos)

source_set("notifications") {
  public = [ "request_pin_view_chromeos.h" ]

  sources = [ "request_pin_view_chromeos.cc" ]

  public_deps = [
    "//base",
    "//chromeos/components/security_token_pin",
    "//ui/base",
    "//ui/base/metadata",
    "//ui/base/mojom",
    "//ui/views",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/browser/notifications",
    "//chrome/browser/ui/views:layout_provider",
    "//ui/events",
    "//ui/gfx",
  ]
}
