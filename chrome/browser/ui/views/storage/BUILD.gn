import("//build/config/ui.gni")

assert(toolkit_views)

source_set("storage") {
  public = [ "storage_pressure_bubble_view.h" ]

  public_deps = [
    "//base",
    "//ui/base/metadata",
    "//ui/views",
    "//url",
  ]
}

source_set("impl") {
  sources = [ "storage_pressure_bubble_view.cc" ]

  deps = [
    ":storage",
    "//chrome/app:generated_resources",
    "//chrome/browser/ui:storage_pressure_bubble",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:toolbar_button_provider",
    "//chrome/browser/ui/views/toolbar",
    "//components/url_formatter",
    "//content/public/common",
    "//ui/base",
    "//ui/base/mojom:ui_base_types",
    "//ui/views",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "storage_pressure_bubble_view_browsertest.cc" ]

  deps = [
    ":storage",
    "//chrome/browser/ui:storage_pressure_bubble",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
