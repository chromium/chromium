import("//build/config/chromeos/args.gni")
import("//build/config/ui.gni")

assert(toolkit_views)

source_set("hovercard_helpers") {
  public = [
    "fade_label_view.h",
    "fade_view.h",
    "filename_elider.h",
    "tab_hover_card_thumbnail_observer.h",
  ]

  sources = [
    "fade_label_view.cc",
    "filename_elider.cc",
    "tab_hover_card_thumbnail_observer.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/thumbnails",
    "//ui/views",
  ]

  deps = [
    "//base:i18n",
    "//chrome/browser/ui/tabs",
    "//skia",
    "//ui/base",
    "//ui/gfx",
  ]
}

source_set("hovercard") {
  public = [
    "fade_footer_view.h",
    "hover_card_anchor_target.h",
    "tab_hover_card_bubble_view.h",
    "tab_hover_card_controller.h",
  ]

  public_deps = [
    ":hovercard_helpers",
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/performance_controls",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/thumbnails",
    "//chrome/browser/ui/views:layout_provider",
    "//components/prefs",
    "//ui/base/metadata",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
  ]

  # TODO(crbug.com/451609048): Remove this circular dependency when the
  # following header gets componentized:
  # - c/b/ui/views/tabs/tab_slot_controller.h
  # (No allow_circular_includes_from entry belongs here -- the waiver that
  # makes this legal is declared on //chrome/browser/ui:ui, which is the
  # target that owns tab_slot_controller.h and depends on this target.)
}

