import("//build/config/ui.gni")

source_set("horizontal") {
  sources = [
    "horizontal_tab_strip_overflow_indicator_view.cc",
    "horizontal_tab_strip_overflow_indicator_view.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
    "//chrome/browser/ui/color:color_headers",
    "//skia",
    "//ui/base/metadata",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "horizontal_tab_strip_layout_unittest.cc" ]
  deps = [
    "//base",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/views/tabs/common:impl",
    "//testing/gtest",
  ]
}
