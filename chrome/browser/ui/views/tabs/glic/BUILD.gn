  deps = [
    ":glic",
    "//base",
    "//base/test:test_support",
    "//chrome/app:branded_strings",
    "//chrome/app:command_ids",
    "//chrome/browser/glic",
    "//chrome/browser/glic/suggestions",
    "//chrome/browser/glic/test_support",
    "//chrome/browser/private_ai",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/views/glic",
    "//chrome/browser/ui/views/interaction",
    "//chrome/browser/ui/views/tabs:tab_strip",
    "//chrome/common:chrome_features",
    "//chrome/test/base:in_process_browser_test",
    "//components/keyed_service/content",
    "//components/prefs",
    "//components/private_ai",
    "//components/private_ai:features",
    "//components/private_ai:proto",
    "//components/private_ai:testing",
    "//content/test:test_support",
    "//testing/gmock",
    "//ui/base",
    "//ui/base/mojom:ui_base_types",
    "//ui/events",
    "//ui/views",
  ]
}
