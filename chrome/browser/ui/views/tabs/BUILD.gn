  }

  # frame/browser_frame_view.h, frame/browser_view.h,
  # tabs/browser_tab_strip_controller.h, and tabs/tab_strip.h are all still
  # monolithic in ui:ui (crbug.com/353332589) and are only ever needed by
  # tab.cc, never by tab.h -- so this :tab_impl target is the one that
  # carries the real dependency and the corresponding
  # allow_circular_includes_from grant on ui:ui, not the public :tab target.
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}
