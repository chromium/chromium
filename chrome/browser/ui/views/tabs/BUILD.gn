    # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
    # enable the diagnostic by removing this line.
    configs += [ "//build/config/compiler:no_exit_time_destructors" ]

    sources = [
      "tab_group_header_interactive_uitest.cc",
      "tab_strip_interactive_uitest.cc",
    ]

    if (is_mac) {
      sources += [ "tab_modal_focus_interactive_uitest_mac.mm" ]
    }

    deps = [
      ":new_tab_button",
      ":new_tab_button_menu_model",
      ":tab",
      ":tab_group",
      ":tab_strip",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/ui",
      "//chrome/browser/ui:browser_element_identifiers",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs",
      "//chrome/browser/ui/tabs:features",
      "//chrome/browser/ui/tabs:tab_group",
      "//chrome/browser/ui/views/interaction",
      "//chrome/browser/ui/views/test:test_support",
      "//chrome/common",
      "//chrome/test/base:in_process_browser_test",
      "//chrome/test/base:interactive_test_utils",
      "//chrome/test/base:ui_test_utils",
      "//chrome/test/interaction",
      "//components/tab_groups",
      "//components/tabs:public",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/base:test_support",
      "//ui/base/interaction",
      "//ui/gfx",
      "//ui/views",
      "//ui/views/interaction:test_support",
    ]

    if (is_mac) {
      deps += [
        "//chrome/browser/ui/tabs:tabs_public",
        "//chrome/browser/ui/views/frame:contents_web_view",
        "//ui/base",
      ]
    }
  }
}
