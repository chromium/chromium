import("//extensions/buildflags/buildflags.gni")

source_set("organizer") {
  sources = [
    "layout_constants.h",
    "organizer_panel_controls_view.h",
    "organizer_panel_utils.h",
    "organizer_panel_view.h",
  ]

  public_deps = [
    "//base",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui/tabs/organizer",
    "//ui/base",
    "//ui/views",
  ]

  if (enable_extensions) {
    public_deps += [
      "//extensions/buildflags",
      "//extensions/common",
    ]
  }
}

source_set("impl") {
  sources = [
    "organizer_panel_controls_view.cc",
    "organizer_panel_utils.cc",
    "organizer_panel_view.cc",
  ]

  public_deps = [ ":organizer" ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:layout_constants",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs/organizer:impl",
    "//chrome/browser/ui/tabs/saved_tab_groups",
    "//chrome/browser/ui/views/tabs/shared",
    "//chrome/browser/ui/views/tabs/vertical",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/webui:webui_util",
    "//components/saved_tab_groups/public",
    "//ui/actions",
    "//ui/compositor_extra",
    "//ui/views/controls/webview",
    "//url",
  ]

  if (enable_extensions) {
    deps += [
      "//chrome/browser/extensions",
      "//chrome/common/extensions/api",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "organizer_panel_view_unittest.cc" ]
  deps = [
    ":organizer",
    "//base/test:test_support",
    "//build:branding_buildflags",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui:test_support",
    "//chrome/browser/ui:ui_features",
    "//chrome/test:test_support",
    "//components/omnibox/browser:test_support",
    "//components/prefs:test_support",
    "//content/test:test_support",
    "//ui/events:test_support",
    "//ui/views",
    "//ui/views:test_support",
  ]
  if (enable_extensions) {
    deps += [
      "//chrome/browser/extensions",
      "//chrome/common/extensions/api",
      "//extensions:test_support",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "organizer_panel_view_interactive_uitest.cc" ]
  deps = [
    ":organizer",
    "//chrome/browser/tab_group_sync:factories",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs/organizer",
    "//chrome/test:test_support",
    "//components/omnibox/browser:test_support",
    "//components/saved_tab_groups/public",
    "//components/saved_tab_groups/test_support",
    "//ui/base",
    "//ui/compositor_extra",
    "//ui/views",
  ]
  if (enable_extensions) {
    deps += [
      "//chrome/browser/extensions",
      "//chrome/browser/extensions:test_support",
      "//chrome/common/extensions/api",
      "//extensions:test_support",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}
