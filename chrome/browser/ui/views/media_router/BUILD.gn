import("//build/config/chromeos/args.gni")
import("//build/config/ui.gni")

assert(toolkit_views)

source_set("media_router") {
  public = [
    "cast_browser_controller.h",
    "cast_dialog_access_code_cast_button.h",
    "cast_dialog_coordinator.h",
    "cast_dialog_helper.h",
    "cast_dialog_metrics.h",
    "cast_dialog_no_sinks_view.h",
    "cast_dialog_sink_button.h",
    "cast_dialog_sink_view.h",
    "cast_dialog_view.h",
    "media_remoting_dialog_view.h",
    "media_router_dialog_controller_views.h",
    "presentation_receiver_window_frame.h",
    "presentation_receiver_window_view.h",
    "web_contents_display_observer_view.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/media",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/media_router",
    "//chrome/browser/ui/toolbar",
    "//chrome/browser/ui/toolbar/cast",
    "//chrome/browser/ui/views/controls",
    "//chrome/browser/ui/views/exclusive_access",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/webui/media_router",
    "//components/media_router/browser",
    "//components/media_router/common",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/metadata",
    "//ui/display",
    "//ui/events",
    "//ui/menus",
    "//ui/views",
  ]
}

source_set("impl") {
  sources = [
    "cast_browser_controller.cc",
    "cast_dialog_access_code_cast_button.cc",
    "cast_dialog_coordinator.cc",
    "cast_dialog_helper.cc",
    "cast_dialog_metrics.cc",
    "cast_dialog_no_sinks_view.cc",
    "cast_dialog_sink_button.cc",
    "cast_dialog_sink_view.cc",
    "cast_dialog_view.cc",
    "media_remoting_dialog_view.cc",
    "media_router_dialog_controller_views.cc",
    "presentation_receiver_window_factory.cc",
    "presentation_receiver_window_frame.cc",
    "presentation_receiver_window_view.cc",
    "web_contents_display_observer_view.cc",
  ]

  deps = [
    ":media_router",
    "//chrome/app:command_ids",
    "//chrome/app/vector_icons",
    "//chrome/browser/content_settings",
    "//chrome/browser/media/router:media_router_feature",
    "//chrome/browser/media/router/discovery/access_code:access_code_cast_feature",
    "//chrome/browser/password_manager",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/safe_browsing",
    "//chrome/browser/ssl",
    "//chrome/browser/subresource_filter",
    "//chrome/browser/translate",
    "//chrome/browser/ui:accelerator_table",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui:tab_dialogs",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/autofill",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/media_router",
    "//chrome/browser/ui/passwords",
    "//chrome/browser/ui/search",
    "//chrome/browser/ui/toolbar/cast",
    "//chrome/browser/ui/views/global_media_controls",
    "//chrome/browser/ui/webui/access_code_cast",
    "//chrome/common",
    "//components/infobars/content",
    "//components/media_router/browser",
    "//components/vector_icons",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]

  # These .cc files include headers still compiled in //chrome/browser/ui:ui:
  # views/frame/browser_view.h, views/frame/top_container_view.h and
  # tab_dialogs.h. Reach them via browser_public_dependencies; the reverse
  # edge is the allow_circular_includes_from entry on //chrome/browser/ui:ui.
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]

  if (is_mac) {
    deps += [ "//chrome/browser:global_keyboard_shortcuts_mac" ]
  }
}

source_set("test_support") {
  testonly = true

  sources = [
    "app_menu_test_api.h",
    "app_menu_test_api_views.cc",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui",
    "//chrome/browser/ui/views/toolbar",
    "//ui/views",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "cast_dialog_access_code_cast_button_unittest.cc",
    "cast_dialog_metrics_unittest.cc",
    "cast_dialog_no_sinks_view_unittest.cc",
    "cast_dialog_sink_button_unittest.cc",
    "cast_dialog_sink_view_unittest.cc",
    "cast_dialog_view_unittest.cc",
    "web_contents_display_observer_view_unittest.cc",
  ]

  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  deps = [
    ":media_router",
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser/media/router:media_router_feature",
    "//chrome/browser/media/router/discovery/access_code:access_code_cast_feature",
    "//chrome/browser/ui/media_router",
    "//chrome/browser/ui/views/controls",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/media_router/browser",
    "//components/media_router/common",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/display",
    "//ui/events",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "cast_browser_controller_browsertest.cc",
    "cast_dialog_coordinator_browsertest.cc",
    "cast_dialog_view_browsertest.cc",
    "media_router_ui_browsertest.cc",
    "presentation_receiver_window_view_browsertest.cc",
  ]

  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  deps = [
    ":media_router",
    ":test_support",
    "//chrome/browser/media/router/discovery/access_code:access_code_cast_feature",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/media_router",
    "//chrome/browser/ui/views/frame",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/media_router:test_support",
    "//components/media_router/browser",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/views",
  ]
}

if (!is_chromeos_device) {
  source_set("interactive_ui_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "media_router_dialog_controller_views_interactive_uitest.cc" ]

    # media_router_ui_interactive_uitest.cc is desktop-only; it does not build
    # on ChromeOS or Fuchsia.
    if (is_win || is_mac || is_linux) {
      sources += [ "media_router_ui_interactive_uitest.cc" ]
    }

    configs += [ "//build/config/compiler:no_exit_time_destructors" ]

    deps = [
      ":media_router",
      ":test_support",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/media_router",
      "//chrome/browser/ui/views/global_media_controls",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/media_router:test_support",
      "//content/public/browser",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/views",
    ]
  }
}
