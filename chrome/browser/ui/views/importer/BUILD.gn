import("//build/config/ui.gni")

assert(toolkit_views)

source_set("importer") {
  public = [ "import_lock_dialog_view.h" ]
  sources = [ "import_lock_dialog_view.cc" ]

  public_deps = [
    "//base",
    "//chrome/app:generated_resources",
    "//ui/base",
    "//ui/views",
  ]

  deps = [
    "//chrome/browser/importer",
    "//chrome/browser/ui/views:layout_provider",
    "//ui/base/mojom",
    "//ui/gfx",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "import_lock_dialog_view_browsertest.cc" ]
  deps = [
    ":importer",
    "//base",
    "//chrome/test:test_support",
    "//content/test:test_support",
  ]
}
