import("//build/config/ui.gni")

assert(!is_android)

source_set("shadow") {
  public = [ "shadow_frame_view.h" ]

  sources = [ "shadow_frame_view.cc" ]

  deps = [
    "//base",
    "//chrome/browser/ui/animation",
    "//chrome/browser/ui/color:color_headers",
    "//ui/compositor_extra",
    "//ui/gfx:color_utils",
    "//ui/views",
  ]
}

# immersive_mode_tester is only built on ChromeOS, matching the platforms
# where its immersive-fullscreen consumers compile it.
if (is_chromeos) {
  source_set("immersive_mode_tester") {
    testonly = true

    sources = [
      "immersive_mode_tester.cc",
      "immersive_mode_tester.h",
    ]

    public_deps = [
      "//base",
      "//base/test:test_support",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/immersive:immersive_mode_controller",
      "//testing/gtest",
      "//ui/base",
    ]

    deps = [
      "//chrome/browser/ui",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views",
    ]
  }
}

if (toolkit_views) {
  source_set("test_with_browser_view") {
    testonly = true

    sources = [
      "test_with_browser_view.cc",
      "test_with_browser_view.h",
    ]

    public_deps = [
      "//chrome/browser/media/router:media_router_feature",
      "//chrome/test:test_support",
    ]

    deps = [
      "//base",
      "//chrome/browser/autocomplete",
      "//chrome/browser/extensions",
      "//chrome/browser/search_engines",
      "//chrome/browser/signin",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views",
      "//components/omnibox/browser",
      "//components/omnibox/browser:test_support",
      "//components/signin/public/base:test_support",
      "//extensions/browser",
    ]

    if (is_chromeos) {
      deps += [
        "//chrome/browser/ash/input_method",
        "//ui/base/ime/ash",
      ]
    }
  }
}

static_library("test_support") {
  testonly = true

  sources = [
    "mock_immersive_mode_controller.cc",
    "mock_immersive_mode_controller.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/immersive:immersive_mode_controller",
    "//testing/gmock",
  ]
}

source_set("toolbar_button_provider") {
  public = [ "toolbar_button_provider.h" ]

  sources = [ "toolbar_button_provider.cc" ]

  public_deps = [
    "//chrome/browser/ui/page_action:icon_type",
    "//ui/actions:actions_headers",
    "//ui/base/unowned_user_data",
    "//ui/views",
  ]

  deps = [ "//chrome/browser/ui/browser_window" ]
}

source_set("frame") {
  sources = [
    "browser_root_view.h",
    "tab_strip_region_view.cc",
    "tab_strip_region_view.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/views",
    "//components/tab_groups",
    "//ui/base",
    "//ui/views",
  ]
}

source_set("app_menu_button_observer") {
  sources = [ "app_menu_button_observer.h" ]
}

source_set("top_controls_slide_controller") {
  sources = [ "top_controls_slide_controller.h" ]
}

source_set("glass_frame_service") {
  public = [ "glass_frame_service.h" ]
  sources = [ "glass_frame_service.cc" ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/performance_manager/public/user_tuning",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:constants",
    "//components/prefs",
    "//ui/base/unowned_user_data",
  ]
}
