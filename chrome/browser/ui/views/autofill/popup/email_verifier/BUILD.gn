assert(is_win || is_mac || is_linux || is_chromeos)

source_set("email_verifier") {
  public = [ "email_verification_popup_view_impl.h" ]
  sources = [ "email_verification_popup_view_impl.cc" ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/autofill/email_verifier",
    "//chrome/browser/ui/views/autofill/popup",
    "//ui/views",
    "//url",
  ]

  deps = [
    "//chrome/browser/ui/autofill",
    "//chrome/browser/ui/views:layout_provider",
    "//components/strings:components_strings_grit",
    "//components/url_formatter",
    "//components/vector_icons",
    "//net",
    "//skia",
    "//ui/base",
    "//ui/gfx",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "email_verification_popup_view_unittest.cc" ]

  deps = [
    ":email_verifier",
    "//chrome/test:test_support",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx:test_support",
  ]
}
