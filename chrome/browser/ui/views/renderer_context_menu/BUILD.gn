import("//build/config/ui.gni")

# RenderViewContextMenuViews is the Aura context menu (Mac uses the cocoa
# variant), and its implementation uses aura unconditionally.
assert(use_aura)

source_set("renderer_context_menu") {
  public = [ "render_view_context_menu_views.h" ]

  public_deps = [
    "//chrome/browser/renderer_context_menu",
    "//ui/base/mojom:ui_base_types",
  ]
}

source_set("impl") {
  sources = [ "render_view_context_menu_views.cc" ]

  deps = [
    ":renderer_context_menu",
    "//chrome/app:command_ids",
    "//chrome/browser/ui/views/side_panel",
    "//chrome/common:non_code_constants",
    "//components/lens:buildflags",
    "//components/lens:features",
    "//components/renderer_context_menu",
    "//content/public/browser",
    "//ui/aura",
    "//ui/base",
    "//ui/events",
    "//ui/strings",
    "//ui/views",
  ]

  # render_view_context_menu_views.cc calls
  # BrowserView::GetBrowserViewForBrowser() to expose the browser's
  # AcceleratorProvider, which is still compiled in //chrome/browser/ui:ui.
  # Reach it via browser_public_dependencies; the reverse edge is the
  # allow_circular_includes_from entry on //chrome/browser/ui:ui.
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "render_view_context_menu_views_browsertest.cc" ]

  deps = [
    ":renderer_context_menu",
    "//base",
    "//chrome/app:command_ids",
    "//chrome/browser/renderer_context_menu",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//third_party/blink/public/common:headers",
    "//url",
  ]
}
