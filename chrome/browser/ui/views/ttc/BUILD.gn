import("//build/config/ui.gni")

assert(toolkit_views)

source_set("ttc") {
  public = [
    "pointer_mark.h",
    "ttc_fre_dialog.h",
    "ttc_view.h",
    "ttc_view_delegate.h",
    "ttc_voice_plate.h",
  ]
  sources = [
    "pointer_mark.cc",
    "ttc_fre_dialog.cc",
    "ttc_voice_plate.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ttc/core:states",
    "//chrome/browser/ui/views/voice",
    "//ui/base",
    "//ui/base/interaction",
    "//ui/gfx",
    "//ui/views",
  ]

  deps = [
    "//build:branding_buildflags",
    "//chrome/app:generated_resources",
    "//chrome/app/theme:theme_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui/views:layout_provider",
    "//components/constrained_window",
    "//components/strings",
    "//components/vector_icons",
    "//ui/color",
    "//ui/compositor",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "pointer_mark_unittest.cc",
    "ttc_fre_dialog_unittest.cc",
    "ttc_voice_plate_unittest.cc",
  ]
  deps = [
    ":ttc",
    "//base",
    "//base/test:test_support",
    "//chrome/app:generated_resources",
    "//chrome/browser/ui/views/voice",
    "//chrome/test:test_support",
    "//components/constrained_window",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/accessibility",
    "//ui/base",
    "//ui/base/interaction",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
    "//ui/views:test_support",
  ]
}
