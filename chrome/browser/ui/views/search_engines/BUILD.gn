assert(!is_android)

source_set("search_engines") {
  public = [ "dse_reset_dialog.h" ]
  public_deps = [ "//components/omnibox/browser" ]
}

source_set("impl") {
  sources = [ "dse_reset_dialog.cc" ]
  public_deps = [ ":search_engines" ]
  deps = [
    "//base",
    "//chrome/app:branded_strings",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:toolbar_button_provider",
    "//chrome/browser/ui/views/toolbar",
    "//components/prefs",
    "//components/search_engines",
    "//content/public/browser",
    "//content/public/common",
    "//services/preferences/tracked",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "dse_reset_dialog_view_browsertest.cc" ]

  deps = [
    ":search_engines",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//services/preferences/tracked",
    "//testing/gtest",
  ]
}
