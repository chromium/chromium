import("//build/config/ui.gni")

assert(toolkit_views)

source_set("exclusive_access") {
  public = [
    "exclusive_access_bubble_views.h",
    "exclusive_access_bubble_views_context.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/exclusive_access",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
  ]
}

source_set("impl") {
  sources = [ "exclusive_access_bubble_views.cc" ]

  deps = [
    ":exclusive_access",
    "//chrome/app:command_ids",
    "//chrome/browser/headless",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui:url_identity",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/immersive:immersive_mode_controller",
    "//components/fullscreen_control",
    "//components/viz/common",
    "//ui/base",
    "//ui/strings:ui_strings_grit",
    "//ui/views",
  ]

  # exclusive_access_bubble_views.cc includes views/frame/top_container_view.h,
  # which is still compiled in //chrome/browser/ui:ui. Reach it via
  # browser_public_dependencies; the reverse edge is the
  # allow_circular_includes_from entry on //chrome/browser/ui:ui.
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "exclusive_access_bubble_views_browsertest.cc" ]

  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  deps = [
    ":exclusive_access",
    "//chrome/app:command_ids",
    "//chrome/browser/ui",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/views/frame",
    "//chrome/test:test_support",
    "//components/fullscreen_control",
    "//content/test:test_support",
    "//ui/base",
    "//ui/views",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "exclusive_access_bubble_views_interactive_uitest.cc" ]

  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  deps = [
    ":exclusive_access",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/exclusive_access:test_support",
    "//chrome/browser/ui/views/frame",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//ui/base:ozone_buildflags",
    "//ui/base:test_support",
    "//ui/gfx",
    "//ui/views",
  ]

  if (ozone_platform_x11 || use_ozone) {
    deps += [ "//ui/ozone" ]
  }
}
