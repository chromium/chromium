if (toolkit_views) {
  # Split out from :avatar_toolbar_button below purely so
  # //chrome/browser/ui/views/toolbar can depend on this tiny,
  # dependency-free header (needed by avatar_toolbar_button_interface.h)
  # without depending on the whole :avatar_toolbar_button target --
  # avoiding a real cycle between the two directories (:avatar_toolbar_button
  # itself needs views/toolbar's avatar_toolbar_button_interface.h and
  # toolbar_button.h).
  source_set("avatar_toolbar_button_types") {
    public = [ "avatar_toolbar_button_types.h" ]
    public_deps = [ "//components/signin/public/base:signin_buildflags" ]
  }

  source_set("avatar_toolbar_button") {
    public = [
      "avatar_toolbar_button.h",
      "avatar_toolbar_button_state_manager.h",
    ]

    public_deps = [
      ":avatar_toolbar_button_types",
      "//base",
      "//chrome/browser/profiles",
      "//chrome/browser/profiles:profile_util",
      "//chrome/browser/ui/color:color_headers",
      "//chrome/browser/ui/views/toolbar",
      "//components/signin/public/base:signin_buildflags",
      "//components/signin/public/identity_manager",
      "//components/subscription_eligibility",
      "//google_apis",
      "//ui/base",
      "//ui/gfx/geometry",
    ]
  }

  # views/profiles/profile_menu_coordinator.h is still monolithic in ui:ui
  # (crbug.com/353332589) and is only ever needed by
  # avatar_toolbar_button_state_manager.cc, never by the public headers
  # above -- so this :impl target is the one that carries the real
  # dependency and the corresponding allow_circular_includes_from grant on
  # ui:ui, not the public :avatar_toolbar_button target.
  source_set("avatar_toolbar_button_impl") {
    sources = [
      "avatar_toolbar_button.cc",
      "avatar_toolbar_button_state_manager.cc",
    ]

    deps = [
      ":avatar_toolbar_button",
      "//chrome/app/vector_icons",
      "//chrome/browser:browser_process",
      "//chrome/browser/enterprise",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/signin",
      "//chrome/browser/subscription_eligibility",
      "//chrome/browser/sync",
      "//chrome/browser/sync:factories",
      "//chrome/browser/themes",
      "//chrome/browser/ui:browser_element_identifiers",
      "//chrome/browser/ui:layout_constants",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui:view_ids",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/profiles",
      "//chrome/browser/ui/signin",
      "//chrome/browser/ui/user_education",
      "//chrome/browser/ui/views/toolbar:impl",
      "//chrome/browser/ui/web_applications",
      "//chrome/browser/user_education",
      "//chrome/browser/webauthn",
      "//chrome/common",
      "//components/feature_engagement/public:feature_constants",
      "//components/password_manager/content/common",
      "//components/policy/core/common",
      "//components/prefs",
      "//components/sync/base:features",
      "//components/sync/service",
      "//components/user_education/common",
      "//content/public/common",
      "//google_apis",
      "//skia",
      "//ui/base",
      "//ui/color",
      "//ui/compositor",
      "//ui/gfx",
      "//ui/gfx/animation",
      "//ui/native_theme",
      "//ui/views",
    ]
  }

  source_set("avatar_toolbar_button_browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "avatar_toolbar_button_browsertest.cc" ]

    configs += [ "//build/config/compiler:no_exit_time_destructors" ]

    deps = [
      ":avatar_toolbar_button",
      "//base",
      "//base/test:test_support",
      "//chrome/browser:browser_process",
      "//chrome/browser/enterprise",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/profiles:profile_manager",
      "//chrome/browser/profiles:profile_test_util",
      "//chrome/browser/profiles:profile_util",
      "//chrome/browser/profiles/batch_upload:test_support",
      "//chrome/browser/profiles/keep_alive",
      "//chrome/browser/signin",
      "//chrome/browser/signin:identity_test_support",
      "//chrome/browser/subscription_eligibility",
      "//chrome/browser/sync:factories",
      "//chrome/browser/themes",
      "//chrome/browser/ui:layout_constants",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/profiles",
      "//chrome/browser/ui/signin",
      "//chrome/browser/ui/views/toolbar",
      "//chrome/browser/ui/views/toolbar:test_support",
      "//chrome/browser/ui/waap:manager",
      "//chrome/browser/webauthn",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/user_education",
      "//components/feature_engagement/public:feature_constants",
      "//components/keep_alive_registry",
      "//components/keyed_service/content",
      "//components/policy/core/browser",
      "//components/policy/core/common",
      "//components/prefs",
      "//components/signin/public/base",
      "//components/signin/public/identity_manager",
      "//components/signin/public/identity_manager:test_support",
      "//components/subscription_eligibility",
      "//components/sync:test_support",
      "//components/sync/base:features",
      "//components/sync/service",
      "//components/user_education/common",
      "//components/user_education/views",
      "//components/user_manager",
      "//content/public/browser",
      "//content/public/common",
      "//content/test:test_support",
      "//device/fido",
      "//google_apis",
      "//skia",
      "//testing/gtest",
      "//ui/base",
      "//ui/gfx",
    ]

    if (is_chromeos) {
      deps += [ "//ash/constants" ]
    }
  }
}

