import("//build/config/ui.gni")

assert(toolkit_views)

source_set("voice") {
  public = [
    "voice_plate.h",
    "waveform_mode.h",
    "waveform_view.h",
  ]
  sources = [
    "voice_plate.cc",
    "waveform_view.cc",
  ]

  public_deps = [
    "//base",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
  ]

  deps = [
    "//chrome/browser/ui/views:layout_provider",
    "//ui/color",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "voice_plate_unittest.cc",
    "waveform_view_unittest.cc",
  ]
  deps = [
    ":voice",
    "//base",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/test:test_support",
    "//testing/gtest",
    "//ui/gfx",
    "//ui/views",
    "//ui/views:test_support",
  ]
}
