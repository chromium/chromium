# Split out from :passwords above so that only the .cc files -- not the
# public headers -- carry the real dependency on
# //chrome/browser/ui/passwords:impl (needed for
# password_generation_popup_controller.h, used by
# password_generation_popup_view_views.cc). :passwords itself never needs
# anything from ui/passwords:impl, so keeping the implementation glue here
# means the header-only target stays a clean, one-directional dependency
# with no allow_circular_includes_from waiver needed on either side --
# avoiding the circular relationship this used to require (which, via
# :passwords's own dependency on //chrome/browser/ui/autofill, sat one step
# away from a real dependency cycle through autofill/webauthn/passwords).
source_set("impl") {
  sources = [
    "account_chooser_dialog_view.cc",
    "auto_signin_first_run_dialog_view.cc",
    "credential_leak_dialog_view.cc",
    "credentials_item_view.cc",
    "manage_passwords_details_view.cc",
    "manage_passwords_list_view.cc",
    "manage_passwords_page_action_controller.cc",
    "manage_passwords_view.cc",
    "move_to_account_store_bubble_view.cc",
    "password_add_username_view.cc",
    "password_auto_sign_in_view.cc",
    "password_bubble_view_base.cc",
    "password_combined_selector_view.cc",
    "password_cross_domain_confirmation_popup_view_views.cc",
    "password_generation_popup_view_views.cc",
    "password_save_update_view.cc",
    "post_save_compromised_bubble_view.cc",
    "shared_passwords_notification_view.cc",
    "views_utils.cc",
  ]

  deps = [
    ":passwords",
    "//chrome/app/vector_icons",
    "//chrome/browser/password_manager/factories",
    "//chrome/browser/favicon",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/signin",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:layout_constants",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/hats",
    "//chrome/browser/ui/page_action",
    "//chrome/browser/ui/passwords:impl",
    "//chrome/browser/ui/signin",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/browser/ui/user_education",
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui/views/accessibility",
    "//chrome/browser/ui/views/controls",
    "//chrome/browser/ui/views/frame:toolbar_button_provider",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/page_info",
    "//chrome/browser/ui/views/passwords/password_change:successful_password_change_view",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/views/webauthn",
    "//components/password_manager/core/browser/features:password_features",
