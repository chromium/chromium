import("//build/config/ui.gni")

assert(toolkit_views)

if (!is_chromeos) {
  source_set("enterprise_startup_dialog") {
    public = [ "enterprise_startup_dialog_view.h" ]
    sources = [ "enterprise_startup_dialog_view.cc" ]
    if (is_mac) {
      public += [ "enterprise_startup_dialog_mac_util.h" ]
      sources += [ "enterprise_startup_dialog_mac_util.mm" ]
    }
    deps = [
      "//build:branding_buildflags",
      "//chrome/app:branded_strings",
      "//chrome/app/theme:theme_resources",
      "//chrome/app/vector_icons",
      "//chrome/browser/headless",
      "//chrome/browser/ui:enterprise_startup_dialog",
      "//chrome/browser/ui/views:layout_provider",
      "//components/constrained_window",
      "//ui/base",
      "//ui/gfx",
      "//ui/native_theme",
      "//ui/views",
    ]
  }

  source_set("idle_dialog") {
    public = [ "idle_dialog_view.h" ]
    sources = [ "idle_dialog_view.cc" ]
    public_deps = [
      "//base",
      "//chrome/browser/ui:idle_dialog",
      "//ui/views",
    ]
    deps = [
      "//chrome/app:branded_strings",
      "//chrome/app:generated_resources",
      "//chrome/browser/ui:idle_dialog",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/views:layout_provider",
      "//chrome/browser/ui/views/relaunch_notification",
      "//components/constrained_window",
      "//components/vector_icons",
      "//ui/base",
      "//ui/base/mojom",
      "//ui/base/mojom:ui_base_types",
      "//ui/gfx",
      "//ui/gfx/geometry",
    ]
  }

  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "enterprise_startup_dialog_view_browsertest.cc" ]

    deps = [
      ":enterprise_startup_dialog",
      "//chrome/test:test_support",
      "//content/test:test_support",
      "//testing/gtest",
    ]
  }

  source_set("unit_tests") {
    testonly = true
    sources = [ "enterprise_startup_dialog_unittest.cc" ]
    deps = [
      ":enterprise_startup_dialog",
      "//chrome/test:test_support",
      "//testing/gtest",
    ]
  }
}
