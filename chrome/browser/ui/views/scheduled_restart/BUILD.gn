import("//build/config/features.gni")

if (is_win || is_mac || is_linux) {
  source_set("scheduled_restart") {
    public = [
      "scheduled_restart_bubble_controller.h",
      "scheduled_restart_bubble_view.h",
      "scheduled_restart_hats.h",
    ]

    public_deps = [
      "//base",
      "//chrome/browser/lifetime",
      "//ui/base",
      "//ui/base/unowned_user_data",
      "//ui/views",
    ]
  }

  source_set("impl") {
    sources = [
      "scheduled_restart_bubble_controller.cc",
      "scheduled_restart_bubble_view.cc",
      "scheduled_restart_hats.cc",
    ]

    public_deps = [ ":scheduled_restart" ]

    deps = [
      "//chrome/app:branded_strings",
      "//chrome/app:generated_resources",
      "//chrome/browser:browser_process",
      "//chrome/browser:global_features",
      "//chrome/browser/lifetime",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/hats",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/toasts",
      "//chrome/browser/ui/toasts/api:toasts",
      "//chrome/browser/ui/views:layout_provider",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/browser/ui/views/frame:toolbar_button_provider",
      "//chrome/browser/ui/views/toolbar",
      "//chrome/browser/ui/webui",
      "//chrome/browser/upgrade_detector",
      "//chrome/common:channel_info",
      "//chrome/common:chrome_features",
      "//chrome/common:constants",
      "//components/prefs",
      "//components/tabs:public",
      "//components/version_info",
      "//content/public/browser",
      "//services/metrics/public/cpp:metrics_cpp",
      "//ui/base",
    ]
  }

  source_set("unit_tests") {
    testonly = true

    sources = [ "scheduled_restart_bubble_controller_unittest.cc" ]

    deps = [
      ":scheduled_restart",
      "//base",
      "//base/test:test_support",
      "//build/config/linux/dbus:buildflags",
      "//chrome/browser",
      "//chrome/browser/lifetime:test_support",
      "//chrome/browser/search",
      "//chrome/browser/ui/browser_window/test:test_support",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views/relaunch_notification",
      "//chrome/common:constants",
      "//chrome/test:test_support",
      "//chrome/test/base:testing_browser_process",
      "//components/prefs:test_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/views:test_support",
    ]

    if (is_linux && use_dbus) {
      deps += [ "//components/dbus" ]
    }
  }

  source_set("browser_tests") {
    testonly = true

    sources = [
      "scheduled_restart_bubble_controller_browsertest.cc",
      "scheduled_restart_bubble_view_browsertest.cc",
      "scheduled_restart_hats_browsertest.cc",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    deps = [
      ":scheduled_restart",
      "//base",
      "//base/test:test_support",
      "//chrome/browser",
      "//chrome/browser/lifetime",
      "//chrome/browser/lifetime:test_support",
      "//chrome/browser/ui:browser_commands",
      "//chrome/browser/ui/hats",
      "//chrome/browser/ui/hats:test_support",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/browser/ui/views/relaunch_notification",
      "//chrome/browser/upgrade_detector",
      "//chrome/common:chrome_features",
      "//chrome/common:constants",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/prefs",
      "//content/public/browser",
      "//content/test:test_support",
      "//ui/views",
    ]
  }
}
