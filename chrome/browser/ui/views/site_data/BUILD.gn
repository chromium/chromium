import("//build/config/ui.gni")

assert(toolkit_views)

# site_data has no circular dependency back into //chrome/browser/ui:ui, so the
# public headers and implementation live in a single source_set (no :impl
# split).
source_set("site_data") {
  public = [
    "page_specific_site_data_dialog.h",
    "page_specific_site_data_dialog_controller.h",
    "related_app_row_view.h",
    "site_data_row_view.h",
  ]

  sources = [
    "page_specific_site_data_dialog.cc",
    "page_specific_site_data_dialog_controller.cc",
    "related_app_row_view.cc",
    "site_data_row_view.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/web_applications",
    "//components/browsing_data/content",
    "//components/content_settings/core/common",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/metadata",
    "//ui/views",
    "//url",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser:browser_process",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//chrome/browser/infobars",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui:collected_cookies_infobar_delegate",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui:url_identity",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/accessibility",
    "//chrome/browser/ui/web_applications",
    "//chrome/common",
    "//components/browsing_data/core",
    "//components/constrained_window",
    "//components/content_settings/browser",
    "//components/content_settings/core/browser",
    "//components/infobars/content",
    "//components/omnibox/browser",
    "//components/privacy_sandbox:features",
    "//components/strings:components_strings_grit",
    "//components/vector_icons",
    "//components/web_modal",
    "//components/webapps/common",
    "//net",
    "//ui/gfx",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "page_specific_site_data_dialog_unittest.cc" ]

  deps = [
    ":site_data",
    "//chrome/browser/content_settings",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/web_applications:web_applications_test_support",
    "//chrome/test:test_support",
    "//components/browsing_data/content:test_support",
    "//components/content_settings/browser",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "page_specific_site_data_dialog_browsertest.cc" ]

  deps = [
    ":site_data",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//components/browsing_data/core",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/infobars/content",
    "//components/page_info/core",
    "//components/prefs",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/events:test_support",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "page_specific_site_data_dialog_interactive_uitest.cc" ]

  deps = [
    ":site_data",
    "//chrome/app:command_ids",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/interaction",
    "//chrome/browser/ui/views/frame",
    "//chrome/browser/ui/views/page_info",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/web_applications:web_applications_test_support",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/content_settings/core/common",
    "//components/prefs",
    "//components/privacy_sandbox:features",
    "//components/privacy_sandbox/privacy_sandbox_attestations",
    "//components/privacy_sandbox/privacy_sandbox_attestations:test_support",
    "//components/webapps/common",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//ui/base",
    "//ui/views",
  ]

  if (is_chromeos) {
    deps += [ "//chrome/browser/ash/system_web_apps" ]
  }
}
