import("//build/config/ui.gni")

assert(toolkit_views)

source_set("dictation") {
  public = [
    "dictation_bubble_ui.h",
    "dictation_overlay_view.h",
    "onboarding_dialog_controller.h",
    "ui_state.h",
    "waveform_view.h",
    "waveform_view_button.h",
  ]
  sources = [
    "dictation_bubble_ui.cc",
    "dictation_overlay_view.cc",
    "onboarding_dialog_controller.cc",
