    "dictation_overlay_view_unittest.cc",
  ]
  deps = [
    ":dictation",
    "//base",
    "//chrome/browser/dictation:test_support",
    "//chrome/test:test_support",
    "//testing/gtest",
    "//ui/views",
    "//ui/views:test_support",
  ]
