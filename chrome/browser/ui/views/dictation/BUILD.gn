# Identifiers and bubble placement for the dictation IPH.
source_set("iph") {
  public = [ "dictation_iph.h" ]
  sources = [ "dictation_iph.cc" ]
  public_deps = [
    "//base",
    "//components/user_education/common",
    "//ui/base/interaction",
  ]
  deps = [
    "//base:i18n",
    "//ui/gfx",
    "//ui/views",
  ]
}

# Tab-scoped controller that shows the dictation IPH. The implementation depends
# on //chrome/browser/ui/views/frame, so the header is a separate target that
# //chrome/browser/ui/tabs can depend on.
source_set("iph_controller") {
  public = [ "dictation_iph_controller.h" ]
  public_deps = [
    "//base",
    "//chrome/browser/ui/tabs:tabs_public",
    "//content/public/browser",
  ]
}

source_set("iph_controller_impl") {
  sources = [ "dictation_iph_controller.cc" ]
  public_deps = [ ":iph_controller" ]
  deps = [
    ":dictation",
    ":iph",
    "//chrome/app:branded_strings",
    "//chrome/browser/media/webrtc",
