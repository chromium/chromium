import("//build/config/ui.gni")

assert(toolkit_views)

source_set("optimization_guide") {
  public = [ "optimization_guide_icon_view.h" ]

  sources = [ "optimization_guide_icon_view.cc" ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/views/page_action",
    "//ui/base/metadata",
    "//ui/gfx",
  ]

  deps = [
    "//chrome/browser/optimization_guide",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/browser_window",
    "//components/optimization_guide/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/vector_icons",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "optimization_guide_icon_view_interactive_uitest.cc" ]

  deps = [
    ":optimization_guide",
    "//chrome/browser/optimization_guide",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/views/interaction",
    "//chrome/test:test_support",
    "//components/optimization_guide/core",
    "//content/test:test_support",
  ]
}
