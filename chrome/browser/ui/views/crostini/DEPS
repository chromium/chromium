  "crostini_dialogue_browser_test_util\\.cc": [
    "+chrome/browser/browser_process.h",
    "+chrome/browser/chrome_browser_main.h",
    "+chrome/browser/ui/browser_window/public/browser_window_interface.h",
  ],
  "crostini_dialogue_browser_test_util\\.h": [
    "+chrome/browser/ui/test",
