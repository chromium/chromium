source_set("user_education") {
  public = [
    "autofill_help_bubble_factory.h",
    "browser_help_bubble.h",
    "browser_help_bubble_event_relay.h",
    "browser_ntp_promos.h",
    "browser_user_education_service.h",
    "custom_webui_help_bubble_controller.h",
    "impl/browser_feature_promo_controller.h",
    "impl/browser_feature_promo_preconditions.h",
    "impl/browser_user_education_context.h",
    "impl/browser_user_education_interface_impl.h",
    "impl/non_browser_feature_promo_controller.h",
    "ios_promo_bubble_view.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/user_education",
    "//chrome/browser/ui/views/promos:constants",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/browser/user_education",
    "//components/desktop_to_mobile_promos",
    "//components/user_education/common",
    "//components/user_education/views",
    "//components/user_education/webui",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/interaction",
    "//ui/events",
    "//ui/views",
    "//ui/webui/resources/cr_components/help_bubble:mojo_bindings",
  ]

  # impl/browser_user_education_interface_impl.h needs
  # //chrome/browser/ui/user_education, which itself (transitively, via
  # //chrome/browser/user_education) already depends on this target --
  # grant it access rather than adding a real dep the other way, which
  # would be a cycle.
  allow_circular_includes_from = [ "//chrome/browser/user_education" ]
}

# custom_webui_help_bubble.h lives here, not in :user_education: its
# CreateForController<T>() template calls GetBrowserView().GetProfile(),
# which needs BrowserView's complete type wherever it's instantiated.
# frame/browser_view.h is still monolithic in ui:ui (crbug.com/353332589),
# so this stays confined to the target ui:ui already grants circular
# access to, rather than forcing it onto the public :user_education
# target.
