assert(!is_android)

source_set("browser_active_state_manager") {
  public = [ "browser_active_state_manager.h" ]
  sources = [ "browser_active_state_manager.cc" ]
  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//ui/base/unowned_user_data",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/ui/web_applications",
    "//chrome/common:buildflags",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "browser_active_state_manager_unittest.cc" ]
  deps = [
    ":browser_active_state_manager",
    "//base/test:test_support",
    "//chrome/browser/ui:test_support",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "browser_active_state_manager_interactive_uitest.cc" ]
  deps = [
    ":browser_active_state_manager",
    "//chrome/browser/ui/browser_window",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base",
  ]
}
