import("//extensions/buildflags/buildflags.gni")

source_set("supervised_user") {
  if (enable_extensions_core) {
    sources = [
      "extension_install_blocked_by_parent_dialog.cc",
      "extension_install_blocked_by_parent_dialog.h",
    ]
    public_deps = [
      "//base",
      "//ui/base/interaction",
      "//ui/gfx",
    ]
    deps = [
      "//chrome/app:branded_strings",
      "//chrome/app:generated_resources",
      "//chrome/browser/supervised_user",
      "//chrome/browser/ui/extensions",
      "//components/strings:components_strings_grit",
      "//components/vector_icons",
    ]
  }

  if (enable_extensions) {
    sources += [ "parent_permission_dialog.h" ]
  }
}

if (is_win || is_mac || is_linux) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "extension_install_blocked_by_parent_dialog_browsertest.cc" ]
    deps = [
      ":supervised_user",
      "//base",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//content/test:test_support",
      "//extensions/common",
      "//testing/gtest",
    ]
  }
}
