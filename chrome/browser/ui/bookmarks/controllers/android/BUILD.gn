assert(is_android)

source_set("android") {
  sources = [
    "android_bookmark_bar_action_adapter.cc",
    "android_bookmark_bar_action_adapter.h",
    "android_bookmark_bar_injector.cc",
    "android_bookmark_bar_injector.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/bookmarks/controllers",
    "//components/browser_apis/ui_controllers/bookmark_bar",
    "//ui/base:types",
    "//ui/base/mojom:ui_base_types",
  ]

  deps = [
    "//chrome/browser/bookmarks",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//components/bookmarks/browser",
    "//components/browser_apis/ui_controllers/bookmark_bar:impl",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/gfx/geometry",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "android_bookmark_bar_action_adapter_unittest.cc" ]

  deps = [
    ":android",
    "//base/test:test_support",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//chrome/test:test_support",
    "//components/bookmarks/browser",
    "//components/bookmarks/test",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base:types",
    "//ui/base/mojom:ui_base_types",
    "//url",
  ]
}
