# The embedders of //components/browser_apis/ui_controllers/bookmark_bar.
source_set("controllers") {
  sources = [
    "bookmark_bar_model_adapter.cc",
    "bookmark_bar_model_adapter.h",
    "bookmark_bar_node_id_conversions.cc",
    "bookmark_bar_node_id_conversions.h",
    "bookmark_bar_preferences_adapter.cc",
    "bookmark_bar_preferences_adapter.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/bookmarks:types",
    "//components/browser_apis/bookmarks:mojom",
    "//components/browser_apis/ui_controllers/bookmark_bar",
    "//components/prefs",
  ]

  deps = [
    "//chrome/browser/bookmarks",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_group_sync:factories",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
  ]

  if (!is_android) {
    sources += [
      "desktop_bookmark_bar_action_adapter.cc",
      "desktop_bookmark_bar_action_adapter.h",
      "desktop_bookmark_bar_injector.cc",
      "desktop_bookmark_bar_injector.h",
    ]
    deps += [
      "//chrome/browser/page_load_metrics",
      "//chrome/browser/ui/bookmarks",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/views/bookmarks",
      "//components/browser_apis/ui_controllers/bookmark_bar:impl",
      "//components/profile_metrics",
      "//ui/base:types",
      "//ui/gfx/geometry",
      "//ui/views",
    ]
  }
}
