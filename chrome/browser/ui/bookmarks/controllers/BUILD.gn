source_set("controllers") {
  sources = [
    "bookmark_bar_ui_client.h",
    "bookmark_bar_ui_controller.h",
    "bookmark_bar_ui_controller_injector.h",
  ]
  public_deps = [
    "adapters",
    "//base",
    "//ui/base/mojom:ui_base_types",
  ]
}

source_set("impl") {
  sources = [
    "bookmark_bar_ui_controller_impl.cc",
    "bookmark_bar_ui_controller_impl.h",
  ]
  public_deps = [ ":controllers" ]
  deps = [
    "adapters:impl",
    "//base",
    "//chrome/browser/bookmarks",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//ui/base:types",
    "//ui/gfx/geometry",
  ]

  if (!is_android) {
    sources += [
      "desktop_bookmark_bar_ui_controller_injector.cc",
      "desktop_bookmark_bar_ui_controller_injector.h",
    ]
    deps += [
      "//chrome/browser/bookmarks",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui/browser_window",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "bookmark_bar_ui_controller_impl_unittest.cc" ]
  deps = [
    ":controllers",
    ":impl",
    "//base",
    "//base/test:test_support",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//components/bookmarks/test",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base:types",
    "//ui/gfx/geometry",
  ]
}
