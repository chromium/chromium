      "//chrome/browser/ui/webui/signin/history_sync_optin:mojo_bindings",
      "//chrome/browser/ui/webui/updater:mojo_bindings",
    ]
    allow_circular_includes_from +=
        [ "//chrome/browser/ui/views/relaunch_notification:impl" ]
  }

  # TODO(crbug.com/41437292): Remove this circular dependency. Any circular
  # includes must depend on the target
  # "//chrome/browser:browser_public_dependencies". These are all-platform
  # circular includes.
  if (!is_android) {
    # //chrome/browser/download:impl sources include headers from
    # //chrome/browser/ui.
    allow_circular_includes_from += [
      "//chrome/browser/download:impl",
      "//chrome/browser/ui/browser_web_contents_delegate",

      # bookmarks includes headers from //chrome/browser/ui (e.g. browser.h,
      # browser_window_interface.h) that can't be split out yet.
      "//chrome/browser/ui/webui/bookmarks",

      # chrome_web_contents_handler includes headers from //chrome/browser/ui
      # (e.g. browser.h, browser_window.h) that can't be split out yet.
      "//chrome/browser/ui/webui:chrome_web_contents_handler",

      # TODO(crbug.com/504627103): Remove this circular dependency.
      "//chrome/browser/new_tab_page:impl",

      # views/data_sharing:impl includes headers still built as part of this
      # target (browser_element_identifiers.h and
      # views/frame/browser_view.h) that can't be split out yet.
      "//chrome/browser/ui/views/data_sharing:impl",

      # downloads includes headers from //chrome/browser/ui (e.g.
      # browser_window.h) that can't be split out yet.
      "//chrome/browser/ui/webui/downloads",

      # web_app_internals includes headers from //chrome/browser/ui (e.g.
      # browser.h) that can't be split out yet.
      "//chrome/browser/ui/webui/web_app_internals",
    ]
  }

