  allow_circular_includes_from = [
    # page_load_metrics's :impl includes headers from //chrome/browser/ui that
    # can't be split out yet.
    "//chrome/browser/page_load_metrics:impl",

    # profiles:misc includes headers from //chrome/browser/ui that can't be
    # split out yet (e.g. browser.h).
    "//chrome/browser/profiles:misc",
    "//chrome/browser/profiles:profile_manager_impl",

    # sessions includes headers from //chrome/browser/ui that can't be
    # split out yet (e.g. browser.h).
    "//chrome/browser/sessions",
    "//chrome/browser/sessions:impl",

    # TODO(crbug.com/353332589): Remove this circular dependency when
    # the following headers get modularized:
    # - c/b/ui/browser_window.h
    # - c/b/ui/browser.h
    # - c/b/ui/views/title_origin_label.h
    # - c/b/ui/views/bubble_anchor_util_views.h
    # - c/b/ui/views/frame/browser_view.h
    "//chrome/browser/ui/views/file_system_access:impl",
  ]

  # Desktop-Android-only dependencies.
  if (is_desktop_android) {
    deps += [ "//chrome/browser/ui/android/extensions/windowing/internal" ]
  }

  # TODO(crbug.com/413572035): Move into build files of the actual
  # modules depending on this. eg: autofill, user_education.
  if (is_chrome_branded) {
    deps +=
        [ "//components/plus_addresses/core/browser/resources:vector_icons" ]
  }

  if (enable_captive_portal_detection) {
    deps += [ "//chrome/browser/captive_portal" ]
  }

  if (enable_offline_pages) {
    deps += [ "//chrome/browser/offline_pages" ]
  }

  if (enable_compose) {
    deps += [ "//chrome/browser/compose" ]
  }

  if (enable_rlz) {
    deps += [ "//chrome/browser/rlz" ]
  }

  if (enable_extensions_core) {
    deps += [
      "//chrome/browser/ui/extensions",
      "//chrome/browser/ui/extensions:impl",
    ]
    allow_circular_includes_from += [
      # TODO(crbug.com/420905611): Remove this circular dependency when
      # c/b/ui/browser_dialogs.h gets componentized.
      "//chrome/browser/ui/extensions:impl",
    ]
  }

  if (!is_android) {
    deps += [
      "//chrome/browser/ui/infobars",
      "//chrome/browser/ui/views/frame:glass_frame_service",
      "//chrome/browser/ui/views/relaunch_notification",
      "//chrome/browser/ui/views/relaunch_notification:impl",
      "//chrome/browser/ui/webui:chrome_web_contents_handler",
    ]
  }

  if (is_win) {
    deps += [ "//chrome/browser/ui/webui/default_browser:visual_guided_setter" ]
  }

  # //chrome/browser/ui/views/relaunch_notification:impl sources include
  # :ui headers (browser.h, views/frame/browser_view.h).
  if (!is_android && !is_chromeos) {
    deps += [
      "//chrome/browser/ui/webui/app_home:mojo_bindings",
      "//chrome/browser/ui/webui/default_browser:default_browser_modal",
      "//chrome/browser/ui/webui/default_browser:modal_mojo_bindings",
