import("//build/config/ui.gni")

assert(toolkit_views)

source_set("prefs") {
  sources = [ "omnibox_everywhere_prefs.cc" ]
  public = [ "omnibox_everywhere_prefs.h" ]
  public_deps = [ "//base" ]
  deps = [ "//components/prefs" ]
}

# Omnibox Everywhere global features on desktop.
source_set("omnibox_everywhere") {
  sources = [
    "omnibox_everywhere_controller.cc",
    "omnibox_everywhere_ui_manager.cc",
    "omnibox_everywhere_ui_manager.h",
    "omnibox_everywhere_widget_delegate.cc",
    "omnibox_everywhere_widget_delegate.h",
  ]
  public = [
    "omnibox_everywhere_controller.h",
    "omnibox_everywhere_ui_manager.h",
  ]
  friend = [
    ":interactive_ui_tests",
    ":unit_tests",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":prefs",
    "//chrome/browser:file_select_helper",
    "//chrome/browser/background/omnibox_everywhere",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/profiles",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/omnibox_everywhere",
    "//chrome/browser/ui/webui/omnibox_popup",
    "//components/omnibox/common:features",
    "//components/prefs",
    "//ui/base/accelerators/global_accelerator_listener",
    "//ui/gfx",
    "//ui/views",
    "//ui/views/controls/webview",
  ]
  if (use_aura) {
    sources += [
      "omnibox_everywhere_event_handler_aura.cc",
      "omnibox_everywhere_event_handler_aura.h",
    ]
  }
  if (is_mac) {
    sources += [
      "omnibox_everywhere_mac_utils.h",
      "omnibox_everywhere_mac_utils.mm",
    ]
    public += [ "omnibox_everywhere_mac_utils.h" ]
    deps += [ "//components/remote_cocoa/app_shim" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "omnibox_everywhere_controller_unittest.cc",
    "omnibox_everywhere_ui_manager_unittest.cc",
  ]
  if (use_aura) {
    sources += [ "omnibox_everywhere_event_handler_aura_unittest.cc" ]
  }
  deps = [
    ":omnibox_everywhere",
    ":prefs",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/ui/omnibox",
    "//chrome/test:test_support",
    "//chrome/test/views",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/display:test_support",
    "//ui/views",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "omnibox_everywhere_interactive_uitest.cc" ]
  deps = [
    ":omnibox_everywhere",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base:ozone_buildflags",
    "//ui/views",
    "//ui/views:test_support",
  ]
  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }
}
