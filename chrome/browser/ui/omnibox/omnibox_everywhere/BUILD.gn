import("//build/config/ui.gni")

assert(toolkit_views)

source_set("prefs") {
  sources = [ "omnibox_everywhere_prefs.cc" ]
  public = [ "omnibox_everywhere_prefs.h" ]
  public_deps = [ "//base" ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/new_tab_page/prefs",
    "//chrome/browser/profiles:profile",
    "//components/ntp_tiles:pref_names",
    "//components/pref_registry",
    "//components/prefs",
    "//ui/base",
  ]
}

# Omnibox Everywhere public interface headers.
source_set("omnibox_everywhere") {
  public = [
    "omnibox_everywhere_controller.h",
    "omnibox_everywhere_feature_promo_controller.h",
    "omnibox_everywhere_region_select_overlay.h",
    "omnibox_everywhere_ui_manager.h",
  ]
  public_deps = [
    ":prefs",
    "//base",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/feature_engagement/public",
    "//components/prefs",
    "//components/user_education/common",
    "//ui/base/accelerators/global_accelerator_listener",
    "//ui/gfx",
    "//ui/views",
  ]
  if (is_win) {
    public += [ "omnibox_everywhere_shortcut_win.h" ]
  }
}

# Omnibox Everywhere desktop implementation.
source_set("impl") {
  sources = [
    "omnibox_everywhere_controller.cc",
    "omnibox_everywhere_feature_promo_controller.cc",
    "omnibox_everywhere_region_select_overlay.cc",
    "omnibox_everywhere_ui_manager.cc",
    "omnibox_everywhere_widget_delegate.cc",
    "omnibox_everywhere_widget_delegate.h",
  ]
  public_deps = [ ":omnibox_everywhere" ]
  deps = [
    ":prefs",
    "//build:branding_buildflags",
    "//chrome/app:branded_strings",
    "//chrome/app:generated_resources",
    "//chrome/browser:file_select_helper",
    "//chrome/browser/autocomplete",
    "//chrome/browser/background/omnibox_everywhere",
    "//chrome/browser/feature_engagement",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/new_tab_page/prefs",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/profiles",
    "//chrome/browser/ui/views/user_education",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/omnibox_everywhere",
    "//chrome/browser/ui/webui/omnibox_popup",
    "//chrome/browser/user_education",
    "//components/keep_alive_registry",
    "//components/ntp_tiles:pref_names",
    "//components/omnibox/common:features",
    "//components/prefs",
    "//components/search_engines",
    "//components/vector_icons",
    "//ui/base",
    "//ui/base/accelerators/global_accelerator_listener",
    "//ui/base/clipboard",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/menus",
    "//ui/strings:ui_strings",
    "//ui/views",
    "//ui/views/controls/webview",
  ]
  if (use_aura) {
    sources += [
      "omnibox_everywhere_event_handler_aura.cc",
      "omnibox_everywhere_event_handler_aura.h",
    ]
    deps += [
      "//ui/aura",
      "//ui/events",
      "//ui/wm",
    ]
  }
  if (is_win) {
    sources += [ "omnibox_everywhere_shortcut_win.cc" ]
    deps += [
      "//chrome/app:branded_strings",
      "//chrome/browser:shell_integration",
      "//chrome/browser/win",
      "//chrome/common:constants",
    ]
  }
}

if (is_mac || is_win) {
  source_set("unit_tests") {
    testonly = true
    sources = [
      "//chrome/browser/background/omnibox_everywhere/omnibox_everywhere_background_mode_manager_unittest.cc",
      "omnibox_everywhere_controller_unittest.cc",
      "omnibox_everywhere_prefs_unittest.cc",
      "omnibox_everywhere_region_select_overlay_unittest.cc",
      "omnibox_everywhere_ui_manager_unittest.cc",
    ]
    if (use_aura) {
      sources += [ "omnibox_everywhere_event_handler_aura_unittest.cc" ]
    }
    if (is_win) {
      sources += [ "omnibox_everywhere_shortcut_win_unittest.cc" ]
    }
    deps = [
      ":impl",
      ":omnibox_everywhere",
      ":prefs",
      "//base",
      "//base/test:test_support",
      "//chrome/app:branded_strings",
      "//chrome/browser",
      "//chrome/browser/background/omnibox_everywhere",
      "//chrome/browser/new_tab_page/prefs",
      "//chrome/browser/ui/omnibox",
      "//chrome/test:test_support",
      "//chrome/test/views",
      "//components/ntp_tiles:pref_names",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/display:test_support",
      "//ui/views",
      "//ui/views:test_support",
    ]
  }

  source_set("interactive_ui_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "omnibox_everywhere_interactive_uitest.cc" ]
    deps = [
      ":impl",
      ":omnibox_everywhere",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/background/omnibox_everywhere",
      "//chrome/browser/status_icons",
      "//chrome/browser/ui:chrome_pages",
      "//chrome/browser/ui/browser_window",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/base:ozone_buildflags",
      "//ui/views",
      "//ui/views:test_support",
    ]
  }
}
