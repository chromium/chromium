<!-- Width and gravity are set by SideUiResizeHandleView. Starts invisible so
     transitions can capture its starting state before it is shown. -->
<org.chromium.chrome.browser.ui.side_ui.SideUiResizeHandleView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/side_ui_resize_handle"
    android:layout_width="@dimen/side_ui_resize_handle_width"
    android:layout_height="match_parent"
    android:visibility="invisible">

    <View
        android:id="@+id/side_ui_resize_handle_bar"
        android:layout_width="@dimen/side_ui_resize_handle_bar_width"
        android:layout_height="@dimen/side_ui_resize_handle_bar_height"
        android:layout_gravity="center"
        android:background="@drawable/side_ui_resize_handle_bar"
        android:importantForAccessibility="no" />
</org.chromium.chrome.browser.ui.side_ui.SideUiResizeHandleView>
