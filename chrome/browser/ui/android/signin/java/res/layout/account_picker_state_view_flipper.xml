<ViewFlipper
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_picker_state_view_flipper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:measureAllChildren="false" >

    <ScrollView
        android:id="@+id/account_picker_no_account_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_no_account"
            layout="@layout/account_picker_state_no_account" />
    </ScrollView>

    <ScrollView
        android:id="@+id/account_picker_collapsed_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_collapsed"
            layout="@layout/account_picker_state_collapsed" />
    </ScrollView>

    <ScrollView
        android:id="@+id/account_picker_expanded_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_expanded"
            layout="@layout/account_picker_state_expanded" />
    </ScrollView>

    <!--
    Unlike the other screens, this one is `match_parent` so that it takes the
    height of the previously shown (INVISIBLE) screen, and `fillViewport` passes
    that height down to the progress layout so its spinner stays centered. See
    `AccountPickerBottomSheetView#setDisplayedView` and
    https://crbug.com/327127097.
    -->
    <ScrollView
        android:id="@+id/account_picker_progress_scroll_view"
        style="@style/AccountPickerScreenScrollView"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <include
            android:id="@+id/account_picker_state_signin_in_progress"
            layout="@layout/account_picker_state_signin_in_progress" />
    </ScrollView>

    <ScrollView
        android:id="@+id/account_picker_general_error_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_general_error"
            layout="@layout/account_picker_state_general_error" />
    </ScrollView>

    <ScrollView
        android:id="@+id/account_picker_auth_error_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_auth_error"
            layout="@layout/account_picker_state_auth_error" />
    </ScrollView>

    <ScrollView
        android:id="@+id/account_picker_confirm_management_scroll_view"
        style="@style/AccountPickerScreenScrollView">
        <include
            android:id="@+id/account_picker_state_confirm_management"
            layout="@layout/account_picker_state_confirm_management" />
    </ScrollView>
</ViewFlipper>
