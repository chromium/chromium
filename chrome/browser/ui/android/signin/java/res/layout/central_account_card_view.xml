<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PreferenceLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="11dp">
    <!-- Overrides the 16dp top padding of PreferenceLayout:
         11dp = 16dp - 5dp (ai_tier_ring_thickness_large +
         ai_tier_ring_spacing), so that the avatar inside the ring stays in
         place. -->

    <LinearLayout
        android:id="@+id/central_account_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- The 3dp (8dp - 5dp) bottom margin keeps the text in place. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp">

            <ImageView
                android:id="@+id/central_account_image"
                android:layout_width=
                    "@dimen/account_management_picture_size_with_ai_tier_ring"
                android:layout_height=
                    "@dimen/account_management_picture_size_with_ai_tier_ring"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"/>

        </FrameLayout>

        <TextView
            android:id="@+id/central_account_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.TextLarge.Primary"/>

        <TextView
            android:id="@+id/central_account_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.TextSmall.Secondary"/>

    </LinearLayout>

</FrameLayout>
