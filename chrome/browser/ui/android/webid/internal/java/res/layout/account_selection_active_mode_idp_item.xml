<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

  <FrameLayout
      android:layout_width="@dimen/account_selection_active_mode_sheet_avatar_size"
      android:layout_height="@dimen/account_selection_active_mode_sheet_avatar_size"
      android:layout_marginVertical="@dimen/account_selection_active_mode_sheet_item_padding"
      android:layout_marginHorizontal="@dimen/account_selection_active_mode_sheet_item_padding"
      android:importantForAccessibility="no">

    <ImageView
        android:id="@+id/start_icon"
        android:layout_width="@dimen/account_selection_active_mode_sheet_icon_size"
        android:layout_height="@dimen/account_selection_active_mode_sheet_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"/>
  </FrameLayout>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/account_selection_active_mode_sheet_item_padding"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.TextMedium.Primary"/>
  </LinearLayout>

  <ImageView
      android:id="@+id/end_icon"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginEnd="@dimen/account_selection_active_mode_sheet_item_padding"
      android:layout_gravity="center"
      android:src="@drawable/outline_chevron_right_24dp"
      android:importantForAccessibility="no"
      app:tint="@color/default_icon_color_secondary_tint_list"/>
</LinearLayout>
