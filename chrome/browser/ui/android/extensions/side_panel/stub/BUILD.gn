import("//build/config/android/rules.gni")

# Stub target to replace
# "//chrome/browser/ui/android/extensions/side_panel/internal:java" when the
# "internal" target isn't compiled into the build.
android_library("java") {
  visibility = [ "//chrome/android:chrome_all_java" ]
  sources = [ "java/src/org/chromium/chrome/browser/ui/extensions/side_panel/ExtensionSidePanelManagerBridgeFactory.java" ]
  deps = [
    "//build/android:build_java",
    "//chrome/browser/ui/android/extensions/side_panel:java",
  ]
}
