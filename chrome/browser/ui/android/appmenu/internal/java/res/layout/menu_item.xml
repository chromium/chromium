<!-- Layout for each item in the menu popup -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OverflowMenuItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal" >

    <TextView
        android:id="@+id/menu_item_text"
        style="@style/AppMenuItemText"
        android:textAppearance="@style/TextAppearance.DensityAdaptive.TextLarge.Primary"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:minHeight="?attr/listItemHeight"
        android:duplicateParentState="true" />

    <ImageView
        android:id="@+id/menu_item_icon"
        android:layout_weight="0"
        android:layout_width="?attr/listItemIconSize"
        android:layout_height="?attr/listItemIconSize"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:tint="@macro/default_icon_color_secondary"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/menu_item_end_icon"
        android:layout_weight="0"
        android:layout_width="?attr/listItemIconSize"
        android:layout_height="?attr/listItemIconSize"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:tint="@macro/default_icon_color_secondary"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/menu_item_shortcut"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:maxLines="1"
        android:paddingStart="@dimen/menu_item_shortcut_padding_start"
        android:duplicateParentState="true"
        android:visibility="gone" />
</LinearLayout>
