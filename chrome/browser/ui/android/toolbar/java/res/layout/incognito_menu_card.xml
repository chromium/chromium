<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incognito_menu_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/account_menu_card_margin_horizontal"
    android:layout_marginTop="@dimen/account_menu_card_margin_top"
    android:padding="@dimen/account_menu_card_padding"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/incognito_menu_avatar"
        android:layout_width="@dimen/account_menu_avatar_size"
        android:layout_height="@dimen/account_menu_avatar_size"
        android:background="@drawable/oval_surface_0"
        android:src="@drawable/ic_incognito_24dp"
        app:tint="@color/default_icon_color_tint_list"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/incognito_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/incognito_badge"
        android:textAppearance="@style/TextAppearance.Headline2Thick.Primary" />

</LinearLayout>
