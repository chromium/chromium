<org.chromium.components.browser_ui.widget.MaterialCardViewNoShadow
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_menu_identity_card"
    style="@style/MaterialCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cornerRadius="@dimen/account_menu_containment_corner_radius">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/account_menu_identity_avatar"
            android:layout_width="@dimen/account_menu_avatar_size"
            android:layout_height="@dimen/account_menu_avatar_size"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/account_menu_identity_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance=
                "@style/TextAppearance.Headline2Thick.Primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/account_menu_identity_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</org.chromium.components.browser_ui.widget.MaterialCardViewNoShadow>
