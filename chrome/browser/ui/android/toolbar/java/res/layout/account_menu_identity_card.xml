<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_menu_identity_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/account_menu_card_margin_horizontal"
    android:layout_marginTop="@dimen/account_menu_card_margin_top"
    android:padding="@dimen/account_menu_card_padding"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/account_menu_identity_avatar"
        android:layout_width="@dimen/account_menu_avatar_size"
        android:layout_height="@dimen/account_menu_avatar_size"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/account_menu_identity_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance=
            "@style/TextAppearance.Headline2Thick.Primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/account_menu_identity_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
