<org.chromium.chrome.browser.toolbar.download_button.DownloadButtonView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/download_button_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:ignore="UnusedResources">

    <org.chromium.ui.widget.ChromeImageButton
        android:id="@+id/download_button"
        style="@style/ToolbarHoverableButton.AdaptiveDensity"
        android:src="@drawable/ic_download"
        android:contentDescription="@string/menu_downloads"
        android:tooltipText="@string/menu_downloads"
        android:layout_gravity="center"
        app:tint="@color/default_icon_color_tint_list" />

</org.chromium.chrome.browser.toolbar.download_button.DownloadButtonView>
