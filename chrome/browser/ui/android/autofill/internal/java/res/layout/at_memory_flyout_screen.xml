<org.chromium.chrome.browser.ui.autofill.AtMemoryFlyoutView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        tools:ignore="UseCompoundDrawables"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/at_memory_flyout_padding"
        android:layout_marginBottom="@dimen/at_memory_flyout_default_margin">

        <ImageView
            android:id="@+id/flyout_back_button"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_24dp"
            android:contentDescription="@string/back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/flyout_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Headline.Primary" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flyout_chips_container"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/at_memory_flyout_padding"
        android:layout_marginBottom="@dimen/at_memory_flyout_default_margin">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chips_flow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:flow_wrapMode="chain"
            app:flow_verticalAlign="top"
            app:flow_horizontalGap="12dp"
            app:flow_verticalGap="@dimen/at_memory_flyout_default_margin"
            app:flow_horizontalStyle="packed"
            app:flow_horizontalBias="0.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/at_memory_flyout_margin_bottom">

    <TextView
            android:id="@+id/flyout_source_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/at_memory_flyout_margin_bottom"
            android:text="@string/autofill_at_memory_suggestion_source_text"
            android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
            android:gravity="center_vertical"
            android:screenReaderFocusable="true" />

    <TextView
            android:id="@+id/flyout_manage_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="@dimen/at_memory_flyout_margin_bottom"
            android:visibility="gone"
            android:background="@drawable/at_memory_flyout_buttons_bg"
            android:padding="@dimen/at_memory_flyout_default_margin"
            android:textAppearance="@style/TextAppearance.TextLarge.Primary"
            android:drawablePadding="@dimen/at_memory_flyout_default_margin"
            android:gravity="center_vertical" />

    </LinearLayout>

</org.chromium.chrome.browser.ui.autofill.AtMemoryFlyoutView>
