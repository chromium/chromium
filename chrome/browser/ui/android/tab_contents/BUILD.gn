source_set("tab_contents") {
  sources = [
    "chrome_web_contents_view_delegate_android.cc",
    "chrome_web_contents_view_delegate_android.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/flags:flags_android",
    "//chrome/browser/profiles",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui/android:context_menu_helper",
    "//chrome/browser/ui/tab_contents",
    "//components/search_engines",
    "//components/web_distiller/core",
