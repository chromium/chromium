<!-- A dot drawn on the top-right corner of a suggestion icon. The 1dp border
     in the suggestion background color is added at runtime, which leaves an 8dp
     dot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="10dp"
        android:height="10dp" />
    <solid android:color="@macro/default_icon_color_accent1" />
</shape>
