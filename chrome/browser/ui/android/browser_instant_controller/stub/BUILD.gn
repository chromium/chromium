import("//build/config/android/rules.gni")

# Stub target to replace
# "//chrome/browser/ui/android/browser_instant_controller/internal:java"
# when the "internal" target isn't compiled into the build (i.e. when
# enable_webui_ntp is false).
android_library("java") {
  visibility = [ "//chrome/android:chrome_all_java" ]
  sources = [ "java/src/org/chromium/chrome/browser/ui/browser_instant_controller/BrowserInstantControllerBridgeFactory.java" ]
  deps = [
    "//build/android:build_java",
    "//chrome/browser/ui/android/browser_instant_controller:java",
  ]
}
