<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/disclaimer_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

    <!-- TODO(b/512836948): replace with the profile picture -->
    <ImageView
        android:id="@+id/disclaimer_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:src="@drawable/enterprise_icon" />

    <TextView
        android:id="@+id/disclaimer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.Headline.Primary" />

    <org.chromium.ui.widget.TextViewWithLeading
        android:id="@+id/disclaimer_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
        app:leading="@dimen/text_size_medium_leading" />

    <!-- Profile information card -->
    <org.chromium.components.browser_ui.widget.containment.ContainedLinearLayout
        android:id="@+id/profile_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:padding="16dp"
        android:orientation="horizontal"
        app:backgroundStyle="card">

        <ImageView
            android:id="@+id/profile_info_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_account_circle_24dp"
            app:tint="@color/default_icon_color_tint_list" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_information_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textAppearance=
                  "@style/TextAppearance.TextLarge.Primary" />

            <org.chromium.ui.widget.TextViewWithLeading
                android:id="@+id/profile_information_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance=
                  "@style/TextAppearance.TextMedium.Secondary"
                app:leading="@dimen/text_size_medium_leading" />
        </LinearLayout>
    </org.chromium.components.browser_ui.widget.containment.ContainedLinearLayout>

    <!-- Device information card -->
    <org.chromium.components.browser_ui.widget.containment.ContainedLinearLayout
        android:id="@+id/device_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:padding="16dp"
        android:orientation="horizontal"
        app:backgroundStyle="card">

        <ImageView
            android:id="@+id/device_info_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/mobile_icon"
            app:tint="@color/default_icon_color_tint_list" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_information_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textAppearance=
                  "@style/TextAppearance.TextLarge.Primary" />

            <org.chromium.ui.widget.TextViewWithLeading
                android:id="@+id/device_information_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance=
                  "@style/TextAppearance.TextMedium.Secondary"
                app:leading="@dimen/text_size_medium_leading" />
        </LinearLayout>
    </org.chromium.components.browser_ui.widget.containment.ContainedLinearLayout>

    <org.chromium.ui.widget.ButtonCompat
        android:id="@+id/disclaimer_accept_button"
        style="@style/FilledButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="8dp" />

    <org.chromium.ui.widget.ButtonCompat
        android:id="@+id/disclaimer_cancel_button"
        style="@style/TextButton"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
