import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

generate_jni("jni_headers") {
  sources = [ "//chrome/android/java/src/org/chromium/chrome/browser/safe_browsing/SafeBrowsingSuspiciousSiteDialogBridge.java" ]
}

source_set("safe_browsing") {
  sources = [
    "password_reuse_dialog_view_android.cc",
    "password_reuse_dialog_view_android.h",
    "suspicious_site_dialog_view_android.cc",
    "suspicious_site_dialog_view_android.h",
  ]
  deps = [
    ":jni_headers",
    "//base",
    "//chrome/android:chrome_jni_headers",
    "//chrome/browser/safe_browsing/android",
    "//ui/android",
  ]
}
