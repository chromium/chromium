assert(is_chromeos)

source_set("quick_answers") {
  sources = [
    "quick_answers_controller_impl.cc",
    "quick_answers_controller_impl.h",
    "quick_answers_state_ash.cc",
    "quick_answers_state_ash.h",
    "quick_answers_ui_controller.cc",
    "quick_answers_ui_controller.h",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/ui/ash/quick_answers/ui",
  ]

  # quick_answers_ui_controller.h/.cc includes headers owned by the ui:
  # target above, while its .cc files include quick_answers_ui_controller.h
  # back -- a genuine bidirectional pair.
  allow_circular_includes_from = [ "//chrome/browser/ui/ash/quick_answers/ui" ]

  deps = [
    "//ash",
    "//chrome/browser/ash/magic_boost",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui/ash/editor_menu:utils",
    "//chrome/browser/ui/ash/read_write_cards",
    "//chrome/browser/ui/color:color_headers",
    "//chromeos/ash/components/browser_context_helper",
    "//chromeos/ash/experiences/settings_ui",
    "//chromeos/components/kiosk",
    "//chromeos/components/magic_boost/public/cpp/views",
    "//chromeos/components/quick_answers",
    "//chromeos/components/quick_answers/public/cpp",
    "//chromeos/components/quick_answers/public/cpp:constants",
    "//chromeos/components/quick_answers/public/cpp:prefs",
    "//chromeos/constants",
    "//chromeos/strings:strings_grit",
    "//chromeos/ui/vector_icons",
    "//components/account_id",
    "//components/application_locale_storage",
    "//components/language/core/browser",
    "//components/omnibox/browser:vector_icons",
    "//components/prefs",
    "//content/public/browser",
    "//ui/views/controls/webview",
    "//ui/wm",
  ]
}
