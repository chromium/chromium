assert(!is_android)

import("//build/config/ozone.gni")

source_set("session_tab_group_utils") {
  public = [ "session_tab_group_utils.h" ]

  sources = [ "session_tab_group_utils.cc" ]

  public_deps = [ "//components/tab_groups" ]

  deps = [
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs:tab_strip",
  ]
}

source_set("sessions") {
  public = [ "session_service_browser_helper.h" ]

  sources = [ "session_service_browser_helper.cc" ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//components/sessions:session_id",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    ":session_tab_group_utils",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sessions",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/sessions",
    "//components/split_tabs",
    "//components/tabs:public",
    "//content/public/browser",
  ]

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [ "session_tab_group_utils_unittest.cc" ]

  deps = [
    ":session_tab_group_utils",
    "//base/test:test_support",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs:tab_model",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:test_support",
    "//chrome/test:test_support",
    "//components/tab_groups",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
