assert(is_win || is_mac || is_linux || is_chromeos || is_android)

source_set("email_verifier") {
  public = [ "email_verification_controller.h" ]

  public_deps = [
    "//base",
    "//components/autofill/core/browser",
    "//content/public/browser",
    "//net",
    "//ui/gfx/geometry",
    "//url",
  ]

  if (is_android) {
    public += [ "email_verification_controller_android.h" ]
  } else {
    public += [
      "email_verification_controller_desktop.h",
      "email_verification_popup_controller.h",
      "email_verification_popup_view.h",
      "email_verified_toast_menu_model.h",
    ]
    public_deps += [
      "//chrome/browser/ui/autofill",
      "//ui/base",
      "//ui/menus",
    ]
  }
}

source_set("impl") {
  sources = [ "email_verification_controller.cc" ]

  public_deps = [ ":email_verifier" ]

  deps = []

  if (is_android) {
    sources += [ "email_verification_controller_android.cc" ]
    deps += [
      "//chrome/browser/ui/android/autofill",
      "//chrome/browser/ui/autofill",
      "//components/messages/android",
    ]
  } else {
    sources += [
      "email_verification_controller_desktop.cc",
      "email_verification_popup_controller.cc",
      "email_verified_toast_menu_model.cc",
    ]
    deps += [
      "//chrome/app:generated_resources",
      "//chrome/browser/ui:chrome_pages",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/toasts",
      "//chrome/browser/ui/toasts/api:toasts",
      "//chrome/browser/ui/views/autofill/popup/email_verifier",
      "//chrome/common:constants",
      "//components/tabs:public",
      "//components/vector_icons",
      "//ui/views",
    ]
  }
}

source_set("test_support") {
  testonly = true

  sources = [ "email_verification_controller_test_api.h" ]

  public_deps = [ ":email_verifier" ]

  if (is_android) {
    public_deps += [ "//chrome/browser/ui/android/autofill" ]
  } else {
    sources += [
      "mock_email_verification_popup_view.cc",
      "mock_email_verification_popup_view.h",
    ]
    public_deps += [
      "//base",
      "//testing/gmock",
    ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = []
  deps = [
    ":email_verifier",
    ":impl",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/autofill/core/browser",
    "//net",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",
  ]

  if (is_android) {
    sources += [ "email_verification_controller_android_unittest.cc" ]
    deps += [
      "//chrome/app:generated_resources",
      "//chrome/browser/ui/android/autofill",
      "//chrome/browser/ui/autofill",
      "//chrome/browser/ui/autofill:test_support",
      "//components/messages/android",
      "//components/messages/android:test_support",
      "//ui/base",
    ]
  } else {
    sources += [
      "email_verification_controller_unittest.cc",
      "email_verification_popup_controller_unittest.cc",
    ]
    deps += [
      "//content/public/browser",
      "//content/test:test_support",
      "//third_party/blink/public:blink_headers",
      "//third_party/blink/public/common",
    ]
  }
}
