assert(is_win || is_mac || is_linux || is_chromeos)

source_set("email_verifier") {
  public = [
    "email_verification_controller.h",
    "email_verification_popup_controller.h",
    "email_verification_popup_view.h",
    "email_verified_toast_menu_model.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/autofill",
    "//components/autofill/core/browser",
    "//content/public/browser",
    "//net",
    "//ui/base",
    "//ui/gfx/geometry",
    "//ui/menus",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "email_verification_controller.cc",
    "email_verification_popup_controller.cc",
    "email_verified_toast_menu_model.cc",
  ]

  public_deps = [ ":email_verifier" ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/toasts",
    "//chrome/browser/ui/toasts/api:toasts",
    "//chrome/browser/ui/views/autofill/popup/email_verifier",
    "//chrome/common:constants",
    "//components/tabs:public",
    "//components/vector_icons",
    "//ui/views",
  ]
}

source_set("test_support") {
  testonly = true

  sources = [
    "mock_email_verification_popup_view.cc",
    "mock_email_verification_popup_view.h",
  ]

  public_deps = [
    ":email_verifier",
    "//base",
    "//testing/gmock",
  ]
}

