assert(!is_android)

source_set("browser_window_theme_observer") {
  public = [ "browser_window_theme_observer.h" ]
  sources = [ "browser_window_theme_observer.cc" ]
  public_deps = [
    "//base",
    "//chrome/browser/themes",
    "//ui/base/unowned_user_data",
    "//ui/native_theme",
  ]
  deps = [
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "browser_window_theme_observer_unittest.cc" ]
  deps = [
    ":browser_window_theme_observer",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/themes",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window/test:test_support",
    "//chrome/test:test_support",
    "//components/keyed_service/core",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/native_theme",
  ]
}
