module password_manager.mojom;

import "url/mojom/url.mojom";

// Represents a single credential, corresponds to
// password_manager::CredentialUiEntry::DomainInfo
struct DomainInfo {
  // A human readable version of the URL of the credential's origin. For
  // android credentials this is usually App name.
  string human_readable_name;
  // The URL that will be linked to when an entry is clicked.
  url.mojom.Url url;
  // signon_realm of a corresponding PasswordForm.
  string signon_realm;
};

// Corresponds to password_manager::ActorLoginPermission
struct ActorLoginPermission {
  DomainInfo domain_info;
  url.mojom.Url favicon_url;
  string username;
};

// Used by the WebUI page to bootstrap bidirectional communication.
interface PageHandlerFactory {
  // The WebUI page's |BrowserProxy| singleton calls this method when the
  // page is first initialized.
  CreatePageHandler(
      pending_remote<Page> page, pending_receiver<PageHandler> handler);
};

// Represents the status of the password export process.
// Maps to password_manager::ExportProgressStatus.
enum ExportProgressStatus {
  kNotStarted = 0,
  kInProgress = 1,
  kSucceeded = 2,
  kFailed = 3,
  kFailedWrite = 4,
};

// Results for the password export request.
enum ExportPasswordsResult {
  kSuccess = 0,
  kInProgress = 1,
  kReauthFailed = 2,
};

// Classifies states during automatic password change flow.
// Corresponds to
// PasswordChangeFromCheckupDelegate::PasswordAutomaticChangeState.
enum PasswordAutomaticChangeState {
  kInactive = 0,
  kAttemptingSignIn = 1,
  kChangingPassword = 2,
  kConfirmingChangedPassword = 3,
  kPasswordChangedSuccessfully = 4,
  kError = 5,
};

// Classifies errors that user could act on to enable their password manager.
// Corresponds to password_manager::ActionableError.
enum PasswordManagerActionableError {
  kNoError = 0,
  kInactionable = 1,
  kInactionableTemporaryError = 2,
  kSignInNeeded = 3,
  kKeychainError = 4,
  kTrustedVaultKeyNeeded = 5,
  kNeedsPassphrase = 6,
};


// Represents the target store for the password import process.
enum PasswordStoreSet {
  // Corresponds to profile-scoped password store.
  kDevice = 0,
  // Corresponds to Gaia-account-scoped password store (i.e. account store).
  kAccount = 1,
  // Corresponds to both profile-scoped and Gaia-account-scoped password
  // stores.
  kDeviceAndAccount = 2,
};

// Represents the general status of the triggered password import process.
enum ImportResultsStatus {
  // Any other error state.
  kUnknownError = 0,
  // Data was fully or partially imported.
  kSuccess = 1,
  // Failed to read provided file.
  kIoError = 2,
  // Header is missing, invalid or could not be read.
  kBadFormat = 3,
  // File selection dismissed.
  kDismissed = 4,
  // Size of the chosen file exceeds the limit.
  kMaxFileSize = 5,
  // User has already started the import flow in a different window.
  kImportAlreadyActive = 6,
  // User tried to import too many passwords from one file.
  kNumPasswordsExceeded = 7,
  // Conflicts found and they need to be resolved by the user.
  kConflicts = 8,
};

// Represents the parsing status of an individual row that represents credential
// during import process.
enum ImportEntryStatus {
  // Any other error state.
  kUnknownError = 0,
  // Missing password field.
  kMissingPassword = 1,
  // Missing url field.
  kMissingUrl = 2,
  // Bad url formatting.
  kInvalidUrl = 3,
  // URL contains non-ASCII chars.
  kNonAsciiUrl = 4,
  // URL is too long.
  kLongUrl = 5,
  // Password is too long.
  kLongPassword = 6,
  // Username is too long.
  kLongUsername = 7,
  // Credential is already stored in profile store.
  kConflictProfile = 8,
  // Credential is already stored in account store.
  kConflictAccount = 9,
  // Note is too long.
  kLongNote = 10,
  // Concatenation of imported and local notes is too long.
  kLongConcatenatedNote = 11,
  // Valid credential.
  kValid = 12,
};

// Represents an individual row that represents credential during the import
// process.
struct ImportEntry {
  ImportEntryStatus status;
  string url;
  string username;
  string password;
  int32 id;
};

// Represents the results of the password import process.
struct ImportResults {
  ImportResultsStatus status;
  int32 number_imported;
  array<ImportEntry> displayed_entries;
  string file_name;
};

// Called from TS side of chrome://password-manager (Renderer -> Browser)
interface PageHandler {
  // Restarts the authentication timeout timer if the user is authenticated.
  ExtendAuthValidity();

  // Deletes all password manager data (passwords, passkeys, etc.)
  // Returns whether the deletion was successful.
  DeleteAllPasswordManagerData() => (bool success);

  // Copies the plain text backup password for the given |id| to the clipboard,
  // in response to the user clicking the Copy button.
  CopyPlaintextBackupPassword(int32 id) => (bool success);

  // Removes the backup password from a credential with |id|.
  RemoveBackupPassword(int32 id);

  // Removes the saved password exception corresponding to |id|. If no exception
  // with this id exists, this function is a no-op. This will remove the
  // exception from both stores.
  RemovePasswordException(int32 id);

  // Starts a check for insecure passwords.
  StartBulkPasswordCheck();

  // Moves passwords currently stored on the device to being stored in the
  // signed-in, non-syncing Google Account. For each id, the result is a
  // no-op if any of these is true: the id is invalid; the id corresponds to a
  // password already stored in the account; or the user is not using the
  // account-scoped password storage.
  MovePasswordsToAccount(array<int32> ids);

  // Resets the PasswordImporter if it is in the CONFLICTS/FINISHED state
  // and the user closes the dialog. Only when the PasswordImporter is in
  // FINISHED state, the |delete_file| option is taken into account.
  ResetImporter(bool delete_file) => ();

  // Returns the list of sites that can be used for Actor Login.
  GetActorLoginPermissions() => (array<ActorLoginPermission> sites);

  // Revokes actor login permission for all credentials matching the site.
  RevokeActorLoginPermission(ActorLoginPermission site);

  // Shows a dialog for changing the Password Manager PIN.
  // Returns whether the flow was successfully started.
  ChangePasswordManagerPin() => (bool success);

  // Shows a dialog for creating a shortcut for the Password Manager page.
  ShowAddShortcutDialog();

  // Requests the account-storage active state of the current user.
  IsAccountStorageActive() => (bool active);

  // Triggered when the user toggles the account storage switch.
  SetAccountStorageEnabled(bool enabled);

  // Requests whether the account storage toggle should be shown.
  ShouldShowAccountStorageSettingToggle() => (bool should_show);

  // Checks whether changing the Password Manager PIN is possible.
  IsPasswordManagerPinAvailable() => (bool is_available);

  // Switches the Biometric authentication state (before filling) after
  // successful re-auth. Returns whether the switch was successful.
  SwitchBiometricAuthBeforeFillingState() => (bool success);

  // Starts the change password flow for the given credential.
  StartPasswordChange(int32 credential_id);

  // Stops an ongoing password change flow started from Password Checkup.
  StopPasswordChange();

  // Returns the current actionable error.
  GetPasswordManagerActionableError() => (PasswordManagerActionableError error);

  // Shows the file with the exported passwords in the OS shell.
  ShowLastExportedFileInShell();

  // Disconnects the Chrome client from the cloud authenticator
  // (Passkeys Enclave). Returns whether the disconnection was successful.
  DisconnectCloudAuthenticator() => (bool success);

  // Checks whether the Chrome client is connected to the cloud authenticator
  // (Passkeys Enclave).
  IsConnectedToCloudAuthenticator() => (bool connected);

  // Undoes the last removal of a saved password or exception.
  UndoRemoveSavedPasswordOrException();

  // Request to start exporting passwords. The UI will show an OS file picker.
  RequestPasswordsExport() => (ExportPasswordsResult result);

  // Request the current export progress status.
  GetPasswordsExportProgress() => (ExportProgressStatus status);

  // Triggers the Password Manager password import functionality.
  // `to_store`: The store to import passwords into.
  ImportPasswords(PasswordStoreSet to_store) => (ImportResults results);

  // Resumes the password import process when the user has selected which
  // passwords to replace.
  // `selected_ids`: The IDs of passwords that need to be replaced.
  ContinueImport(array<int32> selected_ids) => (ImportResults results);

  // Starts the OS/Sync native Trusted Vault authentication flow to unlock
  // passwords.
  StartTrustedVaultUnlock();
};

// Called from C++ side of chrome://password-manager. (Browser -> Renderer)
interface Page {
  // Pushes a targeted state update for a specific credential.
  OnPasswordAutomaticChangeStateUpdated(
      int32 credential_id,
      PasswordAutomaticChangeState state);

  // Broadcasts the progress of the password export flow.
  // |folder_name| is only populated when status is kFailedWrite.
  OnPasswordsExportProgress(ExportProgressStatus status, string? folder_name);
};
