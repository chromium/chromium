import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "tools.mojom" ]
  public_deps = [
    "//mojo/public/mojom/base",
    "//third_party/blink/public/mojom:dom_node_id",
    "//ui/gfx/geometry/mojom",
    "//url/mojom:url_mojom_gurl",
  ]
  webui_module_path = "/"
}

action("generate_tool_definitions") {
  script = "//chrome/browser/ttc/resources/tools/generate_tool_definitions.py"
  sources = [ "tools.mojom" ]
  outputs = [
    "$target_gen_dir/generated_tool_definitions.h",
    "$target_gen_dir/generated_tool_definitions.ts",
  ]
  args = [
    "--in-files",
    rebase_path(sources[0], root_build_dir),
    "--out-file",
    rebase_path(outputs[0], root_build_dir),
    "--out-ts-file",
    rebase_path(outputs[1], root_build_dir),
  ]
}
