module visual_guided_setter.mojom;

import "ui/gfx/geometry/mojom/geometry.mojom";

// Implemented in the renderer (WebUI). Receives state updates pushed from the
// browser process.
interface Page {
  // Notifies the WebUI page whether docking is in an error or degraded state.
  SetErrorState(bool has_error);
};

// Implemented in the browser process. Drives the native Windows guided flow.
interface PageHandler {
  // Sets the DOMRect bounds (in CSS pixels relative to WebUI viewport) of the
  // visual stage where the native Windows Settings app should be docked.
  SetAnchorRect(gfx.mojom.Rect rect);

  // Opens the Windows Settings default apps page.
  OpenSettings();
};

// Bootstraps the Page/PageHandler pipes. Bound to the WebUI controller.
interface PageHandlerFactory {
  // Creates a PageHandler to drive the native Windows guided flow, and
  // binds it to the WebUI Page to send status/updates back to the renderer.
  // `page`: Remote endpoint to send notifications/status updates to the WebUI.
  // `handler`: Receiver endpoint to handle commands from the WebUI page.
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};
