import("//mojo/public/tools/bindings/mojom.gni")
import("//ui/webui/webui_features.gni")

assert(enable_webui_tabstrip_ntb)

mojom("mojo_bindings") {
  sources = [ "tabstrip_ntb.mojom" ]
  webui_module_path = "/"
}

source_set("tabstrip_ntb") {
  sources = [
    "tabstrip_ntb_ui.cc",
    "tabstrip_ntb_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/common",
    "//components/browser_apis/tab_strip:mojom",
    "//mojo/public/cpp/bindings",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/browser/flags:flags_android",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/tabstrip_ntb:resources",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/common:buildflags",
    "//components/browser_apis/tab_strip:service",
    "//components/browser_apis/tab_strip/resources",
    "//content/public/browser",
  ]
}
