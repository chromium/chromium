module iwa_dev.mojom;

import "mojo/public/mojom/base/file_path.mojom";
import "url/mojom/origin.mojom";
import "url/mojom/url.mojom";

// Describes how a manifest-installed app should perform update checks.
struct UpdateInfo {
  url.mojom.Url update_manifest_url;
  string update_channel;
};

// Represents the installation source and configuration of a dev mode IWA.
union IwaDevModeSource {
  url.mojom.Origin proxy_origin;         // Local proxy install source
  mojo_base.mojom.FilePath bundle_path;  // Local bundle file install source
  UpdateInfo update_info;                // Manifest install source
};

struct IwaDevModeAppInfo {
  string app_id;
  string web_bundle_id;
  string name;
  IwaDevModeSource source;
  string installed_version;
};

// Interface for the WebUI page to communicate with the browser.
interface PageHandler {
  // Returns information about installed dev mode IWAs.
  GetInstalledAppsInfo() => (array<IwaDevModeAppInfo> apps);

  // Installs an IWA from a local proxy server.
  // Returns an error message if installation failed, or null on success.
  InstallAppFromDevProxy(url.mojom.Url url) => (string? error);

  // Opens a file picker for the user to select a Web Bundle and installs it.
  SelectAndInstallAppFromLocalWebBundle() => (string? error);

  // Uninstalls an IWA with a given ID.
  UninstallApp(string app_id) => (bool success);
};

// Interface for the browser to push events to the WebUI page.
interface Page {
  // Notifies the page that an app has been installed.
  OnAppInstalled(IwaDevModeAppInfo app_info);

  // Notifies the page that an app's manifest has been updated.
  OnAppUpdated(IwaDevModeAppInfo app_info);

  // Notifies the page that an app has been uninstalled.
  OnAppUninstalled(string app_id);
};

// Factory interface to create the handler.
interface PageHandlerFactory {
  // Creates a PageHandler and binds it to the given receiver.
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};
