      "//components/favicon_base",
      "//components/search_engines",
      "//content/public/browser",
      "//content/test:test_support",
      "//extensions/browser",
      "//extensions/common",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/native_theme",
      "//ui/native_theme:test_support",
      "//ui/resources",
    ]
  }
}

