import("//mojo/public/tools/bindings/mojom.gni")

assert(is_linux || is_chromeos || is_win || is_mac)
assert(!is_fuchsia, "Fuchsia shouldn't use anything in //chrome")

mojom("mojo_bindings") {
  sources = [ "tab_groups.mojom" ]
  public_deps = [
    "//components/tab_groups/public/mojom:mojo_bindings",
    "//mojo/public/mojom/base",
  ]
  webui_module_path = "/"
}

source_set("organizer_panel") {
  sources = [
    "organizer_panel_ui.cc",
    "organizer_panel_ui.h",
    "tab_groups_organizer_page_handler.cc",
    "tab_groups_organizer_page_handler.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//chrome/browser/ui/webui/tab_search:mojo_bindings",
    "//chrome/browser/ui/webui/top_chrome",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/organizer_panel:resources",
    "//chrome/browser/resources/tab_group_shared:resources",
    "//chrome/browser/tab_group_sync:factories",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:features",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs/saved_tab_groups",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/browser/ui/webui/metrics_reporter",
    "//chrome/browser/ui/webui/tab_search",
    "//chrome/common",
    "//components/favicon_base",
    "//components/saved_tab_groups/public",
    "//components/strings:components_strings",
    "//components/tab_groups",
    "//components/tabs:public",
    "//ui/base",
    "//ui/webui",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "tab_groups_organizer_page_handler_browsertest.cc" ]
  deps = [
    ":mojo_bindings",
    ":organizer_panel",
    "//base/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_group_sync:factories",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/saved_tab_groups/public",
    "//components/tab_groups",
    "//content/test:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
    "//url",
  ]
}
