module organizer_panel.mojom;

// Persisted display state for an organizer panel section.
struct SectionState {
  bool expanded = true;
  bool show_all = false;
};

// WebUI-side handler for general panel requests from the browser.
interface Page {
  // Called when the persisted state of sections changes.
  OnSectionsStateChanged(map<string, SectionState> sections_state);
};

// Browser-side handler for general panel requests from WebUI page.
interface PageHandler {
  // Closes the organizer panel.
  ClosePanel();

  // Returns the persisted state for the section with the given ID.
  GetSectionState(string section_id) => (SectionState state);

  // Sets whether the section with the given ID is expanded.
  SetSectionExpanded(string section_id, bool expanded);

  // Sets whether the section with the given ID shows all items.
  SetSectionShowAll(string section_id, bool show_all);
};

// Factory interface to bootstrap communication between WebUI and browser.
interface PageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};
