module organizer_panel.mojom;

// LINT.IfChange(OrganizerSection)
// Identifiers for sections in the organizer panel.
enum SectionId {
  kCrossDeviceTabs = 0,
  kOpenTabs = 1,
  kRecentlyClosed = 2,
  kTabGroups = 3,
};
// LINT.ThenChange(//chrome/browser/ui/tabs/organizer/organizer_panel_controller.cc:OrganizerSection)

// Persisted display state for an organizer panel section.
struct SectionState {
  bool expanded = true;
  bool show_all = false;
};

// Actions performed on an item in an organizer panel section list.
// LINT.IfChange(OrganizerAction)
enum Action {
  kCloseTab,
  kOpenCrossDeviceTab,
  kOpenRecentlyClosedEntry,
  kOpenTabGroup,
  kSwitchTab,
};
// LINT.ThenChange(//chrome/browser/resources/organizer_panel/organizer_list_section.ts:OrganizerAction, //chrome/browser/ui/webui/organizer_panel/organizer_panel_page_handler.cc:OrganizerAction, //tools/metrics/histograms/metadata/tab/histograms.xml:OrganizerAction)

// WebUI-side handler for general panel requests from the browser.
interface Page {
  // Called when whether the panel is in the tray view changes.
  OnIsInTrayViewChanged(bool in_tray_view);

  // Called when the persisted state of sections changes.
  OnSectionsStateChanged(map<SectionId, SectionState> sections_state);
};

// Browser-side handler for general panel requests from WebUI page.
interface PageHandler {
  // Notifies the browser that the UI is ready to be shown.
  ShowUI();

  // Closes the organizer panel.
  ClosePanel();

  // Returns the persisted state for the section with the given ID.
  GetSectionState(SectionId section_id) => (SectionState state);

  // Sets whether the section with the given ID is expanded.
  SetSectionExpanded(SectionId section_id, bool expanded);

  // Sets whether the section with the given ID shows all items.
  SetSectionShowAll(SectionId section_id, bool show_all);

  // Records the time from when the panel was shown until `action` was
  // performed in a filtered or unfiltered section list.
  RecordTimeToAction(Action action, bool is_filtered);
};

// Factory interface to bootstrap communication between WebUI and browser.
interface PageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};
