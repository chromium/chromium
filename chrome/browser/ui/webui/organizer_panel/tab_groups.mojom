module organizer_panel.mojom;

import "components/tab_groups/public/mojom/tab_group_types.mojom";
import "mojo/public/mojom/base/uuid.mojom";

// Information about an existing tab group.
struct TabGroup {
  mojo_base.mojom.Uuid id;
  tab_groups.mojom.Color color;
  string title;
};

// Browser-side handler for requests from WebUI page.
interface TabGroupsOrganizerPageHandler {
  // Get the list of tab groups that should be displayed in the organizer panel.
  GetTabGroups() => (array<TabGroup> tab_groups);
};

// Factory interface to bootstrap communication between WebUI and browser.
interface TabGroupsOrganizerPageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(
      pending_receiver<TabGroupsOrganizerPageHandler> handler);
};
