module organizer_panel.mojom;

import "components/tab_groups/public/mojom/tab_group_types.mojom";
import "mojo/public/mojom/base/uuid.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";

// Information about an existing tab group.
struct TabGroup {
  mojo_base.mojom.Uuid id;
  tab_groups.mojom.Color color;
  string title;
  bool is_open;
};

// WebUI-side handler for requests from the browser.
interface TabGroupsOrganizerPage {
  // Called when a tab group is added.
  TabGroupAdded(TabGroup tab_group);

  // Called when a tab group is removed.
  TabGroupRemoved(mojo_base.mojom.Uuid id);

  // Called when a tab group is updated.
  TabGroupUpdated(TabGroup tab_group);
};

// Browser-side handler for requests from WebUI page.
interface TabGroupsOrganizerPageHandler {
  // Get the list of tab groups that should be displayed in the organizer panel.
  GetTabGroups() => (array<TabGroup> tab_groups);

  // Open the tab group with the given ID in the tab strip, or highlight it if
  // already open.
  OpenTabGroup(mojo_base.mojom.Uuid id);

  // Shows the context menu for the specified tab group anchored at
  // `anchor_rect`. The callback is invoked when the menu is closed.
  ShowContextMenu(mojo_base.mojom.Uuid group_id, gfx.mojom.Rect anchor_rect)
      => ();
};

// Factory interface to bootstrap communication between WebUI and browser.
interface TabGroupsOrganizerPageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(
      pending_remote<TabGroupsOrganizerPage> page,
      pending_receiver<TabGroupsOrganizerPageHandler> handler);
};
