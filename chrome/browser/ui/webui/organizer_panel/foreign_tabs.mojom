module organizer_panel.mojom;

import "url/mojom/url.mojom";

// Information about a tab open on another device.
struct ForeignTab {
  string title;
  url.mojom.Url url;
  string last_active_elapsed_text;
  string device_name;
};

// Browser-side handler for requests from WebUI page.
interface ForeignTabsPageHandler {
  // Get the list of foreign tabs that should be displayed in the
  // organizer panel, sorted by how recently they were accessed.
  GetForeignTabs() => (array<ForeignTab> tabs);
};

// Factory interface to bootstrap communication between WebUI and browser.
interface ForeignTabsPageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePageHandler(
      pending_receiver<ForeignTabsPageHandler> handler);
};
