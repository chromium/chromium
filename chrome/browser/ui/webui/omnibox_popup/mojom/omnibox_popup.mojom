module omnibox_popup.mojom;

import "components/omnibox/browser/searchbox.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "ui/gfx/range/mojom/range.mojom";

// The per-tab input-row state of the Omnibox.
struct OmniboxInputState {
  // An incrementing sequence number generated by C++ to reject stale in-flight
  // selection changes sent back from WebUI during asynchronous state
  // restoration.
  uint32 sequence_number;
  // The tab ID associated with this input state.
  int32 tab_id;
  // The text that should be displayed in the Omnibox input field.
  string text;
  // The selection range (or cursor position if start == end) in the input
  // field.
  gfx.mojom.Range selection;
  // Whether the user has edited the text or if it is unedited permanent text.
  bool user_input_in_progress;
  // The full url to show on unelision.
  string full_url;
  // Whether the Omnibox input should have active focus.
  bool is_focused;
  // The steady-state permanent display text (usually the unelided URL).
  string permanent_display_text;
  // Whether the full url should be showing.
  bool show_full_url;
  // Whether searchbox should query for ZPS.
  bool query_zps;
  // The keyword model associated with the input, if in keyword mode.
  searchbox.mojom.InputKeywordModel? keyword_model;
};

// Browser-side handler for the Omnibox Popup.
interface PageHandlerFactory {
  // Creates and binds a new PageHandler to handle calls from the WebUI page.
  CreatePageHandler(
      pending_remote<Page> page, pending_receiver<PageHandler> handler);
};

enum OmniboxEscapeAction {
  kRevertTemporaryText = 1,
  kClosePopup = 2,
  kClearUserInput = 3,
  kClosePopupAndClearUserInput = 4,
  kBlur = 5,
};

// Browser-side handler for requests from WebUI page.
interface PageHandler {
  // Opens context menu.
  ShowContextMenu(gfx.mojom.Point point);

  // Closes the Omnibox Popup.
  CloseUI();

  // Called when the selection changes in the WebUI.
  OnSelectionChanged(
      gfx.mojom.Range selection, uint32 sequence_number, bool show_full_url);

  // Reverts the omnibox edit model.
  // Discards the call if `sequence_number` is stale.
  Revert(uint32 sequence_number);

  // Logs the Escape key press action to UMA.
  LogEscapeAction(OmniboxEscapeAction action);

  // Notifies the browser that the user has cleared the Omnibox.
  // Discards the call if `sequence_number` is stale.
  OnInputCleared(uint32 sequence_number);

  // Notifies the browser that the user has pasted text into the Omnibox.
  // Discards the call if `sequence_number` is stale.
  OnPaste(string text, gfx.mojom.Range selection, uint32 sequence_number);

  // Notifies the browser that the user has cut or copied text from the Omnibox.
  // Discards the call if `sequence_number` is stale.
  OnCutOrCopy(uint32 sequence_number,
              bool is_cut,
              string full_text,
              gfx.mojom.Range selection);

  // Requests the current native input state (text, selection, focus) from C++.
  RequestInputState();

  // Opens the AIM (AI Mode) popup. `via_keyboard` is true if triggered via
  // keyboard.
  OpenAimPopup(bool via_keyboard);

  // Updates the client-side edit history undo/redo availability state.
  SetEditHistoryState(bool can_undo, bool can_redo);

  // Opens DevTools to inspect the Omnibox popup WebUI.
  OpenDevTools();
};

// The WebUI page for the Omnibox Popup.
interface Page {
  // Called when the popup is shown.
  OnShow();

  // Called when the context menu is closed.
  OnContextMenuClosed();

  // Called by the browser to update the input state (e.g. input text
  // and selection range) of the WebUI Omnibox.
  SetInputState(OmniboxInputState state);

  // Called by the browser when focus changes within the active tab. `query_zps`
  // indicates whether to issue a Zero-Suggest autocomplete query upon focus.
  SetFocus(bool is_focused, bool query_zps);

  // Clears autocomplete results and resets active query ID in WebUI.
  ClearAutocompleteMatches();

  // Called when the popup is hidden. The page is expected to perform any
  // necessary cleanup and complete the callback.
  ClearPopup() => ();

  // Updates the default search provider's icon path.
  SetDefaultSearchProvider(string default_icon_path);
};
