include_rules = [
  # Other ash directories in //chrome.
  "+chrome/browser/ash/cloud_upload",
  "+chrome/browser/ash/file_manager",
  "+chrome/browser/ash/file_system_provider",
  "+chrome/browser/ui/ash/system_web_apps",
  "+chrome/browser/ui/webui/ash/cloud_upload",
  "+chrome/browser/ui/webui/ash/smb_shares",

  # Existing dependencies within //chrome. There is an active effort to
  # refactor //chrome/browser/ui/ash to break these dependencies; see b/332804822.
  # Whenever possible, avoid adding new //chrome dependencies to this list.
  "+chrome/browser/platform_util.h",
]

specific_include_rules = {
  '.*_(browser|unit)test\\.cc': [
    "+chrome/browser/ash/profiles/profile_helper.h",
    "+chrome/browser/ui/browser_window/public",
    "+chrome/browser/ui/browser_window/public/browser_window_interface.h",
    "+chrome/browser/ui/webui/ash/settings/test_support",
    "+chrome/test",
  ],
}
