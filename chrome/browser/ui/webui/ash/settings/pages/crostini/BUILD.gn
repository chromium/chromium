assert(is_chromeos)

static_library("crostini") {
  sources = [
    "crostini_handler.cc",
    "crostini_handler.h",
    "crostini_section.cc",
    "crostini_section.h",
    "guest_os_handler.cc",
    "guest_os_handler.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ash/crostini",
    "//chrome/browser/ash/guest_os",
    "//chrome/browser/ui/webui/settings",
    "//chromeos/ash/components/dbus/session_manager",
    "//chromeos/ash/components/network",
    "//chromeos/ash/components/settings",
    "//components/prefs",
    "//components/services/app_service",
  ]

  deps = [
    "//ash/constants",
    "//ash/strings",
    "//ash/webui/settings/public/constants:mojom",
    "//chrome/browser/ash/bruschetta",
    "//chrome/browser/ash/crostini:crostini_installer_types_mojom",
    "//chrome/browser/ash/file_manager",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/views/bruschetta",
    "//chrome/browser/ui/views/crostini",
    "//chrome/browser/ui/webui/ash/crostini_installer",
    "//chrome/browser/ui/webui/ash/settings/search",
    "//chromeos/ash/components/browser_context_helper",
    "//chromeos/ash/components/install_attributes",
    "//chromeos/ash/components/login/session",
    "//chromeos/ash/experiences/arc",
    "//chromeos/ash/experiences/settings_ui/resources:strings",
    "//components/user_manager",
    "//content/public/browser",
    "//ui/base",
    "//ui/chromeos",
    "//ui/display",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "crostini_section_unittest.cc" ]

  deps = [
    ":crostini",
    "//ash/constants",
    "//base/test:test_support",
    "//chrome/browser/ash/bruschetta",
    "//chrome/browser/ash/guest_os",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
