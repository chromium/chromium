source_set("unit_tests") {
  testonly = true
  sources = []

  # Common to contextual_searchbox_handler_unittest.cc (!is_android) and
  # searchbox_handler_unittest.cc (enable_webui_ntp) below.
  deps = [
    ":searchbox_test_utils",
    "//chrome/browser/autocomplete",
    "//chrome/browser/autocomplete:aim_eligibility_service",
    "//chrome/browser/contextual_search",
    "//chrome/browser/tab_list",
    "//chrome/browser/tab_list:test_support",
    "//chrome/browser/ui:test_support",
    "//chrome/browser/ui/contextual_search",
    "//chrome/browser/ui/tabs/alert:tab_alert",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/new_tab_page/composebox/variations",
    "//components/contextual_search:test_support",
    "//components/omnibox/browser",
    "//components/omnibox/browser:test_support",
    "//components/omnibox/common",
    "//components/search",
    "//components/tabs:test_support",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base",
  ]

  if (!is_android) {
    sources += [ "contextual_searchbox_handler_unittest.cc" ]
    deps += [
      "//chrome/browser/contextual_tasks",
      "//chrome/browser/feature_engagement",
      "//chrome/browser/search_engines",
      "//chrome/browser/signin",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views/drive_picker_host",
      "//chrome/browser/ui/webui/cr_components/composebox",
      "//chrome/browser/ui/webui/drive_picker_host",
      "//chrome/common",
      "//components/contextual_search/internal:test_support",
      "//components/contextual_tasks/public",
      "//components/contextual_tasks/public:test_support",
      "//components/feature_engagement/test:test_support",
      "//components/lens",
      "//components/omnibox/common:features",
      "//components/omnibox/composebox:mojo_bindings",
      "//components/prefs",
      "//ui/base:test_support",
    ]

    if (is_chromeos) {
      deps += [ "//chromeos/ash/components/network:test_support" ]
    }
  }

  # searchbox_handler_unittest.cc exercises the desktop-NTP-only handlers
  # (omnibox_composebox_handler, webui_omnibox_handler), which :searchbox
  # only compiles under !is_android; it's gated on enable_webui_ntp (rather
  # than the !is_android split above) because enable_webui_ntp can also be
  # true for is_desktop_android.
  if (enable_webui_ntp) {
    sources += [ "searchbox_handler_unittest.cc" ]
    deps += [
      ":searchbox",
      "//chrome/browser/bookmarks",
      "//chrome/browser/ui/omnibox",
      "//chrome/browser/ui/omnibox:test_support",
      "//chrome/browser/ui/webui/cr_components/searchbox",
      "//chrome/test:test_support",
      "//components/bookmarks/browser",
      "//components/contextual_search:public",
      "//components/variations",
      "//ui/webui/resources/cr_components/composebox:mojo_bindings",
    ]

    if (!is_android) {
      deps += [
        "//chrome/browser/ui/tabs:tab_strip",
        "//chrome/browser/ui/tabs:test_support",
        "//chrome/browser/ui/webui/omnibox_popup",
      ]
    }
  }
}

