import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core)

source_set("aim_eligibility_extension") {
  sources = [
    "aim_eligibility_extension_bridge.cc",
    "aim_eligibility_extension_bridge.h",
    "aim_eligibility_extension_bridge_factory.cc",
    "aim_eligibility_extension_bridge_factory.h",
  ]

  public_deps = [
    "//chrome/browser/ui/webui/omnibox/aim_eligibility",
    "//chrome/browser/ui/webui/omnibox/aim_eligibility:mojo_bindings",
  ]

  deps = [
    "//chrome/browser/autocomplete:aim_eligibility_service",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//ui/webui/resources/cr_components/color_change_listener:mojom",
  ]
}

source_set("browser_tests") {
  testonly = true

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "aim_eligibility_extension_browsertest.cc" ]

  deps = [
    ":aim_eligibility_extension",
    "//chrome/browser:browser_process",
    "//chrome/browser/autocomplete:aim_eligibility_service",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions:test_support",
    "//chrome/common:constants",
    "//components/omnibox/browser:test_support",
    "//components/omnibox/common",
    "//content/test:browsertest_support",
    "//extensions:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gmock",
  ]

  if (is_android) {
    deps += [
      "//chrome/browser/ui/browser_window/test:android_browser_test_support",
      "//chrome/test:test_support_ui_android",
    ]
  } else {
    deps += [ "//chrome/test:test_support_ui" ]
  }
}
