import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  disable_variants = true
  public_deps = [
    "//components/content_settings/core/common:mojo_bindings",
    "//mojo/public/mojom/base",
  ]

  deps = [ "//components/content_settings/core/common:content_settings_types" ]

  sources = [ "content_settings_internals.mojom" ]
  webui_module_path = "/"
}

source_set("content_settings") {
  sources = [
    "content_settings_handler.cc",
    "content_settings_handler.h",
    "content_settings_ui.cc",
    "content_settings_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
  ]

  deps = [
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/resources/content_settings:resources",
    "//ui/base",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "content_settings_handler_unittest.cc" ]

  deps = [
    ":content_settings",
    ":mojo_bindings",
    "//base/test:test_support",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/test:test_support",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//content/test:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "content_settings_ui_browsertest.cc" ]

    deps = [
      ":content_settings",
      ":mojo_bindings",
      "//base/test:test_support",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/content_settings/core/browser",
      "//components/content_settings/core/common",
      "//content/public/browser",
      "//content/test:test_support",
      "//mojo/public/cpp/bindings",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
