module feature_showcase.mojom;

// Browser-side handler for requests from the Gemini step WebUI.
interface GeminiPageHandler {
  // Accepts the Gemini consent.
  AcceptConsent();

  // Skips the Gemini consent.
  SkipConsent();
};

// Used by the WebUI to bootstrap WebUI->Browser communication for Gemini.
interface GeminiPageHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreateGeminiPageHandler(pending_receiver<GeminiPageHandler> handler);
};
