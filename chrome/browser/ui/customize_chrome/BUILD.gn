import("//ui/webui/webui_features.gni")

assert(enable_webui_ntp)

source_set("customize_chrome") {
  sources = [
    "side_panel_controller.cc",
    "side_panel_controller.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/side_panel",
    "//ui/base/unowned_user_data",
  ]
}

# Platform independent base class.
source_set("customize_chrome_base") {
  sources = [
    "side_panel_controller_base.cc",
    "side_panel_controller_base.h",
  ]

  public_deps = [ ":customize_chrome" ]

  deps = [
    # Does not actually depend on //ui/views for is_android.
    "//chrome/browser/ui/side_panel:side_panel_views_dependent",
  ]

  if (is_android) {
    sources += [
      "side_panel_controller_android.cc",
      "side_panel_controller_android.h",
    ]
    deps += [
      "//chrome/browser/android/thin_webview",
      "//chrome/browser/ui/side_panel/android",
    ]
  } else {
    deps += [
      "//chrome/browser/search/background",
      "//chrome/browser/ui/webui/side_panel/customize_chrome:customize_chrome_ui",
    ]
  }
}
