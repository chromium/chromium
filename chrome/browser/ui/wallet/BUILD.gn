import("//build/config/ui.gni")

source_set("wallet") {
  sources = [
    "walletable_pass_bubble_controller_base.cc",
    "walletable_pass_bubble_controller_base.h",
    "walletable_pass_bubble_view_base.cc",
    "walletable_pass_bubble_view_base.h",
    "walletable_pass_bubble_view_factory.cc",
    "walletable_pass_bubble_view_factory.h",
    "walletable_pass_consent_bubble_controller.cc",
    "walletable_pass_consent_bubble_controller.h",
    "walletable_pass_consent_bubble_view.cc",
    "walletable_pass_consent_bubble_view.h",
    "walletable_pass_save_bubble_controller.cc",
    "walletable_pass_save_bubble_controller.h",
    "walletable_pass_save_bubble_view.cc",
    "walletable_pass_save_bubble_view.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/signin",
    "//chrome/browser/ui/autofill",
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/autofill/autofill_ai",
    "//chrome/browser/ui/views/location_bar",
    "//components/wallet/core/browser",
    "//content/public/browser",
    "//ui/views",
  ]

  if (!is_android) {
    deps += [ "//chrome/browser/ui:chrome_pages" ]
  }

  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}

if (toolkit_views) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "walletable_pass_bubble_controller_browsertest.cc",
      "walletable_pass_save_bubble_view_browsertest.cc",
    ]
    deps = [
      ":wallet",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/signin",
      "//chrome/browser/ui",
      "//chrome/browser/ui/test:test_support",
      "//chrome/test:test_support",
      "//components/optimization_guide/proto:optimization_guide_proto",
      "//components/signin/public/identity_manager",
      "//components/signin/public/identity_manager:test_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/base",
      "//ui/views",
      "//ui/views:test_support",
      "//url",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "walletable_pass_consent_bubble_controller_unittest.cc",
    "walletable_pass_save_bubble_controller_unittest.cc",
  ]

  deps = [
    ":wallet",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/tabs:test_support",
    "//components/wallet/core/browser",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
