<!--
  Layout for the side panel container.

  This layout should be feature-agnostic, i.e., besides the View
  provided by a side panel feature, this layout should only contain
  common Views that can be shared among features.

  The "layout_width" should be set programmatically, so it's 0dp here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:padding="@dimen/side_ui_container_padding"
    android:background="@macro/default_bg_color">

    <LinearLayout
        android:id="@+id/side_panel_inner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/side_panel_inner_container_bg"
        android:clipToOutline="true">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/side_panel_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/side_panel_header_height"
            android:layout_marginBottom="@dimen/side_panel_header_bottom_margin"
            android:orientation="horizontal"
            android:paddingStart="@dimen/side_panel_header_horizontal_spacing"
            android:gravity="center_vertical">

            <!-- Representative icon -->
            <ImageView
                android:id="@+id/side_panel_icon"
                android:layout_width="@dimen/side_panel_header_icon_size"
                android:layout_height="@dimen/side_panel_header_icon_size"
                android:layout_marginEnd=
                    "@dimen/side_panel_header_horizontal_spacing"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Title -->
            <TextView
                android:id="@+id/side_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance=
                    "@style/TextAppearance.TextLargeThick.Primary" />

            <!-- Close button
                 It fills the header's height and is wider than its icon, for
                 a larger touch target. The icon is centered, so its spacing
                 from the title and the header's end matches the other
                 header elements. -->
            <ImageButton
                android:id="@+id/side_panel_close_button"
                android:layout_width="@dimen/side_panel_header_button_width"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:scaleType="center"
                android:src="@drawable/material_ic_close_24dp"
                android:tint="@macro/default_icon_color" />

        </LinearLayout>

        <!-- Content Area
             We use a FrameLayout here instead of a ViewStub because during
             content replacement (e.g. startReplacingPanelContent), we
             temporarily add the new content view before removing the old one.
             A FrameLayout allows these two views to overlap (Z-stack) while the
             new one loads, avoiding a blank flash. -->
        <FrameLayout
            android:id="@+id/side_panel_content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
