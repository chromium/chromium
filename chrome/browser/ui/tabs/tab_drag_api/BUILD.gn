source_set("tab_drag_api") {
  sources = [ "tab_drag_service_feature.h" ]

  public_deps = [
    "//components/browser_apis/tab_drag",
    "//ui/base/unowned_user_data",
  ]
}

source_set("impl") {
  sources = [ "tab_drag_service_feature.cc" ]

  deps = [
    ":tab_drag_api",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/ui/browser_window",
    "//components/browser_apis/tab_drag",
    "//components/browser_apis/tab_drag/sessions",
    "//mojo/public/cpp/bindings",
  ]
}

if (!is_android) {
  source_set("unit_tests") {
    testonly = true
    deps = [ "desktop_tab_drag_impl:unit_tests" ]
  }

  source_set("browser_tests") {
    testonly = true
    deps = [ "desktop_tab_drag_impl:browser_tests" ]
  }
}
