<resources>
    <dimen name="composeplate_view_button_margin">8dp</dimen>
    <!-- The lateral padding of the icon-only optional and incognito buttons
         with the phone layout. It is reduced in very narrow windows, e.g.,
         split screen at the minimum width, to leave enough space for the AI
         Mode button. See values-w360dp/dimens.xml for the regular value. -->
    <dimen name="composeplate_view_optional_button_padding">
        @dimen/composeplate_view_button_margin
    </dimen>
    <dimen name="composeplate_view_optional_button_margin">4dp</dimen>
    <!-- The spacing of the optional button with the large form factor layout. -->
    <dimen name="composeplate_view_optional_button_padding_lff">@dimen/composeplate_view_button_margin</dimen>
    <dimen name="composeplate_view_optional_button_margin_lff">12dp</dimen>
    <!-- The min window width on large form factor devices to use the large form factor layout. -->
    <dimen name="composeplate_view_lff_layout_min_window_width">420dp</dimen>
    <dimen name="composeplate_view_height">48dp</dimen>
    <dimen name="composeplate_view_icon_size">24dp</dimen>
    <dimen name="composeplate_view_legacy_height">44dp</dimen>
    <dimen name="composeplate_view_lateral_margin">16dp</dimen>
    <dimen name="composeplate_view_margin_top">8dp</dimen>
    <dimen name="composeplate_view_legacy_margin_top">4dp</dimen>
    <dimen name="composeplate_view_beside_mvt_width">88dp</dimen>
    <dimen name="composeplate_view_beside_mvt_margin_end">12dp</dimen>
</resources>
