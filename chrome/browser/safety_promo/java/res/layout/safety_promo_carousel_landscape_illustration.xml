<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/carousel_landscape_illustration_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- Fills the pane height and keeps the aspect ratio. If the pane is
       wider, the illustration is centered; otherwise it is
       center-cropped. -->
  <ImageView
      android:id="@+id/carousel_illustration"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:adjustViewBounds="true"
      android:scaleType="centerCrop"
      android:importantForAccessibility="no" />
</FrameLayout>
