import("//chrome/common/features.gni")
import("//components/optimization_guide/features.gni")
import("//pdf/features.gni")
import("//services/on_device_model/on_device_model.gni")

assert(build_with_model_execution)
assert(is_win || is_mac || is_linux || is_chromeos || is_android)

source_set("features") {
  sources = [
    "features.cc",
    "features.h",
  ]

  configs += [ "//build/config/compiler:wglobal_constructors" ]
  public_deps = [ "//base" ]
}

source_set("ai") {
  sources = [
    "ai_context_bound_object.h",
    "ai_context_bound_object_set.h",
    "ai_data_keyed_service.h",
    "ai_data_keyed_service_factory.h",
    "ai_language_model.h",
    "ai_manager.h",
    "ai_on_device_session.h",
    "ai_proofreader.h",
    "ai_rewriter.h",
    "ai_semantic_embedder.h",
    "ai_semantic_embedder_service_launcher.h",
    "ai_summarizer.h",
    "ai_utils.h",
    "ai_writer.h",
    "semantic_embedder_spaces.h",
  ]
  if (!is_android) {
    sources += [
      "ai_embedding_gemma_v1_decision_model.h",
      "ai_language_model_decision_model.h",
      "ai_laya_decision_model.h",
      "decision_model_prompt_builder.h",
      "decision_model_schema_compiler.h",
    ]
  }

  configs += [ "//build/config/compiler:wglobal_constructors" ]
  public_deps = [
    ":features",
    "//base",
    "//chrome/browser/actor",
    "//chrome/browser/glic",
    "//chrome/browser/profiles:profile",
    "//components/component_updater",
    "//components/on_device_ai",
    "//components/optimization_guide/core",
    "//components/passage_embeddings/core",
    "//components/update_client",
    "//content/public/browser",
    "//services/passage_embeddings/public/mojom",
  ]
  if (is_chrome_branded && use_on_device_model_service) {
    sources += [ "ai_page_action_controller.h" ]
    public_deps += [
      "//ui/base/interaction",
      "//ui/base/unowned_user_data",
    ]
  }
}

source_set("impl") {
  sources = [
    "ai_context_bound_object.cc",
    "ai_context_bound_object_set.cc",
    "ai_data_keyed_service.cc",
    "ai_data_keyed_service_factory.cc",
    "ai_language_model.cc",
    "ai_manager.cc",
    "ai_on_device_session.cc",
    "ai_proofreader.cc",
    "ai_rewriter.cc",
    "ai_semantic_embedder.cc",
    "ai_semantic_embedder_service_launcher.cc",
    "ai_summarizer.cc",
    "ai_utils.cc",
    "ai_writer.cc",
    "semantic_embedder_spaces.cc",
  ]
  if (!is_android) {
    sources += [
      "ai_embedding_gemma_v1_decision_model.cc",
      "ai_language_model_decision_model.cc",
      "ai_laya_decision_model.cc",
      "decision_model_prompt_builder.cc",
      "decision_model_schema_compiler.cc",
    ]
  }

  configs += [ "//build/config/compiler:wglobal_constructors" ]

  public_deps = [ "//components/content_extraction/content/browser" ]
  deps = [
    ":ai",
    "//base:i18n",
    "//build:branding_buildflags",
    "//chrome/browser:browser_process",
    "//chrome/browser/component_updater",
    "//chrome/browser/passage_embeddings",
    "//chrome/browser/ui/tabs:tabs_public",
    "//components/autofill/content/browser",
    "//components/autofill/core/browser",
    "//components/language/core/common",
    "//components/optimization_guide/content/browser",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/passage_embeddings/core",
    "//components/site_engagement/content",
    "//pdf:buildflags",
    "//services/on_device_model/public/cpp:buildflags",
    "//skia",
    "//third_party/protobuf:protobuf_lite",
  ]
  if (!is_android) {
    deps += [
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs:tab_group",
      "//chrome/browser/ui/tabs:tab_strip",
    ]
  }
  if (is_chrome_branded && use_on_device_model_service) {
    sources += [ "ai_page_action_controller.cc" ]
    deps += [
      "//chrome/app:branded_strings",
      "//chrome/app:generated_resources",
      "//chrome/browser:global_features",
      "//chrome/browser/optimization_guide",
      "//chrome/browser/ui:browser_element_identifiers",
      "//chrome/browser/ui:chrome_pages",
      "//chrome/browser/ui/actions:actions_headers",
      "//chrome/browser/ui/dialogs:browser_dialogs",
      "//chrome/browser/ui/interaction",
      "//chrome/browser/ui/page_action",
      "//chrome/browser/ui/webui/settings",
      "//chrome/common",
      "//components/prefs",
      "//components/tabs:public",
      "//components/vector_icons",
      "//ui/actions",
      "//ui/base",
      "//ui/color:color_headers",
      "//ui/views",
    ]
  }
  if (enable_pdf) {
    deps += [
      "//components/pdf/browser",
      "//components/pdf/common:constants",
    ]
  }
}

source_set("test_support") {
  testonly = true
  sources = [
    "ai_test_utils.cc",
    "ai_test_utils.h",
  ]
  public_deps = [
    "//chrome/browser/optimization_guide",
    "//chrome/browser/optimization_guide:test_support",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/optimization_guide/core:manifest_broker_test_support",
    "//components/optimization_guide/core:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
  deps = [
    ":ai",
    "//components/component_updater:component_updater_paths",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ai_manager_unittest.cc",
    "ai_summarizer_unittest.cc",
    "ai_utils_unittest.cc",
    "semantic_embedder_spaces_unittest.cc",
  ]
  deps = []
  if (!is_android) {
    sources += [
      "ai_embedding_gemma_v1_decision_model_unittest.cc",
      "ai_language_model_decision_model_unittest.cc",
      "ai_language_model_unittest.cc",
      "ai_laya_decision_model_unittest.cc",
      "ai_proofreader_unittest.cc",
      "ai_rewriter_unittest.cc",
      "ai_semantic_embedder_service_launcher_unittest.cc",
      "ai_semantic_embedder_unittest.cc",
      "ai_writer_unittest.cc",
      "decision_model_prompt_builder_unittest.cc",
      "decision_model_schema_compiler_unittest.cc",
    ]
    deps += [ "//services/on_device_model/public/cpp/test_support" ]
  }
  deps += [
    ":ai",
    ":test_support",
    "//chrome/browser/component_updater",
    "//chrome/browser/optimization_guide:test_support",
    "//chrome/test/base:testing_browser_process",
    "//components/component_updater:test_support",
    "//components/on_device_ai",
    "//components/optimization_guide/core:manifest_broker_test_support",
    "//components/optimization_guide/core:test_support",
    "//components/optimization_guide/core/model_execution/configs:summarize_config",
    "//components/passage_embeddings/core:test_support",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [
      "ai_data_keyed_service_browsertest.cc",
      "ai_semantic_embedder_browsertest.cc",
    ]

    deps = [
      ":ai",
      ":test_support",
      "//base",
      "//chrome/browser/actor:test_support",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/web_applications:web_applications_test_support",
      "//chrome/test:test_support",
      "//components/passage_embeddings/core:test_support",
      "//content/test:test_support",
      "//testing/gmock",
    ]

    if (is_chrome_branded && use_on_device_model_service) {
      sources += [ "ai_page_action_controller_browsertest.cc" ]
      deps += [
        "//chrome/app:branded_strings",
        "//chrome/browser:browser_process",
        "//chrome/browser/ui/actions:actions_headers",
        "//chrome/browser/ui/page_action",
        "//chrome/browser/ui/tabs:tab_strip",
        "//chrome/browser/ui/views/interaction",
        "//chrome/browser/ui/views/page_action:test_support",
        "//chrome/browser/ui/views/toolbar:test_support",
        "//chrome/browser/ui/webui/settings",
        "//ui/base",
        "//ui/base/interaction",
        "//ui/views",
        "//ui/views:test_support",
        "//url",
      ]
    }
  }
}

if (!is_android && !is_chromeos_device) {
  source_set("interactive_ui_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "ai_on_device_interactive_uitest.cc" ]

    deps = [
      ":ai",
      ":test_support",
      "//base",
      "//chrome/browser/ui/browser_window",
      "//chrome/test:test_support",
      "//components/embedder_support",
      "//content/test:test_support",
      "//testing/gmock",
    ]
  }
}
