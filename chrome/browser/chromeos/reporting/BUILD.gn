assert(is_chromeos)

static_library("reporting") {
  sources = [
    "user_reporting_settings.cc",
    "user_reporting_settings.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chromeos/ash/components/metrics_reporting",
    "//components/prefs",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "user_reporting_settings_unittest.cc" ]

  deps = [
    ":reporting",
    "//base",
    "//base/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//chrome/test/base:testing_profile",
    "//components/content_settings/core/common",
    "//components/reporting/proto:metric_data_proto",
    "//components/sync_preferences:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
