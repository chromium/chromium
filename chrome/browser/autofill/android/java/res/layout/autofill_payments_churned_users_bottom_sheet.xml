<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/autofill_bottom_sheet_padding_horizontal"
    android:paddingEnd="@dimen/autofill_bottom_sheet_padding_horizontal"
    android:paddingTop="@dimen/autofill_bottom_sheet_spacing_medium"
    android:paddingBottom="@dimen/autofill_bottom_sheet_spacing_large">

    <TextView
        android:id="@+id/payments_churned_users_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom=
            "@dimen/autofill_bottom_sheet_spacing_extra_small"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Headline.Primary" />
</LinearLayout>
