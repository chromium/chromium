import("//build/config/chrome_build.gni")
import("//chrome/common/request_header_integrity/buildflags.gni")

if (enable_request_header_integrity) {
  source_set("request_header_integrity") {
    public = [ "chrome_companero_host.h" ]
    sources = [ "chrome_companero_host.cc" ]

    if (!is_android) {
      public += [ "platform_runtime_host.h" ]
      sources += [ "platform_runtime_host.cc" ]
    }

    public_deps = [
      "//base",
      "//chrome/common/request_header_integrity:mojom",
      "//mojo/public/cpp/bindings",
      "//net",
    ]

    deps = [
      "//chrome/common/request_header_integrity",
      "//components/embedder_support:user_agent",
      "//content/public/browser",
      "//google_apis",
      "//services/network/public/mojom",
    ]
  }

  source_set("unit_tests") {
    testonly = true

    sources = [ "chrome_companero_host_unittest.cc" ]

    if (!is_android) {
      sources += [ "platform_runtime_host_unittest.cc" ]
    }

    deps = [
      ":request_header_integrity",
      "//base/test:test_support",
      "//chrome/common/request_header_integrity",
      "//chrome/common/request_header_integrity:mojom",
      "//mojo/public/cpp/bindings",
      "//net",
      "//services/network/public/mojom",
      "//testing/gmock",
      "//testing/gtest",
    ]

    data_deps =
        [ "//chrome/common/request_header_integrity/internal:chromecompaneros" ]
  }

  if (!is_android) {
    source_set("browser_tests") {
      testonly = true

      defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

      sources = [ "platform_runtime_browsertest.cc" ]

      deps = [
        ":request_header_integrity",
        "//base",
        "//base/test:test_support",
        "//build:branding_buildflags",
        "//chrome/browser",
        "//chrome/common/request_header_integrity",
        "//chrome/common/request_header_integrity:mojom",
        "//chrome/test:test_support",
        "//chrome/test:test_support_ui",
        "//content/test:test_support",
        "//mojo/public/cpp/bindings",
        "//net:test_support",
        "//services/network/public/mojom",
        "//testing/gtest",
        "//url",
      ]

      if (is_chrome_branded) {
        sources += [ "//chrome/common/request_header_integrity/internal/google_header_names.h" ]
        data_deps = [
          "//chrome/common/request_header_integrity/internal:chromecompaneros",
        ]
      }
    }
  }
}
