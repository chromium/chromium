source_set("origin_gating") {
  sources = [
    "origin_gating_service_factory.cc",
    "origin_gating_service_factory.h",
  ]

  public_deps = [ "//chrome/browser/profiles:profile" ]

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/origin_gating/core",
    "//content/public/browser",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "origin_gating_service_factory_unittest.cc" ]

  deps = [
    ":origin_gating",
    "//base",
    "//chrome/test:test_support",
    "//components/origin_gating/core",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
