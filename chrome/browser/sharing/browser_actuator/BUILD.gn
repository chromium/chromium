  deps = [
    ":browser_actuator",
    "//base/test:test_support",
    "//chrome/browser/signin",
    "//chrome/browser/stream_transport",
    "//chrome/test:test_support",
    "//components/browser_actuator/public:feature_list",
    "//components/gcm_driver/common",
    "//components/sharing_message:test_support",
    "//components/sharing_message/proto",
    "//components/signin/public/identity_manager",
    "//components/stream_transport/internal:features",
    "//components/stream_transport/internal:session_stream_recorder",
    "//components/stream_transport/internal/proto",
    "//components/stream_transport/internal/test_support",
    "//components/stream_transport/public",
    "//components/stream_transport/public:payload_type_mapping",
    "//components/stream_transport/public:service",
    "//components/stream_transport/test_support",
    "//components/stream_transport/test_support/proto_stream",
    "//components/sync_device_info:test_support",
    "//content/test:test_support",
    "//net",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
  ]
