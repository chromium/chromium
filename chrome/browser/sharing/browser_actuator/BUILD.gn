source_set("browser_actuator") {
  public = [ "browser_actuator_message_handler.h" ]

  public_deps = [
    "//base",
    "//chrome/browser/glic",
    "//chrome/browser/sharing/glic_experimental_triggering",
    "//components/sharing_message",
    "//components/sharing_message/proto",
  ]
}

source_set("impl") {
  sources = [ "browser_actuator_message_handler.cc" ]

  deps = [
    ":browser_actuator",
    "//chrome/browser/actor",
    "//chrome/browser/glic",
    "//chrome/browser/glic:impl",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sharing/glic_experimental_triggering:impl",
    "//chrome/common:chrome_features",
    "//components/browser_actuator/public",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "browser_actuator_message_handler_unittest.cc" ]
  deps = [
    ":browser_actuator",
    ":impl",
    "//base/test:test_support",
    "//chrome/browser/glic",
    "//chrome/browser/glic:impl",
    "//chrome/browser/glic/test_support",
    "//chrome/test:test_support",
    "//components/browser_actuator/public",
    "//components/sharing_message:test_support",
    "//components/sharing_message/proto",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
