import("//build/config/android/rules.gni")

# Printing interfaces that are available whether or not printing is built.
android_library("java") {
  sources =
      [ "java/src/org/chromium/chrome/browser/printing/PrintingDelegate.java" ]
  deps = [
    "//base:base_java",
    "//base:service_loader_java",
    "//build/android:build_java",
    "//chrome/browser/tab:java",
    "//components/prefs/android:java",
  ]
}
