<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="bn">
<translation id="1293272072740285747">পরে ট্যাব যোগ করার জন্য, এই গ্রুপ রেখে দিন অথবা এটি আপনার আর প্রয়োজন না থাকলে মুছে দিন।

আপনি এটি মুছে দিলে, সকলেই, "<ph name="TITLE_OF_GROUP" />" ট্যাব গ্রুপে অ্যাক্সেস হারাবেন এবং এটি সব ডিভাইস থেকে মুছে দেওয়া হবে।</translation>
<translation id="1340839264183302272">গ্রুপ থেকে বেরিয়ে আসুন</translation>
<translation id="1419023007528516122">এর ফলে আপনার ডিভাইস থেকে গ্রুপ স্থায়ীভাবে মুছে যাবে</translation>
<translation id="1499635324672558517">সবকটি ছদ্মবেশী ট্যাব বন্ধ করবেন?</translation>
<translation id="1501480321619201731">আইটেমের গ্রুপ মুছুন</translation>
<translation id="1713541401465507417">সব ট্যাব ও গ্রুপ বন্ধ করুন</translation>
<translation id="2123073051266141035">{INCOGNITO_TABS_COUNT,plural, =1{আপনার বন্ধ করে দেওয়া ট্যাব ও গ্রুপ, 'সাম্প্রতিক' ট্যাব ও ট্যাব গ্রুপ বিভাগ থেকে আবার খোলা যাবে। আপনার 'ছদ্মবেশী' ট্যাবের সুবিধা উপলভ্য হবে না।}one{আপনার বন্ধ করে দেওয়া ট্যাব ও গ্রুপ, 'সাম্প্রতিক' ট্যাব ও ট্যাব গ্রুপ বিভাগ থেকে আবার খোলা যাবে। আপনার #টি 'ছদ্মবেশী' ট্যাবের সুবিধা উপলভ্য হবে না।}other{আপনার বন্ধ করে দেওয়া ট্যাব ও গ্রুপ, 'সাম্প্রতিক' ট্যাব ও ট্যাব গ্রুপ বিভাগ থেকে আবার খোলা যাবে। আপনার #টি 'ছদ্মবেশী' ট্যাবের সুবিধা উপলভ্য হবে না।}}</translation>
<translation id="2628148780487543078">এছাড়াও পিন করা ট্যাব বন্ধ করুন</translation>
<translation id="2677748264148917807">ছেড়ে চলে যান</translation>
<translation id="3547352561153509682"><ph name="USER_EMAIL" /> ব্যবহার করে সাইন-ইন করা হয়েছে এমন সবকটি ডিভাইস থেকে গ্রুপ মুছে ফেলা হবে</translation>
<translation id="381219490185664296">ট্যাব গ্রুপ আনগ্রুপ করবেন?</translation>
<translation id="4139634748112164403">এই ডিভাইসে ট্যাব খোলা থাকবে কিন্তু গ্রুপ স্থায়ীভাবে মুছে ফেলা হবে</translation>
<translation id="4431937619879060901">আপনি অবিলম্বে “<ph name="GROUP_NAME" />” ট্যাব গ্রুপের অ্যাক্সেস হারাবেন এবং আপনার সব ডিভাইস থেকে এটি মুছে দেওয়া হবে</translation>
<translation id="4460014764210899310">আলাদা করুন</translation>
<translation id="4777866634702576038">ট্যাব গ্রুপ মুছবেন?</translation>
<translation id="4870911314065352661">সব ট্যাব বন্ধ করবেন?</translation>
<translation id="5094423602314093681">ট্যাব সরাবেন ও গ্রুপ মুছবেন?</translation>
<translation id="5647702255748985085">গ্রুপ থেকে বেরিয়ে আসতে চান?</translation>
<translation id="742664698522525515">গ্রুপটি রাখবেন?</translation>
<translation id="750886945254958667">পরে ট্যাব যোগ করার জন্য এই গ্রুপটি রেখে দিন অথবা আর অ্যাক্সেস করতে না চাইলে ছেড়ে বেরিয়ে আসুন</translation>
<translation id="8261506727792406068">মুছুন</translation>
<translation id="870736955561925754">ট্যাব বন্ধ করে গ্রুপ মুছে দেবেন?</translation>
<translation id="8730999928494395583">এইসব 'ছদ্মবেশী' ট্যাবে আপনার করা অ্যাক্টিভিটি এই ডিভাইস থেকে সরানো হবে</translation>
<translation id="8804742093141782941">গ্রুপ রেখে দিন</translation>
<translation id="8887921976452567404">'সাম্প্রতিক ট্যাব' এবং 'ট্যাব গ্রুপ' বিভাগ থেকে, আপনার বন্ধ করে দেওয়া ট্যাব ও গ্রুপ আবার খোলা যেতে পারে।</translation>
<translation id="9169141410816678175">প্রত্যেকে অবিলম্বে "<ph name="GROUP_NAME" />" ট্যাব গ্রুপে অ্যাক্সেস হারাবেন এবং সব ডিভাইস থেকে এটি মুছে দেওয়া হবে</translation>
<translation id="9216898458513705996">এই ডিভাইসে ট্যাব খোলা থাকবে কিন্তু <ph name="USER_EMAIL" /> ব্যবহার করে সাইন-ইন করা হয়েছে এমন সবকটি ডিভাইস থেকে গ্রুপ মুছে ফেলা হবে</translation>
<translation id="94870150074703282">গ্রুপটি মুছবেন?</translation>
</translationbundle>