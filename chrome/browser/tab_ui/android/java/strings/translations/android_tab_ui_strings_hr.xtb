<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1293272072740285747">Sačuvajte ovu grupu da biste kasnije dodali kartice ili je izbrišite ako vam više nije potrebna.

Ako je izbrišete, svi će odmah izgubiti pristup grupi kartica <ph name="TITLE_OF_GROUP" /> i izbrisat će se sa svih uređaja.</translation>
<translation id="1340839264183302272">Napusti grupu</translation>
<translation id="1419023007528516122">Time ćete trajno izbrisati grupu s uređaja</translation>
<translation id="1499635324672558517">Zatvoriti sve anonimne kartice?</translation>
<translation id="1501480321619201731">Izbriši grupu</translation>
<translation id="1645759014353344461">Kartice su grupirane (njih <ph name="TABS_COUNT_MANY" />)</translation>
<translation id="1713541401465507417">Zatvori sve kartice i grupe</translation>
<translation id="1828808367831369073"><ph name="TABS_COUNT_ONE" /> kartica je grupirana</translation>
<translation id="2123073051266141035">{INCOGNITO_TABS_COUNT,plural, =1{Zatvorene kartice i grupe mogu se ponovo otvoriti u odjeljku Nedavne kartice i odjeljku Grupe kartica. Vaša anonimna kartica neće biti dostupna.}one{Zatvorene kartice i grupe mogu se ponovo otvoriti u odjeljku Nedavne kartice i odjeljku Grupe kartica. Vaša # anonimna kartica neće biti dostupna.}few{Zatvorene kartice i grupe mogu se ponovo otvoriti u odjeljku Nedavne kartice i odjeljku Grupe kartica. Vaše # anonimne kartice neće biti dostupne.}other{Zatvorene kartice i grupe mogu se ponovo otvoriti u odjeljku Nedavne kartice i odjeljku Grupe kartica. Vaših # anonimnih kartica neće biti dostupno.}}</translation>
<translation id="2628148780487543078">Zatvori i prikvačene kartice</translation>
<translation id="2677748264148917807">Napusti</translation>
<translation id="3547352561153509682">Time će se grupa izbrisati sa svih uređaja na kojima ste prijavljeni na <ph name="USER_EMAIL" /></translation>
<translation id="381219490185664296">Želite li poništiti grupiranje kartica?</translation>
<translation id="4139634748112164403">Kartice će ostati otvorene na ovom uređaju, ali će se grupa trajno izbrisati</translation>
<translation id="4431937619879060901">Odmah ćete izgubiti pristup grupi kartica <ph name="GROUP_NAME" /> i ona će se izbrisati sa svih vaših uređaja</translation>
<translation id="4460014764210899310">Razgrupiraj</translation>
<translation id="4777866634702576038">Želite li izbrisati grupu kartica?</translation>
<translation id="4870911314065352661">Želite li zatvoriti sve kartice?</translation>
<translation id="5094423602314093681">Želite li ukloniti kartice i izbrisati grupu?</translation>
<translation id="5647702255748985085">Želite li napustiti grupu?</translation>
<translation id="742664698522525515">Želite li i zadržati grupu?</translation>
<translation id="750886945254958667">Zadržite ovu grupu da biste kasnije dodali kartice ili je napustite ako joj više ne želite pristupati</translation>
<translation id="8261506727792406068">Izbriši</translation>
<translation id="870736955561925754">Želite li zatvoriti karticu i izbrisati grupu?</translation>
<translation id="8730999928494395583">Vaša aktivnost na tim anonimnim karticama uklonit će se s ovog uređaja</translation>
<translation id="8804742093141782941">Zadrži grupu</translation>
<translation id="8887921976452567404">Zatvorene kartice i grupe mogu se ponovo otvoriti u odjeljku Nedavne kartice i odjeljku Grupe kartica.</translation>
<translation id="9169141410816678175">Svi će odmah izgubiti pristup grupi kartica <ph name="GROUP_NAME" /> i izbrisat će se sa svih uređaja</translation>
<translation id="9216898458513705996">Kartice će ostati otvorene na ovom uređaju, ali će se grupa izbrisati sa svih uređaja na kojima ste prijavljeni na <ph name="USER_EMAIL" /></translation>
<translation id="94870150074703282">Želite li izbrisati grupu?</translation>
