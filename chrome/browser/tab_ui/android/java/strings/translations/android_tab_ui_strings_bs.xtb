<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="1293272072740285747">Zadržite ovu grupu da kasnije dodate kartice ili je izbrišite ako je više ne trebate.

Ako je izbrišete, svi će odmah izgubiti pristup grupi kartica "<ph name="TITLE_OF_GROUP" />" i grupa će se izbrisati sa svih uređaja.</translation>
<translation id="1340839264183302272">Napusti grupu</translation>
<translation id="1419023007528516122">Ovo će trajno izbrisati grupu s uređaja</translation>
<translation id="1499635324672558517">Zatvoriti sve anonimne kartice?</translation>
<translation id="1501480321619201731">Izbriši grupu</translation>
<translation id="1645759014353344461">Grupisano je više kartica (ukupno <ph name="TABS_COUNT_MANY" />)</translation>
<translation id="1713541401465507417">Zatvori sve kartice i grupe</translation>
<translation id="1828808367831369073">Grupisana je <ph name="TABS_COUNT_ONE" /> kartica</translation>
<translation id="2123073051266141035">{INCOGNITO_TABS_COUNT,plural, =1{Zatvorene kartice i grupe možete ponovo otvoriti iz odjeljaka Nedavne kartice i Grupe kartica. Anonimna kartica neće biti dostupna.}one{Zatvorene kartice i grupe možete ponovo otvoriti iz odjeljaka Nedavne kartice i Grupe kartica. # anonimna kartica neće biti dostupna.}few{Zatvorene kartice i grupe možete ponovo otvoriti iz odjeljaka Nedavne kartice i Grupe kartica. # anonimne kartice neće biti dostupne.}other{Zatvorene kartice i grupe možete ponovo otvoriti iz odjeljaka Nedavne kartice i Grupe kartica. # anonimnih kartica neće biti dostupno.}}</translation>
<translation id="2628148780487543078">Zatvori i zakačene kartice</translation>
<translation id="2677748264148917807">Napusti</translation>
<translation id="3547352561153509682">Ovo će izbrisati grupu sa svih uređaja na kojima ste prijavljeni na <ph name="USER_EMAIL" /></translation>
<translation id="381219490185664296">Poništiti grupisanje grupe kartica</translation>
<translation id="4139634748112164403">Kartice će ostati otvorene na uređaju, ali će se grupa trajno izbrisati</translation>
<translation id="4431937619879060901">Odmah ćete izgubiti pristup grupi kartica "<ph name="GROUP_NAME" />", a ona će se izbrisati sa svih vaših uređaja</translation>
<translation id="4460014764210899310">Razgrupiši</translation>
<translation id="4777866634702576038">Izbrisati grupu kartica?</translation>
<translation id="4870911314065352661">Zatvoriti sve kartice?</translation>
<translation id="5094423602314093681">Ukloniti kartice i izbrisati grupu?</translation>
<translation id="5647702255748985085">Napustiti grupu?</translation>
<translation id="742664698522525515">Zadržati grupu?</translation>
<translation id="750886945254958667">Zadržite ovu grupu da kasnije dodate kartice ili je napustite ako joj više ne želite pristupati</translation>
<translation id="8261506727792406068">Izbriši</translation>
<translation id="870736955561925754">Zatvoriti karticu i izbrisati grupu?</translation>
<translation id="8730999928494395583">Vaša aktivnost na ovim anonimnim karticama će se ukloniti s ovog uređaja</translation>
<translation id="8804742093141782941">Zadrži grupu</translation>
<translation id="8887921976452567404">Zatvorene kartice i grupe možete ponovo otvoriti iz odjeljaka Nedavne kartice i Grupe kartica.</translation>
<translation id="9169141410816678175">Svako će odmah izgubiti pristup grupi kartica "<ph name="GROUP_NAME" />", a ona će se izbrisati sa svih uređaja</translation>
<translation id="9216898458513705996">Kartice će ostati otvorene na uređaju, ali će se grupa izbrisati sa svih uređaja na kojima ste prijavljeni na <ph name="USER_EMAIL" /></translation>
<translation id="94870150074703282">Izbrisati grupu?</translation>
