<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1293272072740285747">ट्याबहरू पछि हाल्न यो समूह राखिराख्नुहोस् वा अबदेखि चाहिँदैन भने यसलाई मेटाउनुहोस्।

तपाईंले यो ट्याब समूह हटाउनुभयो भने सबै जना तत्कालै <ph name="TITLE_OF_GROUP" /> नामक ट्याब समूहको एक्सेस गुमाउने छन् र यसलाई सबै डिभाइसहरूबाट मेटाइने छ।</translation>
<translation id="1340839264183302272">समूह छाड्नुहोस्</translation>
<translation id="1419023007528516122">तपाईंले यसो गर्नुभयो भने तपाईंको डिभाइसबाट यो समूह सदाका लागि मेटाइने छ</translation>
<translation id="1499635324672558517">सबै इन्कोग्निटो ट्याबहरू बन्द गर्ने हो?</translation>
<translation id="1501480321619201731">समूह मेट्नुहोस्</translation>
<translation id="1645759014353344461"><ph name="TABS_COUNT_MANY" /> वटा ट्याब समूहबद्ध गरिएका छन्</translation>
<translation id="1713541401465507417">सबै ट्याब र समूहहरू बन्द गर्नुहोस्</translation>
<translation id="1828808367831369073"><ph name="TABS_COUNT_ONE" /> ट्याब समूहबद्ध गरिएको छ</translation>
<translation id="2123073051266141035">{INCOGNITO_TABS_COUNT,plural, =1{तपाईंका बन्द गरिएका ट्याब र समूहहरू "हालसालैका ट्याबहरू" खण्ड र "ट्याब समूहहरू" खण्डमा गई फेरि खोल्न सकिन्छ। तपाईंको इन्कोग्निटो ट्याब उपलब्ध हुने छैन।}other{तपाईंका बन्द गरिएका ट्याब र समूहहरू "हालसालैका ट्याबहरू" खण्ड र "ट्याब समूहहरू" खण्डमा गई फेरि खोल्न सकिन्छ। तपाईंका # वटा इन्कोग्निटो ट्याब उपलब्ध हुने छैनन्।}}</translation>
<translation id="2628148780487543078">पिन गरिएका ट्याबहरू पनि बन्द गर्नुहोस्</translation>
<translation id="2677748264148917807">छोड्नुहोस्</translation>
<translation id="3547352561153509682">यसो गर्नुभयो भने <ph name="USER_EMAIL" /> मा साइन इन गरिएका सबै डिभाइसहरूबाट यो समूह मेटाइने छ</translation>
<translation id="381219490185664296">ट्याबहरू समूहबाट हटाउने हो?</translation>
<translation id="4139634748112164403">यी ट्याबहरू यो डिभाइसमा खुलै रहने छन् तर यो समूह भने सदाका लागि मेटाइने छ</translation>
<translation id="4431937619879060901">तपाईं तुरुन्तै "<ph name="GROUP_NAME" />" ट्याब समूहको एक्सेस गुमाउनु हुने छ र यो ट्याब समूह सबै डिभाइसबाट मेटाइने छ</translation>
<translation id="4460014764210899310">समूह विघटन गर्नुहोस्</translation>
<translation id="4777866634702576038">ट्याब समूह मेटाउने हो?</translation>
<translation id="4870911314065352661">सबै ट्याबहरू बन्द गर्ने हो?</translation>
<translation id="5094423602314093681">ट्याब(हरू) हटाउने र समूह मेटाउने हो?</translation>
<translation id="5647702255748985085">समूह छाड्ने हो?</translation>
<translation id="742664698522525515">समूह राखिराख्ने हो?</translation>
<translation id="750886945254958667">ट्याबहरू पछि हाल्न यो समूह राखिराख्नुहोस् वा तपाईं अबदेखि यो एक्सेस गर्न चाहनुहुन्न भने यसबाट बाहिरिनुहोस्</translation>
<translation id="8261506727792406068">मेट्नुहोस्</translation>
<translation id="870736955561925754">ट्याब बन्द गर्ने र समूह मेटाउने हो?</translation>
<translation id="8730999928494395583">तपाईंले यी इन्कोग्निटो ट्याबबाट गर्नुभएको क्रियाकलापको विवरण यो डिभाइसबाट हटाइने छ</translation>
<translation id="8804742093141782941">समूह राखिराख्नुहोस्</translation>
<translation id="8887921976452567404">तपाईंका बन्द गरिएका ट्याब र समूहहरू "हालसालैका ट्याबहरू" खण्ड र "ट्याब समूहहरू" खण्डमा गई फेरि खोल्न सकिन्छ।</translation>
<translation id="9169141410816678175">सबै जना तुरुन्तै "<ph name="GROUP_NAME" />" ट्याब समूहको एक्सेस गुमाउने छन् र यो ट्याब समूह सबै डिभाइसबाट मेटाइने छ</translation>
<translation id="9216898458513705996">यी ट्याबहरू यो डिभाइसमा खुलै रहने छन् तर <ph name="USER_EMAIL" /> मा साइन इन गरिएका सबै डिभाइसहरूबाट यो समूह मेटाइने छ</translation>
<translation id="94870150074703282">समूह मेटाउने हो?</translation>
</translationbundle>