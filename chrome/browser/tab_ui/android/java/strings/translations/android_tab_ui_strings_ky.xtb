<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="1293272072740285747">Кийинчерээк өтмөктөрдү кошуу үчүн бул топту калтырып, эгер кереги жок болуп калса, өчүрүңүз.

Эгер аны өчүрсөңүз, бардык колдонуучулар "<ph name="TITLE_OF_GROUP" />" өтмөктөр тобуна кирүү мүмкүнчүлүгүнөн дароо ажырап, ал бардык түзмөктөрдөн өчүрүлөт.</translation>
<translation id="1340839264183302272">Топтон чыгуу</translation>
<translation id="1419023007528516122">Бул топ ушуну менен бул түзмөктөн биротоло өчүрүлөт</translation>
<translation id="1499635324672558517">Бардык жашыруун өтмөктөр жабылсынбы?</translation>
<translation id="1501480321619201731">Топту жок кылуу</translation>
<translation id="1645759014353344461"><ph name="TABS_COUNT_MANY" /> өтмөк топтолду</translation>
<translation id="1713541401465507417">Бардык өтмөктөрдү жана топторду жабуу</translation>
<translation id="1828808367831369073"><ph name="TABS_COUNT_ONE" /> өтмөк топтолду</translation>
<translation id="2123073051266141035">{INCOGNITO_TABS_COUNT,plural, =1{Жабылган өтмөктөр менен топторду Акыркы өтмөктөр жана Өтмөк топтору бөлүмүнөн кайра ачууга болот. Жашыруун өтмөк жеткиликсиз болот.}other{Жабылган өтмөктөр менен топторду Акыркы өтмөктөр жана Өтмөк топтору бөлүмүнөн кайра ачууга болот. # жашыруун өтмөк жеткиликсиз болот.}}</translation>
<translation id="2628148780487543078">Кадалган өтмөктөрдү да жабуу</translation>
<translation id="2677748264148917807">Чыгуу</translation>
<translation id="3547352561153509682">Ушуну менен топ <ph name="USER_EMAIL" /> аккаунтуна кирип турган бардык түзмөктөрдөн өчүрүлөт</translation>
<translation id="381219490185664296">Өтмөктөр тобу ажыратылсынбы?</translation>
<translation id="4139634748112164403">Өтмөктөр бул түзмөктө ачык бойдон калып, бирок топ биротоло өчүрүлөт</translation>
<translation id="4431937619879060901">"<ph name="GROUP_NAME" />" өтмөктөр тобуна кирүү мүмкүнчүлүгүнөн дароо ажырап, ал бардык түзмөктөрүңүздөн өчүрүлөт</translation>
<translation id="4460014764210899310">Топтолбосун</translation>
<translation id="4777866634702576038">Өтмөктөр тобу өчүрүлсүнбү?</translation>
<translation id="4870911314065352661">Бардык өтмөктөр жабылсынбы?</translation>
<translation id="5094423602314093681">Өтмөк(-төр) алынып салынып, топ өчүрүлсүнбү?</translation>
<translation id="5647702255748985085">Топтон чыгасызбы?</translation>
<translation id="742664698522525515">Топту калтырасызбы?</translation>
<translation id="750886945254958667">Өтмөктөрдү кийинчерээк кошуу үчүн бул топту калтырып, же ага кирүүнү каалабасаңыз, андан чыгыңыз</translation>
<translation id="8261506727792406068">Жок кылуу</translation>
<translation id="870736955561925754">Өтмөк жабылып, топ өчүрүлсүнбү?</translation>
<translation id="8730999928494395583">Ушул Жашыруун өтмөктөрдө издеген нерселериңиз бул түзмөктөн өчүрүлөт</translation>
<translation id="8804742093141782941">Топту калтыруу</translation>
<translation id="8887921976452567404">Жабылган өтмөктөр менен топторду Акыркы өтмөктөр жана Өтмөк топтору бөлүмүнөн кайра ачууга болот.</translation>
<translation id="9169141410816678175">Бардык колдонуучулар "<ph name="GROUP_NAME" />" өтмөктөр тобуна кирүү мүмкүнчүлүгүнөн дароо ажырап, ал бардык түзмөктөрдөн өчүрүлөт</translation>
<translation id="9216898458513705996">Өтмөктөр бул түзмөктө ачык бойдон калып, бирок топ <ph name="USER_EMAIL" /> аккаунтуна кирип турган бардык түзмөктөрдөн өчүрүлөт</translation>
<translation id="94870150074703282">Топту өчүрөсүзбү?</translation>
</translationbundle>