<!-- Wrapped in a ScrollView so the full disclaimer stays reachable with
     large font sizes or in landscape, where the dialog height is
     constrained. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readaloud_opt_in_dialog_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false">

    <LinearLayout
        android:id="@+id/readaloud_opt_in_dialog_custom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/readaloud_opt_in_illustration"
            android:layout_width="148dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/readaloud_opt_in_illustration"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/readaloud_opt_in_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/readaloud_opt_in_dialog_title"
            android:textAppearance="@style/TextAppearance.Headline.Primary" />

        <TextView
            android:id="@+id/readaloud_opt_in_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/readaloud_opt_in_dialog_message"
            android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
            />
    </LinearLayout>
</ScrollView>
