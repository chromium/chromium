<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/color_primary_with_alpha_5"/>
      <corners
          android:radius="@dimen/readaloud_control_button_corner_radius" />
    </shape>
  </item>
  <item>
    <selector>
      <item
          android:state_focused="true"
          android:left="@dimen/focused_outline_offset"
          android:top="@dimen/focused_outline_offset"
          android:right="@dimen/focused_outline_offset"
          android:bottom="@dimen/focused_outline_offset">
        <shape android:shape="rectangle">
          <solid android:color="@android:color/transparent" />
          <stroke
            android:color="@macro/default_control_color_active"
            android:width="@dimen/focused_outline_stroke_width" />
          <corners
              android:radius="@dimen/readaloud_control_button_focus_ring_corner_radius" />
        </shape>
      </item>
      <item
          android:state_hovered="true"
          android:left="@dimen/focused_outline_offset"
          android:top="@dimen/focused_outline_offset"
          android:right="@dimen/focused_outline_offset"
          android:bottom="@dimen/focused_outline_offset">
        <shape android:shape="rectangle">
          <solid android:color="@color/color_on_surface_with_alpha_8" />
          <corners
              android:radius="@dimen/readaloud_control_button_focus_ring_corner_radius" />
        </shape>
      </item>
      <item android:drawable="@android:color/transparent" />
    </selector>
  </item>
</layer-list>