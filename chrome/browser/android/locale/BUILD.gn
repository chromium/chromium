assert(is_android)

source_set("locale") {
  public = [ "locale_template_url_loader.h" ]

  sources = [ "locale_template_url_loader.cc" ]

  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/search_engines",
  ]

  deps = [
    "//chrome/browser/locale:jni_headers",
    "//chrome/browser/search_engines",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "locale_template_url_loader_unittest.cc" ]
  deps = [
    ":locale",
    "//base",
    "//chrome/browser/search_engines:test_support",
    "//components/search_engines",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

source_set("locale_manager") {
  public = [ "locale_manager.h" ]

  sources = [ "locale_manager.cc" ]

  deps = [
    "//base",
    "//chrome/browser/locale:jni_headers",
  ]
}
