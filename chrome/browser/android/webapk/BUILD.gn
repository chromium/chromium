import("//chrome/android/webapk/shell_apk/request_update_for_version.gni")

source_set("webapk_sources") {
  sources = [
    "webapk_features.cc",
    "webapk_features.h",
    "webapk_handler_delegate.cc",
    "webapk_handler_delegate.h",
    "webapk_helpers.cc",
    "webapk_helpers.h",
    "webapk_info.cc",
    "webapk_info.h",
    "webapk_install_service.h",
    "webapk_installer.h",
    "webapk_metrics.cc",
    "webapk_metrics.h",
    "webapk_post_share_target_navigator.cc",
    "webapk_post_share_target_navigator.h",
    "webapk_registrar.h",
    "webapk_registry_update.cc",
    "webapk_registry_update.h",
    "webapk_ukm_recorder.cc",
    "webapk_ukm_recorder.h",
    "webapk_update_data_fetcher.cc",
    "webapk_update_data_fetcher.h",
  ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/webapps/browser",
    "//skia",
    "//url",
  ]
  deps = [
    "//chrome/android:jni_headers",
    "//chrome/browser/android/webapk/proto",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/web_share_target",
    "//chrome/common:channel_info",
    "//components/crx_file",
    "//components/sync",
    "//components/ukm",
    "//components/webapps/browser",
    "//components/webapps/common",
    "//content/public/browser",
    "//services/metrics/public/cpp:ukm_builders",
    "//third_party/smhasher:murmurhash2",
    "//ui/android",
  ]
  defines = [ "REQUEST_UPDATE_FOR_SHELL_APK_VERSION_VALUE=$request_update_for_shell_apk_version" ]
}

source_set("android_browsertests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "webapk_icons_hasher_browsertest.cc",
    "webapk_installer_browsertest.cc",
    "webapk_restore_task_browsertest.cc",
  ]
  deps = [
    ":webapk_sources",
    "//base/test:test_support",
    "//chrome/browser/android",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//chrome/test/base:android_browser_test",
    "//chrome/test/base:chrome_test_utils",
    "//components/ukm:test_support",
    "//components/webapk:proto",
    "//components/webapps/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//services/network:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/gfx:test_support",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "webapk_database_unittest.cc",
    "webapk_helpers_unittest.cc",
    "webapk_restore_manager_unittest.cc",
    "webapk_sync_bridge_unittest.cc",
  ]
  deps = [
    ":webapk_sources",
    "//base/test:test_support",
    "//chrome/browser/android",
    "//chrome/browser/android/webapk/test:webapk_test_support",
    "//chrome/test:test_support",
    "//components/sync:test_support",
    "//components/webapps/common",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
