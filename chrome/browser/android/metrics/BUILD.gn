if (is_android) {
  import("//build/config/android/rules.gni")
  import("//third_party/jni_zero/jni_zero.gni")

  _jni_sources = [
    "java/src/org/chromium/chrome/browser/metrics/AndroidSessionDurationsServiceState.java",
    "java/src/org/chromium/chrome/browser/metrics/AppUpdateInfoUtils.java",
    "java/src/org/chromium/chrome/browser/metrics/ChromeStatsLogHelper.java",
  ]

  android_library("base_java") {
    srcjar_deps = [ ":base_jni_headers" ]
    sources = [
      "java/src/org/chromium/chrome/browser/metrics/SimpleStartupForegroundSessionDetector.java",
      "java/src/org/chromium/chrome/browser/metrics/UmaUtils.java",
    ]
    deps = [
      "//base:base_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/jni_zero:jni_zero_java",
    ]
  }

  android_library("java") {
    srcjar_deps = [ ":jni_headers" ]
    sources = [ "java/src/org/chromium/chrome/browser/metrics/MainIntentBehaviorMetrics.java" ]
    sources += _jni_sources

    deps = [
      ":chrome_stats_log_java",
      "//base:base_java",
      "//base:service_loader_java",
      "//chrome/browser/browsing_data/android:java",
      "//chrome/browser/preferences:java",
      "//chrome/browser/profiles/android:java",
      "//chrome/browser/ui/android/default_browser_promo:java",
      "//components/ukm/android:java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/jni_zero:jni_zero_java",
    ]

    public_deps = [ ":delegate_java" ]
  }

  android_library("delegate_java") {
    sources = [
      "java/src/org/chromium/chrome/browser/metrics/AppUpdateInfoDelegate.java",
    ]
  }

  android_library("chrome_stats_log_java") {
    sources =
        [ "java/src/org/chromium/chrome/browser/metrics/ChromeStatsLog.java" ]
    alternative_android_sdk_dep =
        "//third_party/android_sdk:public_framework_system_java"
    proguard_configs = [ "chrome_stats_log_proguard.flags" ]
    deps = [ "//third_party/androidx:androidx_annotation_annotation_java" ]
  }

  generate_jni("base_jni_headers") {
    sources = [ "java/src/org/chromium/chrome/browser/metrics/UmaUtils.java" ]
  }

  generate_jni("jni_headers") {
    sources = _jni_sources
  }
}
