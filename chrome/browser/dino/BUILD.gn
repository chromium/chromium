source_set("dino") {
  public = [
    "dino_features.h",
    "dino_metrics.h",
  ]
  sources = [
    "dino_features.cc",
    "dino_metrics.cc",
  ]
  public_deps = [
    "//base",
    "//ui/base",
  ]

  if (is_win || is_mac || is_linux) {
    public += [
      "dino_bookmark_iph_controller.h",
      "dino_bookmark_metrics_service.h",
      "dino_bookmark_metrics_service_factory.h",
      "dino_prefs.h",
    ]
    sources += [
      "dino_bookmark_iph_controller.cc",
      "dino_bookmark_metrics_service.cc",
      "dino_bookmark_metrics_service_factory.cc",
      "dino_prefs.cc",
    ]
    public_deps += [
      "//chrome/browser/profiles:profile",
      "//components/keyed_service/core",
    ]
    deps = [
      "//chrome/app:branded_strings",
      "//chrome/browser/bookmarks",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/user_education",
      "//components/bookmarks/browser",
      "//components/bookmarks/common",
      "//components/feature_engagement/public",
      "//components/pref_registry",
      "//components/prefs",
      "//components/user_education/common",
      "//url",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "dino_features_unittest.cc",
    "dino_metrics_unittest.cc",
  ]
  deps = [
    ":dino",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/base",
  ]

  if (is_win || is_mac || is_linux) {
    sources += [
      "dino_bookmark_iph_controller_unittest.cc",
      "dino_bookmark_metrics_service_unittest.cc",
      "dino_prefs_unittest.cc",
    ]
    deps += [
      "//base",
      "//chrome/browser/bookmarks",
      "//chrome/test:test_support",
      "//components/bookmarks/browser",
      "//components/bookmarks/common",
      "//components/bookmarks/test",
      "//components/pref_registry",
      "//components/prefs",
      "//components/sync_preferences:test_support",
      "//content/test:test_support",
      "//url",
    ]
  }
}
