import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/webui_features.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "webui_toolbar"

  static_files = [
    "webui_toolbar.html",
    "webui_toolbar.css",
  ]

  ts_files = [
    "app.html.ts",
    "app_menu_button.html.ts",
    "app_menu_button.ts",
    "app.ts",
    "avatar_button.html.ts",
    "avatar_button.ts",
    "back_forward_button.html.ts",
    "back_forward_button.ts",
    "battery_saver_button.html.ts",
    "battery_saver_button.ts",
    "browser_proxy.ts",
    "content_setting_icon.html.ts",
    "content_setting_icon.ts",
    "content_settings_icons.html.ts",
    "content_settings_icons.ts",
    "cr_lazy_iconset.ts",
    "extension.html.ts",
    "extension.ts",
    "extensions.html.ts",
    "extensions.ts",
    "page_action_icon.html.ts",
    "page_action_icon.ts",
    "page_action_icons.html.ts",
    "page_action_icons.ts",
    "home_button.html.ts",
    "home_button.ts",
    "icons.ts",
    "location_bar.ts",
    "location_bar.html.ts",
    "location_icon.ts",
    "location_icon.html.ts",
    "metrics_recorder.ts",
    "performance_intervention_button.html.ts",
    "performance_intervention_button.ts",
    "pinned_toolbar_action.html.ts",
    "pinned_toolbar_action.ts",
    "pinned_toolbar_actions.html.ts",
    "pinned_toolbar_actions.ts",
    "pointer_proxy.ts",
    "readonly_omnibox.ts",
    "readonly_omnibox.html.ts",
    "reload_button.html.ts",
    "reload_button.ts",
    "selected_keyword.ts",
    "selected_keyword.html.ts",
    "split_tabs_button.html.ts",
    "split_tabs_button.ts",
    "timer_helper.ts",
    "toolbar_action_mixin.ts",
    "toolbar_action_container_mixin.ts",
    "toolbar_button.ts",
    "toolbar_chip_button.html.ts",
    "toolbar_chip_button.ts",
    "toolbar_divider.html.ts",
    "toolbar_divider.ts",
  ]

  if (is_chrome_branded) {
    ts_files += [ "internal/icons.ts" ]
  }

  css_files = [
    "app.css",
    "app_menu_button.css",
    "avatar_button.css",
    "back_forward_button.css",
    "content_setting_icon.css",
    "content_settings_icons.css",
    "extensions.css",
    "page_action_icon.css",
    "page_action_icons.css",
    "home_button.css",
    "location_bar.css",
    "location_icon.css",
    "performance_intervention_button.css",
    "pinned_toolbar_actions.css",
    "readonly_omnibox.css",
    "reload_button.css",
    "selected_keyword.css",
    "toolbar_button.css",
    "toolbar_chip_button.css",
    "toolbar_divider.css",
  ]

  # ts_composite is needed for JS tests to depend on this.
  ts_composite = true
  webui_context_type = "trusted"
  optimize = optimize_webui
  generate_code_cache = enable_webui_generate_code_cache
  if (optimize) {
    optimize_webui_host = "webui-toolbar.top-chrome"
    optimize_webui_in_files = [ "app.js" ]
    optimize_webui_external_paths = [
      "chrome://webui-toolbar.top-chrome|" +
          rebase_path(
              "$root_gen_dir/chrome/browser/resources/webui_toolbar/tsc",
              root_build_dir),
      "/shared|" + rebase_path(
              "$root_gen_dir/chrome/browser/resources/webui_toolbar_shared/tsc",
              root_build_dir),
    ]
  }

  ts_definitions = [
    "//tools/typescript/definitions/chrome_histograms.d.ts",
    "//tools/typescript/definitions/chrome_send.d.ts",
    "//tools/typescript/definitions/chrome_timeticks.d.ts",
    "//tools/typescript/definitions/metrics_private.d.ts",
    "//tools/typescript/definitions/pending.d.ts",
  ]

  ts_deps = [
    "../webui_toolbar_shared:build_ts",
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/cr_components/help_bubble:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps = [
    "//components/content_settings/core/common:content_settings_types_ts__generator",
    "//ui/base/dragdrop/mojom:mojom_ts__generator",
  ]

  mojo_files = [
    "$root_gen_dir/components/content_settings/core/common/content_settings_types.mojom-webui.ts",
    "$root_gen_dir/ui/base/dragdrop/mojom/drag_drop_types.mojom-webui.ts",
  ]

  ts_path_mappings =
      [ "/shared/*|" + rebase_path(
            "$root_gen_dir/chrome/browser/resources/webui_toolbar_shared/tsc/*",
            target_gen_dir) ]
}
