import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "context_hub"

  static_files = [
    "context_hub.html",
    "save_to_memory_bank.html",
  ]

  ts_files = [
    "app.html.ts",
    "app.ts",
    "icons.html.ts",
    "memory_bank_chat/memory_bank_chat.html.ts",
    "memory_bank_chat/memory_bank_chat.ts",
    "memory_banks/memory_banks.html.ts",
    "memory_banks/memory_banks.ts",
    "memory_banks/memory_banks_edit_dialog.html.ts",
    "memory_banks/memory_banks_edit_dialog.ts",
    "memory_banks/memory_banks_entry.html.ts",
    "memory_banks/memory_banks_search.ts",
    "save_to_memory_bank/save_to_memory_bank.html.ts",
    "save_to_memory_bank/save_to_memory_bank.ts",
    "smart_search/smart_search.html.ts",
    "smart_search/smart_search.ts",
    "tab_groups/tab_groups.html.ts",
    "tab_groups/tab_groups.ts",
    "taskbox/ai_taskbox.html.ts",
    "taskbox/ai_taskbox.ts",
    "taskbox/todo_item.html.ts",
    "taskbox/todo_item.ts",
    "topics/topic_card.html.ts",
    "topics/topic_card.ts",
    "topics/topics_view.html.ts",
    "topics/topics_view.ts",
  ]

  css_files = [
    "app.css",
    "memory_bank_chat/memory_bank_chat.css",
    "memory_banks/memory_banks.css",
    "memory_banks/memory_banks_edit_dialog.css",
    "save_to_memory_bank/save_to_memory_bank.css",
    "smart_search/smart_search.css",
    "tab_groups/tab_groups.css",
    "taskbox/ai_taskbox.css",
    "taskbox/todo_item.css",
    "topics/topic_card.css",
    "topics/topics_view.css",
  ]

  mojo_files_deps =
      [ "//chrome/browser/ui/webui/context_hub:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/context_hub/context_hub.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
