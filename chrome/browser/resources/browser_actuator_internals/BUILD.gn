import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "browser_actuator_internals"

  static_files = [ "browser_actuator_internals.html" ]

  css_files = [ "app.css" ]

  ts_files = [
    "app.html.ts",
    "app.ts",
  ]

  mojo_files_deps = [
    "//chrome/browser/browser_actuator/internals:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/browser_actuator/internals/browser_actuator_internals.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  ts_composite = true
  webui_context_type = "trusted"
}
