{
  "name": "AIM Eligibility Component Extension",
  "version": "1.0",
  "manifest_version": 3,
  "key": "",
  "host_permissions": [
    "chrome://resources/*",
    "chrome://theme/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' chrome://resources; object-src 'self';"
  }
}
