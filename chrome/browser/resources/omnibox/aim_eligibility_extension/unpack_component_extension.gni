# Unpacks a component extension into a standalone directory by reading the .grd
# file generated by build_webui().
#
# Parameters:
#   in_grd (required):
#     Path to the input .grd file generated by build_webui().
#
#   out_folder (required):
#     Destination folder for the unpacked extension files.
#
#   deps (required):
#     Dependencies that build the .grd file (e.g. [ ":resources" ]).
#
#   grd_resource_path_prefix (optional):
#     Prefix to strip from the resource_path attributes in the .grd file when
#     writing to out_folder (e.g. "aim_eligibility_extension"). This should
#     match the grd_resource_path_prefix passed to build_webui().
#
#   outputs (optional):
#     Representative output files produced by unpacking.
#     Defaults to [ "$out_folder/manifest.json" ].
template("unpack_component_extension") {
  assert(defined(invoker.in_grd), "in_grd must be defined")
  assert(defined(invoker.out_folder), "out_folder must be defined")
  assert(defined(invoker.deps), "deps must be defined")

  action(target_name) {
    forward_variables_from(invoker,
                           [
                             "deps",
                             "inputs",
                             "testonly",
                             "visibility",
                           ])

    script = "//chrome/browser/resources/omnibox/aim_eligibility_extension/unpack_component_extension.py"

    depfile = "$target_gen_dir/${target_name}.d"

    outputs = [ "${invoker.out_folder}/manifest.json" ]
    if (defined(invoker.outputs)) {
      outputs = invoker.outputs
    }

    args = [
      "--in-grd",
      rebase_path(invoker.in_grd, root_build_dir),
      "--out-folder",
      rebase_path(invoker.out_folder, root_build_dir),
      "--root-gen-dir",
      rebase_path(root_gen_dir, root_build_dir),
      "--root-src-dir",
      rebase_path("//", root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),
      "--stamp",
      rebase_path(outputs[0], root_build_dir),
    ]

    if (defined(invoker.grd_resource_path_prefix)) {
      args += [
        "--grd-resource-path-prefix",
        invoker.grd_resource_path_prefix,
      ]
    }
  }
}
