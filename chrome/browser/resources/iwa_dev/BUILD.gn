import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "iwa_dev"

  static_files = [ "iwa_dev.html" ]

  css_files = [
    "app.css",
    "install_dialog.css",
    "installed_app_list_item.css",
  ]

  ts_files = [
    "app.html.ts",
    "app.ts",
    "install_dev_proxy_tab.html.ts",
    "install_dev_proxy_tab.ts",
    "install_dialog.html.ts",
    "install_dialog.ts",
    "install_tab.ts",
    "installed_app_list_item.html.ts",
    "installed_app_list_item.ts",
  ]

  mojo_files_deps =
      [ "//chrome/browser/ui/webui/iwa_dev:mojo_bindings_ts__generator" ]
  mojo_files =
      [ "$root_gen_dir/chrome/browser/ui/webui/iwa_dev/iwa_dev.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  ts_composite = true
  webui_context_type = "trusted"
}
