import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "visual_guided_setter"

  static_files = [
    "visual_guided_setter.html",
    "visual_guided_setter.css",
  ]

  ts_files = [ "visual_guided_setter.ts" ]

  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/default_browser/visual_guided_setter.mojom-webui.ts" ]
  mojo_files_deps = [ "//chrome/browser/ui/webui/default_browser:visual_guided_setter_mojo_bindings_ts__generator" ]

  ts_deps = [
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
