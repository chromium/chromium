import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "tab_group_shared"
  grd_resource_path_prefix = "tab_group_shared"

  ts_files = [
    "tab_group_color_helper.ts",
    "tab_group_dot.html.ts",
    "tab_group_dot.ts",
  ]
  css_files = [
    "tab_group_dot.css",
    "tab_group_shared_vars.css",
  ]

  ts_composite = true
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  mojo_files_deps =
      [ "//components/tab_groups/public/mojom:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/components/tab_groups/public/mojom/tab_group_types.mojom-webui.ts" ]

  webui_context_type = "trusted"
}
