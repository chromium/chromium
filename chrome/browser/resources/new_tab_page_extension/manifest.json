{
  "name": "New Tab Page",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Experimental New Tab Page.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "new_tab_page.html"
  },
  "permissions": [
    "favicon",
    "metricsPrivate"
  ],
  "host_permissions": [
    "chrome://image/*",
    "chrome://resources/*",
    "chrome://theme/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' chrome://resources; object-src 'self';"
  }
}
