import("//chrome/common/features.gni")
import("//tools/grit/preprocess_if_expr.gni")
import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/bundle_js.gni")
import("//ui/webui/resources/tools/bundle_js_excludes.gni")

action("rewrite_mojo_imports") {
  visibility = [ ":*" ]
  script = "//chrome/browser/resources/rewrite_imports.py"

  inputs = [
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks_internals.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks_types.mojom-webui.ts",
    "$root_gen_dir/ui/webui/resources/cr_components/composebox/composebox.mojom-webui.ts",
  ]

  outputs = [
    "$target_gen_dir/mojo/contextual_tasks.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_internals.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_types.mojom-webui.ts",
    "$target_gen_dir/mojo/composebox.mojom-webui.ts",
  ]

  deps = [
    "//chrome/browser/contextual_tasks:mojo_bindings_ts__generator",
    "//ui/webui/resources/cr_components/composebox:mojo_bindings_ts__generator",
  ]

  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    rebase_path(inputs[1], root_build_dir),
    rebase_path(outputs[1], root_build_dir),
    rebase_path(inputs[2], root_build_dir),
    rebase_path(outputs[2], root_build_dir),
    rebase_path(inputs[3], root_build_dir),
    rebase_path(outputs[3], root_build_dir),
  ]
}

preprocess_if_expr("preprocess_background") {
  visibility = [ ":build_background_ts" ]
  defines = chrome_grit_defines
  in_folder = "."
  out_folder = "$target_gen_dir/preprocessed_background"
  in_files = [ "background.ts" ]
}

ts_library("build_background_ts") {
  root_dir = "$target_gen_dir/preprocessed_background"
  out_dir = "$target_gen_dir/background"
  in_files = [ "background.ts" ]
  composite = true
  deps = [
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  extra_deps = [ ":preprocess_background" ]
  path_mappings =
      [ "chrome://contextual-tasks/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc/*",
            target_gen_dir) ]
  definitions = [
    "contextual_tasks_private.d.ts",
    "//tools/typescript/definitions/chrome_event.d.ts",
    "//tools/typescript/definitions/chrome_histograms.d.ts",
    "//tools/typescript/definitions/metrics_private.d.ts",
    "//tools/typescript/definitions/runtime.d.ts",
    "//tools/typescript/definitions/tabs.d.ts",
  ]
}

bundle_js("bundle_background") {
  host = "chrome-extension://glbjnfimcajjenihimblfaponejbkoph"
  input = rebase_path("$target_gen_dir/background", root_build_dir)
  js_module_in_files = [ "background.js" ]
  out_folder = "$target_gen_dir/background_bundled"
  deps = [
    ":build_background_ts",
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//mojo/public/js:bindings_module",
    "//ui/webui/resources/mojo:build_ts",
  ]
  external_paths = [
    "chrome://resources/mojo/mojo/public/js/|" +
        rebase_path("$root_gen_dir/mojo/public/js", root_build_dir),
    "//resources/mojo/mojo/public/js/|" +
        rebase_path("$root_gen_dir/mojo/public/js", root_build_dir),
    "chrome://resources/mojo/|" +
        rebase_path("$root_gen_dir/ui/webui/resources/tsc/mojo",
                    root_build_dir),
    "//resources/mojo/|" +
        rebase_path("$root_gen_dir/ui/webui/resources/tsc/mojo",
                    root_build_dir),
    "chrome://contextual-tasks/|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc",
            root_build_dir),
  ]
}

generate_grd("build_background_grdp") {
  grd_prefix = "contextual_tasks_extension"
  out_grd = "$target_gen_dir/background_resources.grdp"
  resource_path_prefix = "contextual_tasks_extension"
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  input_files = [ "background_bundled/background.rollup.js" ]
  resource_path_rewrites =
      [ "background_bundled/background.rollup.js|background.js" ]
  deps = [ ":bundle_background" ]
}

