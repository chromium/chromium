import("//ui/webui/resources/tools/build_webui.gni")
import("//ui/webui/resources/tools/bundle_js.gni")
import("//ui/webui/resources/tools/bundle_js_excludes.gni")

action("rewrite_mojo_imports") {
  visibility = [ ":*" ]
  script = "//chrome/browser/resources/rewrite_imports.py"

  inputs = [
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks_internals.mojom-webui.ts",
    "$root_gen_dir/chrome/browser/contextual_tasks/contextual_tasks_types.mojom-webui.ts",
    "$root_gen_dir/ui/webui/resources/cr_components/composebox/composebox.mojom-webui.ts",
  ]

  outputs = [
    "$target_gen_dir/mojo/contextual_tasks.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_internals.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_types.mojom-webui.ts",
    "$target_gen_dir/mojo/composebox.mojom-webui.ts",
  ]

  deps = [
    "//chrome/browser/contextual_tasks:mojo_bindings_ts__generator",
    "//ui/webui/resources/cr_components/composebox:mojo_bindings_ts__generator",
  ]

  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    rebase_path(inputs[1], root_build_dir),
    rebase_path(outputs[1], root_build_dir),
    rebase_path(inputs[2], root_build_dir),
    rebase_path(outputs[2], root_build_dir),
    rebase_path(inputs[3], root_build_dir),
    rebase_path(outputs[3], root_build_dir),
  ]
}

ts_library("build_background_ts") {
  root_dir = "."
  out_dir = "$target_gen_dir/background"
  in_files = [ "background.ts" ]
  definitions = [
    "contextual_tasks_private.d.ts",
    "//tools/typescript/definitions/runtime.d.ts",
    "//tools/typescript/definitions/tabs.d.ts",
    "//tools/typescript/definitions/chrome_event.d.ts",
  ]
}

generate_grd("build_background_grdp") {
  grd_prefix = "contextual_tasks_extension"
  out_grd = "$target_gen_dir/background_resources.grdp"
  manifest_files = [ "$target_gen_dir/build_background_ts_manifest.json" ]
  resource_path_prefix = "contextual_tasks_extension"
  deps = [ ":build_background_ts" ]
}

ts_library("build_post_message_handler_ts") {
  root_dir = "."
  out_dir = "$target_gen_dir/post_message_handler"
  in_files = [
    "post_message_entrypoint.ts",
    "post_message_handler.ts",
  ]
  composite = true
  deps = [
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  path_mappings =
      [ "chrome://contextual-tasks/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc/*",
            target_gen_dir) ]
}

bundle_js("bundle_post_message_handler") {
  host = "chrome-extension://glbjnfimcajjenihimblfaponejbkoph"
  input = rebase_path("$target_gen_dir/post_message_handler", root_build_dir)
  js_module_in_files = [ "post_message_handler.js" ]
  out_folder = "$target_gen_dir/post_message_handler_bundled"
  excludes = BUNDLE_JS_EXCLUDES
  deps = [
    ":build_post_message_handler_ts",
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  external_paths =
      [ "chrome://contextual-tasks/|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc",
            root_build_dir) ]
}

bundle_js("bundle_post_message_entrypoint") {
  host = "chrome-extension://glbjnfimcajjenihimblfaponejbkoph"
  input = rebase_path("$target_gen_dir/post_message_handler", root_build_dir)
  js_module_in_files = [ "post_message_entrypoint.js" ]
  out_folder = "$target_gen_dir/post_message_entrypoint_bundled"
  excludes = BUNDLE_JS_EXCLUDES
  deps = [
    ":build_post_message_handler_ts",
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  external_paths =
      [ "chrome://contextual-tasks/|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc",
            root_build_dir) ]
}

generate_grd("build_post_message_handler_grdp") {
  grd_prefix = "contextual_tasks_extension"
  out_grd = "$target_gen_dir/post_message_handler_resources.grdp"
  resource_path_prefix = "contextual_tasks_extension"
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  input_files = [
    "post_message_entrypoint_bundled/post_message_entrypoint.rollup.js",
    "post_message_handler_bundled/post_message_handler.rollup.js",
  ]
  resource_path_rewrites = [
    "post_message_entrypoint_bundled/post_message_entrypoint.rollup.js|post_message_entrypoint.js",
    "post_message_handler_bundled/post_message_handler.rollup.js|post_message_handler.js",
  ]
  deps = [
    ":bundle_post_message_entrypoint",
    ":bundle_post_message_handler",
  ]
}

bundle_js("bundle_tab_picker") {
  host = "chrome-extension://glbjnfimcajjenihimblfaponejbkoph"
  input = rebase_path("$target_gen_dir/tsc", root_build_dir)
  js_module_in_files = [ "tab_picker.js" ]
  out_folder = "$target_gen_dir/tab_picker_bundled"
  excludes = BUNDLE_JS_EXCLUDES
  deps = [ ":build_ts" ]
  external_paths =
      [ "chrome://contextual-tasks/|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc",
            root_build_dir) ]
}

generate_grd("build_tab_picker_grdp") {
  grd_prefix = "contextual_tasks_extension"
  out_grd = "$target_gen_dir/tab_picker_resources.grdp"
  resource_path_prefix = "contextual_tasks_extension"
  input_files_base_dir = rebase_path(target_gen_dir, root_build_dir)
  input_files = [ "tab_picker_bundled/tab_picker.rollup.js" ]
  resource_path_rewrites = [
    "tab_picker_bundled/tab_picker.rollup.js|tab_picker.js",
  ]
  deps = [ ":bundle_tab_picker" ]
}

build_webui("build") {
  grd_prefix = "contextual_tasks_extension"
  grd_resource_path_prefix = "contextual_tasks_extension"
  ts_composite = true

  in_folder = "."

  static_files = [
    "chip.html",
    "favicons.html",
    "lens_button.html",
    "manifest.json",
    "tab_picker.html",
  ]

  extra_grdp_deps = [
    ":build_background_grdp",
    ":build_post_message_handler_grdp",
    ":build_tab_picker_grdp",
  ]
  extra_grdp_files = [
    "$target_gen_dir/background_resources.grdp",
    "$target_gen_dir/post_message_handler_resources.grdp",
    "$target_gen_dir/tab_picker_resources.grdp",
  ]

  ts_files = [
    "favicons_app.html.ts",
    "favicons_app.ts",
    "lens_button_app.html.ts",
    "lens_button_app.ts",
    "tab_picker.ts",
    "tab_picker_app.html.ts",
    "tab_picker_app.ts",
    "tab_picker_browser_proxy.ts",
  ]

  css_files = [
    "favicons_app.css",
    "lens_button_app.css",
    "tab_picker_app.css",
  ]

  ts_deps = [
    "//chrome/browser/resources/contextual_tasks:build_ts",
    "//chrome/browser/resources/guest_view_shared:build_ts",
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/composebox:build_ts",
    "//ui/webui/resources/cr_components/help_bubble:build_ts",
    "//ui/webui/resources/cr_components/localized_link:build_ts",
    "//ui/webui/resources/cr_components/search:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  mojo_files_deps = [ ":rewrite_mojo_imports" ]
  mojo_files = [
    "$target_gen_dir/mojo/contextual_tasks.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_internals.mojom-webui.ts",
    "$target_gen_dir/mojo/contextual_tasks_types.mojom-webui.ts",
    "$target_gen_dir/mojo/composebox.mojom-webui.ts",
  ]

  ts_path_mappings = [
    "chrome://contextual-tasks/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc/*",
            target_gen_dir),
    "/shared/guest_view/*|" + rebase_path(
            "$root_gen_dir/chrome/browser/resources/guest_view_shared/tsc/*",
            target_gen_dir),
  ]

  webui_context_type = "trusted_only"

  # Force optimization (bundling) even in debug builds to avoid having to
  # package all parent UI files individually in the extension.
  optimize = true
  optimize_webui_host = "chrome-extension://glbjnfimcajjenihimblfaponejbkoph"
  optimize_webui_in_files = [
    "favicons_app.js",
    "lens_button_app.js",
  ]

  optimize_webui_external_paths =
      [ "chrome://contextual-tasks/|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/contextual_tasks/tsc",
            root_build_dir) ]
}
