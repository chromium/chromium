{
  "name": "Contextual Tasks",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Provides Contextual Tasks Private APIs",
  "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC8ZtnRT6hXtjtG5XM7TcKakx9J+37WuK1g1cx2IOh9enerA5VlQBcoHSpGOx5xzebQLxzUtURmNQXSrhOac/z9SVUhHrXrtnBS4ftIUfagTDroowh1b23pIusQaLKprhkS8iFr0nw887BV+yh9LQ7J90qDNzukXn0ss6ZVMxgcaQIDAQAB",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextualTasksPrivate",
    "metricsPrivate",
    "favicon"
  ],
  "host_permissions": [
    "chrome://resources/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' chrome://resources; object-src 'self';"
  },
  "externally_connectable": {
    // LINT.IfChange(AllowedOrigins)
    "matches": [
      "https://google.com/search*",
      "https://www.google.com/search*",
      "https://*.borg.google.com/search*",
      "https://*.corp.google.com/search*",
      "https://*.prod.google.com/search*"
    ]
    // LINT.ThenChange(post_message_handler.ts:AllowedOrigins)
  },
  "web_accessible_resources": [
    {
      // The Search page mounts each of these by hardcoded URL, so the
      // filenames are a contract. Renaming one here without renaming it
      // there leaves Search mounting an iframe for a document that does
      // not exist, which fails silently.
      // LINT.IfChange(SearchMountedResources)
      "resources": [
        "context_library.html",
        "lens_button.html",
        "lens_chip.html",
        "tab_picker.html"
      ],
      // LINT.ThenChange(
      //   //depot/google3/java/com/google/search/next/aim/ui/chrome/cobrowse/context_library.sfc.tsx,
      //   //depot/google3/java/com/google/search/next/aim/ui/chrome/cobrowse/lens_button.sfc.tsx,
      //   //depot/google3/java/com/google/search/next/aim/ui/chrome/cobrowse/lens_chip.sfc.tsx,
      //   //depot/google3/java/com/google/search/next/aim/ui/chrome/cobrowse/tab_picker_menu_item.sfc.tsx
      // )
      // LINT.IfChange(WebAccessibleMatches)
      "matches": [
        "https://*.google.com/*",
        "https://*.corp.google.com/*",
        "https://*.prod.google.com/*",
        "https://*.googlers.com/*"
// <if expr="not is_official_build">
        ,"http://localhost/*",
        "file:///*"
// </if>
      ]
      // LINT.ThenChange(post_message_handler.ts:AllowedOrigins)
    }
  ]
}
