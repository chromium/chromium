import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "critical_actions"

  static_files = [
    "index.html",
    "index.css",
  ]

  ts_files = [
    "action_row.ts",
    "action_row.html.ts",
    "app.ts",
    "app.html.ts",
  ]

  css_files = [
    "action_row.css",
    "app.css",
  ]

  mojo_files_deps = [
    "//chrome/browser/ui/webui/critical_actions:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/critical_actions/critical_actions.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
}
