source_set("unit_tests") {
  testonly = true

  sources = [ "sharesheet_client_unittest.cc" ]

  deps = [
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/sharesheet",
    "//chrome/browser/webshare",
    "//chrome/browser/webshare:storage",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/enterprise/isolated_mode",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (is_chromeos) {
    deps += [ "//chrome/browser/ash/file_manager" ]
  }
}
