if (!is_android) {
  source_set("browser_tests") {
    testonly = true

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "pdf_find_request_manager_browsertest.cc" ]

    deps = [
      ":pdf",
      ":pdf_extension_test_utils",
      "//base",
      "//build/config/coverage:buildflags",
      "//chrome/browser/pdf:pdf_extension_test_base",
      "//chrome/browser/ui",
      "//chrome/browser/ui/pdf",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/user_education:impl",
      "//components/pdf/browser",
      "//components/pdf/common:constants",
      "//components/pdf/common:util",
      "//content/public/browser",
      "//content/public/common",
      "//content/test:test_support",
      "//extensions/browser/mime_handler",
      "//extensions/browser/mime_handler:stream_container",
      "//pdf:features",
      "//pdf/loader",
      "//testing/gtest",
      "//ui/base/clipboard:clipboard_test_support",
    ]

    if (enable_pdf) {
      sources += [
        "pdf_extension_accessibility_test.cc",
        "pdf_extension_download_test.cc",
        "pdf_extension_js_test.cc",
        "pdf_extension_test.cc",
      ]
      deps += [
        "//chrome/browser/download:test_support",
        "//chrome/browser/permissions",
        "//chrome/browser/screen_ai:screen_ai_install_state",
        "//chrome/browser/screen_ai:screen_ai_service_router_factory",
        "//services/screen_ai/public/cpp:utilities",
        "//ui/accessibility:test_support",
      ]

      if (enable_printing) {
        sources += [ "pdf_extension_printing_test.cc" ]
        deps += [
          "//chrome/browser/printing",
          "//chrome/browser/printing:test_support",
        ]

        if (is_chromeos) {
          deps += [ "//chrome/browser/ash/printing:test_support" ]
        }
      }

      if (enable_pdf_save_to_drive) {
        deps += [ "//chrome/browser/save_to_drive:browser_tests" ]
      }
    }

    if (enable_screen_ai_browsertests) {
      sources += [ "pdf_searchify_browsertest.cc" ]
      deps += [
        "//chrome/browser/screen_ai:screen_ai_install_state",
        "//chrome/browser/ui/user_education",
        "//components/feature_engagement/public",
        "//components/metrics:content",
        "//components/pdf/browser",
        "//services/screen_ai/public/cpp:utilities",
        "//ui/accessibility",
      ]

      # Notifies testing builders that this test needs the ScreenAI library,
      # downloaded from CIPD as defined in //DEPS.
      data_deps = [ "//third_party/screen-ai:screen_ai" ]
    }
  }

  source_set("interactive_ui_tests") {
    testonly = true

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "pdf_extension_interactive_uitest.cc" ]

    deps = [
      ":pdf_extension_test_utils",
      "//base",
      "//chrome/app:command_ids",
      "//chrome/browser/extensions:test_support",
      "//chrome/browser/pdf:pdf_extension_test_base",
      "//chrome/browser/renderer_context_menu:test_support",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/pdf/browser",
      "//content/public/browser",
      "//content/test:test_support",
      "//extensions/browser",
      "//pdf:features",
      "//testing/gtest",
      "//ui/events",
      "//ui/gfx/geometry",
    ]
  }
}
