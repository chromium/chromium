<!-- "Gemini actions" panel shown below a history row when expanded. It's
     clickable so that taps on it don't collapse it like taps on the row. It's
     not exposed to screen readers, which read its labels as part of the row
     instead. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/critical_actions_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:paddingStart="@dimen/critical_actions_panel_padding_start"
    android:paddingBottom="@dimen/critical_actions_panel_padding_bottom">

    <TextView
        android:id="@+id/critical_actions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/critical_action_padding"
        android:paddingEnd="@dimen/critical_action_padding"
        android:paddingTop="@dimen/critical_actions_title_padding_top"
        android:paddingBottom="@dimen/critical_action_padding"
        android:text="@string/history_critical_actions_title"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />

    <LinearLayout
        android:id="@+id/critical_actions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
