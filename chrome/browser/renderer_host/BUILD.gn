import("//extensions/buildflags/buildflags.gni")

source_set("renderer_host") {
  sources = [
    "chrome_navigation_ui_data.cc",
    "chrome_navigation_ui_data.h",
  ]
  public_deps = [
    "//chrome/common",
    "//components/actor/core:task_id",
    "//components/offline_pages/buildflags",
    "//components/offline_pages/core/request_header",
    "//content/public/browser",
    "//extensions/buildflags",
  ]
  deps = [
    "//chrome/browser/actor",
    "//chrome/browser/preloading/prefetch/no_state_prefetch",
  ]

  if (enable_extensions) {
    public_deps += [ "//extensions/browser" ]
  }

  if (is_android) {
    sources += [ "android/chrome_navigation_ui_data_android.cc" ]
    deps += [ "//chrome/android:chrome_jni_headers" ]
  }
}

if (is_mac) {
  import("//build/config/mac/rules.gni")
  import("//build/util/branding.gni")

  # Because browser and PWA share the same history swiper code.
  # Add a new target so that browser and PWA can have the same DEPS.
  source_set("history_swiper") {
    sources = [
      "chrome_render_widget_host_view_mac_history_swiper.h",
      "chrome_render_widget_host_view_mac_history_swiper.mm",
    ]

    frameworks = [ "Cocoa.framework" ]

    deps = [
      "//chrome/browser/ui",
      "//chrome/browser/ui/cocoa",
      "//third_party/blink/public/common:headers",
    ]
  }

  source_set("history_swiping_control") {
    sources = [
      "chrome_render_widget_host_view_mac_history_swiping_control.cc",
      "chrome_render_widget_host_view_mac_history_swiping_control.h",
    ]
    deps = [
      "//base",
      "//content/public/browser",
    ]
  }

  source_set("delegate") {
    sources = [ "chrome_render_widget_host_view_mac_delegate.h" ]
    public_deps = [ "//content/public/browser" ]
  }

  source_set("unit_tests") {
    testonly = true
    sources =
        [ "chrome_render_widget_host_view_mac_history_swiper_unittest.mm" ]
    deps = [
      ":history_swiper",
      ":history_swiping_control",
      "//base",
      "//chrome/test:test_support",
      "//testing/gtest",
      "//third_party/blink/public/common:headers",
      "//third_party/ocmock",
      "//ui/events/blink",
    ]
  }

  # TODO(crbug.com/479890756): Merge :delegate and :delegate_impl targets when
  # c/b/ui/views/tab_contents/chrome_web_contents_view_delegate_views_mac.mm
  # gets componentized.
  source_set("delegate_impl") {
    sources = [ "chrome_render_widget_host_view_mac_delegate.mm" ]
    deps = [
      ":delegate",
      ":history_swiper",
      ":history_swiping_control",
      "//base",
      "//chrome/browser/actor/ui:actor_overlay",
      "//chrome/browser/devtools",
      "//chrome/browser/glic",
      "//chrome/browser/ui",
      "//components/spellcheck/browser",
    ]
  }
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "javascript_optimizer_feature_browsertest.cc",
      "render_process_host_chrome_browsertest.cc",
    ]
    deps = [
      "//chrome/browser:chrome_content_browser_client",
      "//chrome/browser/content_settings",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/devtools",
      "//chrome/browser/extensions",
      "//chrome/browser/history",
      "//chrome/browser/preloading:test_support",
      "//chrome/browser/safe_browsing",
      "//chrome/browser/search",
      "//chrome/browser/site_protection",
      "//chrome/browser/site_protection:utils",
      "//chrome/browser/ui",
      "//chrome/browser/ui:browser_actions",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/page_action",
      "//chrome/browser/ui/views/infobars",
      "//chrome/browser/ui/views/js_optimization",
      "//chrome/browser/ui/views/page_action:page_action_test_support",
      "//chrome/common:chrome_features",
      "//chrome/common:constants",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/interaction",
      "//components/content_settings/core/browser",
      "//components/history/core/browser",
      "//components/performance_manager",
      "//components/policy:policy_code_generate",
      "//components/policy/core/browser",
      "//components/policy/core/common:test_support",
      "//components/prefs",
      "//components/safe_browsing/core/browser/db:test_database_manager",
      "//components/safe_browsing/core/common:features",
      "//components/safe_browsing/core/common:safe_browsing_prefs",
      "//content/test:test_support",
      "//net:test_support",
      "//ui/actions",
      "//ui/base",
      "//ui/base:features",
      "//ui/base/interaction:test_support",
      "//ui/views",
      "//ui/views/interaction:test_support",
    ]

    if (is_mac) {
      sources +=
          [ "chrome_render_widget_host_view_mac_history_swiper_browsertest.mm" ]
      deps += [
        "//chrome/browser/ui/tabs:tab_strip",
        "//chrome/test/base:chrome_test_path_utils",
        "//third_party/blink/public/common:headers",
        "//third_party/ocmock",
      ]
    }
  }
} else {
  source_set("android_browsertests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "javascript_optimizer_feature_browsertest.cc" ]
    deps = [
      "//chrome/browser:chrome_content_browser_client",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/history",
      "//chrome/browser/safe_browsing",
      "//chrome/browser/site_protection",
      "//chrome/browser/site_protection:utils",
      "//chrome/browser/ui:ui_features",
      "//chrome/common:chrome_features",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui_android",
      "//components/content_settings/core/browser",
      "//components/history/core/browser",
      "//components/policy/core/browser",
      "//components/policy/core/common:test_support",
      "//components/prefs",
      "//components/safe_browsing/core/browser/db:test_database_manager",
      "//components/safe_browsing/core/common:features",
      "//components/safe_browsing/core/common:safe_browsing_prefs",
      "//content/test:test_support",
      "//net:test_support",
      "//ui/base",
    ]
  }
}
