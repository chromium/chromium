source_set("registry") {
  public = [
    "tool_definition.h",
    "tool_registry.h",
    "tool_schema_builder.h",
  ]
  public_deps = [ "//base" ]
}

source_set("impl") {
  sources = [
    "tool_definition.cc",
    "tool_registry.cc",
    "tool_schema_builder.cc",
  ]
  deps = [
    ":registry",
    "//base",
    "//chrome/browser/actor",
    "//chrome/browser/actor:variants",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "tool_definition_unittest.cc",
    "tool_registry_unittest.cc",
    "tool_schema_builder_unittest.cc",
  ]
  deps = [
    ":impl",
    ":registry",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/actor",
    "//chrome/browser/actor:variants",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
