import("//components/enterprise/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core,
       "Cannot depend on extensions because enable_extensions_core=false.")

source_set("debugger") {
  sources = [
    "debugger_api.cc",
    "debugger_api.h",
  ]

  public_deps = [
    "//base",
    "//chrome/common/extensions/api",
    "//components/infobars/core",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
  ]

  deps = [
    "//base:i18n",
    "//chrome/app:generated_resources",
    "//chrome/app:generated_resources_grit",
    "//chrome/browser:browser_process",
    "//chrome/browser/devtools",
    "//chrome/browser/extensions",
    "//chrome/browser/infobars",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//chrome/common:non_code_constants",
    "//chrome/common/extensions",
    "//components/enterprise/buildflags",
    "//components/pdf/common:util",
    "//components/security_interstitials/content:security_interstitial_page",
    "//content/public/common",
    "//extensions/common:common_constants",
    "//extensions/common:extension_features",
    "//pdf:buildflags",
    "//pdf:features",
    "//ui/base",
    "//ui/gfx",
    "//ui/strings:ui_strings",
    "//url",
  ]

  if (enterprise_cloud_content_analysis) {
    deps += [ "//chrome/browser/enterprise/connectors/reporting" ]
  }

  if (is_android) {
    sources += [
      "extension_dev_tools_message_delegate.cc",
      "extension_dev_tools_message_delegate.h",
    ]
    deps += [
      "//chrome/browser/android:resource_mapper",
      "//components/messages/android",
    ]
  } else {
    sources += [
      "extension_dev_tools_infobar_delegate.cc",
      "extension_dev_tools_infobar_delegate.h",
    ]
  }
}
