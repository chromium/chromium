source_set("net") {
  sources = []
  deps = [ "//base" ]
}

source_set("platform_browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "proxy_override_rules_browsertest.cc" ]

  deps = [
    "//base",
    "//chrome/browser/enterprise/test:test_support",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_test_utils",
    "//components/proxy_config",
    "//content/test:test_support",
    "//testing/gmock",
  ]

  # Enterprise Proxy dynamic routing is currently not supported on ChromeOS.
  if (!is_chromeos) {
    sources += [
      "test/enterprise_proxy_browsertest.cc",
      "test/enterprise_proxy_browsertest_base.cc",
      "test/enterprise_proxy_browsertest_base.h",
      "test/enterprise_proxy_error_browsertest.cc",
    ]

    deps += [
      "//base/test:test_support",
      "//chrome/browser/enterprise",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/signin",
      "//chrome/browser/signin:identity_test_support",
      "//components/enterprise/browser/identifiers",
      "//components/enterprise/net/core",
      "//components/enterprise/net/core:test_support",
      "//components/keyed_service/content",
      "//components/policy:policy_code_generate",
      "//components/policy/core/common",
      "//components/signin/public/identity_manager:test_support",
      "//net:test_support",
      "//testing/gtest",
      "//ui/base",
      "//url",
    ]
  }
}
