import("//build/config/features.gni")

source_set("test_support") {
  testonly = true
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [ "test_utils.h" ]

  sources = [ "test_utils.cc" ]

  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/device_signals/core/browser",
    "//components/device_signals/core/common",
    "//components/enterprise",
    "//components/enterprise:test_support",
    "//components/policy/core/common",
    "//components/prefs",
    "//components/sync_preferences",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (is_win || is_mac || is_linux || is_android) {
    public += [ "realtime_event_uploader_test_base.h" ]
    sources += [ "realtime_event_uploader_test_base.cc" ]
  }

  if (is_android) {
    sources += [ "test_utils_android.cc" ]
    deps += [
      "//components/safe_browsing/android:safe_browsing_api_handler",
      "//components/safe_browsing/android:safe_browsing_api_handler_util",
    ]
  } else {
    sources += [ "test_utils_desktop.cc" ]
  }
}
