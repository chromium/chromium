source_set("unit_tests") {
  testonly = true

  sources = [
    "certificate_signals_collector_delegate_impl_unittest.cc",
    "user_delegate_impl_unittest.cc",
  ]

  deps = [
    "//base",
    "//chrome/browser/enterprise",
    "//chrome/browser/enterprise:impl",
    "//chrome/browser/net",
    "//chrome/test/base:testing_browser_process",
    "//chrome/test/base:testing_profile",
    "//components/device_signals/core/browser",
    "//components/enterprise/device_trust",
    "//components/enterprise/device_trust/core:device_trust_connector_service",
    "//components/enterprise/device_trust/core:test_support",
    "//components/keyed_service/core",
    "//components/policy/core/common:test_support",
    "//components/signin/public/base",
    "//components/signin/public/identity_manager:test_support",
    "//components/sync_preferences:test_support",
    "//content/test:test_support",
    "//net",
    "//testing/gtest",
  ]

  if (is_chromeos) {
    deps += [
      "//chrome/browser/ash/profiles",
      "//chromeos/ash/components/browser_context_helper",
    ]
  } else {
    # ChromeOS uses `UserPermissionServiceAsh`, which has its own rules.
    sources += [ "user_permission_service_factory_unittest.cc" ]
  }

  if (!is_android) {
    sources += [ "client_certificate_fetcher_unittest.cc" ]
    deps += [
      "//chrome/browser/content_settings:content_settings_factory",
      "//net:test_support",
    ]
  }
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "profile_signals_collector_browsertest.cc" ]

    deps = [
      "//base",
      "//chrome/browser/enterprise:impl",
      "//chrome/test/base:chrome_test_utils",
      "//chrome/test/base:platform_browser_test",
      "//components/enterprise/isolated_mode",
      "//components/enterprise/isolated_mode:test_support",
      "//content/test:test_support",
      "//testing/gmock",
    ]
  }
}

if (is_android) {
  source_set("android_browsertests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "profile_signals_collector_browsertest.cc" ]

    deps = [
      "//base",
      "//chrome/browser/enterprise:impl",
      "//chrome/test/base:chrome_test_utils",
      "//components/enterprise/isolated_mode",
      "//components/enterprise/isolated_mode:test_support",
      "//content/test:test_support",
      "//testing/gmock",
    ]
  }
}
