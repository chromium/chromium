import("//components/enterprise/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")

source_set("sdk_manager") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "content_analysis_sdk_manager.cc",
    "content_analysis_sdk_manager.h",
  ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//third_party/content_analysis_sdk:liblcasdk",
  ]
}

source_set("unit_tests") {
  testonly = true

  # Some of these tests declare file-scope objects with non-trivial
  # destructors.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]

  sources = []
  deps = [
    "//base",
    "//chrome/browser/enterprise:impl",
    "//chrome/browser/enterprise/connectors/test:test_support",
    "//chrome/test:test_support",
    "//components/device_signals/core/browser:test_support",
    "//components/enterprise/connectors/core:test_support",
    "//testing/gtest",
  ]

  if (enterprise_cloud_content_analysis) {
    sources += [
      "clipboard_request_handler_unittest.cc",
      "content_analysis_delegate_unittest.cc",
      "content_analysis_downloads_delegate_unittest.cc",
      "files_request_handler_unittest.cc",
      "page_print_analysis_request_unittest.cc",
      "page_print_request_handler_unittest.cc",
    ]
  }

  if (enterprise_cloud_content_analysis || is_android) {
    sources += [ "analysis_service_settings_unittest.cc" ]
  }

  if (enable_extensions && enterprise_local_content_analysis) {
    sources += [
      "content_analysis_sdk_manager_unittest.cc",
      "local_binary_upload_service_unittest.cc",
    ]
    deps += [ ":sdk_manager" ]
  }

  # file_transfer_analysis_delegate_unittest and
  # source_destination_matcher_ash_unittest are intentionally left in
  # //chrome/test: they include
  # //chrome/browser/safe_browsing/test_extension_event_observer.h, which is
  # built by //chrome/test:unit_tests, so extracting them here would create a
  # dependency cycle.
}

if (!is_android && enterprise_cloud_content_analysis) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    # Some of these tests declare file-scope objects with non-trivial
    # destructors.
    configs += [ "//build/config/compiler:no_exit_time_destructors" ]

    sources = [
      "content_analysis_browsertest.cc",
      "content_analysis_delegate_browsertest.cc",
      "content_analysis_info_browsertest.cc",
    ]

    deps = [
      "//base",
      "//chrome/browser/enterprise:impl",
      "//chrome/browser/enterprise/connectors/test:test_support",
      "//chrome/browser/enterprise/test:test_support",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/enterprise/connectors/core:content_analysis_browser_test_base",
      "//content/test:test_support",
      "//testing/gmock",

      # Inherits -Wno-sign-compare via fuzztest_public_config. See
      # crbug.com/527094632.
      "//third_party/fuzztest",
    ]
  }
}
