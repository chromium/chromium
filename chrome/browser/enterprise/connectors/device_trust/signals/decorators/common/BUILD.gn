source_set("common") {
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [
    "common_signals_decorator.h",
    "signals_utils.h",
  ]

  sources = [
    "common_signals_decorator.cc",
    "signals_utils.cc",
  ]

  public_deps = [
    "//base",
    "//components/enterprise/device_trust/core/attestation:types",
    "//components/enterprise/device_trust/core/signals/decorators/common",
  ]

  deps = [
    "//components/device_signals/core/common",
    "//components/enterprise/device_trust/core:metrics",
    "//components/policy/core/common",
    "//components/version_info",
    "//third_party/abseil-cpp:absl",
  ]
}

source_set("test_support") {
  testonly = true
  configs += [ "//components/enterprise:extra_warnings" ]

  public_deps = [
    ":common",
    "//components/enterprise/device_trust/core/attestation:types",
    "//components/enterprise/device_trust/core/signals/decorators/common:test_support",
    "//testing/gmock",
  ]
}

source_set("unit_tests") {
  testonly = true
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [ "common_signals_decorator_unittest.cc" ]

  deps = [
    ":common",
    "//base/test:test_support",
    "//build:branding_buildflags",
    "//chrome/common:constants",
    "//components/component_updater",
    "//components/device_signals/core/common",
    "//components/enterprise/device_trust/core/attestation:types",
    "//components/enterprise/device_trust/core/signals/decorators/common:test_support",
    "//components/policy/content",
    "//components/policy/core/browser",
    "//components/prefs:test_support",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
    "//third_party/abseil-cpp:absl",
  ]

  if (is_chromeos) {
    deps += [ "//chromeos/ash/components/system" ]
  }
}
