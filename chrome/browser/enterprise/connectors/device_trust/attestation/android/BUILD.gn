import("//build/config/android/rules.gni")

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/enterprise/connectors/device_trust/attestation/AttestationTokenGenerator.java",
    "java/src/org/chromium/chrome/browser/enterprise/connectors/device_trust/attestation/AttestationTokenGeneratorDefaultDelegate.java",
    "java/src/org/chromium/chrome/browser/enterprise/connectors/device_trust/attestation/AttestationTokenGeneratorDelegate.java",
    "java/src/org/chromium/chrome/browser/enterprise/connectors/device_trust/attestation/AttestationTokenResult.java",
  ]

  deps = [
    "//base:base_java",
    "//base:service_loader_java",
    "//build/android:build_java",
  ]
}

robolectric_library("junit") {
  sources = [ "java/src/org/chromium/chrome/browser/enterprise/connectors/device_trust/attestation/AttestationTokenGeneratorTest.java" ]

  deps = [
    ":java",
    "//base:base_java_test_support",
    "//base:base_junit_test_support",
    "//third_party/androidx:androidx_test_runner_java",
    "//third_party/junit",
    "//third_party/mockito:mockito_java",
  ]
}
