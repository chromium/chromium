if (is_android) {
  import("//build/config/android/rules.gni")
  import("//third_party/jni_zero/jni_zero.gni")

  generate_jni("jni_headers") {
    sources = [ "android/java/src/org/chromium/chrome/browser/personal_context/first_run/PersonalContextFirstRunService.java" ]
  }

  android_library("java") {
    deps = [
      "//base:base_java",
      "//chrome/browser/profiles/android:java",
      "//third_party/jni_zero:jni_zero_java",
    ]

    srcjar_deps = [ ":jni_headers" ]

    sources = [ "android/java/src/org/chromium/chrome/browser/personal_context/first_run/PersonalContextFirstRunService.java" ]
  }
}

source_set("first_run") {
  sources = [
    "personal_context_first_run_service_factory.cc",
    "personal_context_first_run_service_factory.h",
  ]

  if (is_android) {
    sources += [
      "android/personal_context_first_run_service_bridge.cc",
    ]
  }

  deps = [
    "//base",
    "//chrome/browser/personal_context",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/signin",
    "//components/keyed_service/content",
    "//components/personal_context/core",
    "//components/personal_context/core:features",
    "//components/personal_context/first_run",
    "//content/public/browser",
  ]

  if (is_android) {
    deps += [
      ":jni_headers",
      "//chrome/android:jni_headers",
      "//ui/android",
    ]
  }
}

