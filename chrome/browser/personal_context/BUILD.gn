source_set("personal_context") {
  sources = [
    "personal_context_enablement_service_factory.cc",
    "personal_context_enablement_service_factory.h",
    "personal_context_service_factory.cc",
    "personal_context_service_factory.h",
  ]

  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/account_settings",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/signin",
    "//components/application_locale_storage",
    "//components/personal_context/core",
    "//components/personal_context/core:features",
    "//components/variations/service",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "personal_context_service_factory_unittest.cc" ]
  deps = [
    ":personal_context",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/personal_context/core",
    "//components/personal_context/core:features",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "personal_context_enablement_service_browsertest.cc",
      "personal_context_service_browsertest.cc",
    ]
    deps = [
      ":personal_context",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/account_settings",
      "//chrome/browser/signin",
      "//chrome/test:test_support",
      "//components/account_settings:test_support",
      "//components/personal_context/core",
      "//components/personal_context/core:features",
      "//components/signin/public/identity_manager:test_support",
      "//components/sync:test_support",
      "//content/test:test_support",
      "//net:test_support",
      "//services/network:test_support",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
