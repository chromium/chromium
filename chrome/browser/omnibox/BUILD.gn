import("//extensions/buildflags/buildflags.gni")

source_set("omnibox") {
  sources = [
    "autocomplete_controller_emitter_factory.cc",
    "autocomplete_controller_emitter_factory.h",
    "geolocation_header_service_factory.cc",
    "geolocation_header_service_factory.h",
    "geolocation_navigation_throttle.cc",
    "geolocation_navigation_throttle.h",
  ]

  # Matches the build check used for the objects constructed by these factories.
  if (enable_extensions_core) {
    sources += [
      "omnibox_input_watcher_factory.cc",
      "omnibox_input_watcher_factory.h",
      "omnibox_suggestions_watcher_factory.cc",
      "omnibox_suggestions_watcher_factory.h",
    ]
  }
  deps = [
    "//base",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//components/content_settings/browser",
    "//components/keyed_service/content",
    "//components/omnibox/browser",
    "//components/omnibox/common",
    "//content/public/browser",
  ]

  # ChromeOmniboxNavigationObserverBase still carries the desktop-only infobar
  # code at this point, so it cannot build on Android yet and has to depend back
  # on //chrome/browser/ui/omnibox. Both go away when the desktop subclass is
  # split out.
  # TODO(crbug.com/467693484): Remove once the desktop subclass is extracted.
  if (!is_android) {
    sources += [
      "chrome_omnibox_navigation_observer_base.cc",
      "chrome_omnibox_navigation_observer_base.h",
    ]
    deps += [
      "//chrome/browser:browser_process",
      "//chrome/browser:intranet_redirect_detector",
      "//chrome/browser/autocomplete",
      "//chrome/browser/history",
      "//chrome/browser/infobars",
      "//chrome/browser/ui/omnibox",
      "//components/history/core/browser",
      "//components/infobars/content",
      "//components/infobars/core",
      "//components/search_engines",
      "//components/tabs:public",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom:url_loader_base",
      "//ui/base",
      "//url",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "geolocation_navigation_throttle_unittest.cc" ]
  deps = [
    ":omnibox",
    "//base/test:test_support",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/search_engines",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/omnibox/browser:test_support",
    "//components/search_engines",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "geolocation_header_browsertest.cc" ]
    deps = [
      ":omnibox",
      "//base/test:test_support",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/search_engines",
      "//chrome/browser/ui:browser_window_header",
      "//chrome/test:test_support",
      "//chrome/test/base:browser_test_waiters",
      "//components/content_settings/core/browser",
      "//components/omnibox/browser",
      "//components/omnibox/common",
      "//components/search_engines",
      "//content/test:test_support",
      "//net:test_support",
      "//services/device/public/cpp:test_support",
      "//testing/gtest",
      "//url",
    ]
  }
}
