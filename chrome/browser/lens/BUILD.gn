if (is_android) {
  import("//build/config/android/config.gni")
  import("//build/config/android/rules.gni")
  import("//chrome/browser/buildflags.gni")
  import("//third_party/jni_zero/jni_zero.gni")

  source_set("lens") {
    public = [ "android/lens_prefs.h" ]
  }

  generate_jni("jni_headers") {
    sources = [
      "java/src/org/chromium/chrome/browser/lens/LensSupportStatusHelper.java",
    ]
  }

  source_set("impl") {
    sources = [
      "android/lens_policy_utils.cc",
      "android/lens_prefs.cc",
    ]

    public_deps = [ ":lens" ]

    deps = [
      ":jni_headers",
      "//chrome/android:jni_headers",
      "//chrome/browser:browser_process",
      "//components/policy/core/common:common_constants",
      "//components/prefs",
    ]
  }

  android_library("java") {
    sources = [
      "java/src/org/chromium/chrome/browser/lens/LensController.java",
      "java/src/org/chromium/chrome/browser/lens/tips/GoogleLensTipsPromoHandler.java",
    ]

    deps = [
      ":java_resources",
      "//base:base_java",
      "//base:service_loader_java",
      "//build/android:build_java",
      "//chrome/browser/contextmenu:java",
      "//chrome/browser/tabmodel:java",
      "//chrome/browser/tips/android:java_resources",
      "//chrome/browser/tips/android:public_java",
      "//chrome/browser/ui/android/strings:ui_strings_grd",
      "//components/embedder_support/android:context_menu_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//ui/android:ui_java",
    ]

    public_deps = [
      ":delegate_java",
      ":util_java",
    ]

    resources_package = "org.chromium.chrome.browser.lens"
  }

  android_library("delegate_java") {
    sources = [
      "java/src/org/chromium/chrome/browser/lens/LensControllerDelegate.java",
    ]

    deps = [
      ":java_resources",
      ":util_java",
      "//base:base_java",
      "//chrome/browser/ui/android/strings:ui_strings_grd",
      "//components/embedder_support/android:context_menu_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//ui/android:ui_java",
    ]
    resources_package = "org.chromium.chrome.browser.lens"
  }

  android_library("util_java") {
    sources = [
      "java/src/org/chromium/chrome/browser/lens/LensEntryPoint.java",
      "java/src/org/chromium/chrome/browser/lens/LensIdentityUtils.java",
      "java/src/org/chromium/chrome/browser/lens/LensIntentParams.java",
      "java/src/org/chromium/chrome/browser/lens/LensMetrics.java",
      "java/src/org/chromium/chrome/browser/lens/LensQueryParams.java",
      "java/src/org/chromium/chrome/browser/lens/LensQueryResult.java",
      "java/src/org/chromium/chrome/browser/lens/LensSupportStatusHelper.java",
    ]
    deps = [
      "//base:base_java",
      "//build/android:build_java",
      "//chrome/browser/flags:java",
      "//chrome/browser/gsa:java",
      "//chrome/browser/profiles/android:java",
      "//chrome/browser/search_engines/android:java",
      "//chrome/browser/signin/services/android:java",
      "//components/search_engines/android:java",
      "//components/signin/public/android:java",
      "//content/public/android:content_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/jni_zero:jni_zero_java",
    ]
  }

  android_resources("java_resources") {
    sources = [ "java/res/drawable/lens_icon.xml" ]
  }

  robolectric_library("junit") {
    sources = [
      "java/src/org/chromium/chrome/browser/lens/LensControllerTest.java",
      "java/src/org/chromium/chrome/browser/lens/LensSupportStatusHelperUnitTest.java",
      "java/src/org/chromium/chrome/browser/lens/tips/GoogleLensTipsPromoHandlerUnitTest.java",
    ]
    deps = [
      ":java",
      ":util_java",
      "//base:base_java",
      "//base:base_java_test_support",
      "//base:base_junit_test_support",
      "//chrome/browser/flags:java",
      "//chrome/browser/gsa:java",
      "//chrome/browser/profiles/android:java",
      "//chrome/browser/search_engines/android:java",
      "//chrome/browser/tabmodel:java",
      "//chrome/browser/tips/android:public_java",
      "//components/search_engines/android:java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/junit",
      "//third_party/mockito:mockito_java",
      "//ui/android:ui_no_recycler_view_java",
    ]
  }
}

if (!is_android) {
  source_set("lens_suggestion_tool") {
    sources = [
      "lens_suggestion_tool.cc",
      "lens_suggestion_tool.h",
    ]
    public_deps = [
      "//base",
      "//chrome/browser/selection",
    ]
    deps = [
      "//chrome/app:generated_resources",
      "//chrome/browser/ui/lens",
      "//components/lens",
      "//components/optimization_guide/proto:optimization_guide_proto",
      "//components/tabs:public",
      "//content/public/browser",
      "//skia",
      "//ui/base",
      "//ui/gfx/geometry",
    ]
  }
}

source_set("lens_sapisid_generator") {
  sources = [
    "lens_sapisid_generator.cc",
    "lens_sapisid_generator.h",
  ]
  deps = [
    "//base",
    "//build:branding_buildflags",
    "//components/optimization_guide:optimization_guide_buildflags",
    "//components/optimization_guide/core:optimization_guide_library_holder",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "lens_sapisid_generator_unittest.cc" ]
  deps = [
    ":lens_sapisid_generator",
    "//base",
    "//base/test:test_support",
    "//build:branding_buildflags",
    "//testing/gtest",
  ]

  if (!is_android) {
    sources += [ "lens_suggestion_tool_unittest.cc" ]
    deps += [
      ":lens_suggestion_tool",
      "//chrome/browser/lens/core/mojom:mojo_bindings",
      "//chrome/browser/selection",
      "//chrome/browser/ui/lens",
      "//components/lens",
      "//components/optimization_guide/proto:optimization_guide_proto",
      "//components/tabs:test_support",
      "//content/test:test_support",
      "//mojo/public/cpp/bindings",
      "//skia",
      "//testing/gmock",
      "//ui/base/unowned_user_data",
      "//ui/gfx/geometry",
    ]
  }
}
