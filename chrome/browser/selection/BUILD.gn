assert(!is_android)

source_set("selection") {
  sources = [
    "features.cc",
    "features.h",
    "suggestion.cc",
    "suggestion.h",
    "suggestion_service.cc",
    "suggestion_service.h",
    "suggestion_tool.cc",
    "suggestion_tool.h",
  ]

  public_deps = [
    "//chrome/browser/selection/mojom:mojo_bindings",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/base/unowned_user_data",
    "//ui/gfx/geometry",
  ]

  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//components/optimization_guide/core",
    "//components/tabs:public",
    "//components/variations/service",
    "//components/version_info",
    "//content/public/browser",
    "//services/metrics/public/cpp:metrics_cpp",
    "//services/metrics/public/cpp:ukm_builders",
    "//ui/gfx/codec",
    "//ui/gfx/geometry:geometry_skia",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "suggestion_service_unittest.cc",
    "suggestion_unittest.cc",
  ]
  deps = [
    ":selection",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_interfaces",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/optimization_guide/core",
    "//components/optimization_guide/core:test_support",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//components/tabs:test_support",
    "//components/ukm:test_support",
    "//components/variations",
    "//components/variations/service",
    "//content/test:test_support",
    "//mojo/public/cpp/bindings",
    "//services/metrics/public/cpp:metrics_cpp",
    "//services/metrics/public/cpp:ukm_builders",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/codec",
  ]
}
