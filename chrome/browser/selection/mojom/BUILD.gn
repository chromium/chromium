import("//mojo/public/tools/bindings/mojom.gni")

assert(!is_android)

mojom("mojo_bindings") {
  sources = [ "action.mojom" ]

  # Surfaces that host inline fulfillments are WebUIs, so these types need
  # TypeScript bindings alongside the C++ ones.
  webui_module_path = "/"
}
