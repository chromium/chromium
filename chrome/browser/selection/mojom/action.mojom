module selection.mojom;

// Renders a component inside the surface that offered the Suggestion.
struct InlineFulfillment {
  // The WebUI resource to load, after the user interacting with the Suggestion.
  string resource_name;
};

// The Suggestion hands off to another surface (e.g., the side panel).
struct Handoff {};

// What the surface does when the user executes a Suggestion.
union Action {
  InlineFulfillment inline_fulfillment;
  Handoff handoff;
};

// Identifies a prompt endpoint destination for Smart Selection.
//
// These values are persisted to logs and profile prefs. Entries should not be
// renumbered and numeric values should never be reused.
// LINT.IfChange(PromptEndpointId)
enum PromptEndpointId {
  // The Gemini in Chrome (Glic) side panel.
  kGemini = 0,
  // The Google Search (`ContextualTasks`) side panel.
  kGoogleSearch = 1,
};
// LINT.ThenChange(//tools/metrics/histograms/metadata/smart_selection/enums.xml:SmartSelectionPromptEndpoint)
