module contextual_cueing_internals.mojom;

import "url/mojom/url.mojom";

// Represents structured log data for a single cue shown to the user.
// String fields in this struct are for display/diagnostic purposes only and
// should not be programmatically parsed.
struct CueLog {
  // The CUJ identifier.
  string cuj;
  // The anchored message text displayed to the user.
  string anchored_message_text;
  // The action button text displayed to the user.
  string action_text;
  // The URL of the page where the cue was shown, if available.
  url.mojom.Url? url;
  // The prompt text sent for Gemini feature execution, if available.
  string? prompt;
};

// Browser-side handler for requests from WebUI page. Bound specifically for
// chrome://contextual-cueing-internals.
// Messages sent from Renderer TypeScript to Browser C++.
interface PageHandler {
  // Returns the list of cues that have been shown to the user.
  GetShownCues() => (array<CueLog> cues);
};
