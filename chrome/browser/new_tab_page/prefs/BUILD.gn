# New Tab Page pref names and their registration and reset. Kept in a separate
# BUILD.gn so that the assert(enable_webui_ntp) in new_tab_page/BUILD.gn doesn't
# apply to pref consumers.
source_set("prefs") {
  sources = [
    "ntp_pref_names.h",
    "ntp_prefs.cc",
    "ntp_prefs.h",
  ]
  deps = [
    "//base",
    "//chrome/common:constants",
    "//components/prefs",
  ]
}
