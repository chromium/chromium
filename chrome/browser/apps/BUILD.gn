import("//extensions/buildflags/buildflags.gni")

source_set("user_type_filter") {
  public = [ "user_type_filter.h" ]
  sources = [ "user_type_filter.cc" ]

  public_deps = [ "//base" ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
  ]

  if (is_chromeos) {
    deps += [ "//chromeos/components/mgs" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "user_type_filter_unittest.cc" ]
  deps = [
    ":user_type_filter",
    "//base",
    "//chrome/browser/policy",
    "//chrome/browser/profiles:profile_test_util",
    "//chrome/browser/signin",
    "//chrome/browser/signin:identity_test_support",
    "//chrome/test/base:testing_profile",
    "//components/supervised_user/core/browser:test_support",
    "//content/test:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/gfx",
  ]
}

if (is_chromeos && enable_extensions) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "guest_view/app_view_browsertest.cc",
      "guest_view/web_view_browsertest.cc",
    ]
    deps = [
      "//chrome/browser/apps/platform_apps:browser_test_support",
      "//chrome/browser/ash/system_web_apps",
      "//chrome/browser/autocomplete:aim_eligibility_service",
      "//chrome/browser/bluetooth:test_support",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/devtools:test_support",
      "//chrome/browser/glic/test_support",
      "//chrome/browser/guest_view",
      "//chrome/browser/hid",
      "//chrome/browser/interstitials:test_support",
      "//chrome/browser/lifetime",
      "//chrome/browser/net",
      "//chrome/browser/pdf:pdf_extension_test_utils",
      "//chrome/browser/pdf:test_mime_handler_stream_manager",
      "//chrome/browser/preloading/prefetch/no_state_prefetch",
      "//chrome/browser/renderer_context_menu",
      "//chrome/browser/renderer_context_menu:test_support",
      "//chrome/browser/safe_browsing:test_support",
      "//chrome/browser/serial",
      "//chrome/browser/site_protection",
      "//chrome/browser/task_manager:test_support",
      "//chrome/browser/ui:browser_commands",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/browser/ui/dialogs:browser_dialogs",
      "//chrome/browser/ui/hid",
      "//chrome/browser/ui/login",
      "//chrome/browser/ui/views:file_system_access_test_support",
      "//chrome/browser/usb",
      "//chrome/browser/usb:browser_test_support",
      "//chrome/test/base:chrome_test_utils",
      "//chrome/test/base:tracing",
      "//chrome/test/base:ui_test_utils",
      "//components/guest_view/browser:test_support",
      "//components/omnibox/browser:test_support",
      "//components/permissions:test_support",
      "//components/safe_browsing/core/browser/db:test_database_manager",
      "//content/test:browsertest_support",
      "//content/test:test_support",
      "//extensions:test_support",
      "//extensions/browser:test_support",
      "//services/device/public/cpp:test_support",
      "//ui/events:gesture_detection",
    ]
  }

  source_set("interactive_ui_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "guest_view/web_view_interactive_browsertest.cc" ]
    deps = [
      "//chrome/browser/apps/platform_apps:browser_test_support",
      "//chrome/browser/renderer_context_menu:test_support",
      "//chrome/test/base:interactive_test_utils",
      "//chrome/test/base:test_launcher_utils",
      "//chrome/test/base:ui_test_utils",
      "//components/guest_view/browser:test_support",
      "//content/test:browsertest_support",
      "//content/test:test_support",
      "//extensions:test_support",
      "//extensions/browser:test_support",
      "//net:test_support",
      "//ui/base:ozone_buildflags",
      "//ui/base:test_support",
    ]
  }
}
