import("//chrome/common/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  # Bound browser-side (and, in tests, from the browser); nothing in Blink C++
  # binds it yet, so no Blink variant is needed. Disabling variants also keeps
  # this target variant-consistent with the pwc :features target it imports for
  # the [RuntimeFeature] reference. The TypeScript bindings generated here are
  # consumed by a remote GE web app via the rollup bundle in
  # //chrome/browser/resources/geic, not by Blink.
  disable_variants = true

  sources = [ "geic.mojom" ]

  public_deps = [
    "//chrome/browser/pwc:features",
    "//mojo/public/mojom/base",
    "//mojo/public/mojom/base:protobuf_support",
    "//url/mojom:url_mojom_gurl",
  ]
  webui_module_path = "/"

  # This is necessary to prevent method id scrambling. This is critical since
  # the client is shipped separately from the browser. If scrambling is not
  # disabled, the client will encounter a missing method validation error.
  scramble_message_ids = false
}

source_set("geic") {
  public = [
    "geic_enabling.h",
    "geic_host.h",
  ]

  sources = [
    "geic_enabling.cc",
    "geic_host.cc",
  ]

  public_deps = [
    ":mojo_bindings",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//base",
    "//chrome/browser:bad_message",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/pwc",
    "//chrome/common:channel_info",
    "//chrome/common:chrome_features",
    "//chrome/common:non_code_constants",
    "//components/prefs",
    "//components/version_info",
    "//content/public/common",
  ]

  if (!is_android) {
    public += [
      "geic_browser_host_impl.h",
      "geic_pwc_manager.h",
      "geic_tab_context_extraction_runner.h",
    ]

    sources += [
      "geic_browser_host_impl.cc",
      "geic_pwc_manager.cc",
      "geic_tab_context_extraction_runner.cc",
    ]

    deps += [
      "//chrome/browser/ui:browser_tab_strip",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/navigator",
      "//chrome/browser/ui/side_panel",
      "//chrome/browser/ui/tabs:tab_strip",
      "//components/content_extraction/content/browser",
      "//components/favicon/content",
      "//components/optimization_guide/content/browser",
      "//components/optimization_guide/proto:optimization_guide_proto",
      "//components/tabs:public",
      "//google_apis",
      "//mojo/public/cpp/base:protobuf_support",
      "//skia",
      "//ui/base",
      "//ui/gfx",
      "//ui/gfx/codec",
      "//url",
    ]
  }
}

