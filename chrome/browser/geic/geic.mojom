module geic.mojom;

import "chrome/browser/pwc/pwc_features.mojom";
import "mojo/public/mojom/base/proto_wrapper.mojom";
import "mojo/public/mojom/base/string16.mojom";
import "url/mojom/url.mojom";

// The GEIC capability surface, exposed to the qualifying main frame of a GEIC
// PrivilegedWebContents (see //chrome/browser/pwc). The browser-side binder
// (//chrome/browser/geic) hands this interface out only to a frame that passes
// the shared privileged-frame gate AND whose blessed component is GEIC, so a
// glic (or any other component's) frame never receives it.
//
// The interface is intentionally empty scaffolding. The GEIC team owns this
// file and adds the real capability surface in follow-up CLs, each
// implemented end to end and carrying IPC security review (see the *.mojom
// rule in this directory's OWNERS).
[RuntimeFeature=pwc.mojom.features.kPrivilegedWebContents]
interface GeicApi {};

// GEiC Mojo Interface and Glic Fork Rationale:
//
// This interface is a fork of the Glic Mojo API, tailored for Gemini Enterprise
// in Chrome (GEiC). We maintain a separate interface rather than reusing
// Glic's directly for two primary reasons:
//
// 1. Semantic and architectural divergence: GEiC operates under distinct
//    enterprise requirements (e.g., enterprise account constraints, a policy-
//    driven configuration channel, and default StoragePartition handling).
//    Additionally, Glic's API surface is API_OWNERS-gated, which would require
//    cross-team review queues for GEiC-specific iterations. Owning the Mojo
//    interface allows GEiC to evolve its contract independently, while sharing
//    underlying browser machinery over time.
//
// 2. Embedding architecture (PrivilegedWebContents vs <webview>):
//    Glic embeds its remote UI inside a <webview> hosted within a
//    chrome-untrusted:// WebUI container. In Glic, the remote page communicates
//    via window.postMessage with the WebUI host, which translates messages to
//    Mojo IPCs. In contrast, GEiC leverages PrivilegedWebContents (see
//    //chrome/browser/pwc), eliminating the intermediary WebUI host layer. The
//    remote GE web app runs directly in the privileged main frame and speaks
//    Mojo directly to the browser process. Consequently, this interface is
//    designed as a direct Mojo IPC surface rather than a postMessage bridge
//    API.
//
// TODO(crbug.com/547979281): Follow up on
// sharing Glic data types and the underlying extraction machinery (e.g., tab
// validity checks, inner text extraction, and screenshot capture in
// //chrome/browser/glic/host/context/) rather than re-implementing them. These
// live outside GEiC's OWNERS, so convergence is deferred to a follow-up.

// Lightweight metadata for browser tab identification and UI chip rendering.
struct TabMetadata {
  // Unique frame tree node / tab identifier.
  int32 tab_id;
  // Browser window identifier containing the tab.
  int32 window_id;
  // Committed URL of the active document in the tab.
  url.mojom.Url url;
  // Page title of the active document in the tab.
  mojo_base.mojom.String16 title;
  // PNG-encoded favicon data, or null if no favicon is available.
  array<uint8>? favicon;
  // Whether this tab is currently the active tab in its window.
  bool is_active_in_window;
};

// Reason why no focused tab data could be shared.
// Note: Unlike glic, we intentionally do NOT expose rejected tab metadata
// (e.g. chrome:// URL or title) to prevent information leakage from
// non-allowlisted schemes.
struct NoFocusedTabData {
  // Human-readable diagnostic reason explaining why the tab cannot be shared
  // (e.g. "no active tab", "scheme not allowed", "incognito window").
  //
  // This is a string rather than an enum because the reason is diagnostic and
  // the set of failure conditions is still settling. Using an enum would freeze
  // the set into the Mojo contract prematurely before client needs are known,
  // making additions require additional security review rounds. A string keeps
  // it cheap to iterate and refine during early development.
  //
  // The GE web app must NOT branch programmatically on this text; it is
  // intended strictly for display and diagnostic logging. This should be
  // tightened into a formal enum once the set of failure reasons stabilizes.
  string no_focus_reason;
};

// Represents the focused tab state for the side panel.
union FocusedTabData {
  // Successfully validated and shareable tab metadata.
  TabMetadata focused_tab;
  // Information describing why focused tab data is unavailable.
  NoFocusedTabData no_focused_tab_data;
};

// Initial state delivered to the GE web app upon connecting.
struct GeicInitialState {
  // Focused tab data available at the time the client is registered.
  FocusedTabData focused_tab_data;
};

// Options for on-demand page content capture.
// Next version: 2
struct TabContextOptions {
  // Whether to extract innerText from the active tab. Defaults to false.
  bool include_inner_text = false;
  // Maximum bytes of innerText to extract. 0 selects the browser default
  // cap. A client requesting no inner text sets include_inner_text = false,
  // so 0 is never ambiguous with withholding text.
  uint32 inner_text_bytes_limit = 0;
  // Whether to capture a screenshot of the active tab. Defaults to false.
  bool include_screenshot = false;
  // Maximum width in pixels for the captured screenshot. 0 selects the
  // browser default (viewport width).
  uint32 screenshot_max_width = 0;
  // Maximum height in pixels for the captured screenshot. 0 selects the
  // browser default (viewport height).
  uint32 screenshot_max_height = 0;
  // Whether to extract AnnotatedPageContent protobuf data.
  [MinVersion=1] bool? include_annotated_page_content;
};

// Full extracted tab context payload for GEiC grounding.
// Next version: 2
struct TabContextData {
  // Metadata for the tab from which context was extracted.
  TabMetadata metadata;
  // Extracted innerText from the tab DOM, if requested.
  string? inner_text;
  // Encoded image data of the screenshot, if requested.
  array<uint8>? screenshot_data;
  // MIME type of the screenshot data (e.g. "image/jpeg").
  string? screenshot_mime_type;
  // Serialized AnnotatedPageContent proto, if requested.
  // Transmitted as a ProtoWrapper rather than structured Mojom structs
  // because the downstream web app and model backend consume the
  // raw AnnotatedPageContent protobuf directly for AI grounding.
  [MinVersion=1] mojo_base.mojom.ProtoWrapper? annotated_page_data;
};

// Error codes returned when tab context extraction fails.
[Extensible]
enum GetTabContextError {
  // Fallback for values added after this client was built.
  [Default] kUnknown = 0,
  // Tab was closed before or during extraction.
  kTabClosed = 1,
  // Tab navigated during extraction; the captured state would not match the
  // tab that was validated.
  kNavigationInProgress = 2,
  // Permission denied, or the tab's scheme is not on the allowlist.
  kPermissionDenied = 3,
  // Internal browser error during capture or IPC.
  kInternalError = 4,
};

// Result of attempting to close the sign-in tab.
[Extensible]
enum CloseSignInTabResult {
  [Default] kUnknown = 0,
  // The sign-in tab was found and closed.
  kSuccess = 1,
  // A sign-in tab was previously opened, but had already been closed.
  kAlreadyClosed = 2,
  // No sign-in tab was open or tracked.
  kNoSignInTab = 3,
};

// TODO(crbug.com/539909218): Converge GeicBrowserHost and GeicClient with the
// PWC-scoped GeicApi / GeicHost interface above.

// Main IPC interface from the GE web app to browser for GEiC side panel
// interaction.
//
// Version Evolution and Stability Rules:
//
// 1. Definition of Version 0:
// Version 0 is defined as whatever this interface contains at the moment the
// bindings become independently deployable via the Chrome WebUI SDK sync.
// Declarations added prior to that cutover point deliberately carry no
// [MinVersion] attribute. This is an architectural boundary decision, not an
// omission; version 0 encompasses the entire baseline interface.
//
// 2. Build coupling and versioning rules:
// While client and browser bindings are compiled together in the same tree,
// both ends of every pipe are guaranteed to agree, making versioning
// machinery inert. As soon as bindings deploy independently, cross-version
// compatibility rules become mandatory: the interface must be marked [Stable],
// every subsequent addition must carry [MinVersion=N], every enum must be
// marked [Extensible] with a [Default] member, and the client-browser
// handshake must verify capability versions. These requirements must land
// together, because satisfying only a subset still allows version mismatches
// through in a quieter form.
//
// 3. Failure mode being defended against:
// An unrecognized method ordinal or enum value is treated as a fatal Mojo
// validation error, not a graceful degradation. For a PrivilegedWebContents,
// dropping the pipe terminates the renderer process outright, causing the
// side panel to vanish with no error visible to the user. This failure mode
// was previously hit when official builds rejected every ordinal on this
// interface because message ID scrambling
// (enable_mojom_message_id_scrambling = is_official_build, salted with
// //chrome/VERSION) rewrote them, an issue that took two days to diagnose
// because every source-level check passed.
//
// Next version: 1
interface GeicBrowserHost {
  // Registers the GE web app's client endpoint and returns the state the
  // GE web app needs before its first frame. The browser is always ready before
  // the GE web app's JS, so returning initial state here removes the startup
  // race that a later push would create.
  // `client`: The remote callback endpoint implemented by the GE web app.
  // Returns `initial_state` containing initial focused-tab data to eliminate
  // startup races.
  RegisterClient(pending_remote<GeicClient> client)
      => (GeicInitialState initial_state);

  // Returns metadata or rejection reason for the currently active tab in the
  // browser window.
  // Returns `data` containing `TabMetadata` if the tab is valid and shareable,
  // or `NoFocusedTabData` explaining why tab data cannot be shared.
  GetFocusedTab() => (FocusedTabData data);

  // Extracts full page context (e.g. inner text, annotated page content,
  // and/or screenshot) from the active tab.
  // `options`: Configuration specifying what data to capture (e.g. byte limits,
  // screenshot dimensions).
  // Returns `result` containing `TabContextData` on success, or a
  // `GetTabContextError` failure code if extraction could not be completed.
  GetContextFromFocusedTab(TabContextOptions options)
      => result<TabContextData, GetTabContextError>;

  // Requests the browser to close the GEiC side panel for this tab.
  ClosePanel();

  // Opens the authentication endpoint in a new top-level browser tab
  // and captures the originating tab for focus restoration.
  // The `signin_url` is enforced browser-side to require HTTPS and match the
  // component's configured guest or authentication origin.
  OpenSignInTab(url.mojom.Url signin_url);

  // Closes the active sign-in tab (if open) and restores focus to the
  // user's originating tab. Returns the status of the operation.
  CloseSignInTab() => (CloseSignInTabResult result);
};

// Client callbacks sent from browser C++ to the GE web app.
interface GeicClient {
  // Notifies the GE web app when the active or focused tab changes.
  // `data`: The updated focused tab state, containing either `TabMetadata` or
  // `NoFocusedTabData`.
  OnFocusedTabChanged(FocusedTabData data);
};
