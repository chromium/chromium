<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/task_item_margin_bottom"
    android:divider="@drawable/task_header_divider"
    android:showDividers="middle"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- TODO(crbug.com/381352682): Make the header items easier to click. -->
    <TextView
        android:id="@+id/task_name"
        style="@style/TaskManagerHeaderColumn" />
    <TextView
        android:id="@+id/memory_footprint"
        style="@style/TaskManagerHeaderColumn" />
    <TextView
        android:id="@+id/cpu"
        style="@style/TaskManagerHeaderColumn" />
    <TextView
        android:id="@+id/network_usage"
        style="@style/TaskManagerHeaderColumn" />
    <TextView
        android:id="@+id/process_id"
        style="@style/TaskManagerHeaderColumn" />
    <TextView
        android:id="@+id/gpu_memory_id"
        style="@style/TaskManagerHeaderColumn" />

</LinearLayout>
