include_rules = [
  "+components/glic",
  "+components/origin_matcher",

  # geic_enabling is a GLiC-internal helper rather than a general purpose
  # enablement check; see the comment in geic_enabling.h. Callers should go
  # through GLiC's enablement utilities instead. The allowlist lives in
  # chrome/browser/glic/host/DEPS; please loop in the GEiC owners before adding
  # to it.
  "-chrome/browser/glic/gemini_enterprise/geic_enabling.h",
]

specific_include_rules = {
  "glic_actor_attempt_otp_filling_.*": [
    "+components/one_time_tokens/core/browser",
  ],
  ".*_browsertest\\.cc": [
    "+chrome/browser/performance_manager",
  ]
}
