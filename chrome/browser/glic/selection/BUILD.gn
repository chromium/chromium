import("//build/config/ozone.gni")
import("//chrome/common/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

assert(!is_android)

source_set("selection") {
  sources = [
    "explain_selection_trigger.cc",
    "explain_selection_trigger.h",
    "selection_overlay_controller.cc",
    "selection_overlay_controller.h",
    "selection_overlay_untrusted_ui.cc",
    "selection_overlay_untrusted_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//chrome/browser/glic",
    "//chrome/browser/ui/lens",
  ]

  deps = [
    "//base",
    "//chrome/browser/actor",
    "//chrome/browser/glic:mojo_bindings",
    "//chrome/browser/glic:public_types",
    "//chrome/browser/glic/public:features",
    "//chrome/browser/glic/resources:browser_resources",
    "//chrome/browser/optimization_guide",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/glic/selection_overlay:resources",
    "//chrome/browser/resources/lens/overlay:resources_grit",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/common:chrome_features",
    "//components/actor/public/mojom:mojo_bindings",
    "//components/optimization_guide/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//mojo/public/mojom/base",
  ]
}

mojom("mojo_bindings") {
  disable_variants = true
  sources = [ "selection_overlay.mojom" ]
  public_deps = [
    "//skia/public/mojom",
    "//ui/gfx/geometry/mojom",
  ]
  webui_module_path = "/"
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "selection_overlay_interactive_uitests.cc" ]
  deps = [
    ":selection",
    "//chrome/browser/actor:test_support",
    "//chrome/browser/background/glic",
    "//chrome/browser/glic",
    "//chrome/browser/glic/test_support",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base:ozone_buildflags",
    "//ui/base/interaction",
  ]
  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "selection_overlay_browsertest.cc" ]
  deps = [
    ":selection",
    "//base",
    "//chrome/browser/glic",
    "//chrome/browser/glic/test_support",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "explain_selection_trigger_unittest.cc" ]
  deps = [
    ":selection",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/glic/public:features",
    "//chrome/browser/optimization_guide:test_support",
    "//chrome/test:test_support",
    "//components/optimization_guide/core:test_support",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//content/test:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gtest",
  ]
}
