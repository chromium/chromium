import("//extensions/buildflags/buildflags.gni")

source_set("synthetic_trial_constants") {
  sources = [ "synthetic_trial_constants.h" ]
}

source_set("navigation_capture") {
  sources = [
    "glic_marketing_page_tab_helper.cc",
    "glic_marketing_page_tab_helper.h",
    "glic_navigation_throttle.cc",
    "glic_navigation_throttle.h",
    "glic_promotion_source_navigation_observer.cc",
    "glic_promotion_source_navigation_observer.h",
    "glic_share_link_navigation_throttle.cc",
    "glic_share_link_navigation_throttle.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/glic",
    "//content/public/browser",
    "//url",
  ]

  deps = [
    ":synthetic_trial_constants",
    "//chrome/browser:browser_process",
    "//chrome/browser/glic:mojo_bindings",
    "//chrome/browser/glic/public:features",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/navigator",
    "//chrome/common:chrome_features",
    "//components/prefs",
    "//components/tabs:public",
    "//extensions/buildflags",
    "//net",
    "//ui/base",
  ]

  if (enable_extensions) {
    deps += [ "//extensions/common" ]
  }
}

if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [
      "glic_marketing_page_tab_helper_browsertest.cc",
      "glic_navigation_throttle_browsertest.cc",
      "glic_promotion_source_navigation_observer_browsertest.cc",
    ]

    deps = [
      ":navigation_capture",
      ":synthetic_trial_constants",
      "//base",
      "//base/test:test_support",
      "//chrome/browser:browser_process",
      "//chrome/browser/actor",
      "//chrome/browser/glic",
      "//chrome/browser/glic:impl",
      "//chrome/browser/glic:mojo_bindings",
      "//chrome/browser/glic/public:features",
      "//chrome/browser/glic/suggestions",
      "//chrome/browser/glic/test_support",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/signin",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/navigator",
      "//chrome/browser/ui/tabs:tab_enums",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/common:chrome_features",
      "//chrome/common:non_code_constants",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//chrome/test/base:testing_browser_process",
      "//components/keyed_service/content",
      "//components/prefs",
      "//components/variations",
      "//content/public/browser",
      "//content/test:test_support",
      "//extensions/common",
      "//net:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//ui/base",
      "//url",
    ]
  }
}
