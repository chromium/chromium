source_set("features") {
  sources = [
    "features.cc",
    "features.h",
  ]
  public_deps = [ "//pdf:buildflags" ]
  deps = [
    "//base",
    "//build:android_buildflags",
  ]
}

# Feature flags whose availability depends on the Glic provider. Production code
# must check GlicProviderSpec::SupportsFeature() instead.
source_set("provider_features") {
  visibility = [
    "//chrome/browser:core",  # about_flags.cc
    "//chrome/browser/glic:provider_spec_impl",  # glic_provider_spec_impl.cc
    "//chrome/test:test_support",  # testonly = true
  ]
  sources = [
    "provider_features.cc",
    "provider_features.h",
  ]
  public_deps = [ "//pdf:buildflags" ]
  deps = [
    ":features",
    ":provider",
    "//base",
    "//build:android_buildflags",
  ]
}

source_set("request_headers") {
  sources = [
    "glic_request_headers.cc",
    "glic_request_headers.h",
  ]
  deps = [ "//services/network/public/mojom" ]
}

# The per-profile Glic provider and its latch. Kept free of Glic dependencies so
# that low-level helpers can read the latched provider. The latch is populated
# by GlicProviderLatchFactory in //chrome/browser/glic:impl.
source_set("provider") {
  # Feature code outside Glic should use GetGlicProviderSpec(profile) or
  # GlicKeyedService::provider_spec().
  visibility = [ "//chrome/browser/glic/*" ]
  sources = [
    "glic_feature.h",
    "glic_provider.h",
    "glic_provider_change.h",
    "glic_provider_latch.cc",
    "glic_provider_latch.h",
    "glic_provider_spec.cc",
    "glic_provider_spec.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
  ]
}
