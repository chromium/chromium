assert(is_win || is_mac || is_linux,
       "Child module updates are only supported on desktop platforms.")

source_set("child_module") {
  public = [
    "child_module_manager.h",
    "child_module_paths.h",
    "features.h",
  ]

  sources = [
    "child_module_manager.cc",
    "child_module_watcher.cc",
    "child_module_watcher.h",
    "features.cc",
    "version_set.h",
  ]

  public_deps = [
    "//base",
    "//chrome/common/child_module",
    "//content/public/browser",
    "//content/public/common",
  ]

  deps = [
    "//chrome/common:constants",
    "//components/prefs",
  ]

  if (is_win) {
    sources += [ "child_module_paths_win.cc" ]
  }
  if (is_mac || is_linux) {
    sources += [ "child_module_paths_stub.cc" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [ "child_module_paths_unittest.cc" ]

  deps = [
    ":child_module",
    "//base",
    "//base/test:test_support",
    "//chrome/common:constants",
    "//chrome/common/child_module",
    "//testing/gmock",
    "//testing/gtest",
  ]

  # TODO(crbug.com/558598893): Dynamic child module staging and FilePathWatcher
  # are not yet supported on macOS.
  if (is_win || is_linux) {
    sources += [ "child_module_manager_unittest.cc" ]
    deps += [
      "//chrome/browser:browser_process",
      "//chrome/test:test_support",
      "//components/prefs:test_support",
      "//content/test:test_support",
    ]
  }
}
