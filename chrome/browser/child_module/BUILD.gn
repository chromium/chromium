assert(!is_android)

source_set("child_module") {
  public = [
    "child_module_manager.h",
    "features.h",
  ]

  sources = [
    "child_module_manager.cc",
    "child_module_watcher.cc",
    "child_module_watcher.h",
    "features.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/common/child_module",
  ]

  deps = [
    "//chrome/common:constants",
    "//components/prefs",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "child_module_manager_unittest.cc" ]

  deps = [
    ":child_module",
    "//base",
    "//base/test:test_support",
    "//chrome/browser:browser_process",
    "//chrome/common:constants",
    "//chrome/common/child_module",
    "//components/prefs:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
