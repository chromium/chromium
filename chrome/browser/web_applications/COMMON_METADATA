monorail: {
  component: "UI>Browser>WebAppInstalls"
}
team_email: "pwa-dev@chromium.org"
buganizer_public: {
  component_id: 1457043
}

# Opt in to agentic code review.
agentic_review {
  # Web apps tests: unit, browser, and interactive UI tests in the desktop
  # trees, and the web apps sync integration tests.
  capability_groups {
    path_expression: [
      "chrome/browser/(web_applications|ui/web_applications|ui/views/web_apps)/.*_(unittest|browsertest|interactive_uitest|interactve_uitest|ui_test)(_[a-z0-9_]+)?\\.(cc|mm)",
      "chrome/browser/sync/test/integration/web_apps/.*_test(_[a-z0-9_]+)?\\.cc"
    ]
    path_expression_exclusion: [".*_(base|util|utils|helper|helpers|mixin)\\.(cc|mm)"]
    review_capability_skills: ["chrome/browser/web_applications/docs/skills/webapps-testing-review/SKILL.md"]
  }
  capability_groups {
    path_expression: "chrome/browser/web_applications/app_service/.*\\.(cc|h)"
    path_expression_exclusion: [".*_(unittest|browsertest)\\.(cc|h)"]
    review_capability_skills: ["chrome/browser/web_applications/_agents/skills/webapps-app-service-review/SKILL.md"]
  }
  # Web apps commands, locks, and provider usage in non-test desktop files.
  capability_groups {
    path_expression: "chrome/browser/(web_applications|ui/web_applications|ui/views/web_apps)/.*\\.(cc|h|mm)"
    path_expression_exclusion: [
      ".*/test(s|_support)?/.*",
      ".*/(test|fake|mock)_[^/]*",
      ".*_(unittest|browsertest|interactive_uitest|perftest|ui_test|fuzzer|test)(_[a-z0-9_]+)?\\.(cc|h|mm)"
    ]
    review_capability_skills: ["components/webapps/_agents/skills/webapps-command-and-lock-review/SKILL.md"]
  }
  # Web apps Mojo security and origin validation in non-test files.
  capability_groups {
    path_expression: "chrome/browser/(web_applications|ui/web_applications)/.*\\.(cc|h|mm)"
    path_expression_exclusion: [
      ".*/test(s|_support)?/.*",
      ".*/(test|fake|mock)_[^/]*",
      ".*_(unittest|browsertest|interactive_uitest|perftest|ui_test|fuzzer|test)(_[a-z0-9_]+)?\\.(cc|h|mm)"
    ]
    review_capability_skills: ["components/webapps/_agents/skills/webapps-layering-and-security-review/SKILL.md"]
  }
}
