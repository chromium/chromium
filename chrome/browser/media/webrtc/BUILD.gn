    "//third_party/zlib/google:compression_utils",
  ]

  if (is_chromeos) {
    sources += [
      "chrome_screen_enumerator_ash_unittest.cc",
      "desktop_media_list_ash_unittest.cc",
    ]
    deps += [
      "//chrome/browser/ash/login/users",
