      "//chrome/browser/chromeos/policy/dlp/test:test_support",
      "//chrome/test:test_support_unit",
      "//chromeos/ash/components/system",
      "//components/account_id",
    ]
  }

  # These media/webrtc unit tests are desktop-only (!is_android);
  # test_stats_dictionary additionally lives in the desktop-only browser-test
  # base.
  if (!is_android) {
    sources += [
      "current_tab_desktop_media_list_unittest.cc",
      "desktop_capture_access_handler_unittest.cc",
      "desktop_media_picker_controller_unittest.cc",
      "display_media_access_handler_unittest.cc",
      "media_capture_devices_dispatcher_unittest.cc",
      "media_stream_capture_indicator_unittest.cc",
