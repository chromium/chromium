<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- User Picture Dimensions -->
    <dimen name="user_picture_size">40dp</dimen>
    <!-- user_picture_size + 2 * (ai_tier_ring_thickness_large + ai_tier_ring_spacing) -->
    <!-- TODO(crbug.com/522145863): Remove tools:ignore once used. -->
    <dimen name="user_picture_size_with_ai_tier_ring" tools:ignore="UnusedResources">50dp</dimen>
    <dimen name="badge_position_x">26dp</dimen>
    <dimen name="badge_position_y">20dp</dimen>
    <dimen name="badge_border_size">1.3dp</dimen>
    <dimen name="badge_size">20dp</dimen>

    <!-- Large Badge Dimensions -->
    <dimen name="large_badge_size">32dp</dimen>
    <dimen name="large_badge_border_size">2dp</dimen>
    <dimen name="large_badge_position_x">84dp</dimen>
    <dimen name="large_badge_position_y">78dp</dimen>

    <!-- Toolbar Identity Disc Badge Dimensions -->
    <dimen name="toolbar_identity_disc_badge_size">16dp</dimen>
    <dimen name="toolbar_identity_disc_badge_border_size">0dp</dimen>
    <dimen name="toolbar_identity_disc_badge_position_x">12dp</dimen>
    <dimen name="toolbar_identity_disc_badge_position_y">12dp</dimen>

    <!-- AI Tier Ring Dimensions -->
    <dimen name="ai_tier_ring_spacing">2dp</dimen>
    <!-- AI tier ring thickness for avatars up to 24dp -->
    <dimen name="ai_tier_ring_thickness_small">2dp</dimen>
    <!-- AI tier ring thickness for avatars larger than 24dp -->
    <!-- TODO(crbug.com/522145863): Remove tools:ignore once used. -->
    <dimen name="ai_tier_ring_thickness_large" tools:ignore="UnusedResources">3dp</dimen>
</resources>
