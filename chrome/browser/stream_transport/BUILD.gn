source_set("stream_transport") {
  sources = [
    "transport_service_factory.cc",
    "transport_service_factory.h",
  ]

  public_deps = [ "//chrome/browser/profiles:profile" ]

  deps = [
    "//base",
    "//chrome/browser/signin",
    "//components/browser_actuator/public:feature_list",
    "//components/keyed_service/core",
    "//components/signin/public/identity_manager",
    "//components/stream_transport/public:factory",
    "//components/stream_transport/public:service",
    "//content/public/browser",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "transport_service_factory_unittest.cc" ]

  deps = [
    ":stream_transport",
    "//base/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//components/browser_actuator/public:feature_list",
    "//components/stream_transport/public:service",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
