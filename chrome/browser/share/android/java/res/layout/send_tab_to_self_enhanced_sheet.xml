<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/drag_handlebar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="@dimen/stts_sheet_margin"
        android:layout_marginStart="@dimen/stts_sheet_margin"
        android:layout_marginTop="@dimen/stts_drag_handlebar_margin"
        android:layout_marginBottom="@dimen/stts_drag_handlebar_margin"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/drag_handlebar" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/drag_handlebar"
        android:layout_centerHorizontal="true"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/send_tab_to_self_enhanced_title"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Headline.Primary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheet_item_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sheet_title"
        android:layout_marginHorizontal="@dimen/stts_sheet_margin"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/bottom_actions_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sheet_item_list"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/stts_sheet_margin"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/stts_sheet_margin">
        <org.chromium.ui.widget.ButtonCompat
            android:id="@+id/send_button"
            style="@style/FilledButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/send_tab_to_self_send_button" />
        <LinearLayout
            android:id="@+id/manage_devices_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <View
                android:id="@+id/manage_devices_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/stts_sheet_margin"
                android:background="@drawable/divider_line_bg" />
            <TextView
                android:id="@+id/manage_devices_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/send_tab_to_self_manage_devices_footer"
                android:textAppearance=
                        "@style/TextAppearance.TextLarge.Primary" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
