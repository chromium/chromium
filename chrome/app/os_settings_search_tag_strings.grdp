<!-- Search tags used for CrOS settings search (go/cros-settings-search). -->
<grit-part>
  <!-- Network section. -->
  <message name="IDS_OS_SETTINGS_TAG_INSTANT_TETHERING" desc="Text for search result item which, when clicked, navigates the user to Instant hotspot settings, which lists properties about the currently-connected Instant hotspot network. Alternate phrase for: 'Disconnect Instant hotspot network', 'Configure Wi-Fi'">
    Instant hotspot
  </message>

