<?xml version="1.0" encoding="utf-8"?>
<!-- Search synonyms for settings search. Result titles reuse the existing
     IDS_SETTINGS_* strings, so this file only holds alternate search terms.

     Each setting has a single message holding a comma-separated list of
     synonyms, split at runtime in SettingsSearchRegistry.

     The messages are marked is_accessibility_with_no_ui because they are never
     rendered; they are only used as indexing terms for settings search, so no
     screenshots are required. -->
<!-- TODO(b/573316647): Remove translateable="false" once search synonyms are
     finalized. -->
<grit-part>
  <!-- Appearance section. -->
  <message name="IDS_SETTINGS_TAG_APPEARANCE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Appearance') that users might type in the Settings search bar to find the Appearance settings page (browser themes, dark mode, toolbar customization, bookmarks bar, tab position, and page zoom). Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    palette, design, customizations, page zoom, show, home, button, layout, visual, style, nicer, prettier
  </message>
  <message name="IDS_SETTINGS_TAG_THEME" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Theme') that users might type in the Settings search bar to find the setting for choosing a browser theme. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    backgrounds, wallpaper, colors, dark, mode, style, aesthetic
  </message>
  <message name="IDS_SETTINGS_TAG_COLOR_SCHEME_MODE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Mode') that users might type in the Settings search bar to find the setting for choosing a light, dark or system color scheme. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    dark, light, night, black, white, dim, system
  </message>
  <message name="IDS_SETTINGS_TAG_CUSTOMIZE_TOOLBAR" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Customize your toolbar') that users might type in the Settings search bar to find the setting for choosing which buttons are pinned to the toolbar. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    buttons, icons, pin, unpin, actions, navigation, shortcuts
  </message>
  <message name="IDS_SETTINGS_TAG_SHOW_HOME_BUTTON" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Show home button') that users might type in the Settings search bar to find the toggle for showing the home button on the toolbar. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    house, icon, toolbar, homepage, start, url, shortcut
  </message>
  <message name="IDS_SETTINGS_TAG_SHOW_BOOKMARKS_BAR" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Show bookmarks bar') that users might type in the Settings search bar to find the setting for showing the bookmarks bar. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    toolbar, favorites, top, display, shortcuts
  </message>
  <message name="IDS_SETTINGS_TAG_TAB_STRIP_POSITION" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Tab position') that users might type in the Settings search bar to find the setting for showing tabs at the top or on the side of the window. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    layout, side, vertical, screen, space, monitors, organization
  </message>
  <message name="IDS_SETTINGS_TAG_SIDE_PANEL_POSITION" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Side panel position') that users might type in the Settings search bar to find the setting for showing the side panel on the left or right of the window. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    left, right, sidebar, drawer, alignment, dock
  </message>
  <message name="IDS_SETTINGS_TAG_PAGE_ZOOM" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Page zoom') that users might type in the Settings search bar to find the setting for the default zoom level of web pages. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    magnification, scale, size, bigger, smaller, percentage, screen
  </message>

  <!-- Security section. -->
  <message name="IDS_SETTINGS_TAG_SECURITY" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Security') that users might type in the Settings search bar to find the Security settings subpage (Safe Browsing, HTTPS upgrades, secure DNS, security keys, and certificates). Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    advanced, browsing, certificates, dangerous, safe, sites, ssl
  </message>
  <message name="IDS_SETTINGS_TAG_SAFE_BROWSING" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Safe Browsing') that users might type in the Settings search bar to find the setting for choosing the level of Safe Browsing protection against dangerous websites, downloads, and extensions. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    phishing, malware, dangerous, scam, virus, protection, shield
  </message>
  <message name="IDS_SETTINGS_TAG_PASSWORDS_LEAK_DETECTION" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Warn you if a password was compromised in a data breach') that users might type in the Settings search bar to find the toggle that warns the user if a saved password was compromised in a data breach. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    breach, leak, exposed, compromised, credentials, sign-in, alert, warning, check, passkey
  </message>
  <message name="IDS_SETTINGS_TAG_SECURE_CONNECTIONS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Secure connections') that users might type in the Settings search bar to find the Secure connections section in Security settings (HTTPS connection upgrades, secure DNS, security keys, and certificates). Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    https, ssl, tls, dns, doh, certificates, keys, network, encrypted, advanced, padlock
  </message>
  <message name="IDS_SETTINGS_TAG_HTTPS_ONLY_MODE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Always use secure connections') that users might type in the Settings search bar to find the setting that upgrades navigations to HTTPS and warns before loading sites that do not support secure connections. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    https, ssl, tls, encryption, insecure, padlock
  </message>
  <message name="IDS_SETTINGS_TAG_SECURE_DNS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Use secure DNS') that users might type in the Settings search bar to find the setting for encrypting domain name lookups using DNS-over-HTTPS (DoH). Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    doh, domain, lookup, resolver, cloudflare, network
  </message>
  <message name="IDS_SETTINGS_TAG_SECURITY_KEYS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Manage security keys') that users might type in the Settings search bar to find the subpage for managing PINs, fingerprints, and resetting physical FIDO2 security keys. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    yubikey, titan, fido, pin, hardware, 2fa, mfa
  </message>
  <message name="IDS_SETTINGS_TAG_MANAGE_CERTIFICATES" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Manage certificates') that users might type in the Settings search bar to find the setting for viewing and managing SSL/TLS client certificates and trusted certificate authorities. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    ssl, tls, ca, root, authority, trust, x509
  </message>

  <!-- Privacy and Privacy Guide section. -->
  <message name="IDS_SETTINGS_TAG_PRIVACY" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Privacy and security') that users might type in the Settings search bar to find the Privacy and security settings page (cookies, tracking protection, site permissions, and browsing safety). Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    cookies, block, track, safety, check, clear, history, site, settings, permissions, lock
  </message>
  <message name="IDS_SETTINGS_TAG_PRIVACY_GUIDE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Privacy Guide') that users might type in the Settings search bar to find the step-by-step guided tour of key Chrome privacy and security controls. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    wizard, tour, checkup, walkthrough
  </message>
  <message name="IDS_SETTINGS_TAG_THIRD_PARTY_COOKIES" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Third-party cookies') that users might type in the Settings search bar to find the setting that controls how websites use third-party cookies to track browsing across sites. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    block, data, site, tracking
  </message>

  <!-- Safety Hub and Clear browsing data section. -->
  <message name="IDS_SETTINGS_TAG_CLEAR_BROWSING_DATA" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Delete browsing data') that users might type in the Settings search bar to find the setting to delete browsing history, cookies, cached images, and temporary files. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    cache, clear, cookies, history
  </message>
  <message name="IDS_SETTINGS_TAG_SAFETY_HUB_PAGE_CARD_SECTION_HEADER" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Safety at a glance') that users might type in the Settings search bar to find the Safety Check overview section showing proactive safety alerts, compromised password warnings, and security status. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    check, checkup, status, recommendations, alerts, audit, breach, scan, passwords, permissions, update
  </message>
  <message name="IDS_SETTINGS_TAG_SAFETY_HUB" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Safety Check') that users might type in the Settings search bar to find the Safety Check page that checks for compromised passwords, dangerous extensions, unused site permissions, and Chrome updates. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    passwords, permissions, recommendations, update
  </message>

  <!-- Site settings section. -->
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Site settings') that users might type in the Settings search bar to find the Site settings page that controls what information websites can use and what content they can show. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    camera, data, location, microphone, notifications, permissions, pop-ups
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_ALL_SITES" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'View permissions and data stored across sites') that users might type in the Settings search bar to find the subpage to inspect and clear cookies, storage, and permissions for individual websites. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    storage, quota, cache, localstorage, domain, cookies
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_LOCATION" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Location') that users might type in the Settings search bar to find the site setting that controls whether websites can ask to see your physical geographic location. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    gps, geolocation, map, coordinates
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_CAMERA" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Camera') that users might type in the Settings search bar to find the site setting to select your default webcam and control which websites are allowed to use your camera. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    webcam, video, call, meet, recording, stream
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_MIC" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Microphone') that users might type in the Settings search bar to find the site setting to select your default audio input device and control which sites can record from your microphone. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    mic, audio, voice, input, headset, call, recording, mute
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_NOTIFICATIONS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Notifications') that users might type in the Settings search bar to find the site setting that controls which websites can send desktop notifications and configures quieter notification prompts. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    alerts, push, banners, prompts, spam, quiet
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_POPUPS_REDIRECTS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Pop-ups and redirects') that users might type in the Settings search bar to find the site setting to block websites from automatically opening pop-up windows or redirecting tabs. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    popup, blocker, adblock, spam, windows, allow, block
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_ADS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Intrusive ads') that users might type in the Settings search bar to find the site setting to block ads on websites known to show intrusive, misleading, or disruptive advertisements. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    adblock, banners, popups, spam, misleading, block
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_JAVASCRIPT" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'JavaScript') that users might type in the Settings search bar to find the site setting to allow or block websites from running JavaScript code in the browser. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    js, scripts, code, execution, noscript, developer
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_IMAGES" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Images') that users might type in the Settings search bar to find the site setting that controls whether websites are allowed to load and display images. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    pictures, photos, graphics, media, load, display
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_SOUND" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Sound') that users might type in the Settings search bar to find the site setting to allow or mute audio playback across websites and manage per-site sound exceptions. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    audio, mute, volume, speaker, music, noise, silence
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_AUTOMATIC_DOWNLOADS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Automatic downloads') that users might type in the Settings search bar to find the site setting that controls whether websites can automatically download multiple files in sequence. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    files, batch, multiple, bulk, save, prompt
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_PDF_DOCUMENTS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'PDF documents') that users might type in the Settings search bar to find the site setting that chooses whether Chrome opens PDF files directly in a tab or downloads them. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    acrobat, reader, viewer, download, preview, adobe
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_CLIPBOARD" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Clipboard') that users might type in the Settings search bar to find the site setting that controls whether websites can ask to read text and images saved to your system clipboard. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    copy, paste, text, images, buffer, access
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_HANDLERS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Protocol handlers') that users might type in the Settings search bar to find the site setting to allow web apps to open special link types such as mailto:. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    mailto, webcal, gmail, links, scheme
  </message>
  <message name="IDS_SETTINGS_TAG_SITE_SETTINGS_ZOOM_LEVELS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Zoom levels') that users might type in the Settings search bar to find the site setting to view and remove custom page zoom levels saved for specific websites. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    magnification, scale, size, percentage, enlarge, shrink
  </message>

  <!-- People section. -->
  <message name="IDS_SETTINGS_TAG_HOME" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Home') that users might type in the Settings search bar to find the central Settings Home page for managing Google Account, Chrome profile, quick actions, data import, and default browser. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    you, google, people, services, account, profile, user, sync, sign-in, avatar, identity, personalize, default, browser, import
  </message>
  <message name="IDS_SETTINGS_TAG_PEOPLE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'You and Google') that users might type in the Settings search bar to find the settings page to manage your signed-in Google Account, Chrome profile, and sync preferences. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    home, people, services, account, profile, user, sync, sign-in, avatar, identity, personalize, default, browser
  </message>
  <message name="IDS_SETTINGS_TAG_YOUR_ACCOUNT" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Your account in Chrome') that users might type in the Settings search bar to find the subpage to manage how your Google Account data, sync settings, and encryption passphrase work in Chrome. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    sync, services, people, profile, google, backup, passphrase, encryption, data, manage
  </message>
  <message name="IDS_SETTINGS_TAG_SYNC_AND_GOOGLE_SERVICES" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Sync and Google services') that users might type in the Settings search bar to find the subpage that controls what browsing data syncs across signed-in devices and configures Google service integrations. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    data, encryption, manage, personalization
  </message>
  <message name="IDS_SETTINGS_TAG_MANAGE_GOOGLE_ACCOUNT" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Manage Your Google Account') that users might type in the Settings search bar to find the link row that opens the Google Account dashboard for security, privacy, and personal info. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    security, privacy, personal info, data, password, subscription, profile
  </message>
  <message name="IDS_SETTINGS_TAG_CUSTOMIZE_PROFILE" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Customize your Chrome profile') that users might type in the Settings search bar to find the subpage to personalize your profile name, theme color, and avatar image. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    theme, color, avatar, name, background, account
  </message>
  <message name="IDS_SETTINGS_TAG_SIGN_OUT" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Sign out') that users might type in the Settings search bar to find the action to sign out of your Google Account and stop sync on this profile. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    logout, quit, exit, clear, session, switch, user, stop
  </message>
  <message name="IDS_SETTINGS_TAG_IMPORT_DATA" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Import bookmarks and settings') that users might type in the Settings search bar to find the dialog to import bookmarks, saved passwords, and browsing history from other browsers. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    safari, edge, firefox, restore, backup, transfer, setup, old
  </message>

  <!-- Autofill and passwords section. -->
  <message name="IDS_SETTINGS_TAG_PASSWORD_MANAGER" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Google Password Manager') that users might type in the Settings search bar to find the setting to manage and autofill saved passwords, passkeys, and sign-in credentials. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    credentials, sign-in, passkey, lock, vault, keys
  </message>
  <message name="IDS_SETTINGS_TAG_PASSWORDS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Passwords') that users might type in the Settings search bar to find the setting to manage saved website usernames and passwords stored in Google Password Manager. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    credentials, passkey, sign-in
  </message>
  <message name="IDS_SETTINGS_TAG_PASSKEYS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Passkeys') that users might type in the Settings search bar to find the setting to manage cryptographic passkeys saved on this device for passwordless sign-in. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    face, fingerprint, sign-in, unlock
  </message>
  <message name="IDS_SETTINGS_TAG_PAYMENT_METHODS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Payment methods') that users might type in the Settings search bar to find the subpage to save and manage payment cards and billing info for secure checkout. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    credit cards, debit, purchase, billing, money, visa, mastercard, wallet, security, pay
  </message>
  <message name="IDS_SETTINGS_TAG_PAYMENTS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Payments') that users might type in the Settings search bar to find the setting to configure payment methods, credit cards, IBANs, and loyalty cards for checkout. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    cards, credit, ibans, methods, wallet
  </message>
  <message name="IDS_SETTINGS_TAG_CREDIT_AND_DEBIT_CARDS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Credit &amp; debit cards') that users might type in the Settings search bar to find the setting to add, edit, or remove saved credit and debit cards used for checkout autofill. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    mastercard, methods, payment, visa, debit, credit
  </message>
  <message name="IDS_SETTINGS_TAG_IBANS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'IBANs') that users might type in the Settings search bar to find the setting to save and autofill International Bank Account Numbers (IBANs) for bank payments. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    account, bank, payment, transfer
  </message>
  <message name="IDS_SETTINGS_TAG_LOYALTY_CARDS" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Loyalty cards') that users might type in the Settings search bar to find the setting to manage loyalty and rewards cards linked from Google Wallet for online shopping. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
    membership, rewards, store
  </message>
  <message name="IDS_SETTINGS_TAG_CONTACT_INFO" is_accessibility_with_no_ui="true" desc="Comma-separated list of search terms (other than the title 'Contact info') that users might type in the Settings search bar to find the subpage to manage saved contact details including names, phone numbers, email addresses, and street addresses. Do not translate the list 1:1; list the terms users typing in the target language might search for, delimited by commas." translateable="false">
