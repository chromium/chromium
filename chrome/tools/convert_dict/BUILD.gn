source_set("lib") {
  # Production code shouldn't be depending on this.
  testonly = true

  sources = [
    "aff_reader.cc",
    "aff_reader.h",
    "dic_reader.cc",
    "dic_reader.h",
    "hunspell_reader.cc",
    "hunspell_reader.h",
  ]
  configs += [ "//build/config/compiler:wexit_time_destructors" ]
  deps = [
    "//base",
    "//base:i18n",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "aff_reader_unittest.cc",
    "convert_dict_unittest.cc",
  ]
  deps = [
    ":lib",
    "//base",
    "//base:i18n",
    "//chrome/common:constants",
    "//testing/gtest",
    "//third_party/hunspell",
  ]
  data = [
    "//chrome/test/data/convert_dict/affix-flags.aff",
    "//chrome/test/data/convert_dict/description.aff",
    "//chrome/test/data/convert_dict/empty.aff",
    "//chrome/test/data/convert_dict/indexed-affix.aff",
    "//chrome/test/data/convert_dict/leading-comment.aff",
    "//chrome/test/data/convert_dict/other-commands.aff",
    "//chrome/test/data/convert_dict/prefix-suffix.aff",
    "//chrome/test/data/convert_dict/rep.aff",
    "//chrome/test/data/convert_dict/tab-separated.aff",
  ]
}

executable("convert_dict") {
  # Production code shouldn't be depending on this.
  testonly = true

  sources = [ "convert_dict.cc" ]
  configs += [ "//build/config/compiler:wexit_time_destructors" ]
  deps = [
    ":lib",
    "//base",
    "//base:i18n",
    "//build/win:default_exe_manifest",
    "//third_party/hunspell",
  ]
}
