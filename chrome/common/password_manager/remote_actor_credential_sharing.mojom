module chrome.mojom;

// Interface for sharing remote actor credentials.
// This interface is called by the renderer process (specifically the private V8
// JS API binding exposed on authorized origins like https://gemini.google.com)
// and is implemented in the browser process (by RemoteActorCredentialSharingImpl)
// to trigger the user presence verification and credential retrieval flow.
interface RemoteActorCredentialSharing {
  // Initiates remote actor credential sharing authentication flow.
  RequestAgentAuthentication(string gaia_id,
                             string domain,
                             string remote_actor_id) => (bool success);
};
