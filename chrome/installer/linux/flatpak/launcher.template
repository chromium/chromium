# INSTALLDIR (/opt/...) is reused verbatim inside /app to keep internal
# relative paths, asset loading, and common artifact staging logic identical
# across DEB, RPM, and Flatpak packages.
exec /app@@INSTALLDIR/@@PACKAGE "$@"
