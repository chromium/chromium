# Runs the @@PACKAGE daily repository and signing key maintenance job on
# systems without a cron daemon. Triggered by @@PACKAGE-repo.timer.

[Unit]
Description=@@MENUNAME repository and signing key maintenance

[Service]
Type=oneshot
ExecStart=@@INSTALLDIR/cron/@@PACKAGE
