# Ubuntu 26.04 libraries bundled into the snap package. build.py downloads the
# .debs pinned in runtime.lock.json (generated by update.py) from
# snapshot.ubuntu.com, checks their SHA256 and extracts the files the snap
# needs. See ../README.md.

create {
  platform_re: "linux-amd64"
  source {
    script {
      name: "build.py"
      use_fetch_checkout_workflow: true
    }
  }
  build {
    install: ["build.py", "install"]
    # This package only extracts .deb archives in Python; skip the CentOS 7
    # manylinux docker container (which runs Python 3.6 instead of vpython3) so
    # build.py runs under vpython3 with vpython.toml.
    no_docker_env: true
    no_toolchain: true
  }
}

upload {
  pkg_prefix: "chromium/chrome/installer/linux/snap"
}
