#!/bin/bash

# Based on Canonical's Chromium snap launcher:
# https://git.launchpad.net/~chromium-team/chromium-browser/+git/snap-from-source/tree/launcher/chromium.launcher?h=stable
#
# Portions Copyright 2018-2021 Canonical Ltd., licensed under the 3-Clause BSD
# License:
# https://git.launchpad.net/~chromium-team/chromium-browser/+git/snap-from-source/tree/LICENSE?h=stable

# Basename of the user data directory, which depends on the branding and the
# channel (see chrome/common/chrome_paths_linux.cc).
CONFIG_DIR_NAME="@@snap_config_dir"

# The browser's sandbox requires the browser-support interface with
# allow-sandbox. It isn't connected automatically for locally built snaps.
if ! snapctl is-connected browser-sandbox; then
  printf '%s\n' \
    "The browser sandbox requires the browser-sandbox plug. Run:" \
    "  sudo snap connect $SNAP_INSTANCE_NAME:browser-sandbox" >&2
  exit 1
fi

# Move an existing profile directory over to $SNAP_USER_COMMON, which is shared
# across revisions of the snap. This addresses profile corruption when the snap
# is refreshed while running, until a proper solution is implemented in snapd.
# Ref: https://launchpad.net/bugs/1616650
if [ ! -d "$SNAP_USER_COMMON/$CONFIG_DIR_NAME" ]; then
  if [ -d "$SNAP_USER_DATA/.config/$CONFIG_DIR_NAME" ]; then
    mv "$SNAP_USER_DATA/.config/$CONFIG_DIR_NAME" "$SNAP_USER_COMMON/"
  fi
fi

# When running the snap for the first time, try and locate an existing profile
# in $HOME/.config (e.g. from a deb or rpm installation), and import it if it
# was created by an older or equal version (the profile data format is not
# guaranteed to be forward-compatible). This requires the
# @@snap_config_plug personal-files plug to be connected.
if [ ! -d "$SNAP_USER_COMMON/$CONFIG_DIR_NAME" ] &&
  snapctl is-connected @@snap_config_plug; then
  HOST_CONFIG="$SNAP_REAL_HOME/.config/$CONFIG_DIR_NAME"
  PREF_FILE="$HOST_CONFIG/Default/Preferences"
  if [ -d "$HOST_CONFIG" ] && [ -r "$PREF_FILE" ]; then
    VERSION=$(sed -n -e 's/.*"last_chrome_version":"\([0-9.]\+\)".*/\1/p' \
      "$PREF_FILE")
    if [ -n "$VERSION" ]; then
      OLD=$(printf '%s\n%s\n' "$VERSION" "$SNAP_VERSION" | sort -V | head -1)
      if [ "$OLD" = "$VERSION" ]; then
        SIZE=$(du -sb "$HOST_CONFIG" | cut -f 1)
        AVAILABLE_BLOCKS=$(stat -f -c %a "$SNAP_USER_COMMON")
        BLOCK_SIZE=$(stat -f -c %s "$SNAP_USER_COMMON")
        AVAILABLE_SIZE=$((AVAILABLE_BLOCKS * BLOCK_SIZE))
        if [ "$AVAILABLE_SIZE" -gt "$SIZE" ]; then
          printf 'Importing existing profile from %s (version %s)\n' \
            "$HOST_CONFIG" "$VERSION"
          TS1=$(date +%s.%3N)
          cp -R "$HOST_CONFIG" "$SNAP_USER_COMMON/"
          TS2=$(date +%s.%3N)
          T=$(printf '%s %s' "$TS1" "$TS2" | awk '{printf "%.3f",$2-$1}')
          printf 'Import done in %s s\n' "$T"
        else
          printf 'Not importing existing profile from %s (version %s) ' \
            "$HOST_CONFIG" "$VERSION"
          printf 'because there is not enough available space in %s ' \
            "$SNAP_USER_COMMON"
          printf '(required: %s bytes / available: %s bytes)\n' \
            "$SIZE" "$AVAILABLE_SIZE"
        fi
      fi
    fi
  fi
fi

# Specify that no encrypted password store (keyring) should be used when the
# password-manager-service interface is not plugged, because the browser won't
# fall back to the basic store (no encryption) if it fails to talk to the
# default password store for the current desktop environment.
# Ref: https://launchpad.net/bugs/1763829
# When it is plugged, no store is specified, so that the browser selects one
# based on the current desktop environment. "detect" isn't used because it's
# not a recognized store anymore (see docs/linux/password_storage.md).
PASSWORD_STORE_FLAGS=()
if ! snapctl is-connected password-manager-service; then
  PASSWORD_STORE_FLAGS=(--password-store=basic)
fi

# The channel, which also determines the user data directory name for Google
# Chrome builds (see chrome/common/channel_info_posix.cc).
export CHROME_VERSION_EXTRA="@@channel"

# This convinces the browser that it is running from /snap/bin instead of the
# unconfined path, /snap/*/*@@INSTALLDIR/@@PROGNAME.
# As a result, it creates desktop files with an appropriate Exec= line.
export CHROME_WRAPPER="/snap/bin/$SNAP_INSTANCE_NAME"

# Configuration for the "man" binary, which is invoked when the browser is
# called with the "-h" (or "--help") argument
# (see https://launchpad.net/bugs/1848083).
export MAN_TEST_DISABLE_SYSTEM_CONFIG=1
export MANPATH="$SNAP"
export GROFF_FONT_PATH="$SNAP/usr/share/groff/current/font"
export GROFF_TMAC_PATH="$SNAP/usr/share/groff/current/tmac"

# Use GTK3. Ref: https://launchpad.net/bugs/2106312
# Ref: https://launchpad.net/bugs/2106342
CHROME_FLAGS=(--gtk-version=3 "${PASSWORD_STORE_FLAGS[@]}")

WANT_TEMP_PROFILE=0
for arg in "$@"; do
  shift
  if [ "$arg" = "--temp-profile" ]; then
    WANT_TEMP_PROFILE=1
    continue
  fi
  set -- "$@" "$arg"
done

# Sanitize std{in,out,err} because they'll be shared with untrusted child
# processes (http://crbug.com/40079595).
exec < /dev/null
exec > >(exec cat)
exec 2> >(exec cat >&2)

if [ $WANT_TEMP_PROFILE -eq 0 ]; then
  exec "$SNAP@@INSTALLDIR/@@PROGNAME" "${CHROME_FLAGS[@]}" "$@"
else
  TEMP_PROFILE=$(mktemp -d)
  trap 'rm -rf "$TEMP_PROFILE"' EXIT
  # Don't exec, so that the temporary profile can be cleaned up on exit.
  "$SNAP@@INSTALLDIR/@@PROGNAME" --user-data-dir="$TEMP_PROFILE" \
    "${CHROME_FLAGS[@]}" "$@"
fi
