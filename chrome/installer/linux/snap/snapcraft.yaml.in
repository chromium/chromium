# Based on Canonical's Chromium snap:
# https://git.launchpad.net/~chromium-team/chromium-browser/+git/snap-from-source/tree/snapcraft.yaml?h=stable
#
# Portions Copyright 2018-2021 Canonical Ltd., licensed under the 3-Clause BSD
# License:
# https://git.launchpad.net/~chromium-team/chromium-browser/+git/snap-from-source/tree/LICENSE?h=stable
#
# Unlike Canonical's snap, which builds Chromium from source, this snap
# repackages the binaries staged by build.py from a local build.

name: @@SNAPNAME
version: '@@version'
summary: @@SHORTDESC
description: |
  @@FULLDESC
confinement: strict
base: core26
assumes:
  - snapd2.55 # >=2.55 needed for the cups interface
compression: lzo

apps:
  @@SNAPNAME:
    extensions: [gnome]
    command: bin/chrome.launcher
    desktop: bin/@@SNAPNAME.desktop
    environment:
      ALSA_CONFIG_PATH: "$SNAP/gnome-platform/usr/share/alsa/alsa.conf"
      CHROME_DESKTOP: @@SNAPNAME.desktop
      CHROME_CONFIG_HOME: $SNAP_USER_COMMON
      GTK_USE_PORTAL: 1
      QT_PLUGIN_PATH: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/qt6/plugins
    plugs:
      - audio-playback
      - audio-record
      - bluez # for Web Bluetooth (https://launchpad.net/bugs/1887201)
      - camera
      - cups
      - hardware-observe
      - hidraw
      - home
      - joystick
      - kerberos-tickets
      - mount-observe
      - network
      - network-manager
      - password-manager-service
      - pcscd
      - raw-usb # for WebUSB (https://launchpad.net/bugs/1780678)
      - removable-media
      - screen-inhibit-control
      - serial-port
      - system-packages-doc
      - timezone-control
      - u2f-devices
      - unity7 # required for xdg-open to work
      - upower-observe
    slots:
      - mpris

plugs:
  browser-sandbox:
    interface: browser-support
    allow-sandbox: true
  # This is not used or needed for anything other than to trigger automatic
  # installation of the cups snap via "default-provider: cups"
  install-cups-runtime-dependency:
    interface: content
    content: foo
    default-provider: cups
    target: $SNAP_DATA/foo
  # Allows importing an existing profile on first launch (see chrome.launcher).
  @@snap_config_plug:
    interface: personal-files
    read: [$HOME/.config/@@snap_config_dir]

layout:
  /usr/lib/man-db:
    bind: $SNAP/usr/lib/man-db
  /usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/opensc-pkcs11.so:
    bind-file: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/opensc-pkcs11.so
  /usr/share/alsa:
    bind: $SNAP/usr/share/alsa

parts:
  # @@MENUNAME build artifacts (installed by build.py)
  chrome:
    plugin: dump
    source: chrome
    stage-packages:
      - libnss3
      - libpci3
      - libsecret-1-0
      - opensc-pkcs11
    prime:
      - -etc/init.d
      - -etc/xdg
      - -usr/include
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man
      # Only Qt 6 is bundled (see the "qt6" part).
      - -@@snap_install_dir/libqt5_shim.so

  # Qt 6 for libqt6_shim.so, which provides the Qt UI integration (e.g. on
  # KDE). The shim initializes Qt with the xcb or wayland platform plugin to
  # match the display server Chrome uses.
  qt6:
    plugin: nil
    stage-packages:
      - libqt6core6t64
      - libqt6gui6
      - libqt6widgets6
      - qt6-wayland
    prime:
      - -etc
      - -usr/bin
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

  # The launcher script and desktop file (generated by build.py)
  launcher:
    plugin: dump
    source: launcher
    organize:
      '*': bin/

  # Stage packages required for the "man" binary, which is invoked when
  # @@PROGNAME is called with the "-h" (or "--help") argument
  # (see https://launchpad.net/bugs/1848083).
  manpage:
    plugin: nil
    stage-packages:
      - groff-base
      - libgdbm6t64
      - libpipeline1
      - man-db
    prime:
      - -etc
      - -usr/lib/tmpfiles.d
      - -usr/share/bug
      - -usr/share/calendar
      - -usr/share/doc
      - -usr/share/doc-base
      - -usr/share/lintian
      - -usr/share/man
      - -usr/share/man-db
      - -var

  # Create a symlink xdg-email -> xdg-open, as the latter is perfectly able to
  # handle mailto: URLs (see https://launchpad.net/bugs/1849774).
  # xdg-open is a wrapper provided by the core snap.
  # TODO: remove once https://launchpad.net/bugs/1863625 is fixed.
  xdg-email:
    plugin: nil
    override-pull: ""
    override-prime: |
      set -eux
      mkdir -p usr/bin
      cd usr/bin
      ln -s /usr/bin/xdg-open xdg-email
