import("//ui/views/features.gni")

source_set("in_process_browser_test_mixin") {
  testonly = true
  sources = [
    "in_process_browser_test_mixin.cc",
    "in_process_browser_test_mixin.h",
  ]
  public_deps = [ "//base" ]
}

static_library("chrome_test_launcher") {
  testonly = true
  sources = [
    "chrome_test_launcher.cc",
    "chrome_test_launcher.h",
  ]
  deps = [
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser:main_extra_parts",
    "//chrome/test:test_support",
    "//testing/libfuzzer:fuzztest_init_support",
  ]
  if (is_mac) {
    deps += [
      "//chrome/app_shim",
      "//chrome/browser:chrome_browser_application_mac",
    ]
  }
  if (is_chromeos) {
    deps += [ "//chrome/browser/ash/crosapi" ]
  }
  if (is_posix && !is_mac) {
    deps += [ "//chrome/app:chrome_crash_reporter_client" ]
  }
}

# Thin header-only target that exposes test_launcher_utils.h for gn check.
# The implementation (test_launcher_utils.cc) still lives in
# //chrome/test:test_support until chrome/test/base/ is fully componentized.
#
# TODO(crbug.com/353332589): Add test_launcher_utils.{cc,h} as sources and
# remove from //chrome/test:test_support once chrome/test/base/ is fully
# componentized.
source_set("test_launcher_utils") {
  testonly = true
  sources = [ "test_launcher_utils.h" ]
  public_deps = [ "//base" ]
}

if (!is_android) {
  # Thin header-only target that exposes in_process_browser_test.h for gn check.
  # The implementation (in_process_browser_test.cc) still lives in
  # //chrome/test:test_support_ui until chrome/test/base/ is fully
  # componentized.
  #
  # TODO(crbug.com/353332589): Add in_process_browser_test.{cc,h} as sources and
  # remove from //chrome/test:test_support_ui once the dep-graph cycle through
  # //chrome/browser/ui:test_support -> //chrome/test:test_support_ui is
  # resolved.
  source_set("in_process_browser_test") {
    testonly = true
    sources = [ "in_process_browser_test.h" ]
    public_deps = [
      "//base",
      "//base/test:test_support",
      "//components/feature_engagement/test:test_support",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/base",
    ]
    if (toolkit_views) {
      public_deps += [ "//chrome/browser/ui" ]
    }
    if (is_mac) {
      public_deps += [ "//ui/base:test_support" ]
    }
  }

  # Thin header-only target that exposes ui_test_utils.h for gn check. The
  # implementation (ui_test_utils.cc) still lives in
  # //chrome/test:test_support_ui until chrome/test/base/ is fully
  # componentized.
  #
  # TODO(crbug.com/353332589): Add ui_test_utils.{cc,h} as sources and remove
  # from //chrome/test:test_support_ui once the dep-graph cycle through
  # //chrome/browser/ui:test_support -> //chrome/test:test_support_ui is
  # resolved.
  source_set("ui_test_utils") {
    testonly = true
    sources = [ "ui_test_utils.h" ]
    public_deps = [
      "//base",
      "//chrome/browser/ui",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs:tab_strip",
      "//components/history/core/browser",
      "//content/public/browser",
      "//content/test:test_support",
      "//ui/base",
      "//ui/events",
      "//ui/gfx",
      "//ui/views",
      "//url",
    ]
    if (toolkit_views) {
      public_deps += [ "//ui/views:test_support" ]
    }
  }
}
