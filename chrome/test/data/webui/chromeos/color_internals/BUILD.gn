import("../../build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [ "color_internals_browsertest.cc" ]

  ts_path_mappings = [
    "chrome://color-internals/*|" +
        rebase_path("$root_gen_dir/ash/webui/color_internals/resources/tsc/*",
                    target_gen_dir),
    "chrome://webui-test/chromeos/*|" +
        rebase_path("$root_gen_dir/chrome/test/data/webui/chromeos/tsc/*",
                    target_gen_dir),
  ]

  files = [ "color_internals_test.ts" ]

  ts_deps = [
    "//ash/webui/color_internals/resources:build_ts",
    "//chrome/test/data/webui:build_ts",
    "//chrome/test/data/webui/chromeos:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]
}
