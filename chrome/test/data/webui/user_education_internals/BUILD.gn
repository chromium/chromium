import("../build_webui_tests.gni")

assert(!is_android)

build_webui_tests("build") {
  cc_test_files = [ "user_education_internals_browsertest.cc" ]

  files = [
    "test_user_education_internals_page_handler.ts",
    "user_education_internals_test.ts",
  ]

  ts_path_mappings = [ "chrome://user-education-internals/*|" + rebase_path(
                           "$root_gen_dir/chrome/browser/resources/user_education_internals/tsc/*",
                           target_gen_dir) ]

  ts_deps = [
    "//chrome/browser/resources/user_education_internals:build_ts",
    "//ui/webui/resources/cr_components/help_bubble:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
}
