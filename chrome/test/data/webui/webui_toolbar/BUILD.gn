import("../build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [
    "webui_toolbar_js_browsertest.cc",
    "webui_toolbar_js_interactive_uitest.cc",
  ]

  files = [
    "app_menu_button_test.ts",
    "back_forward_button_test.ts",
    "battery_saver_button_test.ts",
    "content_setting_icon_test.ts",
    "cr_lazy_iconset_test.ts",
    "icon_from_table_test.ts",
    "iph_test.ts",
    "location_bar_focus_test.ts",
    "location_bar_high_contrast_focus_test.ts",
    "location_bar_test.ts",
    "location_icon_test.ts",
    "page_action_icon_test.ts",
    "performance_intervention_button_test.ts",
    "permission_chip_test.ts",
    "permission_dashboard_test.ts",
    "pinned_toolbar_action_test.ts",
    "pinned_toolbar_actions_test.ts",
    "readonly_omnibox_focus_test.ts",
    "readonly_omnibox_test.ts",
    "toolbar_action_container_mixin_test.ts",
    "toolbar_action_mixin_test.ts",
    "toolbar_app_test.ts",
    "toolbar_button_test.ts",
    "toolbar_chip_button_test.ts",
  ]

  ts_definitions = [ "//tools/typescript/definitions/chrome_send.d.ts" ]

  ts_deps = [
    "//chrome/browser/resources/webui_toolbar:build_ts",
    "//chrome/browser/resources/webui_toolbar_shared:build_ts",
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/help_bubble:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  ts_path_mappings = [
    "chrome://webui-toolbar.top-chrome*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/webui_toolbar/tsc/*",
            target_gen_dir),
    "chrome://webui-toolbar.top-chrome/shared/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/webui_toolbar_shared/tsc/*",
            target_gen_dir),
  ]
}
