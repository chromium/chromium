import("../build_webui_tests.gni")

assert(!is_android && !is_ios)

build_webui_tests("build") {
  cc_test_files = [ "omnibox_everywhere_browsertest.cc" ]

  files = [
    "omnibox_test.ts",
    "test_searchbox_browser_proxy.ts",
  ]

  ts_path_mappings = [ "chrome://omnibox-everywhere.top-chrome/omnibox_everywhere.js|" + rebase_path(
                           "$root_gen_dir/chrome/browser/resources/omnibox_everywhere/tsc/omnibox_everywhere.d.ts",
                           target_gen_dir) ]
  ts_deps = [
    "//chrome/browser/resources/omnibox_everywhere:build_ts",
    "//ui/webui/resources/cr_components/composebox:build_ts",
    "//ui/webui/resources/cr_components/search:build_ts",
    "//ui/webui/resources/cr_components/searchbox:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
}
