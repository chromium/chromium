import("../build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [ "notebooks_internals_browsertest.cc" ]

  files = [
    "notebooks_internals_test.ts",
    "test_notebooks_internals_page_handler.ts",
  ]

  ts_path_mappings = [ "chrome://notebooks-internals/*|" + rebase_path(
                           "$root_gen_dir/components/notebooks/internals/webui/resources/tsc/*",
                           target_gen_dir) ]

  ts_deps = [
    "//components/notebooks/internals/webui/resources:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]
}
