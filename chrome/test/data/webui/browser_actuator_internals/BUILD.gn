import("//chrome/test/data/webui/build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [ "browser_actuator_internals_browsertest.cc" ]

  files = [
    "browser_actuator_internals_app_test.ts",
    "test_browser_actuator_internals_ui_handler.ts",
  ]

  ts_path_mappings = [ "chrome://browser-actuator-internals/*|" + rebase_path(
                           "$root_gen_dir/chrome/browser/resources/browser_actuator_internals/tsc/*",
                           target_gen_dir) ]

  ts_deps = [ "//chrome/browser/resources/browser_actuator_internals:build_ts" ]
}
