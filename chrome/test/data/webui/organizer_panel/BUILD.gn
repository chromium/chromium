import("../build_webui_tests.gni")

build_webui_tests("build") {
  cc_test_files = [ "organizer_panel_browsertest.cc" ]
  files = [ "app_test.ts" ]

  ts_path_mappings =
      [ "chrome://organizer-panel.top-chrome/*|" +
        rebase_path(
            "$root_gen_dir/chrome/browser/resources/organizer_panel/tsc/*",
            target_gen_dir) ]

  ts_deps = [
    "//chrome/browser/resources/organizer_panel:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]
}
