import("//ui/webui/webui_features.gni")
import("../build_webui_tests.gni")

assert(enable_webui_tabstrip_ntb)

build_webui_tests("build") {
  cc_test_files = [ "tabstrip_ntb_browsertest.cc" ]

  files = [ "new_tab_button_test.ts" ]

  ts_path_mappings = [
    "chrome://tabstrip-ntb.top-chrome/*|" +
        rebase_path("$root_gen_dir/chrome/browser/resources/tabstrip_ntb/tsc/*",
                    target_gen_dir),
    "/tab_strip_api/*|" + rebase_path(
            "$root_gen_dir/components/browser_apis/tab_strip/resources/tsc/*",
            target_gen_dir),
  ]

  ts_deps = [
    "//chrome/browser/resources/tabstrip_ntb:build_ts",
    "//components/browser_apis/tab_strip/resources:build_ts",
    "//ui/webui/resources/js:build_ts",
  ]
}
