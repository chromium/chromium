{
  "name": "Manifest with x-scheme-handler in file_handlers",
  "icons": [
    {
      "src": "launcher-icon-4x.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "start_url": "manifest_test_page.html",
  "scope": "/",
  "display": "standalone",
  "file_handlers": [
    {
      "action": "/open-foo",
      "accept": {
        "x-scheme-handler/mailto": [
          ".eml"
        ],
        "x-content/image-dcf": [
          ".dcf"
        ],
        "x-directory/normal": [
          ".dir"
        ],
        "x-special/socket": [
          ".sock"
        ],
        "x-custom/foo": [
          ".custom"
        ],
        "application/foo": [
          ".foo"
        ]
      }
    }
  ]
}
