import("//build/rust/rust_static_library.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

# Pure-Rust parser for UDIF (.dmg) disk images and HFS+/HFSX filesystems.
# Kept free of `unsafe` code.
rust_static_library("dmg_parser") {
  visibility = [ ":*" ]

  crate_root = "rust/lib.rs"
  sources = [
    "rust/hfs.rs",
    "rust/lib.rs",
    "rust/udif.rs",
  ]
}

rust_static_library("dmg_parser_unittests") {
  testonly = true
  is_gtest_unittests = true
  visibility = [ ":*" ]

  crate_root = "rust/dmg_parser_unittests.rs"
  sources = [ "rust/dmg_parser_unittests.rs" ]
  deps = [
    ":dmg_parser",
    "//testing/rust_gtest_interop",
  ]
}

source_set("read_stream_bridge_hdr") {
  visibility = [ ":*" ]
  sources = [ "rust/read_stream_bridge.h" ]
  public_deps = [ "//build/rust:cxx_cppdeps" ]
}

# `cxx` FFI bridge exposing `dmg_parser` to C++ (`UDIFParser` / `HFSIterator`).
# This is the only Rust target here that permits `unsafe` (for
# `#[cxx::bridge]`).
rust_static_library("dmg_ffi_bridge") {
  visibility = [
    ":*",
    "//chrome/utility/safe_browsing:*",
  ]

  allow_unsafe = true
  crate_root = "rust/ffi.rs"
  sources = [ "rust/ffi.rs" ]
  cxx_bindings = [ "rust/ffi.rs" ]

  deps = [
    ":dmg_parser",
    ":read_stream_bridge_hdr",
  ]
}

config("dmg_public_config") {
  libs = [ "bz2" ]
  frameworks = [ "CoreFoundation.framework" ]
}

source_set("dmg_common") {
  visibility = [
    ":*",
    "//chrome/utility/safe_browsing:*",
  ]

  sources = [
    "convert_big_endian.h",
    "hfs.cc",
    "hfs.h",
    "read_stream.cc",
    "read_stream.h",
    "rust/read_stream_bridge.cc",
    "udif.cc",
    "udif.h",
  ]

  deps = [
    ":read_stream_bridge_hdr",
    "//base",
    "//components/safe_browsing/core/common:features",
    "//third_party/zlib",
  ]

  public_deps = [ ":dmg_ffi_bridge" ]

  public_configs = [ ":dmg_public_config" ]
}

executable("crdmg") {
  sources = [ "crdmg.cc" ]

  deps = [
    ":dmg_common",
    "//base",
    "//sandbox/mac:seatbelt",
  ]
}

fuzzer_test("safe_browsing_dmg_fuzzer") {
  sources = [ "dmg_fuzzer.cc" ]

  deps = [
    ":dmg_common",
    "//base",
    "//testing/libfuzzer:libfuzzer_base_wrappers",
  ]
}

fuzzer_test("safe_browsing_hfs_fuzzer") {
  sources = [ "hfs_fuzzer.cc" ]

  deps = [
    ":dmg_common",
    "//base",
    "//testing/libfuzzer:libfuzzer_base_wrappers",
  ]

  seed_corpus = rebase_path("//chrome/test/data/safe_browsing/dmg/data")

  libfuzzer_options = [ "max_len=1488576" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "dmg_analyzer_unittest.cc",
    "dmg_test_utils.cc",
    "dmg_test_utils.h",
    "hfs_unittest.cc",
    "read_stream_unittest.cc",
    "udif_unittest.cc",
  ]
  deps = [
    ":dmg_common",
    ":dmg_parser_unittests",
    "//base",
    "//base/test:test_support",
    "//chrome/common:constants",
    "//chrome/common/safe_browsing:archive_analyzer_results",
    "//chrome/utility/safe_browsing",
    "//components/safe_browsing/core/common:features",
    "//testing/gtest",
  ]
}
