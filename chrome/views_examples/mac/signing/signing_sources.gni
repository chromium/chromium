import("//chrome/installer/mac/mac_signing_sources.gni")

# The Chrome Mac signing sources, minus the files that are overridden by the
# Views Examples specific implementations in this directory, followed by those
# overrides. All paths are source-absolute so that this list can be consumed
# from any BUILD file.
#
# NOTE: build_props_config.py is generated by :sign_config and is not listed
# here.
views_examples_signing_sources = []
foreach(_source,
        mac_signing_sources - [
              "signing/chromium_config.py",
              "signing/config_factory.py",
              "signing/parts.py",
              "signing/pipeline.py",
            ]) {
  views_examples_signing_sources += [ "//chrome/installer/mac/$_source" ]
}
views_examples_signing_sources += [
  "//chrome/views_examples/mac/signing/config_factory.py",
  "//chrome/views_examples/mac/signing/parts.py",
  "//chrome/views_examples/mac/signing/pipeline.py",
  "//chrome/views_examples/mac/signing/unbranded_config.py",
]
