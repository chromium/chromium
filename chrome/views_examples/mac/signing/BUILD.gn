# Packaging and signing support for the Views Examples app
# (//ui/views/examples:views_examples). This reuses the Chrome Mac signing
# pipeline from //chrome/installer/mac/signing, overriding the parts that are
# product specific. It lives under //chrome because //ui must not depend on
# //chrome.

import("//chrome/process_version_rc_template.gni")
import("//testing/test.gni")
import("//ui/views/examples/views_examples.gni")
import("signing_sources.gni")

assert(is_mac)

group("signing") {
  testonly = true

  public_deps = [ ":copies" ]

  # Make sure the app to sign is built alongside the signing scripts.
  deps = [ "//ui/views/examples:views_examples" ]
}

_packaging_dir = "$root_out_dir/$views_examples_app_name Packaging"

process_version_rc_template("sign_config") {
  visibility = [ ":copy_signing" ]

  process_only = true

  template_file = "build_props_config.py.in"

  output = "$_packaging_dir/signing/build_props_config.py"

  _full_target_name = get_label_info(target_name, "label_no_toolchain")

  extra_args = [
    "-e",
    "GEN_HEADER=\"THIS FILE IS AUTOMATICALLY GENERATED BY $_full_target_name.\n\"",
    "-e",
    "PRODUCT_FULLNAME=\"$views_examples_app_name\"",
    "-e",
    "FRAMEWORK_FULLNAME=\"$views_examples_framework_name.framework\"",
    "-e",
    "MAC_BUNDLE_ID=\"org.chromium.ViewsExamples\"",
  ]
}

copy("copy_signing") {
  visibility = [ ":copies" ]

  public_deps = [ ":sign_config" ]

  sources = views_examples_signing_sources

  outputs = [ "$_packaging_dir/signing/{{source_file_part}}" ]
}

copy("copies") {
  visibility = [ ":signing" ]

  public_deps = [ ":copy_signing" ]

  sources = [ "//chrome/installer/mac/sign_chrome.py" ]

  outputs = [ "$_packaging_dir/sign_views_examples.py" ]
}

script_test("views_examples_mac_signing_tests") {
  script = "//testing/scripts/run_isolated_script_test.py"

  args = [ "@WrappedPath(" +
           rebase_path("run_mac_signing_tests.py", root_build_dir) + ")" ]

  # run_mac_signing_tests.py merges the overrides in this directory into a copy
  # of the base library from //chrome/installer/mac/signing, so both are needed
  # at runtime.
  data = views_examples_signing_sources + [
           "parts_test.py",
           "pipeline_test.py",
           "run_mac_signing_tests.py",
           "//third_party/catapult/third_party/typ/",
         ]
}
