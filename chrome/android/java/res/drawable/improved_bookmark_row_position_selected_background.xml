<!-- Background for a selected bookmark row within a run of consecutive rows.
     Its corner radii come from the theme, so it must be loaded with one of
     the ThemeOverlay.BookmarkRow.ListPosition.* overlays applied. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerLow" />
    <corners
        android:topLeftRadius="?attr/bookmarkRowTopRadius"
        android:topRightRadius="?attr/bookmarkRowTopRadius"
        android:bottomLeftRadius="?attr/bookmarkRowBottomRadius"
        android:bottomRightRadius="?attr/bookmarkRowBottomRadius" />
</shape>
