<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingStart="16dp"
      android:paddingEnd="8dp"
      android:paddingTop="8dp"
      android:paddingBottom="8dp">

    <org.chromium.components.browser_ui.widget.chips.ChipView
        android:id="@+id/app_history_filter_chip"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginEnd="8dp" />

    <org.chromium.components.browser_ui.widget.chips.ChipView
        android:id="@+id/host_history_filter_chip"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginEnd="8dp" />

    <org.chromium.components.browser_ui.widget.chips.ChipView
        android:id="@+id/client_history_filter_chip"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginEnd="8dp" />

    <org.chromium.components.browser_ui.widget.chips.ChipView
        android:id="@+id/actor_history_filter_chip"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginEnd="8dp" />

    <org.chromium.ui.widget.ButtonCompat
        android:id="@+id/reset_history_filters_button"
        style="@style/TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/history_reset_filters"
        android:visibility="gone" />

  </LinearLayout>

</HorizontalScrollView>
