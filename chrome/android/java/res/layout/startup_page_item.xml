<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/min_touch_target_size"
    android:paddingTop="@dimen/on_startup_page_item_vertical_padding"
    android:paddingBottom="@dimen/on_startup_page_item_vertical_padding">

    <ImageView
        android:id="@+id/startup_page_favicon"
        android:layout_width="@dimen/radio_button_with_description_icon_size"
        android:layout_height="@dimen/radio_button_with_description_icon_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/list_item_default_margin"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:src="@drawable/ic_globe_24dp" />

    <TextView
        android:id="@+id/startup_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/startup_page_favicon"
        android:layout_toStartOf="@+id/startup_page_more_button"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.TextLarge.Primary" />

    <TextView
        android:id="@+id/startup_page_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/startup_page_title"
        android:layout_alignStart="@id/startup_page_title"
        android:layout_alignEnd="@id/startup_page_title"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />

    <org.chromium.ui.listmenu.ListMenuButton
        android:id="@+id/startup_page_more_button"
        android:layout_width="@dimen/min_touch_target_size"
        android:layout_height="@dimen/min_touch_target_size"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_more_vert_24dp"
        app:menuVerticalOverlapAnchor="false" />

</RelativeLayout>
