<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <org.chromium.ui.widget.LoadingView
        android:id="@+id/autofill_ai_loading_view"
        android:layout_width="@dimen/autofill_loading_dialog_spinner_size"
        android:layout_height="@dimen/autofill_loading_dialog_spinner_size"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/autofill_ai_loading_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TextMedium.Primary" />

</LinearLayout>
