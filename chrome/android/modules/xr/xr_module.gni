# The XR prebuilt AARs (androidx.xr, impress, ARCore) ship native libs for
# every ABI; pick the jni/ subdir that matches the 64-bit target_cpu instead
# of hardcoding arm64-v8a, so the x86_64 emulator build packages x86_64 libs.
if (target_cpu == "x64") {
  _xr_jni_abi = "x86_64"
} else {
  _xr_jni_abi = "arm64-v8a"
}

xr_module_desc = {
  name = "xr"
  android_manifest =
      "//chrome/android/modules/xr/internal/java/AndroidManifest.xml"
  java_deps = [
    "//chrome/android/modules/xr:java",
    "//third_party/android_deps:com_google_ar_impress_java",
    "//third_party/android_sdk:android_xr_extensions_java",
    "//third_party/androidx:androidx_xr_arcore_arcore_openxr_java",
    "//third_party/androidx:androidx_xr_runtime_runtime_openxr_java",
    "//third_party/arcore-android-sdk-client:com_google_ar_core_java",
  ]
  uses_split = "chrome"
  loadable_modules_64_bit = [
    "$root_out_dir/obj/third_party/androidx/androidx_xr_arcore_arcore_openxr_java/jni/$_xr_jni_abi/libandroidx.xr.arcore.openxr.so",
    "$root_out_dir/obj/third_party/androidx/androidx_xr_runtime_runtime_openxr_java/jni/$_xr_jni_abi/libandroidx.xr.runtime.openxr.so",
    "$root_out_dir/obj/third_party/android_deps/com_google_ar_impress_java/jni/$_xr_jni_abi/libimpress_api_jni.so",
    "$root_out_dir/obj/third_party/arcore-android-sdk-client/com_google_ar_core_java/jni/$_xr_jni_abi/libarcore_sdk_jni.so",
    "$root_out_dir/obj/third_party/arcore-android-sdk-client/com_google_ar_core_java/jni/$_xr_jni_abi/libarcore_sdk_c.so",
  ]
}
