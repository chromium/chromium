"set"
"static"
"super"
"switch"
"target"
"this"
"throw"
"true"
"try"
"typeof"
"undefined"
"using"
"var"
"void"
"while"
"window"
"with"

# Known built-in objects and classes
"Object"
"Array"
"Function"
"String"
"Number"
"Boolean"
"Symbol"
"BigInt"
"Math"
"Date"
"RegExp"
"Map"
"Set"
"WeakMap"
