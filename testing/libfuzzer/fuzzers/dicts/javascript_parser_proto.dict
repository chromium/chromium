# Elementary building blocks:

# Empty
" "

# Tokens
"("
")"
"["
"]"
"{"
"}"
":"
";"
"."
"..."
"?"
"?."
"??"
"++"
"--"
"=>"
"!"
"~"
"="
"|="
"^="
"&="
"<<="
">>="
">>>="
"+="
"-="
"*="
"/="
"%="
"**="
"||="
"&&="
"??="
","
"||"
"&&"
"|"
"^"
"&"
"<<"
">>"
">>>"
"+"
"-"
"*"
"/"
"%"
"**"
"=="
"!="
"==="
"!=="
"<"
">"
"<="
">="
"#"
".#"
"?.#"
"@"

# Keywords, contextual keywords, literals, reserved words.
"__proto__"
"accessor"
"anonymous"
"arguments"
"as"
"assert"
"async"
"await"
"break"
"case"
"catch"
"class"
