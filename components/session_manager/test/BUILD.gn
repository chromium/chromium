static_library("test_support") {
  testonly = true

  sources = [
    "fake_user_session_test_environment_delegate.cc",
    "fake_user_session_test_environment_delegate.h",
    "user_session_test_environment.cc",
    "user_session_test_environment.h",
  ]

  public_deps = [ "//components/account_id" ]

  deps = [
    "//base",
    "//components/prefs:test_support",
