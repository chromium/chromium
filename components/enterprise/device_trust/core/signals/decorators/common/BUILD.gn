source_set("common") {
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [ "signals_decorator.h" ]

  public_deps = [ "//base" ]
}

source_set("test_support") {
  testonly = true
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "mock_signals_decorator.cc",
    "mock_signals_decorator.h",
  ]

  public_deps = [
    ":common",
    "//testing/gmock",
  ]

  deps = [ "//base" ]
}
