# Public interfaces of the multiplexed session channel and feature handlers.
# Nothing here may depend on //components/browser_actuator or on the low-level
# OnePlatform stream client
# (`//components/stream_transport/public/proto_stream`).
source_set("public") {
  sources = [
    "common.h",
    "transport_channel.h",
    "transport_handler.cc",
    "transport_handler.h",
    "transport_handler_factory.h",
    "transport_handler_factory_registry.h",
    "transport_session.h",
    "transport_session_registry.h",
  ]

  public_deps = [
    "//base",
    "//third_party/protobuf:protobuf_lite",
  ]
}

# Kept separate from ":public" so that consumers of the transport interfaces
# do not pick up a dependency on the wire proto unless they actually translate
# between PayloadType and the wire enum.
source_set("payload_type_mapping") {
  sources = [ "payload_type_mapping.h" ]

  public_deps = [
    ":public",
    "//base",
    "//components/sharing_message/proto",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "payload_type_mapping_unittest.cc" ]

  deps = [
    ":payload_type_mapping",
    ":public",
    "//base",
    "//components/sharing_message/proto",
    "//testing/gtest",
  ]

  visibility = [ "//components/stream_transport:unit_tests" ]
}

# The per-profile TransportService KeyedService interface. Separate from
# ":public" so that handler code does not pull in //components/keyed_service.
source_set("service") {
  sources = [
    "transport_service.cc",
    "transport_service.h",
  ]

  public_deps = [
    ":public",
    "//components/keyed_service/core",
    "//url",
  ]
}

# Factory function for creating the concrete per-profile TransportService. This
# is the only target permitted to depend on
# `//components/stream_transport/internal:service`.
source_set("factory") {
  sources = [
    "transport_service_factory_helper.cc",
    "transport_service_factory_helper.h",
  ]

  public_deps = [
    ":service",
    "//base",
  ]

  deps = [
    "//components/stream_transport/internal:service",
    "//services/network/public/cpp",
  ]
}
