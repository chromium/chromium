include_rules = [
  # The transport must not depend on //components/browser_actuator, so that
  # other features can use it on its own.
  "-components/browser_actuator",
  "+components/stream_transport/internal",
  "+components/stream_transport/public",
  "+services/network",
]

specific_include_rules = {
  ".*_unittest\\.cc": [
    "+components/stream_transport/test_support",
    "+net/base/net_errors.h",
  ],
  "rust_stream_framer_unittest\\.cc": [
    "+components/stream_transport/test_support",
    "+third_party/fuzztest/src/fuzztest/fuzztest.h",
  ],
}
