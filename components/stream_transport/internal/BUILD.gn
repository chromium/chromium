# Multiplexed session channel, sequencer, and service implementation (see
# README.md). Consumes the low-level OnePlatform stream layer strictly through
# `//components/stream_transport/public/proto_stream`, never reaching into
# `//components/stream_transport/internal/proto_stream`.

# Utilities internal to the multiplexed session channel.
source_set("metrics_utils") {
  sources = [ "metrics_utils.h" ]

  public_deps = [
    "//base",
    "//components/stream_transport/public",
  ]

  visibility = [ "//components/stream_transport/internal/*" ]
}

# Features and params of the multiplexed session channel and service.
source_set("features") {
  sources = [
    "features.cc",
    "features.h",
  ]

  public_deps = [ "//base" ]

  visibility = [
    "//chrome/browser/sharing/browser_actuator:*",
    "//components/browser_actuator/*",
    "//components/stream_transport/internal:*",
    "//components/stream_transport/internal/upstream_message_client:*",
  ]
}

source_set("probe_payload") {
  visibility = [ ":*" ]

  sources = [
    "probe_payload.cc",
    "probe_payload.h",
  ]

  public_deps = [
    "//base",
    "//components/stream_transport/internal/proto",
  ]
}

source_set("session_stream_recorder") {
  visibility = [
    ":*",
    "//chrome/browser/browser_actuator/internals:*",
    "//chrome/browser/sharing/browser_actuator:unit_tests",
  ]

  sources = [
    "session_stream_recorder.cc",
    "session_stream_recorder.h",
    "transport_message_observer.h",
  ]

  public_deps = [
    "//base",
    "//components/sharing_message/proto",
    "//components/stream_transport/internal/proto",
    "//components/stream_transport/public",
    "//components/stream_transport/public:payload_type_mapping",
  ]

  deps = [
    ":metrics_utils",
    "//components/sharing_message/proto:actuator_downstream_message_extras",
    "//components/stream_transport/internal/proto:transport_messages_extras",
    "//third_party/protobuf:protobuf_lite",
  ]
}

# The channel, sessions and registries that route payloads between the stream
# and feature handlers.
source_set("channel") {
  visibility = [ ":*" ]

  sources = [
    "control_transport_handler.cc",
    "control_transport_handler.h",
    "downstream_message_sequencer.cc",
    "downstream_message_sequencer.h",
    "probe_transport_handler.cc",
    "probe_transport_handler.h",
    "transport_channel_impl.cc",
    "transport_channel_impl.h",
    "transport_handler_factory_registry_impl.cc",
    "transport_handler_factory_registry_impl.h",
    "transport_session_impl.cc",
    "transport_session_impl.h",
    "transport_session_registry_impl.cc",
    "transport_session_registry_impl.h",
  ]

  public_deps = [
    ":session_stream_recorder",
    "//components/sharing_message/proto",
    "//components/stream_transport/public",
    "//components/stream_transport/public:payload_type_mapping",
    "//components/stream_transport/public/proto_stream",
  ]

  deps = [
    ":features",
    ":metrics_utils",
    ":probe_payload",
    "//base",
    "//components/stream_transport/internal/proto",
    "//components/stream_transport/internal/upstream_message_client",
    "//components/stream_transport/public/proto_stream:factory",
  ]
}

# TransportServiceImpl: assembles the stream client, upstream client and channel
# for one profile. Only `//components/stream_transport/public:factory`
# constructs it.
source_set("service") {
  visibility = [
    ":*",
    "//components/stream_transport/public:factory",
  ]

  sources = [
    "transport_service_impl.cc",
    "transport_service_impl.h",
  ]

  public_deps = [
    "//base",
    "//components/signin/public/identity_manager",
    "//components/stream_transport/public:service",
    "//url",
  ]

  deps = [
    ":channel",
    ":features",
    ":session_stream_recorder",
    "//components/signin/public/base",
    "//components/stream_transport/internal/upstream_message_client",
    "//components/stream_transport/public",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/public/proto_stream:factory",
    "//net",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "control_transport_handler_unittest.cc",
    "downstream_message_sequencer_unittest.cc",
    "probe_payload_unittest.cc",
    "probe_transport_handler_unittest.cc",
    "session_stream_recorder_unittest.cc",
    "transport_channel_impl_unittest.cc",
    "transport_handler_factory_registry_impl_unittest.cc",
    "transport_handler_unittest.cc",
    "transport_service_impl_unittest.cc",
    "transport_service_integration_unittest.cc",
    "transport_session_impl_unittest.cc",
    "transport_session_registry_impl_unittest.cc",
  ]

  deps = [
    ":channel",
    ":features",
    ":metrics_utils",
    ":probe_payload",
    ":service",
    ":session_stream_recorder",
    "test_support",
    "//base",
    "//base/test:test_support",
    "//components/sharing_message/proto",
    "//components/signin/public/identity_manager",
    "//components/signin/public/identity_manager:test_support",
    "//components/stream_transport/internal/proto",
    "//components/stream_transport/internal/upstream_message_client",
    "//components/stream_transport/public",
    "//components/stream_transport/public:factory",
    "//components/stream_transport/public:payload_type_mapping",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/test_support",
    "//components/stream_transport/test_support/proto_stream",
    "//net",
    "//net/traffic_annotation:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]

  visibility = [ "//components/stream_transport:unit_tests" ]
}

# Fails `gn gen` if a transport target starts depending on
# //components/browser_actuator, or if the low-level `proto_stream` layer
# depends on the outer multiplexed session channel. Depended on by
# //components/stream_transport:unit_tests so that it is always checked.
group("isolation_check") {
  testonly = true

  deps = [
    ":channel",
    ":features",
    ":metrics_utils",
    ":probe_payload",
    ":service",
    ":session_stream_recorder",
    "proto",
    "proto:transport_messages_extras",
    "proto_stream:isolation_check",
    "test_support",
    "upstream_message_client",
    "//components/stream_transport/public",
    "//components/stream_transport/public:factory",
    "//components/stream_transport/public:payload_type_mapping",
    "//components/stream_transport/public:service",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/public/proto_stream:factory",
    "//components/stream_transport/test_support",
    "//components/stream_transport/test_support/proto_stream",
  ]

  assert_no_deps = [
    "//components/browser_actuator:*",
    "//components/browser_actuator/*",
  ]
}
