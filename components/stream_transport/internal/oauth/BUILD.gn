# Lives in its own target to keep the signin dependency out of the core
# transport.
source_set("oauth") {
  sources = [
    "oauth_stream_connection_delegate.cc",
    "oauth_stream_connection_delegate.h",
  ]

  public_deps = [
    "//base",
    "//components/signin/public/base",
    "//components/signin/public/identity_manager",
    "//components/stream_transport/internal:transport",
    "//google_apis",
  ]

  deps = [
    "//net",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "oauth_stream_connection_delegate_unittest.cc" ]

  deps = [
    ":oauth",
    "//base",
    "//base/test:test_support",
    "//components/signin/public/identity_manager:test_support",
    "//components/stream_transport/internal:transport",
    "//components/stream_transport/internal/test_support",
    "//net",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
  ]

  visibility = [ "//components/stream_transport:unit_tests" ]
}
