import("//build/rust/rust_static_library.gni")

# Concrete OnePlatform `alt=proto` stream implementations. All targets here are
# strictly internal to `proto_stream` and exposed only through the factory
# targets in `//components/stream_transport/public/proto_stream`.

# C++ transport client for OnePlatform `alt=proto` server-streaming RPCs:
# owns the network connection and fans complete (still serialized)
# messages out to observers. Framing of the untrusted stream bytes is
# behind the injected StreamFramer factory, so this target does not link
# any Rust.
source_set("proto_stream_client") {
  visibility = [
    ":*",
    "//components/stream_transport/public/proto_stream:factory",
  ]

  sources = [
    "proto_stream_client.cc",
    "proto_stream_client.h",
  ]

  public_deps = [
    "//base",
    "//components/stream_transport/public/proto_stream",
    "//net",
    "//services/network/public/cpp",
    "//url",
  ]

  deps = [ "//services/network/public/mojom" ]
}

# StreamConnectionDelegate decorator that supplies a freshly serialized protobuf
# request/resume body on each connection or reconnection attempt.
source_set("resume_body_connection_delegate") {
  visibility = [
    ":*",
    "//components/stream_transport/public/proto_stream:factory",
  ]

  sources = [
    "resume_body_connection_delegate.cc",
    "resume_body_connection_delegate.h",
  ]

  public_deps = [
    "//base",
    "//components/stream_transport/public/proto_stream",
  ]

  deps = [ "//services/network/public/cpp" ]
}

# StreamConnectionDelegate decorator that mints primary-account OAuth2 bearer
# tokens and retries once on HTTP 401 after cache invalidation. Kept in its own
# target so //components/signin stays out of :proto_stream_client.
source_set("oauth") {
  visibility = [
    ":*",
    "//components/stream_transport/public/proto_stream:factory",
  ]

  sources = [
    "oauth_stream_connection_delegate.cc",
    "oauth_stream_connection_delegate.h",
  ]

  public_deps = [
    "//base",
    "//components/signin/public/base",
    "//components/signin/public/identity_manager",
    "//components/stream_transport/public/proto_stream",
    "//google_apis",
  ]

  deps = [
    "//net",
    "//services/network/public/cpp",
  ]
}

# StreamFramer implementation backed by the Rust StreamBody parser: the
# only production C++ that touches the cxx-generated bridge, so FFI types
# such as rust::Box do not leak into client code.
source_set("rust_stream_framer") {
  visibility = [
    ":*",
    "//components/stream_transport/public/proto_stream:factory",
  ]

  sources = [
    "rust_stream_framer.cc",
    "rust_stream_framer.h",
  ]

  public_deps = [
    "//base",
    "//components/stream_transport/public/proto_stream",
  ]

  deps = [ ":stream_body_bridge" ]
}

# Pure-Rust StreamBody framing parser: the part that interprets untrusted
# network input. Keep this crate free of unsafe code and of dependencies.
rust_static_library("stream_body_parser") {
  crate_root = "rust/stream_body_parser.rs"
  sources = [ crate_root ]
  visibility = [ ":*" ]
}

# Rust gtest tests for the parser; linked into components_unittests via
# the //components/stream_transport:unit_tests group.
rust_static_library("stream_body_parser_unittests") {
  testonly = true
  is_gtest_unittests = true
  crate_root = "rust/stream_body_parser_unittests.rs"
  sources = [ crate_root ]
  deps = [
    ":stream_body_parser",
    "//testing/rust_gtest_interop",
  ]
  visibility = [
    ":*",
    "//components/stream_transport:unit_tests",
  ]
}

# cxx FFI glue between RustStreamFramer and the parser crate. Contains no
# parsing logic, only type conversion; this is the only Rust target here
# that may use unsafe code.
rust_static_library("stream_body_bridge") {
  crate_root = "rust/stream_body_bridge.rs"
  sources = [ crate_root ]
  cxx_bindings = [ crate_root ]
  allow_unsafe = true  # Needed for FFI that underpins the `cxx` crate.
  deps = [ ":stream_body_parser" ]
  visibility = [ ":*" ]
}

# Includes a FuzzTest (listed in test("components_unittests")'s fuzztests)
# that fuzzes the Rust framing parser through the production StreamFramer
# surface.
source_set("unit_tests") {
  testonly = true

  sources = [
    "oauth_stream_connection_delegate_unittest.cc",
    "proto_stream_client_unittest.cc",
    "resume_body_connection_delegate_unittest.cc",
    "rust_stream_framer_unittest.cc",
  ]

  deps = [
    ":oauth",
    ":proto_stream_client",
    ":resume_body_connection_delegate",
    ":rust_stream_framer",
    "//base",
    "//base/test:test_support",
    "//components/signin/public/base",
    "//components/signin/public/identity_manager",
    "//components/signin/public/identity_manager:test_support",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/test_support/proto_stream",
    "//mojo/public/cpp/system",
    "//net",
    "//net/traffic_annotation:test_support",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/fuzztest",
    "//url",
  ]

  visibility = [ "//components/stream_transport:unit_tests" ]
}

# Fails `gn gen` if the core (non-OAuth) `proto_stream` targets ever pull in
# `//components/signin` or `//components/keyed_service`.
group("core_isolation_check") {
  testonly = true

  deps = [
    ":proto_stream_client",
    ":resume_body_connection_delegate",
    ":rust_stream_framer",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/test_support/proto_stream",
  ]

  assert_no_deps = [
    "//components/keyed_service/*",
    "//components/signin/*",
  ]

  visibility = [ ":isolation_check" ]
}

# Fails `gn gen` if the low-level OnePlatform `proto_stream` layer ever starts
# depending on the outer multiplexed session/channel/handler layer or on
# //components/browser_actuator.
group("isolation_check") {
  testonly = true

  deps = [
    ":core_isolation_check",
    ":oauth",
    ":proto_stream_client",
    ":resume_body_connection_delegate",
    ":rust_stream_framer",
    "//components/stream_transport/public/proto_stream",
    "//components/stream_transport/public/proto_stream:factory",
    "//components/stream_transport/test_support/proto_stream",
  ]

  assert_no_deps = [
    "//components/browser_actuator:*",
    "//components/browser_actuator/*",
    "//components/sharing_message/*",
    "//components/stream_transport/internal:*",
    "//components/stream_transport/internal/proto:*",
    "//components/stream_transport/internal/upstream_message_client:*",
    "//components/stream_transport/public:*",
    "//components/stream_transport/test_support:*",
  ]

  visibility = [ "//components/stream_transport/internal:isolation_check" ]
}
