include_rules = [
  # The transport must not depend on the rest of //components/browser_actuator,
  # so that other features can use it on its own. "-" has to come first: the
  # last matching rule in a DEPS file wins.
  "-components/browser_actuator",
  "+components/browser_actuator/internal/transport",
  "+components/browser_actuator/public/transport",
  "+services/network",
]

specific_include_rules = {
  # TODO(crbug.com/568448841): The endpoint params still hang off
  # browser_actuator::kBrowserActuator.
  "features\\.cc": [
    "+components/browser_actuator/public/features.h",
  ],
  ".*_unittest\\.cc": [
    "+components/browser_actuator/test_support/transport",
  ],
  "rust_stream_framer_unittest\\.cc": [
    "+components/browser_actuator/test_support/transport",
    "+third_party/fuzztest/src/fuzztest/fuzztest.h",
  ],
}
