_forwarding_header = "$target_gen_dir/transport_messages.pb.h"

write_file(
    _forwarding_header,
    [
      "// Generated forwarding header until callers move to //components/stream_transport.",
      "#ifndef COMPONENTS_BROWSER_ACTUATOR_INTERNAL_TRANSPORT_PROTO_TRANSPORT_MESSAGES_PB_H_",
      "#define COMPONENTS_BROWSER_ACTUATOR_INTERNAL_TRANSPORT_PROTO_TRANSPORT_MESSAGES_PB_H_",
      "#include \"components/stream_transport/internal/proto/transport_messages.pb.h\"",
      "#endif  // COMPONENTS_BROWSER_ACTUATOR_INTERNAL_TRANSPORT_PROTO_TRANSPORT_MESSAGES_PB_H_",
    ])

source_set("proto") {
  visibility = [
    "//chrome/browser/browser_actuator/internals:*",
    "//chrome/browser/sharing/browser_actuator/*",
    "//components/browser_actuator/*",
  ]
  sources = [ _forwarding_header ]
  public_deps = [ "//components/stream_transport/internal/proto" ]
}
