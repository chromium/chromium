# Features and params internal to the browser_actuator implementation.
# A leaf target (only //base) so that anything under internal/ can depend
# on it without cycles.
# Utilities internal to the browser_actuator implementation.
source_set("metrics_utils") {
  sources = [ "metrics_utils.h" ]

  public_deps = [
    "//base",
    "//components/browser_actuator/public",
  ]

  visibility = [ "//components/browser_actuator/*" ]
}

source_set("features") {
  sources = [
    "features.cc",
    "features.h",
  ]

  public_deps = [
    "//base",
    "//url",
  ]

  deps = [
    "//components/browser_actuator/public:feature_list",
    "//net",
  ]

  visibility = [ "//components/browser_actuator/*" ]
}

source_set("session_stream_recorder") {
  visibility = [ ":*" ]

  sources = [
    "session_stream_recorder.cc",
    "session_stream_recorder.h",
    "transport_message_observer.h",
  ]

  public_deps = [
    "//base",
    "//components/browser_actuator/internal/proto",
    "//components/browser_actuator/public",
    "//components/browser_actuator/public:payload_type_mapping",
    "//components/sharing_message/proto",
  ]

  deps = [
    "//components/browser_actuator/internal/proto:transport_messages_extras",
    "//components/sharing_message/proto:actuator_downstream_message_extras",
    "//third_party/protobuf:protobuf_lite",
  ]
}

source_set("internal") {
  visibility = [
    ":*",
    "//chrome/browser/browser_actuator:factory",
  ]

  sources = [
    "browser_actuator_service_impl.cc",
    "browser_actuator_service_impl.h",
    "control_transport_handler.cc",
    "control_transport_handler.h",
    "transport_channel_impl.cc",
    "transport_channel_impl.h",
    "transport_handler_factory_registry_impl.cc",
    "transport_handler_factory_registry_impl.h",
    "transport_session_impl.cc",
    "transport_session_impl.h",
    "transport_session_registry_impl.cc",
    "transport_session_registry_impl.h",
  ]

  public_deps = [
    ":session_stream_recorder",
    "//components/browser_actuator/internal/transport",
    "//components/browser_actuator/public",
    "//components/browser_actuator/public:payload_type_mapping",
  ]

  deps = [
    ":features",
    ":metrics_utils",
    "//base",
    "//components/browser_actuator/internal/proto",
    "//components/browser_actuator/internal/transport/proto_stream_client",
    "//components/browser_actuator/internal/transport/proto_stream_client:rust_stream_framer",
    "//components/browser_actuator/internal/transport/upstream_message_client",
    "//components/browser_actuator/public:feature_list",
    "//components/keyed_service/core",
    "//components/signin/public/identity_manager",
    "//services/network/public/cpp",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "browser_actuator_service_impl_unittest.cc",
    "control_transport_handler_unittest.cc",
    "session_stream_recorder_unittest.cc",
    "transport_channel_impl_unittest.cc",
    "transport_handler_factory_registry_impl_unittest.cc",
    "transport_handler_unittest.cc",
    "transport_session_impl_unittest.cc",
    "transport_session_registry_impl_unittest.cc",
  ]

  deps = [
    ":features",
    ":internal",
    ":metrics_utils",
    ":session_stream_recorder",
    "//base",
    "//base/test:test_support",
    "//components/browser_actuator/internal/proto",
    "//components/browser_actuator/internal/transport",
    "//components/browser_actuator/internal/transport:unit_tests",
    "//components/browser_actuator/internal/transport/oauth:unit_tests",
    "//components/browser_actuator/internal/transport/proto_stream_client",
    "//components/browser_actuator/internal/transport/proto_stream_client:unit_tests",
    "//components/browser_actuator/internal/transport/test_support",
    "//components/browser_actuator/internal/transport/upstream_message_client",
    "//components/browser_actuator/internal/transport/upstream_message_client:unit_tests",
    "//components/browser_actuator/public",
    "//components/browser_actuator/public:feature_list",
    "//components/browser_actuator/public:payload_type_mapping",
    "//components/browser_actuator/test_support",
    "//components/endpoint_fetcher",
    "//components/sharing_message/proto",
    "//components/signin/public/identity_manager",
    "//components/signin/public/identity_manager:test_support",
    "//net/traffic_annotation:test_support",
    "//services/network:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]

  visibility = [ "//components/browser_actuator:unit_tests" ]
}
