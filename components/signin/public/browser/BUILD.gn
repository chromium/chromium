if (is_android) {
  import("//build/config/android/rules.gni")
}

source_set("browser") {
  sources = [
    "signin_status_metrics_provider_helpers.cc",
    "signin_status_metrics_provider_helpers.h",
    "web_signin_tracker.cc",
    "web_signin_tracker.h",
  ]

  deps = [
    "//base",
    "//components/signin/core/browser",
    "//components/signin/public/base",
    "//components/signin/public/base:signin_buildflags",
    "//components/signin/public/identity_manager",
    "//google_apis",
  ]

  if (is_ios) {
    sources += [
      "account_switching_promo_logger.cc",
      "account_switching_promo_logger.h",
      "account_switching_promo_metrics.h",
      "account_switching_promo_prefs.cc",
      "account_switching_promo_prefs.h",
    ]
    deps += [
      "//base",
      "//components/feature_engagement/public",
      "//components/prefs",
    ]
  }
}

if (is_android) {
  java_cpp_enum("java_enums") {
    sources = [ "web_signin_tracker.h" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "signin_status_metrics_provider_helpers_unittest.cc",
    "web_signin_tracker_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//components/signin/core/browser",
    "//components/signin/public/base",
    "//components/signin/public/base:test_support",
    "//components/signin/public/identity_manager",
    "//components/signin/public/identity_manager:test_support",
    "//components/sync_preferences:test_support",
    "//google_apis",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (is_chromeos) {
    sources -= [ "signin_status_metrics_provider_helpers_unittest.cc" ]
    deps += [ "//components/account_manager_core:test_support" ]
  }

  if (is_ios) {
    sources += [
      "account_switching_promo_logger_unittest.cc",
      "account_switching_promo_prefs_unittest.cc",
    ]
    deps += [
      "//components/feature_engagement/public",
      "//components/feature_engagement/test:test_support",
      "//components/prefs",
      "//components/prefs:test_support",
    ]
  }
}
