import("//build/buildflag_header.gni")
import("//build/config/cronet/config.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

buildflag_header("buildflags") {
  header = "cbor_buildflags.h"

  # TODO(crbug.com/535682335): Remove `USE_CBOR_RUST` buildflag entirely,
  # unconditionally enable Rust CBOR parser, and drop `is_cronet_build` check
  # once Cronet supports Crubit dependencies.
  flags = [ "USE_CBOR_RUST=!$is_cronet_build" ]
}

source_set("cbor_headers") {
  visibility = [ ":*" ]
  sources = [
    "constants.h",
    "diagnostic_writer.h",
    "experiment_metrics.h",
    "reader.h",
    "values.h",
    "writer.h",
  ]

  public_deps = [
    ":buildflags",
    "//base",
  ]
}

source_set("cbor_rust_impl") {
  visibility = [ ":*" ]
  public = []
  sources = [
    "reader.cc",
    "writer.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  deps = [
    ":buildflags",
    ":cbor_headers",
    "//base",
  ]

  if (!is_cronet_build) {
    deps += [
      "//build/rust/crubit",
      "//components/cbor/rust:cbor_rust_bindings",
    ]
  }
}

component("cbor") {
  sources = [
    "diagnostic_writer.cc",
    "values.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  public_deps = [
    ":buildflags",
    ":cbor_headers",
    "//base",
  ]
  deps = [ ":cbor_rust_impl" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "diagnostic_writer_unittest.cc",
    "fuzz_unittest.cc",
    "reader_unittest.cc",
    "values_unittest.cc",
    "writer_unittest.cc",
  ]

  deps = [
    ":buildflags",
    ":cbor",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/fuzztest",
  ]
  if (!is_cronet_build) {
    deps += [
      "//components/cbor/rust:cbor_rust_bindings",
      "//components/cbor/rust:cbor_rust_unittests",
    ]
  }

  data = [ "reader_fuzzer_corpus/" ]

  # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
  # enable the diagnostic by removing this line.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}
