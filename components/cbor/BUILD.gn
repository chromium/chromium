import("//testing/libfuzzer/fuzzer_test.gni")

if (is_ios) {
  import("//build/config/ios/bundle_data_from_filelist.gni")
}

source_set("cbor_headers") {
  visibility = [ ":*" ]
  sources = [
    "constants.h",
    "diagnostic_writer.h",
    "experiment_metrics.h",
    "reader.h",
    "values.h",
    "writer.h",
  ]

  public_deps = [ "//base" ]
}

source_set("cbor_rust_impl") {
  visibility = [ ":*" ]
  public = []
  sources = [
    "reader.cc",
    "writer.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  deps = [
    ":cbor_headers",
    "//base",
    "//build/rust/crubit",
    "//components/cbor/rust:cbor_rust_bindings",
  ]
}

component("cbor") {
  sources = [
    "diagnostic_writer.cc",
    "values.cc",
  ]

  defines = [ "CBOR_IMPLEMENTATION" ]

  public_deps = [
    ":cbor_headers",
    "//base",
  ]
  deps = [ ":cbor_rust_impl" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "diagnostic_writer_unittest.cc",
    "fuzz_unittest.cc",
    "reader_unittest.cc",
    "values_unittest.cc",
    "writer_unittest.cc",
  ]

  deps = [
    ":cbor",
    "//base",
    "//base/test:test_support",
    "//components/cbor/rust:cbor_rust_unittests",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/fuzztest",
  ]
  if (is_ios) {
    deps += [ ":unit_tests_bundle_data" ]
  }

  data = [ "reader_fuzzer_corpus/" ]

  # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
  # enable the diagnostic by removing this line.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}

if (is_ios) {
  bundle_data_from_filelist("unit_tests_bundle_data") {
    testonly = true
    filelist_name = "unit_tests_bundle_data.filelist"
  }
}
