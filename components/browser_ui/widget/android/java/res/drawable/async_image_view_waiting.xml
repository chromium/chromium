<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/async_image_view_unavailable">

    <target android:name="circle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1500"
                android:interpolator="@android:anim/linear_interpolator"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="fillAlpha"
                    android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"/>
                    <keyframe
                        android:fraction="0.3"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="0.5"/>
                    <keyframe
                        android:fraction="0.85533333"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="1"/>
                    <keyframe
                        android:fraction="1"
                        android:value="1"/>
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="square">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1500"
                android:interpolator="@android:anim/linear_interpolator"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="fillAlpha"
                    android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"/>
                    <keyframe
                        android:fraction="0.05533333"
                        android:value="1"/>
                    <keyframe
                        android:fraction="0.56666666"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="0.5"/>
                    <keyframe
                        android:fraction="0.91133333"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="1"/>
                    <keyframe
                        android:fraction="1"
                        android:value="1"/>
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1500"
                android:interpolator="@android:anim/linear_interpolator"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="fillAlpha"
                    android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="0"/>
                    <keyframe
                        android:fraction="0.1"
                        android:value="0"/>
                    <keyframe
                        android:fraction="0.378"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="0.3"/>
                    <keyframe
                        android:fraction="1"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:value="0"/>
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

</animated-vector>