<!-- TODO(crbug.com/580967946): Confirm sheet layout and dimensions with UX. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/adaptive_ui_sheet_vertical_margin">

    <LinearLayout
        android:id="@+id/adaptive_ui_sheet_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingTop="@dimen/adaptive_ui_sheet_vertical_margin"
        android:visibility="gone">

        <ImageView
            android:id="@+id/adaptive_ui_sheet_icon"
            android:layout_width="@dimen/adaptive_ui_sheet_icon_size"
            android:layout_height="@dimen/adaptive_ui_sheet_icon_size"
            android:layout_marginStart=
                "@dimen/adaptive_ui_sheet_horizontal_margin"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/adaptive_ui_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal=
                "@dimen/adaptive_ui_sheet_horizontal_margin"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Headline.Primary"
            android:visibility="gone" />

        <org.chromium.ui.widget.ChromeImageButton
            android:id="@+id/adaptive_ui_sheet_close_button"
            android:layout_width="@dimen/min_touch_target_size"
            android:layout_height="@dimen/min_touch_target_size"
            android:background="@drawable/default_icon_background"
            android:contentDescription="@string/close"
            android:src="@drawable/btn_close"
            android:visibility="gone" />
    </LinearLayout>

    <org.chromium.components.browser_ui.widget.FadingEdgeScrollView
        android:id="@+id/adaptive_ui_sheet_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal=
                "@dimen/adaptive_ui_sheet_horizontal_margin">

            <TextView
                android:id="@+id/adaptive_ui_sheet_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop=
                    "@dimen/adaptive_ui_sheet_vertical_margin"
                android:textAppearance=
                    "@style/TextAppearance.TextMedium.Secondary"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/adaptive_ui_sheet_custom_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop=
                    "@dimen/adaptive_ui_sheet_vertical_margin"
                android:visibility="gone" />

            <TextView
                android:id="@+id/adaptive_ui_sheet_footer_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop=
                    "@dimen/adaptive_ui_sheet_vertical_margin"
                android:textAppearance=
                    "@style/TextAppearance.TextSmall.Secondary"
                android:visibility="gone" />
        </LinearLayout>
    </org.chromium.components.browser_ui.widget.FadingEdgeScrollView>

    <LinearLayout
        android:id="@+id/adaptive_ui_sheet_button_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/adaptive_ui_sheet_horizontal_margin">

        <org.chromium.ui.widget.ButtonCompat
            android:id="@+id/adaptive_ui_sheet_primary_button"
            style="@style/FilledButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/adaptive_ui_sheet_vertical_margin"
            android:visibility="gone" />

        <org.chromium.ui.widget.ButtonCompat
            android:id="@+id/adaptive_ui_sheet_secondary_button"
            style="@style/OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/adaptive_ui_sheet_button_spacing"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
