source_set("crypto") {
  sources = [
    "agile_symmetric_key.cc",
    "agile_symmetric_key.h",
    "agile_symmetric_key_set.cc",
    "agile_symmetric_key_set.h",
    "key_derivation_params.cc",
    "key_derivation_params.h",
    "nigori.cc",
    "nigori.h",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  public_deps = [
    "//components/sync/protocol",
    "//crypto",
  ]

  deps = [
    "//base",
    "//components/sync/base",
  ]
}
