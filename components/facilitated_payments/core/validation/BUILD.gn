import("//build/rust/rust_static_library.gni")
import("//testing/test.gni")

rust_static_library("payment_qr_validator_rs") {
  crate_root = "payment_qr_validator.rs"
  sources = [ "payment_qr_validator.rs" ]

  visibility = [ ":*" ]
}

rust_static_library("payment_qr_validator_rs_ffi_glue") {
  crate_root = "payment_qr_validator_cxx.rs"
  sources = [ "payment_qr_validator_cxx.rs" ]

  visibility = [
    ":*",
    "//components/facilitated_payments/core/browser",
  ]

  allow_unsafe = true
  cxx_bindings = [ "payment_qr_validator_cxx.rs" ]

  deps = [ ":payment_qr_validator_rs" ]
}

static_library("validation") {
  sources = [
    "payment_link_validator.cc",
    "payment_link_validator.h",
  ]

  public_deps = [ "//url" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "payment_link_validator_unittest.cc",
    "pix_validator_fuzzer_util_unittest.cc",
    "pix_validator_unittest.cc",
  ]

  deps = [
    ":fuzzer_util",
    ":payment_qr_validator_rs_ffi_glue",
    ":validation",
    "//base",
    "//testing/gtest",
    "//third_party/re2",
  ]
}

static_library("fuzzer_util") {
  testonly = true
  sources = [
    "pix_validator_fuzzer_util.cc",
    "pix_validator_fuzzer_util.h",
  ]
}

test("pix_validator_fuzzer") {
  sources = [ "pix_validator_fuzzer.cc" ]

  testonly = true
  fuzztests = [ "GetPixQrCodeTypeTest.GetPixQrCodeTypeCanParseAnyString" ]

  deps = [
    ":fuzzer_util",
    ":payment_qr_validator_rs_ffi_glue",
    "//base",
    "//third_party/fuzztest:fuzztest_gtest_main",
  ]
}
