module extensions_bar.mojom;

import "components/browser_apis/ui_controllers/toolbar/icon_handle.mojom";
import "mojo/public/mojom/base/empty.mojom";
import "mojo/public/mojom/base/string16.mojom";

// Edge of the button that should be flattened to join an adjacent button.
enum FlatEdge {
  kNone,
  kStart,
  kEnd,
};

// Identifies a toolbar button for dealing with extensions.
union ExtensionActionId {
  // The extension's identifier string. Must not be empty.
  string extension_id;

  // Identifies the extensions menu button (puzzle piece).
  mojo_base.mojom.Empty extensions_menu_button;

  // Identifies the request access button. The value is a sequence number that
  // changes whenever the set of extensions or origin the button would grant
  // access to changes. It's sent back to the browser when the button is
  // pressed, so that presses based on stale button state can be ignored.
  uint32 request_access_button;
};

// Data of a toolbar button for dealing with extensions.
struct ExtensionActionInfo {
  // Identifies the button, e.g. the extension whose action it represents.
  ExtensionActionId id;
  mojo_base.mojom.String16 accessible_name;
  mojo_base.mojom.String16 tooltip;

  // True if button is visible for any reason; e.g. pinned, or popped out
  // because the user is interacting with this extension. The WebUI toolbar
  // never receives actions where this is false, as they're filtered out by
  // WebUIToolbarExtensionsContainerWrapper.
  bool is_visible;

  // True if the button must be visible, regardless of whether there's enough
  // room for it on the toolbar, e.g., because it's popped out, has an open
  // context menu, has a bubble anchored to it, or is the pinned-by-default IPH
  // anchor. Always true for the extensions button. When true, `is_visible` is
  // also true.
  bool force_visible;

  toolbar_ui_api.mojom.IconHandle icon;

  // True if this button should additionally register as the anchor for the
  // "pinned by default" IPH (kExtensionsPinnedByDefaultElementId). Set only
  // while that IPH is pending or showing for this extension.
  bool is_pinned_by_default_iph_anchor;

  // Should this button appear highlighted?
  bool highlighted;

  // Text to put in the button (e.g. for the request access button).
  mojo_base.mojom.String16 text;

  // Indicates if the button should have a flat edge on one or the other side.
  FlatEdge flat_edge = FlatEdge.kNone;
};
