module toolbar_ui_api.mojom;

import "components/browser_apis/ui_controllers/toolbar/toolbar_ui_api_data_model.mojom";
import "components/browser_apis/ui_controllers/toolbar/icon_handle.mojom";
import "components/content_settings/core/common/content_settings_types.mojom";
import "ui/base/dragdrop/mojom/drag_drop_types.mojom";
import "ui/base/mojom/menu_source_type.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "ui/webui/resources/js/tracked_element/tracked_element.mojom";
import "mojo/public/mojom/base/empty.mojom";
import "mojo/public/mojom/base/error.mojom";
import "mojo/public/mojom/base/string16.mojom";
import "url/mojom/url.mojom";

// Used by Toolbar UI to observe navigation controls state changes.
interface ToolbarUIObserver {
  // Observes events for navigation controls (e.g. back, forward, reload
  // buttons). |state| contains the state for all navigation controls
  // so that they can update together to avoid visual flicker.
  OnNavigationControlsStateChanged(
    array<IconUpdate> icons,
    NavigationControlsState state);

  // Called to focus an element in the WebUI, with `target` specifying
  // which one.
  OnFocusRequested(FocusRequestTarget target);

  // Requests that JavaScript show the split tabs menu. Although the browser
  // process is responsivle for showing the menu, only the WebUI can determine
  // the button's location and ensure it's visible before anchoring.
  ShowSplitTabsContextMenu();
};

struct InitialState {
    array<IconUpdate> icons;
    NavigationControlsState state;
    pending_receiver<ToolbarUIObserver> update_stream;
};

struct AdjustOmniboxTextForCopyResult {
  mojo_base.mojom.String16 adjusted_text;
  url.mojom.Url? adjusted_url;
  mojo_base.mojom.String16? page_title;
};

// Information about a control that is hidden due to overflow, and should be
// shown on the overflow button's pulldown menu.
struct OverflowMenuItem {
  // TrackedElementIdentifier of the item. This is checked in the browser
  // against a list of ui::ElementIdentifiers that can overflow, to determine
  // the icon and string shown in the menu, and what to do when the item is
  // clicked. Unknown IDs or those of elements that can't overflow result in
  // an exception.
  tracked_element.mojom.TrackedElementIdentifier id;

  // Whether the menu item should be enabled or greyed out.
  bool is_enabled;
};

// ToolbarUIService defines methods to be called from the WebUI to the
// browser-side to drive UI logic.
interface ToolbarUIService {
  // Binds an observer to the service. This is a synchronization point between
  // the client and the browser. All subsequent updates after the initial
  // data will be associated receiver.
  Bind() => result<InitialState, mojo_base.mojom.Error>;

  // Displays the context menu with the provided menu type at the provided
  // bounding rectangle in CSS pixels relative to the WebUIToolbarWebView's
  // viewport origin. RectF is used to preserve subpixel precision from the
  // WebUI (DOMRect) to avoid misalignment after scaling by the zoom factor.
  // The source indicates what triggered showing this menu (mouse, keyboard,
  // etc).
  //
  // `showMenuState` is an opaque identifier that should be echoed back in the
  // State associated with the control for `menu_type`. It's used so that
  // controls that have been hidden due to overflow can be shown and act like
  // there is a menu visible until they can be sure the browser process has
  // processed their request for a context menu, at which point, they can trust
  // the relevant fields of the control's State indicate if a menu was indeed
  // opened, and the control can be hidden again due to overflow. Used to
  // prevent visual flickering due to outdated state messages. Only controls
  // whose State fields have a `show_menu_token` field support this. For other
  // controls, it's ignored. For controls that support `show_menu_token`, it's
  // also ignored if null. It's only used for left click menus, since clicking
  // on the overflow menu always acts as a left click.
  ShowContextMenu(ContextMenuType menu_type,
                  gfx.mojom.RectF bounds_in_css_pixels,
                  ui.mojom.MenuSourceType source,
                  uint32? show_menu_token);

  // Displays the overflow menu with the provided list of overflow control
  // items at the provided bounding rectangle in CSS pixels.
  ShowOverflowMenu(array<OverflowMenuItem> controls,
                   gfx.mojom.RectF bounds_in_css_pixels,
                   ui.mojom.MenuSourceType source)
      => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Handles user interaction with the omnibox
  OnOmniboxAction(OmniboxAction action)
      => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Called when the page finishes initialization.
  OnPageInitialized();

  // Called when a content setting image chip is pressed.
  OnContentSettingImagePointerDown(ContentSettingImageType type);

  // Displays the bubble, anchored to the URL bar, that corresponds to `type`.
  // `is_pointer_interaction` is true if the bubble was opened via a pointer
  // interaction (mouse, touch, etc.) rather than a keyboard interaction. This
  // is necessary because the backend uses this context to decide whether to run
  // pointer-specific rapid-reopen suppression shielding.
  ShowContentSettingsBubble(ContentSettingImageType type,
                            bool is_pointer_interaction)
      => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Called when the content setting icon animation finishes.
  OnContentSettingImageAnimationEnded(ContentSettingImageType type);

  // Called when a page action chip is pressed (e.g. pointerdown).
  OnPageActionPointerDown(PageActionId action_id);

  // Called after an interaction with the icon, with `trigger` specifying
  // the input modality.
  OnPageActionClick(PageActionId action_id, PageActionTrigger trigger)
      => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Called after the chip show / hide transition completes (called after the
  // animation, if there was one).
  OnPageActionChipShowingChanged(PageActionId action_id)
      => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Invoke the pinned toolbar action for `action_id`. It's expected that the
  // corresponding pinned toolbar action button is visible and enabled, i.e.
  // `action_id` is one of the `PinnedToolbarActionState.action`'s that's
  // passed to `OnNavigationControlsStateChanged()`.
  InvokePinnedToolbarAction(PinnedToolbarAction action_id);

  // Called when whether the focus is inside or outside the location bar is
  // changed. Note that focus on a subwidget (security icon, omnibox input,
  // page actions, etc) count as focus being inside.
  OnLocationBarFocusWithinChanged(bool focus_inside);

  // Moves the pinned toolbar action identified by `action_id` to
  // `target_index`.
  MovePinnedToolbarAction(PinnedToolbarAction action_id, int32 target_index);

  // Moves the pinned toolbar action by `delta` (-1 for left/previous, +1 for
  // right/next).
  MovePinnedToolbarActionBy(PinnedToolbarAction action_id, int32 delta);

  // Moves the extension action identified by `extension_id` to `target_index`.
  MoveExtensionAction(string extension_id, int32 target_index);

  // Moves the extension action by `delta` (-1 for left/previous, +1 for
  // right/next).
  MoveExtensionActionBy(string extension_id, int32 delta);

  // Called when an LHS chip is pressed (e.g., pointerdown).
  // `identifier` specifies which chip triggered the event (e.g., LocationIcon).
  // `is_middle_click` evaluates whether the event specifically generated from
  // an auxiliary/middle click.
  OnLhsChipMousePressed(LhsChipIdentifier identifier, bool is_middle_click);

  // Called when an LHS chip is clicked.
  // `is_mouse_interaction` is true if the click was triggered by a mouse event.
  // This is used to differentiate between mouse clicks and keyboard activations
  // (e.g., pressing Enter) because mouse clicks require specific handling to
  // prevent reopening the Page Info bubble if the click itself just closed it
  // due to native focus loss.
  OnLhsChipClicked(LhsChipIdentifier identifier, bool is_mouse_interaction);

  // Called when an LHS permission chip pointerenter event is fired.
  OnLhsChipPointerEntered(LhsChipIdentifier identifier);

  // Called when an LHS permission chip pointerleave or pointercancel event is
  // fired.
  OnLhsChipPointerExited(LhsChipIdentifier identifier);

  // Called when an expand animation finishes.
  OnLhsChipExpandAnimationEnded(LhsChipIdentifier identifier);

  // Called when a collapse animation finishes.
  OnLhsChipCollapseAnimationEnded(LhsChipIdentifier identifier);

  // Called when a drag gesture is detected on an LHS chip.
  OnLhsChipDrag(LhsChipIdentifier identifier, ui.mojom.DragEventSource source);

  // Sets the home page to the currently dragged url, if any, and displays the
  // home page undo bubble.
  OnHomeButtonDropUrl(url.mojom.Url url);

  // Sets the home page to the currently dragged file, if any, and displays the
  // home page undo bubble.
  OnHomeButtonDropFile(gfx.mojom.PointF drop_position);

  // Navigates the current tab to the currently dragged file at `drop_position`.
  OnToolbarDropFile(gfx.mojom.PointF drop_position);

  // Shows the avatar menu bubble.
  ShowAvatarMenu() => result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Notifies the browser of the hover state of the avatar button.
  SetAvatarButtonHovered(bool hovered) =>
    result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Notifies the browser of the focus state of the avatar button.
  SetAvatarButtonFocused(bool focused) =>
    result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Notifies the browser that the avatar button's IPH promo state has changed.
  SetAvatarButtonIphPromoShowing(bool showing) =>
    result<mojo_base.mojom.Empty, mojo_base.mojom.Error>;

  // Called when the app menu button focus state changes.
  OnAppMenuFocusChanged(bool focused);

  // Executes the user action for the extension with the given ID.
  ExecuteExtensionAction(string extension_id);

  // Displays the context menu for the extension with the given ID.
  ShowExtensionContextMenu(string extension_id, ui.mojom.MenuSourceType source);

  // Adjusts the copied or dragged text and returns the adjusted text,
  // the adjusted URL, and whether a URL should be written to the payload.
  AdjustOmniboxTextForCopy(mojo_base.mojom.String16 text, int32 selection_start)
      => result<AdjustOmniboxTextForCopyResult, mojo_base.mojom.Error>;

  // Called when the performance intervention button is clicked.
  // `is_mouse_interaction` is true if the click was triggered by a mouse event.
  OnPerformanceInterventionButtonClicked(bool is_mouse_interaction);

  // Called when the performance intervention button is pressed
  // (e.g. pointerdown).
  OnPerformanceInterventionButtonMousePressed();
};
