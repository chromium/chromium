module metrics.mojom;

// The event that triggered the profile collection.
//
// Mirrors SampledProfile::TriggerEvent from
// third_party/metrics_proto/sampled_profile.proto.
enum TriggerEvent {
  kUnknown,
  kPeriodicCollection,
  kResumeFromSuspend,
  kRestoreSession,
  kProcessStartup,
  kJankyTask,
  kThreadHung,
  kPeriodicHeapCollection,
  kPeriodicHeapChurnCollection,
};
