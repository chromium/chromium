# History-free types, features, and query interface so that
# //components/history/core/browser can depend on this target without creating
# a dependency cycle with :browser (which observes history::HistoryService).
static_library("types") {
  sources = [
    "critical_action_history_utils.cc",
    "critical_action_history_utils.h",
    "critical_action_provider.h",
    "critical_action_types.cc",
    "critical_action_types.h",
    "features.cc",
    "features.h",
  ]

  public_deps = [
    "//base",
    "//third_party/abseil-cpp:absl",
  ]

  deps = [
    "//components/strings:components_strings",
    "//ui/base",
  ]
}

static_library("browser") {
  sources = [
    "critical_action_backend.cc",
    "critical_action_backend.h",
    "critical_action_database.cc",
    "critical_action_database.h",
    "critical_action_metrics.cc",
    "critical_action_metrics.h",
    "critical_action_redirect_metrics_recorder.cc",
    "critical_action_redirect_metrics_recorder.h",
    "critical_action_service.cc",
    "critical_action_service.h",
  ]

  public_deps = [ ":types" ]

  deps = [
    "//base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//sql",
    "//ui/base",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "fake_critical_action_provider.cc",
    "fake_critical_action_provider.h",
  ]

  public_deps = [
    ":types",
    "//base",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "critical_action_backend_unittest.cc",
    "critical_action_database_unittest.cc",
    "critical_action_history_utils_unittest.cc",
    "critical_action_metrics_unittest.cc",
    "critical_action_redirect_metrics_recorder_unittest.cc",
    "critical_action_service_unittest.cc",
    "critical_action_types_unittest.cc",
    "features_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//components/history/core/browser",
    "//components/strings:components_strings",
    "//sql:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/sqlite",
    "//ui/base",
    "//url",
  ]
}

if (is_android) {
  import("//build/config/android/rules.gni")

  android_library("critical_actions_enums_java") {
    srcjar_deps = [ ":critical_actions_enums_javagen" ]
    deps = [ "//third_party/androidx:androidx_annotation_annotation_java" ]
  }

  java_cpp_enum("critical_actions_enums_javagen") {
    sources = [ "critical_action_types.h" ]
    visibility = [ ":*" ]  # Depend on through :critical_actions_enums_java
  }
}
