source_set("types") {
  defines = [ "IS_ISOLATED_WEB_APPS_IMPL" ]
  visibility = [ "//components/webapps/isolated_web_apps/*" ]
  sources = [
    "isolated_web_app_external_install_options.cc",
    "isolated_web_app_external_install_options.h",
    "isolated_web_app_policy_constants.cc",
    "isolated_web_app_policy_constants.h",
    "iwa_origin.cc",
    "iwa_origin.h",
    "iwa_version.cc",
    "iwa_version.h",
    "source.cc",
    "source.h",
    "storage_location.cc",
    "storage_location.h",
    "update_channel.cc",
    "update_channel.h",
    "update_check_and_prepare_result.cc",
    "update_check_and_prepare_result.h",
    "url_loading_types.h",
  ]

  deps = [
    "//components/crx_file",
    "//components/webapps/isolated_web_apps:scheme",
    "//crypto",
  ]

  public_deps = [
    "//base",
    "//components/web_package",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "isolated_web_app_external_install_options_unittest.cc",
    "iwa_version_unittest.cc",
    "source_unittest.cc",
  ]
  deps = [
    "//components/webapps/isolated_web_apps",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
