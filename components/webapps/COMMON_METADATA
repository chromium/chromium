# Opt in to agentic code review.
agentic_review {
  # Web apps Mojo security and origin validation in non-test files.
  capability_groups {
    path_expression: "components/webapps/.*\\.(cc|h|mm)"
    path_expression_exclusion: [
      ".*/test(s|_support)?/.*",
      ".*/(test|fake|mock)_[^/]*",
      ".*_(unittest|browsertest|interactive_uitest|perftest|ui_test|fuzzer|test)(_[a-z0-9_]+)?\\.(cc|h|mm)"
    ]
    review_capability_skills: ["components/webapps/_agents/skills/webapps-layering-and-security-review/SKILL.md"]
  }
}
