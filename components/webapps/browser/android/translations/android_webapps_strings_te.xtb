<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1344914278748983512">ఈ యాప్ ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది</translation>
<translation id="1353513225130339633">యాప్‌ను ఇన్‌స్టాల్ చేయవచ్చో లేదో చెక్ చేస్తోంది\u2026</translation>
<translation id="1786044937610313874">Chromeలో షార్ట్‌కట్‌లు తెరవబడతాయి</translation>
<translation id="204914487372604757">షార్ట్‌కట్‌ను క్రియేట్ చేయండి</translation>
<translation id="2478076885740497414">యాప్‌ను ఇన్‌స్టాల్ చేయండి</translation>
<translation id="3470954020960831923">యాప్‌ను ఇన్‌స్టాల్ చేయడం సాధ్యం కాదు.</translation>
<translation id="3789841737615482174">ఇన్‌స్టాల్ చేయండి</translation>
<translation id="3910402514791813257">ఇన్‌స్టాల్ చేయడంలో విఫలమైంది</translation>
<translation id="4250229828105606438">స్క్రీన్‌షాట్</translation>
<translation id="4665282149850138822"><ph name="NAME" /> మీ హోమ్ స్క్రీన్‌కు జోడించబడింది</translation>
<translation id="5037411519220435935">ఒక్క క్షణం వేచి ఉండండి\u2026</translation>
<translation id="5250483651202458397">స్క్రీన్‌షాట్. మూసివేయడానికి ట్యాప్ చేయండి.</translation>
<translation id="5684726956335420505">మొదటి స్క్రీన్‌కు యాప్‌ను ఎలా జోడించాలో ఎంచుకోండి</translation>
<translation id="573338379539282448">బదులుగా క్లిక్ చేసి యాప్‌ను తెరవండి</translation>
<translation id="5833749891039107935">వెబ్ యాప్ పేరును ఎంటర్ చేయండి</translation>
<translation id="6847654118050428901">షార్ట్‌కట్ పేరును ఎంటర్ చేయండి</translation>
<translation id="6923899737874692938">ఇన్‌స్టాల్ &amp; షార్ట్‌కట్</translation>
<translation id="6990079615885386641">Google Play Store నుండి యాప్‌ను పొందండి: <ph name="APP_ACTION" /></translation>
<translation id="7333031090786104871">ఇంకా మునుపటి సైట్‌ను జోడిస్తోంది</translation>
<translation id="962979164594783469">ఈ యాప్‌ను ఇన్‌స్టాల్ చేయండి</translation>
</translationbundle>