<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1344914278748983512">Այս հավելվածն արդեն տեղադրված է</translation>
<translation id="1353513225130339633">Ստուգվում է հավելվածի տեղադրման հնարավորությունը\u2026</translation>
<translation id="1786044937610313874">Դյուրանցումները բացել Chrome-ում</translation>
<translation id="204914487372604757">Ստեղծել դյուրանցում</translation>
<translation id="2478076885740497414">Տեղադրել հավելվածը</translation>
<translation id="3470954020960831923">Այս հավելվածը հնարավոր չէ տեղադրել։</translation>
<translation id="3789841737615482174">Տեղադրել</translation>
<translation id="3910402514791813257">Չհաջողվեց տեղադրել</translation>
<translation id="4250229828105606438">Սքրինշոթ</translation>
<translation id="4665282149850138822"><ph name="NAME" /> կայքն ավելացվեց ձեր հիմնական էկրանին</translation>
<translation id="5037411519220435935">Սպասեք\u2026</translation>
<translation id="5250483651202458397">Սքրինշոթ։ Հպեք՝ փակելու համար։</translation>
<translation id="5684726956335420505">Ընտրեք, թե ինչպես ավելացնել հավելվածը հիմնական էկրանին</translation>
<translation id="573338379539282448">Սեղմեք՝ փոխարենը հավելվածը բացելու համար</translation>
<translation id="5833749891039107935">Մուտքագրեք վեբ հավելվածի անվանումը</translation>
<translation id="6847654118050428901">Մուտքագրեք դյուրանցման անվանումը</translation>
<translation id="6923899737874692938">Տեղադրել և ստեղծել դյուրանցում</translation>
<translation id="6990079615885386641">Ձեռք բերեք հավելվածը Google Play Խանութից՝ <ph name="APP_ACTION" /></translation>
<translation id="7333031090786104871">Դեռ նախորդ կայքն է ավելացվում</translation>
<translation id="962979164594783469">Տեղադրել հավելվածը</translation>
</translationbundle>