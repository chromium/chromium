<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1344914278748983512">આ ઍપ પહેલેથી જ ઇન્સ્ટૉલ કરેલી છે</translation>
<translation id="1353513225130339633">ઍપ ઇન્સ્ટૉલ કરી શકાય છે કે નહીં તે ચેક કરી રહ્યાં છીએ\u2026</translation>
<translation id="1786044937610313874">શૉર્ટકટ Chromeમાં ખુલે છે</translation>
<translation id="204914487372604757">શૉર્ટકટ બનાવો </translation>
<translation id="2478076885740497414">ઍપ્લિકેશન ઇન્સ્ટોલ કરો</translation>
<translation id="3470954020960831923">આ ઍપ ઇન્સ્ટૉલ કરી શકાતી નથી.</translation>
<translation id="3789841737615482174">ઇન્સ્ટોલ કરો</translation>
<translation id="3910402514791813257">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં</translation>
<translation id="4250229828105606438">સ્ક્રીનશૉટ</translation>
<translation id="4665282149850138822"><ph name="NAME" /> ને તમારા હોમ સ્ક્રીન પર ઉમેરવામાં આવ્યું હતું</translation>
<translation id="5037411519220435935">બસ એક પળ\u2026</translation>
<translation id="5250483651202458397">સ્ક્રીનશૉટ. બંધ કરવા માટે ટૅપ કરો.</translation>
<translation id="5684726956335420505">હોમ સ્ક્રીનમાં ઍપ ઉમેરવાની રીત વિશે જાણો</translation>
<translation id="573338379539282448">તેના બદલે ઍપ ખોલવા માટે ક્લિક કરો</translation>
<translation id="5833749891039107935">વેબ ઍપનું નામ દાખલ કરો</translation>
<translation id="6847654118050428901">શૉર્ટકટ નામ દાખલ કરો</translation>
<translation id="6923899737874692938">ઇન્સ્ટૉલ કરો, શૉર્ટકટ બનાવો</translation>
<translation id="6990079615885386641">Google Play Store માંથી ઍપ્લિકેશન મેળવો: <ph name="APP_ACTION" /></translation>
<translation id="7333031090786104871">હજીપણ પાછલી સાઇટ ઉમેરી રહ્યાં છે</translation>
<translation id="962979164594783469">આ ઍપ ઇન્સ્ટૉલ કરો</translation>
</translationbundle>