<translation id="4250229828105606438">ថតអេក្រង់</translation>
<translation id="4665282149850138822"><ph name="NAME" /> ត្រូវបានបន្ថែមទៅអេក្រង់ដើមរបស់អ្នក</translation>
<translation id="5037411519220435935">ចាំមួយភ្លែត\u2026</translation>
<translation id="5250483651202458397">រូបថត​អេក្រង់។ ចុចដើម្បីបិទ។</translation>
<translation id="5684726956335420505">ជ្រើសរើសរបៀបបញ្ចូលកម្មវិធីទៅក្នុងអេក្រង់ដើម</translation>
<translation id="573338379539282448">ចុច ដើម្បីបើកកម្មវិធីជំនួសវិញ</translation>
