<translation id="1344914278748983512">កម្មវិធីនេះត្រូវបានដំឡើងរួចហើយ</translation>
<translation id="1353513225130339633">កំពុង​ពិនិត្យមើល​ថាតើអាច​ដំឡើង​កម្មវិធីបាន​ឬអត់\u2026</translation>
<translation id="1786044937610313874">ផ្លូវកាត់បើកនៅក្នុង Chrome</translation>
<translation id="204914487372604757">បង្កើតផ្លូវកាត់</translation>
<translation id="2478076885740497414">តំឡើងកម្មវិធី</translation>
<translation id="3470954020960831923">មិនអាច​ដំឡើង​កម្មវិធីនេះ​បានទេ។</translation>
<translation id="3789841737615482174">តំឡើង</translation>
