<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="1344914278748983512">මෙම යෙදුම දැනටමත් ස්ථාපනය කර ඇත</translation>
<translation id="1353513225130339633">යෙදුම ස්ථාපනය කළ හැකි දැයි පරීක්ෂා කරමින්\u2026</translation>
<translation id="1786044937610313874">කෙටිමං Chrome හි විවෘත වේ</translation>
<translation id="204914487372604757">කෙටිමඟ තනන්න</translation>
<translation id="2478076885740497414">වැඩසටහන සථාපනය කරන්න</translation>
<translation id="3470954020960831923">මෙම යෙදුම ස්ථාපනය කළ නොහැක.</translation>
<translation id="3789841737615482174">ස්ථාපනය</translation>
<translation id="3910402514791813257">ස්ථාපනය කිරීම අසාර්ථක විය</translation>
<translation id="4250229828105606438">තිරරූපය</translation>
<translation id="4665282149850138822"><ph name="NAME" /> ඔබේ මුල් තිරය වෙත එක් කරන ලදී</translation>
<translation id="5037411519220435935">මොහොතක් ඉන්න\u2026</translation>
<translation id="5250483651202458397">තිර රුව. වැසීමට තට්ටු කරන්න.</translation>
<translation id="5684726956335420505">මුල් තිරයට යෙදුම එක් කරන ආකාරය තෝරා ගන්න</translation>
<translation id="573338379539282448">ඒ වෙනුවට යෙදුම විවෘත කිරීමට ක්ලික් කරන්න</translation>
<translation id="5833749891039107935">වෙබ් යෙදුමේ නම ඇතුළු කරන්න</translation>
<translation id="6847654118050428901">කෙටිමඟේ නම ඇතුළු කරන්න</translation>
<translation id="6923899737874692938">ස්ථාපනය කර කෙටිමඟ සාදන්න</translation>
<translation id="6990079615885386641">Google Play ගබඩාව වෙතින් යෙදුම ලබාගන්න: <ph name="APP_ACTION" /></translation>
<translation id="7333031090786104871">තවමත් කලින් අඩවියට එක් කරමින්</translation>
<translation id="962979164594783469">මෙම යෙදුම ස්ථාපනය කරන්න</translation>
</translationbundle>