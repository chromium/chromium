import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")
import("//components/activity_reporter/buildflags.gni")
import("//testing/test.gni")

# Activity reporting must never be built into ChromeOS. Any dependency on this
# component from a ChromeOS build is an error.
assert(!is_chromeos, "//components/activity_reporter is not built on ChromeOS")

use_activity_reporter_internal_constants =
    is_internal_chrome_branded && is_official_build

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "REPORT_ACTIVITY=$report_activity",
    "USE_LEGACY_ACTIVE_DEFINITION=$use_legacy_active_definition",
    "USE_ACTIVITY_REPORTER_INTERNAL_CONSTANTS=$use_activity_reporter_internal_constants",
  ]
}

source_set("activity_reporter") {
  public_deps = [ ":interface" ]

  deps = [
    "//base",
    "//components/update_client",
  ]

  sources = [ "activity_reporter_no_impl.cc" ]

  if (report_activity) {
    sources += [ "activity_reporter_enabled.cc" ]
    deps += [ ":impl" ]
  } else {
    sources += [ "activity_reporter_disabled.cc" ]
  }
}

# Lets `:impl` use the interface without depending on `:activity_reporter`,
# which depends on `:impl`.
source_set("interface") {
  visibility = [ ":*" ]
  public = [ "activity_reporter.h" ]
  public_deps = [ "//base" ]
}

# Not gated on `report_activity`, so that its tests also run in unbranded
# builds. Only builds with `report_activity` link it into the browser.
source_set("impl") {
  visibility = [
    ":activity_reporter",
    ":unit_tests",
  ]

  public = [ "activity_reporter_impl.h" ]

  sources = [
    "activity_reporter_for_testing.h",
    "activity_reporter_impl.cc",
    "configurator.cc",
    "configurator.h",
    "constants.h",
    "features.cc",
    "features.h",
  ]

  public_deps = [ ":interface" ]

  deps = [
    ":buildflags",
    "//base",
    "//base/version_info",
    "//components/policy/core/common",
    "//components/prefs",
    "//components/update_client",
    "//ui/base",
    "//url",
  ]

  if (use_activity_reporter_internal_constants) {
    sources += [ "internal/constants.h" ]
  }

  if (is_win) {
    deps += [ ":vm_detection" ]
  }

  friend = [ ":unit_tests" ]
}

if (is_win) {
  # Experimental VM-guest detection. See virtual_machine_win.h. Not gated on
  # `report_activity`, so that its tests also run in unbranded builds.
  source_set("vm_detection") {
    visibility = [
      ":impl",
      ":unit_tests",
    ]
    public = [ "virtual_machine_win.h" ]
    sources = [
      "virtual_machine_cpuid_win.cc",
      "virtual_machine_metrics_win.cc",
      "virtual_machine_smbios_win.cc",
      "virtual_machine_win_internal.h",
    ]
    deps = [ "//base" ]
    friend = [ ":unit_tests" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = []
  deps = [
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]

  # The reporter doesn't run on Fuchsia, so these tests don't either.
  if (!is_fuchsia) {
    sources += [
      "activity_reporter_impl_unittest.cc",
      "configurator_unittest.cc",
    ]
    deps += [
      ":activity_reporter",
      ":buildflags",
      ":impl",
      "//base/version_info",
      "//components/prefs:test_support",
      "//components/update_client",
      "//testing/gmock",
    ]
  }

  if (is_win) {
    sources += [ "virtual_machine_win_unittest.cc" ]
    deps += [ ":vm_detection" ]
  }
}
