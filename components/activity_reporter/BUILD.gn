import("//build/buildflag_header.gni")
import("//build/config/chrome_build.gni")
import("//components/activity_reporter/buildflags.gni")
import("//testing/test.gni")

use_activity_reporter_internal_constants =
    is_internal_chrome_branded && is_official_build

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "USE_LEGACY_ACTIVE_DEFINITION=$use_legacy_active_definition",
    "USE_ACTIVITY_REPORTER_INTERNAL_CONSTANTS=$use_activity_reporter_internal_constants",
  ]
}

source_set("activity_reporter") {
  public = [ "activity_reporter.h" ]

  deps = [
    ":buildflags",
    "//base",
    "//components/prefs",
    "//components/update_client",
  ]

  sources = [ "activity_reporter_no_impl.cc" ]

  if (report_activity) {
    sources += [
      "activity_reporter_impl.cc",
      "configurator.cc",
      "configurator.h",
      "constants.h",
    ]
    deps += [
      "//base/version_info",
      "//components/policy/core/common",
      "//components/prefs",
      "//ui/base",
      "//url",
    ]

    if (use_activity_reporter_internal_constants) {
      sources += [ "internal/constants.h" ]
    }

    if (is_win) {
      deps += [ ":vm_detection" ]
    }
  } else {
    sources += [ "activity_reporter_disabled.cc" ]
  }

  friend = [ ":unit_tests" ]
}

if (is_win) {
  # Experimental VM-guest detection. See virtual_machine_win.h. Not gated on
  # `report_activity`, so that its tests also run in unbranded builds.
  source_set("vm_detection") {
    visibility = [
      ":activity_reporter",
      ":unit_tests",
    ]
    public = [ "virtual_machine_win.h" ]
    sources = [
      "virtual_machine_metrics_win.cc",
      "virtual_machine_stub_win.cc",
    ]
    deps = [ "//base" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = []
  deps = [
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]

  if (report_activity) {
    sources += [
      "activity_reporter_for_testing.h",
      "activity_reporter_impl_unittest.cc",
    ]
    deps += [
      ":activity_reporter",
      "//components/prefs:test_support",
      "//components/update_client",
      "//testing/gmock",
    ]
  }

  if (is_win) {
    sources += [ "virtual_machine_win_unittest.cc" ]
    deps += [ ":vm_detection" ]
  }
}
