import("//third_party/protobuf/proto_library.gni")

group("proto_lite") {
  public_deps = [
    ":proto",
    "//third_party/protobuf:protobuf_lite",
  ]
}

proto_library("proto") {
  sources = [
    "actuator_downstream_message.proto",
    "glic_experimental_triggering.proto",
    "one_time_token_backend_notification.proto",
    "optimization_guide_push_notification.proto",
    "peer_connection_messages.proto",
    "remote_copy_message.proto",
    "sharing_message.proto",
    "sharing_message_type.proto",
    "sms_fetch_message_test_proto3_optional.proto",
    "timestamp.proto",
  ]
  deps = [ "//third_party/protobuf:any_proto" ]
}
