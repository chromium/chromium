import("//components/proto_extras/proto_extras.gni")
import("//third_party/protobuf/proto_library.gni")

group("proto_lite") {
  public_deps = [
    ":proto",
    "//third_party/protobuf:protobuf_lite",
  ]
}

proto_library("proto") {
  sources = [
    "actuator_downstream_message.proto",
    "glic_experimental_triggering.proto",
    "one_time_token_backend_notification.proto",
    "optimization_guide_push_notification.proto",
    "peer_connection_messages.proto",
    "remote_copy_message.proto",
    "sharing_message.proto",
    "sharing_message_type.proto",
    "sms_fetch_message_test_proto3_optional.proto",
    "timestamp.proto",
  ]
  import_dirs = [ "//" ]
  deps = [
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//third_party/protobuf:any_proto",
  ]
}

# base::Value serialization for the actuator downstream messages, used by
# chrome://browser-actuator-internals to dump recorded sessions.
proto_extras("actuator_downstream_message_extras") {
  sources = [ "actuator_downstream_message.proto" ]
  deps = [ ":proto" ]
  extras_deps = [ "//components/proto_extras:any_proto_extras" ]
}
