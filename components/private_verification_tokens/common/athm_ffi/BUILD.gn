import("//build/config/rust.gni")
import("//build/rust/rust_static_library.gni")

assert(enable_rust)

rust_static_library("athm_ffi") {
  crate_root = "athm_ffi.rs"
  sources = [
    "athm_ffi.rs",
    "privacy_pass_client.rs",
    "privacy_pass_common.rs",
    "privacy_pass_issuer.rs",
  ]
  cpp_api_from_rust = {
    target_name = "athm_ffi_bindings"
    cpp_namespace = "private_verification_tokens"
  }
  deps = [ "//third_party/anonymous_tokens:athm" ]
  visibility = [
    ":*",
    "//components/private_verification_tokens/common:*",
  ]
}

rust_static_library("privacy_pass_unittests") {
  testonly = true
  is_gtest_unittests = true
  crate_root = "privacy_pass_unittest.rs"
  sources = [ "privacy_pass_unittest.rs" ]
  deps = [
    ":athm_ffi",
    "//testing/rust_gtest_interop",
    "//third_party/anonymous_tokens:athm",
  ]
  visibility = [
    "//components/private_verification_tokens:*",
    "//components/private_verification_tokens/common:*",
  ]
}
