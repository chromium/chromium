[
  {
    "os": [
      "linux",
      "win",
      "android",
      "chromeos",
      "mac"
    ],
    "simple_policy_pref_mapping_test": {
      "pref_name": "proxy_override_rules",
      "default_value": [],
      "policy_settings": {
        "scope": "machine",
        "source": "cloud"
      },
      "values_to_test": [
        [
          {
            "DestinationMatchers": [
              "https://app1.com",
              "https://app2.com"
            ],
            "ProxyList": [
              "HTTPS proxy.app:443"
            ]
          }
        ],
        [
          {
            "DestinationMatchers": [
              "https://some.app.com"
            ],
            "ProxyList": [
              "DIRECT"
            ],
            "Conditions": [
              {
                "DnsProbe": {
                  "Host": "corp.ads",
                  "Result": "resolved"
                }
              }
            ]
          },
          {
            "DestinationMatchers": [
              "https://some.app.com"
            ],
            "ProxyList": [
              "HTTPS proxy.app:443"
            ],
            "Conditions": [
              {
                "DnsProbe": {
                  "Host": "corp.ads",
                  "Result": "not_found"
                }
              }
            ]
          }
        ]
      ]
    },
    "policy_pref_mapping_tests": [
      {
        "policies": {
          "ProxyOverrideRules": 12
        },
        "policies_settings": {
          "ProxyOverrideRules": {
            "scope": "machine",
            "source": "cloud"
          }
        },
        "prefs": {
          "proxy_override_rules": {
            "default_value": []
          }
        }
      },
      {
        "policies": {
          "ProxyOverrideRules": "some string"
        },
        "policies_settings": {
          "ProxyOverrideRules": {
            "scope": "machine",
            "source": "cloud"
          }
        },
        "prefs": {
          "proxy_override_rules": {
            "default_value": []
          }
        }
      },
      {
        "policies": {
          "ProxyOverrideRules": false
        },
        "policies_settings": {
          "ProxyOverrideRules": {
            "scope": "machine",
            "source": "cloud"
          }
        },
        "prefs": {
          "proxy_override_rules": {
            "default_value": []
          }
        }
      }
    ]
  },
  {
    "note": "User-scoped policy applies when EnableProxyOverrideRulesForAllUsers is enabled at machine scope.",
    "os": [
      "linux",
      "win",
      "android",
      "mac"
    ],
    "policy_pref_mapping_tests": [
      {
        "policies": {
          "EnableProxyOverrideRulesForAllUsers": 1,
          "ProxyOverrideRules": [
            {
              "DestinationMatchers": [
                "https://app1.com",
                "https://app2.com"
              ],
              "ProxyList": [
                "HTTPS proxy.app:443"
              ]
            }
          ]
        },
        "policies_settings": {
          "EnableProxyOverrideRulesForAllUsers": {
            "scope": "machine",
            "source": "cloud"
          },
          "ProxyOverrideRules": {
            "scope": "user",
            "source": "cloud"
          }
        },
        "prefs": {
          "proxy_override_rules": {
            "value": [
              {
                "DestinationMatchers": [
                  "https://app1.com",
                  "https://app2.com"
                ],
                "ProxyList": [
                  "HTTPS proxy.app:443"
                ]
              }
            ]
          }
        }
      }
    ]
  },
  {
    "note": "Policy is cloud-only so shouldn't apply if from a platform source.",
    "os": [
      "linux",
      "win",
      "android",
      "mac"
    ],
    "policy_pref_mapping_tests": [
      {
        "policies_settings": {
          "ProxyOverrideRules": {
            "scope": "machine",
            "source": "platform"
          }
        },
        "policies": {
          "ProxyOverrideRules": [
            {
              "DestinationMatchers": [
                "https://app1.com",
                "https://app2.com"
              ],
              "ProxyList": [
                "HTTPS proxy.app:443"
              ]
            }
          ]
        },
        "prefs": {
          "proxy_override_rules": {
            "default_value": []
          }
        }
      }
    ]
  }
]
