visibility = [
  ":*",
  "//components/cast_streaming/browser/frame/*",
  "//components/cast_streaming/renderer/frame/*",

  # Shared between renderer/frame and renderer/web_ui
  "//components/cast_streaming/renderer/common/*",
]

source_set("frame") {
  public = [
    "demuxer_stream_traits.h",
    "frame_trace_flow.h",
  ]
  sources = [ "frame_trace_flow.cc" ]
  public_deps = [
    "//base",
    "//media",
  ]
}

source_set("unit_tests") {
  testonly = true
  visibility += [ "//components/cast_streaming:unit_tests" ]
  public = []
  sources = [ "frame_trace_flow_unittest.cc" ]
  deps = [
    ":frame",
    "//base",
    "//media",
    "//testing/gtest",
  ]
}
