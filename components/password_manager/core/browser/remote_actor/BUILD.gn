assert(!is_android)

# Clients and service for sharing credentials with remote actors (e.g. Gemini)
# via Passbox and the Agentic Permission Service. Shared by desktop and iOS;
# not used on Android.
source_set("remote_actor") {
  sources = [
    "remote_actor_credential_permission_client.cc",
    "remote_actor_credential_permission_client.h",
    "remote_actor_credential_sharing_controller.cc",
    "remote_actor_credential_sharing_controller.h",
    "remote_actor_credential_sharing_result.cc",
    "remote_actor_credential_sharing_result.h",
    "remote_actor_credential_sharing_service.h",
    "remote_actor_credential_sharing_service_impl.cc",
    "remote_actor_credential_sharing_service_impl.h",
    "remote_actor_credential_store_client.cc",
    "remote_actor_credential_store_client.h",
    "remote_actor_request_helper.cc",
    "remote_actor_request_helper.h",
    "remote_actor_switches.cc",
    "remote_actor_switches.h",
  ]

  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/browser/sync",
    "//components/signin/public/base",
    "//components/sync/base",
    "//components/sync/protocol",
    "//net",
    "//services/network/public/cpp",
    "//url",
  ]

  deps = [
    "//components/password_manager/core/browser:metrics_util",
    "//components/password_manager/core/browser/features:utils",
    "//components/password_manager/core/browser/remote_actor/protos",
    "//components/password_manager/core/common:features",
    "//components/signin/public/identity_manager",
    "//components/sync/service",
    "//google_apis",
    "//google_apis/common",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "remote_actor_credential_permission_client_unittest.cc",
    "remote_actor_credential_sharing_controller_unittest.cc",
    "remote_actor_credential_sharing_service_impl_unittest.cc",
    "remote_actor_credential_store_client_unittest.cc",
    "remote_actor_request_helper_unittest.cc",
  ]
  deps = [
    ":remote_actor",
    "//base/test:test_support",
    "//components/affiliations/core/browser:test_support",
    "//components/password_manager/core/browser:password_form",
    "//components/password_manager/core/browser:password_string",
    "//components/password_manager/core/browser/affiliation:test_support",
    "//components/password_manager/core/browser/password_store:test_support",
    "//components/password_manager/core/browser/remote_actor/protos",
    "//components/password_manager/core/browser/sync",
    "//components/password_manager/core/common:features",
    "//components/signin/public/identity_manager:test_support",
    "//components/sync:test_support",
    "//components/sync/base",
    "//components/sync/protocol",
    "//components/sync/service",
    "//google_apis",
    "//google_apis/common",
    "//net",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
