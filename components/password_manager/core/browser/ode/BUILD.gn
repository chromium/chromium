if (is_android) {
  import("//build/config/android/config.gni")
  import("//build/config/android/rules.gni")
  import("//third_party/jni_zero/jni_zero.gni")
}

source_set("ode") {
  sources = [
    "on_device_encryption_data_type_specific_metrics_reporter.cc",
    "on_device_encryption_data_type_specific_metrics_reporter.h",
    "on_device_encryption_metrics_reporter.cc",
    "on_device_encryption_metrics_reporter.h",
    "on_device_encryption_state_tracker.cc",
    "on_device_encryption_state_tracker.h",
    "passkey_trusted_vault_on_device_encryption_state_tracker.cc",
    "passkey_trusted_vault_on_device_encryption_state_tracker.h",
    "password_trusted_vault_on_device_encryption_state_tracker.cc",
    "password_trusted_vault_on_device_encryption_state_tracker.h",
  ]

  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/signin/public/identity_manager",
    "//components/sync/service",
    "//components/trusted_vault",
  ]

  deps = [
    "//components/password_manager/core/common",
    "//components/sync/base",
  ]

  if (!is_android) {
    sources += [
      "passkey_on_device_encryption_state_tracker.cc",
      "passkey_on_device_encryption_state_tracker.h",
    ]
    public_deps += [ "//components/webauthn/core/browser:passkey_model" ]
  }
}

if (is_android) {
  generate_jni("jni_headers") {
    visibility = [ ":*" ]
    sources = [ "android/java/src/org/chromium/components/password_manager/ode/PasskeySecurityDomainChecker.java" ]
  }

  android_library("java") {
    srcjar_deps = [ ":jni_headers" ]
    sources = [ "android/java/src/org/chromium/components/password_manager/ode/PasskeySecurityDomainChecker.java" ]
    deps = [
      "//base:base_java",
      "//base:service_loader_java",
      "//build/android:build_java",
      "//components/signin/public/android:java",
      "//components/trusted_vault/android:java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/jni_zero:jni_zero_java",
    ]
  }

  robolectric_library("junit") {
    sources = [ "android/junit/src/org/chromium/components/password_manager/ode/PasskeySecurityDomainCheckerTest.java" ]
    deps = [
      ":java",
      "//base:base_java",
      "//base:base_junit_test_support",
      "//base:service_loader_java",
      "//components/signin/public/android:java",
      "//components/signin/public/android:signin_java_test_support",
      "//components/trusted_vault/android:java",
      "//third_party/junit",
      "//third_party/mockito:mockito_java",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "mock_on_device_encryption_state_tracker_observer.cc",
    "mock_on_device_encryption_state_tracker_observer.h",
    "on_device_encryption_data_type_specific_metrics_reporter_unittest.cc",
    "on_device_encryption_metrics_reporter_unittest.cc",
    "on_device_encryption_state_tracker_unittest.cc",
    "passkey_trusted_vault_on_device_encryption_state_tracker_unittest.cc",
    "password_trusted_vault_on_device_encryption_state_tracker_unittest.cc",
  ]
  deps = [
    ":ode",
    "//base/test:test_support",
    "//components/password_manager/core/common",
    "//components/prefs:test_support",
    "//components/sync:test_support",
    "//components/trusted_vault:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (!is_android) {
    sources += [ "passkey_on_device_encryption_state_tracker_unittest.cc" ]
    deps += [ "//components/webauthn/core/browser:test_support" ]
  }
}
