import("//third_party/protobuf/proto_library.gni")

# TODO(crbug.com/578080484): Delete this file once src-internal points directly
# to
# //components/safe_browsing/content/resources/download_file_types:make_all_file_types_protobuf.
action("make_all_file_types_protobuf") {
  script = "download_file_types/gen_file_type_proto.py"

  input_filename = "download_file_types/download_file_types.asciipb"
  output_dir = "$target_gen_dir/all"
  outputs = [
    "$output_dir/android/download_file_types.pb",
    "$output_dir/chromeos/download_file_types.pb",
    "$output_dir/linux/download_file_types.pb",
    "$output_dir/mac/download_file_types.pb",
    "$output_dir/win/download_file_types.pb",
  ]
  python_path_safe_browsing = "$proto_python_root/components/safe_browsing/content/common/file_type_policies/proto"

  inputs = [
    input_filename,
    "//components/resources/protobufs/binary_proto_generator.py",
  ]

  deps = [
    "//components/safe_browsing/content/common/file_type_policies/proto:download_file_types_proto_gen",
    "//components/safe_browsing/content/resources/download_file_types:make_all_file_types_protobuf",
    "//third_party/protobuf:py_proto",
  ]

  args = [
    "-w",
    "-a",
    "-i",
    rebase_path(input_filename, root_build_dir),
    "-d",
    rebase_path(output_dir, root_build_dir),
    "-o",
    "download_file_types.pb",
    "-p",
    rebase_path(proto_python_root, root_build_dir),
    "-p",
    rebase_path(python_path_safe_browsing, root_build_dir),
  ]
}
