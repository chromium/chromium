source_set("client_side_detection_service_base") {
  sources = [
    "client_side_detection_feature_cache_base.cc",
    "client_side_detection_feature_cache_base.h",
    "client_side_detection_service_base.cc",
    "client_side_detection_service_base.h",
    "client_side_phishing_model.cc",
    "client_side_phishing_model.h",
    "csd_model_type.h",
  ]

  public_deps = [ "//components/safe_browsing/core/common/fbs:client_model" ]

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/optimization_guide/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/prefs",
    "//components/safe_browsing/core/common",
    "//components/safe_browsing/core/common:features",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/safe_browsing/core/common/phishing_classifier",
    "//components/safe_browsing/core/common/proto:client_model_proto",
    "//components/safe_browsing/core/common/proto:csd_proto",
    "//google_apis",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "client_side_detection_feature_cache_base_unittest.cc",
    "client_side_detection_service_base_unittest.cc",
    "client_side_phishing_model_unittest.cc",
  ]
  deps = [
    ":client_side_detection_service_base",
    "//base/test:test_support",
    "//components/content_settings/core/browser",
    "//components/history/core/browser",
    "//components/optimization_guide/core",
    "//components/optimization_guide/core:test_support",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/prefs:test_support",
    "//components/safe_browsing/core/browser/db:sb_protocol_manager_util",
    "//components/safe_browsing/core/common",
    "//components/safe_browsing/core/common:features",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/safe_browsing/core/common:visual_utils",
    "//components/safe_browsing/core/common/fbs:client_model",
    "//components/safe_browsing/core/common/phishing_classifier",
    "//components/safe_browsing/core/common/phishing_classifier:unit_tests_support",
    "//components/safe_browsing/core/common/proto:client_model_proto",
    "//components/safe_browsing/core/common/proto:csd_proto",
    "//components/sync_preferences:test_support",
    "//services/network:test_support",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx",
  ]
  if (is_ios) {
    deps += [ "//components/test:safe_browsing_test_bundle_data" ]
  }
}
