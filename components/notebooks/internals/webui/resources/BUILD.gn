import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "notebooks_internals"

  static_files = [ "notebooks_internals.html" ]

  css_files = [ "app.css" ]

  ts_files = [
    "app.html.ts",
    "app.ts",
  ]

  mojo_files_deps =
      [ "//components/notebooks/internals/webui:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/components/notebooks/internals/webui/notebooks_internals.mojom-webui.ts" ]

  ts_composite = true
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
  grit_output_dir = "$root_gen_dir/components"
}
