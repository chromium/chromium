import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

generate_jni("jni_headers") {
  sources = [ "java/src/org/chromium/components/fcm/FcmBridge.java" ]
}

android_library("fcm_java") {
  deps = [
    "$google_play_services_package:google_firebase_firebase_common_java",
    "$google_play_services_package:google_firebase_firebase_installations_java",
    "$google_play_services_package:google_firebase_firebase_messaging_java",
    "$google_play_services_package:google_play_services_tasks_java",
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/jni_zero:jni_zero_java",
  ]

  srcjar_deps = [ ":jni_headers" ]
  sources = [
    "java/src/org/chromium/components/fcm/FcmBridge.java",
    "java/src/org/chromium/components/fcm/FcmManager.java",
  ]
}

robolectric_library("components_fcm_junit_tests") {
  sources = [
    "junit/src/org/chromium/components/fcm/FcmBridgeTest.java",
    "junit/src/org/chromium/components/fcm/FcmManagerTest.java",
  ]
  deps = [
    ":fcm_java",
    "$google_play_services_package:google_firebase_firebase_common_java",
    "$google_play_services_package:google_firebase_firebase_installations_java",
    "$google_play_services_package:google_firebase_firebase_messaging_java",
    "$google_play_services_package:google_play_services_tasks_java",
    "//base:base_java",
    "//base:base_junit_test_support",
    "//base/test:test_support_java",
    "//third_party/jni_zero:jni_zero_java",
    "//third_party/junit",
    "//third_party/mockito:mockito_java",
  ]
}
