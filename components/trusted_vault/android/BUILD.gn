import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_library("java") {
  srcjar_deps = [
    ":java_enums",
    ":jni_headers",
  ]
  sources = [
    "java/src/org/chromium/components/trusted_vault/TrustedVaultClient.java",
    "java/src/org/chromium/components/trusted_vault/TrustedVaultKeyAndVersion.java",
  ]
  deps = [
    "//base:base_java",
    "//base:service_loader_java",
    "//build/android:build_java",
    "//components/signin/public/android:java",
    "//components/sync/android:sync_java",
    "//google_apis/gaia/android:java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

robolectric_library("junit") {
  sources = [
    "junit/src/org/chromium/components/trusted_vault/TrustedVaultClientTest.java",
    "junit/src/org/chromium/components/trusted_vault/TrustedVaultKeyAndVersionTest.java",
  ]
  deps = [
    ":java",
    "//base:base_java",
    "//base:base_junit_test_support",
    "//components/signin/public/android:java",
    "//components/signin/public/android:signin_java_test_support",
    "//google_apis/gaia/android:java",
    "//third_party/jni_zero:jni_zero_java",
    "//third_party/junit",
    "//third_party/mockito:mockito_java",
  ]
}

java_cpp_enum("java_enums") {
  sources = [ "//components/trusted_vault/trusted_vault_server_constants.h" ]
}

generate_jni("jni_headers") {
  sources = [
    "java/src/org/chromium/components/trusted_vault/TrustedVaultClient.java",
    "java/src/org/chromium/components/trusted_vault/TrustedVaultKeyAndVersion.java",
  ]
}

source_set("android") {
  sources = [
    "trusted_vault_client_android.cc",
    "trusted_vault_client_android.h",
  ]

  public_deps = [
    "//base",
    "//components/signin/public/identity_manager",
    "//components/trusted_vault",
  ]

  deps = [
    ":jni_headers",
    "//components/sync/service",
    "//content/public/browser",
    "//google_apis",
    "//third_party/jni_zero",
  ]
}
