import("//build/config/features.gni")

source_set("actor") {
  sources = [
    "actor_filling_observer.cc",
    "actor_filling_observer.h",
    "actor_form_filling_service.h",
    "actor_form_filling_service_impl.cc",
    "actor_form_filling_service_impl.h",
    "actor_form_section_splitter.cc",
    "actor_form_section_splitter.h",
    "actor_key_metrics_recorder.cc",
    "actor_key_metrics_recorder.h",
  ]

  public_deps = [
    "//base",
    "//components/actor/core:journal",
    "//components/autofill/core/browser/integrators/actor:actor_form_filling_types",
    "//components/keyed_service/core",
  ]

  deps = [
    "//components/autofill/core/browser",
    "//components/autofill/core/common",
    "//ui/gfx/geometry",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "actor_form_filling_service_impl_test_api.h",
    "actor_test_utils.cc",
    "actor_test_utils.h",
    "mock_actor_form_filling_service.cc",
    "mock_actor_form_filling_service.h",
  ]

  public_deps = [
    ":actor",
    "//base",
  ]

  deps = [
    "//base/test:test_support",
    "//components/autofill/core/browser:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "actor_filling_observer_unittest.cc",
    "actor_form_filling_service_unittest.cc",
    "actor_form_section_splitter_unittest.cc",
    "actor_key_metrics_recorder_unittest.cc",
  ]

  deps = [
    ":actor",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//components/autofill/core/browser:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx:test_support",
  ]
}
