import("//components/on_device_translation/buildflags/features.gni")
import("//third_party/protobuf/proto_library.gni")

assert(enable_on_device_translation)

proto_library("translate_kit_api_proto") {
  sources = [ "proto/translate_kit_api.proto" ]
}

source_set("file_operation_proxy") {
  sources = [
    "file_operation_proxy_impl.cc",
    "file_operation_proxy_impl.h",
  ]
  deps = [
    "//base",
    "//components/on_device_translation/public/mojom",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("launcher_interface") {
  sources = [ "service_launcher.h" ]
  public_deps = [ "//base" ]
  deps = [
    "//components/on_device_translation/public/mojom",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("service_launcher") {
  sources = [ "service_launcher.cc" ]
  public_deps = [ ":launcher_interface" ]
  deps = [
    ":file_operation_proxy",
    "//base",
    "//components/on_device_translation",
    "//components/on_device_translation:features",
    "//components/on_device_translation/public/mojom",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("on_device_translation_service") {
  sources = [
    "on_device_translation_service.cc",
    "on_device_translation_service.h",
    "translate_kit_client.cc",
    "translate_kit_client.h",
    "translate_kit_structs.h",
  ]
  deps = [
    ":translate_kit_api_proto",
    "//components/on_device_translation:features",
    "//components/on_device_translation:metrics",
  ]

  public_deps = [
    "//base",
    "//components/on_device_translation/public/mojom/",
    "//mojo/public/cpp/bindings",
  ]

  if (is_linux || is_chromeos) {
    sources += [
      "sandbox_hook.cc",
      "sandbox_hook.h",
    ]
    deps += [ "//sandbox/linux:sandbox_services" ]
    public_deps += [ "//sandbox/policy" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "file_operation_proxy_impl_unittest.cc",
    "on_device_translation_service_unittest.cc",
    "translate_kit_client_idle_unload_unittest.cc",
    "translate_kit_client_unittest.cc",
  ]
  deps = [
    ":file_operation_proxy",
    ":test_support",
    "//base/test:test_support",
    "//components/on_device_translation",
    "//components/on_device_translation/public/mojom",
    "//components/on_device_translation/service:on_device_translation_service",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/blink/public/common:headers",
  ]
}

source_set("test_support") {
  testonly = true

  sources = [
    "test/test_util.cc",
    "test/test_util.h",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//components/on_device_translation/public/mojom",
    "//mojo/public/cpp/bindings",
  ]

  # On Android, the test APK only packages loadable modules that are linked
  # through `deps`. Elsewhere, the libraries only need to exist next to the
  # test binary at runtime.
  if (is_android) {
    deps += [
      ":mock_failing_translate_kit_lib",
      ":mock_invalid_function_pointer_lib",
      ":mock_translate_kit_lib",
      ":mock_translate_kit_without_split_sentences_lib",
    ]
  } else {
    data_deps = [
      ":mock_failing_translate_kit_lib",
      ":mock_invalid_function_pointer_lib",
      ":mock_translate_kit_lib",
      ":mock_translate_kit_without_split_sentences_lib",
    ]
  }
}

loadable_module("mock_translate_kit_lib") {
  testonly = true
  sources = [
    "test/mock_translate_kit_lib.cc",
    "translate_kit_structs.h",
  ]
  deps = [ ":translate_kit_api_proto" ]
  public_deps = [ "//base" ]
  defines = [ "TRANSLATE_KIT_SPLIT_SENTENCES" ]
}

loadable_module("mock_translate_kit_without_split_sentences_lib") {
  testonly = true
  sources = [
    "test/mock_translate_kit_lib.cc",
    "translate_kit_structs.h",
  ]
  deps = [ ":translate_kit_api_proto" ]
  public_deps = [ "//base" ]
}

loadable_module("mock_invalid_function_pointer_lib") {
  testonly = true
  sources = [ "test/mock_invalid_function_pointer_lib.cc" ]
  public_deps = [ "//base" ]
}

loadable_module("mock_failing_translate_kit_lib") {
  testonly = true
  sources = [
    "test/mock_failing_translate_kit_lib.cc",
    "translate_kit_structs.h",
  ]
  public_deps = [ "//base" ]
}
