  public = [
    "error_codes.h",
    "server_journal_event.h",
    "tool_types.h",
  ]
  sources = [
    "error_codes.cc",
    "server_journal_event.cc",
    "tool_types.cc",
  ]
  public_deps = [
    "//base",
    "//components/actor/public/mojom:mojo_bindings_shared",
  ]
}
