# The headers in public are the only ones that should be accessible from
# core. This is enforced via DEPS.
source_set("public") {
  public = [
    "conversation.h",
    "debug_sink.h",
    "error_codes.h",
    "page_context_types.h",
    "server_journal_event.h",
    "session_journal.h",
    "tool_types.h",
    "turn_state_update.h",
  ]
  sources = [
    "error_codes.cc",
    "page_context_types.cc",
    "server_journal_event.cc",
    "tool_types.cc",
  ]
  public_deps = [
    "//base",
    "//components/actor/public/mojom:mojo_bindings",
    "//components/actor/public/mojom:mojo_bindings_shared",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  public = [ "test_utils.h" ]
  public_deps = [
    ":public",
    "//testing/gmock",
  ]
}
