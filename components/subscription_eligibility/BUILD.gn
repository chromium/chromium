import("//build/config/chrome_build.gni")

source_set("subscription_eligibility") {
  sources = [
    "subscription_eligibility_metrics_util.cc",
    "subscription_eligibility_metrics_util.h",
    "subscription_eligibility_prefs.cc",
    "subscription_eligibility_prefs.h",
    "subscription_eligibility_service.cc",
    "subscription_eligibility_service.h",
  ]

  public_deps = [
    "//base",
    "//components/keyed_service/core",
  ]

  deps = [
    "//components/pref_registry",
    "//components/prefs",
  ]
}

# Display names of the AI subscription tiers.
source_set("tier_names") {
  public = [ "ai_subscription_tier_names.h" ]
  sources = [ "ai_subscription_tier_names.cc" ]

  # Google Chrome builds use the branded names from src-internal.
  if (is_chrome_branded) {
    sources += [ "//components/internal/subscription_eligibility/ai_subscription_tier_names_branded.h" ]
  } else {
    sources += [ "ai_subscription_tier_names_specs.h" ]
  }

  public_deps = [ "//base" ]
  deps = [ "//build:branding_buildflags" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ai_subscription_tier_names_unittest.cc",
    "subscription_eligibility_metrics_util_unittest.cc",
    "subscription_eligibility_service_unittest.cc",
  ]
  deps = [
    ":subscription_eligibility",
    ":tier_names",
    "//base",
    "//base/test:test_support",
    "//components/pref_registry",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
  ]
}
