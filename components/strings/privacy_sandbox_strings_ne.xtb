<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1184166532603925201">तपाईंले इन्कोग्निटो मोड प्रयोग गर्दा Chrome ले साइटहरूलाई तेस्रो पक्षीय कुकीहरू प्रयोग गर्न दिँदैन</translation>
<translation id="1569440020357229235">तपाईंले इन्कोग्निटो मोड प्रयोग गर्दा साइटहरूले तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्दैनन्। तेस्रो पक्षीय कुकीहरूमा निर्भर रहेको कुनै साइट चलिरहेको छैन भने तपाईं <ph name="BEGIN_LINK" />उक्त साइटलाई केही समयका लागि तेस्रो पक्षीय कुकीहरूको एक्सेस दिई हेर्न<ph name="END_LINK" /> सक्नुहुन्छ।</translation>
<translation id="19426210786412737">वेबसाइटहरूलाई तेस्रो पक्षीय कुकीहरूको एक्सेस दिनका लागि Chrome का हालका सेटिङ अपडेट गरिएका छन्। तपाईं जुनसुकै बेला यो सेटिङ परिवर्तन गर्न सक्नुहुन्छ।</translation>
<translation id="2004697686368036666">केही साइटका सुविधाहरूले काम नगर्न सक्छन्</translation>
<translation id="2183376768278472507">कुनै साइटले अपेक्षा गरेअनुसार काम नगरेका खण्डमा तपाईं आफूले खोल्ने कुनै खास साइटलाई तेस्रो पक्षीय कुकीहरू प्रयोग गर्ने अनुमति दिई हेर्न सक्नुहुन्छ</translation>
<translation id="2235344399760031203">तेस्रो पक्षीय कुकीहरू ब्लक गरिएका छन्</translation>
<translation id="2496115946829713659">साइटहरूले कन्टेन्ट तथा विज्ञापन पर्सनलाइज गर्ने र तपाईंले अन्य साइटमा गर्ने कारबाहीहरूका बारेमा थाहा पाउने प्रयोजनका लागि तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्छन्</translation>
<translation id="3045333309254072201">तपाईंले इन्कोग्निटो मोड प्रयोग गर्दा साइटहरूले तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्दैनन्। तेस्रो पक्षीय कुकीहरूमा निर्भर रहेको कुनै साइट चलिरहेको छैन भने तपाईं <ph name="START_LINK" />उक्त साइटलाई केही समयका लागि तेस्रो पक्षीय कुकीहरूको एक्सेस दिई हेर्न<ph name="END_LINK" /> सक्नुहुन्छ।</translation>
<translation id="3425311689852411591">तेस्रो पक्षीय कुकीहरूमा निर्भर रहेका साइटहरूले भने अपेक्षा गरेअनुसार काम गर्नु पर्ने हो</translation>
<translation id="3624583033347146597">तेस्रो पक्षीय कुकीसम्बन्धी प्राथमिकताहरू छनौट गर्नुहोस्</translation>
<translation id="3918378745482005425">केही सुविधाहरूले काम नगर्न सक्छन्। सम्बन्धित साइटहरूले अझै पनि तेस्रो पक्षीय कुकी प्रयोग गर्न सक्छन्।</translation>
<translation id="4278390842282768270">अनुमति दिइएको</translation>
<translation id="4412992751769744546">तेस्रो पक्षीय कुकीहरू प्रयोग गर्ने अनुमति दिनुहोस्</translation>
<translation id="4711259472133554310">निश्चित साइटहरूलाई सधैँ तेस्रो पक्षीय कुकीहरू प्रयोग गर्ने अनुमति दिनका निम्ति तपाईं सेटिङमा गई अपवादहरू सेट गर्न सक्नुहुन्छ</translation>
<translation id="5117284457376555514">तपाईंले सम्बन्धित साइटहरूलाई एक्सेस दिइएका खण्डमा मात्र साइटहरूले कन्टेन्ट तथा विज्ञापन पर्सनलाइज गर्ने र तपाईंले अन्य साइटमा गर्ने कारबाहीहरूका बारेमा थाहा पाउने प्रयोजनका लागि तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्छन्। साइटका केही सुविधाहरूले भने अपेक्षा गरेअनुसार काम नगर्न सक्छन्।</translation>
<translation id="5677928146339483299">ब्लक गरिएको</translation>
<translation id="6196640612572343990">तेस्रो पक्षीय कुकीहरू ब्लक गर्नुहोस्</translation>
<translation id="6308169245546905162">तपाईंले अन्य साइटहरूमा गर्ने कारबाहीहरूका बारेमा थाहा पाउन साइटहरूले तेस्रो पक्षीय कुकी प्रयोग गर्न सक्छन्</translation>
<translation id="6494210367693221285">वेबसाइटहरूलाई तेस्रो पक्षीय कुकीहरूको एक्सेस दिनका लागि Chromium का हालका सेटिङ अपडेट गरिएका छन्। तपाईं जुनसुकै बेला यो सेटिङ परिवर्तन गर्न सक्नुहुन्छ।</translation>
<translation id="6710025070089118043">तपाईंले सम्बन्धित साइटहरूलाई एक्सेस दिइएका खण्डमा मात्र साइटहरूले कन्टेन्ट तथा विज्ञापन पर्सनलाइज गर्ने र तपाईंले अन्य साइटमा गर्ने कारबाहीहरूका बारेमा थाहा पाउने प्रयोजनका लागि तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्छन्</translation>
<translation id="7315780377187123731">"तेस्रो पक्षीय कुकीहरू ब्लक गर्नुहोस्" विकल्पका बारेमा थप जानकारी</translation>
<translation id="7374493521304367420">ब्राउजरमार्फत आफ्ना साइटमा गरिएका गतिविधि हेर्न साइटहरूले अझै पनि कुकी प्रयोग गरिराख्न सक्छन्</translation>
<translation id="7453144832830554937">तेस्रो पक्षीय कुकीहरूमा निर्भर रहेका साइटका सुविधाहरूले अपेक्षा गरेअनुसार काम नगर्न सक्छन्</translation>
<translation id="7538480403395139206">"तेस्रो पक्षीय कुकीहरू प्रयोग गर्ने अनुमति दिनुहोस्" विकल्पका बारेमा थप जानकारी</translation>
<translation id="8200078544056087897">तेस्रो पक्षीय कुकीहरूमा निर्भर रहेका साइटका सुविधाहरूले भने अपेक्षा गरेअनुसार काम गर्नु पर्ने हो</translation>
<translation id="839994149685752920">साइटहरूले कन्टेन्ट तथा विज्ञापन पर्सनलाइज गर्ने प्रयोजनका लागि तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्छन्</translation>
<translation id="8428213095426709021">सेटिङ</translation>
<translation id="8712637175834984815">बुझेँ</translation>
<translation id="9039924186462989565">तपाईंले इन्कोग्निटो मोड प्रयोग गर्दा Chromium ले साइटहरूलाई तेस्रो पक्षीय कुकीहरू प्रयोग गर्न दिँदैन</translation>
<translation id="9162335340010958530">तपाईंले सम्बन्धित साइटहरूलाई एक्सेस दिइएका खण्डमा मात्र साइटहरूले कन्टेन्ट तथा विज्ञापन पर्सनलाइज गर्ने र तपाईंले अन्य साइटमा गर्ने कारबाहीहरूका बारेमा थाहा पाउने प्रयोजनका लागि तेस्रो पक्षीय कुकीहरू प्रयोग गर्न सक्छन्</translation>
