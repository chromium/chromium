<!DOCTYPE translationbundle>
<translationbundle lang="my">
<translation id="1184166532603925201">သင် ရုပ်ဖျက်မုဒ်သုံးနေသောအခါ Chrome က ဝဘ်ဆိုက်များ ပြင်ပကုမ္ပဏီ၏ကွတ်ကီး သုံးခြင်းကို ပိတ်ထားသည်</translation>
<translation id="1559726735555610004">ဝဘ်ဆိုက်များတွင် သင့်အား မည်သူမည်ဝါဖြစ်ကြောင်း ခြေရာခံရန်အတွက် ဤဒေတာကို သုံးမည်မဟုတ်ကြောင်း လူသိရှင်ကြားထုတ်ပြန်ရန် Google က ကုမ္ပဏီများအား တောင်းဆိုထားသည်။ ဝဘ်ဆိုက်အချို့သည် ကြော်ငြာအတွက်သာမက သင့်အသုံးပြုမှုကို ပုဂ္ဂိုလ်ရေးသီးသန့်ဖြစ်စေရန် သင့်လုပ်ဆောင်ချက်ကို အသုံးချနိုင်သည်။ ၎င်းတို့သည် ဤလုပ်ဆောင်ချက်နှင့် ၎င်းတို့သိထားပြီးဖြစ်သော သင့်အကြောင်း အခြားအချက်အလက်များကိုလည်း ပေါင်းစပ်နိုင်သည်။ သင့်ဒေတာကို ၎င်းတို့အသုံးပြုပုံနှင့်ပတ်သက်၍ သင့်အားအသိပေးရန် ကုမ္ပဏီများတွင် တာဝန်ရှိသည်။ Google က သင့်ဒေတာကို ကာကွယ်ပုံအကြောင်း ကျွန်ုပ်တို့၏ <ph name="BEGIN_LINK" />ကိုယ်ရေးအချက်အလက်လုံခြုံမှုဆိုင်ရာ မူဝါဒ<ph name="END_LINK" /> တွင် ပိုမိုလေ့လာနိုင်သည်။</translation>
<translation id="1569440020357229235">သင် ရုပ်ဖျက်မုဒ်သုံးနေသောအခါ ဝဘ်ဆိုက်များသည် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံး၍မရပါ။ ဤကွတ်ကီးများပေါ် မှီခိုသော ဝဘ်ဆိုက်သည် အလုပ်မလုပ်ပါက <ph name="BEGIN_LINK" />အဆိုပါဝဘ်ဆိုက်အား ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ယာယီသုံးခွင့်ပေးကြည့်နိုင်သည်<ph name="END_LINK" />။</translation>
<translation id="19426210786412737">ဝဘ်ဆိုက်များကို ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံးခွင့်ပြုရန် Chrome ၏ လက်ရှိဆက်တင်များကို အပ်ဒိတ်လုပ်လိုက်သည်။ ဤဆက်တင်ကို အချိန်မရွေးပြောင်းနိုင်သည်။</translation>
<translation id="2004697686368036666">ဝဘ်ဆိုက်အချို့ရှိ ဝန်ဆောင်မှုများ အလုပ်မလုပ်နိုင်ပါ</translation>
<translation id="2183376768278472507">ဝဘ်ဆိုက်တစ်ခုသည် မျှော်မှန်းထားသည့်အတိုင်း အလုပ်မလုပ်ပါက သင်ဝင်ကြည့်သည့် သက်ဆိုင်ရာဝဘ်ဆိုက်အတွက် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ခွင့်ပြုပြီး စမ်းကြည့်နိုင်သည်</translation>
<translation id="2235344399760031203">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ပိတ်ထားသည်</translation>
<translation id="2496115946829713659">ဝဘ်ဆိုက်များသည် အကြောင်းအရာနှင့် ကြော်ငြာများ ပုဂ္ဂိုလ်ရေးသီးသန့်ပြုလုပ်ရန်၊ အခြားဝဘ်ဆိုက်ပေါ်ရှိ သင်၏လုပ်ဆောင်ချက်များအကြောင်း လေ့လာရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို သုံး၍မရပါ</translation>
<translation id="3045333309254072201">သင် ရုပ်ဖျက်မုဒ်သုံးနေသောအခါ ဝဘ်ဆိုက်များသည် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံး၍မရပါ။ ဤကွတ်ကီးများပေါ် မှီခိုသော ဝဘ်ဆိုက်သည် အလုပ်မလုပ်ပါက <ph name="START_LINK" />အဆိုပါဝဘ်ဆိုက်အား ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ယာယီသုံးခွင့်ပေးကြည့်နိုင်သည်<ph name="END_LINK" />။</translation>
<translation id="3425311689852411591">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများပေါ် မှီခိုသော ဝဘ်ဆိုက်များသည် မျှော်မှန်းထားသည့်အတိုင်း အလုပ်လုပ်နိုင်သည်</translation>
<translation id="3624583033347146597">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီး သတ်မှတ်ချက်များ ရွေးပါ</translation>
<translation id="3918378745482005425">ဝန်ဆောင်မှုအချို့ အလုပ်မလုပ်နိုင်ပါ။ သက်ဆိုင်ရာဝဘ်ဆိုက်များက ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ဆက်သုံးနိုင်သည်။</translation>
<translation id="4009365983562022788">ဝဘ်ဆိုက်များတွင် သင့်အား မည်သူမည်ဝါဖြစ်ကြောင်း ခြေရာခံရန်အတွက် ဤဒေတာကို သုံးမည်မဟုတ်ကြောင်း လူသိရှင်ကြားထုတ်ပြန်ရန် Google က ကုမ္ပဏီများအား တောင်းဆိုထားသည်။ ဝဘ်ဆိုက်အချို့သည် ကြော်ငြာအတွက်သာမက သင့်အသုံးပြုမှုကို ပုဂ္ဂိုလ်ရေးသီးသန့်ဖြစ်စေရန် သင့်လုပ်ဆောင်ချက်ကို အသုံးချနိုင်သည်။ ၎င်းတို့သည် ဤလုပ်ဆောင်ချက်နှင့် ၎င်းတို့သိထားပြီးဖြစ်သော သင့်အကြောင်း အခြားအချက်အလက်များကိုလည်း ပေါင်းစပ်နိုင်သည်။ သင့်ဒေတာကို ၎င်းတို့အသုံးပြုပုံနှင့်ပတ်သက်၍ သင့်အားအသိပေးရန် ကုမ္ပဏီများတွင် တာဝန်ရှိသည်။ ကျွန်ုပ်တို့၏ <ph name="BEGIN_LINK1" />ကိုယ်ရေးအချက်အလက်လုံခြုံမှုဆိုင်ရာ မူဝါဒ<ph name="LINK_END1" /> တွင် ပိုမိုလေ့လာပါ။</translation>
<translation id="4278390842282768270">ခွင့်ပြုထားသည်</translation>
<translation id="4412992751769744546">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ ခွင့်ပြုရန်</translation>
<translation id="4711259472133554310">ဆက်တင်များတွင် ခြွင်းချက်အခြေအနေ ပြုလုပ်ပြီး ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံးရန် သက်ဆိုင်ရာဝဘ်ဆိုက်များကို အမြဲခွင့်ပြုနိုင်သည်</translation>
<translation id="5117284457376555514">သင်သည် သက်ဆိုင်ရာဝဘ်ဆိုက်များအား သုံးခွင့်ပြုမထားပါက ဝဘ်ဆိုက်များသည် အကြောင်းအရာနှင့် ကြော်ငြာများ ပုဂ္ဂိုလ်ရေးသီးသန့်ပြုလုပ်ရန်၊ အခြားဝဘ်ဆိုက်ပေါ်ရှိ သင်၏လုပ်ဆောင်ချက်များအကြောင်း လေ့လာရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို သုံး၍မရပါ။ ဝဘ်ဆိုက်ဝန်ဆောင်မှုအချို့သည် မျှော်မှန်းထားသည့်အတိုင်း အလုပ်မလုပ်နိုင်ပါ။</translation>
<translation id="5677928146339483299">ပိတ်ထားသည်</translation>
<translation id="6196640612572343990">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ပိတ်ထားရန်</translation>
<translation id="6308169245546905162">ဝဘ်ဆိုက်များသည် အခြားဝဘ်ဆိုက်ပေါ်ရှိ သင်၏လုပ်ဆောင်ချက်များအကြောင်း လေ့လာရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံးနိုင်သည်</translation>
<translation id="6494210367693221285">ဝဘ်ဆိုက်များကို ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံးခွင့်ပြုရန် Chromium ၏ လက်ရှိဆက်တင်များကို အပ်ဒိတ်လုပ်လိုက်သည်။ ဤဆက်တင်ကို အချိန်မရွေးပြောင်းနိုင်သည်။</translation>
<translation id="6710025070089118043">သင်သည် သက်ဆိုင်ရာဝဘ်ဆိုက်များအား သုံးခွင့်ပေးမထားပါက ဝဘ်ဆိုက်များသည် အကြောင်းအရာနှင့် ကြော်ငြာများ ပုဂ္ဂိုလ်ရေးသီးသန့်ပြုလုပ်ရန်၊ အခြားဝဘ်ဆိုက်ပေါ်ရှိ သင်၏လုပ်ဆောင်ချက်များအကြောင်း လေ့လာရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို သုံး၍မရပါ</translation>
<translation id="7315780377187123731">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ပိတ်ထားရန် ရွေးချယ်စရာအကြောင်း နောက်ထပ်အချက်အလက်</translation>
<translation id="7374493521304367420">ဝဘ်ဆိုက်များသည် ၎င်းတို့၏ဝဘ်ဆိုက်ပေါ်ရှိ ကြည့်ရှုခြင်းများ မြင်ရရန် ကွတ်ကီးများကို သုံးနိုင်သေးသည်</translation>
<translation id="7453144832830554937">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများပေါ် မှီခိုသော ဝဘ်ဆိုက်ဝန်ဆောင်မှုများ အလုပ်မလုပ်နိုင်ပါ</translation>
<translation id="7538480403395139206">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို ခွင့်ပြုရန် ရွေးချယ်စရာအကြောင်း နောက်ထပ်အချက်အလက်</translation>
<translation id="8200078544056087897">ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများပေါ် မှီခိုသော ဝဘ်ဆိုက်ဝန်ဆောင်မှုများသည် မျှော်မှန်းထားသည့်အတိုင်း အလုပ်လုပ်နိုင်သည်</translation>
<translation id="839994149685752920">ဝဘ်ဆိုက်များသည် အကြောင်းအရာနှင့် ကြော်ငြာများ ပုဂ္ဂိုလ်ရေးသီးသန့်ပြုလုပ်ရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများ သုံးနိုင်သည်</translation>
<translation id="8428213095426709021">ဆက်တင်များ</translation>
<translation id="8712637175834984815">နားလည်ပြီ</translation>
<translation id="9039924186462989565">သင် ရုပ်ဖျက်မုဒ်သုံးနေသောအခါ Chromium က ဝဘ်ဆိုက်များ ပြင်ပကုမ္ပဏီ၏ကွတ်ကီး သုံးခြင်းကို ပိတ်ထားသည်</translation>
<translation id="9162335340010958530">သင်သည် သက်ဆိုင်ရာဝဘ်ဆိုက်များအား သုံးခွင့်ပြုမထားပါက ဝဘ်ဆိုက်များသည် အကြောင်းအရာနှင့် ကြော်ငြာများ ပုဂ္ဂိုလ်ရေးသီးသန့်ပြုလုပ်ရန်၊ အခြားဝဘ်ဆိုက်ပေါ်ရှိ သင်၏လုပ်ဆောင်ချက်များအကြောင်း လေ့လာရန် ပြင်ပကုမ္ပဏီ၏ကွတ်ကီးများကို သုံး၍မရပါ</translation>
</translationbundle>