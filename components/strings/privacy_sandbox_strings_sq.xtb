<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1184166532603925201">Kur je në modalitetin "I fshehtë", Chrome bllokon përdorimin e kukive të palëve të treta nga sajtet</translation>
<translation id="1569440020357229235">Kur je në modalitetin "I fshehtë", sajtet nuk mund të përdorin kukit e palëve të treta. Nëse një sajt që mbështetet në këto kuki nuk funksionon, mund <ph name="BEGIN_LINK" />të provosh t'i japësh atij sajti qasje të përkohshme te kukit e palëve të treta<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Cilësimet e tua aktuale të Chrome janë përditësuar për të lejuar uebsajtet të kenë qasje te kukit e palëve të treta. Mund ta ndryshosh këtë cilësim në çdo kohë.</translation>
<translation id="2004697686368036666">Veçoritë në disa sajte mund të mos funksionojnë</translation>
<translation id="2183376768278472507">Nëse një sajt nuk funksionon siç pritet, mund të provosh që të lejosh kukit e palëve të treta për një sajt specifik që viziton ti</translation>
<translation id="2235344399760031203">Kukit e palëve të treta janë bllokuar</translation>
<translation id="2496115946829713659">Sajtet mund të përdorin kukit e palëve të treta për të personalizuar përmbajtjet dhe reklamat, si dhe për të mësuar për veprimet që ti bën në sajte të tjera</translation>
<translation id="3045333309254072201">Kur je në modalitetin "I fshehtë", sajtet nuk mund të përdorin kukit e palëve të treta. Nëse një sajt që mbështetet në këto kuki nuk funksionon, mund <ph name="START_LINK" />të provosh t'i japësh atij sajti qasje të përkohshme te kukit e palëve të treta<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">Sajtet që mbështeten në kukit e palëve të treta do të funksionojnë siç pritet</translation>
<translation id="3624583033347146597">Zgjidh preferencat e tua për kukit e palëve të treta</translation>
<translation id="3918378745482005425">Disa veçori mund të mos funksionojnë. Sajtet e lidhura mund të përdorin përsëri kukit e palëve të treta.</translation>
<translation id="4278390842282768270">Lejuar</translation>
<translation id="4412992751769744546">Lejo kukit e palëve të treta</translation>
<translation id="4711259472133554310">Mund të krijosh përjashtime te "Cilësimet" për të lejuar gjithmonë sajte specifike që të përdorin kukit e palëve të treta</translation>
<translation id="5117284457376555514">Sajtet nuk mund të përdorin kukit e palëve të treta për të personalizuar përmbajtjet dhe reklamat, apo për të mësuar për veprimet që ti bën në sajte të tjera, përveçse nëse i lejon sajtet përkatëse që të qasen në to. Disa veçori të sajteve mund të mos funksionojnë siç pritet.</translation>
<translation id="5677928146339483299">Bllokuar</translation>
<translation id="6196640612572343990">Blloko kukit e palëve të treta</translation>
<translation id="6308169245546905162">Sajtet mund të përdorin kukit e palëve të treta për të mësuar për veprimet që ti bën në to</translation>
<translation id="6494210367693221285">Cilësimet e tua aktuale të Chromium janë përditësuar për të lejuar uebsajtet të kenë qasje te kukit e palëve të treta. Mund ta ndryshosh këtë cilësim në çdo kohë.</translation>
<translation id="6710025070089118043">Sajtet nuk mund të përdorin kukit e palëve të treta për të personalizuar përmbajtjet dhe reklamat, apo për të mësuar për veprimet që ti bën në sajte të tjera, përveçse nëse u jep sajteve përkatëse qasje në to</translation>
<translation id="7315780377187123731">Më shumë rreth opsionit "Blloko kukit e palëve të treta"</translation>
<translation id="7374493521304367420">Sajtet mund të përdorin përsëri kukit për të shikuar aktivitetin e shfletimit në to</translation>
<translation id="7453144832830554937">Veçoritë e sajteve që mbështeten në kukit e palëve të treta mund të mos funksionojnë</translation>
<translation id="7538480403395139206">Më shumë rreth opsionit "Lejo kukit e palëve të treta"</translation>
<translation id="8200078544056087897">Veçoritë e sajteve që mbështeten në kukit e palëve të treta do të funksionojnë siç pritet</translation>
<translation id="839994149685752920">Sajtet mund të përdorin kukit e palëve të treta për të personalizuar përmbajtjet dhe reklamat</translation>
<translation id="8428213095426709021">Cilësimet</translation>
<translation id="8712637175834984815">E kuptova</translation>
<translation id="9039924186462989565">Kur je në modalitetin "I fshehtë", Chromium bllokon përdorimin e kukive të palëve të treta nga sajtet</translation>
<translation id="9162335340010958530">Sajtet nuk mund të përdorin kukit e palëve të treta për të personalizuar përmbajtjet dhe reklamat, apo për të mësuar për veprimet që ti bën në sajte të tjera, përveçse nëse i lejon sajtet përkatëse që të qasen në to</translation>
</translationbundle>