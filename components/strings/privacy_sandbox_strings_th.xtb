<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1184166532603925201">เมื่อคุณอยู่ในโหมดไม่ระบุตัวตน Chrome จะบล็อกเว็บไซต์ไม่ให้ใช้คุกกี้ของบุคคลที่สาม</translation>
<translation id="1569440020357229235">เมื่อคุณอยู่ในโหมดไม่ระบุตัวตน เว็บไซต์จะใช้คุกกี้ของบุคคลที่สามไม่ได้ หากเว็บไซต์ที่ใช้คุกกี้เหล่านี้ไม่ทำงาน คุณสามารถ<ph name="BEGIN_LINK" />ลองให้สิทธิ์เข้าถึงคุกกี้ของบุคคลที่สามชั่วคราว<ph name="END_LINK" /></translation>
<translation id="19426210786412737">การตั้งค่า Chrome ปัจจุบันได้รับการอัปเดตเพื่ออนุญาตให้เว็บไซต์เข้าถึงคุกกี้ของบุคคลที่สาม คุณเปลี่ยนแปลงการตั้งค่านี้ได้ทุกเมื่อ</translation>
<translation id="2004697686368036666">ฟีเจอร์ในบางเว็บไซต์อาจใช้งานไม่ได้</translation>
<translation id="2183376768278472507">หากเว็บไซต์ไม่ทำงานตามที่คาดไว้ คุณอาจลองอนุญาตคุกกี้ของบุคคลที่สามสำหรับบางเว็บไซต์ที่คุณเข้าชม</translation>
<translation id="2235344399760031203">แสดงว่ามีการบล็อกคุกกี้ของบุคคลที่สาม</translation>
<translation id="2496115946829713659">เว็บไซต์สามารถใช้คุกกี้ของบุคคลที่สามเพื่อปรับเปลี่ยนเนื้อหาและโฆษณาในแบบของคุณ รวมถึงเรียนรู้เกี่ยวกับการกระทำที่คุณทำในเว็บไซต์อื่นๆ</translation>
<translation id="3045333309254072201">เมื่อคุณอยู่ในโหมดไม่ระบุตัวตน เว็บไซต์จะใช้คุกกี้ของบุคคลที่สามไม่ได้ หากเว็บไซต์ที่ใช้คุกกี้เหล่านี้ไม่ทำงาน คุณสามารถ<ph name="START_LINK" />ลองให้สิทธิ์เข้าถึงคุกกี้ของบุคคลที่สามชั่วคราว<ph name="END_LINK" /></translation>
<translation id="3425311689852411591">เว็บไซต์ที่ใช้คุกกี้ของบุคคลที่สามควรทำงานได้ตามที่คาดไว้</translation>
<translation id="3624583033347146597">เลือกค่ากำหนดคุกกี้ของบุคคลที่สาม</translation>
<translation id="3918378745482005425">ฟีเจอร์บางอย่างอาจใช้งานไม่ได้ เว็บไซต์ที่เกี่ยวข้องจะยังคงใช้คุกกี้ของบุคคลที่สามได้</translation>
<translation id="4278390842282768270">อนุญาต</translation>
<translation id="4412992751769744546">อนุญาตคุกกี้ของบุคคลที่สาม</translation>
<translation id="4711259472133554310">คุณสามารถสร้างข้อยกเว้นในการตั้งค่าเพื่ออนุญาตให้เว็บไซต์บางแห่งใช้คุกกี้ของบุคคลที่สามได้เสมอ</translation>
<translation id="5117284457376555514">เว็บไซต์ไม่สามารถใช้คุกกี้ของบุคคลที่สามเพื่อปรับเปลี่ยนเนื้อหาและโฆษณาในแบบของคุณ รวมถึงเรียนรู้เกี่ยวกับการกระทำที่คุณทำในเว็บไซต์อื่นๆ เว้นแต่คุณจะอนุญาตให้เว็บไซต์ที่เกี่ยวข้องเข้าถึงได้ ฟีเจอร์บางอย่างของเว็บไซต์อาจไม่ทำงานตามที่คาดไว้</translation>
<translation id="5677928146339483299">ถูกบล็อก</translation>
<translation id="6196640612572343990">บล็อกคุกกี้ของบุคคลที่สาม</translation>
<translation id="6308169245546905162">เว็บไซต์สามารถใช้คุกกี้ของบุคคลที่สามเพื่อดูข้อมูลเกี่ยวกับการกระทำของคุณในเว็บไซต์อื่นๆ</translation>
<translation id="6494210367693221285">การตั้งค่า Chromium ปัจจุบันได้รับการอัปเดตเพื่ออนุญาตให้เว็บไซต์เข้าถึงคุกกี้ของบุคคลที่สาม คุณเปลี่ยนแปลงการตั้งค่านี้ได้ทุกเมื่อ</translation>
<translation id="6710025070089118043">เว็บไซต์ไม่สามารถใช้คุกกี้ของบุคคลที่สามเพื่อปรับเปลี่ยนเนื้อหาและโฆษณาในแบบของคุณ รวมถึงเรียนรู้เกี่ยวกับการกระทำที่คุณทำในเว็บไซต์อื่นๆ เว้นแต่คุณจะให้สิทธิ์เว็บไซต์ที่เกี่ยวข้องเข้าถึงได้</translation>
<translation id="7315780377187123731">ข้อมูลเพิ่มเติมเกี่ยวกับตัวเลือก "บล็อกคุกกี้ของบุคคลที่สาม"</translation>
<translation id="7374493521304367420">เว็บไซต์จะยังคงใช้คุกกี้เพื่อดูกิจกรรมการท่องเว็บในเว็บไซต์ตนเองได้</translation>
<translation id="7453144832830554937">ฟีเจอร์ของเว็บไซต์ที่ใช้คุกกี้ของบุคคลที่สามอาจไม่ทำงาน</translation>
<translation id="7538480403395139206">ข้อมูลเพิ่มเติมเกี่ยวกับตัวเลือก "อนุญาตคุกกี้ของบุคคลที่สาม"</translation>
<translation id="8200078544056087897">ฟีเจอร์ของเว็บไซต์ที่ใช้คุกกี้ของบุคคลที่สามควรทำงานตามที่คาดไว้</translation>
<translation id="839994149685752920">เว็บไซต์สามารถใช้คุกกี้ของบุคคลที่สามเพื่อปรับเปลี่ยนเนื้อหาและโฆษณาในแบบของคุณ</translation>
<translation id="8428213095426709021">การตั้งค่า</translation>
<translation id="8712637175834984815">รับทราบ</translation>
<translation id="9039924186462989565">เมื่อคุณอยู่ในโหมดไม่ระบุตัวตน Chromium จะบล็อกเว็บไซต์ไม่ให้ใช้คุกกี้ของบุคคลที่สาม</translation>
<translation id="9162335340010958530">เว็บไซต์ไม่สามารถใช้คุกกี้ของบุคคลที่สามเพื่อปรับเปลี่ยนเนื้อหาและโฆษณาในแบบของคุณ รวมถึงเรียนรู้เกี่ยวกับการกระทำที่คุณทำในเว็บไซต์อื่นๆ เว้นแต่คุณจะอนุญาตให้เว็บไซต์ที่เกี่ยวข้องเข้าถึงได้</translation>
</translationbundle>