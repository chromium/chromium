<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1184166532603925201">ເມື່ອທ່ານຢູ່ໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, Chrome ຈະບລັອກເວັບໄຊຈາກການໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="1559726735555610004">Google ກຳນົດໃຫ້ບໍລິສັດຕ້ອງປະກາດຕໍ່ສາທາລະນະວ່າເຂົາເຈົ້າຈະບໍ່ໃຊ້ຂໍ້ມູນນີ້ເພື່ອຕິດຕາມທ່ານໃນເວັບໄຊຕ່າງໆ. ບາງເວັບໄຊອາດໃຊ້ຂໍ້ມູນການເຄື່ອນໄຫວຂອງທ່ານເພື່ອປັບແຕ່ງປະສົບການໃນການໃຊ້ຂອງທ່ານໃຫ້ເປັນແບບສ່ວນຕົວ, ເຊິ່ງບໍ່ແມ່ນພຽງແຕ່ໂຄສະນາເທົ່ານັ້ນ. ນອກຈາກນີ້, ເຂົາເຈົ້າຍັງອາດຮວມຂໍ້ມູນນີ້ເຂົ້າກັບຂໍ້ມູນອື່ນໆທີ່ເຂົາເຈົ້າຮູ້ກ່ຽວກັບທ່ານຢູ່ແລ້ວ. ບໍລິສັດມີໜ້າທີ່ແຈ້ງໃຫ້ທ່ານຮູ້ກ່ຽວກັບວິທີທີ່ບໍລິສັດໃຊ້ຂໍ້ມູນຂອງທ່ານ. ສຶກສາເພີ່ມເຕີມກ່ຽວກັບວິທີທີ່ Google ປົກປ້ອງຂໍ້ມູນຂອງທ່ານໃນ <ph name="BEGIN_LINK" />ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ<ph name="END_LINK" /> ຂອງພວກເຮົາ.</translation>
<translation id="1569440020357229235">ເມື່ອທ່ານຢູ່ໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, ເວັບໄຊຕ່າງໆຈະບໍ່ສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມໄດ້. ຫາກເວັບໄຊໃດໜຶ່ງທີ່ອາໄສຄຸກກີ້ເຫຼົ່ານີ້ບໍ່ເຮັດວຽກ, ທ່ານສາມາດ <ph name="BEGIN_LINK" />ລອງໃຫ້ສິດເວັບໄຊນັ້ນເຂົ້າເຖິງຄຸກກີ້ພາກສ່ວນທີສາມຊົ່ວຄາວໄດ້<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">ການຕັ້ງຄ່າ Chrome ປັດຈຸບັນຂອງທ່ານໄດ້ຮັບການອັບເດດເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊເຂົ້າເຖິງຄຸກກີ້ພາກສ່ວນທີສາມ. ທ່ານສາມາດປ່ຽນການຕັ້ງຄ່ານີ້ໄດ້ທຸກເວລາ.</translation>
<translation id="2004697686368036666">ຄຸນສົມບັດຢູ່ບາງເວັບໄຊອາດບໍ່ເຮັດວຽກ</translation>
<translation id="2183376768278472507">ຫາກເວັບໄຊບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້, ທ່ານສາມາດລອງອະນຸຍາດຄຸກກີ້ພາກສ່ວນທີສາມສຳລັບບາງເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງໄດ້</translation>
<translation id="2235344399760031203">ຄຸກກີ້ພາກສ່ວນທີສາມຖືກບລັອກໄວ້</translation>
<translation id="2496115946829713659">ເວັບໄຊຕ່າງໆສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອປັບແຕ່ງເນື້ອຫາ ແລະ ໂຄສະນາໃຫ້ເປັນສ່ວນຕົວ ແລະ ສຶກສາກ່ຽວກັບຄຳສັ່ງທີ່ທ່ານເຮັດຢູ່ເວັບໄຊອື່ນໄດ້</translation>
<translation id="3045333309254072201">ເມື່ອທ່ານຢູ່ໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, ເວັບໄຊຕ່າງໆຈະບໍ່ສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມໄດ້. ຫາກເວັບໄຊໃດໜຶ່ງທີ່ອາໄສຄຸກກີ້ເຫຼົ່ານີ້ບໍ່ເຮັດວຽກ, ທ່ານສາມາດ <ph name="START_LINK" />ລອງໃຫ້ສິດເວັບໄຊນັ້ນເຂົ້າເຖິງຄຸກກີ້ພາກສ່ວນທີສາມຊົ່ວຄາວໄດ້<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">ເວັບໄຊທີ່ອາໄສຄຸກກີ້ພາກສ່ວນທີສາມຄວນເຮັດວຽກຕາມທີ່ຄາດໄວ້</translation>
<translation id="3624583033347146597">ເລືອກການຕັ້ງຄ່າຄຸກກີ້ພາກສ່ວນທີສາມຂອງທ່ານ</translation>
<translation id="3918378745482005425">ຄຸນສົມບັດບາງຢ່າງອາດບໍ່ເຮັດວຽກ. ເວັບໄຊທີ່ກ່ຽວຂ້ອງຍັງສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມຢູ່.</translation>
<translation id="4009365983562022788">Google ກຳນົດໃຫ້ບໍລິສັດຕ້ອງປະກາດຕໍ່ສາທາລະນະວ່າເຂົາເຈົ້າຈະບໍ່ໃຊ້ຂໍ້ມູນນີ້ເພື່ອຕິດຕາມທ່ານໃນເວັບໄຊຕ່າງໆ. ບາງເວັບໄຊອາດໃຊ້ຂໍ້ມູນການເຄື່ອນໄຫວຂອງທ່ານເພື່ອປັບແຕ່ງປະສົບການໃນການໃຊ້ຂອງທ່ານໃຫ້ເປັນແບບສ່ວນຕົວ, ເຊິ່ງບໍ່ແມ່ນພຽງແຕ່ໂຄສະນາເທົ່ານັ້ນ. ນອກຈາກນີ້, ເຂົາເຈົ້າຍັງອາດຮວມຂໍ້ມູນນີ້ເຂົ້າກັບຂໍ້ມູນອື່ນໆທີ່ເຂົາເຈົ້າຮູ້ກ່ຽວກັບທ່ານຢູ່ແລ້ວ. ບໍລິສັດມີໜ້າທີ່ແຈ້ງໃຫ້ທ່ານຮູ້ກ່ຽວກັບວິທີທີ່ບໍລິສັດໃຊ້ຂໍ້ມູນຂອງທ່ານ. ສຶກສາເພີ່ມເຕີມໃນ <ph name="BEGIN_LINK1" />ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ<ph name="LINK_END1" /> ຂອງພວກເຮົາ.</translation>
<translation id="4278390842282768270">ອະນຸຍາດແລ້ວ</translation>
<translation id="4412992751769744546">ອະ​ນຸ​ຍາດ​ຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="4711259472133554310">ທ່ານສາມາດສ້າງຂໍ້ຍົກເວັ້ນໄດ້ໃນການຕັ້ງຄ່າເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊສະເພາະໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມໄດ້ຕະຫຼອດເວລາ</translation>
<translation id="5117284457376555514">ເວັບໄຊຕ່າງໆບໍ່ສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອປັບແຕ່ງເນື້ອຫາ ແລະ ໂຄສະນາໃຫ້ເປັນສ່ວນຕົວ ແລະ ສຶກສາກ່ຽວກັບຄຳສັ່ງທີ່ທ່ານເຮັດຢູ່ເວັບໄຊອື່ນໄດ້, ເວັ້ນແຕ່ທ່ານຈະອະນຸຍາດໃຫ້ເວັບໄຊທີ່ກ່ຽວຂ້ອງເຂົ້າເຖິງພວກມັນ. ຄຸນສົມບັດເວັບໄຊບາງຢ່າງອາດບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້.</translation>
<translation id="5677928146339483299">ບລັອກແລ້ວ</translation>
<translation id="6196640612572343990">ບລັອກຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="6308169245546905162">ເວັບໄຊຕ່າງໆສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອສຶກສາກ່ຽວກັບຄຳສັ່ງທີ່ທ່ານເຮັດຢູ່ເວັບໄຊອື່ນໄດ້</translation>
<translation id="6494210367693221285">ການຕັ້ງຄ່າ Chromium ປັດຈຸບັນຂອງທ່ານໄດ້ຮັບການອັບເດດເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊເຂົ້າເຖິງຄຸກກີ້ພາກສ່ວນທີສາມ. ທ່ານສາມາດປ່ຽນການຕັ້ງຄ່ານີ້ໄດ້ທຸກເວລາ.</translation>
<translation id="6710025070089118043">ເວັບໄຊຕ່າງໆບໍ່ສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອປັບແຕ່ງເນື້ອຫາ ແລະ ໂຄສະນາໃຫ້ເປັນສ່ວນຕົວ ແລະ ສຶກສາກ່ຽວກັບຄຳສັ່ງທີ່ທ່ານເຮັດຢູ່ເວັບໄຊອື່ນໄດ້, ເວັ້ນແຕ່ທ່ານຈະໃຫ້ສິດເຂົ້າເຖິງເວັບໄຊທີ່ກ່ຽວຂ້ອງໃຫ້ພວກມັນ</translation>
<translation id="7315780377187123731">ເພີ່ມເຕີມກ່ຽວກັບຕົວເລືອກການບລັອກຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="7374493521304367420">ເວັບໄຊຍັງຄົງສາມາດໃຊ້ຄຸກກີ້ເພື່ອເບິ່ງການເຄື່ອນໄຫວການທ່ອງເວັບຢູ່ເວັບໄຊຂອງຕົນເອງໄດ້</translation>
<translation id="7453144832830554937">ຄຸນສົມບັດເວັບໄຊທີ່ອາໄສຄຸກກີ້ພາກສ່ວນທີສາມອາດບໍ່ເຮັດວຽກ</translation>
<translation id="7538480403395139206">ເພີ່ມເຕີມກ່ຽວກັບຕົວເລືອກການອະນຸຍາດຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="8200078544056087897">ຄຸນສົມບັດເວັບໄຊທີ່ອາໄສຄຸກກີ້ພາກສ່ວນທີສາມຄວນເຮັດວຽກຕາມທີ່ຄາດໄວ້</translation>
<translation id="839994149685752920">ເວັບໄຊຕ່າງໆສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອປັບແຕ່ງເນື້ອຫາ ແລະ ໂຄສະນາໃຫ້ເປັນສ່ວນຕົວໄດ້</translation>
<translation id="8428213095426709021">ການຕັ້ງຄ່າ</translation>
<translation id="8712637175834984815">ເຂົ້າໃຈແລ້ວ</translation>
<translation id="9039924186462989565">ເມື່ອທ່ານຢູ່ໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, Chromium ຈະບລັອກເວັບໄຊຈາກການໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມ</translation>
<translation id="9162335340010958530">ເວັບໄຊຕ່າງໆບໍ່ສາມາດໃຊ້ຄຸກກີ້ພາກສ່ວນທີສາມເພື່ອປັບແຕ່ງເນື້ອຫາ ແລະ ໂຄສະນາໃຫ້ເປັນສ່ວນຕົວ ແລະ ສຶກສາກ່ຽວກັບຄຳສັ່ງທີ່ທ່ານເຮັດຢູ່ເວັບໄຊອື່ນໄດ້, ເວັ້ນແຕ່ທ່ານຈະອະນຸຍາດໃຫ້ເວັບໄຊທີ່ກ່ຽວຂ້ອງເຂົ້າເຖິງພວກມັນ</translation>
</translationbundle>