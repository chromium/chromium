<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1184166532603925201">Khi bạn ở chế độ ẩn danh, Chrome sẽ chặn các trang web sử dụng cookie của bên thứ ba</translation>
<translation id="1559726735555610004">Google yêu cầu các công ty phải tuyên bố công khai rằng họ sẽ không sử dụng dữ liệu này để theo dõi bạn trên các trang web. Một số trang web có thể dùng dữ liệu về hoạt động của bạn để cá nhân hoá trải nghiệm cho bạn, không chỉ riêng cho mục đích quảng cáo. Các trang web đó cũng có thể kết hợp thông tin này với những thông tin khác mà họ đã biết về bạn. Các công ty có trách nhiệm cho bạn biết cách họ sử dụng dữ liệu của bạn. Tìm hiểu thêm về cách Google bảo vệ dữ liệu của bạn trong <ph name="BEGIN_LINK" />Chính sách quyền riêng tư<ph name="END_LINK" /> của chúng tôi.</translation>
<translation id="1569440020357229235">Khi bạn ở chế độ ẩn danh, các trang web sẽ không thể sử dụng cookie của bên thứ ba. Nếu một trang web phụ thuộc vào các cookie này không hoạt động, bạn có thể <ph name="BEGIN_LINK" />thử cấp cho trang web đó quyền truy cập tạm thời vào cookie của bên thứ ba<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Chế độ cài đặt Chrome hiện tại của bạn đã được cập nhật để cho phép trang web truy cập vào cookie của bên thứ ba. Bạn có thể thay đổi chế độ cài đặt này bất cứ lúc nào.</translation>
<translation id="2004697686368036666">Các tính năng trên một số trang web có thể không hoạt động</translation>
<translation id="2183376768278472507">Nếu một trang web bạn ghé thăm không hoạt động như dự kiến, bạn có thể thử cho phép trang web đó sử dụng cookie của bên thứ ba</translation>
<translation id="2235344399760031203">Đã chặn cookie của bên thứ ba</translation>
<translation id="2496115946829713659">Các trang web có thể sử dụng cookie của bên thứ ba để cá nhân hoá nội dung và quảng cáo, cũng như tìm hiểu về những thao tác bạn thực hiện trên các trang web khác</translation>
<translation id="3045333309254072201">Khi bạn ở chế độ ẩn danh, các trang web sẽ không thể sử dụng cookie của bên thứ ba. Nếu một trang web phụ thuộc vào các cookie này không hoạt động, bạn có thể <ph name="START_LINK" />thử cấp cho trang web đó quyền truy cập tạm thời vào cookie của bên thứ ba<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">Các trang web dựa vào cookie của bên thứ ba sẽ hoạt động như dự kiến</translation>
<translation id="3624583033347146597">Chọn lựa chọn ưu tiên về cookie của bên thứ ba</translation>
<translation id="3918378745482005425">Một số tính năng có thể không hoạt động. Các trang web có liên quan vẫn có thể sử dụng cookie của bên thứ ba.</translation>
<translation id="4009365983562022788">Google yêu cầu các công ty phải tuyên bố công khai rằng họ sẽ không sử dụng dữ liệu này để theo dõi bạn trên các trang web. Một số trang web có thể dùng dữ liệu về hoạt động của bạn để cá nhân hoá trải nghiệm cho bạn, không chỉ riêng cho mục đích quảng cáo. Các trang web đó cũng có thể kết hợp thông tin này với những thông tin khác mà họ đã biết về bạn. Các công ty có trách nhiệm cho bạn biết cách họ sử dụng dữ liệu của bạn. Tìm hiểu thêm về <ph name="BEGIN_LINK1" />Chính sách quyền riêng tư<ph name="LINK_END1" /> của chúng tôi.</translation>
<translation id="4278390842282768270">Được phép</translation>
<translation id="4412992751769744546">Cho phép cookie của bên thứ ba</translation>
<translation id="4711259472133554310">Bạn có thể tạo ngoại lệ trong phần Cài đặt để luôn cho phép một số trang web cụ thể sử dụng cookie của bên thứ ba</translation>
<translation id="5117284457376555514">Các trang web không thể sử dụng cookie của bên thứ ba để cá nhân hoá nội dung và quảng cáo, cũng như tìm hiểu về thao tác bạn thực hiện trên các trang web khác, trừ phi bạn cho phép các trang web có liên quan truy cập vào những cookie đó. Một số tính năng của trang web có thể không hoạt động như dự kiến.</translation>
<translation id="5677928146339483299">Bị chặn</translation>
<translation id="6196640612572343990">Chặn cookie của bên thứ ba</translation>
<translation id="6308169245546905162">Các trang web có thể sử dụng cookie của bên thứ ba để tìm hiểu về những thao tác bạn thực hiện trên các trang web khác</translation>
<translation id="6494210367693221285">Chế độ cài đặt Chromium hiện tại của bạn đã được cập nhật để cho phép trang web truy cập vào cookie của bên thứ ba. Bạn có thể thay đổi chế độ cài đặt này bất cứ lúc nào.</translation>
<translation id="6710025070089118043">Các trang web không thể sử dụng cookie của bên thứ ba để cá nhân hoá nội dung và quảng cáo, cũng như để tìm hiểu về thao tác bạn thực hiện trên các trang web khác, trừ phi bạn cấp cho các trang web có liên quan quyền truy cập vào những cookie đó</translation>
<translation id="7315780377187123731">Tìm hiểu thêm về lựa chọn Chặn cookie của bên thứ ba</translation>
<translation id="7374493521304367420">Các trang web vẫn có thể dùng cookie để xem hoạt động duyệt web trên trang web của mình</translation>
<translation id="7453144832830554937">Các tính năng của trang web dựa vào cookie của bên thứ ba có thể không hoạt động</translation>
<translation id="7538480403395139206">Tìm hiểu thêm về lựa chọn Cho phép cookie của bên thứ ba</translation>
<translation id="8200078544056087897">Các tính năng của trang web dựa vào cookie của bên thứ ba sẽ hoạt động như dự kiến</translation>
<translation id="839994149685752920">Các trang web có thể sử dụng cookie của bên thứ ba để cá nhân hoá nội dung và quảng cáo</translation>
<translation id="8428213095426709021">Cài đặt</translation>
<translation id="8712637175834984815">Tôi hiểu</translation>
<translation id="9039924186462989565">Khi bạn ở chế độ ẩn danh, Chromium sẽ chặn các trang web sử dụng cookie của bên thứ ba</translation>
<translation id="9162335340010958530">Các trang web không thể sử dụng cookie của bên thứ ba để cá nhân hoá nội dung và quảng cáo, cũng như tìm hiểu về thao tác bạn thực hiện trên các trang web khác, trừ phi bạn cho phép các trang web có liên quan truy cập vào những cookie đó</translation>
</translationbundle>