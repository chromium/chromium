<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1184166532603925201">عند استخدام "وضع التصفُّح المتخفي"، يحظر Chrome المواقع الإلكترونية من استخدام ملفات تعريف الارتباط الخارجية</translation>
<translation id="1559726735555610004">تطلب Google من الشركات أن تُصرح علانيةً بأنّها لن تستخدم هذه البيانات لتتبّع نشاطك على المواقع الإلكترونية. فقد تستخدم بعض المواقع الإلكترونية نشاطك لتخصيص تجربتك ليس فقط من أجل الإعلانات. وقد يتمّ دمج هذه البيانات أيضًا مع معلومات أخرى يعرفونها عنك. وتتحمل الشركات مسؤولية إعلامك بكيفية استخدامها لبياناتك. اطّلِع على <ph name="BEGIN_LINK" />سياسة الخصوصية<ph name="END_LINK" /> لمعرفة المزيد حول الطُرق التي تتّبعها Google لحماية بياناتك.</translation>
<translation id="1569440020357229235">عند استخدام "وضع التصفُّح المتخفي"، لا يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية. وإذا كان أحد المواقع الإلكترونية التي تعتمد على ملفات تعريف الارتباط هذه لا يعمل، يمكنك <ph name="BEGIN_LINK" />محاولة منح هذا الموقع الإلكتروني إذنًا مؤقتًا بالوصول إلى ملفات تعريف الارتباط الخارجية<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">تم تعديل إعدادات Chrome الحالية للسماح للمواقع الإلكترونية بالوصول إلى ملفات تعريف الارتباط الخارجية. ويمكنك تغيير هذا الإعداد متى شئت.</translation>
<translation id="2004697686368036666">قد لا تعمل الميزات على بعض المواقع الإلكترونية</translation>
<translation id="2183376768278472507">إذا كان الموقع الإلكتروني لا يعمل على النحو المتوقّع، يمكنك محاولة السماح بملفات تعريف الارتباط الخارجية له</translation>
<translation id="2235344399760031203">تم حظر ملفات تعريف الارتباط الخارجية</translation>
<translation id="2496115946829713659">يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية لتخصيص المحتوى والإعلانات والاطّلاع على الإجراءات التي تتخذها على المواقع الإلكترونية الأخرى</translation>
<translation id="3045333309254072201">عند استخدام "وضع التصفُّح المتخفي"، لا يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية. وإذا كان أحد المواقع الإلكترونية التي تعتمد على ملفات تعريف الارتباط هذه لا يعمل، يمكنك <ph name="START_LINK" />محاولة منح هذا الموقع الإلكتروني إذنًا مؤقتًا بالوصول إلى ملفات تعريف الارتباط الخارجية<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">من المفترض أن تعمل المواقع الإلكترونية التي تعتمد على ملفات تعريف الارتباط الخارجية على النحو المتوقّع</translation>
<translation id="3624583033347146597">يُرجى اختيار الإعدادات المفضّلة لملفات تعريف الارتباط الخارجية</translation>
<translation id="3918378745482005425">قد لا تعمل بعض الميزات. ولا يزال بإمكان المواقع الإلكترونية ذات الصلة استخدام ملفات تعريف الارتباط الخارجية.</translation>
<translation id="4009365983562022788">تطلب Google من الشركات أن تُصرح علانيةً بأنّها لن تستخدم هذه البيانات لتتبّع نشاطك على المواقع الإلكترونية. فقد تستخدم بعض المواقع الإلكترونية نشاطك لتخصيص تجربتك ليس فقط من أجل الإعلانات. وقد يتمّ دمج هذه البيانات أيضًا مع معلومات أخرى يعرفونها عنك. وتتحمل الشركات مسؤولية إعلامك بكيفية استخدامها لبياناتك. يمكنك الاطّلاع على مزيد من المعلومات من خلال <ph name="BEGIN_LINK1" />سياسة الخصوصية<ph name="LINK_END1" />.</translation>
<translation id="4278390842282768270">مسموح بها</translation>
<translation id="4412992751769744546">السماح بملفات تعريف الارتباط الخارجية</translation>
<translation id="4711259472133554310">يمكنك إضافة استثناءات في "الإعدادات" للسماح دائمًا لمواقع إلكترونية محدّدة باستخدام ملفات تعريف الارتباط الخارجية</translation>
<translation id="5117284457376555514">لا يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية لتخصيص المحتوى والإعلانات والاطّلاع على الإجراءات التي تتخذها على المواقع الإلكترونية الأخرى، إلا في حال السماح للمواقع الإلكترونية ذات الصلة بالوصول إليها وقد لا تعمل بعض ميزات الموقع الإلكتروني على النحو المتوقّع.</translation>
<translation id="5677928146339483299">محظورة</translation>
<translation id="6196640612572343990">حظر ملفات تعريف الارتباط الخارجية</translation>
<translation id="6308169245546905162">يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية للاطّلاع على الإجراءات التي تتخذها على المواقع الإلكترونية الأخرى</translation>
<translation id="6494210367693221285">تم تعديل إعدادات Chromium الحالية للسماح للمواقع الإلكترونية بالوصول إلى ملفات تعريف الارتباط الخارجية. ويمكنك تغيير هذا الإعداد متى شئت.</translation>
<translation id="6710025070089118043">لا يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية لتخصيص المحتوى والإعلانات والاطّلاع على الإجراءات التي تتخذها على المواقع الإلكترونية الأخرى، إلا في حال منح المواقع الإلكترونية ذات الصلة إذن الوصول إليها</translation>
<translation id="7315780377187123731">مزيد من المعلومات حول خيار "حظر ملفات تعريف الارتباط الخارجية"</translation>
<translation id="7374493521304367420">لا يزال بإمكان المواقع الإلكترونية استخدام ملفات تعريف الارتباط للاطّلاع على نشاط التصفُّح على الموقع الإلكتروني الخاص بكلٍ من تلك الملفات</translation>
<translation id="7453144832830554937">قد لا تعمل ميزات الموقع الإلكتروني التي تعتمد على ملفات تعريف الارتباط الخارجية</translation>
<translation id="7538480403395139206">مزيد من المعلومات حول خيار "السماح بملفات تعريف الارتباط الخارجية"</translation>
<translation id="8200078544056087897">من المفترض أن تعمل ميزات الموقع الإلكتروني التي تعتمد على ملفات تعريف الارتباط الخارجية على النحو المتوقّع</translation>
<translation id="839994149685752920">يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية لتخصيص المحتوى والإعلانات</translation>
<translation id="8428213095426709021">الإعدادات</translation>
<translation id="8712637175834984815">حسنًا</translation>
<translation id="9039924186462989565">عند استخدام "وضع التصفُّح المتخفي"، يمنع Chromium المواقع الإلكترونية من استخدام ملفات تعريف الارتباط الخارجية</translation>
<translation id="9162335340010958530">لا يمكن للمواقع الإلكترونية استخدام ملفات تعريف الارتباط الخارجية لتخصيص المحتوى والإعلانات والاطّلاع على الإجراءات التي تتخذها على المواقع الإلكترونية الأخرى، إلا في حال السماح للمواقع الإلكترونية ذات الصلة بالوصول إليها</translation>
</translationbundle>