<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1184166532603925201">როცა ინკოგნიტო რეჟიმში ხართ, Chrome ბლოკავს საიტების მიერ მესამე მხარის ქუქი-ჩანაწერების გამოყენებას</translation>
<translation id="1569440020357229235">როცა ინკოგნიტო რეჟიმში ხართ, საიტები ვერ გამოიყენებს მესამე მხარის ქუქი-ჩანაწერებს. თუ ამ ქუქი-ჩანაწერებზე დამოკიდებული საიტი არ მუშაობს, შეგიძლიათ, <ph name="BEGIN_LINK" />ცადოთ, ამ საიტს დროებითი წვდომა მისცეთ მესამე მხარის ქუქი-ჩანაწერებზე<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Chrome-ის თქვენი ამჟამინდელი პარამეტრები განახლდა და ვებსაიტებს მესამე მხარის ქუქი-ჩანაწერზე წვდომა მიენიჭათ. ამ პარამეტრის შეცვლა ნებისმიერ დროს შეგიძლიათ.</translation>
<translation id="2004697686368036666">ფუნქციებმა, შესაძლოა, არ იმუშაოს ზოგიერთ საიტზე</translation>
<translation id="2183376768278472507">თუ საიტი სათანადოდ არ იმუშავებს, შეგიძლიათ ცადოთ თქვენ მიერ მონახულებული კონკრეტული საიტისთვის მესამე მხარის ქუქი-ჩანაწერების დროებით დაშვება</translation>
<translation id="2235344399760031203">მესამე მხარის ქუქი-ჩანაწერები დაბლოკილია</translation>
<translation id="2496115946829713659">საიტებს შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება კონტენტისა და რეკლამების პერსონალიზებისთვის და თქვენ მიერ სხვა საიტებზე განხორციელებული მოქმედებების გასაცნობად</translation>
<translation id="3045333309254072201">როცა ინკოგნიტო რეჟიმში ხართ, საიტები ვერ გამოიყენებს მესამე მხარის ქუქი-ჩანაწერებს. თუ ამ ქუქი-ჩანაწერებზე დამოკიდებული საიტი არ მუშაობს, შეგიძლიათ, <ph name="START_LINK" />ცადოთ, ამ საიტს დროებითი წვდომა მისცეთ მესამე მხარის ქუქი-ჩანაწერებზე<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">საიტებმა, რომლებიც ეყრდნობა მესამე მხარის ქუქი-ჩანაწერებს, მოლოდინისამებრ უნდა იმუშაოს</translation>
<translation id="3624583033347146597">დააფიქსირეთ არჩევანი მესამე მხარის ქუქი-ჩანაწერებთან დაკავშირებით</translation>
<translation id="3918378745482005425">ზოგიერთმა ფუნქციამ, შესაძლოა, არ იმუშაოს. დაკავშირებული საიტები მაინც შეძლებს მესამე მხარის ქუქი-ჩანაწერების გამოყენებას.</translation>
<translation id="4278390842282768270">დაშვებულია</translation>
<translation id="4412992751769744546">მესამე მხარის ქუქი-ჩანაწერების დაშვება</translation>
<translation id="4711259472133554310">შეგიძლიათ, შექმნათ გამონაკლისები პარამეტრებში კონკრეტული საიტების მიერ მესამე მხარის ქუქი-ჩანაწერების ყოველთვის დასაშვებად</translation>
<translation id="5117284457376555514">საიტებს არ შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება კონტენტისა და რეკლამების პერსონალიზებისთვის და თქვენ მიერ სხვა საიტებზე განხორციელებული მოქმედებების გასაცნობად, თუ დაკავშირებულ საიტებს არ მისცემთ მათზე წვდომის უფლებას. საიტის ზოგიერთმა ფუნქციამ, შესაძლოა, მოლოდინისამებრ არ იმუშაოს.</translation>
<translation id="5677928146339483299">დაბლოკილია</translation>
<translation id="6196640612572343990">მესამე მხარის ქუქი-ჩანაწერების დაბლოკვა</translation>
<translation id="6308169245546905162">საიტებს შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება თქვენ მიერ სხვა საიტებზე განხორციელებული მოქმედებების გასაცნობად</translation>
<translation id="6494210367693221285">Chromium-ის თქვენი ამჟამინდელი პარამეტრები განახლდა და ვებსაიტებს მესამე მხარის ქუქი-ჩანაწერზე წვდომა მიენიჭათ. ამ პარამეტრის შეცვლა ნებისმიერ დროს შეგიძლიათ.</translation>
<translation id="6710025070089118043">საიტებს არ შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება კონტენტისა და რეკლამების პერსონალიზებისთვის და თქვენ მიერ სხვა საიტებზე განხორციელებული მოქმედებების გასაცნობად, თუ დაკავშირებულ საიტებს არ მისცემთ მათზე წვდომის უფლებას</translation>
<translation id="7315780377187123731">მეტი ინფორმაცია მესამე მხარის ქუქი-ჩანაწერების დაბლოკვის ვარიანტის შესახებ</translation>
<translation id="7374493521304367420">საიტებს მაინც შეუძლია ქუქი-ჩანაწერების გამოყენება თავიანთ საიტზე დათვალიერების აქტივობის სანახავად</translation>
<translation id="7453144832830554937">საიტის ფუნქციებმა, რომლებიც ეყრდნობა მესამე მხარის ქუქი-ჩანაწერებს, შესაძლოა, არ იმუშაოს</translation>
<translation id="7538480403395139206">მეტი ინფორმაცია მესამე მხარის ქუქი-ჩანაწერების დაშვების ვარიანტის შესახებ</translation>
<translation id="8200078544056087897">საიტის ფუნქციებმა, რომლებიც ეყრდნობა მესამე მხარის ქუქი-ჩანაწერებს, მოლოდინისამებრ უნდა იმუშაოს</translation>
<translation id="839994149685752920">საიტებს შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება კონტენტისა და რეკლამების პერსონალიზებისთვის</translation>
<translation id="8428213095426709021">პარამეტრები</translation>
<translation id="8712637175834984815">გასაგებია</translation>
<translation id="9039924186462989565">ინკოგნიტო რეჟიმში Chromium ბლოკავს საიტების მიერ მესამე მხარის ქუქი-ჩანაწერების გამოყენებას</translation>
<translation id="9162335340010958530">საიტებს არ შეუძლია მესამე მხარის ქუქი-ჩანაწერების გამოყენება კონტენტისა და რეკლამების პერსონალიზებისთვის და თქვენ მიერ სხვა საიტებზე განხორციელებული მოქმედებების გასაცნობად, თუ დაკავშირებულ საიტებს არ მისცემთ მათზე წვდომის უფლებას</translation>
