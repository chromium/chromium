<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="1184166532603925201">Жашыруун режимде Chrome үчүнчү тараптын cookie файлдарын колдонуусун бөгөттөйт</translation>
<translation id="1569440020357229235">Жашыруун режимде сайттар үчүнчү тараптын cookie файлдарын колдоно алышпайт. Эгер cookie файлдарды колдонгон сайт иштебей жатса, ал сайтка <ph name="BEGIN_LINK" />үчүнчү тараптын cookie файлдарына убактылуу колдонуу мүмкүнчүлүгүн берип көрсөңүз болот<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Учурдагы Chrome параметрлериңиз жаңыртылып, вебсайттарга үчүнчү тараптын cookie файлдарын колдонууга уруксат берилди. Бул параметрди каалаган убакта өзгөртө аласыз.</translation>
<translation id="2004697686368036666">Функциялар айрым сайттарда иштебеши мүмкүн</translation>
<translation id="2183376768278472507">Кайсы бир сайт иштебей жатса, ага үчүнчү тараптын cookie файлдарын колдонууга уруксат берип көрсөңүз болот.</translation>
<translation id="2235344399760031203">Үчүнчү тараптын cookie файлдары бөгөттөлгөн</translation>
<translation id="2496115946829713659">Сайттар мазмунду жана жарнамаларды жекечелештирүү жана башка сайттардагы жүрүм-турумуңуз жөнүндө билүү үчүн, үчүнчү тараптын cookie файлдарын колдоно алышат</translation>
<translation id="3045333309254072201">Жашыруун режимде сайттар үчүнчү тараптын cookie файлдарын колдоно алышпайт. Эгер cookie файлдарды колдонгон сайт иштебей жатса, ал сайтка <ph name="START_LINK" />үчүнчү тараптын cookie файлдарына убактылуу колдонуу мүмкүнчүлүгүн берип көрсөңүз болот<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">Үчүнчү тараптын cookie файлдары менен иштеген сайттын функциялары талапка ылайык иштеши керек</translation>
<translation id="3624583033347146597">Үчүнчү тараптын cookie файлынын параметрлерин тандаңыз</translation>
<translation id="3918378745482005425">Айрым функциялар иштебеши мүмкүн. Байланышкан сайттар үчүнчү тараптын cookie файлдарын колдоно бериши мүмкүн.</translation>
<translation id="4278390842282768270">Уруксат берилген</translation>
<translation id="4412992751769744546">Үчүнчү тараптын cookie файлдарына уруксат берүү</translation>
<translation id="4711259472133554310">Белгилүү бир сайттарга үчүнчү тараптын cookie файлдарын колдонууга ар дайым уруксат берүү үчүн, Параметрлерден өзгөчө шарттарды түзө аласыз</translation>
<translation id="5117284457376555514">Сиз байланышкан сайттарга уруксат бермейинче, сайттар мазмунду жана жарнамаларды жекечелештирүү жана башка сайттардагы жүрүм-турумуңуз жөнүндө билүү үчүн үчүнчү тараптын cookie файлдарын колдоно алышпайт. Сайттын айрым функциялары талапка ылайык иштебеши мүмкүн.</translation>
<translation id="5677928146339483299">Бөгөттөлгөн</translation>
<translation id="6196640612572343990">Үчүнчү тараптын cookie файлдары бөгөттөлсүн</translation>
<translation id="6308169245546905162">Сайттар үчүнчү тараптын cookie файлдары аркылуу башка сайттардагы жүрүм-турумуңузду көрө алышат</translation>
<translation id="6494210367693221285">Учурдагы Chromium параметрлериңиз жаңыртылып, вебсайттарга үчүнчү тараптын cookie файлдарын колдонууга уруксат берилди. Бул параметрди каалаган убакта өзгөртө аласыз.</translation>
<translation id="6710025070089118043">Сиз байланышкан сайттарга уруксат бермейинче, сайттар мазмунду жана жарнамаларды жекелештирүү жана башка сайттардагы жүрүм-турумуңуз жөнүндө билүү үчүн үчүнчү тараптын cookie файлдарын колдоно алышпайт</translation>
<translation id="7315780377187123731">"Үчүнчү тараптын cookie файлдары бөгөттөө" параметри жөнүндө көбүрөөк маалымат</translation>
<translation id="7374493521304367420">Сайттар cookie файлдары аркылуу сайтында көрүлгөн барактарды көрө беришет</translation>
<translation id="7453144832830554937">Үчүнчү тараптын cookie файлдарын колдонгон сайттын функциялары талапка ылайык иштебеши мүмкүн</translation>
<translation id="7538480403395139206">"Үчүнчү тараптын cookie файлдарына уруксат берүү" параметри жөнүндө көбүрөөк маалымат</translation>
<translation id="8200078544056087897">Үчүнчү тараптын cookie файлдарын колдонгон сайттагы функциялар талапка ылайык иштеши керек</translation>
<translation id="839994149685752920">Сайттар мазмунду жана жарнамаларды жекечелештирүү үчүн, үчүнчү тараптын cookie файлдарын колдоно алышат</translation>
<translation id="8428213095426709021">Параметрлер</translation>
<translation id="8712637175834984815">Түшүндүм</translation>
<translation id="9039924186462989565">Жашыруун режимде Chromium cайттарга үчүнчү тараптын cookie файлдарын колдонууга тыюу салат</translation>
<translation id="9162335340010958530">Сиз байланышкан сайттарга уруксат бермейинче, сайттар мазмунду жана жарнамаларды жекечелештирүү жана башка сайттардагы жүрүм-турумуңуз жөнүндө билүү үчүн үчүнчү тараптын cookie файлдарын колдоно алышпайт</translation>
</translationbundle>