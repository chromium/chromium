<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1184166532603925201">ನೀವು ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿರುವಾಗ, Chrome ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸದಂತೆ ಸೈಟ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತದೆ</translation>
<translation id="1559726735555610004">ಸೈಟ್‌ಗಳಾದ್ಯಂತ ನಿಮ್ಮನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಕಂಪನಿಗಳು ಈ ಡೇಟಾವನ್ನು ಬಳಸುವುದಿಲ್ಲ ಎಂದು ಸಾರ್ವಜನಿಕವಾಗಿ ಅವುಗಳು ಘೋಷಿಸಬೇಕೆಂದು Google ಬಯಸುತ್ತದೆ. ಕೆಲವು ಸೈಟ್‌ಗಳು ಆ್ಯಡ್‌ಗಳನ್ನು ಮಾತ್ರವಲ್ಲದೆ ನಿಮ್ಮ ಅನುಭವವನ್ನೂ ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ನಿಮ್ಮ ಚಟುವಟಿಕೆಯನ್ನು ಬಳಸಬಹುದು. ಅವುಗಳು ನಿಮ್ಮ ಕುರಿತು ಈಗಾಗಲೇ ಹೊಂದಿರುವ ಇತರ ಮಾಹಿತಿಯೊಂದಿಗೆ ಅದನ್ನು ಸಂಯೋಜಿಸಬಹುದು. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಕಂಪನಿಗಳು ಹೇಗೆ ಬಳಸುತ್ತವೆ ಎಂಬುದರ ಕುರಿತು ನಿಮಗೆ ತಿಳಿಸಲು ಅವುಗಳು ಜವಾಬ್ದಾರರಾಗಿರುತ್ತವೆ. ನಮ್ಮ <ph name="BEGIN_LINK" />ಗೌಪ್ಯತೆ ನೀತಿಯಲ್ಲಿ<ph name="END_LINK" /> ನಿಮ್ಮ ಡೇಟಾವನ್ನು Google ಹೇಗೆ ರಕ್ಷಿಸುತ್ತದೆ ಎಂಬುದರ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="1569440020357229235">ನೀವು ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿರುವಾಗ, ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಈ ಕುಕೀಗಳನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೈಟ್ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ನೀವು <ph name="BEGIN_LINK" />ಆ ಸೈಟ್‌ಗೆ ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳಿಗೆ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ತಾತ್ಕಾಲಿಕವಾಗಿ ಅನುಮತಿಸಲು ಪ್ರಯತ್ನಿಸಬಹುದು<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕಿಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ವೆಬ್‌ಸೈಟ್‌ಗಳಿಗೆ ಅನುವು ಮಾಡಿಕೊಡಲು ನಿಮ್ಮ ಪ್ರಸ್ತುತ Chrome ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗಿದೆ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="2004697686368036666">ಫೀಚರ್‌ಗಳು ಕೆಲವು ಸೈಟ್‌ಗಳಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸದಿರಬಹುದು</translation>
<translation id="2183376768278472507">ಒಂದು ಸೈಟ್ ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ನೀವು ಭೇಟಿ ನೀಡುತ್ತಿರುವ ನಿರ್ದಿಷ್ಟ ಸೈಟ್‌ಗಾಗಿ ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಲು ಪ್ರಯತ್ನಿಸಬಹುದು</translation>
<translation id="2235344399760031203">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ</translation>
<translation id="2496115946829713659">ಕಂಟೆಂಟ್‍ ಮತ್ತು ಆ್ಯಡ್‌ಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಮತ್ತು ನೀವು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ಏನು ಮಾಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="3045333309254072201">ನೀವು ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿರುವಾಗ, ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಈ ಕುಕೀಗಳನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೈಟ್ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ನೀವು <ph name="START_LINK" />ಆ ಸೈಟ್‌ಗೆ ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳಿಗೆ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ತಾತ್ಕಾಲಿಕವಾಗಿ ಅನುಮತಿಸಲು ಪ್ರಯತ್ನಿಸಬಹುದು<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೈಟ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು</translation>
<translation id="3624583033347146597">ನಿಮ್ಮ ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀ ಆದ್ಯತೆಗಳನ್ನು ಆರಿಸಿ</translation>
<translation id="3918378745482005425">ಕೆಲವು ಫೀಚರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸದಿರಬಹುದು. ಸಂಬಂಧಿತ ಸೈಟ್‌ಗಳು ಇನ್ನೂ ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="4009365983562022788">ಸೈಟ್‌ಗಳಾದ್ಯಂತ ನಿಮ್ಮನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಕಂಪನಿಗಳು ಈ ಡೇಟಾವನ್ನು ಬಳಸುವುದಿಲ್ಲ ಎಂದು ಸಾರ್ವಜನಿಕವಾಗಿ ಅವುಗಳು ಘೋಷಿಸಬೇಕೆಂದು Google ಬಯಸುತ್ತದೆ. ಕೆಲವು ಸೈಟ್‌ಗಳು ಆ್ಯಡ್‌ಗಳನ್ನು ಮಾತ್ರವಲ್ಲದೆ ನಿಮ್ಮ ಅನುಭವವನ್ನೂ ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ನಿಮ್ಮ ಚಟುವಟಿಕೆಯನ್ನು ಬಳಸಬಹುದು. ಅವುಗಳು ನಿಮ್ಮ ಕುರಿತು ಈಗಾಗಲೇ ಹೊಂದಿರುವ ಇತರ ಮಾಹಿತಿಯೊಂದಿಗೆ ಅದನ್ನು ಸಂಯೋಜಿಸಬಹುದು. ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಕಂಪನಿಗಳು ಹೇಗೆ ಬಳಸುತ್ತವೆ ಎಂಬುದರ ಕುರಿತು ನಿಮಗೆ ತಿಳಿಸಲು ಅವುಗಳು ಜವಾಬ್ದಾರರಾಗಿರುತ್ತವೆ. ನಮ್ಮ <ph name="BEGIN_LINK1" />ಗೌಪ್ಯತೆ ನೀತಿಯಲ್ಲಿ<ph name="LINK_END1" /> ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ.</translation>
<translation id="4278390842282768270">ಅನುಮತಿಸಲಾಗಿದೆ</translation>
<translation id="4412992751769744546">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="4711259472133554310">ನಿರ್ದಿಷ್ಟ ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಲು ಯಾವಾಗಲೂ ಅನುಮತಿಸಲು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ವಿನಾಯಿತಿಗಳನ್ನು ರಚಿಸಬಹುದು</translation>
<translation id="5117284457376555514">ಸಂಬಂಧಿತ ಸೈಟ್‌ಗಳು ಅವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ನೀವು ಅನುಮತಿಸದ ಹೊರತು, ಕಂಟೆಂಟ್‌ ಮತ್ತು ಆ್ಯಡ್‌ಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಮತ್ತು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸುವಂತಿಲ್ಲ. ಕೆಲವು ಸೈಟ್ ಫೀಚರ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು.</translation>
<translation id="5677928146339483299">ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ</translation>
<translation id="6196640612572343990">ಥರ್ಡ್ ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ನಿರ್ಬಂಧಿಸಿ</translation>
<translation id="6308169245546905162">ನೀವು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ತೆಗೆದುಕೊಳ್ಳುವ ಕ್ರಮಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6494210367693221285">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕಿಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ವೆಬ್‌ಸೈಟ್‌ಗಳಿಗೆ ಅನುವು ಮಾಡಿಕೊಡಲು ನಿಮ್ಮ ಪ್ರಸ್ತುತ Chromium ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗಿದೆ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="6710025070089118043">ಸಂಬಂಧಿತ ಸೈಟ್‌ಗಳು ಅವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ನೀವು ಅನುಮತಿ ನೀಡದ ಹೊರತು, ಕಂಟೆಂಟ್‌ ಮತ್ತು ಆ್ಯಡ್‌ಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಮತ್ತು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸುವಂತಿಲ್ಲ</translation>
<translation id="7315780377187123731">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ನಿರ್ಬಂಧಿಸುವ ಆಯ್ಕೆಯ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿ</translation>
<translation id="7374493521304367420">ಸೈಟ್‌ಗಳು ತಮ್ಮದೇ ಆದ ಸೈಟ್‌ನಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಚಟುವಟಿಕೆಯನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಇನ್ನೂ ಕುಕೀಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="7453144832830554937">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೈಟ್ ಫೀಚರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸದಿರಬಹುದು</translation>
<translation id="7538480403395139206">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸುವ ಆಯ್ಕೆಯ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿ</translation>
<translation id="8200078544056087897">ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೈಟ್ ಫೀಚರ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು</translation>
<translation id="839994149685752920">ಕಂಟೆಂಟ್‌ ಮತ್ತು ಆ್ಯಡ್‌ಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="8428213095426709021">ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="8712637175834984815">ಅರ್ಥವಾಯಿತು</translation>
<translation id="9039924186462989565">ನೀವು ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿರುವಾಗ, Chromium ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸದಂತೆ ಸೈಟ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತದೆ</translation>
<translation id="9162335340010958530">ಸಂಬಂಧಿತ ಸೈಟ್‌ಗಳು ಅವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ನೀವು ಅನುಮತಿಸದ ಹೊರತು, ಕಂಟೆಂಟ್‌ ಮತ್ತು ಆ್ಯಡ್‌ಗಳನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು ಮತ್ತು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಕ್ರಿಯೆಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸೈಟ್‌ಗಳು ಥರ್ಡ್-ಪಾರ್ಟಿ ಕುಕೀಗಳನ್ನು ಬಳಸುವಂತಿಲ್ಲ</translation>
