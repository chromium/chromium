<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1184166532603925201">Таныг Нууцлалын горимд байхад Chrome сайтыг гуравдагч талын күүкиг ашиглахыг блоклоно</translation>
<translation id="1569440020357229235">Таныг Нууцлалын горимд байхад сайт гуравдагч талын күүкиг ашиглах боломжгүй. Хэрэв эдгээр күүкид тулгуурладаг сайт ажиллахгүй байвал та <ph name="BEGIN_LINK" />тухайн сайтад түр зуур гуравдагч талын күүкид хандах эрх өгч үзэх<ph name="END_LINK" /> боломжтой.</translation>
<translation id="19426210786412737">Вебсайтад гуравдагч талын күүкид хандахыг зөвшөөрөхийн тулд таны одоогийн Chrome-н тохиргоог шинэчилсэн. Та хүссэн үедээ энэ тохиргоог өөрчлөх боломжтой.</translation>
<translation id="2004697686368036666">Зарим сайт дээрх онцлог ажиллахгүй байж магадгүй</translation>
<translation id="2183376768278472507">Хэрэв сайт зохих ёсоор ажиллахгүй байвал та зочилдог тодорхой сайтдаа гуравдагч талын күүкиг зөвшөөрч үзэж болно</translation>
<translation id="2235344399760031203">Гуравдагч талын күүкиг блоклосон</translation>
<translation id="2496115946829713659">Сайт гуравдагч талын күүкиг ашиглан контент, зарыг хувийн болгох, таны бусад сайт дээр хийсэн үйлдлийн талаар мэдэж авах боломжтой</translation>
<translation id="3045333309254072201">Таныг Нууцлалын горимд байхад сайт гуравдагч талын күүкиг ашиглах боломжгүй. Хэрэв эдгээр күүкид тулгуурладаг сайт ажиллахгүй байвал та <ph name="START_LINK" />тухайн сайтад түр зуур гуравдагч талын күүкид хандах эрх өгч үзэх<ph name="END_LINK" /> боломжтой.</translation>
<translation id="3425311689852411591">Гуравдагч талын күүкид тулгуурладаг сайт зохих ёсоор ажиллах ёстой</translation>
<translation id="3624583033347146597">Гуравдагч талын күүкиний тохиргоогоо сонгоно уу</translation>
<translation id="3918378745482005425">Зарим онцлог ажиллахгүй байж магадгүй. Холбоотой сайт гуравдагч талын күүки ашиглах боломжтой хэвээр байна.</translation>
<translation id="4278390842282768270">Зөвшөөрсөн</translation>
<translation id="4412992751769744546">Гуравдагч талын күүкиг зөвшөөрөх</translation>
<translation id="4711259472133554310">Та тодорхой сайтыг гуравдагч талын күүкиг ашиглахыг үргэлж зөвшөөрөхийн тулд Тохиргооноос онцгой тохиолдол үүсгэх боломжтой</translation>
<translation id="5117284457376555514">Та холбогдох сайтад хандахыг зөвшөөрөөгүй бол сайт контент, зарыг хувийн болгох, таны бусад сайт дээр хийсэн үйлдлийн талаар мэдэж авахад гуравдагч талын күүкиг ашиглах боломжгүй. Зарим сайтын онцлог зохих ёсоор ажиллахгүй байж магадгүй.</translation>
<translation id="5677928146339483299">Блоклосон</translation>
<translation id="6196640612572343990">Гуравдагч талын күүкиг блоклох</translation>
<translation id="6308169245546905162">Сайт гуравдагч талын күүкиг ашиглан таны бусад сайт дээр хийсэн үйлдлийн талаар мэдэж авах боломжтой</translation>
<translation id="6494210367693221285">Вебсайтад гуравдагч талын күүкид хандахыг зөвшөөрөхийн тулд таны одоогийн Chromium-н тохиргоог шинэчилсэн. Та хүссэн үедээ энэ тохиргоог өөрчлөх боломжтой.</translation>
<translation id="6710025070089118043">Та холбогдох сайтад хандахыг зөвшөөрөөгүй бол сайт контент, зарыг хувийн болгох, таны бусад сайт дээр хийсэн үйлдлийн талаар мэдэж авахад гуравдагч талын күүкиг ашиглах боломжгүй</translation>
<translation id="7315780377187123731">Гуравдагч талын күүкиг блоклох сонголтын талаар мэдэж авна уу</translation>
<translation id="7374493521304367420">Сайт өөрийн сайт дээрх хөтчийн үйл ажиллагааг харахын тулд күүки ашиглах боломжтой хэвээр байна</translation>
<translation id="7453144832830554937">Гуравдагч талын күүкид тулгуурладаг сайтын онцлог ажиллахгүй байж магадгүй</translation>
<translation id="7538480403395139206">Гуравдагч талын күүкиг зөвшөөрөх сонголтын талаар мэдэж авна уу</translation>
<translation id="8200078544056087897">Гуравдагч талын күүкид тулгуурладаг сайтын онцлог зохих ёсоор ажиллах ёстой</translation>
<translation id="839994149685752920">Сайт гуравдагч талын күүкиг ашиглан контент, зарыг хувийн болгох боломжтой</translation>
<translation id="8428213095426709021">Тохиргоо</translation>
<translation id="8712637175834984815">Ойлголоо</translation>
<translation id="9039924186462989565">Таныг Нууцлалын горимд байхад Chromium сайтыг гуравдагч талын күүки ашиглахыг блоклоно</translation>
<translation id="9162335340010958530">Та холбогдох сайтад хандахыг зөвшөөрөөгүй бол сайт контент, зарыг хувийн болгох, таны бусад сайт дээр хийсэн үйлдлийн талаар мэдэж авахад гуравдагч талын күүкиг ашиглах боломжгүй</translation>
</translationbundle>