<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1184166532603925201">وقتی در «حالت ناشناس» هستید، Chrome اجازه استفاده از کوکی‌های طرف سوم را به سایت‌ها نمی‌دهد</translation>
<translation id="1569440020357229235">وقتی در «حالت ناشناس» هستید، سایت‌ها نمی‌توانند از کوکی‌های طرف سوم استفاده کنند. اگر سایتی که به این کوکی‌ها متکی است کار نمی‌کند، می‌توانید <ph name="BEGIN_LINK" />به آن سایت اجازه دهید موقتاً به کوکی‌های طرف سوم دسترسی داشته باشد<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">تنظیمات فعلی Chrome به‌روز شدند تا وب‌سایت‌ها بتوانند به کوکی‌های طرف سوم دسترسی پیدا کنند. هروقت خواستید می‌توانید این تنظیم را تغییر دهید.</translation>
<translation id="2004697686368036666">ممکن است ویژگی‌های برخی‌از سایت‌ها کار نکنند</translation>
<translation id="2183376768278472507">اگر سایتی طبق انتظارتان کار نمی‌کند، می‌توانید به کوکی‌های طرف سوم برای آن سایت خاص اجازه دهید</translation>
<translation id="2235344399760031203">کوکی‌های طرف سوم مسدود شده‌اند</translation>
<translation id="2496115946829713659">سایت‌ها می‌توانند از کوکی‌های طرف سوم برای شخصی‌سازی محتوا و آگهی‌ها استفاده کنند و از کنش‌هایی که در سایت‌های دیگر انجام می‌دهید مطلع شوند</translation>
<translation id="3045333309254072201">وقتی در «حالت ناشناس» هستید، سایت‌ها نمی‌توانند از کوکی‌های طرف سوم استفاده کنند. اگر سایتی که به این کوکی‌ها متکی است کار نمی‌کند، می‌توانید <ph name="START_LINK" />به آن سایت اجازه دهید موقتاً به کوکی‌های طرف سوم دسترسی داشته باشد<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">سایت‌هایی که به کوکی‌های طرف سوم متکی هستند باید طبق انتظار کار کنند</translation>
<translation id="3624583033347146597">انتخاب اولویت‌های کوکی طرف سوم</translation>
<translation id="3918378745482005425">ممکن است برخی‌از ویژگی‌ها کار نکنند. سایت‌های مربوطه همچنان می‌توانند از کوکی‌های طرف سوم استفاده کنند.</translation>
<translation id="4278390842282768270">اجازه داشتن</translation>
<translation id="4412992751769744546">اجازه به کوکی‌های طرف سوم</translation>
<translation id="4711259472133554310">می‌توانید استثناهایی در «تنظیمات» تعریف کنید تا سایت‌های مشخصی برای استفاده از کوکی‌های طرف سوم همیشه اجازه داشته باشند.</translation>
<translation id="5117284457376555514">سایت‌ها نمی‌توانند از کوکی‌های طرف سوم برای شخصی‌سازی محتوا و آگهی‌ها و همچنین مطلع شدن از کنش‌های شما در سایت‌های دیگر استفاده کنند، مگر اینکه به سایت‌های مربوطه اجازه دسترسی به آن‌ها را بدهید. ممکن است برخی‌از ویژگی‌های سایت طبق انتظار کار نکند.</translation>
<translation id="5677928146339483299">مسدودشده</translation>
<translation id="6196640612572343990">مسدود کردن کوکی‌های طرف سوم</translation>
<translation id="6308169245546905162">سایت‌ها می‌توانند از کوکی‌های طرف سوم برای مطلع شدن از کنش‌هایی که در سایت‌های دیگر انجام می‌دهید استفاده کنند</translation>
<translation id="6494210367693221285">تنظیمات فعلی Chromium به‌روز شدند تا وب‌سایت‌ها بتوانند به کوکی‌های طرف سوم دسترسی پیدا کنند. هروقت خواستید می‌توانید این تنظیم را تغییر دهید.</translation>
<translation id="6710025070089118043">سایت‌ها نمی‌توانند از کوکی‌های طرف سوم برای شخصی‌سازی محتوا و آگهی‌ها و همچنین مطلع شدن از کنش‌های شما در سایت‌های دیگر استفاده کنند، مگر اینکه به سایت‌های مربوطه اجازه دسترسی به آن‌ها را بدهید</translation>
<translation id="7315780377187123731">اطلاعات بیشتر درباره گزینه «مسدود کردن کوکی‌های طرف سوم»</translation>
<translation id="7374493521304367420">سایت‌ها همچنان می‌توانند از کوکی‌ها برای دیدن فعالیت مرور در سایت خود استفاده کنند</translation>
<translation id="7453144832830554937">ممکن است آن دسته از ویژگی‌های سایت که به کوکی‌های طرف سوم متکی هستند کار نکنند</translation>
<translation id="7538480403395139206">اطلاعات بیشتر درباره گزینه «اجازه به کوکی‌های طرف سوم»</translation>
<translation id="8200078544056087897">آن دسته از ویژگی‌های سایت که به کوکی‌های طرف سوم متکی هستند باید طبق انتظار کار کنند</translation>
<translation id="839994149685752920">سایت‌ها می‌توانند از کوکی‌های طرف سوم برای شخصی‌سازی محتوا و آگهی‌ها استفاده کنند</translation>
<translation id="8428213095426709021">تنظیمات</translation>
<translation id="8712637175834984815">متوجهم</translation>
<translation id="9039924186462989565">وقتی در «حالت ناشناس» هستید، Chromium اجازه استفاده از کوکی‌های طرف سوم را به سایت‌ها نمی‌دهد</translation>
<translation id="9162335340010958530">سایت‌ها نمی‌توانند از کوکی‌های طرف سوم برای شخصی‌سازی محتوا و آگهی‌ها و همچنین مطلع شدن از کنش‌های شما در سایت‌های دیگر استفاده کنند، مگر اینکه به سایت‌های مربوطه اجازه دهید به آن‌ها دسترسی داشته باشند</translation>
</translationbundle>