<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="1184166532603925201">នៅពេលអ្នក​ស្ថិតនៅក្នុងមុខងារ​ឯកជន Chrome ​ទប់ស្កាត់គេហទំព័រមិនឱ្យប្រើខូគី​ភាគីទីបី</translation>
<translation id="1569440020357229235">នៅពេលអ្នក​ស្ថិតនៅក្នុងមុខងារ​ឯកជន គេហទំព័រមិនអាចប្រើខូគី​ភាគីទីបីបានទេ។ ប្រសិនបើគេហទំព័រដែលពឹងផ្អែកលើខូគីទាំងនេះមិនដំណើរការទេ អ្នកអាច<ph name="BEGIN_LINK" />សាកល្បងផ្ដល់ឱ្យគេហទំព័រនោះនូវសិទ្ធិចូលប្រើខូគីភាគីទីបីជាបណ្ដោះអាសន្ន<ph name="END_LINK" />។</translation>
<translation id="19426210786412737">ការកំណត់ Chrome បច្ចុប្បន្នរបស់អ្នកត្រូវបានធ្វើបច្ចុប្បន្នភាព ដើម្បីអនុញ្ញាតឱ្យគេហទំព័រចូលប្រើខូគីភាគីទីបី។ អ្នកអាចផ្លាស់ប្ដូរការកំណត់នេះពេលណាក៏បាន។</translation>
<translation id="2004697686368036666">មុខងារ​នៅលើ​គេហទំព័រ​មួយចំនួន​អាចមិនដំណើរការទេ</translation>
<translation id="2183376768278472507">ប្រសិនបើគេហទំព័រមិនដំណើរការដូចការរំពឹងទុកទេ អ្នកអាចសាកល្បងអនុញ្ញាតខូគី​ភាគីទីបីសម្រាប់គេហទំព័រជាក់លាក់ដែលអ្នកចូលមើល</translation>
<translation id="2235344399760031203">ខូគី​ភាគី​ទីបីត្រូវបាន​ទប់ស្កាត់</translation>
<translation id="2496115946829713659">គេហទំព័រអាចប្រើខូគី​ភាគីទីបី ដើម្បីកំណត់ខ្លឹមសារ និងការផ្សាយពាណិជ្ជកម្មឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងស្វែងយល់អំពីសកម្មភាពដែលអ្នកធ្វើនៅលើគេហទំព័រផ្សេងទៀត</translation>
<translation id="3045333309254072201">នៅពេលអ្នក​ស្ថិតនៅក្នុងមុខងារ​ឯកជន គេហទំព័រមិនអាចប្រើខូគី​ភាគីទីបីបានទេ។ ប្រសិនបើគេហទំព័រដែលពឹងផ្អែកលើខូគីទាំងនេះមិនដំណើរការទេ អ្នកអាច<ph name="START_LINK" />សាកល្បងផ្ដល់ឱ្យគេហទំព័រនោះនូវសិទ្ធិចូលប្រើខូគីភាគីទីបីជាបណ្ដោះអាសន្ន<ph name="END_LINK" />។</translation>
<translation id="3425311689852411591">គេហទំព័រ​ដែលពឹងផ្អែកលើខូគី​ភាគីទីបីគួរតែដំណើរការដូចការរំពឹងទុក</translation>
<translation id="3624583033347146597">ជ្រើសរើសចំណូលចិត្តខូគី​ភាគីទីបីរបស់អ្នក</translation>
<translation id="3918378745482005425">មុខងារ​មួយចំនួន​ប្រហែល​​​​មិន​​ដំណើរការ​ទេ។ គេហទំព័រ​ដែល​ពាក់ព័ន្ធ​នៅ​តែ​អាច​ប្រើ​ខូគី​ភាគីទីបីបាន។</translation>
<translation id="4278390842282768270">បាន​អនុញ្ញាត</translation>
<translation id="4412992751769744546">អនុញ្ញាតខូគី​ភាគីទីបី</translation>
<translation id="4711259472133554310">អ្នកអាចបង្កើតការលើកលែងនៅក្នុងការកំណត់ ដើម្បីអនុញ្ញាតឱ្យគេហទំព័រជាក់លាក់ប្រើប្រាស់ខូគី​ភាគីទីបីបានជានិច្ច</translation>
<translation id="5117284457376555514">គេហទំព័រមិនអាចប្រើខូគី​ភាគីទីបី ដើម្បីកំណត់ខ្លឹមសារ និងការផ្សាយពាណិជ្ជកម្មឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងស្វែងយល់អំពីសកម្មភាពដែលអ្នកធ្វើនៅលើគេហទំព័រផ្សេងទៀតបានទេ ប្រសិនបើអ្នកមិនអនុញ្ញាតឱ្យគេហទំព័រដែលពាក់ព័ន្ធចូលប្រើខូគី​ភាគីទីបីទាំងនោះទេ។ មុខងារ​គេហទំព័រ​ប្រហែលជាមិន​ដំណើរការ​ដូចការរំពឹងទុក​ទេ។</translation>
<translation id="5677928146339483299">បាន​ទប់ស្កាត់</translation>
<translation id="6196640612572343990">​ទប់ស្កាត់​ខូគី​ភាគី​ទីបី</translation>
<translation id="6308169245546905162">គេហទំព័រអាចប្រើខូគី​ភាគីទីបី ដើម្បីស្វែងយល់អំពីសកម្មភាពដែលអ្នកធ្វើនៅលើគេហទំព័រផ្សេងទៀត</translation>
<translation id="6494210367693221285">ការកំណត់ Chromium បច្ចុប្បន្នរបស់អ្នកត្រូវបានធ្វើបច្ចុប្បន្នភាព ដើម្បីអនុញ្ញាតឱ្យគេហទំព័រចូលប្រើខូគីភាគីទីបី។ អ្នកអាចផ្លាស់ប្ដូរការកំណត់នេះពេលណាក៏បាន។</translation>
<translation id="6710025070089118043">គេហទំព័រមិនអាចប្រើខូគី​ភាគីទីបី ដើម្បីកំណត់ខ្លឹមសារ និងការផ្សាយពាណិជ្ជកម្មឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងស្វែងយល់អំពីសកម្មភាពដែលអ្នកធ្វើនៅលើគេហទំព័រផ្សេងទៀតបានទេ ប្រសិនបើអ្នកមិនផ្ដល់ឱ្យ​គេហទំព័រដែលពាក់ព័ន្ធនូវសិទ្ធិ​ចូល​ប្រើខូគីភាគីទីបីទាំងនោះទេ</translation>
<translation id="7315780377187123731">ព័ត៌មានបន្ថែមអំពីជម្រើស "​ទប់ស្កាត់ខូគី​ភាគីទីបី"</translation>
<translation id="7374493521304367420">គេហទំព័រនៅតែអាចប្រើខូគី ដើម្បីមើលសកម្មភាព​រុករក​តាមអ៊ីនធឺណិតនៅលើគេហទំព័ររបស់វាផ្ទាល់</translation>
<translation id="7453144832830554937">មុខងារ​គេហទំព័រ​ដែលពឹងផ្អែកលើខូគី​ភាគីទីបីប្រហែលជាមិន​ដំណើរការ​ទេ</translation>
<translation id="7538480403395139206">ព័ត៌មានបន្ថែមអំពីជម្រើស "អនុញ្ញាតខូគី​ភាគីទីបី"</translation>
<translation id="8200078544056087897">មុខងារ​គេហទំព័រ​ដែលពឹងផ្អែកលើខូគី​ភាគីទីបីគួរតែដំណើរការដូចការរំពឹងទុក</translation>
<translation id="839994149685752920">គេហទំព័រអាចប្រើខូគី​ភាគីទីបី ដើម្បីកំណត់ខ្លឹមសារ និងការផ្សាយពាណិជ្ជកម្មឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន</translation>
<translation id="8428213095426709021">ការកំណត់</translation>
<translation id="8712637175834984815">យល់ហើយ</translation>
<translation id="9039924186462989565">នៅពេលអ្នក​ស្ថិតនៅក្នុងមុខងារ​ឯកជន Chromium ទប់ស្កាត់គេហទំព័រមិនឱ្យប្រើខូគី​ភាគីទីបី</translation>
<translation id="9162335340010958530">គេហទំព័រមិនអាចប្រើខូគី​ភាគីទីបី ដើម្បីកំណត់ខ្លឹមសារ និងការផ្សាយពាណិជ្ជកម្មឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងស្វែងយល់អំពីសកម្មភាពដែលអ្នកធ្វើនៅលើគេហទំព័រផ្សេងទៀតបានទេ ប្រសិនបើអ្នកមិនអនុញ្ញាតឱ្យគេហទំព័រដែលពាក់ព័ន្ធចូលប្រើខូគី​ភាគីទីបីទាំងនោះទេ</translation>
</translationbundle>