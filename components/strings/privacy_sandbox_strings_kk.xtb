<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1184166532603925201">Инкогнито режимінде болған кезде, Chrome сайттардағы үшінші тарап cookie файлдарын блоктайды.</translation>
<translation id="1559726735555610004">Google басқа компаниялардан бұл деректерді сайттарда пайдаланушыларды бақылау үшін қолданбайтынын ашық мәлімдеуді талап етеді. Кейбір сайттар сіздің пайдалану тарихыңызды тек жарнаманы ғана емес, өз контентін де қалауыңызға қарай жекелендіру мақсатында қолдануы мүмкін. Сондай-ақ олар оны сіз туралы білетін басқа да ақпаратпен біріктіруі мүмкін. Компаниялар деректеріңізді қалай пайдаланатыны туралы сізді хабардар етуге міндетті. Google-дың деректерді қалай қорғайтыны туралы толық ақпаратты <ph name="BEGIN_LINK" />Құпиялық саясатымыздан<ph name="END_LINK" /> алыңыз.</translation>
<translation id="1569440020357229235">Инкогнито режимінде болған кезде, сайттар үшінші тарап cookie файлдарын пайдалана алмайды. Осы cookie файлдарын пайдаланатын сайт жұмыс істемесе, <ph name="BEGIN_LINK" />оған үшінші тарап cookie файлдарын уақытша пайдалануға рұқсат беріп көріңіз<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Веб-сайттарға үшінші тарап cookie файлдарын пайдалануға рұқсат ету үшін қолданыстағы Chrome параметрлері жаңартылды. Бұл параметрлерді кез келген уақытта өзгертуге болады.</translation>
<translation id="2004697686368036666">Кейбір сайттардың функциялары жұмыс істемеуі мүмкін.</translation>
<translation id="2183376768278472507">Сайт ойдағыдай істемесе, белгілі бір кірген сайт үшін үшінші тарап cookie файлдарына рұқсат беріп көре аласыз.</translation>
<translation id="2235344399760031203">Үшінші тарап cookie файлдары блокталды</translation>
<translation id="2496115946829713659">Сайттар контент пен жарнаманы жекелендіру үшін, сондай-ақ басқа сайттардағы әрекеттеріңіз туралы білу үшін үшінші тарап cookie файлдарын пайдалануы мүмкін.</translation>
<translation id="3045333309254072201">Инкогнито режимінде болған кезде, сайттар үшінші тарап cookie файлдарын пайдалана алмайды. Осы cookie файлдарын пайдаланатын сайт жұмыс істемесе, <ph name="START_LINK" />оған үшінші тарап cookie файлдарын уақытша пайдалануға рұқсат беріп көріңіз<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">Үшінші тарап cookie файлдарын пайдаланатын сайттар ойдағыдай жұмыс істеуі керек.</translation>
<translation id="3624583033347146597">Үшінші тарап cookie файлының параметрлерін таңдаңыз</translation>
<translation id="3918378745482005425">Кейбір функциялар жұмыс істемеуі мүмкін. Қатысты сайттарда әлі де үшінші тарап cookie файлдары пайдаланылуы мүмкін.</translation>
<translation id="4009365983562022788">Google басқа компаниялардан бұл деректерді сайттарда пайдаланушыларды бақылау үшін қолданбайтынын ашық мәлімдеуді талап етеді. Кейбір сайттар сіздің пайдалану тарихыңызды тек жарнаманы ғана емес, өз контентін де қалауыңызға қарай жекелендіру мақсатында қолдануы мүмкін. Сондай-ақ олар оны сіз туралы білетін басқа да ақпаратпен біріктіруі мүмкін. Компаниялар деректеріңізді қалай пайдаланатыны туралы сізді хабардар етуге міндетті. <ph name="BEGIN_LINK1" />Құпиялық саясатымыздан<ph name="LINK_END1" /> толық ақпарат алыңыз.</translation>
<translation id="4278390842282768270">Рұқсат етілген</translation>
<translation id="4412992751769744546">Үшінші тарап cookie файлдарына рұқсат беру</translation>
<translation id="4711259472133554310">Белгілі бір сайттарға үшінші тарап cookie файлдарын пайдалануға әрқашан рұқсат ету үшін параметрлерде ерекше жағдайлар жасай аласыз.</translation>
<translation id="5117284457376555514">Сайттар контент пен жарнаманы жекелендіру үшін, сондай-ақ қатысты сайттарға рұқсат бермейінше, басқа сайттардағы әрекеттеріңіз туралы білу үшін үшінші тарап cookie файлдарын пайдалана алмайды. Кейбір сайт функциялары ойдағыдай жұмыс істемеуі мүмкін.</translation>
<translation id="5677928146339483299">Тыйым салынған</translation>
<translation id="6196640612572343990">Үшінші тарап cookie файлдарын блоктау</translation>
<translation id="6308169245546905162">Сайттар сіздің басқа сайттардағы әрекеттеріңіз туралы білу үшін үшінші тарап cookie файлдарын пайдалануы мүмкін.</translation>
<translation id="6494210367693221285">Веб-сайттарға үшінші тарап cookie файлдарын пайдалануға рұқсат ету үшін қолданыстағы Chromium параметрлері жаңартылды. Бұл параметрлерді кез келген уақытта өзгертуге болады.</translation>
<translation id="6710025070089118043">Сайттар контент пен жарнаманы жекелендіру үшін, сондай-ақ қатысты сайттарға рұқсат бермейінше, басқа сайттардағы әрекеттеріңіз туралы білу үшін үшінші тарап cookie файлдарын пайдалана алмайды.</translation>
<translation id="7315780377187123731">Үшінші тарап cookie файлдарын блоктау опциясы туралы толық ақпарат</translation>
<translation id="7374493521304367420">Сайттар сіздің сол сайттардағы браузерді пайдалану тарихыңызды көру үшін cookie файлдарын бұрынғыша пайдалана алады.</translation>
<translation id="7453144832830554937">Үшінші тарап cookie файлдарын пайдаланатын сайттар жұмыс істемеуі мүмкін.</translation>
<translation id="7538480403395139206">Үшінші тарап cookie файлдарына рұқсат беру опциясы туралы толық ақпарат</translation>
<translation id="8200078544056087897">Үшінші тарап cookie файлдарын пайдаланатын сайт функциялары ойдағыдай жұмыс істеуі керек.</translation>
<translation id="839994149685752920">Сайттар контент пен жарнаманы жекелендіру үшін үшінші тарап cookie файлдарын пайдалануы мүмкін.</translation>
<translation id="8428213095426709021">Параметрлер</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="9039924186462989565">Инкогнито режимінде болған кезде, Chromium сайттардағы үшінші тарап cookie файлдарын блоктайды.</translation>
<translation id="9162335340010958530">Сайттар контент пен жарнаманы жекелендіру үшін, сондай-ақ қатысты сайттарға рұқсат бермейінше, басқа сайттардағы әрекеттеріңіз туралы білу үшін үшінші тарап cookie файлдарын пайдалана алмайды.</translation>
</translationbundle>