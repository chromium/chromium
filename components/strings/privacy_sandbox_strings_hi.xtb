<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="1184166532603925201">गुप्त मोड में Chrome, साइटों को तीसरे पक्ष की कुकी इस्तेमाल करने से रोकता है</translation>
<translation id="1559726735555610004">Google, कंपनियों से सार्वजनिक तौर पर यह बताने के लिए कहता है कि वे इस डेटा का इस्तेमाल, अलग-अलग साइटों पर आपकी गतिविधि को ट्रैक करने के लिए नहीं करेंगी. कुछ साइटें आपकी गतिविधि का इस्तेमाल, सिर्फ़ दिलचस्पी के हिसाब से विज्ञापन दिखाने के लिए ही नहीं, बल्कि अन्य चीज़ों के लिए भी कर सकती हैं, ताकि आपको बेहतर अनुभव मिले. वे इस जानकारी को, आपके बारे में पहले से मौजूद अन्य जानकारी के साथ जोड़ सकती हैं. आपको यह बताना कंपनियों की ज़िम्मेदारी है कि वे आपके डेटा का इस्तेमाल कैसे करती हैं. Google आपके डेटा की सुरक्षा कैसे करता है, इस बारे में ज़्यादा जानने के लिए हमारी <ph name="BEGIN_LINK" />निजता नीति<ph name="END_LINK" /> पढ़ें.</translation>
<translation id="1569440020357229235">गुप्त मोड में ब्राउज़ करने पर, साइटें तीसरे पक्ष की कुकी का इस्तेमाल नहीं कर सकतीं. अगर इन कुकी का इस्तेमाल करने वाली कोई साइट काम नहीं करती है, तो <ph name="BEGIN_LINK" />उस साइट को कुछ समय के लिए, तीसरे पक्ष की कुकी का ऐक्सेस दें<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Chrome की आपकी मौजूदा सेटिंग को अपडेट कर दिया गया है. इससे सभी वेबसाइट तीसरे पक्ष की कुकी ऐक्सेस कर पाएंगी. इस सेटिंग को कभी भी बदला जा सकता है.</translation>
<translation id="2004697686368036666">ऐसा हो सकता है कि कुछ साइटों पर खास सुविधाएं काम न करें</translation>
<translation id="2183376768278472507">अगर कोई साइट उम्मीद के मुताबिक काम नहीं करती है, तो आपके पास उस साइट के लिए तीसरे पक्ष की कुकी को अनुमति देने का विकल्प होता है</translation>
<translation id="2235344399760031203">तीसरे पक्ष की कुकी ब्लॉक हैं</translation>
<translation id="2496115946829713659">साइटें, कॉन्टेंट और विज्ञापनों को आपकी दिलचस्पी के हिसाब से बनाने के लिए, तीसरे पक्ष की कुकी का इस्तेमाल कर सकती हैं. साथ ही, वे अन्य साइटों पर की गई आपकी गतिविधियों के बारे में जानकारी जुटा सकती हैं</translation>
<translation id="3045333309254072201">गुप्त मोड में ब्राउज़ करने पर, साइटें तीसरे पक्ष की कुकी का इस्तेमाल नहीं कर सकतीं. अगर इन कुकी का इस्तेमाल करने वाली कोई साइट काम नहीं करती है, तो <ph name="START_LINK" />उस साइट को कुछ समय के लिए, तीसरे पक्ष की कुकी का ऐक्सेस दें<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">तीसरे पक्ष की कुकी इस्तेमाल करने वाली साइटें, उम्मीद के मुताबिक काम करेंगी</translation>
<translation id="3624583033347146597">तीसरे पक्ष की कुकी की प्राथमिकताएं चुनें</translation>
<translation id="3918378745482005425">ऐसा हो सकता है कि कुछ सुविधाएं काम न करें. मिलती-जुलती साइटें अब भी तीसरे पक्ष की कुकी का इस्तेमाल कर सकती हैं.</translation>
<translation id="4009365983562022788">Google, कंपनियों से सार्वजनिक तौर पर यह बताने के लिए कहता है कि वे इस डेटा का इस्तेमाल, अलग-अलग साइटों पर आपकी गतिविधि को ट्रैक करने के लिए नहीं करेंगी. कुछ साइटें आपकी गतिविधि का इस्तेमाल, सिर्फ़ दिलचस्पी के हिसाब से विज्ञापन दिखाने के लिए ही नहीं, बल्कि अन्य चीज़ों के लिए भी कर सकती हैं, ताकि आपको बेहतर अनुभव मिले. वे इस जानकारी को, आपके बारे में पहले से मौजूद अन्य जानकारी के साथ जोड़ सकती हैं. आपको यह बताना कंपनियों की ज़िम्मेदारी है कि वे आपके डेटा का इस्तेमाल कैसे करती हैं. इस बारे में ज़्यादा जानने के लिए, हमारी <ph name="BEGIN_LINK1" />निजता नीति<ph name="LINK_END1" /> पढ़ें.</translation>
<translation id="4278390842282768270">अनुमति है</translation>
<translation id="4412992751769744546">तीसरे पक्ष की कुकी को अनुमति दें</translation>
<translation id="4711259472133554310">खास साइटों को, तीसरे पक्ष की कुकी का 'हमेशा इस्तेमाल करने' की अनुमति दी जा सकती है. इसे सेटिंग में अपवाद के तौर पर जोड़ा जा सकता है</translation>
<translation id="5117284457376555514">साइटें, कॉन्टेंट और विज्ञापनों को आपकी दिलचस्पी के हिसाब से बनाने के लिए, तीसरे पक्ष की कुकी का इस्तेमाल नहीं कर सकतीं. साथ ही, वे अन्य साइटों पर की गई आपकी गतिविधियों के बारे में जानकारी नहीं जुटा सकतीं. ऐसा तब तक होगा, जब तक आपने मिलती-जुलती साइटों को, इन कुकी को ऐक्सेस करने की अनुमति न दी हो. ऐसा हो सकता है कि साइट की कुछ सुविधाएं ठीक से काम न करें.</translation>
<translation id="5677928146339483299">ब्लॉक किया गया</translation>
<translation id="6196640612572343990">तीसरे पक्ष की कुकी ब्लॉक करें</translation>
<translation id="6308169245546905162">साइटें तीसरे पक्ष की कुकी का इस्तेमाल करके, यह जान सकती हैं कि आपने अन्य साइटों पर कौन-कौनसी गतिविधियां की हैं</translation>
<translation id="6494210367693221285">Chromium की आपकी मौजूदा सेटिंग को अपडेट कर दिया गया है. इससे सभी वेबसाइट तीसरे पक्ष की कुकी ऐक्सेस कर पाएंगी. इस सेटिंग को कभी भी बदला जा सकता है.</translation>
<translation id="6710025070089118043">साइटें, कॉन्टेंट और विज्ञापनों को आपकी दिलचस्पी के हिसाब से बनाने के लिए, तीसरे पक्ष की कुकी का इस्तेमाल नहीं कर सकतीं. साथ ही, वे अन्य साइटों पर की गई आपकी गतिविधियों के बारे में जानकारी नहीं जुटा सकतीं. ऐसा तब तक होगा, जब तक आपने मिलती-जुलती साइटों को, इन कुकी को ऐक्सेस करने की अनुमति न दी हो</translation>
<translation id="7315780377187123731">तीसरे पक्ष की कुकी ब्लॉक करने के विकल्प के बारे में ज़्यादा जानकारी</translation>
<translation id="7374493521304367420">साइटें अब भी कुकी का इस्तेमाल कर सकती हैं, ताकि वे अपनी वेबसाइट पर आपकी ब्राउज़िंग गतिविधि की जानकारी देख सकें</translation>
<translation id="7453144832830554937">तीसरे पक्ष की कुकी इस्तेमाल करने वाली साइट की सुविधाएं शायद काम न करें</translation>
<translation id="7538480403395139206">तीसरे पक्ष की कुकी को अनुमति देने के विकल्प के बारे में ज़्यादा जानकारी</translation>
<translation id="8200078544056087897">तीसरे पक्ष की कुकी इस्तेमाल करने वाली साइट की सुविधाएं, उम्मीद के मुताबिक काम करेंगी</translation>
<translation id="839994149685752920">साइटें, कॉन्टेंट और विज्ञापनों को आपकी दिलचस्पी के हिसाब से बनाने के लिए, तीसरे पक्ष की कुकी का इस्तेमाल कर सकती हैं</translation>
<translation id="8428213095426709021">सेटिंग</translation>
<translation id="8712637175834984815">ठीक है</translation>
<translation id="9039924186462989565">गुप्त मोड में ब्राउज़ करने पर, Chromium साइटों को तीसरे पक्ष की कुकी इस्तेमाल करने से रोकता है</translation>
<translation id="9162335340010958530">साइटें, कॉन्टेंट और विज्ञापनों को आपकी दिलचस्पी के हिसाब से बनाने के लिए, तीसरे पक्ष की कुकी का इस्तेमाल नहीं कर सकतीं. साथ ही, वे अन्य साइटों पर की गई आपकी गतिविधियों के बारे में जानकारी नहीं जुटा सकतीं. ऐसा तब तक होगा, जब तक आपने मिलती-जुलती साइटों को कुकी ऐक्सेस करने की अनुमति न दी हो</translation>
</translationbundle>