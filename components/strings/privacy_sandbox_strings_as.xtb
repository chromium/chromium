<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="as">
<translation id="1184166532603925201">আপুনি ইনক’গনিট’ ম’ডত থাকিলে, Chromeএ ছাইটসমূহে তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰাটো অৱৰোধ কৰে</translation>
<translation id="1559726735555610004">Googleৰ বাবে কোম্পানীসমূহে আপোনাক বিভিন্ন ছাইটত ট্ৰেক কৰিবলৈ এই ডেটাখিনি ব্যৱহাৰ নকৰে বুলি ৰাজহুৱাভাৱে জনোৱাটো প্ৰয়োজনীয়। কিছুমান ছাইটে বিজ্ঞাপনৰ উপৰিও আপোনাৰ অভিজ্ঞতা ব্যক্তিগতকৰণ কৰিবলৈ আপোনাৰ কাৰ্যকলাপ ব্যৱহাৰ কৰিব পাৰে। সেইসমূহে আপোনাৰ বিষয়ে আগৰে পৰা জনা অন্য তথ্যৰ সৈতে এই তথ্যখিনি একত্ৰিত কৰিব পাৰে। কোম্পানীসমূহে আপোনাৰ ডেটা কেনেকৈ ব্যৱহাৰ কৰে সেয়া আপোনাক জনোৱাটো কোম্পানীসমূহৰ দ্বায়িত্ব। আমাৰ <ph name="BEGIN_LINK" />গোপনীয়তাৰ নীতি<ph name="END_LINK" />ত Googleএ আপোনাৰ ডেটা কেনেকৈ সুৰক্ষিত কৰে সেই বিষয়ে অধিক জানক।</translation>
<translation id="1569440020357229235">আপুনি ইনক’গনিট’ ম’ডত থাকিলে, ছাইটসমূহে তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব নোৱাৰে। যদি এই কুকিসমূহৰ ওপৰত নিৰ্ভৰশীল কোনো ছাইটে কাম নকৰে, তেন্তে আপুনি <ph name="BEGIN_LINK" />সেই ছাইটটোক সাময়িকভাৱে তৃতীয় পক্ষৰ কুকিৰ এক্সেছ প্ৰদান কৰি চাব পাৰে<ph name="END_LINK" />।</translation>
<translation id="19426210786412737">ৱেবছাইটে তৃতীয় পক্ষৰ কুকি এক্সেছ কৰাৰ অনুমতি দিবলৈ আপোনাৰ বৰ্তমানৰ Chromeৰ ছেটিং আপডে’ট কৰা হৈছে। আপুনি যিকোনো সময়তে এই ছেটিংটো সলনি কৰিব পাৰে।</translation>
<translation id="2004697686368036666">কিছুমান ছাইটত সুবিধাসমূহে কাম নকৰিবও পাৰে</translation>
<translation id="2183376768278472507">যদি কোনো ছাইটে আশা কৰা ধৰণে কাম নকৰে, তেন্তে আপুনি চোৱা কোনো নিৰ্দিষ্ট ছাইটৰ বাবে তৃতীয় পক্ষৰ কুকিসমূহৰ অনুমতি প্ৰদান কৰি চাব পাৰে</translation>
<translation id="2235344399760031203">তৃতীয় পক্ষৰ কুকিসমূহ অৱৰোধ কৰা হৈছে</translation>
<translation id="2496115946829713659">ছাইটসমূহে সমল আৰু বিজ্ঞাপনসমূহ ব্যক্তিগতকৰণ কৰিবলৈ আৰু আপুনি অন্য ছাইটসমূহত কৰা কাৰ্যসমূহৰ বিষয়ে জানিবলৈ তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="3045333309254072201">আপুনি ইনক’গনিট’ ম’ডত থাকিলে, ছাইটসমূহে তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব নোৱাৰে। যদি এই কুকিসমূহৰ ওপৰত নিৰ্ভৰশীল কোনো ছাইটে কাম নকৰে, তেন্তে আপুনি <ph name="START_LINK" />সেই ছাইটটোক সাময়িকভাৱে তৃতীয় পক্ষৰ কুকিৰ এক্সেছ প্ৰদান কৰি চাব পাৰে<ph name="END_LINK" />।</translation>
<translation id="3425311689852411591">তৃতীয় পক্ষৰ কুকিৰ ওপৰত নিৰ্ভৰশীল ছাইটসমূহে আশা কৰা ধৰণে কাম কৰিব লাগে</translation>
<translation id="3624583033347146597">আপোনাৰ তৃতীয় পক্ষৰ কুকিৰ অগ্ৰাধিকাৰ বাছনি কৰক</translation>
<translation id="3918378745482005425">কিছুমান সুবিধাই কাম নকৰিবও পাৰে। সংশ্লিষ্ট ছাইটসমূহে তথাপি তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব পাৰে।</translation>
<translation id="4009365983562022788">Googleৰ বাবে কোম্পানীসমূহে আপোনাক বিভিন্ন ছাইটত ট্ৰেক কৰিবলৈ এই ডেটাখিনি ব্যৱহাৰ নকৰে বুলি ৰাজহুৱাভাৱে জনোৱাটো প্ৰয়োজনীয়। কিছুমান ছাইটে বিজ্ঞাপনৰ উপৰিও আপোনাৰ অভিজ্ঞতা ব্যক্তিগতকৰণ কৰিবলৈ আপোনাৰ কাৰ্যকলাপ ব্যৱহাৰ কৰিব পাৰে। সেইসমূহে আপোনাৰ বিষয়ে আগৰে পৰা জনা অন্য তথ্যৰ সৈতে এই তথ্যখিনি একত্ৰিত কৰিব পাৰে। কোম্পানীসমূহে আপোনাৰ ডেটা কেনেকৈ ব্যৱহাৰ কৰে সেয়া আপোনাক জনোৱাটো কোম্পানীসমূহৰ দ্বায়িত্ব। আমাৰ <ph name="BEGIN_LINK1" />গোপনীয়তাৰ নীতি<ph name="LINK_END1" />ত অধিক জানক।</translation>
<translation id="4278390842282768270">অনুমতি দিয়া হৈছে</translation>
<translation id="4412992751769744546">তৃতীয় পক্ষৰ কুকিৰ অনুমতি দিয়ক</translation>
<translation id="4711259472133554310">আপুনি নিৰ্দিষ্ট ছাইটসমূহক সদায় তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰাৰ অনুমতি দিবলৈ ছেটিঙত ব্যতিক্ৰম কৰিব পাৰে</translation>
<translation id="5117284457376555514">ছাইটসমূহে সমল আৰু বিজ্ঞাপনসমূহ ব্যক্তিগতকৰণ কৰিবলৈ আৰু আপুনি অন্য ছাইটসমূহত কৰা কাৰ্যসমূহৰ বিষয়ে জানিবলৈ তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব নোৱাৰে, যদিহে আপুনি সংশ্লিষ্ট ছাইটসমূহক সেইসমূহ এক্সেছ কৰিবলৈ অনুমতি নিদিয়ে। কিছুমান ছাইটৰ সুবিধাই আশা কৰা ধৰণে কাম নকৰিবও পাৰে।</translation>
<translation id="5677928146339483299">অৱৰোধ কৰা হৈছে</translation>
<translation id="6196640612572343990">তৃতীয়-পক্ষৰ কুকিসমূহ অৱৰোধ কৰক</translation>
<translation id="6308169245546905162">আপুনি অন্য ছাইটসমূহত কৰা কাৰ্যসমূহৰ বিষয়ে জানিবলৈ ছাইটসমূহে তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="6494210367693221285">ৱেবছাইটে তৃতীয় পক্ষৰ কুকি এক্সেছ কৰাৰ অনুমতি দিবলৈ আপোনাৰ বৰ্তমানৰ Chromiumৰ ছেটিং আপডে’ট কৰা হৈছে। আপুনি যিকোনো সময়তে এই ছেটিংটো সলনি কৰিব পাৰে।</translation>
<translation id="6710025070089118043">ছাইটসমূহে সমল আৰু বিজ্ঞাপনসমূহ ব্যক্তিগতকৰণ কৰিবলৈ আৰু আপুনি অন্য ছাইটসমূহত কৰা কাৰ্যসমূহৰ বিষয়ে জানিবলৈ তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব নোৱাৰে, যদিহে আপুনি সংশ্লিষ্ট ছাইটসমূহক সেইসমূহৰ এক্সেছ প্ৰদান নকৰে</translation>
<translation id="7315780377187123731">তৃতীয়-পক্ষৰ কুকিসমূহ অৱৰোধ কৰাৰ বিকল্পটোৰ বিষয়ে অধিক তথ্য</translation>
<translation id="7374493521304367420">ছাইটসমূহে তথাপি নিজৰ ছাইটত ব্ৰাউজিঙৰ কাৰ্যকলাপ চাবলৈ কুকিসমূহ ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="7453144832830554937">তৃতীয় পক্ষৰ কুকিৰ ওপৰত নিৰ্ভৰশীল ছাইটৰ সুবিধাসমূহে আশা কৰা ধৰণে কাম নকৰিবও পাৰে</translation>
<translation id="7538480403395139206">তৃতীয়-পক্ষৰ কুকিসমূহৰ অনুমতি দিয়ক বিকল্পটোৰ বিষয়ে অধিক তথ্য</translation>
<translation id="8200078544056087897">তৃতীয় পক্ষৰ কুকিৰ ওপৰত নিৰ্ভৰশীল ছাইটৰ সুবিধাসমূহে আশা কৰা ধৰণে কাম কৰিব লাগে</translation>
<translation id="839994149685752920">ছাইটসমূহে সমল আৰু বিজ্ঞাপনসমূহ ব্যক্তিগতকৰণ কৰিবলৈ তৃতীয় পক্ষৰ কুকিসমূহ ব্যৱহাৰ কৰিব পাৰে</translation>
<translation id="8428213095426709021">ছেটিং</translation>
<translation id="8712637175834984815">বুজি পালোঁ</translation>
<translation id="9039924186462989565">আপুনি ইনক’গনিট’ ম’ডত থাকিলে, Chromiumএ ছাইটসমূহে তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰাটো অৱৰোধ কৰে</translation>
<translation id="9162335340010958530">ছাইটসমূহে সমল আৰু বিজ্ঞাপনসমূহ ব্যক্তিগতকৰণ কৰিবলৈ আৰু আপুনি অন্য ছাইটসমূহত কৰা কাৰ্যসমূহৰ বিষয়ে জানিবলৈ তৃতীয় পক্ষৰ কুকি ব্যৱহাৰ কৰিব নোৱাৰে, যদিহে আপুনি সংশ্লিষ্ট ছাইটসমূহক সেইসমূহ এক্সেছ কৰিবলৈ অনুমতি নিদিয়ে</translation>
</translationbundle>