<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1184166532603925201">במצב פרטי, Chrome מונע מאתרים להשתמש בקובצי Cookie של צד שלישי</translation>
<translation id="1569440020357229235">במצב פרטי, אתרים לא יכולים להשתמש בקובצי Cookie של צד שלישי. אם אתר שמשתמש בקובצי Cookie כאלה לא פועל, אפשר <ph name="BEGIN_LINK" />לנסות לתת לאתר הזה גישה זמנית לקובצי Cookie של צד שלישי<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">ההגדרות הנוכחיות של Chrome עודכנו כדי לאפשר לאתרים לגשת לקובצי Cookie של צד שלישי. אפשר לשנות את ההגדרה הזו בכל שלב.</translation>
<translation id="2004697686368036666">יכול להיות שתכונות באתרים מסוימים לא יפעלו.</translation>
<translation id="2183376768278472507">אם אתר מסוים לא פועל כמו שצריך, אפשר לנסות לאשר את השימוש בקובצי Cookie של צד שלישי באתר הספציפי הזה</translation>
<translation id="2235344399760031203">קובצי Cookie של צד שלישי חסומים</translation>
<translation id="2496115946829713659">אתרים יכולים להשתמש בקובצי Cookie של צד שלישי כדי להתאים אישית תוכן ומודעות, וגם לקבל מידע על פעולות שביצעת באתרים אחרים</translation>
<translation id="3045333309254072201">במצב פרטי, אתרים לא יכולים להשתמש בקובצי Cookie של צד שלישי. אם אתר שמשתמש בקובצי Cookie כאלה לא פועל, אפשר <ph name="START_LINK" />לנסות לתת לאתר הזה גישה זמנית לקובצי Cookie של צד שלישי<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">אתרים שמסתמכים על קובצי Cookie של צד שלישי אמורים לפעול כצפוי</translation>
<translation id="3624583033347146597">בחירת ההעדפות בנוגע לקובצי Cookie של צד שלישי</translation>
<translation id="3918378745482005425">יכול להיות שחלק מהתכונות לא יפעלו. אתרים קשורים עדיין יכולים להשתמש בקובצי Cookie של צד שלישי.</translation>
<translation id="4278390842282768270">יש הרשאה</translation>
<translation id="4412992751769744546">אישור קובצי Cookie של צד שלישי</translation>
<translation id="4711259472133554310">אפשר ליצור חריגים בהגדרות כדי לאפשר לאתרים ספציפיים להשתמש בקובצי Cookie של צד שלישי ללא הגבלה</translation>
<translation id="5117284457376555514">אתרים לא יכולים להשתמש בקובצי Cookie של צד שלישי כדי להתאים אישית תוכן ומודעות או לקבל מידע על פעולות שביצעת באתרים אחרים, אלא אם נתת לאתרים קשורים גישה אליהם. יכול להיות שחלק מהתכונות באתר לא יפעלו כצפוי.</translation>
<translation id="5677928146339483299">האפשרות חסומה</translation>
<translation id="6196640612572343990">חסימת קובצי Cookie של צד שלישי</translation>
<translation id="6308169245546905162">אתרים יכולים להשתמש בקובצי Cookie של צד שלישי כדי לקבל מידע על פעולות שביצעת באתרים אחרים</translation>
<translation id="6494210367693221285">ההגדרות הנוכחיות של Chromium עודכנו כדי לאפשר לאתרים לגשת לקובצי Cookie של צד שלישי. אפשר לשנות את ההגדרה הזו בכל שלב.</translation>
<translation id="6710025070089118043">אתרים לא יכולים להשתמש בקובצי Cookie של צד שלישי כדי להתאים אישית תוכן ומודעות או לקבל מידע על פעולות שביצעת באתרים אחרים, אלא אם נתת לאתרים קשורים גישה אליהם</translation>
<translation id="7315780377187123731">מידע נוסף על האפשרות "חסימת קובצי Cookie של צד שלישי"</translation>
<translation id="7374493521304367420">אתרים עדיין יכולים להשתמש בקובצי Cookie כדי לראות את פעילות הגלישה בהם</translation>
<translation id="7453144832830554937">יכול להיות שתכונות באתר שמסתמך על קובצי Cookie של צד שלישי לא יפעלו</translation>
<translation id="7538480403395139206">מידע נוסף על האפשרות "אישור קובצי Cookie של צד שלישי"</translation>
<translation id="8200078544056087897">התכונות באתר שמבוססות על קובצי Cookie של צד שלישי אמורות לפעול כצפוי</translation>
<translation id="839994149685752920">אתרים יכולים להשתמש בקובצי Cookie של צד שלישי כדי להתאים אישית תוכן ומודעות</translation>
<translation id="8428213095426709021">הגדרות</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="9039924186462989565">במצב פרטי, Chromium מונע מאתרים להשתמש בקובצי Cookie של צד שלישי</translation>
<translation id="9162335340010958530">אתרים לא יכולים להשתמש בקובצי Cookie של צד שלישי כדי להתאים אישית תוכן ומודעות או לקבל מידע על פעולות שביצעת באתרים אחרים, אלא אם נתת לאתרים קשורים גישה אליהם</translation>
