<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1184166532603925201">Uma ukumodi ye-Incognito, iChrome ivimba amasayithi ekusebenziseni amakhukhi wongahlangene ngqo</translation>
<translation id="1569440020357229235">Uma ukumodi ye-Incognito, amasayithi awakwazi ukusebenzisa amakhukhi wongahlangene ngqo. Uma isayithi ethembele kulawa makhukhi ingasebenzi, <ph name="BEGIN_LINK" />ungazama ukunika lelo sayithi ukufinyelela kwesikhashana kumakhukhi wongahlangene ngqo<ph name="END_LINK" />.</translation>
<translation id="19426210786412737">Amasethingi akho amanje eChrome abuyekeziwe ukuze avumele amawebhusayithi afinyelele kumakhukhi ongahlangene ngqo. Ungashintsha le sethingi noma nini.</translation>
<translation id="2004697686368036666">Izakhi ezikwamanye amasayithi zingase zingasebenzi</translation>
<translation id="2183376768278472507">Uma isayithi ingasebenzi njengoba bekulindelekile, ungazama ukuvumela amakhukhi wongahlangene ngqo esayithini ethile oyivakashelayo</translation>
<translation id="2235344399760031203">Amakhukhi enkampani yangaphandle avinjiwe</translation>
<translation id="2496115946829713659">Amasayithi angasebenzisa amakhukhi wongahlangene ngqo ukwenza okuqukethwe kube ngokwakho kanye nezikhangiso, futhi afunde mayelana nezenzo ozenzayo kwamanye amasayithi</translation>
<translation id="3045333309254072201">Uma ukumodi ye-Incognito, amasayithi awakwazi ukusebenzisa amakhukhi wongahlangene ngqo. Uma isayithi ethembele kulawa makhukhi ingasebenzi, <ph name="START_LINK" />ungazama ukunika lelo sayithi ukufinyelela kwesikhashana kumakhukhi wongahlangene ngqo<ph name="END_LINK" />.</translation>
<translation id="3425311689852411591">Amasathini athembele kumakhukhi ezinkampani zangaphandle kufanele zisebenze njengoba kulindelekile</translation>
<translation id="3624583033347146597">Khetha okuncanyelwayo kwakho kwekhukhi yenkampani engahlangene ngqo</translation>
<translation id="3918378745482005425">Ezinye izakhi zingase zingasebenzi. Amasayithi ahlobene asengasebenzisa amakhukhi ezinkampani ezingahlangene ngqo.</translation>
<translation id="4278390842282768270">Kuvumelekile</translation>
<translation id="4412992751769744546">Vumela amakhukhi wezinkampani zangaphandle</translation>
<translation id="4711259472133554310">Ungasungula okuhlukile kokuthi Amasethingi ukuze uhlale uvumela amasayithi athile ukuthi asebenzise amakhukhi wongahlangene ngqo</translation>
<translation id="5117284457376555514">Amasayithi awakwazi ukusebenzisa amakhukhi wongahlangene ngqo ukwenza okuqukethwe kube ngokwakho kanye nezikhangiso, futhi afunde mayelana nezenzo ozenzayo kwamanye amasayithi, ngaphandle kwalapho uma uvumela amasayithi ahlobene nawo ukuthi awafinyelele. Ezinye izakhi zesayithi zingase zingasebenzi njengoba bekulindelekile.</translation>
<translation id="5677928146339483299">Kuvinjiwe</translation>
<translation id="6196640612572343990">Vimba amakhukhi enkampani yangaphandle</translation>
<translation id="6308169245546905162">Amasayithi angasebenzisa amakhukhi wongahlangene ngqo ukuze afunde mayelana nezenzo ozenzayo kwamanye amasayithi</translation>
<translation id="6494210367693221285">Amasethingi akho amanje eChromium abuyekeziwe ukuze avumele amawebhusayithi afinyelele kumakhukhi ongahlangene ngqo. Ungashintsha le sethingi noma nini.</translation>
<translation id="6710025070089118043">Amasayithi awakwazi ukusebenzisa amakhukhi wongahlangene ngqo ukwenza ikhontenti nezikhangiso zibe ngezakho, futhi afunde mayelana nezenzo ozenzayo kwamanye amasayithi, ngaphandle kwalapho uma unikeza amasayithi ahlobene nawo ukufinyelela kuwo</translation>
<translation id="7315780377187123731">Okuningi mayelana nongakhetha kukho okuthi Vimba amakhukhi wongahlangene ngqo</translation>
<translation id="7374493521304367420">Amasayithi asengasebenzisa amakhukhi ukuze abone umsebenzi wokubhrawuza osesayithini yakho</translation>
<translation id="7453144832830554937">Izakhi zesayithi ezithembele kumakhukhi ezinkampani ezingahlangene ngqo zingase zingasebenzi</translation>
<translation id="7538480403395139206">Okuningi mayelana nongakhetha kukho okuthi Vumela amakhukhi wongahlangene ngqo</translation>
<translation id="8200078544056087897">Izakhi zesayithi ezithembele kumakhukhi wongahlangene ngqo kufanele zisebenze njengoba kulindelekile</translation>
<translation id="839994149685752920">Amasayithi angasebenzisa amakhukhi wongahlangene ngqo ukwenza okuqukethwe kube ngokwakho kanye nezikhangiso</translation>
<translation id="8428213095426709021">Amasethingi</translation>
<translation id="8712637175834984815">Ngiyezwa</translation>
<translation id="9039924186462989565">Uma ukumodi ye-Incognito, iChromium ivimba amasayithi ekusebenziseni amakhukhi wongahlangene ngqo</translation>
<translation id="9162335340010958530">Amasayithi awakwazi ukusebenzisa amakhukhi wongahlangene ngqo ukwenza okuqukethwe kube ngokwakho kanye nezikhangiso, futhi afunde mayelana nezenzo ozenzayo kwamanye amasayithi, ngaphandle kwalapho uma uvumela amasayithi ahlobene nawo ukuthi awafinyelele</translation>
</translationbundle>