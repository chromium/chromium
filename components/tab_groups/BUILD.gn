if (is_android) {
  import("//build/config/android/rules.gni")
  import("//third_party/jni_zero/jni_zero.gni")
}

component("tab_groups") {
  sources = [
    "features.cc",
    "features.h",
    "tab_group_color.cc",
    "tab_group_color.h",
    "tab_group_id.h",
    "tab_group_info.cc",
    "tab_group_info.h",
    "tab_group_visual_data.cc",
    "tab_group_visual_data.h",
    "token_id.h",
  ]

  defines = [ "IS_TAB_GROUPS_IMPL" ]

  deps = [
    "//base",
    "//components/strings",
    "//components/tab_groups/public/mojom:mojo_bindings_ts__generator",
    "//skia",
    "//ui/base",
    "//ui/gfx",
  ]

  if (is_android) {
    sources += [
      "android/tab_group_id_jni_conversion.cc",
      "android/tab_group_id_jni_conversion.h",
      "android/tab_groups_feature_map.cc",
    ]
    deps += [
      ":tab_groups_jni_headers",
      "//third_party/jni_zero",
    ]
  }
}

if (is_android) {
  java_cpp_enum("java_enums") {
    visibility = [ ":*" ]
    sources = [ "//components/tab_groups/tab_group_color.h" ]
  }

  generate_jni("tab_groups_jni_headers") {
    sources = [
      "android/java/src/org/chromium/components/tab_groups/TabGroupId.java",
      "android/java/src/org/chromium/components/tab_groups/TabGroupsFeatureMap.java",
      "android/java/src/org/chromium/components/tab_groups/TokenId.java",
    ]
  }

  android_library("tab_groups_java") {
    resources_package = "org.chromium.components.tab_groups"
    sources = [
      "android/java/src/org/chromium/components/tab_groups/TabGroupColorPickerUtils.java",
      "android/java/src/org/chromium/components/tab_groups/TabGroupId.java",
      "android/java/src/org/chromium/components/tab_groups/TabGroupsFeatureMap.java",
      "android/java/src/org/chromium/components/tab_groups/TokenId.java",
    ]
    deps = [
      ":java_resources",
      "//base:features_java",
      "//base:token_java",
      "//build/android:build_java",
      "//components/browser_ui/styles/android:java",
      "//third_party/android_deps:com_google_errorprone_error_prone_annotations_java",
      "//third_party/android_deps:material_design_java",
      "//third_party/androidx:androidx_annotation_annotation_java",
      "//third_party/androidx:androidx_core_core_java",
      "//third_party/jni_zero:gendeps_java",
      "//third_party/jni_zero:jni_zero_java",
      "//ui/android:ui_java",
    ]
    srcjar_deps = [
      ":java_enums",
      ":tab_groups_jni_headers",
    ]
  }

  android_resources("java_resources") {
    sources = [
      "android/java/res/values-night/colors.xml",
      "android/java/res/values/colors.xml",
      "android/java/res/values/dimens.xml",
    ]
    deps = [ "//components/strings:components_strings_grd" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = []
  deps = []

  if (is_android) {
    sources += [ "android/tab_group_id_jni_conversion_unittest.cc" ]
    deps += [
      ":tab_groups",
      "//base",
      "//testing/gtest",
      "//third_party/jni_zero",
    ]
  }
}

if (is_android) {
  robolectric_library("junit") {
    sources = [ "android/junit/src/org/chromium/components/tab_groups/TokenIdUnitTest.java" ]
    deps = [
      ":tab_groups_java",
      "//base:base_junit_test_support",
      "//base:token_java",
      "//third_party/junit",
    ]
  }
}
