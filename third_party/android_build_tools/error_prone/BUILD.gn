import("//build/config/android/rules.gni")

java_prebuilt("error_prone_java") {
  jar_path = "cipd/error_prone_core.jar"
}

# Temporary copies of Error Prone checks. See README.chromium.
java_library("error_prone_checks_java") {
  visibility = [ "//tools/android/errorprone_plugin:*" ]
  sources = [
    "java/src/org/chromium/third_party/errorprone/FieldCanBeFinalFast.java",
  ]

  # Necessary to avoid dependency cycle
  enable_errorprone = false
  enable_bytecode_checks = false

  deps = [
    ":error_prone_java",
    "//build/android:build_java",
    "//third_party/android_build_tools/error_prone_javac:error_prone_javac_java",
  ]
}

# We use //tools/android/errorprone_plugin when build_with_chromium.
if (!build_with_chromium) {
  java_binary("error_prone") {
    # main_class and wrapper script are not actually used.
    # This target is referenced directly from java_library_impl().
    main_class = "<ignore>"
    wrapper_script_name = "bin/helper/ignored_error_prone"

    # GN adds nullaway.jar when nullaway is enabled, so add it as a
    # build-time-only dep here.
    input_jars_paths =
        [ "//third_party/android_build_tools/error_prone/cipd/nullaway.jar" ]

    deps = [ ":error_prone_java" ]
  }
}
