    # have_wayland or have_native_backend
    "src/src/backends/meta-udev.c",
    "src/src/backends/meta-udev.h",
  ]

  # Upstream only builds these with remote_desktop enabled, but
  # meta-clipboard-session.c (which is always built) uses them.
  sources += [
    "src/src/core/meta-selection-source-remote.c",
    "src/src/core/meta-selection-source-remote.h",
  ]

  configs += [
    ":libmutter_config",
    ":gbm",
    "//third_party/libei:libei_include_dirs",
  ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]

  deps = _libmutter_deps

  # Generated sources.
  sources += get_target_outputs(":meta_enum_types_c")
  sources += get_target_outputs(":meta_private_enum_types_c")
  foreach(t, _meta_dbus_targets) {
    sources += get_target_outputs(t)
  }
  deps += _meta_dbus_targets + [
            ":meta_enum_types_c",
            ":meta_private_enum_types_c",
          ]
}

# Chromium's implementation of the zcr_ui_controls_v2 protocol, used by
# interactive_ui_tests. It is kept outside of the upstream mutter tree so that
# src/ can track a pristine upstream release, and is hooked into the compositor
# by wrapping meta_wayland_compositor_new() at link time (see the
# executable("mutter") target below).
source_set("ui_controls") {
  testonly = true

  defines = [ "G_LOG_DOMAIN=\"libmutter\"" ]

  sources = [ "chromium/meta-wayland-ui-controls.c" ]

  configs += [
    ":gbm",
    ":libmutter_config",
    ":mtk_public_config",
    "//third_party/libei:libei_include_dirs",
  ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]

  deps = _libmutter_deps + [
           ":libmutter",
           "//third_party/wayland-protocols:ui_controls_protocol",
         ]
}

# Replacements for libmutter functions whose upstream behavior makes tests
# flaky. They are hooked in with -Wl,--wrap (see the executable("mutter")
# target below), so that src/ can track a pristine upstream release.
source_set("test_workarounds") {
  testonly = true

  defines = [ "G_LOG_DOMAIN=\"libmutter\"" ]

  sources = [ "chromium/meta-test-workarounds.c" ]

  configs += [
    ":gbm",
    ":libmutter_config",
    ":mtk_public_config",
    "//third_party/libei:libei_include_dirs",
  ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]

  deps = _libmutter_deps + [ ":libmutter" ]
}

shared_library("libdefault") {
  testonly = true

  defines = [ "G_LOG_DOMAIN=\"mutter\"" ]

  sources = [ "src/src/compositor/plugins/default.c" ]

  configs += [
    ":mtk_public_config",
    ":libmutter_config",
  ]

  deps = [
    ":clutter",
    ":libmutter",
  ]

  ldflags = [ "-Wl,-rpath=\$ORIGIN" ]

  # TODO(crbug.com/396647882) remove this temporary measure to build with
  # missing gbm functions in sysroot gbm package.
  configs -= [ "//build/config/compiler:no_unresolved_symbols" ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
}

template("mutter_gschema") {
  action(target_name) {
    script = "//third_party/glib/process_gschema.py"
    sources = [ "src/data/${invoker.schema_xml}.in" ]
    outputs = [ "$target_gen_dir/${invoker.schema_xml}" ]
    args = [
      "--input",
      rebase_path(sources[0], root_build_dir),
      "--output",
      rebase_path(outputs[0], root_build_dir),
      "--gettext-domain",
      "mutter",
    ]
  }
}

mutter_gschema("org_gnome_mutter_gschema") {
  schema_xml = "org.gnome.mutter.gschema.xml"
}

mutter_gschema("org_gnome_mutter_experimental_gschema") {
  schema_xml = "org.gnome.mutter.experimental.gschema.xml"
}

mutter_gschema("org_gnome_mutter_wayland_gschema") {
  schema_xml = "org.gnome.mutter.wayland.gschema.xml"
}

action("collect_schemas") {
  testonly = true
  outputs = [ "$target_gen_dir/collected_schemas/.stamp" ]

  # We use python to copy files to avoid shell issues
  script = "//third_party/mutter/collect_schemas.py"

  # Add all schemas from gsettings-desktop-schemas
  _gsettings_gen_dir = get_label_info("//third_party/gsettings-desktop-schemas",
                                      "target_gen_dir")

  args = [
    "--output-dir",
    rebase_path("$target_gen_dir/collected_schemas", root_build_dir),
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
    "--schemas",
  ]

  inputs = [
    "$target_gen_dir/org.gnome.mutter.experimental.gschema.xml",
    "$target_gen_dir/org.gnome.mutter.gschema.xml",
    "$target_gen_dir/org.gnome.mutter.wayland.gschema.xml",
    "$_gsettings_gen_dir/org.gnome.desktop.enums.xml",
    "chromium/chromium-tests.gschema.override",
  ]

  deps = [
    ":org_gnome_mutter_experimental_gschema",
    ":org_gnome_mutter_gschema",
    ":org_gnome_mutter_wayland_gschema",
    "//third_party/gsettings-desktop-schemas",
  ]

  # Add all schemas from gsettings-desktop-schemas
  _gsettings_gen_dir = get_label_info("//third_party/gsettings-desktop-schemas",
                                      "target_gen_dir")

  foreach(s, gsettings_desktop_schemas) {
    inputs += [ "$_gsettings_gen_dir/$s" ]
  }

  args += rebase_path(inputs, root_build_dir)
}

action("compile_schemas") {
  testonly = true
  script = "//third_party/glib/compile_schemas.py"

  _host_tool = "//third_party/glib:glib-compile-schemas($host_toolchain)"
  _host_executable =
      get_label_info(_host_tool, "root_out_dir") + "/glib-compile-schemas"

  inputs = [
    "$target_gen_dir/collected_schemas/.stamp",
    _host_executable,
  ]
  outputs = [ "$root_out_dir/gschemas.compiled" ]
  data = outputs

  deps = [
    ":collect_schemas",
    _host_tool,
  ]

  args = [
    rebase_path(_host_executable, root_build_dir),
    "--targetdir=" + rebase_path(root_out_dir, root_build_dir),
    rebase_path("$target_gen_dir/collected_schemas", root_build_dir),
  ]
}

executable("mutter") {
  testonly = true

  defines = [ "G_LOG_DOMAIN=\"mutter\"" ]

  sources = [ "src/src/core/mutter.c" ]

  configs += [
    ":mtk_public_config",
    ":libmutter_config",
  ]

  deps = [
    ":clutter",
    ":compile_schemas",
    ":libmutter",
    ":test_workarounds",
    ":ui_controls",
  ]

  data_deps = [ ":libdefault" ]

  ldflags = [
    "-Wl,-rpath=\$ORIGIN",

    # Hook ui_controls initialization into Wayland compositor creation. See
    # chromium/meta-wayland-ui-controls.c.
    "-Wl,--wrap=meta_wayland_compositor_new",

    # Workarounds for upstream mutter bugs that affect tests. See
    # chromium/meta-test-workarounds.c.
    "-Wl,--wrap=meta_compositor_size_change_window",
    "-Wl,--wrap=meta_window_get_unit_cgroup",
    "-Wl,--wrap=meta_window_unit_cgroup_equal",
  ]

  # TODO(crbug.com/396647882) remove this temporary measure to build with
  # missing gbm functions in sysroot gbm package.
  configs -= [ "//build/config/compiler:no_unresolved_symbols" ]
  ldflags += [ "-Wl,--unresolved-symbols=ignore-in-object-files" ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
}
