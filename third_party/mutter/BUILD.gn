# config.h comes from meson's host configuration checks and is checked in as a
# template (see on_update.sh). Fill in the mutter version.
action("config_h") {
  script = "configure_version_header.py"
  inputs = [
    "include/config.h.in",
    "src/meson.build",
  ]
  outputs = [ "$_gen_dir/include/config.h" ]
  args = [
    "--meson-build",
    rebase_path("src/meson.build", root_build_dir),
    "--template",
    rebase_path("include/config.h.in", root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

# Generated headers, which are included throughout mutter, so every mutter
# target needs them to be generated first.
group("generated_headers") {
  public_deps = _meta_dbus_targets + [
                  ":clutter_enum_types_h",
                  ":clutter_marshal_h",
                  ":cogl_enum_types_h",
                  ":config_h",
                  ":meta_enum_types_h",
                  ":meta_private_enum_types_h",
                ]
}

