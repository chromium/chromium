# ---------------------------------------------------------------------------
# pipewire daemon binary
# ---------------------------------------------------------------------------

executable("pipewire") {
  testonly = true
  output_name = "pipewire"

  sources = [ "src/src/daemon/pipewire.c" ]

  deps = [ ":libpipewire" ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":pipewire_internal_config",
  ]
}

# ---------------------------------------------------------------------------
# Convenience group — use as data_deps in tests
#
# Tests should use:
#   data_deps = [ "//third_party/pipewire:all" ]
# configure_pipewire.py auto-detects the source-built layout via the presence
# of pipewire binary + pipewire-0.3/ in the output directory.
# ---------------------------------------------------------------------------

# Copies the pre-generated pipewire.conf into a dedicated subdirectory of the
# build output so configure_pipewire.py can point PIPEWIRE_CONFIG_DIR at it.
copy("pipewire_conf") {
  testonly = true
  sources = [
    "conf/client.conf",
    "conf/pipewire.conf",
  ]
  outputs = [ "${root_out_dir}/pipewire-conf/{{source_file_part}}" ]
}

group("all") {
  testonly = true
  data_deps = [
    ":libpipewire",
    ":pipewire",
    ":pipewire_conf",
    ":pipewire_module_access",
    ":pipewire_module_adapter",
    ":pipewire_module_client_device",
    ":pipewire_module_client_node",
    ":pipewire_module_link_factory",
    ":pipewire_module_metadata",
    ":pipewire_module_protocol_native",
    ":pipewire_module_spa_device_factory",
    ":pipewire_module_spa_node_factory",
    ":spa_support",
    ":spa_videoconvert",
  ]
}
