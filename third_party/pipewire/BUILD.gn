# Builds PipeWire 1.6.x from source for use in tests.  Only the components
# needed by webrtc/modules/desktop_capture, video_capture, and portal are
# included.  All targets are testonly because PipeWire is only used in tests.
#
# Runtime environment variables the test runner must set:
#   PIPEWIRE_MODULE_DIR  → <out_dir>/pipewire-0.3
#   SPA_PLUGIN_DIR       → <out_dir>/spa-0.2
#   PIPEWIRE_CONFIG_DIR  → directory containing pipewire.conf
#
# See README.chromium for update instructions.

assert(is_linux)

# ---------------------------------------------------------------------------
# Common configuration
# ---------------------------------------------------------------------------

config("pipewire_internal_config") {
  include_dirs = [
    # Generated config.h and pipewire/version.h.
    "include",

    # PipeWire public headers (pipewire/*.h) and private impl headers.
    "src/src",

    # SPA public headers (spa/*.h).
    "src/spa/include",
  ]

  # PipeWire requires GNU C extensions (asm keyword, gnu-specific builtins).
  cflags_c = [ "-std=gnu11" ]

  cflags = [
    "-D_GNU_SOURCE",
    "-DFASTPATH",
    "-DSPA_AUDIO_MAX_CHANNELS=128u",
    "-fvisibility=hidden",
    "-fno-strict-aliasing",
    "-fno-strict-overflow",

    # Warnings present upstream; silence rather than fix them.
    "-Wno-sign-compare",
    "-Wno-unused-parameter",
    "-Wno-missing-field-initializers",
    "-Wno-pedantic",
    "-Wno-deprecated-declarations",
    "-Wno-implicit-fallthrough",
    "-Wno-gnu-case-range",
    "-Wno-type-limits",
    "-Wno-variadic-macros",
    "-Wno-string-conversion",
  ]

  # Chromium passes -Wa,--crel (experimental CREL relocations) globally.
  # LLD's --gdb-index DWARF reader does not yet handle CREL, so it reports
  # DWARF version 0 and --fatal-warnings turns that into a link error.
  # Suppress fatal warnings only for our shared libraries so the link proceeds.
  ldflags = [ "-Wl,--no-fatal-warnings" ]
}

# Exposed to consumers (WebRTC) that compile against PipeWire headers.
config("pipewire_public_config") {
  include_dirs = [
    "include",
    "src/src",
    "src/spa/include",
  ]
  cflags = [ "-Wno-gnu-case-range" ]
}

# ---------------------------------------------------------------------------
# Core libpipewire shared library
# ---------------------------------------------------------------------------

shared_library("libpipewire") {
  testonly = true
  output_name = "libpipewire-0.3"

  sources = [
    "src/src/pipewire/buffers.c",
    "src/src/pipewire/conf.c",
    "src/src/pipewire/context.c",
    "src/src/pipewire/control.c",
    "src/src/pipewire/core.c",
    "src/src/pipewire/data-loop.c",
    "src/src/pipewire/filter.c",
    "src/src/pipewire/global.c",
    "src/src/pipewire/impl-client.c",
    "src/src/pipewire/impl-core.c",
    "src/src/pipewire/impl-device.c",
    "src/src/pipewire/impl-factory.c",
    "src/src/pipewire/impl-link.c",
    "src/src/pipewire/impl-metadata.c",
    "src/src/pipewire/impl-module.c",
    "src/src/pipewire/impl-node.c",
    "src/src/pipewire/impl-port.c",
    "src/src/pipewire/introspect.c",
    "src/src/pipewire/log.c",
    "src/src/pipewire/loop.c",
    "src/src/pipewire/main-loop.c",
    "src/src/pipewire/mem.c",
    "src/src/pipewire/pipewire.c",
    "src/src/pipewire/properties.c",
    "src/src/pipewire/protocol.c",
    "src/src/pipewire/proxy.c",
    "src/src/pipewire/resource.c",
    "src/src/pipewire/settings.c",
    "src/src/pipewire/stream.c",
    "src/src/pipewire/thread-loop.c",
    "src/src/pipewire/thread.c",
    "src/src/pipewire/timer-queue.c",
    "src/src/pipewire/utils.c",
    "src/src/pipewire/work-queue.c",
  ]

  cflags_c = [
    "-DOLD_MEDIA_SESSION_WORKAROUND=1",
    "-D_POSIX_C_SOURCE",
  ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":pipewire_internal_config",
  ]

  libs = [
    "dl",
    "m",
    "pthread",
  ]
}

