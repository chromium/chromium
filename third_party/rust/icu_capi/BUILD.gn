# v8 depends on icu_capi, which may occasionally update in ways that
# change its API. Since icu_capi lives in the chromium repo, v8 cannot
# be atomically upgraded alongside icu_capi changes. Instead, we have some
# `defines` here that let v8 detect which version of icu_capi is vendored.
#
# In case we are vendoring multiple versions of icu_capi, it is acceptable
# to have multiple `defines`.
#
# It is not mandatory to update the `defines` list every time icu_capi
# updates; it is just a convenient tool to use as needed.
config("icu_capi_versioning_defines") {
  defines = [ "ICU_CAPI_VERSION_2" ]
}

# v8 includes headers and targets from paths that include a specific crate
# epoch in a directory name (e.g. `v2`).  To insulate v8 from the exact
# paths:
#
# * We have some indirection via `group` / `public_deps` to forward to the
#   right target
# * We set `include_dirs` by depending on the right config via `public_configs`
#
# We also opportunistically have a public dependency on the `defines` `config`
# above.
group("icu_capi") {
  public_configs = [
    ":icu_capi_include_dirs",
    ":icu_capi_versioning_defines",
  ]
  public_deps = [ "//third_party/rust/icu_capi/v2:lib" ]
}

config("icu_capi_include_dirs") {
  include_dirs = [
    "//third_party/rust/chromium_crates_io/vendor/icu_capi-v2/bindings/cpp",
  ]
}
