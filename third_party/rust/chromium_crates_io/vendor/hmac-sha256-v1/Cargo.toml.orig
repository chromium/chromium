[package]
name = "hmac-sha256"
version = "1.1.15"
authors = ["Frank Denis <github@pureftpd.org>"]
edition = "2021"
description = "SHA256 hashing, HMAC-SHA256 authentication, and HKDF-SHA256 key derivation in pure Rust, with no_std support"
keywords = ["sha256", "hmac", "hkdf", "hash", "no-std"]
repository = "https://github.com/jedisct1/rust-hmac-sha256"
homepage = "https://github.com/jedisct1/rust-hmac-sha256"
categories = ["algorithms", "cryptography", "no-std"]
license = "ISC"

[dependencies]
digest09 = { package = "digest", version = "0.9.0", optional = true }
digest010 = { package = "digest", version = "0.10.7", features = ["oid"], optional = true }
digest011 = { package = "digest", version = "0.11.3", features = ["oid"], optional = true }

[features]
default = []
opt_size = []
traits = ["traits09", "traits010", "traits011"]
traits09 = ["digest09"]
traits010 = ["digest010"]
traits011 = ["digest011"]

[profile.release]
lto = true
panic = "abort"
opt-level = 3

[[test]]
name = "test_digest011"
required-features = ["traits011"]
