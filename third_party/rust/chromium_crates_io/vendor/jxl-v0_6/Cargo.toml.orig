[package]
name = "jxl"
description = "High performance Rust implementation of a JPEG XL decoder"
version = "0.6.0"
readme = "../README.md"
keywords = ["jpeg-xl", "decoder"]
categories = ["multimedia::images"]
authors = ["Luca Versari <veluca93@gmail.com>"]
repository = "https://github.com/libjxl/jxl-rs"
edition = "2024"
license = "BSD-3-Clause"

exclude = ["resources/"]

[dependencies]
jxl_transforms = { path = "../jxl_transforms", version = "=0.6.0" }
thiserror = "2.0"
byteorder = "1.4.3"
num-derive = "0.4"
num-traits = "0.2.14"
array-init = "2.0.0"
tracing = { version = "0.1.40", optional = true }
jxl_macros = { path = "../jxl_macros", version = "=0.6.0" }
jxl_simd = { path = "../jxl_simd", version = "=0.6.0" }
shuttle = { version = "0.9", optional = true }

[dev-dependencies]
arbtest = "0.3.2"
paste = "1.0.15"
rand = "0.9.2"
rand_xorshift = "0.4.0"
test-log = { version = "0.2.16", features = ["trace"] }
jxl_macros = { path = "../jxl_macros", version = "=0.6.0", features = ["test"] }

# rayon (criterion's default feature) doesn't support wasm32
[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
criterion = { version = "0.7.0", default-features = false, features = ["html_reports", "plotters", "cargo_bench_support"] }

[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies]
criterion = { version = "0.7.0", features = ["html_reports"] }

[features]
default = ["all-simd"]

shuttle = ["dep:shuttle"]

all-simd = ["jxl_simd/all-simd"]
sse42 = ["jxl_simd/sse42"]
avx = ["jxl_simd/avx"]
avx512 = ["jxl_simd/avx512"]
neon = ["jxl_simd/neon"]
simd128 = ["jxl_simd/simd128"]

[lints]
workspace = true

[[bench]]
name = "blending"
harness = false
