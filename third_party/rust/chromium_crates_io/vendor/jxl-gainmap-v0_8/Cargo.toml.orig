[package]
name = "jxl-gainmap"
description = "Gain-map bundle parsing helpers for the jxl decoder"
version = "0.8.0"
readme = "README.md"
keywords = ["jpeg-xl", "gain-map"]
categories = ["multimedia::images"]
repository = "https://github.com/libjxl/jxl-rs"
edition = "2024"
license = "BSD-3-Clause"
rust-version.workspace = true

[dependencies]
jxl = { path = "../jxl", version = "=0.8.0", default-features = false }

[lints]
workspace = true
