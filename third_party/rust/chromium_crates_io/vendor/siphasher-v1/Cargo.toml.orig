[package]
authors = ["Frank Denis <github@pureftpd.org>"]
keywords = ["siphash", "hash", "hasher", "keyed-hash", "no-std"]
license = "MIT OR Apache-2.0"
name = "siphasher"
description = "SipHash-2-4 and SipHash-1-3 keyed hash functions in pure Rust, with 64-bit and 128-bit output and no_std support"
repository = "https://github.com/jedisct1/rust-siphash"
homepage = "https://docs.rs/siphasher"
documentation = "https://docs.rs/siphasher"
readme = "README.md"
version = "1.0.4"
categories = ["algorithms", "cryptography"]
edition = "2018"

[profile.release]
lto = true
panic = "abort"
opt-level = 3

[dependencies]
serde = { version = "1.0", features = ["derive"], optional = true }
serde_json = { version = "1.0", optional = true }

[features]
default = ["std"]
serde_std = ["std", "serde/std"]
serde_no_std = ["serde/alloc"]
std = []
