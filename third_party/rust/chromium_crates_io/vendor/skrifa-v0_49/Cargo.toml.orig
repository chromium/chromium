[package]
name = "skrifa"
version = "0.49.0"
description = "Metadata reader and glyph scaler for OpenType fonts."
readme = "README.md"
categories = ["text-processing", "parsing", "graphics"]

rust-version.workspace = true
edition.workspace = true
license.workspace = true
repository.workspace = true

[package.metadata.docs.rs]
# To build locally:
# RUSTDOCFLAGS="--cfg docsrs" cargo +nightly doc --all-features
all-features = true

[features]
default = ["std", "autohint_shaping"]
std = ["read-fonts/std"]
# Enables extended shaping support for the autohinter. Enabled by default.
# This exists as a feature because shaping support is "best effort" and
# we want the ability to disable it for testing against FreeType.
autohint_shaping = []
# Does nothing. The cubic outlines it once enabled are now always read.
spec_next = ["read-fonts/spec_next"]
libm = ["dep:core_maths", "read-fonts/libm"]
# Maps characters to the glyphs of Type 1 and standalone CFF fonts through
# their glyph names, as FreeType does, at the cost of the Adobe Glyph List's
# size. Without it those fonts map no characters, so the automatic hinter
# finds no blue zones in them.
agl = ["read-fonts/agl"]

[dependencies]
smallvec = { workspace = true }
read-fonts = { workspace = true, default-features = false }
core_maths = { workspace = true, optional = true }
bytemuck = { workspace = true }
yoke = { workspace = true }
once_cell = { workspace = true }

[dev-dependencies]
font-test-data = { workspace = true }
read-fonts = { workspace = true, features = [
    "scaler_test",
    "serde",
] }
serde = "1.0"
serde_json = "1.0"
pretty_assertions = "1.3.0"
kurbo.workspace = true
