+/// Fixed predictor for samples of up-to 64 bits. See `fixed_predict` for details.
+fn fixed_predict_wide(order: u32, buf: &mut [i64]) {
+    debug_assert!(order <= 4);
+
+    // Wrapping arithmetic is used throughout so that malformed streams cannot cause a panic.
+    match order {
+        0 => (),
+        // s(i) = 1*s(i-1)
+        1 => {
+            for i in 1..buf.len() {
+                buf[i] = buf[i].wrapping_add(buf[i - 1]);
+            }
+        }
+        // s(i) = 2*s(i-1) - 1*s(i-2)
+        2 => {
+            for i in 2..buf.len() {
+                let p = buf[i - 1].wrapping_mul(2).wrapping_sub(buf[i - 2]);
+                buf[i] = buf[i].wrapping_add(p);
+            }
+        }
+        // s(i) = 3*s(i-1) - 3*s(i-2) + 1*s(i-3)
+        3 => {
+            for i in 3..buf.len() {
+                let p = buf[i - 1]
+                    .wrapping_mul(3)
+                    .wrapping_sub(buf[i - 2].wrapping_mul(3))
+                    .wrapping_add(buf[i - 3]);
+                buf[i] = buf[i].wrapping_add(p);
+            }
+        }
+        // s(i) = 4*s(i-1) - 6*s(i-2) + 4*s(i-3) - 1*s(i-4)
+        4 => {
+            for i in 4..buf.len() {
+                let p = buf[i - 1]
+                    .wrapping_mul(4)
+                    .wrapping_sub(buf[i - 2].wrapping_mul(6))
+                    .wrapping_add(buf[i - 3].wrapping_mul(4))
+                    .wrapping_sub(buf[i - 4]);
+                buf[i] = buf[i].wrapping_add(p);
+            }
+        }
+        _ => unreachable!(),
+    };
+}
+
+/// Linear Predictive Coding (LPC) decoder for samples of up-to 64 bits. The order of the predictor
+/// is the length of `coeffs`. Coefficients must be stored in reverse order such that the last
+/// coefficient is applied to the most recent sample. It is expected that the first `coeffs.len()`
+/// samples in `buf` are warm-up samples.
+///
+/// This predictor is only used for the 33-bit Side channel of 32-bit stereo streams, therefore it
+/// is not as optimized as `lpc_predict`. For valid streams, the products of a (up-to) 15-bit
+/// coefficient and a 33-bit sample, and the sum of up-to 32 of such products, cannot overflow an
+/// i64. Wrapping arithmetic is used so that malformed streams cannot cause a panic.
+fn lpc_predict_wide(coeffs: &[i32], coeff_shift: u32, buf: &mut [i64]) {
+    let order = coeffs.len();
+
+    debug_assert!(order <= buf.len());
+
+    for i in order..buf.len() {
+        let predicted = coeffs
+            .iter()
+            .zip(&buf[i - order..i])
+            .fold(0i64, |acc, (&c, &s)| acc.wrapping_add(i64::from(c).wrapping_mul(s)));
+
+        buf[i] = buf[i].wrapping_add(predicted >> coeff_shift);
     }
 }
