+// When the frame bits per sample is 32, the Side channel of a stereo pair requires 33 bits per
+// sample and cannot be represented by an i32. In this case, the Side channel is decoded into a
+// separate i64 buffer, and the following functions are used to restore the Left and Right channels.
+// The restored channel that would otherwise replace the Side channel is written into `out`, which is
+// the Side channel's i32 plane.
+
+fn decorrelate_left_side_wide(left: &[i32], side: &[i64], out: &mut [i32]) {
+    for ((o, &l), &s) in out.iter_mut().zip(left).zip(side) {
+        // R = L - S
+        *o = i64::from(l).wrapping_sub(s) as i32;
+    }
+}
+
+fn decorrelate_mid_side_wide(mid: &mut [i32], side: &[i64], out: &mut [i32]) {
+    for ((m, o), &s) in mid.iter_mut().zip(out.iter_mut()).zip(side) {
+        // See decorrelate_mid_side for the derivation. The intermediate values require up-to 34
+        // bits, so the computation must be performed with 64-bit integers.
+        let mid = (i64::from(*m) << 1) | (s & 1);
+        *m = (mid.wrapping_add(s) >> 1) as i32;
+        *o = (mid.wrapping_sub(s) >> 1) as i32;
+    }
+}
+
+fn decorrelate_right_side_wide(right: &[i32], side: &[i64], out: &mut [i32]) {
+    for ((o, &r), &s) in out.iter_mut().zip(right).zip(side) {
+        // L = S + R
+        *o = s.wrapping_add(i64::from(r)) as i32;
+    }
+}
+
+/// Get a mutable slice of `len` samples from the wide (i64) scratch buffer, growing it if required.
+fn wide_scratch(wide: &mut Vec<i64>, len: usize) -> &mut [i64] {
+    if wide.len() < len {
+        wide.resize(len, 0);
+    }
+    &mut wide[..len]
+}
