+        decoder.decode_headers().unwrap();
+        let mut raw = decoder.raw_output();
+        raw.set_input_complete();
+        let mut y = [0xA5; 64];
+        let mut u = [0xA5; 64];
+        let mut v = [0xA5; 64];
+        assert!(raw
+            .decode_next_imcu_row(&mut [&mut y, &mut u, &mut v], &[8; 3])
+            .unwrap_err()
+            .is_recoverable_eof());
+        assert!(y.iter().chain(u.iter()).chain(v.iter()).all(|&value| value == 0xA5));
+    }
