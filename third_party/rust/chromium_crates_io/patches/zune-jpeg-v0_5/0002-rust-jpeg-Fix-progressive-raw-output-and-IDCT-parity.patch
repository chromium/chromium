+                    }
+                }
+                let mut expected = [0; 64];
+                let mut reference_coefficients = coefficients;
+                idct_int(&mut reference_coefficients, &mut expected, 8);
+                check_idct(coefficients, expected, reduced);
+            }
+        }
+    }
