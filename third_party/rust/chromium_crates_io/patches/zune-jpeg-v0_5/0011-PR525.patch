+    y_row: &[i16], cb_row: &[i16], cr_row: &[i16], out_row: &mut [u8], width: usize
+) {
+    assert!(
+        width >= 16
+            && y_row.len() >= width
+            && cb_row.len() >= width
+            && cr_row.len() >= width
+            && out_row.len() / 4 >= width
