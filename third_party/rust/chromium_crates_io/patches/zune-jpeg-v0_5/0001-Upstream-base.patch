+        if !self.decoder.scanline_state.started {
+            match self.start()? {
+                ScanlineStatus::Ready => {}
+                ScanlineStatus::NeedMoreInput => {
+                    return Ok(ScanlineReadStatus::NeedMoreInput)
+                }
+                ScanlineStatus::Complete => return Ok(ScanlineReadStatus::Complete)
+            }
+        }
