+    #[test]
+    fn final_scanline_input_preserves_default_and_strict_suspension() {
+        let data = dc_only_progressive_jpeg(false);
+        for strict in [false, true] {
+            let mut decoder = JpegDecoder::new_with_options(
+                ZCursor::new(&data),
