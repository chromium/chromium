+        &mut self, output: &mut McuDecodeOutput<'_, '_>
+    ) -> Result<(), DecodeErrors> {
+        if self.is_progressive {
+            self.render_buffered_progressive_stripe(output)
+        } else {
+            self.render_buffered_baseline_stripe(output)
