+    #[test]
+    fn test_exact_quantization() {
+        let row = [0u8, 0, 0, 246, 255, 255, 255, 255];
+        let mut data = Vec::with_capacity(64);
+        for _ in 0..8 {
+            data.extend_from_slice(&row);
