# Ported from //third_party/icu/patches/locale1.patch.
# Overrides Korean (ko, ko-CN, ko-KP) Gregorian yMMMd day-interval spacing
# ("y년 M월 d일~d일" -> "y년 M월 d일 ~ d일") and North American metazone long
# names (America_Central, America_Eastern, America_Mountain, America_Pacific)
# to use "북미 ..." / "북미 로키 산맥 ..." instead of "미 ...".
diff -ruN a/datetime/patterns/range/date/gregorian/v1/ym0d/ko-CN.json b/datetime/patterns/range/date/gregorian/v1/ym0d/ko-CN.json
--- a/datetime/patterns/range/date/gregorian/v1/ym0d/ko-CN.json
+++ b/datetime/patterns/range/date/gregorian/v1/ym0d/ko-CN.json
@@ -12,7 +12,7 @@
     {
       "header": 42,
       "patterns": [
-        "y년 M월 d일~d일",
+        "y년 M월 d일 ~ d일",
         "y년 MMM d일~MMM d일",
         "y년 MMM d일~y년 MMM d일"
       ]
diff -ruN a/datetime/patterns/range/date/gregorian/v1/ym0d/ko.json b/datetime/patterns/range/date/gregorian/v1/ym0d/ko.json
--- a/datetime/patterns/range/date/gregorian/v1/ym0d/ko.json
+++ b/datetime/patterns/range/date/gregorian/v1/ym0d/ko.json
@@ -12,7 +12,7 @@
     {
       "header": 42,
       "patterns": [
-        "y년 M월 d일~d일",
+        "y년 M월 d일 ~ d일",
         "y년 MMM d일~MMM d일",
         "y년 MMM d일~y년 MMM d일"
       ]
diff -ruN a/datetime/patterns/range/date/gregorian/v1/ym0d/ko-KP.json b/datetime/patterns/range/date/gregorian/v1/ym0d/ko-KP.json
--- a/datetime/patterns/range/date/gregorian/v1/ym0d/ko-KP.json
+++ b/datetime/patterns/range/date/gregorian/v1/ym0d/ko-KP.json
@@ -12,7 +12,7 @@
     {
       "header": 42,
       "patterns": [
-        "y년 M월 d일~d일",
+        "y년 M월 d일 ~ d일",
         "y년 MMM d일~MMM d일",
         "y년 MMM d일~y년 MMM d일"
       ]
