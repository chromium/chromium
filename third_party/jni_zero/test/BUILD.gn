import("//build/config/android/rules.gni")
import("//testing/test.gni")
import("//third_party/jni_zero/jni_zero.gni")

# Most targets in this file are compile tests only, to make sure the generated
# code compiles for all edgecases. jni_zero_unittests contains runnable tests.
testonly = true

# Runnable C++ tests. Built both as a standalone binary and as part of
# base_unittests so that CQ bots cover them.
source_set("jni_zero_unittests_sources") {
  sources = [ "jni_unique_ptr_unittest.cc" ]
  deps = [
    "//testing/gtest",
    "//third_party/jni_zero",
  ]
}

test("jni_zero_unittests") {
  deps = [
    ":jni_zero_unittests_sources",
    "//testing/gtest:gtest_main",
  ]
}

generate_jni("test_jni") {
  sources = [
    "java/src/org/jni_zero/SampleForAnnotationProcessor.java",
    "java/src/org/jni_zero/SampleForTests.java",
  ]
}

android_library("stubs_java") {
  sources = [
    "java/src/org/stubs/MyClass.java",
    "java/src/org/stubs/MyInterface.java",
  ]
}

android_library("test_java") {
  sources = [
    "java/src/org/jni_zero/NullMarked.java",
    "java/src/org/jni_zero/SampleForAnnotationProcessor.java",
    "java/src/org/jni_zero/SampleForTests.java",
    "java/src/org/jni_zero/SampleUnderSamePackage.java",
    "java/src/org/jni_zero/TinySample.java",
    "java/src/org/jni_zero/extrapackage/ImportsTinySample.java",
  ]

  deps = [
    ":stubs_java",
    ":test_jni_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

source_set("test_native_side") {
  deps = [
    ":test_jni",
    "//third_party/jni_zero",
  ]
  sources = [
    "sample_for_tests.cc",
    "sample_for_tests.h",
    "stub_conversions.h",
  ]
}

shared_library_with_jni("libjni_zero_compile_check") {
  sources = [ "../sample/sample_entry_point.cc" ]

  deps = [
    ":test_native_side",
    "//third_party/jni_zero",
  ]
  java_targets = [ ":jni_zero_compile_check_apk" ]
  remove_uncalled_jni = true
}

# This apk is meant to be a compile only test to make sure the generated code,
# both java and native, compiles for all the edgecases. APK itself is not meant
# to be run or installed on a device since a lot of internal implementations are
# empty stubs and are just meant for the compiler or linker to see.
android_apk("jni_zero_compile_check_apk") {
  apk_name = "JniZeroCompileCheck"
  android_manifest = "../sample/AndroidManifest.xml"
  deps = [ ":test_java" ]
  shared_libraries = [ ":libjni_zero_compile_check" ]
  srcjar_deps = [ ":libjni_zero_compile_check__jni_registration" ]
  proguard_enabled = true
}

generate_jni("jni_processor_test_jni") {
  sources = [ "java/src/org/jni_zero/JniProcessorTest.java" ]
  enable_resolved_types_validation = true
}

android_library("test_jni_processor_java") {
  sources = [
    "java/src/org/jni_zero/JniProcessorTest.java",
    "java/src/org/jni_zero/OuterClass.java",
  ]
  deps = [
    ":jni_processor_test_jni_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  annotation_processor_deps = [ "//third_party/jni_zero:validator_processor" ]

  _resolved_types_path =
      "$target_gen_dir/jni_processor_test_jni.resolved_types.txt"
  processor_args_javac = [ "jni_zero.resolved_types_path=" +
                           rebase_path(_resolved_types_path, root_build_dir) ]
}
