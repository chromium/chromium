Drop std::has_denorm and std::has_denorm_loss, deprecated in C++23.

Chromium commit 15a7f54609572 (crbug.com/388070065). Upstream in
e721741.

diff --git a/src/int256.h b/src/int256.h
index 4c464a4978412..7d7f4937f1745 100644
--- a/src/int256.h
+++ b/src/int256.h
@@ -469,8 +469,11 @@ class numeric_limits<rlwe::uint256> {
   static constexpr bool has_infinity = false;
   static constexpr bool has_quiet_NaN = false;
   static constexpr bool has_signaling_NaN = false;
+// has_denorm and has_denorm_loss are deprecated in C++23.
+#if !defined(__cplusplus) || __cplusplus < 202302L
   static constexpr float_denorm_style has_denorm = denorm_absent;
   static constexpr bool has_denorm_loss = false;
+#endif
   static constexpr float_round_style round_style = round_toward_zero;
   static constexpr bool is_iec559 = false;
   static constexpr bool is_bounded = true;
