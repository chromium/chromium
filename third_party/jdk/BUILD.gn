import("//build/config/android/jdk.gni")

config("jdk") {
  include_dirs = [ "$android_jdk_home/include" ]
  if (host_os == "mac") {
    include_dirs += [ "$android_jdk_home/include/darwin" ]
  } else {
    include_dirs += [ "$android_jdk_home/include/linux" ]
  }
}

group("java_data") {
  data = [
    "$android_jdk_home/bin/java",
    "$android_jdk_home/bin/java.chromium",
    "$android_jdk_home/bin/jcmd",
    "$android_jdk_home/conf/",
    "$android_jdk_home/lib/",
    "//build/android/java_home.py",
  ]
}
