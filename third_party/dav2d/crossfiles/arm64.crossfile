[binaries]
c = 'clang'
ar = 'llvm-ar'

# Copied from //third_party/ffmpeg's build_ffmpeg.py script. Does not use all
# the cflags listed there since dav2d doesn't currently need such specificity.
[built-in options]
c_args = ['-march=armv8-a', '--target=aarch64-linux-gnu', '--sysroot=@DIRNAME@/../../../build/linux/debian_bullseye_arm64-sysroot']
c_link_args = ['--target=aarch64-linux-gnu', '--sysroot=@DIRNAME@/../../../build/linux/debian_bullseye_arm64-sysroot', '-fuse-ld=lld']

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'
