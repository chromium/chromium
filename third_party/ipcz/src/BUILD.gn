source_set("fuzzer_sources") {
  testonly = true
  sources = [
    "fuzzer/driver.cc",
    "fuzzer/driver.h",
    "fuzzer/fuzzer.cc",
    "fuzzer/fuzzer.h",
    "fuzzer/ipcz_fuzzer_testcase.cc",
    "fuzzer/ipcz_fuzzer_testcase.h",
  ]
  deps = [
    ":ipcz",
    ":reference_drivers",
    ":util",
    "//base",
    "//third_party/abseil-cpp:absl",
  ]
  public_configs = [
    ":ipcz_include_dir",
    ":ipcz_include_src_dir",
  ]
}

fuzzer_test("ipcz_fuzzer") {
  sources = [ "fuzzer/ipcz_fuzzer.cc" ]
  deps = [
    ":fuzzer_sources",
    "//third_party/abseil-cpp:absl",
  ]
  include_dirs = [
    "../include",
    ".",
  ]
}
