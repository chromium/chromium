Drop the OpenSSLInit() call

With BoringSSL OpenSSLInit() does nothing: its body in openssl_init.cc
is under #if !defined(OPENSSL_IS_BORINGSSL). Dropping the call keeps
openssl_init.{h,cc} out of the import, so Chromium does not build two
files for an empty function.

Chromium commits 85145d1e68b27 and 83c559e0cf152.

diff --git a/src/private_join_and_compute/crypto/context.cc b/src/private_join_and_compute/crypto/context.cc
index 4dd22eb3039a0..51a8651db3825 100644
--- a/src/private_join_and_compute/crypto/context.cc
+++ b/src/private_join_and_compute/crypto/context.cc
@@ -22,7 +22,6 @@
 #include "absl/strings/str_cat.h"
 #include "absl/strings/string_view.h"
 #include "private_join_and_compute/crypto/openssl.inc"
-#include "private_join_and_compute/crypto/openssl_init.h"
 
 namespace private_join_and_compute {
 
@@ -39,7 +38,6 @@ Context::Context()
       one_bn_(CreateBigNum(1)),
       two_bn_(CreateBigNum(2)),
       three_bn_(CreateBigNum(3)) {
-  OpenSSLInit();
   CHECK(RAND_status()) << "OpenSSL PRNG is not properly seeded.";
   HMAC_CTX_init(&hmac_ctx_);
 }
