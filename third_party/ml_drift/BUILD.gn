import("//third_party/flatbuffers/flatbuffer.gni")
import("//third_party/litert/features.gni")
import("//third_party/tflite/features.gni")

# In google3 ml_drift maintains a build file per directory and a target per
# file. This structure can be mirrored in chrome, but it proved tedious to
# maintain. Instead a single build file is used. Having a single build file with
# a single target is not possible, because gn does not allow a single target to
# have multiple files with the same name (e.g. util.cc and task/util.cc cannot
# exist in the same target). The structure used here is to put as many files as
# possible into the main target (ml_drift) and create additional targets for
# duplicate file names. To make the process of creating additional targets
# easier, a template is used (ml_drift_source_set).

config("ml_drift_config") {
  cflags = [
    "-Wno-deprecated-copy",
    "-Wno-deprecated-copy-with-user-provided-copy",
    "-Wno-deprecated-declarations",  # crbug.com/376315414
    "-Wno-ignored-qualifiers",
    "-Wno-macro-redefined",
    "-Wno-shadow",
    "-Wno-sign-compare",
    "-Wno-switch",  # TODO(b/388311883): Remove
    "-Wno-unused-function",
    "-Wno-unused-private-field",
  ]
  defines = [ "DAWN_ENABLE_BACKEND_VULKAN" ]

  include_dirs = [
    "src",
    "$root_gen_dir/third_party/ml_drift/src",
  ]
}

if (build_litert_with_ml_drift) {
  template("ml_drift_source_set") {
    source_set(target_name) {
      if (defined(invoker.visibility)) {
        visibility = invoker.visibility
      }
      sources = invoker.sources
      public_deps = [
        ":ml_drift_flatbuffers",
        "//third_party/abseil-cpp:absl",
        "//third_party/dawn/include/dawn:cpp_headers",
        "//third_party/dawn/src/dawn/native:headers",
        "//third_party/farmhash",
        "//third_party/flatbuffers",
        "//third_party/fp16",
        "//third_party/pthreadpool",
        "//third_party/xnnpack",
      ]
      if (use_litert_tflite) {
        public_deps += [ "//third_party/litert:tflite_public_headers" ]
      } else {
        public_deps += [ "//third_party/tflite:tflite_public_headers" ]
      }
      if (defined(invoker.public_deps)) {
        public_deps += invoker.public_deps
      }
      public_configs = [
        ":ml_drift_config",
        "//third_party/tflite:tflite_config",
      ]
      configs -= [ "//build/config/compiler:chromium_code" ]
      configs += [
        "//build/config/compiler:no_chromium_code",
        "//build/config/compiler:rtti",
        "//third_party/gemmlowp:gemmlowp_include",
      ]
    }
  }

