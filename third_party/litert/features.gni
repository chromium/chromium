declare_args() {
  # This enables building LiteRT with XNNPACK.
  build_litert_with_xnnpack = current_cpu != "arm" && !is_fuchsia
}

declare_args() {
  # This enables building LiteRT with the statically linked ML Drift WebGPU
  # accelerator.
  build_litert_with_ml_drift = false
}
