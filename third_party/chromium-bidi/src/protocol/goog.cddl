; Chromium-specific `goog:` extensions of the WebDriver BiDi protocol (BiDi+).
;
; This file is the source of truth for the `goog:` commands and events. Types
; referenced from the WebDriver BiDi specification (e.g.
; `browsingContext.BrowsingContext`) are imported from the core generated types.
;
; After editing, regenerate and format the TypeScript and Zod definitions:
;   tools/update_bidi_types.py --cddl-file src/protocol/goog.cddl \
;     --ts-file src/protocol/generated/goog.ts \
;     --zod-file src/protocol-parser/generated/goog.ts
;   ./tools/node.py node_modules/prettier/bin/prettier.cjs --write \
;     src/protocol/generated/goog.ts src/protocol-parser/generated/goog.ts
; The full `tools/update_bidi_types.py` run regenerates them as well.
;
; Convention:
; * Command `goog:<module>.<command>` is described by the group
;   `goog_<module>.<Command>` (generated as `Goog<Module>.<Command>`), so
;   `<module>` never shadows a core WebDriver BiDi module import.

GoogCommand = (
  goog_browsingContext.GetAccessibilityTree //
  goog_cdp.GetSession //
  goog_cdp.ResolveRealm //
  goog_cdp.SendCommand //
  goog_session.SetAcl
)

GoogResult = (
  goog_browsingContext.GetAccessibilityTreeResult /
  goog_cdp.GetSessionResult /
  goog_cdp.ResolveRealmResult /
  goog_cdp.SendCommandResult /
  goog_session.SetAclResult
)

GoogEvent = (
  goog_cdp.Event //
  goog_session.Changed
)

; `goog:browsingContext` module: extensions of the `browsingContext` module.

; An accessibility node and its descendants in the accessibility tree. The type
; mirrors `browsingContext.AccessibilityNode` of the specification draft
; https://github.com/w3c/webdriver-bidi/pull/1216.
goog_browsingContext.AccessibilityNode = {
  accessibilityId: text,
  children: [* goog_browsingContext.AccessibilityNode],
  ; The accessible name. The field is absent if the name is the empty string.
  ? name: text,
  ; The other computed accessibility properties, e.g. `focusable`. The value of
  ; a relation property, e.g. `labelledby`, is the space-separated list of the
  ; shared IDs of the related DOM nodes.
  ? properties: { * text => text },
  ? role: text,
  ; The shared ID of the DOM node, if the accessibility node has a DOM node.
  ? sharedId: script.SharedId,
}

; Returns the accessibility tree of the active document of the given top-level
; browsing context. The tree excludes the documents of the child contexts.
goog_browsingContext.GetAccessibilityTree = (
  method: "goog:browsingContext.getAccessibilityTree",
  params: goog_browsingContext.GetAccessibilityTreeParameters
)

goog_browsingContext.GetAccessibilityTreeParameters = {
  context: browsingContext.BrowsingContext,
}

goog_browsingContext.GetAccessibilityTreeResult = {
  root: goog_browsingContext.AccessibilityNode,
}

; `goog:cdp` module: direct access to the Chrome DevTools Protocol.
; https://chromedevtools.github.io/devtools-protocol

goog_cdp.SessionId = text

; Returns the default CDP session of the given browsing context.
goog_cdp.GetSession = (
  method: "goog:cdp.getSession",
  params: goog_cdp.GetSessionParameters
)

goog_cdp.GetSessionParameters = {
  context: browsingContext.BrowsingContext,
}

goog_cdp.GetSessionResult = {
  ? session: goog_cdp.SessionId,
}

; Resolves a BiDi realm to its CDP execution context ID.
goog_cdp.ResolveRealm = (
  method: "goog:cdp.resolveRealm",
  params: goog_cdp.ResolveRealmParameters
)

goog_cdp.ResolveRealmParameters = {
  realm: script.Realm,
}

goog_cdp.ResolveRealmResult = {
  executionContextId: int,
}

; Runs the given CDP command and returns its result.
goog_cdp.SendCommand = (
  method: "goog:cdp.sendCommand",
  params: goog_cdp.SendCommandParameters
)

; CDDL cannot tie `method` and `params` to the CDP command types, so
; `src/protocol/cdp.ts` narrows both with `devtools-protocol`.
goog_cdp.SendCommandParameters = {
  ; CDP method, e.g. `Page.navigate`.
  method: text,
  ? params: { * text => any },
  ? session: goog_cdp.SessionId,
}

goog_cdp.SendCommandResult = {
  result: any,
  ? session: goog_cdp.SessionId,
}

; A CDP event. The `method` is `"goog:cdp." + params.event`, e.g.
; `"goog:cdp.Page.loadEventFired"`. CDDL cannot tie `method` to `params.event`,
; nor to the CDP event types, so `src/protocol/cdp.ts` narrows both with
; `devtools-protocol`.
goog_cdp.Event = (
  method: text,
  params: goog_cdp.EventParameters
)

goog_cdp.EventParameters = {
  ; CDP event name, e.g. `Page.loadEventFired`.
  event: text,
  params: any,
  ? session: goog_cdp.SessionId,
}

; `goog:session` module: restricted sessions with an access control list (ACL).

; Commands allowed, and events delivered, for a navigable or for the whole
; session. Unsupported commands and events grant nothing.
goog_session.AclEntry = {
  ? commands: [* text],
  ? events: [* text],
}

; Session-wide default entry and entries per top-level navigable. Unknown or
; non-top-level navigables grant nothing.
goog_session.Acl = {
  ? default: goog_session.AclEntry,
  ? perNavigable: { * browsingContext.BrowsingContext => goog_session.AclEntry },
}

; Requests or retracts access. `acl` is the full desired ACL, not a diff,
; so the call is idempotent. `reason` tells the user why the access is
; needed and should be sent when requesting it; it is untrusted client text.
; The result has the ACL now in effect and, if the browser refused part of the
; request, the refused entries in `denied`, with an optional `reason` from the
; browser.
; * `goog:session.setAcl` requests are processed one at a time, in order. Other
;   commands don't wait for them and are checked against the ACL in effect.
; * A malformed `acl` fails with `invalid argument` and changes nothing.
; * Always allowed in restricted sessions without an ACL grant.
goog_session.SetAcl = (
  method: "goog:session.setAcl",
  params: goog_session.SetAclParameters
)

goog_session.SetAclParameters = {
  acl: goog_session.Acl,
  ? reason: text,
}

goog_session.SetAclResult = {
  acl: goog_session.Acl,
  ? denied: {
    acl: goog_session.Acl,
    ? reason: text,
  },
}

; Emitted whenever the browser updates a restricted session's ACL (e.g. when
; the user revokes permissions).
; * Always delivered to restricted sessions without `session.subscribe` and
;   not controlled by the ACL.
goog_session.Changed = (
  method: "goog:session.changed",
  params: goog_session.ChangedParameters
)

goog_session.ChangedParameters = {
  acl: goog_session.Acl,
  ? reason: text,
}
