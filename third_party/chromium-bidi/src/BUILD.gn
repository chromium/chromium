import(
    "//third_party/devtools-frontend/src/scripts/build/typescript/typescript.gni")
import("../tools/build/bidi_module.gni")

if (build_with_chromium) {
  devtools_protocol_types_deps = [ "//third_party/blink/public/devtools_protocol:protocol_typescript_definitions" ]
  devtools_protocol_types_dir =
      "$root_gen_dir/third_party/blink/public/devtools_protocol/types"
  devtools_protocol_types_files = [
    "$devtools_protocol_types_dir/protocol.d.ts",
    "$devtools_protocol_types_dir/protocol-mapping.d.ts",
  ]
} else {
  devtools_protocol_types_deps = []
  devtools_protocol_types_files = []
}

