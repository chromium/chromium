enum SemanticEmbedderTaskType {
  "semantic-similarity",
  "clustering",
  "classification",
  "retrieval-query",
  "retrieval-document"
};

dictionary SemanticEmbedderCreateCoreOptions {
  // The requested embedding space identifier, e.g. "embeddinggemma-300m".
  // availability() and create() express support for specific embedding spaces.
  required DOMString embeddingSpace;
};

dictionary SemanticEmbedderCreateOptions : SemanticEmbedderCreateCoreOptions {
  AbortSignal signal;
  CreateMonitorCallback monitor;
};

dictionary SemanticEmbedderEmbedOptions {
  AbortSignal signal;
  SemanticEmbedderTaskType taskType;
};

enum SemanticEmbedderInputType {
  "text"
};

dictionary SemanticEmbedderInput {
  required SemanticEmbedderInputType type;
  required DOMString value;
};

// A bare string is shorthand for { type: "text", value: providedValue }.
typedef (DOMString or SemanticEmbedderInput) SemanticEmbedderInputItem;
typedef (
  SemanticEmbedderInputItem or sequence<SemanticEmbedderInputItem>
) SemanticEmbedderInputs;

dictionary SemanticEmbedderResult {
  required sequence<ContentEmbedding> embeddings;
};

dictionary ContentEmbedding {
  required Float32Array values;
  // The embedding space of `values`.
  required DOMString embeddingSpace;
};

dictionary SemanticEmbedderSpaceInfo {
  required DOMString embeddingSpace;
  // When support for this space ends; null if none is scheduled.
  EpochTimeStamp? shutdownDate = null;
};

dictionary SemanticEmbedderParams {
  required sequence<SemanticEmbedderSpaceInfo> supportedSpaces;
};

[
  Exposed(Window AIEmbeddingsAPI, Worker AIEmbeddingsAPIForWorkers),
  RuntimeEnabled=AIEmbeddingsAPI,
  SecureContext
]
interface SemanticEmbedder {
  [
    MeasureAs=SemanticEmbedder_Availability,
    CallWith=ScriptState,
    RaisesException
  ]
  static Promise<Availability> availability(
    SemanticEmbedderCreateCoreOptions options
  );

  [
    MeasureAs=SemanticEmbedder_Create,
    CallWith=ScriptState,
    RaisesException
  ]
  static Promise<SemanticEmbedder> create(
    SemanticEmbedderCreateOptions options
  );

  // Lists the supported embedding spaces, or none if the API is turned off.
  // Rejects with NotAllowedError if the permissions policy blocks the API.
  [
    MeasureAs=SemanticEmbedder_Params,
    CallWith=ScriptState,
    RaisesException
  ]
  static Promise<SemanticEmbedderParams> params();

  [
    MeasureAs=SemanticEmbedder_Embed,
    CallWith=ScriptState,
    RaisesException
  ]
  Promise<SemanticEmbedderResult> embed(
    SemanticEmbedderInputs input,
    optional SemanticEmbedderEmbedOptions options = {}
  );

  // The space this embedder produces vectors in; the value passed to create().
  [MeasureAs=SemanticEmbedder_EmbeddingSpace]
  readonly attribute DOMString embeddingSpace;

  // The input token limit, including control tokens the model adds.
  [MeasureAs=SemanticEmbedder_MaxInputTokens]
  readonly attribute unsigned long maxInputTokens;

  [
    MeasureAs=SemanticEmbedder_Destroy,
    CallWith=ScriptState,
    RaisesException
  ]
  void destroy();
};
