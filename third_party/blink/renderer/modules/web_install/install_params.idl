// https://github.com/MicrosoftEdge/MSEdgeExplainers/blob/main/WebInstall/explainer.md

dictionary InstallParams {
  // Relative URLs are resolved against the current document's base URL.
  required USVString manifest;
  // Relative URLs are resolved against the current document's base URL. Pass
  // undefined, null, or omit completely if the JSON at `manifest` contains an
  // `id` field.
  USVString? manifestId;
};
