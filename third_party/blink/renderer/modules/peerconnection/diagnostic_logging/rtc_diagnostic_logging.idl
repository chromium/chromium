// https://w3c.github.io/webrtc-extensions/#diagnostic-logging

[
    ImplementedAs=RTCDiagnosticLogging,
    Exposed=Window,
    RuntimeEnabled=RTCDiagnosticLogging
] partial interface RTCPeerConnection {
    [CallWith=ScriptState, RaisesException, MeasureAs=V8RTC_StartDiagnosticLogging_Method] static DOMString startDiagnosticLogging(optional RTCDiagnosticLoggingOptions options = {});
    [CallWith=ScriptState, RaisesException] static undefined stopDiagnosticLogging();
    [CallWith=ScriptState, RaisesException] static undefined cancelDiagnosticLogging();
};
