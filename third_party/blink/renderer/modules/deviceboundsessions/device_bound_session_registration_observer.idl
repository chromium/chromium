callback DeviceBoundSessionRegistrationObserverCallback =
    undefined (sequence<DeviceBoundSession> sessions,
               DeviceBoundSessionRegistrationObserver observer);

[
  SecureContext,
  Exposed=Window,
  RuntimeEnabled=DeviceBoundSessionJsApi
] interface DeviceBoundSessionRegistrationObserver {
  [CallWith=ScriptState, RaisesException, MeasureAs=DeviceBoundSessionRegistrationObserver]
  constructor(DeviceBoundSessionRegistrationObserverCallback callback,
              optional DeviceBoundSessionRegistrationObserverOptions options = {});

  undefined observe();
  undefined disconnect();
};
