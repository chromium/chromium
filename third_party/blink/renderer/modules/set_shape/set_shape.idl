// Window setShape API interface for allowlisted Isolated Web Apps.
[
  ImplementedAs=SetShape,
  RuntimeEnabled=SetShape,
  SecureContext,
  IsolatedContext
] partial interface Window {
  // Sets the shape of the current window to the union of the given `rects`.
  // Only areas of the window that are covered by at least one rectangle become
  // visible and can be interacted with.
  //
  // Passing an empty list of `rects` resets the window shape back to normal.
  //
  // The window display mode must be unframed for this API to work.
  //
  // The returned promise is resolved when the operation is successful, and
  // rejected if the shape couldn't be set (e.g. when `rects` are invalid,
  // the window could not be found, or the window is not in unframed mode).
  [
    CallWith=ScriptState,
    RaisesException
  ]
  Promise<undefined> setShape(sequence<DOMRectReadOnly> rects);
};
