// https://wicg.github.io/cross-origin-storage/#navigatorcrossoriginstorage
[
    SecureContext,
    ImplementedAs=CrossOriginStorageManager
] interface mixin NavigatorCrossOriginStorage {
    [RuntimeEnabled=CrossOriginStorage, SameObject] readonly attribute CrossOriginStorageManager crossOriginStorage;
};

Navigator includes NavigatorCrossOriginStorage;
WorkerNavigator includes NavigatorCrossOriginStorage;
