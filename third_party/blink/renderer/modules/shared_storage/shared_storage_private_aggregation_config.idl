// https://wicg.github.io/shared-storage/#shared-storage-interface
dictionary SharedStoragePrivateAggregationConfig {
    USVString aggregationCoordinatorOrigin;
    USVString contextId;
    [EnforceRange] unsigned long long filteringIdMaxBytes;
