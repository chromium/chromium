dictionary AuthenticationExtensionsCmtgKeyOutputsJSON {
  required Base64URLString cmtgKey;
  required Base64URLString signature;
};

// https://w3c.github.io/webauthn/#dictdef-authenticationextensionsclientoutputsjson

dictionary AuthenticationExtensionsClientOutputsJSON {
  boolean appid;

  // https://fidoalliance.org/specs/fido-v2.0-rd-20180702/fido-client-to-authenticator-protocol-v2.0-rd-20180702.html#sctn-hmac-secret-extension
  boolean hmacCreateSecret;

  // https://w3c.github.io/webauthn/#sctn-authenticator-credential-properties-extension
  CredentialPropertiesOutput credProps;

  // https://w3c.github.io/webauthn/#sctn-large-blob-extension
  object largeBlob;

  // https://fidoalliance.org/specs/fido-v2.1-rd-20201208/fido-client-to-authenticator-protocol-v2.1-rd-20201208.html#sctn-credBlob-extension
  boolean credBlob;
  Base64URLString getCredBlob;

  // https://w3c.github.io/webauthn/#prf-extension
  object prf;

  // Credential Manager Trust Group (CMTG) key.
  // https://github.com/w3c/webauthn/pull/2377
  [RuntimeEnabled=WebAuthenticationCmtgKey] AuthenticationExtensionsCmtgKeyOutputsJSON cmtgKey;

  // Cross-device fallback URL support.
  // https://github.com/w3c/webauthn/pull/2380
  [RuntimeEnabled=WebAuthenticationCrossDeviceFallbackUrl] boolean crossDeviceFallbackUrl;
};
