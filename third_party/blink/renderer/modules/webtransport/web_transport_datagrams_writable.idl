// https://w3c.github.io/webtransport/#webtransportdatagramswritable
[
    Exposed=(Window,Worker),
    SecureContext,
    RuntimeEnabled=WebTransportDatagramsWritable
] interface WebTransportDatagramsWritable : WritableStream {
  [RaisesException=Setter] attribute WebTransportSendGroup? sendGroup;
  attribute long long sendOrder;
};
