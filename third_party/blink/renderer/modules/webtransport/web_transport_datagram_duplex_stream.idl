// https://w3c.github.io/webtransport/#duplex-stream
[
    Exposed=(Window,Worker),
    SecureContext,
    ImplementedAs=DatagramDuplexStream
] interface WebTransportDatagramDuplexStream {
  [CallWith=ScriptState, RaisesException, RuntimeEnabled=WebTransportDatagramsWritable, MeasureAs=WebTransportDatagramDuplexStreamCreateWritable]
  WebTransportDatagramsWritable createWritable(
      optional WebTransportSendOptions options = {});
  readonly attribute ReadableStream readable;
  readonly attribute WritableStream writable;

  readonly attribute unsigned long maxDatagramSize;
  [RaisesException=Setter] attribute unrestricted double? incomingMaxAge;
  [RaisesException=Setter] attribute unrestricted double? outgoingMaxAge;
  attribute unsigned long incomingMaxBufferedDatagrams;
  attribute unsigned long outgoingMaxBufferedDatagrams;
  [DeprecateAs=WebTransportDatagramDuplexStreamIncomingHighWaterMark]
  attribute long incomingHighWaterMark;
  [DeprecateAs=WebTransportDatagramDuplexStreamOutgoingHighWaterMark]
  attribute long outgoingHighWaterMark;
};
