namespace blink {

// Applies the setting called |name| by converting |value| from its string form
// and calling our setter of the same name. Going through our own setters, rather
// than writing to Settings directly, keeps settings that are routed through
// DevToolsEmulator from clobbering active emulation overrides.
void WebSettingsImpl::SetFromStrings(const WebString& name,
                                     const WebString& value) {
  const String name_string = name;
  const String value_string = value;
{% for setting in settings %}
  if (name_string == "{{setting.name}}") {
    Set{{setting.name.to_upper_camel_case()}}(
        FromString<{{setting.type}}>()(value_string));
    return;
  }
{% endfor %}
}

}  // namespace blink
