  {% endif %}
    return true;
  {% if not feature.origin_trial_feature_name %}
  // The feature does not have an origin trial name and its runtime flag
  // is not enabled.
  return false;
  {% else %}
  return context && context->FeatureEnabled(mojom::blink::OriginTrialFeature::k{{feature.name}});
  {% endif %}
}

