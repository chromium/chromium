namespace blink {

namespace {

constexpr CSSBitset kKeywordProperties{ {
  {% for property in properties if 'Keyword' in property.typedom_types %}
  CSSPropertyID::{{property.enum_key}},
  {% endfor %}
} };

}  // namespace

bool CSSOMKeywords::PropertyTakesCustomIdent(CSSPropertyID id) {
  switch (id) {
  {% for property in properties if property.typedom_custom_ident %}
  case CSSPropertyID::{{property.enum_key}}:
  {% endfor %}
    return true;
  default:
    return false;
  }
}

bool CSSOMKeywords::ValidKeywordForProperty(CSSPropertyID id,
                                          const CSSKeywordValue& keyword) {
  const CSSValueID value_id = keyword.KeywordValueID();
  if (css_parsing_utils::IsCSSWideKeyword(value_id)) {
    // TODO(crbug.com/1310761): Support CSS-wide keywords in custom props.
    return id != CSSPropertyID::kVariable;
  }

  if (PropertyTakesCustomIdent(id)) {
    // Any identifier may be a <custom-ident>, including one that happens to
    // name a keyword of some other property ('auto', say). Per css-values-4 a
    // <custom-ident> excludes only the CSS-wide keywords (handled above) and
    // 'default'. Identifiers that an individual property excludes -- 'not',
    // 'and' and 'or' for container-name -- are not CSSValueIDs, so they cannot
    // be enumerated here; they are rejected when the value is parsed against
    // the property's grammar in StyleValueToCSSValue().
    return value_id != CSSValueID::kDefault;
  }

  if (!IsValidCSSValueID(value_id) || !IsCSSPropertyIDWithName(id) ||
      !kKeywordProperties.Has(id)) {
    return false;
  }

  switch (id) {
  {% for property in properties if 'Keyword' in property.typedom_types and property.typedom_keywords %}
    case CSSPropertyID::{{property.enum_key}}:
      switch (value_id) {
      {% for keyword_id in property.typedom_keyword_ids if keyword_id not in property.typedom_keyword_features %}
        case CSSValueID::{{keyword_id}}:
        {% if loop.last %}
          return true;
        {% endif %}
      {% endfor %}
      {% for keyword_id in property.typedom_keyword_ids if keyword_id in property.typedom_keyword_features %}
        case CSSValueID::{{keyword_id}}:
          return RuntimeEnabledFeatures::
              {{property.typedom_keyword_features[keyword_id]}}Enabled();
      {% endfor %}
        default:
          return false;
      }
  {% endfor %}
    default:
      return IsValidCSSPropertyKeyword(id, value_id);
  }
}

} // namespace blink
