// https://www.w3.org/TR/scroll-animations-1/#viewtimeline-interface
[
    Exposed=Window
] interface ViewTimeline : ScrollTimeline {
    [CallWith=Document, RaisesException, MeasureAs=ViewTimelineConstructor] constructor(ViewTimelineOptions options);
    readonly attribute Element subject;
    readonly attribute CSSNumericValue? startOffset;
    readonly attribute CSSNumericValue? endOffset;
};
