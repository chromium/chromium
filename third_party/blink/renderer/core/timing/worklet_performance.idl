// https://w3c.github.io/hr-time/#sec-workletperformance

[
    Exposed=AudioWorklet,
    RuntimeEnabled=AudioWorkletPerformance
] interface WorkletPerformance {
    [Affects=Nothing, NoAllocDirectCall] DOMHighResTimeStamp now();
};
