// https://github.com/WICG/speculative_load_measurement

dictionary SpeculationData {
    required sequence<PreloadData> preloads;
    required sequence<PreconnectData> preconnects;
    required sequence<SpeculationNavigationData> navigations;
    required USVString? navigationDestinationURL;
};
