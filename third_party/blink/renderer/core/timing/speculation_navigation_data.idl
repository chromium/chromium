// https://github.com/WICG/speculative_load_measurement

// Represents the type of speculative navigation.
enum SpeculationNavigationType { "prefetch", "prerender", "prerender-until-script" };

// Represents the eagerness level for speculation rules.
enum SpeculationEagernessValue { "conservative", "moderate", "eager", "immediate" };

dictionary SpeculationNavigationData {
    required SpeculationNavigationType type;
    required USVString url;
    required sequence<DOMString>? tags;
    required SpeculationEagernessValue? eagerness;
};
