interface PassAsSpanTest {
    unsigned long long testBufferSource([PassAsSpan] BufferSource buffer);
    unsigned long long testUnlimitedBufferSource(
        [PassAsSpan, BufferSourceTypeNoSizeLimit] BufferSource buffer);
    unsigned long long testSharedBufferSource(
        [AllowShared, PassAsSpan] BufferSource buffer);
    unsigned long long testUnlimitedSharedBufferSource(
        [AllowShared, PassAsSpan, BufferSourceTypeNoSizeLimit] BufferSource buffer);
    unsigned long long testTypedArray([PassAsSpan] Uint8Array array);
    unsigned long long testUnlimitedTypedArray(
        [PassAsSpan, BufferSourceTypeNoSizeLimit] Uint8Array array);
    unsigned long long testTypedArrayOrSequence(
        [PassAsSpan] (Int32Array or sequence<long>) value);
    unsigned long long testUnlimitedTypedArrayOrSequence(
        [PassAsSpan] ([BufferSourceTypeNoSizeLimit] Int32Array or sequence<long>) value);
};
