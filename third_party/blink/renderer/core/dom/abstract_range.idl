// https://dom.spec.whatwg.org/#interface-abstractrange
//
// Per https://github.com/whatwg/dom/pull/1470 the container attributes move
// from AbstractRange to a new NodeRange interface. The legacy shape (containers
// on AbstractRange) is kept behind LegacyAbstractRange, the inverse of
// OpaqueRange.

[
    Exposed=Window
] interface AbstractRange {
    [RuntimeEnabled=LegacyAbstractRange] readonly attribute Node startContainer;
    [RuntimeEnabled=LegacyAbstractRange] readonly attribute Node endContainer;
    readonly attribute unsigned long startOffset;
    readonly attribute unsigned long endOffset;
    readonly attribute boolean collapsed;
};
