dictionary FocusableOptions {
    [RuntimeEnabled=SequentialFocusPrimitivesShadowRoots]
    sequence<ShadowRoot> shadowRoots = [];
};

[
    Exposed=Window,
    RuntimeEnabled=SequentialFocusPrimitives
]
interface Focusable {
    constructor((Element or CSSPseudoElement) target,
                optional FocusableOptions options = {});
    [RuntimeEnabled=SequentialFocusPrimitivesShadowRoots]
    constructor(Focusable focusable, optional FocusableOptions options = {});

    readonly attribute Element? shadowHost;
    readonly attribute Element? target;
    readonly attribute CSSPseudoElement? pseudoElement;

    undefined focus(optional FocusOptions options = {});
    Focusable? nextFocusable();
    Focusable? previousFocusable();
};
