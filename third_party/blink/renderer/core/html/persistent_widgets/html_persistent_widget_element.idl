[
    Exposed=Window,
    RuntimeEnabled=PersistentWidgetAPI
]
interface HTMLPersistentWidgetElement : HTMLElement {
  [Reflect, URL, CEReactions] attribute USVString src;
  [Reflect, CEReactions] attribute DOMString name;
  [RaisesException] void postMessage(any message, USVString targetOrigin);
  [RaisesException] void postMessage(any message, optional WindowPostMessageOptions options = {});
};
