[
    ImplementedAs=PersistentWidgetOpener,
    Exposed=Window,
    RuntimeEnabled=PersistentWidgetAPI
]
partial interface Window {
    [SameObject] readonly attribute PersistentWidgetOpener? persistentWidgetOpener;
};

[
    Exposed=Window,
    RuntimeEnabled=PersistentWidgetAPI
]
interface PersistentWidgetOpener : EventTarget {
  [CallWith=ScriptState, RaisesException] void postMessage(any message, USVString targetOrigin);
  [CallWith=ScriptState, RaisesException] void postMessage(any message, optional WindowPostMessageOptions options = {});
};

