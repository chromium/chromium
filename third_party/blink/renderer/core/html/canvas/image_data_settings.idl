enum ImageDataPixelFormat {
  "rgba-unorm8", // default
  "rgba-float16",
  "rgba-float32",
};

dictionary ImageDataSettings {
  PredefinedColorSpace colorSpace;
  [RuntimeEnabled=ImageDataPixelFormat] ImageDataPixelFormat pixelFormat = "rgba-unorm8";
};
