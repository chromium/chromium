module blink.mojom;

// An ID generated by Blink to uniquely identify a Node in the DOM.
// See third_party/blink/renderer/core/dom/dom_node_ids.h
// Note: A DOMNodeId is unique only within a renderer process.
struct DOMNodeId {
  int32 value;
};
