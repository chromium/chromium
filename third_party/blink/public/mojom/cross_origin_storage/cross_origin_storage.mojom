module blink.mojom;

import "third_party/blink/public/mojom/file_system_access/file_system_access_error.mojom";
import "third_party/blink/public/mojom/file_system_access/file_system_access_file_handle.mojom";
import "url/mojom/origin.mojom";

// Supported cryptographic hash algorithms for Cross-Origin Storage.
enum CrossOriginStorageAlgorithm {
  kSha256,
};

// Content address identifying a resource in Cross-Origin Storage.
struct CrossOriginStorageHash {
  CrossOriginStorageAlgorithm algorithm;
  // Lowercase hexadecimal digest (64 characters for SHA-256). Validated by
  // both the renderer and the browser process before use.
  string value;
};

// Empty marker struct for the '*' wildcard sharing scope.
struct CrossOriginStorageAnyOrigin {};

// Sharing policy applied when creating a Cross-Origin Storage entry.
union CrossOriginStorageOrigins {
  // Corresponds to `origins: "*"` (requires hash to be on the Public Hash List).
  CrossOriginStorageAnyOrigin any_origin;
  // Explicit list of up to 100 allowed non-opaque HTTP(S) origins. An empty
  // array corresponds to `origins: []` (same-site access only).
  array<url.mojom.Origin> origins;
};

// Interface exposed to the renderer to access Cross-Origin Storage.
interface CrossOriginStorageManager {
  // Requests a handle to a file in Cross-Origin Storage identified by `hash`.
  // - When `create_origins` is null (`create: false`), looks up an existing
  //   committed resource for reading.
  // - When `create_origins` is non-null (`create: true`), returns a writable
  //   handle staged in quarantine until verified on `close()`.
  RequestFileHandle(CrossOriginStorageHash hash,
                    CrossOriginStorageOrigins? create_origins) =>
      (FileSystemAccessError result,
       pending_remote<FileSystemAccessFileHandle>? file_handle);
};
