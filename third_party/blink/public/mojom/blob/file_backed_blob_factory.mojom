module blink.mojom;

import "third_party/blink/public/mojom/blob/blob.mojom";
import "third_party/blink/public/mojom/blob/data_element.mojom";

// Keeps a snapshot file and any temporary read permission alive until its
// file-backed blob has been registered. Closing the remote releases the
// browser's reference to the snapshot file.
interface SnapshotPermissionToken {};

// This interface is implemented by the browser to give renderers the ability
// to register a file backed blob and capture the URL from which it is accessed.
// This interface is channel-associated (for frames).
interface FileBackedBlobFactory {
    // Registers a file backed blob. `snapshot_permission_token` comes from the
    // return value of `FileSystemManager::CreateSnapshotFile`.
    RegisterBlob(
        pending_receiver<blink.mojom.Blob> blob,
        string content_type,
        blink.mojom.DataElementFile file,
        pending_remote<SnapshotPermissionToken>? snapshot_permission_token)
        => (string uuid);
};
