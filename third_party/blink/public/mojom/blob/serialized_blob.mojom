module blink.mojom;

import "third_party/blink/public/mojom/blob/blob.mojom";

// Struct wrapping a Blob interface pointer.
struct SerializedBlob {
  // May be empty if unknown (`blob` is the source of truth).
  // TODO(crbug.com/40529364): ideally this field would never be included.
  string uuid;
  string content_type;
  uint64 size;
  pending_remote<Blob> blob;
};
