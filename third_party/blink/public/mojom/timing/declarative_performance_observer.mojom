module blink.mojom;

import "mojo/public/mojom/base/time.mojom";
import "mojo/public/mojom/base/values.mojom";

// Represents a PerformanceMark entry.
struct DeclarativePerformanceMark {
  string name;
  mojo_base.mojom.TimeDelta start_time;
  // Developer-supplied arbitrary metadata
  mojo_base.mojom.Value? detail;
};

// Represents a Largest Contentful Paint (LCP) entry.
struct DeclarativeLargestContentfulPaint {
  mojo_base.mojom.TimeDelta start_time;
  uint64 size;
  mojo_base.mojom.TimeDelta render_time;
  mojo_base.mojom.TimeDelta load_time;
  string? id;
  string? url;
  string? element;
};

// Represents a single performance entry observed in the document.
// This is a union of all supported strongly-typed performance entry payloads.
// The active union field indicates the entry type.
union DeclarativePerformanceEntry {
  DeclarativePerformanceMark mark;
  DeclarativeLargestContentfulPaint lcp;
};

// Implemented by the browser process (`content::DeclarativePerformanceObserver`)
// and called by the renderer process (`blink::Performance`) to forward
// observed performance entries (e.g. marks) associated with the frame.
interface DeclarativePerformanceObserverHost {
  // Sent to notify the browser of new performance entries observed in the frame.
  // This is throttled and sent in batches to minimize IPC overhead.
  DidObservePerformanceEntries(array<DeclarativePerformanceEntry> entries);
};
