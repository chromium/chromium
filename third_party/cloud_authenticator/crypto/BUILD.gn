import("//build/rust/cargo_crate.gni")

cargo_crate("crypto") {
  allow_unsafe = false
  edition = "2021"
  sources = [ "src/lib.rs" ]
  deps = [
    "//third_party/boringssl:bssl_crypto",
    "//third_party/cloud_authenticator/cbor",
  ]
  features = [ "bssl" ]
  build_native_rust_unit_tests = false
  testonly = true
}
