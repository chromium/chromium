import("//build/rust/cargo_crate.gni")

cargo_crate("handshake") {
  allow_unsafe = false
  sources = [
    "src/error.rs",
    "src/lib.rs",
    "src/noise.rs",
  ]
  deps = [
    "//third_party/cloud_authenticator/crypto",
    "//third_party/rust/static_assertions/v1:lib",
  ]
  build_native_rust_unit_tests = false
  testonly = true
}
