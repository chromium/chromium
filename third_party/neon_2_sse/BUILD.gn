config("neon_2_sse_include") {
  include_dirs = [ "src" ]
}

# Keep as a public config since TFLite's BUILD references it directly.
config("neon_2_sse_flags") {
  # NEON_2_SSE.h marks slow emulated intrinsics as deprecated to act as
  # performance warnings. Disable those with the library's own macro rather
  # than -Wno-deprecated-declarations, since this config is public and would
  # otherwise suppress deprecation warnings for all dependents on x64.
  defines = [ "NEON2SSE_DISABLE_PERFORMANCE_WARNING" ]
  if (target_cpu == "x64" && is_clang) {
    cflags = [ "-Wno-gnu-inline-cpp-without-extern" ]
  }
}

source_set("neon_2_sse") {
  public = [ "src/NEON_2_SSE.h" ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]

  public_configs = [
    ":neon_2_sse_include",
    ":neon_2_sse_flags",
  ]
}
