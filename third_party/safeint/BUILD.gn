config("safeint_config") {
  include_dirs = [ "src" ]

  # Use standard abort() instead of _CRT_SECURE_INVALID_PARAMETER on Windows.
  # In Windows debug builds (_DEBUG), _CRT_SECURE_INVALID_PARAMETER expands to
  # _invalid_parameter(), which is not marked noreturn and triggers
  # -Winvalid-noreturn in SafeInt's noreturn overflow/div-zero handlers.
  defines = [ "SAFE_INT_USE_STDLIB" ]

  visibility = [ ":*" ]
}

source_set("safeint") {
  public = [ "src/SafeInt.hpp" ]

  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]

  public_configs = [ ":safeint_config" ]

  # Chromium code should use //base/numerics instead.
  visibility = [ "//third_party/litert:*" ]
}
