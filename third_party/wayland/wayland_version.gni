# Minimum system libwayland versions required when use_system_libwayland is
# true. These are maintained by hand and are deliberately independent of the
# in-tree libwayland version, which is autorolled: Chromium only needs the
# libwayland APIs it actually uses, not whatever version is bundled. Raise these
# when Chromium starts depending on newer libwayland API.
wayland_version = "1.26.0"
wayland_egl_version = "18.1.0"
