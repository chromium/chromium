Add #include <type_traits> to logging.h and <iterator> to strings.h

logging.h uses std::is_same_v and other <type_traits> templates, and
strings.h uses std::next from <iterator>, without including them
(crbug.com/40263312).

Chromium commit dcd4e94 in libunwindstack.git.

diff --git a/src/include/android-base/logging.h b/src/include/android-base/logging.h
index 2d21638..7b7f84a 100644
--- a/src/include/android-base/logging.h
+++ b/src/include/android-base/logging.h
@@ -65,6 +65,7 @@
 #include <functional>
 #include <memory>
 #include <ostream>
+#include <type_traits>
 
 #include "android-base/errno_restorer.h"
 #include "android-base/macros.h"
diff --git a/src/include/android-base/strings.h b/src/include/android-base/strings.h
index 9557fad..673deaf 100644
--- a/src/include/android-base/strings.h
+++ b/src/include/android-base/strings.h
@@ -18,6 +18,7 @@
 
 #include <ctype.h>
 
+#include <iterator>
 #include <sstream>
 #include <string>
 #include <string_view>
