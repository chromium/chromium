upstream {
  version: "android-17.0.0_r1"
  artifacts {
    git {
      repository: "https://android.googlesource.com/platform/system/libbase"
      commit: "fef4173e19d97cd4b4fc09a06bccbf800d0d3937"
    }
  }
}
stages {
  input {
    patch { copybara {} }
  }
  publish { git {} }
}
latest {
  generic {
    format: "android-${n0}.0.0_r${n1}"
    regex_groups { key: "n0" value: "[0-9]+" }
    regex_groups { key: "n1" value: "[0-9]+" }
  }
  git {
    repository: "https://android.googlesource.com/platform/system/libbase"
    tags {}
  }
}
