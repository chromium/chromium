module(
    name = "multichannel-audio-tools",
    version = "0.0.0",
)

# ===== Bazel rules =====
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# ===== C++ dependencies =====
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "gtest")
bazel_dep(name = "glog", version = "0.7.1.bcr.1", repo_name = "com_github_glog_glog")
bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = "com_google_benchmark")

# ===== Non-registry dependencies =====
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

# ===== eigen =====
http_archive(
    name = "eigen_archive",
    build_file = "//third_party:eigen.BUILD",
    sha256 = "f3d69ac773ecaf3602cb940040390d4e71a501bb145ca9e01ce5464cf6d4eb68",
    strip_prefix = "eigen-eigen-049af2f56331",
    urls = [
        "http://mirror.tensorflow.org/bitbucket.org/eigen/eigen/get/049af2f56331.tar.gz",
        "https://bitbucket.org/eigen/eigen/get/049af2f56331.tar.gz",
    ],
)

# ===== fft2d =====
http_archive(
    name = "fft2d",
    build_file = "//third_party:fft2d.BUILD",
    sha256 = "ada7e99087c4ed477bfdf11413f2ba8db8a840ba9bbf8ac94f4f3972e2a7cec9",
    urls = [
        "http://www.kurims.kyoto-u.ac.jp/~ooura/fft2d.tgz",
    ],
)

# ===== kissfft =====
new_git_repository(
    name = "kissfft",
    build_file = "//third_party:kissfft.BUILD",
    remote = "https://github.com/mborgerding/kissfft.git",
    tag = "v131",
)

# ===== pffft =====
http_archive(
    name = "pffft_archive",
    build_file = "//third_party:pffft.BUILD",
    strip_prefix = "pffft-master",
    urls = [
        "https://github.com/marton78/pffft/archive/refs/heads/master.tar.gz",
    ],
)
