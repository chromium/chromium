import("//build/config/linux/pkg_config.gni")
import("//third_party/glib/codegen.gni")
import("//third_party/glib/visibility.gni")

assert(is_linux)

# Code generated at build time from the in-tree glib, mirroring the layout of
# the checked-in include/ directory.
_gen_include_dir = "$target_gen_dir/include"

_visibility_macros_inputs = [
  "glib_version.py",
  "src/meson.build",
  "src/tools/gen-visibility-macros.py",
]

# config.h and glibconfig.h come from meson's host configuration checks and are
# checked in as templates (see on_update.sh). Fill in the glib version.
_configure_version_inputs = [
  "glib_version.py",
  "src/meson.build",
]

# config.h is private to glib, so generate the output in a private include
# directory instead of in a public include dir.
action("config_h") {
  script = "configure_version_header.py"
  inputs = _configure_version_inputs + [ "include/config.h.in" ]
  outputs = [ "$target_gen_dir/private_include/config.h" ]
  args = [
    "--template",
    rebase_path("include/config.h.in", root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

action("glibconfig_h") {
  script = "configure_version_header.py"
  inputs = _configure_version_inputs + [ "include/glib/glibconfig.h.in" ]
  outputs = [ "$_gen_include_dir/glib/glibconfig.h" ]
  args = [
    "--template",
    rebase_path("include/glib/glibconfig.h.in", root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

action("gversionmacros") {
  script = "gen_visibility_macros.py"
  inputs = _visibility_macros_inputs + [ "src/glib/gversionmacros.h.in" ]
  outputs = [ "$_gen_include_dir/glib/gversionmacros.h" ]
  args = [
    "versions-macros",
    rebase_path("src/glib/gversionmacros.h.in", root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

_visibility_namespaces = [
  [
    "glib",
    "GLIB",
  ],
  [
    "gobject",
    "GOBJECT",
  ],
  [
    "gmodule",
    "GMODULE",
  ],
  [
    "gio",
    "GIO",
  ],
]
foreach(ns, _visibility_namespaces) {
  action("${ns[0]}_visibility") {
    script = "gen_visibility_macros.py"
    inputs = _visibility_macros_inputs
    outputs = [ "$_gen_include_dir/${ns[0]}/${ns[0]}-visibility.h" ]
    args = [
      "visibility-macros",
      ns[1],
      rebase_path(outputs[0], root_build_dir),
    ]
  }
}

glib_mkenums("glib_enumtypes_h") {
  input_headers = [ "src/glib/gunicode.h" ]
