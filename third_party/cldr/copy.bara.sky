load("//crowbar", "crowbar_workflow")

crowbar_workflow(
    origin_files = [
        "usr/share/unicode/cldr/common/annotations/da.xml",
        "usr/share/unicode/cldr/common/annotations/de.xml",
        "usr/share/unicode/cldr/common/annotations/en.xml",
        "usr/share/unicode/cldr/common/annotations/en_001.xml",
        "usr/share/unicode/cldr/common/annotations/es.xml",
        "usr/share/unicode/cldr/common/annotations/fi.xml",
        "usr/share/unicode/cldr/common/annotations/fr.xml",
        "usr/share/unicode/cldr/common/annotations/ja.xml",
        "usr/share/unicode/cldr/common/annotations/no.xml",
        "usr/share/unicode/cldr/common/annotations/sv.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/da.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/de.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/en.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/en_001.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/es.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/fi.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/fr.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/ja.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/no.xml",
        "usr/share/unicode/cldr/common/annotationsDerived/sv.xml",
        "usr/share/unicode/cldr/common/bcp47/calendar.xml",
        "usr/share/unicode/cldr/common/bcp47/collation.xml",
        "usr/share/unicode/cldr/common/bcp47/currency.xml",
        "usr/share/unicode/cldr/common/bcp47/measure.xml",
        "usr/share/unicode/cldr/common/bcp47/number.xml",
        "usr/share/unicode/cldr/common/bcp47/segmentation.xml",
        "usr/share/unicode/cldr/common/bcp47/timezone.xml",
        "usr/share/unicode/cldr/common/bcp47/transform-destination.xml",
        "usr/share/unicode/cldr/common/bcp47/transform.xml",
        "usr/share/unicode/cldr/common/bcp47/transform_hybrid.xml",
        "usr/share/unicode/cldr/common/bcp47/transform_ime.xml",
        "usr/share/unicode/cldr/common/bcp47/transform_keyboard.xml",
        "usr/share/unicode/cldr/common/bcp47/transform_mt.xml",
        "usr/share/unicode/cldr/common/bcp47/transform_private_use.xml",
        "usr/share/unicode/cldr/common/bcp47/variant.xml",
        "usr/share/unicode/cldr/common/supplemental/plurals.xml",
    ],
    transformations = [
        # The Debian package installs CLDR under usr/share/unicode/cldr/.
        core.move("src/usr/share/unicode/cldr/common", "src/common"),
    ],
)
