<translation id="7932992556896556665">ನಿಮ್ಮ ಟಚ್‌ಸ್ಕ್ರೀನ್ ಸಾಧನವನ್ನು ಸರಿಯಾದ ಪ್ರದರ್ಶನಕ್ಕೆ ಸೆಟಪ್‌ ಮಾಡಿ ಮತ್ತು ಮ್ಯಾಪ್ ಮಾಡಿ</translation>
<translation id="7933634003144813719">ಹಂಚಿದ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="7940087892955752820">ಅಪ್ಲಿಕೇಶನ್, ಈ ಫೋಲ್ಡರ್ ಅನ್ನು ಬಳಸುತ್ತಿರುವ ಕಾರಣ, ಅದರ ಹಂಚಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಲಿಲ್ಲ. ಮುಂದಿನ ಸಲ <ph name="SPECIFIC_NAME" /> ಅನ್ನು ಶಟ್ ಡೌನ್ ಮಾಡಿದಾಗ, ಈ ಫೋಲ್ಡರ್ ಹಂಚಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
