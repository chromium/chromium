<translation id="4343283008857332996">ಕ್ಯಾಮರಾ ಅನುಮತಿಯಿರುವ ಆ್ಯಪ್‌ಗಳು, ವೆಬ್‌ಸೈಟ್‌ಗಳಿಗೆ ಮತ್ತು ಸಿಸ್ಟಂ ಸರ್ವಿಸ್‌ಗಳಿಗೆ ಕ್ಯಾಮರಾ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಅನುಮತಿಯಿದೆ. ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಲು, ನೀವು ಆ್ಯಪ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗಬಹುದು ಅಥವಾ ಪುಟವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಬೇಕಾಗಬಹುದು.</translation>
<translation id="4345732373643853732">ಸರ್ವರ್‌ಗೆ ಬಳಕೆದಾರಹೆಸರು ಗೊತ್ತಿಲ್ಲ</translation>
<translation id="4356100841225547054">ವಾಲ್ಯೂಮ್ ಆಫ್ ಮಾಡಿ</translation>
<translation id="4358361163731478742">ಯಾವುದೇ ಆ್ಯಪ್‌ಗಳು, ಆ್ಯಪ್ ಭಾಷೆಯ ಆಯ್ಕೆಯನ್ನು ಬೆಂಬಲಿಸುವುದಿಲ್ಲ</translation>
