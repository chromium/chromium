<translation id="93393615658292258">ಪಾಸ್‌ವರ್ಡ್ ಮಾತ್ರ</translation>
<translation id="942296794412775122">ಮೈಕ್ರೊಫೋನ್ ಆನ್/ಆಫ್</translation>
<translation id="950307215746360464">ಸೆಟಪ್ ಗೈಡ್</translation>
<translation id="952471655966876828">ಸಾಧನವನ್ನು ಆನ್ ಮಾಡಿದಾಗ ಮತ್ತು ಬಳಸುತ್ತಿರುವಾಗ ಅದು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕನೆಕ್ಟ್ ಆಗುತ್ತದೆ</translation>
<translation id="956013912698841780">ಕಂಟೆಂಟ್ ಅನ್ನು ಸಾರಾಂಶಗೊಳಿಸಲು, ವ್ಯಾಖ್ಯಾನಗಳನ್ನು ಪಡೆಯಲು, ಹೆಚ್ಚು ಆತ್ಮವಿಶ್ವಾಸದಿಂದ ಬರೆಯಲು, ಚಿತ್ರಗಳನ್ನು ರಚಿಸಲು ಮತ್ತು ಇನ್ನೂ ಇತ್ಯಾದಿಗಳನ್ನು ಮಾಡಲು ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿ. ಪ್ರಸ್ತುತ ಸೀಮಿತ ಲಭ್ಯತೆಯನ್ನು ಹೊಂದಿದೆ.</translation>
<translation id="957179356621191750">6-ಡಾಟ್‌</translation>
<translation id="964790508619473209">ಸ್ಕ್ರೀನ್ ಜೋಡಣೆ</translation>
<translation id="966588271015727539">ಒಂದು ಬ್ಲೂಟೂತ್ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
