<translation id="8752451679755290210">ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಐಟಂಗಳ ನಡುವೆ ಸರಿಸಿ</translation>
<translation id="875532100880844232"><ph name="DEVICE_NAME" /> ಗಾಗಿ, ಪ್ರತಿಯೊಂದು ಕೀಗಾಗಿ ಕ್ರಿಯೆಯೊಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8756262226135340085">ಒಂದೇ ಕೀಬೋರ್ಡ್‌ ಕೀಯ ತ್ವರಿತ ಪುನರಾವರ್ತಿತ ಪ್ರೆಸ್‌ಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸುತ್ತದೆ</translation>
<translation id="8757368836647541092"><ph name="USER_NAME_OR_EMAIL" /> ಅವರನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ</translation>
<translation id="8761945298804995673">ಈ ಬಳಕೆದಾರರು ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದ್ದಾರೆ</translation>
<translation id="8766796754185931010">ಕೊಟೇರಿ</translation>
<translation id="876956356450740926">ಡೆವಲಪರ್ ಟೂಲ್‌ಗಳು, IDE ಗಳು ಮತ್ತು ಎಡಿಟರ್‌ಗಳನ್ನು ರನ್ ಮಾಡಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="8777509665768981163">ನಿಮ್ಮ ಟ್ಯಾಬ್ಲೆಟ್‌ನಲ್ಲಿ ಬಟನ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ಪತ್ತೆಮಾಡಿ</translation>
<translation id="8780123805589053431">Google ನಿಂದ ಚಿತ್ರದ ವಿವರಣೆಗಳನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8781980678064919987">ಲಿಡ್‌ ಅನ್ನು ಮುಚ್ಚಿದಾಗ ಸಾಧನದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಿ</translation>
<translation id="8785622406424941542">ಸ್ಟೈಲಸ್</translation>
<translation id="8788008845761123079"><ph name="SELECTED_ACTION" /> ಗಾಗಿ ಜೆಸ್ಚರ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="879413103056696865">ಹಾಟ್‌ಸ್ಪಾಟ್ ಆನ್ ಆಗಿರುವಾಗ, ನಿಮ್ಮ <ph name="PHONE_NAME" />:</translation>
<translation id="8798099450830957504">ಡಿಫಾಲ್ಟ್</translation>
<translation id="8807588541160250261">ಯಾವುದೇ ಸಾಧನಗಳು ಕನೆಕ್ಟ್ ಆಗದಿದ್ದಾಗ</translation>
<translation id="8807632654848257479">ಸ್ಥಿರ</translation>
<translation id="8811862054141704416">Crostini ಮೈಕ್ರೋಫೋನ್ ಆ್ಯಕ್ಸೆಸ್</translation>
<translation id="8814190375133053267">ವೈ-ಫೈ</translation>
<translation id="8814319344131658221">ಕಾಗುಣಿತ ಪರಿಶೀಲನೆಗಾಗಿ ಭಾಷೆಗಳು ನಿಮ್ಮ ಭಾಷೆಯ ಆದ್ಯತೆಯನ್ನು ಆಧರಿಸಿವೆ</translation>
<translation id="8814644416678422095">ಹಾರ್ಡ್ ಡ್ರೈವ್‌</translation>
<translation id="881782782501875829">ಪೋರ್ಟ್ ಸಂಖ್ಯೆಯನ್ನು ಸೇರಿಸಿ</translation>
<translation id="8818152010000655963">ವಾಲ್‌ಪೇಪರ್</translation>
<translation id="8818988764764862764">ವಿಂಡೋವನ್ನು ಎಡಕ್ಕೆ ಸರಿಸಲಾಗಿದೆ</translation>
<translation id="8819510664278523111">ನಿಮ್ಮ ಸಾಧನದ EID ಸಂಖ್ಯೆ <ph name="EID_NUMBER" /> , ಸಾಧನದ IMEI ಸಂಖ್ಯೆ <ph name="IMEI_NUMBER" /> ಮತ್ತು ಸಾಧನದ ಕ್ರಮ ಸಂಖ್ಯೆ <ph name="SERIAL_NUMBER" /> ಆಗಿದೆ. ಸೇವೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಲು ಈ ಸಂಖ್ಯೆಗಳನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="8819762137851963556">ಮೌಸ್ ಕರ್ಸರ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="8821045908425223359">ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಐಪಿ ವಿಳಾಸವನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿ</translation>
<translation id="8823963789776061136">ಪರ್ಯಾಯವಾಗಿ, ಪ್ರಿಂಟರ್ PPD ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="88265931742956713">ಟ್ಯಾಬ್ಲೆಟ್ ಬಟನ್‌ಗಳನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="8834039744648160717"><ph name="USER_EMAIL" /> ಮೂಲಕ ನೆಟ್‌ವರ್ಕ್ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ನಿಯಂತ್ರಿಸಲಾಗಿದೆ.</translation>
<translation id="8836360711089151515">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಬೇಕೆಂದು ಮತ್ತು 1 ವಾರದ ಒಳಗಾಗಿ ಈ <ph name="DEVICE_TYPE" /> ಅನ್ನು ಹಿಂತಿರುಗಿಸಬೇಕೆಂದು <ph name="MANAGER" /> ಬಯಸುತ್ತದೆ. <ph name="LINK_BEGIN" />ವಿವರಗಳನ್ನು ನೋಡಿ<ph name="LINK_END" /></translation>
<translation id="8836782447513334597">ಮುಂದುವರಿಸಿ</translation>
<translation id="8845001906332463065">ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="8846239054091760429">ಮೊನೊ ಆಡಿಯೊ, ಸ್ಟಾರ್ಟ್‌ಅಪ್, ಲೈವ್ ಶೀರ್ಷಿಕೆ ಮತ್ತು ಇನ್ನಷ್ಟು</translation>
<translation id="8847988622838149491">USB</translation>
<translation id="8848709220963126773">ಶಿಫ್ಟ್ ಕೀ ಮೋಡ್ ಸ್ವಿಚ್</translation>
<translation id="8849001918648564819">ಮರೆಮಾಡಲಾಗಿದೆ</translation>
<translation id="8849219423513870962"><ph name="PROFILE_NAME" /> ಹೆಸರಿನ eSIM ಪ್ರೊಫೈಲ್ ತೆಗೆದುಹಾಕುವುದನ್ನು ರದ್ದುಗೊಳಿಸಿ</translation>
<translation id="8856028055086294840">ಆ್ಯಪ್‌ಗಳು ಹಾಗೂ ಪುಟಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿ</translation>
<translation id="885701979325669005">ಸಂಗ್ರಹಣೆ</translation>
<translation id="8858369206579825206">ಗೌಪ್ಯತೆ ನಿಯಂತ್ರಣಗಳು</translation>
<translation id="8861568709166518036">ಮನೆಗೆ, ಹಿಂತಿರುಗಲು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು ಆನ್-ಸ್ಕ್ರೀನ್ ಬಟನ್‌ಗಳನ್ನು ಬಳಸಿ. ChromeVox ಅಥವಾ ಸ್ವಯಂಚಾಲಿತ ಕ್ಲಿಕ್‌ಗಳು ಆನ್ ಆಗಿದ್ದರೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಆನ್ ಆಗುತ್ತದೆ.</translation>
<translation id="8867228703146808825">ಬಿಲ್ಡ್ ವಿವರಗಳನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="8868626022555786497">ಬಳಕೆಯಲ್ಲಿದೆ</translation>
<translation id="8868838761037459823">ಸೆಲ್ಯುಲರ್ ವಿವರಗಳು</translation>
<translation id="8872774989979382243">ವಾಲ್ಯೂಮ್ ಆಫ್ ಆಗಿದೆ. ವಾಲ್ಯೂಮ್ ಆನ್ ಮಾಡಿ.</translation>
<translation id="888256071122006425">ಮೌಸ್ ಮತ್ತು ಟಚ್‌ಪ್ಯಾಡ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="8885449336974696155"><ph name="BEGIN_LINK" />ಪ್ರಸ್ತುತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="END_LINK" /> ವರದಿ ಮಾಡುವ ಮೂಲಕ ChromeOS ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="8890529496706615641">ಪ್ರೊಫೈಲ್ ಅನ್ನು ಮರುಹೆಸರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ತಾಂತ್ರಿಕ ಬೆಂಬಲಕ್ಕಾಗಿ ನಿಮ್ಮ ಕ್ಯಾರಿಯರ್ ಅನ್ನು ಸಂಪರ್ಕಿಸಿ.</translation>
<translation id="8894761918470382415">ಬಾಹ್ಯ ಸಾಧನಗಳ ಡೇಟಾ ಆ್ಯಕ್ಸೆಸ್ ರಕ್ಷಣೆ</translation>
<translation id="8896830132794747524">ನಿಮ್ಮ ಮೌಸ್‌ನ ವೇಗವಾದ ಮೂವ್‌ಗಳು ಕರ್ಸರ್ ಅನ್ನು ದೂರಕ್ಕೆ ತಳ್ಳುತ್ತವೆ</translation>
<translation id="8898790559170352647">ನಿಮ್ಮ Microsoft ಖಾತೆಯನ್ನು ಸೇರಿಸಿ</translation>
<translation id="8900413463156971200">ಸೆಲ್ಯುಲರ್ ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="8902667442496790482">ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಆಲಿಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="8903733144777177139">ಮೈಕ್ರೊಫೋನ್ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ</translation>
<translation id="8912810933860534797">ಸ್ವಯಂ ಸ್ಕ್ಯಾನ್ ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="8922624386829239660">ಮೌಸ್, ಪರದೆಯ ಅಂಚುಗಳನ್ನು ಸ್ಪರ್ಶಿಸುವಾಗ ಪರದೆಯನ್ನು ಸರಿಸಿ</translation>
<translation id="8929738682246584251">ಮ್ಯಾಗ್ನಿಫೈಯರ್ ಆನ್/ಆಫ್</translation>
<translation id="8930622219860340959">ವೈರ್‌ಲೆಸ್</translation>
<translation id="8931713990831679796">ಈ ಪ್ರಿಂಟರ್‌ಗಳು ಕನೆಕ್ಟ್ ಆಗಿವೆ ಮತ್ತು ಬಳಸಲು ಸಿದ್ಧವಾಗಿವೆ. ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಸೇವ್ ಮಾಡಿ.</translation>
<translation id="8932654652795262306">ತತ್‌ಕ್ಷಣದ ಟೆಥರಿಂಗ್ ವಿವರಗಳು</translation>
<translation id="8940888110818450052">ಸೈನ್ ಇನ್ ಆಯ್ಕೆಗಳು</translation>
<translation id="8944099748578356325">ಇನ್ನಷ್ಟು ತ್ವರಿತವಾಗಿ ಬ್ಯಾಟರಿ ಬಳಸಿ (ಪ್ರಸ್ತುತವಾಗಿ <ph name="BATTERY_PERCENTAGE" />%)</translation>
<translation id="8945274638472141382">ಐಕಾನ್ ಗಾತ್ರ</translation>
<translation id="8945508919180478719">ಸ್ಟುಡಿಯೋ-ಸ್ಟೈಲ್ ಮೈಕ್</translation>
<translation id="8952831374766033534">ಕಾನ್ಫಿಗರೇಶನ್ ಆಯ್ಕೆಗೆ ಬೆಂಬಲವಿಲ್ಲ: <ph name="ERROR_LINE" /></translation>
<translation id="8960208913905765425">ತ್ವರಿತ ಉತ್ತರಗಳ ಯೂನಿಟ್ ಪರಿವರ್ತನೆ</translation>
<translation id="8960638196855923532">ನೀವು ಈಗ ನಿಮ್ಮ ಫೋನ್‌ನ ಅಧಿಸೂಚನೆಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು</translation>
<translation id="89720367119469899">ಎಸ್ಕೇಪ್</translation>
<translation id="8973648401056792381">ನಿಮ್ಮ ಸಾಧನ ನಿರ್ವಾಹಕರಿಂದ ಇನ್‌ಸ್ಟಾಲ್‌ ಮಾಡಲಾದ ವೆಬ್ ಆ್ಯಪ್.</translation>
<translation id="8978939272793553320"><ph name="DEVICE_NAME" /> ಡಿಸ್‌ಕನೆಕ್ಟ್ ಆಗಿದೆ</translation>
<translation id="8980345560318123814">ಪ್ರತಿಕ್ರಿಯೆ ವರದಿಗಳು</translation>
<translation id="8981825781894055334">ಪೇಪರ್ ಕಡಿಮೆಯಿವೆ</translation>
<translation id="8985561265504464578">ಪತ್ತೆ ಮಾಡುವಿಕೆಯ ಥ್ರೆಶೋಲ್ಡ್</translation>
<translation id="8986362086234534611">ಮರೆತುಹೋಗು</translation>
<translation id="8991694323904646277">ಯಾವುದೇ ಕ್ಯಾಮರಾ ಕನೆಕ್ಟ್ ಆಗಿಲ್ಲ</translation>
<translation id="8991766915726096402">ಸ್ಥಳೀಯ ಡೇಟಾ ಮರಳಿ ಪಡೆಯುವಿಕೆ</translation>
<translation id="8993737615451556423">ಓದುವ ಧ್ವನಿಯನ್ನು ವೇಗಗೊಳಿಸುವ, ನಿಧಾನಗೊಳಿಸುವ ಮತ್ತು ವಿರಾಮಗೊಳಿಸಲು ನಿಯಂತ್ರಣಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ</translation>
<translation id="899384117894244799">ನಿರ್ಬಂಧಿತ ಬಳಕೆದಾರರನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="8999560016882908256">ವಿಭಾಗದ ಸಿಂಟ್ಯಾಕ್ಸ್ ದೋಷ: <ph name="ERROR_LINE" /></translation>
<translation id="8999651235576960439">ಸ್ಕ್ರೀನ್‌ ಮೇಲೆ ಸರಿದಾಡುವುದು ಕಡಿಮೆಯಾಗಿದೆ</translation>
<translation id="9011393886518328654">ಬಿಡುಗಡೆಯ ಟಿಪ್ಪಣಿಗಳು</translation>
<translation id="9012122671773859802">ಮೌಸ್ ಚಲಿಸುವಾಗ ಪರದೆಯನ್ನು ನಿರಂತರವಾಗಿ ಸರಿಸಿ</translation>
<translation id="9014206344398081366">ChromeVox ಟುಟೋರಿಯಲ್</translation>
<translation id="9014674417732091912"><ph name="ROW_NUMBER" /> ಸಾಲಿಗೆ ಸರಿಸಲಾಗಿದೆ</translation>
<translation id="9016827136585652292">ಗೌಪ್ಯತೆ ಸ್ಕ್ರೀನ್ ಟಾಗಲ್</translation>
<translation id="9019956081903586892">ಕಾಗುಣಿತ ಪರೀಕ್ಷೆ ನಿಘಂಟನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="9020362265352758658">4x</translation>
<translation id="902638246363752736">ಕೀಬೋರ್ಡ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="9026393603776578602">ಡಿಕ್ಟೇಶನ್</translation>
<translation id="9030754204056345429">ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ</translation>
<translation id="9031811691986152304">ಪುನಃ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="9032097289595078011">ಶೀಘ್ರ ಜೋಡಿಯಾಗಿಸುವಿಕೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="9032513103438497286">ಈ <ph name="DEVICE_TYPE" /> ಸಾಧನದಲ್ಲಿ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದ ಆ್ಯಪ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸಿ. ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡುವುದನ್ನು ನಿರ್ಬಂಧಿಸಲು, Google Play ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ.</translation>
<translation id="9037054491984310631"><ph name="DEVICE" /> ಹೆಸರಿನ ಬ್ಲೂಟೂತ್ ಸಾಧನಕ್ಕೆ ಕನೆಕ್ಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="904224458472510106">ಈ ಕಾರ್ಯಚರಣೆಯನ್ನು ರದ್ದು ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
