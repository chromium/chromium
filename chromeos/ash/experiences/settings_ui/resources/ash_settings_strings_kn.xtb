<translation id="8848709220963126773">ಶಿಫ್ಟ್ ಕೀ ಮೋಡ್ ಸ್ವಿಚ್</translation>
<translation id="8861568709166518036">ಮನೆಗೆ, ಹಿಂತಿರುಗಲು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು ಆನ್-ಸ್ಕ್ರೀನ್ ಬಟನ್‌ಗಳನ್ನು ಬಳಸಿ. ChromeVox ಅಥವಾ ಸ್ವಯಂಚಾಲಿತ ಕ್ಲಿಕ್‌ಗಳು ಆನ್ ಆಗಿದ್ದರೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಆನ್ ಆಗುತ್ತದೆ.</translation>
<translation id="8872774989979382243">ವಾಲ್ಯೂಮ್ ಆಫ್ ಆಗಿದೆ. ವಾಲ್ಯೂಮ್ ಆನ್ ಮಾಡಿ.</translation>
<translation id="888256071122006425">ಮೌಸ್ ಮತ್ತು ಟಚ್‌ಪ್ಯಾಡ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="8896830132794747524">ನಿಮ್ಮ ಮೌಸ್‌ನ ವೇಗವಾದ ಮೂವ್‌ಗಳು ಕರ್ಸರ್ ಅನ್ನು ದೂರಕ್ಕೆ ತಳ್ಳುತ್ತವೆ</translation>
<translation id="8902667442496790482">ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಆಲಿಸಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="8912810933860534797">ಸ್ವಯಂ ಸ್ಕ್ಯಾನ್ ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="8922624386829239660">ಮೌಸ್, ಪರದೆಯ ಅಂಚುಗಳನ್ನು ಸ್ಪರ್ಶಿಸುವಾಗ ಪರದೆಯನ್ನು ಸರಿಸಿ</translation>
<translation id="8929738682246584251">ಮ್ಯಾಗ್ನಿಫೈಯರ್ ಆನ್/ಆಫ್</translation>
<translation id="8945274638472141382">ಐಕಾನ್ ಗಾತ್ರ</translation>
<translation id="8945508919180478719">ಸ್ಟುಡಿಯೋ-ಸ್ಟೈಲ್ ಮೈಕ್</translation>
<translation id="89720367119469899">ಎಸ್ಕೇಪ್</translation>
<translation id="8978939272793553320"><ph name="DEVICE_NAME" /> ಡಿಸ್‌ಕನೆಕ್ಟ್ ಆಗಿದೆ</translation>
<translation id="8985561265504464578">ಪತ್ತೆ ಮಾಡುವಿಕೆಯ ಥ್ರೆಶೋಲ್ಡ್</translation>
<translation id="8986362086234534611">ಮರೆತುಹೋಗು</translation>
<translation id="8993737615451556423">ಓದುವ ಧ್ವನಿಯನ್ನು ವೇಗಗೊಳಿಸುವ, ನಿಧಾನಗೊಳಿಸುವ ಮತ್ತು ವಿರಾಮಗೊಳಿಸಲು ನಿಯಂತ್ರಣಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ</translation>
<translation id="8999651235576960439">ಸ್ಕ್ರೀನ್‌ ಮೇಲೆ ಸರಿದಾಡುವುದು ಕಡಿಮೆಯಾಗಿದೆ</translation>
<translation id="9012122671773859802">ಮೌಸ್ ಚಲಿಸುವಾಗ ಪರದೆಯನ್ನು ನಿರಂತರವಾಗಿ ಸರಿಸಿ</translation>
<translation id="9014206344398081366">ChromeVox ಟುಟೋರಿಯಲ್</translation>
<translation id="9014674417732091912"><ph name="ROW_NUMBER" /> ಸಾಲಿಗೆ ಸರಿಸಲಾಗಿದೆ</translation>
<translation id="9016827136585652292">ಗೌಪ್ಯತೆ ಸ್ಕ್ರೀನ್ ಟಾಗಲ್</translation>
<translation id="9019956081903586892">ಕಾಗುಣಿತ ಪರೀಕ್ಷೆ ನಿಘಂಟನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ</translation>
<translation id="9020362265352758658">4x</translation>
<translation id="902638246363752736">ಕೀಬೋರ್ಡ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="9026393603776578602">ಡಿಕ್ಟೇಶನ್</translation>
<translation id="9030754204056345429">ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ</translation>
<translation id="9031811691986152304">ಪುನಃ ಪ್ರಯತ್ನಿಸಿ</translation>
<translation id="9043767139743235992">Google Disability ಬೆಂಬಲ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಿ</translation>
<translation id="9062468308252555888">14x</translation>
<translation id="9066782832737749352">ಪಠ್ಯದಿಂದ ಧ್ವನಿ</translation>
<translation id="9068598199622656904">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳಿಗಾಗಿ ಒಂದೇ ಸಮಯದಲ್ಲಿ ಕೀಗಳನ್ನು ಕೆಳಕ್ಕೆ ಹಿಡಿದಿಟ್ಟುಕೊಳ್ಳುವ ಬದಲು ಒಂದು ಸಮಯದಲ್ಲಿ ಒಂದೇ ಕೀಲಿಯನ್ನು ಒತ್ತಿರಿ</translation>
<translation id="9074739597929991885">ಬ್ಲೂಟೂತ್‌</translation>
<translation id="9089416786594320554">ಇನ್‌ಪುಟ್ ವಿಧಾನಗಳು</translation>
<translation id="9096053102600371572">ನಿಯಂತ್ರಿತ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆಯ ಕುರಿತು <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="9100416672768993722">ಕೊನೆಯದಾಗಿ ಬಳಸಿದ ಇನ್‌ಪುಟ್ ವಿಧಾನಕ್ಕೆ ಬದಲಾಯಿಸಲು, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR" /><ph name="BEGIN_SPACE" />ಸ್ಪೇಸ್<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> ಒತ್ತಿರಿ</translation>
<translation id="9111330022786356709">ನಿಮ್ಮ ಮೌಸ್‌ನಲ್ಲಿ ಬಟನ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ಪತ್ತೆ ಮಾಡಿ</translation>
<translation id="9116799625073598554">ಟಿಪ್ಪಣಿ-ತೆಗೆದುಕೊಳ್ಳುವ ಆ್ಯಪ್</translation>
<translation id="9126149354162942022">ಕರ್ಸರ್‌ನ ಬಣ್ಣ</translation>
<translation id="9128335130883257666"><ph name="INPUT_METHOD_NAME" /> ಗಾಗಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪುಟವನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="9148058034647219655">ನಿರ್ಗಮಿಸಿ</translation>
<translation id="9151249085738989067">ಭಾಷೆಯ ಆಧಾರದ ಮೇಲೆ ChromeVox ಧ್ವನಿಯನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬದಲಾಯಿಸಿ</translation>
<translation id="9151906066336345901">end</translation>
<translation id="9153451439615847952">ನೋಟಿಫಿಕೇಶನ್‌ಗಳು ಮತ್ತು ಅಲರ್ಟ್‌ಗಳಿಗಾಗಿ ಹಿನ್ನೆಲೆ ಆಡಿಯೊವನ್ನು ಕಡಿಮೆ ಮಾಡಿ</translation>
<translation id="915485121129452731">ಪೆನ್ ಟ್ಯಾಬ್ಲೆಟ್</translation>
<translation id="9157096865782046368">0.8 ಸೆಕೆಂಡುಗಳು</translation>
<translation id="9169496697824289689">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ</translation>
<translation id="9187967020623675250">ಕೀಗಳು ಹೊಂದಾಣಿಕೆಯಾಗುತ್ತಿಲ್ಲ. <ph name="RESPONSE" /> ಗೆ ಯಾವುದೇ ಕೀ ಅನ್ನು ಒತ್ತಿರಿ.</translation>
<translation id="9192019773545828776">ಮಾತಿನ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಆಲಿಸಿ ಇದರಿಂದ ನೀವು ಸ್ಕ್ರೀನ್ ಅನ್ನು ನೋಡದೆಯೇ ನಿಮ್ಮ ಸಾಧನವನ್ನು ಬಳಸಬಹುದು. ಸಂಪರ್ಕಿತ ಸಾಧನದೊಂದಿಗೆ ಬ್ರೈಲ್ ಪ್ರತಿಕ್ರಿಯೆ ಲಭ್ಯವಿದೆ. ChromeVox ಅನ್ನು ಆನ್ ಮತ್ತು ಆಫ್ ಮಾಡಲು Ctrl + Alt + Z ಬಳಸಿ. ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು Search + ಲೆಫ್ಟ್ ಆ್ಯರೋ ಅಥವಾ ರೈಟ್ ಗುರುತನ್ನು ಬಳಸಿ. ಆಯ್ಕೆ ಮಾಡಲು (ಸಕ್ರಿಯಗೊಳಿಸಲು) Search + ಸ್ಪೇಸ್  ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="9203296457393252944">ಕೆಂಪು-ಹಸಿರು, ಹಸಿರು ಬಣ್ಣಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ದುರ್ಬಲ ದೃಷ್ಟಿ (ಡ್ಯೂಟರಾನೋಮಲಿ)</translation>
<translation id="9205304506427975617">ನೀವು ಸ್ವಲ್ಪ ತಲೆ ಚಲನೆಯನ್ನು ಹೊಂದಿದ್ದರೂ ಸಹ ನೀವು ಕರ್ಸರ್ ಅನ್ನು ಸ್ಥಿರವಾಗಿರಿಸಿಕೊಳ್ಳಬಹುದು. ಕರ್ಸರ್‌ ಅನ್ನು ಸರಿಸಲು ಹೆಚ್ಚಿನ ಪ್ರಯತ್ನದ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="930551443325541578">ಕೀಗಳ ಪುನರಾವರ್ತನೆ ಹಾಗೂ ಉಚ್ಚಾರಣಾ ಗುರುತುಗಳು</translation>
<translation id="942296794412775122">ಮೈಕ್ರೊಫೋನ್ ಆನ್/ಆಫ್</translation>
<translation id="950307215746360464">ಸೆಟಪ್ ಗೈಡ್</translation>
<translation id="957179356621191750">6-ಡಾಟ್‌</translation>
<translation id="964790508619473209">ಸ್ಕ್ರೀನ್ ಜೋಡಣೆ</translation>
<translation id="966588271015727539">ಒಂದು ಬ್ಲೂಟೂತ್ ಬ್ರೈಲ್ ಡಿಸ್‌ಪ್ಲೇಯನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="973558314812359997">ಮೌಸ್ ಕರ್ಸರ್ ಗಾತ್ರ</translation>
<translation id="978146274692397928">ಆರಂಭದ ವಿರಾಮಚಿಹ್ನೆಯ ವಿಸ್ತಾರವು ಪೂರ್ಣವಾಗಿದೆ</translation>
<translation id="978978324795544535">ಐಟಂ ಅನ್ನು ಡಬಲ್-ಟ್ಯಾಪ್ ಮಾಡಿ, ಎರಡನೇ ಟ್ಯಾಪ್ ಮಾಡುವಾಗ ಒತ್ತಿಹಿಡಿಯಿರಿ, ತದನಂತರ ಅದನ್ನು ಮೂವ್ ಮಾಡಲು ಐಟಂ ಅನ್ನು ಎಳೆಯಿರಿ</translation>
<translation id="984705303330760860">ಕಾಗುಣಿತ ಪರೀಕ್ಷೆಯ ಭಾಷೆಗಳನ್ನು ಸೇರಿಸಿ</translation>
<translation id="987264212798334818">ಸಾಮಾನ್ಯ</translation>
<translation id="992256792861109788">ಗುಲಾಬಿ ಬಣ್ಣ</translation>
</translationbundle>