<translation id="625827534921607067">ಈ ಹಿಂದೆ ಕನೆಕ್ಟ್ ಮಾಡಲಾದ ಅಥವಾ ಕಾನ್ಫಿಗರ್ ಮಾಡಲಾದ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ನೆಟ್‌ವರ್ಕ್ ಲಭ್ಯವಿದ್ದರೆ ಈ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಆದ್ಯತೆ ನೀಡಲಾಗುತ್ತದೆ</translation>
<translation id="6265159465845424232">Microsoft ಫೈಲ್‌ಗಳನ್ನು Microsoft OneDrive ಗೆ ಕಾಪಿ ಮಾಡುವ ಅಥವಾ ಸರಿಸುವ ಮೊದಲು ಕೇಳಿ</translation>
<translation id="6265687851677020761">ಪೋರ್ಟ್ ತೆಗೆದುಹಾಕಿ</translation>
<translation id="6266532094411434237"><ph name="DEVICE" /> ಗೆ ಕನೆಕ್ಟ್ ಆಗುತ್ತಿದೆ</translation>
<translation id="6270309713620950855">ನಡ್ಜ್ ಮ್ಯೂಟ್ ಮಾಡಿ</translation>
<translation id="6274089201566806618"><ph name="HOST_DEVICE_NAME" /> ಗೆ ಕನೆಕ್ಟ್ ಆಗುತ್ತಿದೆ</translation>
<translation id="628352644014831790">4 ಸೆಕೆಂಡುಗಳು</translation>
<translation id="6287828400772161253">Android ಫೋನ್ (<ph name="HOST_DEVICE_NAME" />)</translation>
<translation id="6294759976468837022">ಸ್ವಯಂ-ಸ್ಕ್ಯಾನ್ ವೇಗ</translation>
<translation id="6300718114348072351"><ph name="PRINTER_NAME" /> ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಾನ್ಫಿಗರ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸುಧಾರಿತ ಪ್ರಿಂಟರ್ ವಿವರಗಳನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="6302661287897119265">ಫಿಲ್ಟರ್</translation>
<translation id="6305627295927385295">ಈ ಕೆಳಗಿನ ಐಟಂಗಳನ್ನು ಅಳಿಸಿ:</translation>
<translation id="6305702903308659374">ChromeVox ಮಾತನಾಡುತ್ತಿರುವಾಗಲೂ ಸಹ ಸಾಮಾನ್ಯ ವಾಲ್ಯೂಮ್‌‌ನಲ್ಲಿ ಪ್ಲೇ ಮಾಡಿ</translation>
<translation id="6307268917612054609">ಕ್ಯಾಮರಾ ಅನುಮತಿಯಿರುವ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ವೆಬ್‌ಸೈಟ್‌ಗಳು, ಅಷ್ಟೇ ಅಲ್ಲದೇ ಸಿಸ್ಟಂ ಸರ್ವಿಸ್‌ಗಳು ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6309443618838462258">ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಈ ಇನ್‌ಪುಟ್ ವಿಧಾನವನ್ನು ಅನುಮತಿಸುವುದಿಲ್ಲ</translation>
<translation id="6313950457058510656">ತತ್‌ಕ್ಷಣ ಟೆಥರಿಂಗ್ ಆಫ್ ಮಾಡಿ</translation>
<translation id="6315170314923504164">ಧ್ವನಿ</translation>
<translation id="6318944945640833942">ಪ್ರಿಂಟರ್ ಅನ್ನು ಪತ್ತೆಹಚ್ಚಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪ್ರಿಂಟರ್ ವಿಳಾಸವನ್ನು ಪುನಃ ನಮೂದಿಸಿ.</translation>
<translation id="6327785803543103246">ವೆಬ್‌ ಪ್ರಾಕ್ಸಿಯ ಸ್ವಯಂಅನ್ವೇಷಣೆ</translation>
<translation id="6336194758029258346">ಆ್ಯಪ್ ಭಾಷೆ</translation>
<translation id="6338968693068997776">USB ಸಾಧನವನ್ನು ಸೇರಿಸಿ</translation>
<translation id="6340071272923955280">ಇಂಟರ್ನೆಟ್ ಮುದ್ರಿಸುವಿಕೆಯ ಪ್ರೊಟೊಕಾಲ್ (IPPS)</translation>
<translation id="6343981313228733146">ವಿಂಡೋವನ್ನು ಮೇಲಕ್ಕೆ ಮತ್ತು ಬಲಕ್ಕೆ ಸರಿಸಲಾಗಿದೆ</translation>
<translation id="6344576354370880196">ಸೇವ್ ಮಾಡಿದ ಪ್ರಿಂಟರ್‌ಗಳು</translation>
<translation id="6347010704471250799">ಅಧಿಸೂಚನೆಯನ್ನು ತೋರಿಸಿ</translation>
<translation id="6348252528297699679">ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ &gt; ಗೌಪ್ಯತೆ ನಿಯಂತ್ರಣಗಳು &gt; ಸ್ಥಳದ ಆ್ಯಕ್ಸೆಸ್‌ನಲ್ಲಿ ಸ್ಥಳವನ್ನು ಆಫ್ ಮಾಡಬಹುದು. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="6348805481186204412">ಆಫ್‌ಲೈನ್ ಸಂಗ್ರಹಣೆ</translation>
<translation id="6349101878882523185"><ph name="APP_NAME" /> ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="6351178441572658285">ಆ್ಯಪ್ ಭಾಷೆಗಳು</translation>
<translation id="6356718524173428713">ಪುಟವನ್ನು ಕೆಳಕ್ಕೆ ಸರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ಕ್ರಾಲ್ ಮಾಡಿ</translation>
<translation id="6367196786591004737">ನಮೂದನ್ನು ಅಳಿಸಿ</translation>
<translation id="6367396429435748845">ಮೌಸ್ ಕೀಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು ಮತ್ತು ಪುನರಾರಂಭಿಸಲು <ph name="ALT" /> + <ph name="LAUNCHER" /> + <ph name="NUM_4" /> ಒತ್ತಿರಿ</translation>
<translation id="6370551072524410110">ಹುಡುಕಾಟ + shift + backspace</translation>
<translation id="6388429472088318283">ಭಾಷೆಗಳನ್ನು ಹುಡುಕಾಡಿ</translation>
<translation id="6391131092053186625">ನಿಮ್ಮ ಸಾಧನದ IMEI ಸಂಖ್ಯೆ <ph name="IMEI_NUMBER" /> ಆಗಿದೆ. ಸೇವೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಲು ಈ ಸಂಖ್ಯೆಯನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="6398715114293939307">Google Play Store  ತೆಗೆದುಹಾಕಿ</translation>
<translation id="6399675241776343019">ನಿರಾಕರಿಸಲಾಗಿದೆ</translation>
<translation id="6401118106417399952">ನಿಮ್ಮ ಸಾಧನದ EID ಸಂಖ್ಯೆ <ph name="EID_NUMBER" /> ಮತ್ತು ಸಾಧನದ ಕ್ರಮ ಸಂಖ್ಯೆ <ph name="SERIAL_NUMBER" /> ಆಗಿದೆ. ಸೇವೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಲು ಈ ಸಂಖ್ಯೆಗಳನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="6405999530973682789">ಮೌಸ್ ಕರ್ಸರ್ ಕಳೆದುಹೋಗಿದೆ</translation>
<translation id="6406506848690869874">ಸಿಂಕ್</translation>
<translation id="6410328738210026208">ಚಾನಲ್ ಬದಲಿಸಿ ಮತ್ತು ಪವರ್‌ವಾಷ್ ಮಾಡಿ</translation>
<translation id="6411135999030237579">ಕೀ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪುನರಾವರ್ತಿಸಲು ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ</translation>
<translation id="6415757856498750027">"ư" ಪಡೆಯಲು "w" ಎಂದು ಟೈಪ್ ಮಾಡಿ</translation>
<translation id="6415900369006735853">ನಿಮ್ಮ ಫೋನ್‌ನ ಮೂಲಕ ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಗೊಳಿಸಿ</translation>
<translation id="641817663353603351">ಪೇಜ್ ಅಪ್</translation>
<translation id="641899100123938294">ಹೊಸ ಸಾಧನಗಳಿಗಾಗಿ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ</translation>
<translation id="6425556984042222041">ಪಠ್ಯದಿಂದ ಧ್ವನಿ ದರ</translation>
<translation id="6434104957329207050">ಪಾಯಿಂಟ್ ಸ್ಕ್ಯಾನ್ ಮಾಡುವ ವೇಗ</translation>
<translation id="6442445294758185945">ಅಪ್‌ಡೇಟ್ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6444070574980481588">ದಿನಾಂಕ ಮತ್ತು ಸಮಯವನ್ನು ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="6444147596556711162">ಐಟಂಗಳ ನಡುವೆ ಸರಿಸಲು, ಸ್ಕ್ರೀನ್‌ ಮೇಲಿರುವ “ಮುಂದಿನದು” ಮತ್ತು “ಹಿಂದಿನದು” ಬಟನ್ ಬಳಸಿ</translation>
<translation id="6452961788130242735">ನೆಟ್‌ವರ್ಕ್ ಸಮಸ್ಯೆ ಅಥವಾ ಕಳಪೆ ಸಂಪರ್ಕ ಸ್ಥಿತಿ</translation>
<translation id="6453921811609336127">ಮುಂದಿನ ಇನ್‌ಪುಟ್ ವಿಧಾನಕ್ಕೆ ಬದಲಾಯಿಸಲು, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR1" /><ph name="BEGIN_SHIFT" />Shift<ph name="END_SHIFT" /><ph name="SEPARATOR2" /><ph name="BEGIN_SPACE" />ಸ್ಪೇಸ್<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> ಒತ್ತಿರಿ</translation>
<translation id="6463488491707167747">ಈ ನಿಘಂಟನ್ನು ಅಳಿಸಿ</translation>
<translation id="6463596731306859179">ಅನಗತ್ಯ ಪಾಪ್-ಅಪ್‌ಗಳು ಅಥವಾ ಇತರ ಅನಿರೀಕ್ಷಿತ ನಡವಳಿಕೆಯನ್ನು ಪಡೆಯುತ್ತಿದ್ದೀರಾ? ಕೆಲವೊಮ್ಮೆ, ನೀವು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ನಿಮಗೆ ತಿಳಿಯದಂತೆಯೇ ನಿಮ್ಮ ChromeOS ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="6467377768028664108">ನಂತರ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಹೀಗೆ ಮಾಡಬಹುದು:</translation>
<translation id="6469557521904094793">ಸೆಲ್ಯುಲರ್ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="6470120577693311302">ಫ್ಲ್ಯಾಶ್ ನೋಟಿಫಿಕೇಶನ್‌ಗಳು</translation>
<translation id="6470823736074966819">ಅಧಿಸೂಚನೆಗಳನ್ನು ಮ್ಯೂಟ್ ಮಾಡಿ</translation>
<translation id="6474498546677193336">ಒಂದು ಅಪ್ಲಿಕೇಶನ್, ಈ ಫೋಲ್ಡರ್ ಅನ್ನು ಬಳಸುತ್ತಿರುವ ಕಾರಣ, ಅದರ ಹಂಚಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಲಿಲ್ಲ. ಮುಂದಿನ ಸಲ Linux ಅನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಿದಾಗ, ಈ ಫೋಲ್ಡರ್ ಹಂಚಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6474884162850599008">Google ಡ್ರೈವ್ ಖಾತೆಗೆ ಸಂಪರ್ಕ ಕಡಿತಗೊಳಿಸಿ</translation>
<translation id="6476482583633999078">ಧ್ವನಿಯ ವೇಗ</translation>
<translation id="6476671549211161535">ನಿಮ್ಮ <ph name="DEVICE_NAME" /> ನಲ್ಲಿನ ಎಡ ಅಥವಾ ಬಲ ಮೌಸ್ ಬಟನ್ ಅಲ್ಲದಿರುವ ಬಟನ್ ಒತ್ತಿರಿ.</translation>
<translation id="6477822444490674459">ಕೆಲಸದ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಫೋನ್‌ಗಳು ನೋಟಿಫಿಕೇಶನ್ ಸಿಂಕ್ ಮಾಡುವಿಕೆಯನ್ನು ಬೆಂಬಲಿಸುವುದಿಲ್ಲ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="6481749622989211463">ಸಮೀಪದಲ್ಲಿರುವ ಸಾಧನಗಳೊಂದಿಗೆ ಫೈಲ್‌ಗಳು ಮತ್ತು ಇನ್ನಷ್ಟನ್ನು ಹಂಚಿಕೊಳ್ಳಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="648204537326351595">ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು <ph name="SPECIFIC_NAME" /> ಗೆ ಅನುಮತಿಸಿ</translation>
<translation id="6482559668224714696">ಪೂರ್ಣಪರದೆ ವರ್ಧಕ</translation>
<translation id="648927581764831596">ಯಾವುದೂ ಲಭ್ಯವಿಲ್ಲ</translation>
<translation id="6497784818439587832">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ನ ಮೇಲಿನ ಐಟಂಗಳನ್ನು ಚಿಕ್ಕದಾಗಿಸಲು ಅಥವಾ ದೊಡ್ಡದಾಗಿ ಮಾಡಲು ಡಿಸ್‌ಪ್ಲೇ ಗಾತ್ರವನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="6497789971060331894">ಮೌಸ್ ಹಿಮ್ಮುಖ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆ</translation>
<translation id="650185290742160385">ಥ್ರೆಶೋಲ್ಡ್‌ ಅನ್ನು ಕಡಿಮೆ ಮಾಡಿ</translation>
<translation id="650457560773015827">ಎಡ ಬಟನ್</translation>
<translation id="6504611359718185067">ಪ್ರಿಂಟರ್ ಸೇರಿಸಲು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ</translation>
<translation id="6514010653036109809">ಲಭ್ಯವಿರುವ ಸಾಧನ:</translation>
<translation id="6517420300299531857">ನನ್ನ ಡ್ರೈವ್‌ನಲ್ಲಿರುವ ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ನಿಮ್ಮ Chromebook ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸಿಂಕ್ ಆಗುತ್ತವೆ ಇದರಿಂದ ನೀವು ಇಂಟರ್‌ನೆಟ್ ಕನೆಕ್ಷನ್ ಇಲ್ಲದೆಯೇ ಅವುಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು. ಇದು ಸುಮಾರು <ph name="REQUIRED_SPACE" /> ಯಷ್ಟು ಸ್ಥಳಾವಕಾಶ ಬಳಸುತ್ತದೆ. ನೀವು ಪ್ರಸ್ತುತ <ph name="FREE_SPACE_AVAILABLE" /> ಯಷ್ಟು ಸ್ಥಳಾವಕಾಶ ಹೊಂದಿದ್ದೀರಿ.</translation>
<translation id="6517709704288360414">ನಿಮ್ಮ ಸಾಧನವು ಇನ್ನು ಮುಂದೆ ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು ಮತ್ತು ನೀವು ಭದ್ರತೆ ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯ ಸಮಸ್ಯೆಗಳನ್ನು ಅನುಭವಿಸಬಹುದು. ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಆಫ್ ಮಾಡುವುದರಿಂದ, ನಿಮಗೆ ಯಾವುದೇ ಸಮಸ್ಯೆಗಳು ಎದುರಾದರೆ ಕಾನೂನಾತ್ಮಕ ಕ್ಲೈಮ್‌ಗಳನ್ನು ಮಾಡುವ ನಿಮ್ಮ ಹಕ್ಕಿನ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರಬಹುದು.</translation>
<translation id="6518133107902771759">ಪರಿಶೀಲಿಸಿ</translation>
<translation id="6520876759015997832"><ph name="LIST_SIZE" /> ರಲ್ಲಿ <ph name="LIST_POSITION" /> ಹುಡುಕಾಟ ಫಲಿತಾಂಶ: <ph name="SEARCH_RESULT_TEXT" />. ವಿಭಾಗಕ್ಕೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು Enter ಅನ್ನು ಒತ್ತಿರಿ.</translation>
