<translation id="3080933187214341848">ಈ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ನಿಮ್ಮ ಖಾತೆಗೆ ಸಿಂಕ್ ಮಾಡಲಾಗಿಲ್ಲ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="308268297242056490">URI</translation>
<translation id="3083899879156272923">ಪರದೆಯಲ್ಲಿ ಮೌಸ್ ಅನ್ನು ಮಧ್ಯದಲ್ಲಿ ಇರಿಸುತ್ತಾ ಪರದೆಯನ್ನು ಸರಿಸಿ</translation>
<translation id="3090227230165225418">ಡೌನ್‌ಲೋಡ್ ಅಧಿಸೂಚನೆಗಳನ್ನು ಪ್ರಕಟಿಸಿ</translation>
<translation id="3094080575472025333">ಆ್ಯಪ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸಿ</translation>
<translation id="3095871294753148861">ಪ್ರಾಥಮಿಕ ಖಾತೆಯ ಜೊತೆಗೆ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತರ ಬ್ರೌಸಿಂಗ್‌ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲಾಗಿದೆ.</translation>
<translation id="3097674000822532270">ನಿಮ್ಮ Google ಖಾತೆಯ ಮೂಲಕ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ಎಲ್ಲಾ ChromeOS Flex ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಲಾಗುತ್ತದೆ. ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ಯಾವ ಬ್ರೌಸರ್ ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲಾಗಿದೆ ಎಂಬುದನ್ನು ನಿರ್ವಹಿಸಲು, <ph name="LINK_BEGIN" />Chrome ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ<ph name="LINK_END" /> ಹೋಗಿ.</translation>
<translation id="3101126716313987672">ಡಿಮ್ ಲೈಟ್</translation>
<translation id="3101709781009526431">ದಿನಾಂಕ  ಮತ್ತು  ಸಮಯ</translation>
<translation id="3105990244222795498"><ph name="DEVICE_NAME" /> (ಬ್ಲೂಟೂತ್‌)</translation>
<translation id="3108957152224931571">ಹೈಲೈಟ್ ಬಣ್ಣ</translation>
<translation id="3112292765614504292">ಆ್ಯಪ್ ಗಾತ್ರ: <ph name="APP_SIZE" /></translation>
<translation id="3115743155098198207">Google ಖಾತೆಯ ಭಾಷೆಯನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="3119743309973425629">ಪಠ್ಯದ ಕರ್ಸರ್ ಬ್ಲಿಂಕ್ ದರ</translation>
<translation id="3126026824346185272">Ctrl</translation>
<translation id="3127862849166875294">Linux ಡಿಸ್ಕ್ ಮರುಗಾತ್ರಗೊಳಿಸುವಿಕೆ</translation>
<translation id="3129150892373332590">ಇದು ಅತಿಥಿಗಳೊಂದಿಗೆ USB ಸಾಧನಗಳ ನಿರಂತರ ಹಂಚಿಕೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ, ಇದು ಎಲ್ಲಾ ನಿರಂತರತೆಯನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ. ನೀವು ಖಚಿತವಾಗಿರುವಿರಾ?</translation>
<translation id="3132277757485842847">ನಿಮ್ಮ ಫೋನ್‌ನೊಂದಿಗೆ ಕನೆಕ್ಷನ್ ಕಾಯ್ದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ಫೋನ್ ಸಮೀಪದಲ್ಲಿದೆ, ಅನ್‌ಲಾಕ್ ಆಗಿದೆ ಮತ್ತು ಅದರಲ್ಲಿ ಬ್ಲೂಟೂತ್ ಹಾಗೂ ವೈ-ಫೈ ಆನ್ ಆಗಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="3151786313568798007">ಓರಿಯಂಟೇಶನ್</translation>
<translation id="3152356229013609796">ನಿಮ್ಮ ಫೋನ್‌ನ ಅಧಿಸೂಚನೆಗಳನ್ನು ವೀಕ್ಷಿಸಿ, ವಜಾಗೊಳಿಸಿ ಮತ್ತು ಪ್ರತ್ಯುತ್ತರಿಸಿ</translation>
<translation id="3158033540161634471">ನಿಮ್ಮ ಫಿಂಗರ್‌ಪ್ರಿಂಟ್ ಅನ್ನು ಸೆಟಪ್‌ ಮಾಡಿ</translation>
<translation id="3158770568048368350">ಇದು ನಿಮ್ಮ ಮೊಬೈಲ್ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ತಾತ್ಕಾಲಿಕವಾಗಿ ಡಿಸ್‌ಕನೆಕ್ಟ್ ಮಾಡಲು ಕಾರಣವಾಗಬಹುದು</translation>
<translation id="3160928651883997588">VPN ಆದ್ಯತೆಗಳು</translation>
<translation id="3161522574479303604">ಎಲ್ಲಾ ಭಾಷೆಗಳು</translation>
<translation id="3162853326462195145">ಶಾಲೆಯ ಖಾತೆ</translation>
<translation id="3165390001037658081">ಕೆಲವು ವಾಹಕಗಳು ಈ ವೈಶಿಷ್ಟ್ಯವನ್ನು ನಿರ್ಬಂಧಿಸಬಹುದು.</translation>
<translation id="3167446923957429259">ನಿಮ್ಮ ಬಾಯಿಯನ್ನು ಎಡಬದಿಗೆ ಮೂವ್ ಮಾಡುವುದು</translation>
<translation id="3176347586396987181">ಮೌಸ್ ಬಟನ್ ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಲು “z” ಕೀಯನ್ನು ಬಳಸಿ</translation>
<translation id="3177430966804511955">ಪ್ರತ್ಯೇಕಗೊಳಿಸಲಾದ ವೆಬ್ ಆ್ಯಪ್‌ಗಳು (ಬೀಟಾ) ಅನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="3180990259147710757">ದವಡೆಯನ್ನು ಎಡಕ್ಕೆ ಸರಿಸುವುದು</translation>
<translation id="3182749001423093222">ಕಾಗುಣಿತ ಪರಿಶೀಲನೆ</translation>
<translation id="3183143381919926261">ಮೊಬೈಲ್ ಡೇಟಾ ನೆಟ್‌ವರ್ಕ್‌ಗಳು</translation>
<translation id="3183944777708523606">ಮಾನಿಟರ್ ಜೋಡಣೆ</translation>
<translation id="3184536091884214176">CUPS ಪ್ರಿಂಟರ್‌ಗಳನ್ನು ಸೆಟಪ್ ಮಾಡಿ ಅಥವಾ ನಿರ್ವಹಿಸಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="3184591616546256659">ಪೋಷಕ ನಿಯಂತ್ರಣಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು ಈ ಪಿನ್ ಅನ್ನು ಬಳಸಿ.
    ನೀವು ಪಿನ್ ಅನ್ನು ಮರೆತರೆ, ಈ ಸಾಧನವನ್ನು ಪವರ್‌ವಾಷ್ ಮಾಡಿ ಹಾಗೂ ಪುನಃ ಸೆಟಪ್‌ ಮಾಡಿ.</translation>
<translation id="3188257591659621405">ನನ್ನ ಫೈಲ್‌ಗಳು</translation>
<translation id="3189187154924005138">ದೊಡ್ಡ ಕರ್ಸರ್</translation>
<translation id="3197453258332670132">ಬಲ-ಕ್ಲಿಕ್ ಅಥವಾ ದೀರ್ಘಕಾಲ ಒತ್ತಿಹಿಡಿಯಿರಿ, ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಪಠ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಮಾಹಿತಿಯನ್ನು ತೋರಿಸಿ</translation>
<translation id="3201422919974259695">ಲಭ್ಯವಿರುವ USB ಸಾಧನಗಳು ಇಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="3206289903841621620"><ph name="NUMBER" /> ಬಳಕೆದಾರರ ನಿಘಂಟು</translation>
<translation id="3223531857777746191">’ಮರುಹೊಂದಿಸಿ’ ಬಟನ್</translation>
<translation id="3227137524299004712">ಮೈಕ್ರೋಫೋನ್</translation>
<translation id="3230539834943294477">ಸಹಾಯ ಒದಗಿಸುವ ಲೇಖನಗಳನ್ನು ವೀಕ್ಷಿಸಿ ಅಥವಾ ಸಾಧನ ಬೆಂಬಲವನ್ನು ಹುಡುಕಿ</translation>
<translation id="3232754137068452469">ವೆಬ್ ಅಪ್ಲಿಕೇಶನ್</translation>
<translation id="3233271424239923319">Linux ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಿ</translation>
<translation id="3241638166094654466">ಪ್ರತಿಯೊಂದು ಸಾಲಿನಲ್ಲಿರುವ ಸೆಲ್‌ಗಳು:</translation>
<translation id="324366796737464147">ಗದ್ದಲ ನಿವಾರಣೆ</translation>
<translation id="3251119461199395237">ಫೈಲ್ ಸಿಂಕ್</translation>
<translation id="3254516606912442756">ಸಮಯ ವಲಯವನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪತ್ತೆಹಚ್ಚುವುದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="3266022278425892773">Linux ಡೆವಲಪ್‌ಮೆಂಟ್ ಎನ್ವಿರಾನ್‌ಮೆಂಟ್</translation>
<translation id="3266688867683447361"><ph name="ITEM" /> ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ. <ph name="COUNT" /> ರಲ್ಲಿ <ph name="INDEX" />. ಆಯ್ಕೆ ಮಾಡದಿರಲು, Search ಜೊತೆಗೆ Space ಅನ್ನು ಒತ್ತಿರಿ.</translation>
<translation id="3277214528693754078">ಪಠ್ಯ ಕರ್ಸರ್‌ನೊಂದಿಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ (ಕೆರೆಟ್ ಬ್ರೌಸಿಂಗ್)</translation>
<translation id="3289668031376215426">ಸ್ವಯಂ-ದೊಡ್ಡಕ್ಷರ</translation>
<translation id="3292966601422448005">ನೀವು <ph name="APP_NAME" /> ಗೆ ನೀಡುವ ಅನುಮತಿಗಳನ್ನು ಅದರ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲಾದ ಆ್ಯಪ್‌ಗಳಿಗೂ ನೀಡಲಾಗುತ್ತದೆ.</translation>
<translation id="3294686910656423119">ಬಳಕೆ ಅಂಕಿಅಂಶಗಳು ಮತ್ತು ಕ್ರ್ಯಾಶ್ ವರದಿಗಳು</translation>
<translation id="3321460131042519426">ವರ್ಡ್ ವ್ರ್ಯಾಪ್ ಸಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="3321494112580110651">ನಿಮ್ಮ ಪ್ರಿಂಟರ್ ಕಾಣಿಸುತ್ತಿಲ್ಲವೇ?</translation>
<translation id="3321776060736518525"><ph name="APP_URL" /> ನಿಂದ</translation>
<translation id="3335380372402547327">ಫ್ಲಾಶ್ ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ಪೂರ್ವವೀಕ್ಷಿಸಿ</translation>
<translation id="334252345105450327">ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆದುಕೊಳ್ಳಿ</translation>
<translation id="3351472127384196879">ನಿಮ್ಮ ಪೆನ್‌ನಲ್ಲಿ ಬಟನ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ಪತ್ತೆಮಾಡಿ</translation>
<translation id="335581015389089642">ಧ್ವನಿ</translation>
<translation id="3368922792935385530">ಕನೆಕ್ಟ್ ಆಗಿದೆ</translation>
<translation id="3369067987974711168">ಈ ಪೋರ್ಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದ ಇನ್ನಷ್ಟು ಕ್ರಮಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="3370260763947406229">ಸ್ವಯಂ-ತಿದ್ದುಪಡಿ</translation>
<translation id="3371351218553893534">ಸಾಲು ತುಂಬಾ ಉದ್ದವಾಗಿದೆ: <ph name="ERROR_LINE" /></translation>
<translation id="3378627645871606983">Steam ‌ಗೆ ನೀಡಿದ ಅನುಮತಿಗಳು ಎಲ್ಲಾ Steam ಗೇಮ್‌ಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳಿಗೆ ಅನ್ವಯಿಸುತ್ತವೆ.</translation>
<translation id="338323348408199233">VPN ಬಳಸದೇ ಟ್ರಾಫಿಕ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿ</translation>
<translation id="3385092118218578224"><ph name="DISPLAY_ZOOM" />%</translation>
<translation id="3385172418915595177">ಸ್ಥಳದ ನಿಖರತೆಯು ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಸೇವೆಗಳಿಗೆ ಹೆಚ್ಚು ನಿಖರವಾದ ಸ್ಥಳವನ್ನು ಒದಗಿಸುತ್ತದೆ. ಇದನ್ನು ಮಾಡಲು, ನಿಮ್ಮ ಸಾಧನದಿಂದ ಕ್ರೌಡ್‌ಸೋರ್ಸ್ ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್ ಸ್ಥಳಗಳಿಗೆ ಸಾಧನದ ಸೆನ್ಸರ್‌ಗಳು ಮತ್ತು ವೈರ್‌ಲೆಸ್ ಸಿಗ್ನಲ್‌ಗಳ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು Google ನಿಯತಕಾಲಿಕವಾಗಿ ಪ್ರಾಸೆಸ್ ಮಾಡುತ್ತದೆ. ಸ್ಥಳದ ನಿಖರತೆ ಮತ್ತು ಸ್ಥಳ ಆಧಾರಿತ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು ಮತ್ತು ಬಳಕೆದಾರರ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಲು Google ನ ಮತ್ತು ಥರ್ಡ್ ಪಾರ್ಟಿಗಳ ಕಾನೂನುಬದ್ಧ ಆಸಕ್ತಿಗಳ ಆಧಾರದ ಮೇಲೆ Google ನ ಸೇವೆಗಳನ್ನು ಸುಧಾರಿಸಲು, ಒದಗಿಸಲು ಮತ್ತು ನಿರ್ವಹಿಸಲು ನಿಮ್ಮನ್ನು ಗುರುತಿಸದೆಯೇ ಇವುಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ.</translation>
<translation id="3388094447051599208">ಔಟ್‌ಪುಟ್ ಟ್ರೇ ಬಹುತೇಕ ಭರ್ತಿಯಾಗಿದೆ</translation>
<translation id="3390013585654699824">ಆ್ಯಪ್‌ ವಿವರಗಳು</translation>
<translation id="3390740059150071453">ಎಡಕ್ಕೆ ನೋಡುವುದು</translation>
<translation id="3400390787768057815"><ph name="WIDTH" /> x <ph name="HEIGHT" /> (<ph name="REFRESH_RATE" /> ಹರ್ಟ್ಜ್) - ಇಂಟರ್‌ಲೇಸ್ ಆಗಿದೆ</translation>
<translation id="3406396172897554194">ಭಾಷೆ ಅಥವಾ ಇನ್‌ಪುಟ್ ಹೆಸರಿನ ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="3409157109901479672">ಎಡ ಭಾಗ</translation>
<translation id="3414974735818878791">ಮಧ್ಯೆ ಕ್ಲಿಕ್</translation>
<translation id="3417836307470882032">24-ಗಂಟೆಯ ಗಡಿಯಾರ ಬಳಸಿ</translation>
<translation id="3423463006624419153">ನಿಮ್ಮ '<ph name="PHONE_NAME_1" />' ಮತ್ತು '<ph name="PHONE_NAME_2" />' ನಲ್ಲಿ:</translation>
<translation id="3429271624041785769">ವೆಬ್ ವಿಷಯದ ಭಾಷೆಗಳು</translation>
<translation id="3431530007831146102">ಮೌಸ್ ಕರ್ಸರ್ ಅನ್ನು ಕಂಟ್ರೋಲ್ ಮಾಡಲು ತಲೆಯ ಚಲನೆಯನ್ನು ಬಳಸಿ</translation>
<translation id="3433507769937235446">ನಿರ್ಗಮಿಸುವಾಗ ಲಾಕ್ ಮಾಡಿ</translation>
<translation id="3434475275396485144">ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ನಿಮ್ಮ ಫೋನ್‌ನ ನಿರ್ವಾಹಕರು ನಿರ್ವಹಿಸುತ್ತಾರೆ</translation>
<translation id="3435738964857648380">ಭದ್ರತೆ</translation>
<translation id="343578350365773421">ಪೇಪರ್ ಖಾಲಿಯಾಗಿದೆ</translation>
<translation id="3441653493275994384">ಸ್ಕ್ರೀನ್‌</translation>
<translation id="3441824746233675597">ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು <ph name="PRODUCT_NAME" /> ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ.</translation>
<translation id="3442674350323953953"><ph name="DEVICE_OS" /> ಅನ್ನು ಸುಧಾರಿಸಲು ನೆರವಾಗಲು Google ಗೆ ನಿಮ್ಮ ಹಾರ್ಡ್‌ವೇರ್ ಡೇಟಾ ಬಳಸಲು ಅನುಮತಿಸಿ. ನೀವು ನಿರಾಕರಿಸಿದರೆ, ಸೂಕ್ತವಾದ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ನಿರ್ಧರಿಸಲು ಈ ಡೇಟಾವನ್ನು ಈಗಲೂ Google ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ ಆದರೆ ಅದನ್ನು ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಬಳಸಲಾಗುವುದಿಲ್ಲ.</translation>
