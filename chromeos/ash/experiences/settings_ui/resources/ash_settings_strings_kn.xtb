<translation id="1974159333077206889">ಎಲ್ಲಾ ಸ್ಪೀಕರ್‌ಗಳಲ್ಲಿ ಒಂದೇ ಆಡಿಯೋ</translation>
<translation id="1988733631391393183">ಬ್ರೈಲ್‌ ಕಮಾಂಡ್‌ಗಳನ್ನು ChromeVox ಮೆನುಗಳಲ್ಲಿ ತೋರಿಸಿ</translation>
<translation id="1999763610967697511">ಎಳೆಯಿರಿ ಮತ್ತು ಬಿಡಿ</translation>
<translation id="2003596238737586336">ಪ್ರಸ್ತುತ ವೇಳಾಪಟ್ಟಿಯನ್ನು <ph name="SUNRISE" /> - <ph name="SUNSET" /> ಗೆ ಸೆಟ್ ಮಾಡಲಾಗಿದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ನಿರ್ವಹಿಸುತ್ತಾರೆ.</translation>
<translation id="2025123106058020990">ನಿಖರತೆಯ ಕ್ಲಿಕ್</translation>
<translation id="2026377162111110983">ಪ್ರದೇಶದ ಧ್ವನಿ</translation>
<translation id="2030455719695904263">ಟ್ರ್ಯಾಕ್‌ಪ್ಯಾಡ್</translation>
<translation id="2045838962742066664">ಶಾರ್ಟ್‌ಹ್ಯಾಂಡ್ ಟೈಪಿಂಗ್</translation>
<translation id="2066700471214517561">ಬೀಮ್‌ಫಾರ್ಮಿಂಗ್ ಮೈಕ್, ಇದರಿಂದ Chromebook ಅನ್ನು ಬಳಸುವ ವ್ಯಕ್ತಿಯ ಧ್ವನಿಯನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಕೇಳಲಾಗುತ್ತದೆ.</translation>
