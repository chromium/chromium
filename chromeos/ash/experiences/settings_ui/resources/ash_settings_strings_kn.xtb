<translation id="2221261048068091179"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" /></translation>
<translation id="2234208862050358325">ಕರ್ಸರ್ ಅನ್ನು ಸರಿಸಲು 1, 2, 3, q, e, a, s, d ಕೀಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="2243934210752059021">ಹುಡುಕಾಟ ಮಾಡಿ + alt + <ph name="TOP_ROW_KEY" /></translation>
<translation id="2245603955208828424">ಐಟಂಗಳನ್ನು ಅಕ್ಷರದ ಮೂಲಕ ಸರಿಸಲು ಬಾಣದ ಕೀಲಿಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="2247870315273396641">ಧ್ವನಿ ಪೂರ್ವವೀಕ್ಷಣೆ</translation>
<translation id="2250153645770828940">ಡಿಕ್ಷನರಿಯನ್ನು ಅಳಿಸಿ</translation>
<translation id="22505994009453896">ಸಂಖ್ಯಾ ಕೀಪ್ಯಾಡ್ ಬಳಸಿಕೊಂಡು ನಿಮ್ಮ ಮೌಸ್ ಕರ್ಸರ್ ಅನ್ನು ನಿಯಂತ್ರಿಸಿ</translation>
<translation id="2262477216570151239">ಪುನರಾವರ್ತನೆಗೆ ಮೊದಲು ವಿಳಂಬ</translation>
<translation id="2263371730707937087">ಸ್ಕ್ರೀನ್ ರಿಫ್ರೆಶ್ ರೇಟ್</translation>
<translation id="2270666014403455717">“ಆಯ್ಕೆಮಾಡಿ” ಬಟನ್‌ಗೆ ಸ್ವಿಚ್ ಅನ್ನು ನಿಯೋಜಿಸಿ</translation>
<translation id="2272430695183451567">0 ಬದಲಾವಣೆಗಳನ್ನು ನಿಯೋಜಿಸಲಾಗಿದೆ</translation>
<translation id="228059581448666199">ಮೌಸ್‌ ಮೇಲೆ ಎಡ-ಕ್ಲಿಕ್‌ ಮಾಡಿ</translation>
<translation id="2290615375132886363">ಟ್ಯಾಬ್ಲೆಟ್‌‌ ನ್ಯಾವಿಗೇಷನ್ ಬಟನ್‌ಗಳು</translation>
<translation id="2310923358723722542">ಡಿಸ್‌ಪ್ಲೇ ಮತ್ತು ಹಿಗ್ಗಿಸುವಿಕೆ</translation>
<translation id="2319459402137712349">ಕೀಬೋರ್ಡ್ ತೆರೆಯಲು ಪಠ್ಯ ಕ್ಷೇತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ನ ಕೆಳಭಾಗದಲ್ಲಿರುವ ಕೀಬೋರ್ಡ್ ಐಕಾನ್ ಅನ್ನು ಸಹ ನೀವು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="2373499590298659902">ಮೌಸ್ ಬಟನ್ ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಲು "0" ಕೀಯನ್ನು ಬಳಸಿ</translation>
<translation id="2376056713414548745">ಗಟ್ಟಿಯಾಗಿ ಓದಿ</translation>
<translation id="2382368170666222719">ಬಿಲ್ಟ್-ಇನ್ ಟಚ್‌ಪ್ಯಾಡ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="2383825469508278924">ಕೀಬೋರ್ಡ್ ಕೀ ಮ್ಯಾಪಿಂಗ್, ಫಂಕ್ಷನ್ ಕೀಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="2410298923485357543">ಸಾಧನವು ಆನ್‌ಲೈನ್‌ನಲ್ಲಿರುವಾಗ ನೈಸರ್ಗಿಕ ಧ್ವನಿಯನ್ನು ಬಳಸಿ</translation>
<translation id="2416435988630956212">ಕೀಬೋರ್ಡ್ ಫಂಕ್ಷನ್ ಕೀಗಳು</translation>
<translation id="2427507373259914951">ಎಡ-ಕ್ಲಿಕ್</translation>
<translation id="2445726032315793326">ಭಾಗಶಃ ಮ್ಯಾಗ್ನಿಫೈರ್</translation>
<translation id="2448810255793562605">ಸ್ವಯಂ ಸ್ಕ್ಯಾನ್‌ನ‌ ಆ್ಯಕ್ಸೆಸ್ ಬದಲಾಯಿಸಿ</translation>
<translation id="2451298179137331965">2x</translation>
<translation id="2469375675106140201">ಕಾಗುಣಿತ ಪರೀಕ್ಷೆಯನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="2471469610750100598">ಕಪ್ಪು (ಡೀಫಾಲ್ಟ್)</translation>
<translation id="2477065602824695373">ನೀವು ಹಲವಾರು ಸ್ವಿಚ್‌ಗಳನ್ನು ಸೆಟಪ್ ಮಾಡಿದ ನಂತರ, ಸ್ವಯಂ-ಸ್ಕ್ಯಾನ್ ಅನ್ನು ಆಫ್ ಆಗಿದೆ.</translation>
<translation id="2479541499757560845">ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಕೀಬೋರ್ಡ್‌ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="248676429071089168">ಪುಟವನ್ನು ಕೆಳಕ್ಕೆ ಸರಿಸಲು ಮೇಲಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ</translation>
<translation id="2489686758589235262">ಇನ್ನೂ 2 ಸ್ವಿಚ್‌ಗಳನ್ನು ನಿಯೋಜಿಸಿ</translation>
<translation id="249330843868392562">ಪಠ್ಯದಿಂದ ಧ್ವನಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ</translation>
<translation id="2497229222757901769">ಮೌಸ್ ವೇಗ</translation>
<translation id="2501920221385095727">ಸ್ಟಿಕಿ ಕೀಗಳು</translation>
<translation id="250704661983564564">ಡಿಸ್‌ಪ್ಲೇ ಜೋಡಣೆ</translation>
<translation id="2507491234071975894">ಸ್ಪೀಕರ್</translation>
<translation id="2509566264613697683">8x</translation>
<translation id="2512065992892294946"><ph name="LANGUAGE" /> (ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ)</translation>
<translation id="2514465118223423406">ಮೌಸ್ ಅನ್ನು ಕನೆಕ್ಟ್ ಮಾಡಿದಾಗ</translation>
<translation id="2515586267016047495">Alt</translation>
<translation id="2517472476991765520">ಸ್ಕ್ಯಾನ್</translation>
<translation id="2521835766824839541">ಹಿಂದಿನ ಟ್ರ್ಯಾಕ್</translation>
<translation id="2529887123641260401">ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು ಅಥವಾ ಪ್ರವೇಶದ ವಿಧಾನವನ್ನು ಬದಲಿಸುವ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಮತ್ತೆ ಸೆಟಪ್ ಗೈಡ್ ಅನ್ನು ತೆರೆಯಬಹುದು.</translation>
