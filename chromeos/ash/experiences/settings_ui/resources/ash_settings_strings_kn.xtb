<translation id="9096053102600371572">ನಿಯಂತ್ರಿತ ಸ್ಕ್ರಾಲ್ ಮಾಡುವಿಕೆಯ ಕುರಿತು <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
<translation id="9098860402274800697">Google Play ಮತ್ತು Android ಆ್ಯಪ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="910000385680858937">ಅನುಮತಿಸಲಾಗಿದೆ – <ph name="PERMISSION_DETAILS" />. ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಮೈಕ್ರೊಫೋನ್ ಕನೆಕ್ಟ್‌ಮಾಡಿ.</translation>
<translation id="9100416672768993722">ಕೊನೆಯದಾಗಿ ಬಳಸಿದ ಇನ್‌ಪುಟ್ ವಿಧಾನಕ್ಕೆ ಬದಲಾಯಿಸಲು, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR" /><ph name="BEGIN_SPACE" />ಸ್ಪೇಸ್<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> ಒತ್ತಿರಿ</translation>
<translation id="9108294543511800041">ನೀವು ಈಗ ನಿಮ್ಮ ಫೋನ್‌ನ ಇತ್ತೀಚಿನ ಫೋಟೋಗಳು, ಮೀಡಿಯಾ ಮತ್ತು ಅಧಿಸೂಚನೆಗಳನ್ನು ವೀಕ್ಷಿಸಬಹುದು</translation>
<translation id="9109122242323516435">ಸ್ಥಳಾವಕಾಶವನ್ನು ಮುಕ್ತಗೊಳಿಸಲು, ಸಾಧನ ಸಂಗ್ರಹಣೆಯಿಂದ ಫೈಲ್‌ಗಳನ್ನು ಅಳಿಸಿ.</translation>
<translation id="9111330022786356709">ನಿಮ್ಮ ಮೌಸ್‌ನಲ್ಲಿ ಬಟನ್‌ಗಳನ್ನು ಸೇರಿಸಿ ಅಥವಾ ಪತ್ತೆ ಮಾಡಿ</translation>
<translation id="9116799625073598554">ಟಿಪ್ಪಣಿ-ತೆಗೆದುಕೊಳ್ಳುವ ಆ್ಯಪ್</translation>
<translation id="9117030152748022724">ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="9123287046453017203">ನಿಮ್ಮ ಸಾಧನ ಅಪ್ ಟು ಡೇಟ್ ಆಗಿಲ್ಲ</translation>
