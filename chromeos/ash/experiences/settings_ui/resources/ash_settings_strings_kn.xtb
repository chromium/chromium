<translation id="7568759527730933493">DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವನ್ನು ಹುಡುಕಲು ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿ. ಇದು <ph name="DNS_SERVER_TEMPLATE_WITH_IDENTIFIER" /> ನಲ್ಲಿ ನಿರ್ವಹಿಸಲಾದ ಸೇವೆ ಒದಗಿಸುವವರನ್ನು ಬಳಸುತ್ತದೆ ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ ಕೆಲವು ಡೊಮೇನ್‌ಗಳಿಗೆ ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="7570548610653957960">ಓದಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="7575272930307342804">ನ್ಯಾವಿಗೇಶನ್‌ ನಿಯಂತ್ರಣಗಳು</translation>
<translation id="757660455834887988">ಅನುಮತಿಸಲಾಗಿದೆ – <ph name="PERMISSION_DETAILS" />. ನಿಮ್ಮ ಸಾಧನಕ್ಕೆ ಕ್ಯಾಮರಾವನ್ನು ಕನೆಕ್ಟ್‌ ಮಾಡಿ.</translation>
<translation id="7578137152457315135">ಫಿಂಗರ್‌ಪ್ರಿಂಟ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="7578692661782707876">ನಿಮ್ಮ ದೃಢೀಕರಣದ ಕೋಡ್ ಅನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="7582582252461552277">ಈ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಆದ್ಯತೆ ನೀಡಿ</translation>
<translation id="7587806318633605613">ಸಲಹೆಯ ಇತಿಹಾಸ</translation>
<translation id="7590883480672980941">ಇನ್‌ಪುಟ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="7592060599656252486">ಕೆಲವು</translation>
<translation id="7602173054665172958">ಮುದ್ರಣ ನಿರ್ವಹಣೆ</translation>
<translation id="7605163396341021431">ಈ Chromebook ನಲ್ಲಿ USB ಸಾಧನಗಳ ಮೇಲೆ Android ಆ್ಯಪ್‌ಗಳ ನಿಯಂತ್ರಣವನ್ನು ನೀಡಿ</translation>
<translation id="7608810328871051088">Android ಆದ್ಯತೆಗಳು</translation>
<translation id="7611713099524036757">ಮೆಟಾ</translation>
<translation id="7612655942094160088">ಸಂಪರ್ಕಿತ ಫೋನ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ.</translation>
<translation id="7617263010641145920">Play Store  ಅನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="7621595347123595643">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅಥವಾ ಪಿನ್ ಅನ್ನು ನೀವು ಮರೆತರೆ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ರಿಕವರ್ ಮಾಡಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ.</translation>
<translation id="7628927569678398026"><ph name="LOCALE" /> (<ph name="VARIANT" />), ಗ್ರೇಡ್‌ <ph name="GRADE" /></translation>
<translation id="762917478230183172">ಪ್ರತಿ ಕೀಗಾಗಿ ಕ್ರಿಯೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="7632437836497571618">ಸೈಟ್‌ಗಳನ್ನು ಹುಡುಕಲು ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="7634337648687970851">ಪ್ರಸ್ತುತ ಸ್ಥಳೀಯ ಡೇಟಾ ರಿಕವರಿಯನ್ನು ಬೆಂಬಲಿಸಲಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="7640256527901510478">ನಿಮ್ಮ ಸಾಧನದ IMEI ಸಂಖ್ಯೆ <ph name="IMEI_NUMBER" /> ಮತ್ತು ಸಾಧನದ ಕ್ರಮ ಸಂಖ್ಯೆ <ph name="SERIAL_NUMBER" /> ಆಗಿದೆ. ಸೇವೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಲು ಈ ಸಂಖ್ಯೆಗಳನ್ನು ಬಳಸಬಹುದು.</translation>
<translation id="7641513591566880111">ಹೊಸ ಪ್ರೊಫೈಲ್ ಹೆಸರು</translation>
<translation id="764178579712141045"><ph name="USER_EMAIL" /> ಸೇರಿಸಲಾಗಿದೆ</translation>
<translation id="7645176681409127223"><ph name="USER_NAME" /> (ಮಾಲೀಕರು)</translation>
<translation id="7648048654005891115">ಕೀಮ್ಯಾಪ್ ಶೈಲಿ</translation>
<translation id="7649070708921625228">ಸಹಾಯ</translation>
<translation id="7650582458329409456">{COUNT,plural, =1{1 ಫಿಂಗರ್‌ಪ್ರಿಂಟ್ ಸೆಟಪ್ ಮಾಡಲಾಗಿದೆ}one{{COUNT} ಫಿಂಗರ್‌ಪ್ರಿಂಟ್‌ಗಳನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗಿದೆ}other{{COUNT} ಫಿಂಗರ್‌ಪ್ರಿಂಟ್‌ಗಳನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗಿದೆ}}</translation>
<translation id="7651400349472467012">ಇನ್‌ಸ್ಟಂಟ್ ಹಾಟ್‌ಸ್ಪಾಟ್ ಲಭ್ಯವಿದೆ</translation>
<translation id="7651784568388208829">ಫೋನ್ ಹಬ್ ಕಾರ್ಯ ಮುಂದುವರಿಕೆ</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="7663774460282684730">ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್ ಲಭ್ಯವಿದೆ</translation>
<translation id="7663859337051362114">eSIM ಪ್ರೊಫೈಲ್ ಸೇರಿಸಿ</translation>
<translation id="76641554187607347">ಯಾವುದೇ ಕೀಬೋರ್ಡ್ ಕನೆಕ್ಟ್ ಆಗಿಲ್ಲ</translation>
<translation id="7665082356120621510">ಗಾತ್ರವನ್ನು ಕಾಯ್ದಿರಿಸಿ</translation>
<translation id="766560638707011986">ಡೊಮೇನ್‌ಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="7668205084604701639">Office ಫೈಲ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</translation>
<translation id="7668648754769651616">ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ವೈಶಿಷ್ಟ್ಯಗಳು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಬಳಸಲು ಸುಲಭಗೊಳಿಸುತ್ತದೆ. ತ್ವರಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು, ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ನ ಕೆಳಭಾಗದಲ್ಲಿರುವ ಸಮಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ.</translation>
<translation id="7669620291129890197">ನಿಮ್ಮ ಸಾಧನಗಳಿಗೆ ಗೋಚರಿಸುತ್ತದೆ</translation>
<translation id="7670483791111801022">ಸಬ್‌ಟೈಟಲ್‌ಗಳು</translation>
<translation id="7672726198839739113">ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ. ವೇಳಾಪಟ್ಟಿಯನ್ನು ಪ್ರಸ್ತುತ <ph name="SUNRISE_TIME" /> - <ph name="SUNSET_TIME" /> ಗೆ ಸೆಟ್‌ ಮಾಡಲಾಗಿದೆ ಮತ್ತು ಹಸ್ತಚಾಲಿತವಾಗಿ ಮಾತ್ರ ಅಪ್‌ಡೇಟ್‌ ಮಾಡಬಹುದಾಗಿದೆ.</translation>
<translation id="7674416868315480713">Linux ‌ನಲ್ಲಿ ಫಾರ್ವರ್ಡ್ ಮಾಡಲಾಗುತ್ತಿರುವ ಎಲ್ಲಾ ಪೋರ್ಟ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="7674537509496907005"><ph name="APP_COUNT" /> ಆ್ಯಪ್‌ಗಳು</translation>
<translation id="7679171213002716280">ನಿರ್ವಹಿಸಲಾದ <ph name="PRINTER_COUNT" /> ಪ್ರಿಂಟರ್‌ಗಳಿವೆ.</translation>
<translation id="7679895819123160382">ನಿಮ್ಮ ಇಂಟರ್‌ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು <ph name="PRODUCT_NAME" /> ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ. ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ ಕೆಲವು ಡೊಮೇನ್‌ಗಳಿಗೆ ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="7680416688940118410">ಟಚ್‌ಸ್ಕ್ರೀನ್ ಕ್ಯಾಲಿಬ್ರೇಶನ್</translation>
<translation id="7683834360226457448">ದುರ್ಬಲ ದೃಷ್ಟಿ ಹೊಂದಿರುವವರಿಗಾಗಿ ಡಿಸ್‌ಪ್ಲೇ ಟೂಲ್‌ಗಳು</translation>
<translation id="7684718995427157417">ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳನ್ನು ರಚಿಸಲು ಮತ್ತು ಪರೀಕ್ಷಿಸಲು, Android ಡೀಬಗ್ ಬ್ರಿಡ್ಜ್ (ADB) ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ. ಇದು Google ನಿಂದ ದೃಢೀಕರಿಸದ Android ಆ್ಯಪ್‌ಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಅನುಮತಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಗಮನಿಸಿ ಹಾಗೂ ಇದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಫ್ಯಾಕ್ಟರಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಮರುಹೊಂದಿಸುವ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="7685351732518564314">ನಿಮ್ಮ <ph name="DEVICE_NAME" /> ನಲ್ಲಿ ಬಟನ್ ಒಂದನ್ನು ಒತ್ತಿರಿ.</translation>
<translation id="7690378713476594306">ಪಟ್ಟಿಯಿಂದ ಆರಿಸಿ</translation>
<translation id="7696063401938172191">ನಿಮ್ಮ'<ph name="PHONE_NAME" />' ನಲ್ಲಿ:</translation>
<translation id="7700516433658473670">ಪ್ರಿಂಟರ್‌ಗಳು ಮತ್ತು ಸ್ಕ್ಯಾನರ್‌ಗಳು</translation>
<translation id="7701040980221191251">ಯಾವುದೂ ಇಲ್ಲ</translation>
<translation id="7705085181312584869">ನನಗೆ ಬರೆಯಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="7705334495398865155">ಇತರರು ಈ ಸಾಧನವನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡುವುದನ್ನು ತಡೆಯಲು ನಿಮ್ಮ ಹಾರ್ಡ್‌ವೇರ್ ID (BSSID) ಅನ್ನು ಯಾದೃಚ್ಛಿಕಗೊಳಿಸಿ.</translation>
<translation id="7705524343798198388">VPN</translation>
<translation id="7707922173985738739">ಮೊಬೈಲ್‌ ಡೇಟಾ ಬಳಸಿ</translation>
<translation id="7711968363685835633">ವೈಯಕ್ತೀಕರಿಸಿದ ಪರಿವರ್ತನೆಗಳು ಮತ್ತು ಸಲಹೆಗಳು ಹಾಗೂ ಬಳಕೆದಾರರ ನಿಘಂಟನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="7713139339518499741">ನೈಸರ್ಗಿಕ ಧ್ವನಿ</translation>
<translation id="7715455358521357192">ಬಲಗಣ್ಣನ್ನು ಸ್ಕ್ವಿಂಟ್‌ ಮಾಡುವುದು</translation>
<translation id="7717845620320228976">ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸು</translation>
<translation id="7718490543420739837">ಆನ್-ಸ್ಕ್ರೀನ್ ಕೀಬೋರ್ಡ್, ಡಿಕ್ಟೇಶನ್, ಆ್ಯಕ್ಸೆಸ್ ಬದಲಾಯಿಸಿ ಮತ್ತು ಇನ್ನಷ್ಟು</translation>
<translation id="7721179060400456005">ಪ್ರದರ್ಶನಗಳಾದ್ಯಂತ ವ್ಯಾಪಿಸಲು ವಿಂಡೋಗಳಿಗೆ ಅನುಮತಿ ನೀಡಿ</translation>
<translation id="7721237513035801311"><ph name="SWITCH" /> (<ph name="DEVICE_TYPE" />)</translation>
<translation id="7726391492136714301">ನಿಮ್ಮ ಫೋನ್‌ನ ಅಧಿಸೂಚನೆಗಳು ಮತ್ತು ಆ್ಯಪ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಿ</translation>
<translation id="7728465250249629478">ಸಾಧನದ ಭಾಷೆಯನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="7728570244950051353">ಸ್ಲೀಪ್ ಮೋಡ್‌ನಿಂದ ಲಾಕ್ ಸ್ಕ್ರೀನ್</translation>
<translation id="7728668285692163452">ಚಾನಲ್ ಬದಲಾವಣೆಯನ್ನು ನಂತರ ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ</translation>
<translation id="77381465218432215">ಉಚ್ಚಾರಣಾ ಗುರುತುಗಳು ಮತ್ತು ವಿಶೇಷ ಅಕ್ಷರಗಳನ್ನು ತೋರಿಸಿ</translation>
<translation id="7744649840067671761">ಕಾರ್ಯನಿಯೋಜನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಹೊಸ ಸ್ವಿಚ್ ಅಥವಾ ಕೀಬೋರ್ಡ್ ಕೀಯನ್ನು ಒತ್ತಿ.
ಕಾರ್ಯನಿಯೋಜನೆಯನ್ನು ತೆಗೆದುಹಾಕಲು ನಿಯೋಜಿಸಿದ ಸ್ವಿಚ್ ಅಥವಾ ಕೀಯನ್ನು ಒತ್ತಿ.</translation>
<translation id="7745677556280361868">Passpoint ಸಬ್‌ಸ್ಕ್ರಿಪ್ಶನ್ ಪುಟದಲ್ಲಿ ಈ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ತೆಗೆದುಹಾಕಬೇಕೇ?</translation>
<translation id="7757592200364144203">ಸಾಧನದ ಹೆಸರನ್ನು ಬದಲಾಯಿಸಿ</translation>
<translation id="7758143121000533418">Family Link</translation>
<translation id="7762024824096060040">ಈ ಖಾತೆಯನ್ನು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="7765158879357617694">ಸರಿಸು</translation>
<translation id="7766082757934713382">ಸ್ವಯಂಚಾಲಿತ ಆ್ಯಪ್ ಮತ್ತು ಸಿಸ್ಟಮ್ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸುವ ಮೂಲಕ ನೆಟ್‌ವರ್ಕ್ ಡೇಟಾ ಬಳಕೆಯನ್ನು ಕಡಿಮೆ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="7768770796815395237">ಬದಲಿಸಿ</translation>
<translation id="7768784765476638775">ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಆಲಿಸಿ</translation>
<translation id="7769709635093101687">ವಿರಾಮಗೊಳಿಸಲು ಕೀಬೋರ್ಡ್ ಶಾರ್ಟ್‌ಕಟ್</translation>
<translation id="7770827449915784217">ಫರ್ಮ್‌‌ವೇರ್‌‌ ಅಪ್ ಟು ಡೇಟ್ ಆಗಿದೆ</translation>
<translation id="7776701556330691704">ಯಾವುದೇ ಧ್ವನಿಗಳು ಕಂಡುಬಂದಿಲ್ಲ</translation>
<translation id="7779840061887151693">ಡಿಸ್‌ಪ್ಲೇ</translation>
<translation id="778480864305029524">ತತ್‌ಕ್ಷಣ ಟೆಥರಿಂಗ್ ಅನ್ನು ಬಳಸಲು, Google Play ಸೇವೆಗಳ ಅಧಿಸೂಚನೆಗಳನ್ನು ಆನ್ ಮಾಡಿ.</translation>
