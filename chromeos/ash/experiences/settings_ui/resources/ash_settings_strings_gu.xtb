<translation id="5916655001090539219">ઑટોમૅટિક રીતે વાંચવાની સુવિધા</translation>
<translation id="59174027418879706">સક્ષમ કરેલું</translation>
<translation id="5939518447894949180">રીસેટ કરો</translation>
<translation id="594048410531370124">ઓળખવામાં ન આવેલી કી. <ph name="RESPONSE" /> માટે કોઈપણ કી દબાવો.</translation>
<translation id="5945192511027649793">ટચપૅડ બંધ કરો</translation>
<translation id="5947651424015173580">માઉસ પર બે વાર ક્લિક કરો</translation>
<translation id="594993197557058302">1-4 મૉડિફાયર કી (ctrl, alt, shift, શોધ, અથવા લૉન્ચર) અને વધુ 1 કી દબાવો. તમે કોઈ એક કી પણ પસંદ કરી શકો છો.</translation>
<translation id="5951624318208955736">મૉનિટર</translation>
<translation id="5952020381407136867">ટચપૅડ</translation>
<translation id="5957987129450536192">તમારી પ્રોફાઇલ છબીની પાસેના બોલવા માટે પસંદ કરો આઇકનને દબાવો, પછી જે ભાગને સાંભળવો હોય તેને પસંદ કરો.</translation>
<translation id="5959982036207776176">મૅગ્નિફાયર સાંભળવા માટે પસંદ કરો સુવિધા દ્વારા વાંચવામાં આવનાર શબ્દને અનુસરે છે</translation>
<translation id="5961545272769624207">કોઈ સંકેત અસાઇન કરો</translation>
<translation id="5968022600320704045">કોઈ શોધ પરિણામ નથી</translation>
<translation id="598810097218913399">સોંપણી કાઢી નાખો</translation>
<translation id="5988563937187882754">જમણે જુઓ</translation>
<translation id="5992225669837656567">તમામ માઉસ ડિસ્કનેક્ટ કરવામાં આવ્યા છે</translation>
<translation id="5999630716831179808">અવાજો</translation>
<translation id="6002458620803359783">મનપસંદ વૉઇસ</translation>
<translation id="6007053304250788613">મિરર મોડમાં માત્ર એક ડિસ્પ્લેને બાકાત કરી શકાય છે</translation>
<translation id="6017514345406065928">લીલો</translation>
<translation id="6021969570711251331">ઇન્ટરલીવ</translation>
<translation id="6031600495088157824">ટૂલબારમાંના ઇનપુટ માટેના વિકલ્પો</translation>
<translation id="6045114302329202345">પ્રાથમિક TrackPoint બટન</translation>
<translation id="6048747414605857443">ChromeVox અને 'સાંભળવા માટે પસંદ કરો' સુવિધા માટે ટેક્સ્ટ ટૂ સ્પીચ વૉઇસ પસંદ કરો અને કસ્ટમાઇઝ કરો</translation>
<translation id="6050189528197190982">ગ્રેસ્કેલ</translation>
<translation id="6064764629679333574">ઑડિયોના રિઝોલ્યુશનને ઓછામાંથી વધારે કરીને બ્લૂટૂથ માઇક સાઉન્ડની ક્વૉલિટીને બહેતર બનાવો.</translation>
<translation id="6073292342939316679">કીબોર્ડનું બ્રાઇટનેસ ઘટાડવાની કી</translation>
<translation id="6077476112742402730">લખવા માટે બોલો</translation>
<translation id="6089289670051481345">વાદળી-પીળો રંગ ન દેખાવાની ખામી</translation>
<translation id="6104929924898022309">ફંક્શન કીની વર્તણૂંક બદલવા માટે શોધ કીનો ઉપયોગ કરો</translation>
<translation id="6113832060210023016">લૉન્ચર + ક્લિક</translation>
<translation id="6119972796024789243">રંગ સુધારણા</translation>
<translation id="6127292407256937949">વૉલ્યૂમ ચાલુ છે. વૉલ્યૂમ બંધ કરો.</translation>
<translation id="6129953537138746214">Space</translation>
<translation id="6136285399872347291">backspace</translation>
<translation id="6149791593592044995">આધુનિક ટોન માર્ક પ્લેસમેન્ટનો ઉપયોગ કરો</translation>
<translation id="6156944117133588106">ટૅબ્લેટ મોડમાં નૅવિગેશન બટન બતાવો</translation>
<translation id="6174909075810107548">માઉસનું બટન દબાવવા માટે “5”નો ઉપયોગ કરો</translation>
<translation id="61988015556954366">સ્ક્રીન ફ્લૅશ</translation>
<translation id="622484624075952240">Down</translation>
<translation id="6231782223312638214">સૂચવેલા</translation>
<translation id="6237474966939441970">સ્ટાયલસ વડે નોંધ લેવાની ઍપના સેટિંગ</translation>
<translation id="6247708409970142803"><ph name="PERCENTAGE" />%</translation>
<translation id="6249200942125593849">ઍક્સેસિબિલિટીને મેનેજ કરવાનાં સેટિંગ</translation>
<translation id="628352644014831790">4 સેકન્ડ</translation>
<translation id="6294759976468837022">ઑટો-સ્કૅનની ઝડપ</translation>
<translation id="6302661287897119265">ફિલ્ટર</translation>
<translation id="6305627295927385295">નીચેની આઇટમ ડિલીટ કરો:</translation>
<translation id="6305702903308659374">ChromeVox બોલી રહ્યું હોય ત્યારે પણ સામાન્ય અવાજે ચલાવો</translation>
<translation id="6309443618838462258">તમારા વ્યવસ્થાપક આ ઇનપુટ પદ્ધતિની મંજૂરી આપતા નથી</translation>
<translation id="6315170314923504164">અવાજ</translation>
<translation id="6343981313228733146">વિન્ડોને ઉપરની તરફ અને જમણી બાજુ ખસેડવામાં આવી</translation>
<translation id="6344576354370880196">સાચવેલા પ્રિન્ટર</translation>
<translation id="6349101878882523185"><ph name="APP_NAME" /> ઇન્સ્ટૉલ કરો</translation>
<translation id="6356718524173428713">પેજને નીચે લઈ જવા માટે ઉપર સ્ક્રોલ કરો</translation>
<translation id="6367196786591004737">એન્ટ્રી ડિલીટ કરો</translation>
<translation id="6367396429435748845">માઉસ કી થોભાવવા અને ફરી શરૂ કરવા માટે <ph name="ALT" /> + <ph name="LAUNCHER" /> + <ph name="NUM_4" /> દબાવો</translation>
<translation id="6370551072524410110">search + shift + backspace</translation>
<translation id="6388429472088318283">ભાષાઓ શોધો</translation>
<translation id="6405999530973682789">માઉસ કર્સર મળતું નથી</translation>
<translation id="6411135999030237579">કીને ઑટોમેટિક રીતે રિપીટ કરવા માટે દબાવી રાખો</translation>
<translation id="6415757856498750027">"ư" મેળવવા માટે "w" ટાઇપ કરો</translation>
<translation id="641817663353603351">page up</translation>
<translation id="6425556984042222041">ટેક્સ્ટ ટૂ સ્પીચની ઝડપ</translation>
<translation id="6434104957329207050">પૉઇન્ટ સ્કૅન કરવાની ઝડપ</translation>
<translation id="6444147596556711162">સ્ક્રીન પર એક આઇટમથી બીજી પર જવા માટે, “આગળ” અને “પાછળ”નો ઉપયોગ કરો</translation>
<translation id="6453921811609336127">આગલી ઇનપુટ પદ્ધતિ પર સ્વિચ કરવા માટે, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR1" /><ph name="BEGIN_SHIFT" />Shift<ph name="END_SHIFT" /><ph name="SEPARATOR2" /><ph name="BEGIN_SPACE" />Space<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> દબાવો</translation>
<translation id="6463488491707167747">આ શબ્દકોશ ડિલીટ કરો</translation>
<translation id="6470120577693311302">ફ્લૅશ નોટિફિકેશન</translation>
<translation id="6476482583633999078">સ્પીચની સ્પીડ</translation>
<translation id="6476671549211161535">તમારા <ph name="DEVICE_NAME" /> પર એ બટન દબાવો જે માઉસનું ડાબું કે જમણું બટન નથી.</translation>
<translation id="6482559668224714696">પૂર્ણ-સ્ક્રીન મૅગ્નિફાયર</translation>
<translation id="648927581764831596">કંઈપણ ઉપલબ્ધ નથી</translation>
<translation id="6497784818439587832">તમારી સ્ક્રીન પરની આઇટમને વધુ નાની અથવા વધુ મોટી કરવા માટે ડિસ્પ્લેનું કદ બદલો</translation>
<translation id="6497789971060331894">માઉસનું રિવર્સ સ્ક્રોલિંગ</translation>
<translation id="650185290742160385">મર્યાદા ઘટાડો</translation>
<translation id="650457560773015827">ડાબું બટન</translation>
<translation id="65334502113648172">ડિસ્પ્લેના વિસ્તારને નાનો કે મોટો કરવા માટે, ઍરો કી દબાવો. ડિસ્પ્લેના વિસ્તારને આસપાસ ખસેડવા માટે shift અને + દબાવો, પછી ઍરો કીનો ઉપયોગ કરો.</translation>
<translation id="654219396498297850">જ્યારે માઉસનું ડાબું બટન પસંદ કર્યુ હોય, ત્યારે બે વાર ક્લિક કરવા માટે “v”નો ઉપયોગ કરો</translation>
<translation id="6544134392255015460">કીબોર્ડની બૅકલાઇટ માટે ટૉગલ કી</translation>
<translation id="6545665334409411530">પુનરાવર્તન રેટ</translation>
<translation id="6549038875972762904">સેટઅપ ફરી કરો</translation>
<translation id="6556866813142980365">ફરી કરો</translation>
<translation id="6580203076670148210">સ્કૅન કરવાની ઝડપ</translation>
<translation id="6585584201072946561">વેબ બ્રાઉઝર માટે ટેક્સ્ટનું કદ અને ફૉન્ટ કસ્ટમાઇઝ કરો</translation>
<translation id="6586451623538375658">પ્રાથમિક માઉસ બટનને સ્વેપ કરો</translation>
<translation id="6601262427770154296">વપરાશકર્તાના શબ્દકોશો મેનેજ કરો</translation>
<translation id="660846213831377756">માઉસ કી</translation>
<translation id="6626581113916585374">ઇફેક્ટ મોડ</translation>
<translation id="6629951648264770593"><ph name="MODIFIER" /> + <ph name="KEY" /></translation>
<translation id="6630452975878488444">પસંદગી શૉર્ટકટ</translation>
<translation id="6647690760956378579">સાહજિક વૉઇસનો પ્રીવ્યૂ</translation>
<translation id="6660819301598582123">ભૂરા રંગનું શિયાળ આળસુ કૂતરા પર કૂદી પડ્યું.</translation>
<translation id="6673898378497337661">કીબોર્ડનું બ્રાઇટનેસ વધારવાની કી</translation>
<translation id="6677527809400770913"><ph name="ACTION" /> માટે <ph name="GESTURE" /> સંકેતની સોંપણી કરવામાં આવી</translation>
<translation id="6680650203439190394">રેટ કરો</translation>
<translation id="6683022854667115063">હૅડફોન</translation>
<translation id="668599234725812620">Google Play ખોલો</translation>
<translation id="6689948774466767379">માઉસ કી</translation>
<translation id="6694462491298752106">બિલ્ટ-ઇન ટચપૅડ બંધ કરવામાં આવ્યું છે</translation>
<translation id="6710213216561001401">પાછલી</translation>
<translation id="6713441551032149301">ફંક્શન કી અને સિસ્ટમની સૌથી ઉપરની પંક્તિની કી વચ્ચે બદલવા માટે લૉન્ચર કીને દબાવી રાખો</translation>
<translation id="6725970970008349185">પેજ દીઠ ડિસ્પ્લે કરવાના ઉમેદવારોની સંખ્યા</translation>
<translation id="6755702685749429945">શબ્દકોશ ઉમેરો</translation>
<translation id="6756643207511618722">સ્પીચ એન્જિન</translation>
<translation id="6785915470941880363">રિવર્સ સ્ક્રોલિંગ <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="6787839852456839824">કીબોર્ડ શોર્ટકટ્સ</translation>
<translation id="6790428901817661496">ચલાવો</translation>
<translation id="6795371939514004514">ઑટો-સ્કૅનની સુવિધા સ્ક્રીન પર ઑટોમૅટિક રીતે એક આઇટમથી બીજી પર જવાની સરળતા પ્રદાન કરે છે. જ્યારે કોઈ આઇટમ હાઇલાઇટ કરવામાં આવી હોય, ત્યારે તેને સક્રિય કરવા માટે “પસંદ કરો” દબાવો.</translation>
<translation id="6801435275744557998">ટચસ્ક્રીનને કેલિબ્રેટ કરો</translation>
<translation id="6811151703183939603">પ્રબળ</translation>
<translation id="6811792477922751991">ફંક્શન કીની વર્તણૂંક બદલવા માટે લૉન્ચર કીનો ઉપયોગ કરો</translation>
<translation id="6816097980753839617">વાદળી-પીળો (ટ્રાઇટેનોમલી)</translation>
<translation id="6823174134746916417">ક્લિક કરવા હલકું દબાવવા માટે ટચપૅડના સેટિંગ</translation>
<translation id="6838992358006915573">Magnifier ChromeVox ફોકસને ફૉલો કરે છે</translation>
<translation id="6843725295806269523">બંધ કરો</translation>
<translation id="6856623341093082836">તમારી ટચસ્ક્રીનની સચોટતાને સેટ કરો અને સમાયોજિત કરો</translation>
<translation id="686609795364435700">શાંત</translation>
<translation id="686664946474413495">રંગ તાપમાન</translation>
<translation id="6889957081990109136">હજી પણ કોઈ સ્વિચની સોંપણી કરવામાં આવી નથી</translation>
<translation id="6893164346922798247">eSpeak</translation>
<translation id="6899427698619335650">અનુકૂળ ડાયાક્રિટિક અસાઇન્મેન્ટને મંજૂરી આપો. ઉદાહરણ તરીકે, “ánh”નું આઉટપુટ મેળવવા માટે, તમે “anh1” કે “a1nh” ટાઇપ કરી શકો છો.</translation>
