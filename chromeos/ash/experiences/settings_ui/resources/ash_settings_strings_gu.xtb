<translation id="6955893174999506273">વધુ 1 સ્વિચની સોંપણી કરો</translation>
<translation id="695817292005698051">સંકેતની ભાળ મેળવવાની મર્યાદા</translation>
<translation id="6960648667961844909"><ph name="LANGUAGE" /> સ્પીચ ફાઇલો ડાઉનલોડ કરી શકાઈ નથી. થોડા સમય પછી ડાઉનલોડ કરવાનો પ્રયાસ કરવામાં આવશે. ડાઉનલોડ પૂર્ણ થાય ત્યાં સુધી, Googleને પ્રક્રિયા કરવા માટે સ્પીચ મોકલવામાં આવે છે.</translation>
<translation id="6963772203726867701">ભાળ મળી નથી</translation>
<translation id="6963872466817251924">ટેક્સ્ટ કર્સર હાઇલાઇટર</translation>
<translation id="6965382102122355670">બરાબર, સમજાઇ ગયું</translation>
<translation id="6965978654500191972">ઉપકરણ</translation>
<translation id="6968288415730398122">સ્ક્રીન લૉક ગોઠવવા માટે તમારો પાસવર્ડ દાખલ કરો</translation>
<translation id="6969047215179982698">'નજીકના શેર' સુવિધા બંધ કરો</translation>
<translation id="6980402667292348590">insert</translation>
<translation id="6981982820502123353">ઍક્સેસિબિલિટી</translation>
<translation id="6983507711977005608">ઝટપટ ઇન્ટરનેટ શેર કરવાની સુવિધાનું નેટવર્ક ડિસકનેક્ટ કરો</translation>
<translation id="6983890893900549383">escape</translation>
<translation id="6985607387932385770">પ્રિન્ટર્સ</translation>
<translation id="6997707937646349884">તમારા ઉપકરણો પર:</translation>
<translation id="7001556399332161712">શોધ અને સૂચનો</translation>
<translation id="7003537330107832201"><ph name="APP_NAME" />નું નવું વર્ઝન (<ph name="VERSION" />) ઉપલબ્ધ છે. અપડેટ લાગુ કરવા માટે, બધી ખુલ્લી વિન્ડો બંધ કરવામાં આવશે. સાચવ્યો ન હોય એવો ડેટા ગુમાવી દેશો એવી શક્યતા છે.</translation>
<translation id="7003723821785740825">તમારું ઉપકરણ અનલૉક કરવા માટે એક ઝડપી રીત સેટ કરો</translation>
<translation id="7008815993384338777">હાલમાં રોમિંગ જરૂરી નથી</translation>
<translation id="701020165009334820">તમે Play Store મારફતે Android ઍપ અને ગેમ ડાઉનલોડ કરી શકો છો.</translation>
<translation id="7012430956470647760">ઍપ માટે માતાપિતાના યોગ્ય નિયંત્રણો</translation>
<translation id="7014741021609395734">ઝૂમ લેવલ</translation>
<translation id="7016995776279438971">લાલ-લીલો રંગ, લાલ રંગ બરાબર ન દેખાવાની સમસ્યા (પ્રોટેનોમલી)</translation>
<translation id="7019805045859631636">ઝડપી</translation>
<translation id="7021524108486027008">તમારા <ph name="DEVICE_TYPE" /> પર તમારી એન્ટરપ્રાઇઝની દેખરેખમાં મેનેજ કરવામાં આવતા ટૂલ, એડિટર અને IDEs ચલાવો.</translation>
<translation id="7022222879220069865">તમામ ટચપૅડ ડિસ્કનેક્ટ કરવામાં આવ્યા છે</translation>
<translation id="7027432471322992835">ટ્રૅકપૅડ બંધ કરો</translation>
<translation id="7037509989619051237">ટેક્સ્ટ ટૂ સ્પીચના પ્રીવ્યૂ માટે</translation>
<translation id="7038632520572155338">સ્વિચ ઍક્સેસ</translation>
<translation id="7050037487872780845">હૉટસ્પૉટનું અમાન્ય કન્ફિગ્યુરેશન</translation>
<translation id="7058024590501568315">છુપાવવામાં આવેલું નેટવર્ક</translation>
<translation id="7064209589142995848">કન્ટેન્ટ ટ્રાન્સફર</translation>
<translation id="7067396782363924830">ઍમ્બિઅન્ટ રંગ</translation>
<translation id="7072078320324181561">લોકેશનની પરવાનગી ધરાવતી ઍપ અને વેબસાઇટ તેમજ સિસ્ટમ સર્વિસ, તમારા લોકેશનનો ઉપયોગ કરી શકે છે <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="7077751457066325012">કીબોર્ડ શૉર્ટકટ જુઓ અને કસ્ટમાઇઝ કરો</translation>
<translation id="7078120482318506217">તમામ નેટવર્ક્સ</translation>
<translation id="7082568314107259011"><ph name="NETWORK_NAME" />ને તમારા ઍડમિનિસ્ટ્રેટર દ્વારા મેનેજ કરવામાં આવે છે</translation>
<translation id="7088960765736518739">સ્વિચ ઍક્સેસ</translation>
<translation id="7090714929377281710">ઑટોમૅટિક રીતે હૉટસ્પૉટ બંધ કરો</translation>
<translation id="7092504544229909737">Android ઍપ સાથે ઉપયોગ કરી શકાતો નથી</translation>
<translation id="7093220653036489319">ઝડપી જવાબો</translation>
<translation id="7099337801055912064">વિશાળ PPD લોડ કરી શકતાં નથી. મહત્તમ કદ 250 kB છે.</translation>
<translation id="7107609441453408294">બધા સ્પીકરમાંથી એક જ ઑડિયો વગાડો</translation>
<translation id="7116931001458704701">કર્સર શોધવા માટે હલાવો</translation>
<translation id="7118268675952955085">સ્ક્રીનશૉટ</translation>
<translation id="711985611146095797">આ પેજ તમને તમારા સાઇન ઇન કરેલા હોય એવા Google એકાઉન્ટ મેનેજ કરવાની મંજૂરી આપે છે. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="7120762240626567834">જ્યાં સુધી VPNથી કનેક્ટ થવામાં ન આવે, ત્યાં સુધી Chrome બ્રાઉઝર અને Android ટ્રાફિક બ્લૉક કરવામાં આવશે</translation>
<translation id="7121438501124788993">ડેવલપર મોડ</translation>
<translation id="7124013154139278147">“પાછળ” માટે સ્વિચની સોંપણી કરો</translation>
<translation id="7125148293026877011">Crostini ડિલીટ કરો</translation>
<translation id="7125177678433853645"><ph name="MODIFIER_ONE" /> + <ph name="MODIFIER_TWO" /> + <ph name="MODIFIER_THREE" /> + <ph name="MODIFIER_FOUR" /> + <ph name="KEY" /></translation>
<translation id="7125932261198019860">જેની સાથે તમારી Chromebook કનેક્ટ થયેલી હોય, તે વાઇ-ફાઇ નેટવર્કની સાથે જ તમારું પ્રિન્ટર કનેક્ટ થયેલું છે તેની ખાતરી કરો અથવા કોઈ USB કેબલનો ઉપયોગ કરો. <ph name="LINK_BEGIN" />સુસંગતતા વિશે વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="7130438335435247835">ઍક્સેસ પૉઇન્ટનું નામ (APN)</translation>
<translation id="7131431455372521159">તમામ ટ્રૅક પૉઇન્ટ ડિસ્કનેક્ટ કરવામાં આવ્યા છે</translation>
<translation id="7132886488919643383">વાંચન, લેખન અને રચનામાં સહાય મેળવવા માટે Google AIનો ઉપયોગ કરો</translation>
<translation id="7143207342074048698">કનેક્ટિંગ</translation>
<translation id="7144363643182336710">સ્ક્રીન પર નોટિફિકેશન પૉપ-અપ થશે નહીં. તમે હજી પણ તમારી સ્ક્રીનની નીચે જમણી બાજુએ 'ખલેલ પાડશો નહીં' આઇકન પર ક્લિક કરીને નોટિફિકેશન જોઈ શકો છો.</translation>
<translation id="7144878232160441200">ફરી પ્રયત્ન કરો</translation>
<translation id="7153101072880472645">ઉચ્ચ કોન્ટ્રાસ્ટ ચાલુ/બંધ છે</translation>
<translation id="715396040729904728">લૉન્ચર + shift + <ph name="TOP_ROW_KEY" /></translation>
<translation id="7160182524506337403">હવે તમે તમારા ફોનના નોટિફિકેશન જોઈ શકો છો</translation>
<translation id="7166815366658507447">હૉટસ્પૉટ ચાલુ કર્યું</translation>
<translation id="7167327771183668296">ઑટો ક્લિક</translation>
<translation id="7169122689956315694">ડિવાઇસ આસપાસ હોય ત્યારે નોટિફિકેશન ચાલુ કરો</translation>
<translation id="7175037578838465313"><ph name="NAME" /> ગોઠવો</translation>
<translation id="7180611975245234373">રિફ્રેશ કરો</translation>
<translation id="7182063559013288142">ઝટપટ હૉટસ્પૉટ</translation>
<translation id="7189965711416741966">ફિંગરપ્રિન્ટ ઉમેરી.</translation>
<translation id="7207631048330366454">ઍપ શોધો</translation>
<translation id="7210432570808024354">આઇટમને ખસેડવા માટે, ટૅપ કરો અને ખેંચો</translation>
<translation id="7211783048245131419">હજી સુધી કોઈ સ્વિચની સોંપણી કરવામાં આવી નથી</translation>
<translation id="7214047272988222011">મંજૂરી છે – <ph name="PERMISSION_DETAILS" />. <ph name="LINK_BEGIN" />સિસ્ટમનો કૅમેરાનો ઍક્સેસ<ph name="LINK_END" /> ચાલુ કરો.</translation>
<translation id="722099540765702221">ચાર્જ કરવાનો સૉર્સ</translation>
<translation id="7222373446505536781">F11</translation>
<translation id="7223952304612664117">આમ કરવાથી, સિસ્ટમ સર્વિસને તમારું લોકેશન નક્કી કરવા માટે લોકેશનની સચોટતાની સુવિધાનો ઉપયોગ કરવાની મંજૂરી મળે છે. લોકેશનની સચોટતાની સુવિધા, ડિવાઇસનું લોકેશન નક્કી કરવા માટે, વાયરલેસ સિગ્નલ વિશેની માહિતી અને સેન્સરનો ઉપયોગ કરે છે.</translation>
<translation id="7231260028442989757">તમારા ફોનના નોટિફિકેશન જુઓ, છોડી દો અને તેમનો જવાબ આપો</translation>
<translation id="7235305658956131898">તમારા ડિવાઇસના ઍડમિનિસ્ટ્રેટર દ્વારા ઇન્સ્ટૉલ કરવામાં આવેલી Android ઍપ.</translation>
<translation id="7240339475467890413">નવા હોટસ્પોટથી કનેક્ટ કરીએ?</translation>
<translation id="7245628041916450754"><ph name="WIDTH" /> x <ph name="HEIGHT" /> (શ્રેષ્ઠ)</translation>
<translation id="7256634071279256947">પાછળનો માઇક્રોફોન</translation>
<translation id="7257173066616499747">Wi-Fi નેટવર્ક્સ</translation>
<translation id="7260206782629605806">જો તમે મર્યાદા ઘટાડશો, તો તમે ચોકસાઈભરી હિલચાલ કરી શકશો. જો તમે મર્યાદા વધારશો, તો તમારે વધુ અતિશયોક્તિભરી હિલચાલ કરવી જરૂરી રહેશે.</translation>
<translation id="7260802376010589729">માઉસનું બટન રિલીઝ કરવા માટે “c”નો ઉપયોગ કરો</translation>
<translation id="7261612856573623172">સિસ્ટમ ટેક્સ્ટ-ટુ-સ્પીચ વૉઇસ</translation>
<translation id="7268412955622368206">નવા USB ડિવાઇસ માટે પૉપઅપ નોટિફિકેશન બતાવો.</translation>
<translation id="7269736181983384521">'નજીકના શેર'નો ડેટા વપરાશ</translation>
<translation id="7271278495464744706">વધુ પડતી વિગતો આપતા વર્ણનો ચાલુ કરો</translation>
<translation id="727441411541283857"><ph name="PERCENTAGE" />% - <ph name="TIME" /> પૂર્ણ ન થાય ત્યાં સુધી</translation>
<translation id="727595954130325265">હમણાં ખરીદો</translation>
<translation id="7280649757394340890">ટેક્સ્ટ-ટૂ-સ્પીચ વૉઇસ સેટિંગ</translation>
<translation id="7282547042039404307">સુગમ</translation>
<translation id="7292195267473691167"><ph name="LOCALE" /> (<ph name="VARIANT" />)</translation>
<translation id="7303485269821975179"><ph name="DEVICE_TYPE" /> પાસવર્ડનું સેટઅપ કરો</translation>
<translation id="7304030187361489308">વધુ ઝડપે</translation>
<translation id="7308643132139167865">વેબસાઇટની ભાષાઓ</translation>
<translation id="7312210124139670355">તમારા ઍડમિનિસ્ટ્રેટર તમારા ઇ-સિમને રીસેટ કરી રહ્યાં છે. આમાં થોડો સમય લાગી શકે છે.</translation>
<translation id="7313539585802573958">કીબોર્ડની બૅકલાઇટના રંગો</translation>
<translation id="7320213904474460808">ડિફૉલ્ટ કરેલું નેટવર્ક</translation>
<translation id="7323315405936922211">કર્સર એરિયાનું કદ</translation>
<translation id="7325209047678309347">કાગળ ભરાઈ ગયું છે</translation>
<translation id="7331646370422660166">alt + નીચેની ઍરો કી</translation>
<translation id="7348093485538360975">ઑન-સ્ક્રીન કીબોર્ડ</translation>
<translation id="7352651011704765696">કંઈક ખોટું થયું હતું</translation>
<translation id="7360333718677093875">ઇમોજી પિકર</translation>
<translation id="7365076891350562061">મૉનિટરનું કદ</translation>
<translation id="7366909168761621528">બ્રાઉઝિંગ ડેટા</translation>
<translation id="7374376573160927383">USB ડિવાઇસને મેનેજ કરો</translation>
<translation id="7376553024552204454">માઉસ કર્સર જ્યારે ગતિમાન હોય ત્યારે તેને હાઇલાઇટ કરો</translation>
<translation id="7380272457268061606">સ્થાનિક ડેટા રિકવરી બંધ કરીએ?</translation>
<translation id="7380459290951585794">ખાતરી કરો કે તમારો ફોન નજીકમાં હોય, અનલૉક કરેલો હોય અને તેમાં બ્લૂટૂથ તેમજ વાઇ-ફાઇની સુવિધા ચાલુ હોય</translation>
