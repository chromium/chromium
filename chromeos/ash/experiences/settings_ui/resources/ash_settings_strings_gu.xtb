<translation id="8845001906332463065">સહાય મેળવો</translation>
<translation id="8846239054091760429">મૉનો ઑડિયો, સ્ટાર્ટઅપ, લાઇવ કૅપ્શન અને બીજું ઘણું</translation>
<translation id="8847988622838149491">USB</translation>
<translation id="8848709220963126773">શિફ્ટ કી મોડ સ્વિચ</translation>
<translation id="8849001918648564819">છુપાવેલી</translation>
<translation id="8849219423513870962"><ph name="PROFILE_NAME" /> નામની ઇ-સિમ પ્રોફાઇલને કાઢી નાખવાનું રદ કરો</translation>
<translation id="8856028055086294840">ઍપ અને પેજ રિસ્ટોર કરો</translation>
<translation id="885701979325669005">સ્ટોરેજ</translation>
<translation id="8858369206579825206">પ્રાઇવસીને લગતાં નિયંત્રણ</translation>
<translation id="8861568709166518036">હોમ પર નૅવિગેટ કરવા, પાછળ જવા અને ઍપ સ્વિચ કરવા માટે સ્ક્રીન પરના બટનનો ઉપયોગ કરો. જો ChromeVox અથવા ઑટોમૅટિક ક્લિકની સુવિધા ચાલુ કરેલી હોય, તો ઑટોમૅટિક રીતે ચાલુ થાય છે.</translation>
<translation id="8867228703146808825">ક્લિપબોર્ડ પર બિલ્ડની વિગતો કૉપિ કરો</translation>
<translation id="8868626022555786497">ઉપયોગમાં</translation>
<translation id="8868838761037459823">સેલ્યુલર નેટવર્કની વિગતો</translation>
<translation id="8872774989979382243">વૉલ્યૂમ બંધ છે. વૉલ્યૂમ ચાલુ કરો.</translation>
<translation id="888256071122006425">માઉસ અને ટચપૅડના સેટિંગ</translation>
<translation id="8885449336974696155"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને ChromeOSને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="8890529496706615641">પ્રોફાઇલનું નામ બદલી શકાયું નથી. કૃપા કરીને ફરીથી પ્રયાસ કરો અથવા ટેક્નિકલ સપોર્ટ માટે તમારા મોબાઇલ ઑપરેટરનો સંપર્ક કરો.</translation>
<translation id="8894761918470382415">પેરિફેરલ માટે ડેટા ઍક્સેસનું સંરક્ષણ</translation>
<translation id="8896830132794747524">તમારા માઉસને ઝડપથી ખસેડવાથી કર્સર આગળ ખસેડાશે</translation>
<translation id="8898790559170352647">તમારું Microsoft એકાઉન્ટ ઉમેરો</translation>
<translation id="8900413463156971200">સેલ્યુલર નેટવર્ક ચાલુ કરો</translation>
<translation id="8902667442496790482">સાંભળવા માટે પસંદ કરોના સેટિંગ ખોલો</translation>
<translation id="8903733144777177139">માઇક્રોફોનનો ઍક્સેસ બ્લૉક કરેલો છે</translation>
<translation id="8912810933860534797">ઑટો સ્કૅન ચાલુ કરો</translation>
<translation id="8922624386829239660">જ્યારે માઉસ સ્ક્રીનની કિનારીઓને ટચ કરે, ત્યારે સ્ક્રીનને ખસેડો</translation>
<translation id="8929738682246584251">મેગ્નિફાયર ચાલુ/બંધ કરો</translation>
<translation id="8930622219860340959">વાયરલેસ</translation>
<translation id="8931713990831679796">આ પ્રિન્ટર કનેક્ટેડ છે અને ઉપયોગ માટે તૈયાર છે. વધુ સરળ ઍક્સેસ માટે તમારી પ્રોફાઇલ પર સાચવો.</translation>
<translation id="8932654652795262306">ઝટપટ ઇન્ટરનેટ શેર કરવાની સુવિધાની વિગતો</translation>
<translation id="8940888110818450052">સાઇન-ઇનના વિકલ્પો</translation>
<translation id="8944099748578356325">વધુ ઝડપથી બૅટરીનો ઉપયોગ કરો (હાલમાં <ph name="BATTERY_PERCENTAGE" />%)</translation>
<translation id="8945274638472141382">આઇકનનું કદ</translation>
<translation id="8945508919180478719">સ્ટુડિયો-શૈલીનું માઇક</translation>
<translation id="8952831374766033534">ગોઠવણીના વિકલ્પની સુવિધા નથી: <ph name="ERROR_LINE" /></translation>
<translation id="8960208913905765425">ઝડપી જવાબોનું એકમ રૂપાંતરણ</translation>
<translation id="8960638196855923532">હવે તમે તમારા ફોનના નોટિફિકેશન અને ઍપ જોઈ શકો છો</translation>
<translation id="89720367119469899">બહાર નીકળો</translation>
<translation id="8973648401056792381">તમારા ડિવાઇસના ઍડમિનિસ્ટ્રેટર દ્વારા ઇન્સ્ટૉલ કરવામાં આવેલી વેબ ઍપ.</translation>
<translation id="8978939272793553320"><ph name="DEVICE_NAME" /> ડિસ્કનેક્ટ કરવામાં આવ્યું છે</translation>
<translation id="8980345560318123814">પ્રતિસાદ રિપોર્ટ</translation>
<translation id="8981825781894055334">પેપર ઓછા છે</translation>
<translation id="8985561265504464578">ભાળ મેળવવાની મર્યાદા</translation>
<translation id="8986362086234534611">ભૂલી જાઓ</translation>
<translation id="8991694323904646277">કોઈ કૅમેરા નથી</translation>
<translation id="8991766915726096402">સ્થાનિક ડેટા રિકવરી</translation>
<translation id="8993737615451556423">વાંચવાના અવાજની ઝડપ વધારવા, ધીમી કરવા અને થોભાવવા મટે નિયંત્રણો પ્રદાન કરે છે</translation>
<translation id="899384117894244799">પ્રતિબંધિત વપરાશકર્તાને કાઢી નાખો</translation>
<translation id="8999560016882908256">વિભાગ સિન્ટેક્સ ભૂલ: <ph name="ERROR_LINE" /></translation>
<translation id="8999651235576960439">સ્ક્રીન પર ઘટાડેલી હિલચાલ</translation>
<translation id="9011393886518328654">રિલીઝ નોટ</translation>
<translation id="9012122671773859802">માઉસ ખસેડાય ત્યારે સ્ક્રીનને સતત ખસેડો</translation>
<translation id="9014206344398081366">ChromeVoxનું ટ્યૂટૉરિઅલ</translation>
<translation id="9014674417732091912">પંક્તિ <ph name="ROW_NUMBER" /> પર ખસેડ્યું</translation>
<translation id="9016827136585652292">પ્રાઇવસી સ્ક્રીન માટેની ટૉગલ કી</translation>
<translation id="9019956081903586892">જોડણીની તપાસનો શબ્દકોશ ડાઉનલોડ ન કરી શક્યાં</translation>
<translation id="9020362265352758658">4x</translation>
<translation id="902638246363752736">કીબોર્ડ સેટિંગ્સ</translation>
<translation id="9026393603776578602">ડિક્ટેશન</translation>
<translation id="9030754204056345429">વધુ ઝડપી</translation>
<translation id="9031811691986152304">ફરી પ્રયાસ કરો</translation>
<translation id="9032097289595078011">ઝડપી જોડાણની સુવિધા બંધ કરો</translation>
<translation id="9032513103438497286">આ <ph name="DEVICE_TYPE" /> પર ઇન્સ્ટૉલ કરેલી ઍપને બ્લૉક કરો. ઍપ અથવા કન્ટેન્ટ ડાઉનલોડ કરવા પર પ્રતિબંધ મૂકવા માટે, Google Playના સેટિંગ પર જાઓ.</translation>
<translation id="9037054491984310631"><ph name="DEVICE" /> નામના બ્લૂટૂથ ડિવાઇસ સાથે કનેક્ટેડ છે</translation>
<translation id="904224458472510106">આ ઑપરેશનનો છેલ્લો ફેરફાર રદ કરી શકાતો નથી</translation>
<translation id="9042893549633094279">પ્રાઇવસી અને સુરક્ષા</translation>
<translation id="9043767139743235992">Google Disability સપોર્ટ ટીમનો સંપર્ક કરો</translation>
<translation id="9057354806206861646">શેડ્યૂલ અપડેટ કરો</translation>
<translation id="9058760336383947367">પ્રિન્ટર PPD જુઓ</translation>
<translation id="9062468308252555888">14x</translation>
<translation id="9065203028668620118">ફેરફાર કરો</translation>
<translation id="9066782832737749352">ટેક્સ્ટ-ટુ-સ્પીચ</translation>
<translation id="9068598199622656904">એજ સમયે કીને દબાવી રાખવાને બદલે એક સમયે એક જ કી દબાવો</translation>
<translation id="9071664234353284876">કોઈ પ્રમાણીકરણ નથી</translation>
<translation id="9074739597929991885">બ્લૂટૂથ</translation>
<translation id="9076977315710973122">SMB શેર કરવાના સેટિંગ</translation>
<translation id="9078193189520575214">ફેરફારો લાગુ કરી રહ્યાં છીએ...</translation>
<translation id="9078316009970372699">ઝટપટ ઇન્ટરનેટ શેર કરવાની સુવિધા બંધ કરો</translation>
<translation id="9085446486797400519">કૅમેરાનો ઍક્સેસ</translation>
<translation id="9085776959277692427"><ph name="LANGUAGE" /> પસંદ કરી નથી. પસંદ કરવા માટે Search અને Space દબાવો.</translation>
<translation id="9087949559523851360">પ્રતિબંધિત વપરાશકર્તા ઉમેરો</translation>
<translation id="9089416786594320554">ઇનપુટ પદ્ધતિઓ</translation>
<translation id="9094038138851891550">વપરાશકર્તાનું નામ અમાન્ય છે</translation>
<translation id="9094859731829297286">શું તમે ખરેખર Linux માટે સ્થિર કદની ડિસ્ક આરક્ષિત કરવા માગો છો?</translation>
<translation id="9096053102600371572">નિયંત્રિત સ્ક્રોલિંગ વિશે <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="9098860402274800697">Google Play અને Android ઍપ કાઢી નાખો</translation>
<translation id="910000385680858937">મંજૂરી છે – <ph name="PERMISSION_DETAILS" />. તમારા ડિવાઇસ સાથે માઇક્રોફોન કનેક્ટ કરો.</translation>
<translation id="9100416672768993722">છેલ્લે ઉપયોગમાં લીધેલી ઇનપુટ પદ્ધતિ પર સ્વિચ કરવા માટે, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR" /><ph name="BEGIN_SPACE" />Space<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> દબાવો</translation>
<translation id="9108294543511800041">હવે તમે તમારા ફોનના તાજેતરના ફોટા, મીડિયા અને નોટિફિકેશન જોઈ શકો છો</translation>
<translation id="9109122242323516435">સ્પેસ ખાલી કરવા માટે, ડિવાઇસ સ્ટોરેજમાંથી ફાઇલો ડિલીટ કરો.</translation>
<translation id="9111330022786356709">તમારા માઉસ પર બટન ઉમેરો અથવા શોધો</translation>
<translation id="9116799625073598554">નોંધ લેતી અ‍ૅપ્લિકેશન</translation>
<translation id="9117030152748022724">તમારી ઍપને મેનેજ કરો</translation>
<translation id="9123287046453017203">તમારું ડિવાઇસ અપ ટૂ ડેટ નથી</translation>
<translation id="9126149354162942022">કર્સરનો રંગ</translation>
<translation id="9128335130883257666"><ph name="INPUT_METHOD_NAME" /> માટેનું સેટિંગ પેજ ખોલો</translation>
<translation id="9137157311132182254">પસંદગીનું શોધ એન્જિન</translation>
<translation id="9148058034647219655">બહાર નીકળો</translation>
<translation id="9148126808321036104">ફરીથી સાઇન ઇન કરો </translation>
<translation id="9150079578948279438">પ્રોફાઇલ કાઢી નાખી શક્યાં નથી. કૃપા કરીને ફરીથી પ્રયાસ કરો અથવા ટેક્નિકલ સપોર્ટ માટે તમારા મોબાઇલ ઑપરેટરનો સંપર્ક કરો.</translation>
<translation id="9151249085738989067">ChromeVox વૉઇસને ભાષાના આધારે ઑટોમૅટિક રીતે સ્વિચ કરો</translation>
<translation id="9151906066336345901">end</translation>
<translation id="9153451439615847952">નોટિફિકેશન અને અલર્ટ માટે બૅકગ્રાઉન્ડ ઑડિયો ઘટાડો</translation>
<translation id="915485121129452731">પેન ટૅબ્લેટ</translation>
<translation id="9157096865782046368">0.8 સેકન્ડ</translation>
<translation id="9157915340203975005">પ્રિન્ટરનો દરવાજો ખુલ્લો છે</translation>
<translation id="9167813284871066981"><ph name="NUM_ACCOUNTS" /> એકાઉન્ટ</translation>
<translation id="9169496697824289689">કીબોર્ડ શૉર્ટકટ જુઓ</translation>
<translation id="9170048603158555829">Thunderbolt</translation>
<translation id="9170766151357647548">તમારા ડિવાઇસનું EID <ph name="EID_NUMBER" /> છે. સેવા સક્રિય કરવામાં સહાય માટે આ નંબરનો ઉપયોગ થઈ શકે છે.</translation>
<translation id="9179524979050048593">સાઇન ઇન સ્ક્રીન વપરાશકર્તાનું નામ</translation>
<translation id="9187967020623675250">કીનો મેળ થતો નથી. <ph name="RESPONSE" /> માટે કોઈપણ કી દબાવો.</translation>
<translation id="9192019773545828776">બોલાયેલો પ્રતિસાદ સાંભળો, જેથી સ્ક્રીનની સામે જોયા વિના તમે તમારા ડિવાઇસનો ઉપયોગ કરી શકો. કનેક્ટ કરેલા ડિવાઇસ સાથે બ્રેઇલમાં પ્રતિસાદ આપવાની સુવિધા ઉપલબ્ધ છે. ChromeVox ચાલુ અને બંધ કરવા માટે Ctrl + Alt + Zનો ઉપયોગ કરો. નૅવિગેટ કરવા માટે Search + ડાબી ઍરો કી અથવા જમણી ઍરો કીનો ઉપયોગ કરો. પસંદ કરવા (સક્રિય કરવા) માટે Search + Space કીનો ઉપયોગ કરો.</translation>
<translation id="9201220332032049474">સ્ક્રીન લૉકના વિકલ્પો</translation>
<translation id="9203296457393252944">લાલ-લીલો રંગ, લીલો રંગ બરાબર ન દેખાવાની સમસ્યા, (ડ્યૂટેરેનોમલી)</translation>
<translation id="9205304506427975617">તમારું માથું થોડીક હિલચાલ કરતું હોય, તો પણ તમે કર્સર સ્થિર રાખી શકો છો. કર્સરને ખસેડવા આની માટે વધુ પ્રયાસ કરવાની જરૂર છે.</translation>
<translation id="9207669213427469593">જો તમે વિભાજિત સ્ક્રીનનો ઉપયોગ કરવા માટે વિન્ડોને એક બાજુ સ્નૅપ કરો, તો તમે બીજી બાજુ માટે વિન્ડોના સૂચનો જોશો</translation>
<translation id="9215742531438648683">Google Play Store અનઇન્સ્ટૉલ કરો</translation>
<translation id="9220525904950070496">એકાઉન્ટ દૂર કરો</translation>
<translation id="9220820413868316583">આંગળી ઉપાડી લો પછી ફરી પ્રયાસ કરો.</translation>
<translation id="930551443325541578">રિપીટ કી અને ઉચ્ચાર માટેના ચિહ્નો</translation>
<translation id="930893132043726269">હાલમાં રોમિંગ મોડમાં છે</translation>
<translation id="93393615658292258">ફક્ત પાસવર્ડ</translation>
<translation id="942296794412775122">માઇક્રોફોન ચાલુ/બંધ કરો</translation>
<translation id="950307215746360464">સેટઅપની માર્ગદર્શિકા</translation>
<translation id="952471655966876828">ડિવાઇસ જ્યારે ચાલુ કરવામાં આવે અથવા ઉપયોગમાં હોય, ત્યારે તે ઑટોમૅટિક રીતે કનેક્ટ થઈ જશે</translation>
<translation id="956013912698841780">કન્ટેન્ટનો સારાંશ આપવા, વ્યાખ્યાઓ મેળવવા, વધુ આત્મવિશ્વાસ સાથે લખવા, છબીઓ બનાવવા અને અન્ય ઘણું કરવા માટે રાઇટ-ક્લિક કરો. હાલમાં મર્યાદિત ઉપલબ્ધતા છે.</translation>
<translation id="957179356621191750">6-ડૉટ</translation>
<translation id="964790508619473209">સ્ક્રીનની ગોઠવણી</translation>
<translation id="966588271015727539">બ્લૂટૂથનું બ્રેઇલ પ્રદર્શન પસંદ કરો</translation>
<translation id="96774243435178359">મેનેજ કરેલા પ્રિન્ટર</translation>
<translation id="968000525894980488">Google Play સેવાઓ ચાલુ કરો.</translation>
<translation id="973558314812359997">માઉસનું કદ</translation>
<translation id="978146274692397928">પ્રારંભિક વિરામચિહ્નની પહોળાઈ પૂર્ણ છે</translation>
<translation id="978978324795544535">કોઈ આઇટમ પર બે વાર ટૅપ કરો અને બીજા ટૅપ પર તેને દબાવી રાખો, ત્યારબાદ એ આઇટમને ખસેડવા માટે તેને ખેંચો</translation>
<translation id="981121421437150478">ઑફલાઇન</translation>
<translation id="984705303330760860">ભાષાઓ માટે જોડણીની તપાસ સુવિધા ઉમેરો</translation>
<translation id="987264212798334818">સામાન્ય</translation>
<translation id="992256792861109788">ગુલાબી</translation>
<translation id="99731366405731005">વાઇ-ફાઇ સિંકનો ઉપયોગ કરવા માટે <ph name="LINK1_BEGIN" />Chrome સિંક<ph name="LINK1_END" /> ચાલુ કરો. <ph name="LINK2_BEGIN" />વધુ જાણો<ph name="LINK2_END" /></translation>
</translationbundle>