<translation id="1838374766361614909">શોધ સાફ કરો</translation>
<translation id="184183613002882946">ના, 1 સ્વિચ બસ છે</translation>
<translation id="1842681835432895345">આ ડિસ્પ્લેને મિરર મોડમાં બાકાત રાખો</translation>
<translation id="1864400682872660285">કૂલર</translation>
<translation id="1877860345998737529">ક્રિયાની સોંપણી સ્વિચ કરો</translation>
<translation id="1878885068166344708">જ્યારે તમે ફોકસ ખસેડો છો ત્યારે આઇટમ હાઇલાઇટ કરવામાં આવે છે. ટૅબ કી દબાવો અથવા ફોકસ બદલવા માટે આઇટમ પસંદ કરો.</translation>
<translation id="1881445033931614352">કીબોર્ડ લેઆઉટ</translation>
<translation id="1907044622262489040">તમારા વૉઇસ વડે ટાઇપ કરો. Search + Dનો ઉપયોગ કરો, પછી બોલવાનું શરૂ કરો.</translation>
<translation id="1923539912171292317">ઑટોમૅટિક રીતે ક્લિક</translation>
<translation id="1926887872692564784">કર્સર</translation>
<translation id="1938351510777341717">બાહ્ય આદેશ</translation>
<translation id="1951012854035635156">Assistant</translation>
<translation id="1966649499058910679">દરેક શબ્દને બોલવાની રીત પ્રમાણે હાઇલાઇટ કરો</translation>
<translation id="1969011864782743497"><ph name="DEVICE_NAME" /> (USB)</translation>
<translation id="1973886230221301399">ChromeVox</translation>
<translation id="1974060860693918893">વિગતવાર</translation>
<translation id="1974159333077206889">બધા સ્પીકરમાંથી સમાન ઑડિયો માટેનાં સેટિંગ</translation>
<translation id="1988733631391393183">ChromeVox મેનૂમાં બ્રેઇલ આદેશો બતાવો</translation>
<translation id="1999763610967697511">ખેંચો અને છોડો</translation>
<translation id="2003596238737586336">હાલનું શેડ્યૂલ <ph name="SUNRISE" /> - <ph name="SUNSET" /> પર સેટ કર્યું છે. આ સેટિંગને તમારા ઍડમિનિસ્ટ્રેટર દ્વારા મેનેજ કરવામાં આવે છે.</translation>
<translation id="2025123106058020990">ચોકસાઈવાળું ક્લિક</translation>
<translation id="2026377162111110983">એરિયા વૉઇસ</translation>
<translation id="2030455719695904263">ટ્રૅકપૅડ</translation>
<translation id="2045838962742066664">શૉર્ટહેન્ડ ટાઇપિંગ</translation>
<translation id="2066700471214517561">બીમફૉર્મિંગ માઇક, જેથી Chromebookનો ઉપયોગ કરનારી વ્યક્તિને સ્પષ્ટ રીતે સાંભળી શકાય.</translation>
<translation id="2079545284768500474">છેલ્લો ફેરફાર રદ કરો</translation>
<translation id="2088564884469682888">બિલ્ટ-ઇન TrackPoint</translation>
<translation id="2091523941449737894">તમારા ટચપૅડને ઝડપથી ખસેડવાથી કર્સર આગળ ખસેડાશે</translation>
<translation id="2091887806945687916">ધ્વનિ</translation>
<translation id="2135456203358955318">ડૉક કરેલ મૅગ્નિફાયર</translation>
<translation id="2143915448548023856">પ્રદર્શન સેટિંગ્સ</translation>
<translation id="2147282432401652483">command</translation>
<translation id="2148212683005708350"><ph name="MODIFIER_ONE" /> + <ph name="MODIFIER_TWO" /> + <ph name="MODIFIER_THREE" /> + <ph name="KEY" /></translation>
<translation id="2155772377859296191"><ph name="WIDTH" /> x <ph name="HEIGHT" /> જેવું લાગે છે</translation>
<translation id="2157457598652721267">માઉસનું ડાબા કે જમણા બટન પસંદ કરવા માટે “/” અને “-”નો ઉપયોગ કરો. બન્ને બટન પસંદ કરવા માટે “*”નો ઉપયોગ કરો.</translation>
<translation id="2158249272743343757">વ્યક્તિગત ડેટા ડિલીટ કરો...</translation>
<translation id="2164131635608782358"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" />, <ph name="THIRD_SWITCH" /> અને વધુ 1 સ્વિચ</translation>
<translation id="2165177462441582039">દરેક આઇટમ પર હાઇલાઇટ કેટલીવાર સુધી રહેશે તે પસંદ કરો</translation>
<translation id="2175526076681939329">પ્રાથમિક કીનો ઉપયોગ કરો</translation>
<translation id="2218019600945559112">માઉસ અને ટચપેડ</translation>
<translation id="2221261048068091179"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" /></translation>
<translation id="2234208862050358325">કર્સરને ખસેડવા માટે 1, 2, 3, q, e, a, s, d કીનો ઉપયોગ કરો</translation>
<translation id="2243934210752059021">શોધ + alt + <ph name="TOP_ROW_KEY" /></translation>
<translation id="2245603955208828424">આઇટમમાં એક પછી એક અક્ષર પર કર્સરને ખસેડવા માટે ઍરો કીનો ઉપયોગ કરો</translation>
<translation id="2247870315273396641">વૉઇસનો પ્રીવ્યૂ</translation>
<translation id="2250153645770828940">શબ્દકોશ ડિલીટ કરો</translation>
<translation id="22505994009453896">આંકડાના કીપેડ વડે તમારા માઉસનું કર્સર નિયંત્રિત કરો</translation>
<translation id="2262477216570151239">પુનરાવર્તન પહેલાં વિલંબ</translation>
<translation id="2263371730707937087">સ્ક્રીનનો રિફ્રેશ થવાનો રેટ</translation>
<translation id="2270666014403455717">“પસંદ કરો” માટે સ્વિચની સોંપણી કરો</translation>
<translation id="2272430695183451567">એકેય સ્વિચની સોંપણી કરી નથી</translation>
<translation id="228059581448666199">માઉસ પર લેફ્ટ ક્લિક કરો</translation>
<translation id="2290615375132886363">ટૅબ્લેટ નૅવિગેશનનાં બટન</translation>
<translation id="2310923358723722542">ડિસ્પ્લે મોટું કરવાની સુવિધા</translation>
<translation id="2319459402137712349">કીબોર્ડ ખોલવા માટે ટેક્સ્ટ ફીલ્ડ પસંદ કરો. તમે તમારી સ્ક્રીનની સૌથી નીચે કીબોર્ડ આઇકન પણ પસંદ કરી શકો છો.</translation>
<translation id="2373499590298659902">માઉસનું બટન દબાવી રાખવા માટે “0”નો ઉપયોગ કરો</translation>
<translation id="2376056713414548745">મોટેથી વાંચો</translation>
<translation id="2382368170666222719">બિલ્ટ-ઇન ટચપૅડને બંધ કરો</translation>
<translation id="2383825469508278924">કીબોર્ડની કીનું મૅપિંગ, ફંક્શન કી અને બીજું ઘણું બદલો</translation>
<translation id="2410298923485357543">જ્યારે ડિવાઇસ ઑનલાઇન હોય, ત્યારે સાહજિક અવાજનો ઉપયોગ કરો</translation>
<translation id="2416435988630956212">કીબોર્ડની ફંકશન કી</translation>
<translation id="2427507373259914951">લેફ્ટ ક્લિક કરો</translation>
<translation id="2445726032315793326">આંશિક મેગ્નિફાયર</translation>
<translation id="2448810255793562605">સ્વિચ ઍક્સેસનું ઑટોમેટિક રીતે સ્કૅન</translation>
<translation id="2451298179137331965">2x</translation>
<translation id="2469375675106140201">જોડણીની તપાસને કસ્ટમાઇઝ કરો</translation>
<translation id="2471469610750100598">કાળો (ડિફૉલ્ટ)</translation>
<translation id="2477065602824695373">તમે એકથી વધુ સ્વિચનું સેટઅપ કર્યું હોવાને કારણે ઑટો-સ્કૅનની સુવિધા બંધ કરવામાં આવી છે.</translation>
<translation id="2479541499757560845">કીબોર્ડના સેટિંગની ઍક્સેસિબિલિટી</translation>
<translation id="248676429071089168">પેજને નીચે લઈ જવા માટે ઉપર સ્વાઇપ કરો</translation>
<translation id="2489686758589235262">વધુ 2 સ્વિચની સોંપણી કરો</translation>
<translation id="249330843868392562">ટેક્સ્ટ-ટૂ-સ્પીચ સેટિંગ ખોલો</translation>
<translation id="2497229222757901769">માઉસની ગતિ</translation>
<translation id="2501920221385095727">સ્ટિકી કી</translation>
<translation id="250704661983564564">ડિસ્પ્લેની ગોઠવણી</translation>
<translation id="2507491234071975894">સ્પીકર</translation>
<translation id="2509566264613697683">8x</translation>
<translation id="2512065992892294946"><ph name="LANGUAGE" /> (પસંદ કરેલી)</translation>
<translation id="2514465118223423406">જ્યારે માઉસ કનેક્ટ કરેલું છે</translation>
<translation id="2515586267016047495">Alt</translation>
<translation id="2517472476991765520">સ્કૅન કરો</translation>
<translation id="2521835766824839541">પહેલાનો ટ્રૅક</translation>
<translation id="2529887123641260401">તમે કોઈપણ સમયે તમારા સેટિંગમાં ફેરફાર કરી શકો છો અથવા Switch Access સેટિંગમાંથી ફરી સેટઅપ માર્ગદર્શિકા ખોલી શકો છો.</translation>
<translation id="2532589005999780174">ઉચ્ચ કોન્ટ્રાસ્ટ મોડ</translation>
<translation id="2546991196809436099">સ્ક્રીન પર આઇટમ વધુ મોટી બનાવવા માટે 'મોટું કરો'. મૅગ્નિફાયરને ચાલુ કે બંધ કરવા માટે Search + Ctrl + Mનો ઉપયોગ કરો.</translation>
<translation id="2573831315551295105">“<ph name="ACTION" />” માટે સ્વિચની સોંપણી કરો</translation>
<translation id="2577127557293415225">ટૂંક સમય માટે બન્ને આંખ બંધ કરો</translation>
<translation id="258095186877893873">લાંબો</translation>
<translation id="2581786034175502848">તેને ફરી ચાલુ કરવા માટે, 5 વાર Shift કી દબાવો</translation>
<translation id="2619340799655338321">ચલાવો/થોભાવો</translation>
<translation id="2620900772667816510">બ્લૂટૂથ સુપર રિઝોલ્યુશન</translation>
<translation id="262373406453641243">કોલેમાક</translation>
<translation id="2631498379019108537">શેલ્ફમાં ઇનપુટ વિકલ્પો બતાવો</translation>
<translation id="2634199532920451708">પ્રિન્ટ ઇતિહાસ</translation>
<translation id="264897126871533291">લાલ રંગ ન દેખાવાની ખામી</translation>
<translation id="2657612187216250073">પૉઇન્ટરના ઍક્સેસિબિલિટી સેટિંગ</translation>
<translation id="2659694935349347275">વિન્ડોને નીચેની તરફ અને જમણી બાજુ ખસેડવામાં આવી</translation>
<translation id="2670350619068134931">ઘટાડેલા ઍનિમેશન</translation>
<translation id="267442004702508783">રિફ્રેશ કરો</translation>
<translation id="2692503699962701720">તત્વના પ્રકારો અને ફૉર્મેટ કરેલી ટેક્સ્ટ બોલતી વખતે પિચ બદલો</translation>
<translation id="2693134906590795721">ચાર્જિંગના સાઉન્ડ</translation>
<translation id="270516211545221798">ટચપેડની ગતિ</translation>
<translation id="2706462751667573066">Up</translation>
<translation id="2714180132046334502">ઘાટું બૅકગ્રાઉન્ડ</translation>
<translation id="271749239614426244">કર્સરની સાધારણ હિલચાલ અવગણો</translation>
<translation id="2718395828230677721">રાત્રિ પ્રકાશ</translation>
<translation id="2726776862643824793">ડિસ્પ્લેનું બ્રાઇટનેસ ઘટાડવાની કી</translation>
<translation id="27349076983469322">આછું બૅકગ્રાઉન્ડ</translation>
<translation id="2735712963799620190">શેડ્યૂલ</translation>
<translation id="2751454300227269244">તમારું મ્હો જમણી બાજુ કરો</translation>
<translation id="2752805177271551234">ઇનપુટ ઇતિહાસનો ઉપયોગ કરો</translation>
<translation id="2755367719610958252">ઍક્સેસિબિલિટી સુવિધાઓ મેનેજ કરો</translation>
<translation id="2765217105034171413">નાનું</translation>
<translation id="2770929488047004208">મોનિટરનું રિઝોલ્યુશન</translation>
<translation id="2801954693771979815">સ્ક્રીનનું કદ</translation>
<translation id="2802911274872454492">સંકેતનું સેટિંગ: <ph name="SELECTED_GESTURE" /></translation>
<translation id="2804742109948581745">આજુબાજુમાં</translation>
<translation id="2808985063107661499">"<ph name="CONFLICTING_GESTURE_ONE" />" અને "<ph name="CONFLICTING_GESTURE_TWO" />" સાથે "<ph name="MAIN_GESTURE" />" ઓવરલેપ થઈ શકે છે. જો શક્ય હોય, તો બીજો કોઈ સંકેત પસંદ કરી જુઓ.</translation>
<translation id="2809346626032021864">વાંચન</translation>
<translation id="2822634587701817431">સંકોચો / વિસ્તૃત કરો</translation>
<translation id="2833144527504272627">ટેક્સ્ટ કર્સર વડે નૅવિગેટ કરો</translation>
<translation id="2835177225987815960">કોઈપણ સોંપવામાં આવેલી સ્વિચ અને ઑટો-સ્કૅન માટે ઝડપના સેટિંગ સહિત સ્કૅન કરવા માટેના તમારા હાલના સેટઅપને રીસેટ કરવામાં આવશે.</translation>
<translation id="2849035674501872372">શોધો</translation>
<translation id="2860710618359053450">જડબું જમણે ખસેડો</translation>
<translation id="2865057607286263192">ઉચ્ચાર માટેના ચિહ્નો અને વિશેષ વર્ણો જોવા માટે, કીબોર્ડની કીને દબાવી રાખો. આમ કરવાથી આલ્ફાબેટ કી માટે રિપીટ કી દબાવવાની સુવિધા બંધ થઈ જશે. માત્ર અંગ્રેજી (યુએસ) ભાષા માટે ઉપલબ્ધ છે.</translation>
<translation id="2873744479411987024">વધુ ઉચ્ચ રિફ્રેશ રેટને કારણે તમને વધુ વિગતો ધરાવતું ડિસ્પ્લે જોવા મળશે. રિફ્રેશ થવાના વધુ ઉચ્ચ રેટને કારણે બૅટરીની આવરદા પર અસર થઈ શકે છે.</translation>
<translation id="2885129935310217435">સમાન નામ ધરાવતું એક બટન છે. કૃપા કરીને બીજું કોઈ પસંદ કરો.</translation>
<translation id="2903925626657991994">ડાબા બટન, જમણા બટન અને બન્ને બટન વચ્ચે માઉસના બટનની પસંદગી બદલવા માટે “,”નો ઉપયોગ કરો</translation>
<translation id="2908358077082926882">સોંપણી કાઢી નાખવા માટે, ફરી “<ph name="CURRENTKEY" />” દબાવો અને <ph name="RESPONSE" /></translation>
