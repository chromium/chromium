<translation id="583179300286794292"><ph name="SPAN_START" /><ph name="DRIVE_ACCOUNT_EMAIL" /><ph name="SPAN_END" /> તરીકે સાઇન ઇન થયા</translation>
<translation id="583281660410589416">અજ્ઞાત</translation>
<translation id="5833726373896279253">આ સેટિંગ ફક્ત માલિક દ્વારા જ ફેરફાર થઈ શકે છે:</translation>
<translation id="5833746798680181492"><ph name="ALREADY_ASSIGNED_MESSAGE" /> <ph name="CONFLICTING_GESTURES_MESSAGE" /></translation>
<translation id="583756221537636748">કેસ</translation>
<translation id="5841270259333717135">ઇથરનેટ ગોઠવો</translation>
<translation id="5842497610951477805">બ્લૂટૂથ ચાલુ</translation>
<translation id="5846200638699387931">રિલેશન સિન્ટેક્સ ભૂલ: <ph name="ERROR_LINE" /></translation>
<translation id="5846749317653566506">રંગો અલગ અલગ હોવાની ખાતરી કરવા માટે રંગ સુધારણાના સેટિંગની ગોઠવણ કરો</translation>
<translation id="5848054741303781539">મેન્યુઅલી સેટ કરો, લોકેશનનો ઉપયોગ કરીને નહીં</translation>
<translation id="5855267860608268405">જાણીતા વાઇ-ફાઇ નેટવર્ક</translation>
<translation id="5855643921295613558">0.6 સેકન્ડ</translation>
<translation id="5857693745746757503">જ્યારે તમે આજે અપગ્રેડ કરો, ત્યારે નવી Chromebook પર $50 કે તેથી વધુની બચત કરો</translation>
<translation id="585979798156957858">બાહ્ય મેટા</translation>
<translation id="5860033963881614850">બંધ</translation>
<translation id="5860335608673904825">શોધ + ctrl + shift + <ph name="TOP_ROW_KEY" /></translation>
<translation id="5860491529813859533">ચાલુ કરો</translation>
<translation id="5860494867054883682">તમારા ઉપકરણને <ph name="CHANNEL_NAME" /> ચેનલ પર અપડેટ કરી રહ્યાં છે (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="5862109781435984885">શેલ્ફમાં સ્ટાઇલસનાં સાધનો બતાવો</translation>
<translation id="5862319196656206789">કનેક્ટ કરેલાં ડિવાઇસ સેટઅપ કરો</translation>
<translation id="5863195274347579748">બાહ્ય ઍક્સેસરી વ્યક્તિગત ડેટાને ઍક્સેસ અથવા શેર કરી શકે એમ બને.</translation>
<translation id="5863263400083022538">સિસ્ટમ સેવાઓ</translation>
<translation id="5864754048328252126">ચાર્જિંગ દરમ્યાનની નિષ્ક્રિય ક્રિયા</translation>
<translation id="5868434909835797817">તમારા ડિવાઇસ પર માઇક્રોફોન બંધ છે</translation>
<translation id="5877064549588274448">ચેનલ બદલી. ફેરફારો લાગુ કરવા માટે તમારા ઉપકરણને પુનઃપ્રારંભ કરો.</translation>
<translation id="5882919346125742463">જાણીતા નેટવર્ક્સ</translation>
<translation id="5886112770923972514">નજીક હોય એવા 'ઝડપી જોડાણ' ડિવાઇસ સાથે કનેક્ટ કરો અને ઝડપથી તેમનું સેટઅપ કરો</translation>
<translation id="5891688036610113830">પસંદ કરેલા વાઇ-ફાઇ નેટવર્ક</translation>
<translation id="5899860758576822363">ChromeVox બોલી રહ્યું હોય ત્યારે ઓછા અવાજે ચલાવો</translation>
<translation id="5901069264981746702">તમારી ફિંગરપ્રિન્ટનો ડેટા સુરક્ષિત રીતે સ્ટોર કરવામાં આવે છે અને હંમેશાં તમારા <ph name="DEVICE_TYPE" />માં જ રહે છે. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="5901630391730855834">પીળો</translation>
<translation id="5906974869830879618">કૃપા કરીને પિન દાખલ કરો</translation>
<translation id="5911497236110691522">આગલી ઇનપુટ પદ્ધતિ પર સ્વિચ કરવા માટે, <ph name="KEY_CODES" /> દબાવો</translation>
<translation id="5916655001090539219">ઑટોમૅટિક રીતે વાંચવાની સુવિધા</translation>
<translation id="5916664084637901428">ચાલુ</translation>
<translation id="59174027418879706">સક્ષમ કરેલું</translation>
<translation id="5919486630433391408">તમારા ઍડમિનિસ્ટ્રેટર દ્વારા ફર્મવેયર અપડેટ બંધ કરવામાં આવી છે.</translation>
<translation id="5920543303088087579">તમારા વ્યવસ્થાપક દ્વારા આ નેટવર્કથી કનેક્ટ કરવાનું અક્ષમ કરેલ છે</translation>
<translation id="5924438086390153180">Microsoft ફાઇલોને Google Driveમાં કૉપિ કરતા કે ખસેડતા પહેલાં પૂછો</translation>
<translation id="5939518447894949180">રીસેટ કરો</translation>
<translation id="594048410531370124">ઓળખવામાં ન આવેલી કી. <ph name="RESPONSE" /> માટે કોઈપણ કી દબાવો.</translation>
<translation id="5945192511027649793">ટચપૅડ બંધ કરો</translation>
<translation id="5947651424015173580">માઉસ પર બે વાર ક્લિક કરો</translation>
<translation id="594993197557058302">1-4 મૉડિફાયર કી (ctrl, alt, shift, શોધ, અથવા લૉન્ચર) અને વધુ 1 કી દબાવો. તમે કોઈ એક કી પણ પસંદ કરી શકો છો.</translation>
<translation id="5951624318208955736">મૉનિટર</translation>
<translation id="5952020381407136867">ટચપૅડ</translation>
<translation id="5952784976463781389">આ ઍપનો ડેટા "<ph name="PARENT_APP_NAME" />" અને તેની ઇન્સ્ટૉલ કરેલી ઍપ વચ્ચે શેર કરવામાં આવે છે</translation>
<translation id="5957987129450536192">તમારી પ્રોફાઇલ છબીની પાસેના બોલવા માટે પસંદ કરો આઇકનને દબાવો, પછી જે ભાગને સાંભળવો હોય તેને પસંદ કરો.</translation>
<translation id="5959982036207776176">મૅગ્નિફાયર સાંભળવા માટે પસંદ કરો સુવિધા દ્વારા વાંચવામાં આવનાર શબ્દને અનુસરે છે</translation>
<translation id="5961545272769624207">કોઈ સંકેત અસાઇન કરો</translation>
<translation id="5968022600320704045">કોઈ શોધ પરિણામ નથી</translation>
<translation id="5969728632630673489">કીબોર્ડ શૉર્ટકટની નોટિસ છોડી દીધી</translation>
<translation id="5985556342298151179">તમારા ડિવાઇસના ઍડમિનિસ્ટ્રેટર દ્વારા ઇન્સ્ટૉલ કરવામાં આવેલી Chrome ઍપ.</translation>
<translation id="5986442691296752186">Linux ઍપને USB ડિવાઇસને નિયંત્રિત કરવાની સુવિધા આપો.</translation>
<translation id="598810097218913399">સોંપણી કાઢી નાખો</translation>
<translation id="5988563937187882754">જમણે જુઓ</translation>
<translation id="5992225669837656567">તમામ માઉસ ડિસ્કનેક્ટ કરવામાં આવ્યા છે</translation>
<translation id="5999630716831179808">અવાજો</translation>
<translation id="6002458620803359783">મનપસંદ વૉઇસ</translation>
<translation id="6003143259071779217">ઇ-સિમ સેલ્યુલર નેટવર્ક કાઢી નાખો</translation>
<translation id="6007053304250788613">મિરર મોડમાં માત્ર એક ડિસ્પ્લેને બાકાત કરી શકાય છે</translation>
<translation id="6011193465932186973">ફિંગરપ્રિન્ટ</translation>
<translation id="6017514345406065928">લીલો</translation>
<translation id="6021969570711251331">ઇન્ટરલીવ</translation>
<translation id="6028117231645531007">ફિંગરપ્રિન્ટ ઉમેરો</translation>
<translation id="6031600495088157824">ટૂલબારમાંના ઇનપુટ માટેના વિકલ્પો</translation>
<translation id="604388835206766544">ગોઠવણીનું વિશ્લેષણ કરવામાં નિષ્ફળ થયાં</translation>
<translation id="6045114302329202345">પ્રાથમિક TrackPoint બટન</translation>
<translation id="6048747414605857443">ChromeVox અને 'સાંભળવા માટે પસંદ કરો' સુવિધા માટે ટેક્સ્ટ ટૂ સ્પીચ વૉઇસ પસંદ કરો અને કસ્ટમાઇઝ કરો</translation>
<translation id="6050189528197190982">ગ્રેસ્કેલ</translation>
<translation id="6059276912018042191">તાજેતરની Chrome ટૅબ</translation>
<translation id="6059925163896151826">USB ઉપકરણો</translation>
<translation id="6064764629679333574">ઑડિયોના રિઝોલ્યુશનને ઓછામાંથી વધારે કરીને બ્લૂટૂથ માઇક સાઉન્ડની ક્વૉલિટીને બહેતર બનાવો.</translation>
<translation id="6073292342939316679">કીબોર્ડનું બ્રાઇટનેસ ઘટાડવાની કી</translation>
<translation id="6075075631258766703">ફોન ચકાસો</translation>
<translation id="6077131872140550515">પસંદગીમાંથી દૂર કરો</translation>
<translation id="6077476112742402730">લખવા માટે બોલો</translation>
<translation id="6089289670051481345">વાદળી-પીળો રંગ ન દેખાવાની ખામી</translation>
<translation id="609174145569509836">સ્ટોરેજ સાફ કરો</translation>
<translation id="6097480669505687979">જો તમે સ્થાન ખાલી કરશો નહીં, તો વપરાશકર્તાઓ અને ડેટા ઑટોમૅટિક રીતે કાઢી નાખવામાં આવી શકે છે.</translation>
<translation id="6103681770816982672">ચેતવણી: તમે વિકાસકર્તાની ચેનલ પર સ્વિચ કરી રહ્યાં છો</translation>
<translation id="6104796831253957966">પ્રિન્ટરની કતારમાં ઘણી બધી ફાઇલો છે</translation>
<translation id="6104929924898022309">ફંક્શન કીની વર્તણૂંક બદલવા માટે શોધ કીનો ઉપયોગ કરો</translation>
<translation id="6111718295497931251">Google Driveનો ઍક્સેસ કાઢી નાખો</translation>
<translation id="6112727384379533756">ટિકિટ ઉમેરો</translation>
<translation id="6113434369102685411">Chrome બ્રાઉઝર અને <ph name="DEVICE_TYPE" /> લૉન્ચર માટે તમારું ડિફૉલ્ટ શોધ એન્જિન સેટ કરો</translation>
<translation id="6113832060210023016">લૉન્ચર + ક્લિક</translation>
<translation id="6119972796024789243">રંગ સુધારણા</translation>
<translation id="6127292407256937949">વૉલ્યૂમ ચાલુ છે. વૉલ્યૂમ બંધ કરો.</translation>
<translation id="6129953537138746214">Space</translation>
<translation id="6130692320435119637">વાઇ-ફાઇ ઉમેરો</translation>
<translation id="6130807998512240230">ફોન હબ, નજીકના શેર</translation>
<translation id="6134428719487602109">બધા વપરાશકર્તા એકાઉન્ટ કાઢી નાખો અને તમારી Chromebookને એકદમ નવીની જેમ રીસેટ કરો.</translation>
<translation id="6136285399872347291">backspace</translation>
<translation id="6149791593592044995">આધુનિક ટોન માર્ક પ્લેસમેન્ટનો ઉપયોગ કરો</translation>
<translation id="6154240335466762404">બધા પોર્ટ કાઢી નાખો</translation>
<translation id="615436196126345398">પ્રોટોકોલ</translation>
<translation id="6155885807222400044">AES-128</translation>
<translation id="6156944117133588106">ટૅબ્લેટ મોડમાં નૅવિગેશન બટન બતાવો</translation>
<translation id="6163376401832887457">Kerberosના સેટિંગ</translation>
<translation id="6165508094623778733">વધુ જાણો</translation>
<translation id="6169967265765719844">Steam મારફતે ઇન્સ્ટૉલ કરેલી ગેમ અને ઍપ માટેની પરવાનગીઓને <ph name="LINK_BEGIN" />Steam ઍપ સેટિંગ<ph name="LINK_END" />માં મેનેજ કરી શકાય છે.</translation>
<translation id="6174909075810107548">માઉસનું બટન દબાવવા માટે “5”નો ઉપયોગ કરો</translation>
<translation id="6183369864942961155">ઑટોમૅટિક લાઇટ/ડાર્ક થીમ</translation>
<translation id="6186177419203903310">આમ કરવાથી સમગ્ર સિસ્ટમ પરના USBના તમામ નવા સહાયક ડિવાઇસ માટે નોટિફિકેશન ચાલુ કરવામાં આવશે. શું તમે ખરેખર આગળ વધવા માગો છો?</translation>
<translation id="6190953336330058278">ફોન હબની ઍપ</translation>
<translation id="6198252989419008588">PIN બદલો</translation>
<translation id="61988015556954366">સ્ક્રીન ફ્લૅશ</translation>
<translation id="6202935572248792580">મંજૂરી છે. તમારા ડિવાઇસ સાથે માઇક્રોફોન કનેક્ટ કરો.</translation>
<translation id="6212039847102026977">વિગતવાર નેટવર્ક ગુણધર્મો બતાવો</translation>
<translation id="6212168817037875041">ડિસ્પ્લે બંધ કરો</translation>
<translation id="6216601812881225442">તમારા કન્ટેનરનું કદ બદલવાની સુવિધા ઉપલબ્ધ નથી. Linux માટે અગાઉથી ફાળવેલી સ્પેસ ગોઠવવા માટે, બૅકઅપ લો અને ત્યાર બાદ નવા કન્ટેનરમાં રિસ્ટોર કરો.</translation>
<translation id="6216696360484424239">ઑટોમેટિક રીતે સાઇન ઇન કરો</translation>
<translation id="6217806119082621377">શેર કરેલા ફોલ્ડરો <ph name="BASE_DIR" /> પર <ph name="SPECIFIC_NAME" />માં ઉપલબ્ધ હોય છે.</translation>
<translation id="622484624075952240">Down</translation>
<translation id="6229849828796482487">વાઇ-ફાઇ નેટવર્ક ડિસકનેક્ટ કરો</translation>
<translation id="6231782223312638214">સૂચવેલા</translation>
<translation id="6232017090690406397">બૅટરી</translation>
<translation id="6237474966939441970">સ્ટાયલસ વડે નોંધ લેવાની ઍપના સેટિંગ</translation>
<translation id="6240637845286751292">મંજૂરી છે. <ph name="LINK_BEGIN" />સિસ્ટમનો લોકેશનનો ઍક્સેસ<ph name="LINK_END" /> ચાલુ કરો.</translation>
<translation id="6240821072888636753">દર વખતે પૂછો</translation>
<translation id="6247620186971210352">કોઈ ઍપ મળી નથી</translation>
<translation id="6247708409970142803"><ph name="PERCENTAGE" />%</translation>
<translation id="6249200942125593849">ઍક્સેસિબિલિટીને મેનેજ કરવાનાં સેટિંગ</translation>
<translation id="625827534921607067">જો અગાઉ કનેક્ટ કરેલા કે કન્ફિગર કરેલા એક કરતાં વધારે નેટવર્ક ઉપલબ્ધ હશે, તો આ નેટવર્કની પસંદગી કરવામાં આવશે</translation>
<translation id="6265159465845424232">Microsoft ફાઇલોને Microsoft OneDriveમાં કૉપિ કરતા કે ખસેડતા પહેલાં પૂછો</translation>
<translation id="6265687851677020761">પોર્ટ કાઢી નાખો</translation>
<translation id="6266532094411434237"><ph name="DEVICE" />થી કનેક્ટ કરી રહ્યાં છીએ</translation>
<translation id="6270309713620950855">સંકેત મ્યૂટ કરો</translation>
<translation id="6274089201566806618"><ph name="HOST_DEVICE_NAME" /> સાથે કનેક્ટ કરી રહ્યાં છીએ</translation>
<translation id="628352644014831790">4 સેકન્ડ</translation>
<translation id="6287828400772161253">Android ફોન (<ph name="HOST_DEVICE_NAME" />)</translation>
<translation id="6294759976468837022">ઑટો-સ્કૅનની ઝડપ</translation>
<translation id="6300718114348072351"><ph name="PRINTER_NAME" />ને ઑટોમૅટિક રીતે ગોઠવી શકાતું નથી. કૃપા કરીને વિગતવાર પ્રિન્ટરની વિગતો જણાવો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="6302661287897119265">ફિલ્ટર</translation>
<translation id="6305627295927385295">નીચેની આઇટમ ડિલીટ કરો:</translation>
<translation id="6305702903308659374">ChromeVox બોલી રહ્યું હોય ત્યારે પણ સામાન્ય અવાજે ચલાવો</translation>
<translation id="6307268917612054609">કૅમેરાની પરવાનગી ધરાવતી ઍપ અને વેબસાઇટ તેમજ સિસ્ટમ સર્વિસ, તમારા કૅમેરાનો ઉપયોગ કરી શકે છે</translation>
<translation id="6309443618838462258">તમારા વ્યવસ્થાપક આ ઇનપુટ પદ્ધતિની મંજૂરી આપતા નથી</translation>
<translation id="6313950457058510656">ઝટપટ ઇન્ટરનેટ શેર કરવાની સુવિધા બંધ કરો</translation>
<translation id="6315170314923504164">અવાજ</translation>
<translation id="6318944945640833942">પ્રિન્ટરની જાણકારી મેળવી ન શકાઈ. કૃપા કરીને પ્રિન્ટરનું ઍડ્રેસ ફરી દાખલ કરો.</translation>
<translation id="6327785803543103246">વેબ પ્રૉક્સીની ઑટોમૅટિક ખોજ</translation>
<translation id="6336194758029258346">ઍપની ભાષા</translation>
<translation id="6338968693068997776">USB ડિવાઇસ ઉમેરો</translation>
<translation id="6340071272923955280">ઇન્ટરનેટ પ્રિંટિંગ પ્રોટોકોલ (IPPS)</translation>
<translation id="6343981313228733146">વિન્ડોને ઉપરની તરફ અને જમણી બાજુ ખસેડવામાં આવી</translation>
<translation id="6344576354370880196">સાચવેલા પ્રિન્ટર</translation>
<translation id="6347010704471250799">નોટિફિકેશન બતાવો</translation>
<translation id="6348252528297699679">તમે સેટિંગ &gt; પ્રાઇવસી અને સુરક્ષા &gt; પ્રાઇવસીને લગતા નિયંત્રણો &gt; લોકેશન ઍક્સેસમાં જઈને લોકેશન બંધ કરી શકો છો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="6348805481186204412">ઑફલાઇન સ્ટોરેજ</translation>
<translation id="6349101878882523185"><ph name="APP_NAME" /> ઇન્સ્ટૉલ કરો</translation>
<translation id="6351178441572658285">ઍપની ભાષાઓ</translation>
<translation id="6356718524173428713">પેજને નીચે લઈ જવા માટે ઉપર સ્ક્રોલ કરો</translation>
<translation id="6367196786591004737">એન્ટ્રી ડિલીટ કરો</translation>
<translation id="6367396429435748845">માઉસ કી થોભાવવા અને ફરી શરૂ કરવા માટે <ph name="ALT" /> + <ph name="LAUNCHER" /> + <ph name="NUM_4" /> દબાવો</translation>
<translation id="6370551072524410110">search + shift + backspace</translation>
<translation id="6388429472088318283">ભાષાઓ શોધો</translation>
<translation id="6391131092053186625">તમારા ડિવાઇસનું IMEI <ph name="IMEI_NUMBER" /> છે. સેવા સક્રિય કરવામાં સહાય માટે આ નંબરનો ઉપયોગ થઈ શકે છે.</translation>
<translation id="6398715114293939307">Google Play Store દૂર કરો</translation>
<translation id="6399675241776343019">નકારવામાં આવ્યો છે</translation>
<translation id="6401118106417399952">તમારા ડિવાઇસનો EID <ph name="EID_NUMBER" /> અને ડિવાઇસનો અનુક્રમ નંબર <ph name="SERIAL_NUMBER" /> છે. સેવા સક્રિય કરવામાં સહાય માટે આ નંબરનો ઉપયોગ કરી શકાય છે.</translation>
<translation id="6405999530973682789">માઉસ કર્સર મળતું નથી</translation>
<translation id="6406506848690869874">સમન્વયન</translation>
<translation id="6410328738210026208">ચેનલ બદલો અને Powerwash કરો</translation>
<translation id="6411135999030237579">કીને ઑટોમેટિક રીતે રિપીટ કરવા માટે દબાવી રાખો</translation>
<translation id="6415757856498750027">"ư" મેળવવા માટે "w" ટાઇપ કરો</translation>
<translation id="6415900369006735853">તમારા ફોન મારફત ઇન્ટરનેટ સાથે કનેક્ટ કરો</translation>
<translation id="641817663353603351">page up</translation>
<translation id="641899100123938294">નવા ડિવાઇસ સ્કૅન કરો</translation>
<translation id="6425556984042222041">ટેક્સ્ટ ટૂ સ્પીચની ઝડપ</translation>
<translation id="6434104957329207050">પૉઇન્ટ સ્કૅન કરવાની ઝડપ</translation>
<translation id="6442445294758185945">અપડેટ ડાઉનલોડ કરી શકાઈ નથી. કૃપા કરીને થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="6444070574980481588">તારીખ અને સમય સેટ કરો</translation>
<translation id="6444147596556711162">સ્ક્રીન પર એક આઇટમથી બીજી પર જવા માટે, “આગળ” અને “પાછળ”નો ઉપયોગ કરો</translation>
<translation id="6452961788130242735">નેટવર્ક સમસ્યા અથવા અયોગ્ય ક્ષેત્ર</translation>
<translation id="6453921811609336127">આગલી ઇનપુટ પદ્ધતિ પર સ્વિચ કરવા માટે, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR1" /><ph name="BEGIN_SHIFT" />Shift<ph name="END_SHIFT" /><ph name="SEPARATOR2" /><ph name="BEGIN_SPACE" />Space<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> દબાવો</translation>
<translation id="6463488491707167747">આ શબ્દકોશ ડિલીટ કરો</translation>
<translation id="6463596731306859179">શું વણજોઈતા પૉપ-અપ કે અન્ય અનપેક્ષિત વર્તણૂક મેળવી રહ્યાં છો? કેટલીકવાર, તમે ઇન્સ્ટૉલ કરો છો તે ઍપ અને એક્સ્ટેન્શન તમારી જાણ વિના ChromeOSના તમારા સેટિંગ બદલી શકે છે.</translation>
<translation id="6467377768028664108">પછી તમારું <ph name="DEVICE_TYPE" /> આમ કરી શકશે:</translation>
<translation id="6469557521904094793">સેલ્યુલર નેટવર્ક ચાલુ કરો</translation>
<translation id="6470120577693311302">ફ્લૅશ નોટિફિકેશન</translation>
<translation id="6470823736074966819">નોટિફિકેશનને મ્યૂટ કરો</translation>
<translation id="6474498546677193336">કોઈ ઍપ્લિકેશન આ ફોલ્ડરનો ઉપયોગ કરી રહી હોવાને કારણે આને અનશેર કરી શકાતું નથી. જ્યારે આગલી વાર Linux શટ ડાઉન થશે, ત્યારે ફોલ્ડરને અનશેર કરવામાં આવશે.</translation>
<translation id="6474884162850599008">Google ડ્રાઇવ એકાઉન્ટ ડિસ્કનેક્ટ કરો</translation>
<translation id="6476482583633999078">સ્પીચની સ્પીડ</translation>
<translation id="6476671549211161535">તમારા <ph name="DEVICE_NAME" /> પર એ બટન દબાવો જે માઉસનું ડાબું કે જમણું બટન નથી.</translation>
<translation id="6477822444490674459">ઑફિસની પ્રોફાઇલમાંના ફોન માટે નોટિફિકેશન સિંક કરવાની સુવિધાને સપોર્ટ કરવામાં આવતો નથી. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="6481749622989211463">નજીકના ડિવાઇસ વડે ફાઇલો અને તેના જેવું બીજું ઘણું શેર કરો <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="648204537326351595"><ph name="SPECIFIC_NAME" />ને તમારા માઇક્રોફોનના ઍક્સેસની મંજૂરી આપો</translation>
<translation id="6482559668224714696">પૂર્ણ-સ્ક્રીન મૅગ્નિફાયર</translation>
<translation id="648927581764831596">કંઈપણ ઉપલબ્ધ નથી</translation>
<translation id="6497784818439587832">તમારી સ્ક્રીન પરની આઇટમને વધુ નાની અથવા વધુ મોટી કરવા માટે ડિસ્પ્લેનું કદ બદલો</translation>
<translation id="6497789971060331894">માઉસનું રિવર્સ સ્ક્રોલિંગ</translation>
<translation id="650185290742160385">મર્યાદા ઘટાડો</translation>
<translation id="650457560773015827">ડાબું બટન</translation>
<translation id="6504611359718185067">કોઈ પ્રિન્ટર ઉમેરવા માટે ઇન્ટરનેટથી કનેક્ટ કરો</translation>
<translation id="6514010653036109809">ઉપલબ્ધ ઉપકરણ:</translation>
<translation id="6517420300299531857">My-Driveની તમારી ફાઇલો તમારા Chromebook સાથે ઑટોમૅટિક રીતે સિંક થાય છે જેથી તમે તેને ઇન્ટરનેટ કનેક્શન વિના ઍક્સેસ કરી શકશો. આ લગભગ <ph name="REQUIRED_SPACE" /> વાપરશે. તમારી પાસે હાલમાં <ph name="FREE_SPACE_AVAILABLE" /> ઉપલબ્ધ છે.</translation>
<translation id="6517709704288360414">તમારું ડિવાઇસ હવે કદાચ યોગ્ય રીતે કામ કરશે નહીં અને તમે સુરક્ષા તથા પર્ફોર્મન્સ સંબંધિત સમસ્યાઓ અનુભવી શકો છો. અપડેટ કરો બંધ કરવાથી, જો તમને કોઈ સમસ્યા આવે તો કાનૂની દાવા કરવાના તમારા અધિકારને પણ અસર થઈ શકે છે.</translation>
<translation id="6518133107902771759">પ્રમાણિત કરો</translation>
<translation id="6520876759015997832">શોધ પરિણામ <ph name="LIST_SIZE" />માંથી <ph name="LIST_POSITION" />: <ph name="SEARCH_RESULT_TEXT" />. વિભાગ પર નૅવિગેટ કરવા માટે, Enter કી દબાવો.</translation>
<translation id="6527574156657772563">કોઈ ડિવાઇસ ઉપલબ્ધ નથી. તમારા Google એકાઉન્ટને આ <ph name="DEVICE_TYPE" /> સાથે કનેક્ટ કરવા માટે તમારા ફોનમાં ઉમેરો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="6532663472409656417">એન્ટરપ્રાઇઝ દ્વારા નોંધણી કરાયેલું</translation>
<translation id="65334502113648172">ડિસ્પ્લેના વિસ્તારને નાનો કે મોટો કરવા માટે, ઍરો કી દબાવો. ડિસ્પ્લેના વિસ્તારને આસપાસ ખસેડવા માટે shift અને + દબાવો, પછી ઍરો કીનો ઉપયોગ કરો.</translation>
<translation id="653659894138286600">દસ્તાવેજો અને છબીઓ સ્કૅન કરો</translation>
<translation id="6538036594527795020"><ph name="APP" />ની ભાષા બદલો. હાલની ભાષા <ph name="LANGUAGE" /> છે.</translation>
<translation id="654219396498297850">જ્યારે માઉસનું ડાબું બટન પસંદ કર્યુ હોય, ત્યારે બે વાર ક્લિક કરવા માટે “v”નો ઉપયોગ કરો</translation>
<translation id="6544134392255015460">કીબોર્ડની બૅકલાઇટ માટે ટૉગલ કી</translation>
<translation id="6545665334409411530">પુનરાવર્તન રેટ</translation>
