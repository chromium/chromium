<translation id="116896278675803795">Автоматична промяна на езика, за да съответства на избраното съдържание</translation>
<translation id="1173894706177603556">Преименуване</translation>
<translation id="1175572348579024023">Превъртане</translation>
<translation id="1175914831232945926">Цифри</translation>
<translation id="1177863135347784049">По избор</translation>
<translation id="1182876754474670069">home</translation>
