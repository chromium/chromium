<translation id="184183613002882946">לא, מספיק לי מתג אחד</translation>
<translation id="1842681835432895345">לא לכלול את המסך הזה במצב השתקפות במראה</translation>
<translation id="1864400682872660285">קריר יותר</translation>
<translation id="1877860345998737529">הקצאת מתגים לפעולות</translation>
<translation id="1878885068166344708">‏הפריט מודגש כשמזיזים את המיקוד. כדי לשנות את המיקוד, מקישים על Tab או בוחרים פריט.</translation>
<translation id="1881445033931614352">פריסת המקלדת</translation>
<translation id="1907044622262489040">‏שימוש בהקלדה קולית. מקישים על מקש החיפוש + D ומתחילים לדבר.</translation>
<translation id="1923539912171292317">לחיצות אוטומטיות</translation>
<translation id="1926887872692564784">סמן</translation>
<translation id="1938351510777341717">‏מקש Command חיצוני</translation>
<translation id="1951012854035635156">Assistant</translation>
<translation id="1966649499058910679">הדגשה של כל מילה בזמן שהיא נאמרת</translation>
<translation id="1969011864782743497">‏<ph name="DEVICE_NAME" />‏ (USB)</translation>
<translation id="1973886230221301399">ChromeVox</translation>
<translation id="1974060860693918893">מתקדם</translation>
<translation id="1974159333077206889">אותו אודיו בכל הרמקולים</translation>
<translation id="1988733631391393183">‏בתפריטי ChromeVox יוצגו פקודות בכתב ברייל</translation>
<translation id="1999763610967697511">גרירה ושחרור</translation>
<translation id="2003596238737586336">התזמון הנוכחי מוגדר לשעות <ph name="SUNRISE" /> עד <ph name="SUNSET" />. ההגדרה הזו מנוהלת על-ידי האדמין.</translation>
<translation id="2025123106058020990">לחיצה מדויקת</translation>
<translation id="2026377162111110983">פיזור הקול באזור</translation>
<translation id="2030455719695904263">משטח מגע</translation>
<translation id="2045838962742066664">הקלדה מקוצרת</translation>
<translation id="2066700471214517561">‏מיקרופון בטכנולוגיית אלומה כדי שהקול של המשתמש ב-Chromebook ישמע בצורה ברורה.</translation>
<translation id="2079545284768500474">ביטול הפעולה</translation>
<translation id="2088564884469682888">‏TrackPoint מובנה</translation>
<translation id="2091523941449737894">תנועות מהירות יותר על לוח המגע יזיזו את הסמן רחוק יותר</translation>
<translation id="2091887806945687916">צליל</translation>
<translation id="2135456203358955318">מגדיל במצב מעוגן</translation>
<translation id="2143915448548023856">הגדרות תצוגה</translation>
<translation id="2147282432401652483">‏מקש Command</translation>
<translation id="2148212683005708350"><ph name="MODIFIER_ONE" /> + <ph name="MODIFIER_TWO" /> + <ph name="MODIFIER_THREE" /> + <ph name="KEY" /></translation>
<translation id="2155772377859296191">‏נראה כמו <ph name="WIDTH" /> x <ph name="HEIGHT" /></translation>
<translation id="2157457598652721267">משתמשים במקשים "/" ו-"-" כדי לבחור את הכפתור השמאלי או הימני בעכבר. משתמשים ב-“*” כדי לבחור את שניהם.</translation>
<translation id="2158249272743343757">מתבצעת מחיקה של נתוני ההתאמה האישית…</translation>
<translation id="2164131635608782358"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" />, <ph name="THIRD_SWITCH" /> ועוד מתג אחד</translation>
<translation id="2165177462441582039">יש לבחור את משך הזמן שבו ההדגשה תוצב על פריט כלשהו</translation>
<translation id="2175526076681939329">שימוש במקלדת הראשית</translation>
<translation id="2218019600945559112">עכבר ולוח מגע</translation>
<translation id="2221261048068091179"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" /></translation>
