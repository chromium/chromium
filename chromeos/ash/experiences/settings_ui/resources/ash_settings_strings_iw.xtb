<translation id="1583127975413389276">העיבוד של <ph name="LANGUAGE" /> נעשה באופן מקומי ונשאר בזיכרון המכשיר</translation>
<translation id="15916883652754430">הגדרות הקול של המערכת</translation>
<translation id="1594781465361405478">הפעלה או השבתה של הצליל</translation>
<translation id="1597806446183714225">שיפור איכות האודיו כדי שהקולות יישמעו טבעיים וברורים.</translation>
<translation id="1605148987885002237">מקלדת וקלט</translation>
<translation id="161042844686301425">ציאן</translation>
<translation id="1611649489706141841">קדימה</translation>
<translation id="1618102204889321535"><ph name="MAX_CHARACTER_COUNT" />/<ph name="CURRENT_CHARACTER_COUNT" /></translation>
<translation id="1623723619460186680">הפחתה של פליטת אור כחול</translation>
<translation id="1631503405579357839">עיוורון צבעים</translation>
<translation id="1632278969378690607">חיפוש + לחיצה</translation>
<translation id="163309982320328737">רוחב התו הראשוני הוא מלא</translation>
<translation id="1647986356840967552">לדף הקודם</translation>
<translation id="1648439345221797326">‏Ctrl ‏+ Shift +‏ <ph name="TOP_ROW_KEY" /></translation>
<translation id="1667842670298352129">‏האזנה להקראת טקסט ספציפי. קודם לוחצים על סמל ההקראה בתחתית המסך ואז מדגישים את הטקסט. אפשר גם להשתמש במקשי הקיצור: מדגישים טקסט ומקישים על מקש החיפוש + S.</translation>
<translation id="167997285881077031">‏הגדרות קול של המרת טקסט לדיבור (TTS)</translation>
<translation id="1682696837763999627">סמן עכבר גדול</translation>
<translation id="1686550358074589746">הפעלה של הקלדה בהחלקה</translation>
<translation id="1698899521169711967">דפדוף עם סמן טקסט</translation>
