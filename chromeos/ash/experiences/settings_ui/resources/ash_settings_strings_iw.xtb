<translation id="2243934210752059021">‏מקש החיפוש + Alt +‏ <ph name="TOP_ROW_KEY" /></translation>
<translation id="2245603955208828424">שימוש במקשי החיצים כדי לעבור על פריטים, אות אחרי אות</translation>
<translation id="2247870315273396641">תצוגה מקדימה של הקול</translation>
<translation id="2250153645770828940">מחיקת המילון</translation>
<translation id="22505994009453896">איך לשלוט בסמן העכבר באמצעות מקלדת נומרית</translation>
<translation id="2262477216570151239">השהיה לפני חזרה</translation>
<translation id="2263371730707937087">קצב הרענון של המסך</translation>
<translation id="2270666014403455717">הקצאת מתג לפעולה "בחירה"</translation>
<translation id="2272430695183451567">הוקצו אפס מתגים</translation>
