<translation id="1076882167394279216">לא ניתן היה להוריד מילון בדיקת איות ב<ph name="LANGUAGE" />. יש לנסות שוב.</translation>
<translation id="1078037449555275327">‏הגדרות ChromeVox</translation>
<translation id="1085618740036066768">‫<ph name="ITEM" /> לא נבחר. ‫<ph name="INDEX" /> מתוך <ph name="COUNT" />. כדי לבחור, יש ללחוץ על 'חיפוש' ועל מקש הרווח.</translation>
<translation id="1093645050124056515">‏Ctrl +‏ Alt + חץ למטה</translation>
<translation id="1106350001632362876">הגדלת הסף</translation>
<translation id="1110965959145884739">צריך לבחור את השפות שרוצים להגדיר במכשיר הזה. קובצי השפה משותפים עם משתמשים כדי לחסוך מקום בכונן. <ph name="BEGIN_LINK_LEARN_MORE" />מידע נוסף<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="1114202307280046356">יהלום</translation>
<translation id="1125550662859510761">‏נראה כמו <ph name="WIDTH" /> x <ph name="HEIGHT" /> (במקור)</translation>
<translation id="1133751489735776037">לחיצה משולשת בעכבר</translation>
<translation id="114036956334641753">אודיו וכתוביות</translation>
<translation id="114715166554490743">שליטה באמצעות תנועות הראש</translation>
<translation id="1148624853678088576">הכל מוכן!</translation>
<translation id="1149483087970735785">טכנולוגיה מסייעת</translation>
<translation id="1160800016654917722">החלון הועבר למטה ושמאלה</translation>
<translation id="1164015913575846413">‏Alt + לחיצה</translation>
<translation id="1165039591588034296">שגיאה</translation>
<translation id="116896278675803795">שינוי השפה באופן אוטומטי כך שתתאים לתוכן הנבחר</translation>
<translation id="1173894706177603556">שינוי שם</translation>
<translation id="1175572348579024023">גלילה</translation>
<translation id="1175914831232945926">ספרות</translation>
<translation id="1177863135347784049">מותאם אישית</translation>
<translation id="1182876754474670069">‏מקש Home</translation>
<translation id="1190155014618058972">יצירת שילוב מקשים מותאם אישית</translation>
<translation id="1197088940767939838">כתום</translation>
<translation id="1198066799963193307">כלי דיבור ללקויי ראייה</translation>
<translation id="1201402288615127009">הבא</translation>
<translation id="1208392090861059168">התזמון הנוכחי מוגדר לשעות <ph name="SUNRISE" /> עד <ph name="SUNSET" />. כדי לעדכן את זמני השקיעה והזריחה אוטומטית, צריך <ph name="BEGIN_LINK" />להפעיל את הגישה למיקום בהגדרות המערכת<ph name="END_LINK" />.</translation>
<translation id="1217668622537098248">חזרה ללחיצה שמאלית אחרי פעולה</translation>
<translation id="1237950098253310325">‏לשינוי המיקום של <ph name="BUTTON_NAME" />, מקישים על Ctrl ועל החץ למעלה או החץ למטה</translation>
<translation id="124116460088058876">שפות נוספות</translation>
<translation id="1247372569136754018">מיקרופון (פנימי)</translation>
<translation id="1261380933454402672">מתון</translation>
<translation id="1263733306853729545">מעבר בין העמודים של רשימת התווים האפשריים באמצעות המקש <ph name="MINUS" /> והמקש <ph name="EQUAL" /></translation>
<translation id="1264956950255940376">מצמצמים את העין השמאלית</translation>
<translation id="126768002343224824">16x</translation>
<translation id="1275936815032730048">מרכז האפליקציות + חץ ימינה</translation>
<translation id="1288037062697528143">תאורת הלילה תידלק באופן אוטומטי בשעת השקיעה</translation>
<translation id="1288300545283011870">תכונות דיבור</translation>
<translation id="1291057703584594733">אם בוחרים בתנועה שכבר הוקצתה, היא תוסר מהפעולה המקורית.</translation>
<translation id="1291421198328146277">איפוס המקשים</translation>
<translation id="1293360286536751243">יכול להיות שהתנועה '<ph name="MAIN_GESTURE" />' חופפת לתנועות '<ph name="CONFLICTING_GESTURE_ONE" />', '<ph name="CONFLICTING_GESTURE_TWO" />' ו'<ph name="CONFLICTING_GESTURE_THREE" />'. אם אפשר, כדאי לבחור תנועה אחרת.</translation>
<translation id="131364520783682672">Caps Lock</translation>
<translation id="132539964543492755">‏משתמשים במקש X כדי לשנות את הבחירה בין הכפתור השמאלי והכפתור הימני בעכבר, ושל שני הכפתורים ביחד</translation>
<translation id="1328928545650070438">מנמיכים את הגבות</translation>
<translation id="13392265090583506">נגישות</translation>
<translation id="1346748346194534595">ימינה</translation>
<translation id="1348966090521113558">ההגדרות בנושא נגישות של העכבר</translation>
<translation id="135389172849514421">פועלת אופליין</translation>
<translation id="1365650529628379165">מרימים את הגבות</translation>
<translation id="1381567580865186407">‏הדיבור ב<ph name="LANGUAGE" /> נשלח אל Google לעיבוד.</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="1392047138650695757">המילונים של המשתמש</translation>
<translation id="1395832189806039783">הדגשה של פריט באמצעות מיקוד המקלדת</translation>
<translation id="1427179946227469514">‏גובה הקול של המרת טקסט לדיבור (TTS)</translation>
<translation id="1438630805136563416">הפעולה <ph name="REMOVED_ACTION" /> הוסרה</translation>
<translation id="1445330076053050041">צריך לבחור פעולה למקש <ph name="KEY_NAME" /></translation>
<translation id="1449191289887455076">צריך להקיש שוב על "<ph name="CURRENTKEY" />" כדי לאשר את ההקצאה ו<ph name="RESPONSE" /></translation>
<translation id="145432137617179457">שפות שבהן בדיקת האיות זמינה</translation>
<translation id="1467432559032391204">שמאלה</translation>
<translation id="1480663089572535854">יש לך אפשרות לחזור ולשנות את ההקצאה לפעולה "בחירה". תמיד תהיה לך אפשרות להשבית את הסריקה האוטומטית ב'הגדרות'.</translation>
<translation id="1484102317210609525"><ph name="DEVICE_NAME" /> (HDMI/DP)</translation>
<translation id="1486458761710757218">כוונון אוטומטי של בהירות התאורה האחורית במקלדת</translation>
<translation id="1498498210836053409">השבתת ההקשה ביד אחת במהלך עריכת טקסט (הקשה חכמה ביד אחת)</translation>
<translation id="1499041187027566160">הגברת עוצמת הקול</translation>
<translation id="1506187449813838456">הגברת גובה הצליל</translation>
<translation id="1510238584712386396">מרכז האפליקציות</translation>
<translation id="1523978563989812243">‏מנוע המרת טקסט לדיבור (TTS)</translation>
<translation id="1527336312600375509">קצב הרענון של הצג</translation>
<translation id="1531734061664070992"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" /> <ph name="THIRD_SWITCH" /></translation>
<translation id="1535228823998016251">גבוהה</translation>
<translation id="1535753739390684432">האזנה להקראת טקסט ספציפי. קודם לוחצים על סמל ההקראה בתחתית המסך ואז מדגישים את הטקסט.</translation>
<translation id="1537254971476575106">מגדיל למסך מלא</translation>
<translation id="1554640914375980459">המסך יהבהב כשיתקבלו התראות. אם יש לכם רגישות לאור, לא בטוח שהתכונה הזאת מתאימה לכם.</translation>
<translation id="1555130319947370107">כחול</translation>
<translation id="155803912725350982">מקשים איטיים</translation>
<translation id="155865706765934889">לוח מגע</translation>
