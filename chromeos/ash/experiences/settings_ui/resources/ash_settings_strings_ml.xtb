<translation id="9068598199622656904">കീബോഡ് കുറുക്കുവഴികൾക്ക്, ഒരേ സമയം കീകൾ അമർത്തിപ്പിടിക്കുന്നതിന് പകരം ഒരു കീ അമർത്തുക</translation>
<translation id="9074739597929991885">Bluetooth</translation>
<translation id="9089416786594320554">ഇൻപുട്ട്  രീതികൾ</translation>
<translation id="9096053102600371572">നിയന്ത്രിത സ്ക്രോളിംഗ് <ph name="LINK_BEGIN" />കൂടുതലറിയുക<ph name="LINK_END" /></translation>
<translation id="9100416672768993722">അവസാനം ഉപയോഗിച്ച ഇൻപുട്ട് രീതിയിലേക്ക് മാറാൻ, <ph name="BEGIN_SHORTCUT" /><ph name="BEGIN_CTRL" />Ctrl<ph name="END_CTRL" /><ph name="SEPARATOR" /><ph name="BEGIN_SPACE" />Space<ph name="END_SPACE" /><ph name="END_SHORTCUT" /> അമർത്തുക</translation>
<translation id="9111330022786356709">നിങ്ങളുടെ മൗസിൽ ബട്ടണുകൾ ചേർക്കുക അല്ലെങ്കിൽ കണ്ടെത്തുക</translation>
<translation id="9116799625073598554">കുറിപ്പ് രേഖപ്പെടുത്താനുള്ള ആപ്പ്</translation>
<translation id="9126149354162942022">കഴ്‌സറിന്റെ നിറം</translation>
<translation id="9128335130883257666"><ph name="INPUT_METHOD_NAME" /> എന്നതിനുള്ള ക്രമീകരണ പേജ് തുറക്കുക</translation>
<translation id="9148058034647219655">പുറത്തുകടക്കുക</translation>
<translation id="9151249085738989067">ഭാഷ അടിസ്ഥാനമാക്കി ChromeVox ശബ്‌ദം സ്വയമേവ സ്വിച്ച് ചെയ്യുക</translation>
<translation id="9151906066336345901">end</translation>
<translation id="9153451439615847952">അറിയിപ്പുകൾക്കും മുന്നറിയിപ്പുകൾക്കുമുള്ള പശ്ചാത്തല ഓഡിയോ കുറയ്ക്കുക</translation>
<translation id="915485121129452731">പെൻ ടാബ്‌ലെറ്റ്</translation>
<translation id="9157096865782046368">0.8 സെക്കൻഡ്</translation>
<translation id="9169496697824289689">കീബോർഡ് കുറുക്കുവഴികൾ കാണുക</translation>
<translation id="9187967020623675250">കീകൾ പൊരുത്തപ്പെടുന്നില്ല. <ph name="RESPONSE" /> ചെയ്യാൻ ഏതെങ്കിലും കീ അമർത്തുക.</translation>
<translation id="9192019773545828776">സംഭാഷണ ഫീഡ്‌ബാക്ക് കേൾക്കുക, അതുവഴി നിങ്ങൾക്ക് സ്‌ക്രീനിൽ നോക്കാതെ ഉപകരണം ഉപയോഗിക്കാം. കണക്‌റ്റ് ചെയ്‌ത ഉപകരണത്തിൽ ബ്രെയ്‌ലി ഫീഡ്ബാക്ക് ലഭ്യമാണ്. ChromeVox ഓണാക്കാനും ഓഫാക്കാനും Ctrl + Alt + Z ഉപയോഗിക്കുക. നാവിഗേറ്റ് ചെയ്യാൻ, Search + ഇടത്തേയ്ക്കുള്ള അമ്പടയാളം അല്ലെങ്കിൽ വലത്തേയ്ക്കുള്ള അമ്പടയാളം ഉപയോഗിക്കുക. തിരഞ്ഞെടുക്കാൻ Search + Space ഉപയോഗിക്കുക (സജീവമാക്കുക).</translation>
<translation id="9203296457393252944">ചുവപ്പ്-പച്ച, പച്ച വ്യക്തമല്ല (ഡ്യൂറ്ററനോമലി)</translation>
<translation id="9205304506427975617">നിങ്ങൾ ചെറുതായി തല അനക്കുകയാണെങ്കിലും കഴ്‌സർ സ്ഥിരതയോടെ നിലനിർത്താം. ഇങ്ങനെ ചെയ്യുമ്പോൾ കഴ്‌സർ നീക്കാൻ കൂടുതൽ പരിശ്രമം ആവശ്യമാണ്.</translation>
<translation id="930551443325541578">കീകൾ ആവർത്തിക്കലും ആക്‌സന്റ് അടയാളങ്ങളും</translation>
