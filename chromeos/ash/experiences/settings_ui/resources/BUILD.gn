import("//build/config/chrome_build.gni")
import("//tools/grit/grit_rule.gni")

assert(is_chromeos, "Non ChromeOS builds must not depend on //chromeos/ash")

grit_strings("strings") {
  source = "ash_settings_strings.grd"
  defines = [ "is_chrome_branded=$is_chrome_branded" ]
  outputs = [ "grit/ash_settings_strings.h" ]
  output_prefix = "ash_settings_strings_"
}
