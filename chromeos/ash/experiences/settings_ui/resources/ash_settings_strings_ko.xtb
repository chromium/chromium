<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="1011355516189274711">텍스트 음성 변환 볼륨</translation>
<translation id="1015041505466489552">TrackPoint</translation>
<translation id="1029526375103058355">탭하여 클릭</translation>
<translation id="1038643060055067718">행 수:</translation>
<translation id="104385770822424034">작업 추가</translation>
<translation id="1046572983040892965">창이 왼쪽 위로 이동함</translation>
<translation id="1053226848101751430">항목이 삭제되었습니다</translation>
<translation id="1076882167394279216"><ph name="LANGUAGE" /> 맞춤법 검사 사전을 다운로드할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="1078037449555275327">ChromeVox 설정</translation>
<translation id="1085618740036066768"><ph name="ITEM" /> 항목이 선택되지 않았습니다. <ph name="INDEX" />/<ph name="COUNT" />. Search와 Space 키를 눌러 선택하세요.</translation>
<translation id="1093645050124056515">Ctrl + Alt + 아래쪽 화살표</translation>
<translation id="1106350001632362876">기준 높이기</translation>
<translation id="1110965959145884739">이 기기에 설치할 언어를 선택하세요. 디스크 공간 절약을 위해 언어 파일은 사용자 간에 공유됩니다. <ph name="BEGIN_LINK_LEARN_MORE" />자세히 알아보기<ph name="END_LINK_LEARN_MORE" /></translation>
<translation id="1114202307280046356">다이아몬드</translation>
<translation id="1125550662859510761"><ph name="WIDTH" />x<ph name="HEIGHT" />(기본)처럼 보입니다.</translation>
<translation id="1133751489735776037">마우스 세 번 클릭</translation>
<translation id="114036956334641753">오디오 및 자막</translation>
<translation id="114715166554490743">헤드 포인터</translation>
<translation id="1148624853678088576">모든 설정이 완료되었습니다.</translation>
<translation id="1149483087970735785">보조 기술</translation>
<translation id="1160800016654917722">창을 왼쪽 아래로 이동함</translation>
<translation id="1164015913575846413">Alt + 클릭</translation>
<translation id="1165039591588034296">오류</translation>
<translation id="116896278675803795">선택한 콘텐츠와 일치하도록 언어를 자동으로 변경합니다.</translation>
<translation id="1173894706177603556">이름 바꾸기</translation>
<translation id="1175572348579024023">스크롤</translation>
<translation id="1175914831232945926">숫자</translation>
<translation id="1177863135347784049">맞춤설정</translation>
<translation id="1182876754474670069">Home</translation>
<translation id="1190155014618058972">맞춤 키 조합 만들기</translation>
<translation id="1197088940767939838">주황색</translation>
<translation id="1198066799963193307">저시력 음성 도구</translation>
<translation id="1201402288615127009">다음</translation>
<translation id="1208392090861059168">현재 일정은 <ph name="SUNRISE" />~<ph name="SUNSET" />(으)로 설정되어 있습니다. 일몰 및 일출 일정을 자동으로 업데이트하려면 <ph name="BEGIN_LINK" />시스템 위치 액세스를 사용 설정<ph name="END_LINK" />하세요.</translation>
<translation id="1217668622537098248">작업 후 왼쪽 클릭으로 되돌리기</translation>
<translation id="1237950098253310325">Ctrl과 위쪽 또는 아래쪽 화살표를 사용하여 <ph name="BUTTON_NAME" />의 순서 변경</translation>
<translation id="124116460088058876">다른 언어</translation>
<translation id="1247372569136754018">마이크(내부)</translation>
<translation id="1261380933454402672">약한 규칙</translation>
<translation id="1263733306853729545"><ph name="MINUS" /> 및 <ph name="EQUAL" /> 키를 사용하여 후보 목록을 페이지에 표시</translation>
<translation id="1264956950255940376">왼쪽 눈 찡그리기</translation>
<translation id="126768002343224824">16배</translation>
<translation id="1275936815032730048">런처 + 오른쪽 화살표</translation>
<translation id="1288037062697528143">일몰 시 야간 조명이 자동으로 켜짐</translation>
<translation id="1288300545283011870">음성 속성</translation>
<translation id="1291057703584594733">이미 할당된 동작을 선택하면 원래 작업에서 동작이 삭제됩니다.</translation>
<translation id="1291421198328146277">키 재설정</translation>
<translation id="1293360286536751243">"<ph name="MAIN_GESTURE" />" 동작이 "<ph name="CONFLICTING_GESTURE_ONE" />", "<ph name="CONFLICTING_GESTURE_TWO" />", "<ph name="CONFLICTING_GESTURE_THREE" />" 동작과 겹칠 수 있습니다. 가능하다면 다른 동작을 선택해 보세요.</translation>
<translation id="131364520783682672">Caps Lock</translation>
<translation id="132539964543492755">마우스 버튼 선택을 왼쪽 버튼, 오른쪽 버튼, 둘 다로 변경하려면 'x' 키를 사용하세요.</translation>
<translation id="1328928545650070438">눈썹 내리기</translation>
<translation id="13392265090583506">접근성</translation>
<translation id="1346748346194534595">오른쪽</translation>
<translation id="1348966090521113558">마우스 접근성 설정</translation>
<translation id="135389172849514421">오프라인에서 사용 가능</translation>
<translation id="1365650529628379165">눈썹 올리기</translation>
<translation id="1381567580865186407">처리를 위해 <ph name="LANGUAGE" /> 음성이 Google로 전송됩니다.</translation>
<translation id="1383876407941801731">검색</translation>
<translation id="1392047138650695757">사용자 사전</translation>
<translation id="1395832189806039783">키보드 포커스로 항목 강조표시</translation>
<translation id="1427179946227469514">텍스트 음성 변환 음조</translation>
<translation id="1438630805136563416"><ph name="REMOVED_ACTION" /> 작업이 삭제되었습니다</translation>
<translation id="1445330076053050041"><ph name="KEY_NAME" /> 키에 대한 작업 선택</translation>
<translation id="1449191289887455076">할당을 확인하고 <ph name="RESPONSE" />하려면 “<ph name="CURRENTKEY" />” 키를 다시 누르세요.</translation>
<translation id="145432137617179457">맞춤법 검사 언어</translation>
<translation id="1467432559032391204">왼쪽</translation>
<translation id="1480663089572535854">돌아가서 '선택'에 할당된 항목을 변경할 수 있습니다. 설정에서 언제든지 자동 스캔을 사용 중지할 수 있습니다.</translation>
<translation id="1484102317210609525"><ph name="DEVICE_NAME" />(HDMI/DP)</translation>
<translation id="1486458761710757218">키보드 백라이트 밝기 자동 조정</translation>
<translation id="1498498210836053409">텍스트 수정 시 고정 모드 사용 중지(스마트 고정 모드)</translation>
<translation id="1499041187027566160">볼륨 크게</translation>
<translation id="1506187449813838456">음조 높임</translation>
<translation id="1510238584712386396">런처</translation>
<translation id="1523978563989812243">텍스트 음성 변환 엔진</translation>
<translation id="1527336312600375509">모니터 새로고침 빈도</translation>
<translation id="1531734061664070992"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" />, <ph name="THIRD_SWITCH" /></translation>
<translation id="1535228823998016251">크게</translation>
<translation id="1535753739390684432">특정 텍스트를 소리 내어 읽어줍니다. 먼저 화면 하단에 있는 텍스트 읽어주기 아이콘을 선택한 다음 텍스트를 강조표시하세요.</translation>
<translation id="1537254971476575106">전체화면 돋보기</translation>
<translation id="1554640914375980459">알림 수신 시 화면을 깜빡입니다. 빛에 민감한 경우 플래시 알림을 주의해서 사용하세요.</translation>
<translation id="1555130319947370107">파란색</translation>
<translation id="155803912725350982">느린 키</translation>
<translation id="155865706765934889">터치패드</translation>
<translation id="156793199942386351">'<ph name="CURRENTKEY" />' 키는 이미 '<ph name="ACTION" />' 작업에 할당되었습니다. <ph name="RESPONSE" />하려면 아무 키나 누르세요.</translation>
<translation id="1583127975413389276"><ph name="LANGUAGE" />는 로컬에서 처리되고 오프라인에서 작동합니다</translation>
<translation id="15916883652754430">시스템 음성 설정</translation>
<translation id="1594781465361405478">볼륨 켜기/끄기</translation>
<translation id="1597806446183714225">음질을 개선하여 음성이 자연스럽고 또렷하게 들리도록 합니다.</translation>
<translation id="1605148987885002237">키보드 및 입력</translation>
<translation id="161042844686301425">청록색</translation>
<translation id="1611649489706141841">앞으로</translation>
<translation id="1618102204889321535"><ph name="CURRENT_CHARACTER_COUNT" />/<ph name="MAX_CHARACTER_COUNT" /></translation>
<translation id="1623723619460186680">블루라이트 줄이기</translation>
<translation id="1631503405579357839">색맹</translation>
<translation id="1632278969378690607">검색 + 클릭</translation>
<translation id="163309982320328737">초기 글자 폭을 최대로 설정</translation>
<translation id="1647986356840967552">이전 페이지</translation>
<translation id="1648439345221797326">Ctrl + Shift + <ph name="TOP_ROW_KEY" /></translation>
<translation id="1667842670298352129">특정 텍스트를 소리 내어 읽어줍니다. 먼저 화면 하단에 있는 텍스트 읽어주기 아이콘을 선택한 다음 텍스트를 강조 표시하세요. 키보드 단축키를 사용할 수도 있습니다. 텍스트를 강조 표시한 다음 검색 + S를 누르세요.</translation>
<translation id="167997285881077031">텍스트 음성 변환 음성 설정</translation>
<translation id="1682696837763999627">큰 마우스 커서</translation>
<translation id="1686550358074589746">글라이드 타이핑 사용</translation>
<translation id="1698899521169711967">캐럿 브라우징</translation>
<translation id="17081583771848899">런처 + Alt + <ph name="TOP_ROW_KEY" /></translation>
<translation id="1709106626015023981"><ph name="WIDTH" />x<ph name="HEIGHT" />(기본)</translation>
<translation id="1714644264617423774">기기를 더 편하게 이용하기 위한 접근성 기능을 사용 설정합니다. <ph name="LINK_BEGIN" />자세히 알아보기<ph name="LINK_END" /></translation>
<translation id="1724801751621173132">입력 모드</translation>
<translation id="1755601632425835748">텍스트 크기</translation>
<translation id="1761402971842586829"><ph name="BUTTON_NAME" /> 버튼이 <ph name="REMAPPING_OPTION" />에 다시 매핑되었습니다.</translation>
<translation id="1767508543310534319">구두점 에코</translation>
<translation id="177814385589420211">검색 키를 길게 눌러 기능 키와 시스템 맨 위 키 간에 전환</translation>
<translation id="1781164264587898620">주변 소음 제거 및 오디오 개선을 적용합니다.</translation>
<translation id="1781553166608855614">음성 언어</translation>
<translation id="1792619191750875668">확장 디스플레이</translation>
<translation id="1795438342141780114">중앙으로 커서 재설정</translation>
<translation id="180203835522132923">검색 + O를 누른 후 W</translation>
<translation id="1808805149659872686">새 항목</translation>
<translation id="1816036116994822943">키보드 검색 속도</translation>
<translation id="1822517323280215012">회색</translation>
<translation id="1838374766361614909">검색어 지우기</translation>
<translation id="184183613002882946">아니요, 스위치 1개만 사용</translation>
<translation id="1842681835432895345">거울 모드에서 이 디스플레이 제외</translation>
<translation id="1864400682872660285">시원함</translation>
<translation id="1877860345998737529">스위치 작업 할당</translation>
<translation id="1878885068166344708">포커스를 이동하면 항목이 강조표시됩니다. 포커스를 변경하려면 Tab 키를 누르거나 항목을 선택하세요</translation>
<translation id="1881445033931614352">키보드 레이아웃</translation>
<translation id="1907044622262489040">음성으로 입력할 수 있습니다. 검색 + D를 사용한 다음 말하세요.</translation>
<translation id="1923539912171292317">자동 클릭</translation>
<translation id="1926887872692564784">커서</translation>
<translation id="1938351510777341717">외부 명령어</translation>
<translation id="1951012854035635156">어시스턴트</translation>
<translation id="1966649499058910679">각 단어를 읽을 때 강조 표시
</translation>
<translation id="1969011864782743497"><ph name="DEVICE_NAME" />(USB)</translation>
<translation id="1973886230221301399">ChromeVox</translation>
<translation id="1974060860693918893">고급</translation>
<translation id="1974159333077206889">모든 스피커에서 동일한 오디오</translation>
<translation id="1988733631391393183">ChromeVox 메뉴에 점자 명령어 표시</translation>
<translation id="1999763610967697511">드래그 앤 드롭</translation>
<translation id="2003596238737586336">현재 일정은 <ph name="SUNRISE" />~<ph name="SUNSET" />(으)로 설정되어 있습니다. 관리자가 관리하는 설정입니다.</translation>
<translation id="2025123106058020990">정밀 클릭</translation>
<translation id="2026377162111110983">영역 음성</translation>
<translation id="2030455719695904263">트랙패드</translation>
<translation id="2045838962742066664">약식 입력</translation>
<translation id="2066700471214517561">빔포밍 마이크로 Chromebook 사용자의 목소리가 선명하게 전달됩니다.</translation>
<translation id="2079545284768500474">실행취소</translation>
<translation id="2088564884469682888">내장 TrackPoint</translation>
<translation id="2091523941449737894">터치패드에서 더 빠르게 움직이면 커서가 더 멀리 이동합니다.</translation>
<translation id="2091887806945687916">소리</translation>
<translation id="2135456203358955318">고정 돋보기</translation>
<translation id="2143915448548023856">디스플레이 설정</translation>
<translation id="2147282432401652483">Command</translation>
<translation id="2148212683005708350"><ph name="MODIFIER_ONE" /> + <ph name="MODIFIER_TWO" /> + <ph name="MODIFIER_THREE" /> + <ph name="KEY" /></translation>
<translation id="2155772377859296191"><ph name="WIDTH" />x<ph name="HEIGHT" />처럼 보입니다.</translation>
<translation id="2157457598652721267">왼쪽 또는 오른쪽 마우스 버튼을 선택하려면 '/' 및 '-' 키를 사용하세요. 둘 다 선택하려면 '*' 키를 사용하세요.</translation>
<translation id="2158249272743343757">맞춤설정 데이터 삭제…</translation>
<translation id="2164131635608782358"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" />, <ph name="THIRD_SWITCH" /> 외 1개</translation>
<translation id="2165177462441582039">강조표시가 각 항목에 유지되는 시간 선택</translation>
<translation id="2175526076681939329">기본 키 사용</translation>
<translation id="2218019600945559112">마우스 및 터치패드</translation>
<translation id="2221261048068091179"><ph name="FIRST_SWITCH" />, <ph name="SECOND_SWITCH" /></translation>
<translation id="2234208862050358325">커서를 이동하려면 1, 2, 3, q, e, a, s, d 키를 사용하세요.</translation>
<translation id="2243934210752059021">검색 + Alt + <ph name="TOP_ROW_KEY" /></translation>
<translation id="2245603955208828424">화살표 키를 사용하여 글자 단위로 항목을 이동하세요</translation>
<translation id="2247870315273396641">음성 미리보기</translation>
<translation id="2250153645770828940">사전 삭제</translation>
<translation id="22505994009453896">숫자 키패드로 마우스 커서 제어하기</translation>
<translation id="2262477216570151239">반복 전 지연</translation>
<translation id="2263371730707937087">화면 새로고침 빈도</translation>
<translation id="2270666014403455717">'선택'에 스위치 할당</translation>
<translation id="2272430695183451567">스위치 0개 할당됨</translation>
<translation id="228059581448666199">마우스 왼쪽 버튼으로 클릭</translation>
<translation id="2290615375132886363">태블릿 탐색 버튼</translation>
<translation id="2310923358723722542">디스플레이 및 확대</translation>
<translation id="2319459402137712349">키보드를 열려면 텍스트 입력란을 선택합니다. 화면 하단에서 키보드 아이콘을 선택할 수도 있습니다.</translation>
<translation id="2373499590298659902">마우스 버튼을 길게 누르려면 '0' 키를 사용하세요.</translation>
<translation id="2376056713414548745">소리내어 읽기</translation>
<translation id="2382368170666222719">내장 터치패드 사용 중지</translation>
<translation id="2383825469508278924">키보드 키 매핑, 기능 키 등을 변경하세요</translation>
<translation id="2410298923485357543">기기가 온라인일 때 자연 음성 사용</translation>
<translation id="2416435988630956212">키보드 기능 키</translation>
<translation id="2427507373259914951">왼쪽 클릭</translation>
<translation id="2445726032315793326">부분 돋보기</translation>
<translation id="2448810255793562605">스위치 제어 자동 스캔</translation>
<translation id="2451298179137331965">2배</translation>
<translation id="2469375675106140201">맞춤법 검사 맞춤설정</translation>
<translation id="2471469610750100598">검정(기본)</translation>
<translation id="2477065602824695373">여러 스위치를 설정했으므로 자동 스캔이 사용 중지되었습니다.</translation>
