import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core && is_chromeos)

schema_sources_ = [
  "diagnostics.idl",
  "events.idl",
  "management.idl",
  "telemetry.idl",
]

chromeos_system_extensions_api_schema_sources =
    get_path_info(schema_sources_, "abspath")

chromeos_system_extensions_api_root_namespace = "chromeos::api::%(namespace)s"

chromeos_system_extensions_api_schema_include_rules = "chromeos/ash/experiences/extensions/common/telemetry/api:extensions::api::%(namespace)s"
