import("//extensions/buildflags/buildflags.gni")

assert(is_chromeos)
assert(enable_extensions_core)

chromeos_schema_sources_ = [ "speech_recognition_private.idl" ]

chromeos_extensions_api_schema_sources =
    get_path_info(chromeos_schema_sources_, "abspath")

chromeos_extensions_api_root_namespace = "extensions::api::%(namespace)s"

chromeos_extensions_api_schema_include_rules =
    "extensions/common/api:extensions::api::%(namespace)s"
