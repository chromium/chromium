    "core/watcher_set.cc",
    "core/watcher_set.h",
  ]

  defines = [
    "MOJO_LEGACY_SYSTEM_IMPL_IMPLEMENTATION",

    # Mirrors the //mojo/core and //mojo/core/ports defines, which are enabled
    # on ChromeOS (and Android) builds. They affect the wire protocol, so they
    # must match what ChromeOS legacy Mojo Core peers were built with.
    "MOJO_LEGACY_CORE_LEGACY_PROTOCOL",
    "MOJO_LEGACY_BACKWARDS_COMPAT",
  ]

  public_deps = [
    ":mojo_buildflags",
    ":public_c_system",
    ":public_cpp_platform",
    "//base",
    "//third_party/abseil-cpp:absl",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  if (!is_debug && !optimize_for_size) {
    configs -= [ "//build/config/compiler:default_optimization" ]
    configs += [ "//build/config/compiler:optimize_max" ]
  }
}

