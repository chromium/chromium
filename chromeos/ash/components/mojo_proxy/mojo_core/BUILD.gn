import("//build/buildflag_header.gni")
import("//build/config/compiler/compiler.gni")
import("//build/config/features.gni")
import("//testing/test.gni")

assert(is_chromeos)

group("mojo_core") {
  visibility = [ "//chromeos/ash/components/mojo_proxy/*" ]
  public_deps = [
    ":core",
    ":public_cpp_system",
  ]
}

# Corresponds to buildflag_header("buildflags") in //mojo/BUILD.gn.
# The clone is frozen, so dynamic GN flags ($mojo_use_apple_channel,
# $mojo_support_legacy_core) are replaced with constant values.
buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "MOJO_LEGACY_USE_APPLE_CHANNEL=false",
    "MOJO_LEGACY_SUPPORT_LEGACY_CORE=true",
  ]
}

# Corresponds to buildflag_header("mojo_buildflags") in
# //mojo/public/cpp/bindings/BUILD.gn.
buildflag_header("mojo_buildflags") {
  header = "mojo_buildflags.h"
  header_dir =
      "chromeos/ash/components/mojo_proxy/mojo_core/public/cpp/bindings"
  flags = [ "MOJO_LEGACY_TRACE_ENABLED=false" ]
}

