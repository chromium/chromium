assert(is_chromeos, "Non-ChromeOS builds cannot depend on //chromeos/ash")

# Utilities to manage Chrome's log files on ChromeOS.
# This must depend only on //base, because this is used by
# //chrome/common/logging_chrome.cc, which is linked into all processes.
component("logging") {
  defines = [ "IS_CHROMEOS_ASH_COMPONENTS_LOGGING_IMPL" ]

  sources = [
    "log_file_util.cc",
    "log_file_util.h",
    "session_log.cc",
    "session_log.h",
  ]

  deps = [ "//base" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "log_file_util_unittest.cc",
    "session_log_unittest.cc",
  ]

  deps = [
    ":logging",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
