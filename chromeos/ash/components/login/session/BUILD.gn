assert(is_chromeos, "Non-Chrome-OS builds must not depend on //chromeos/ash")

component("session") {
  defines = [ "IS_CHROMEOS_ASH_COMPONENTS_LOGIN_SESSION_IMPL" ]
  deps = [
    "//base",
    "//chromeos/ash/components/dbus/cryptohome",
    "//chromeos/ash/components/dbus/cryptohome:cryptohome_proto",
    "//chromeos/ash/components/dbus/session_manager",
    "//chromeos/ash/components/dbus/userdataauth",
    "//chromeos/ash/components/dbus/userdataauth:userdataauth_proto",
    "//chromeos/dbus/power",
    "//third_party/protobuf:protobuf_lite",
  ]
  sources = [
    "session_termination_manager.cc",
    "session_termination_manager.h",
  ]
}

# Must not be linked into a component (including :session): a component would
# get its own copy of the KeepAliveRegistry singleton in component builds.
source_set("process_shutdown") {
  sources = [
    "process_shutdown.cc",
    "process_shutdown.h",
  ]
  deps = [
    "//base",
    "//components/keep_alive_registry",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "scoped_process_shutting_down_override_for_testing.cc",
    "scoped_process_shutting_down_override_for_testing.h",
  ]
  deps = [
    "//base",
    "//components/keep_alive_registry",
  ]
}

source_set("unit_tests") {
  testonly = true
  deps = [
    ":process_shutdown",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//chromeos/ash/components/dbus/cryptohome",
    "//chromeos/ash/components/dbus/session_manager",
    "//chromeos/ash/components/dbus/userdataauth",
    "//chromeos/ash/components/login/session",
    "//chromeos/dbus/power",
    "//components/keep_alive_registry",
    "//testing/gtest",
  ]
  sources = [
    "process_shutdown_unittest.cc",
    "session_termination_manager_unittest.cc",
  ]
}
