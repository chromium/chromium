import("//build/config/chrome_build.gni")
import("//tools/grit/grit_rule.gni")

assert(is_chromeos)

grit("resources") {
  source = "ash_resources.grd"

  inputs = [
    "audio_resources.grdp",
    "public/sounds/accessibility/camera_snap.wav",
    "public/sounds/accessibility/earcons/enter_screen.wav",
    "public/sounds/accessibility/earcons/exit_screen.wav",
    "public/sounds/accessibility/earcons/passthrough.wav",
    "public/sounds/accessibility/lock.wav",
    "public/sounds/accessibility/object_delete.wav",
    "public/sounds/accessibility/shutdown.wav",
    "public/sounds/accessibility/spoken_feedback_disabled.wav",
    "public/sounds/accessibility/spoken_feedback_enabled.wav",
    "public/sounds/accessibility/spoken_feedback_toggle_countdown_high.wav",
    "public/sounds/accessibility/spoken_feedback_toggle_countdown_low.wav",
    "public/sounds/accessibility/touch_type.wav",
    "public/sounds/accessibility/unlock.wav",
    "public/sounds/accessibility/volume_adjust.wav",
    "public/sounds/focus_mode_ending_moment.flac",
    "public/sounds/power/charging_started_high.flac",
    "public/sounds/power/charging_started_low.flac",
    "public/sounds/power/charging_started_medium.flac",
    "public/sounds/power/low_battery.flac",
  ]

  if (is_chrome_branded) {
    inputs += [
      "growth_framework_resources.grdp",
      "scalable_iph_unscaled_resources.grdp",
      "scanner_resources.grdp",
    ]
  }

  outputs = [
    "grit/ash_resources.h",
    "grit/ash_resources_map.cc",
    "grit/ash_resources_map.h",
    "ash_resources.pak",
  ]
  output_dir = "$root_gen_dir/chromeos/ash"

  defines = [ "is_chrome_branded=$is_chrome_branded" ]

  grit_flags = [
    "-E",
    "mojom_root=" + rebase_path(root_gen_dir, root_build_dir),
  ]

  deps = [
    "//chromeos/ash/components/language_packs/public/mojom:mojom_js",
    "//chromeos/ash/components/mantis/mojom:mojom_js",
  ]
}
