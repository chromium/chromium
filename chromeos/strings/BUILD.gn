# Forwarding targets while callers are migrated to //chromeos/resources.
# Copy the forwarding header into $target_gen_dir so incremental builds
# overwrite any stale generated chromeos/strings/grit/chromeos_strings.h
# (since -Igen precedes -I../..).
copy("strings_grit") {
  sources = [ "grit/chromeos_strings.h" ]
  outputs = [ "$target_gen_dir/grit/chromeos_strings.h" ]
  public_deps = [ "//chromeos/resources:strings_grit" ]
}

group("strings") {
  public_deps = [
    ":strings_grit",
    "//chromeos/resources:strings",
  ]
}

# Use data_deps so GN propagates the repacked chromeos_test_strings.pak output
# into test runtime_deps for Swarming isolates.
group("chromeos_test_strings") {
  public_deps = [ "//chromeos/resources:chromeos_test_strings" ]
  data_deps = [ "//chromeos/resources:chromeos_test_strings" ]
}
