namespace foo {
BASE_FEATURE(kSampleFeatures, base::FEATURE_DISABLED_BY_DEFAULT);
BASE_FEATURE(kString, base::FEATURE_DISABLED_BY_DEFAULT);
BASE_FEATURE(kNullMarked, base::FEATURE_DISABLED_BY_DEFAULT);
BASE_FEATURE(kSampleFeatureMap, base::FEATURE_DISABLED_BY_DEFAULT);
const base::Feature* const kFeaturesExposedToJava[] = {
    &kSampleFeatures,
    &kString,
    &kNullMarked,
    &kSampleFeatureMap,
};
