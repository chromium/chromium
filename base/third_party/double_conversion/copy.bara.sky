load("//crowbar", "crowbar_workflow")

crowbar_workflow(
    origin_files = glob(
        [
            "LICENSE",
            "double-conversion/**",
        ],
        exclude = [
            "double-conversion/.gitignore",
            "double-conversion/SConscript",
        ],
    ),
    transformations = [
        patch.apply(patches = ["patches/0001-memmove_size_t_cast.patch"]),
    ],
)
