load("//crowbar", "crowbar_workflow")

crowbar_workflow(
    origin_files = glob(["xdg-user-dir-lookup.c"]),
    transformations = [
        # Chromium builds the file as C++: xdg_user_dir_lookup.h declares
        # xdg_user_dir_lookup() without extern "C".
        core.move("src/xdg-user-dir-lookup.c", "src/xdg_user_dir_lookup.cc"),
        patch.apply(patches = [
            "patches/0001-export-xdg_user_dir_lookup.patch",
            "patches/0002-include-xdg_user_dir_lookup-header.patch",
        ]),
    ],
)
