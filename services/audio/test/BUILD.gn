import("//media/media_options.gni")

source_set("test_support") {
  testonly = true

  sources = [
    "fake_audio_service.cc",
    "fake_audio_service.h",
    "fake_consumer.cc",
    "fake_consumer.h",
    "fake_loopback_group_member.cc",
    "fake_loopback_group_member.h",
    "fake_output_stream.cc",
    "fake_output_stream.h",
    "mock_log.cc",
    "mock_log.h",
    "mock_loopback_source.cc",
    "mock_loopback_source.h",
    "mock_stream_factory.cc",
    "mock_stream_factory.h",
  ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//media",
    "//media/mojo/mojom",
    "//services/audio",
    "//services/audio/public/cpp",
    "//services/audio/public/cpp:test_support",
    "//services/audio/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (chrome_wide_echo_cancellation_supported) {
    sources += [
      "fake_ml_model_handles.cc",
      "fake_ml_model_handles.h",
    ]
    public_deps = [
      "//media/webrtc",
      "//media/webrtc/voice_isolation:test_support",
      "//third_party/tflite",
    ]
  }
}
