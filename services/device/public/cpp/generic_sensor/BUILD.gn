source_set("generic_sensor") {
  sources = [
    "orientation_util.cc",
    "orientation_util.h",
    "sensor_reading_shared_buffer.cc",
    "sensor_reading_shared_buffer.h",
    "sensor_reading_shared_buffer_reader.cc",
    "sensor_reading_shared_buffer_reader.h",
    "sensor_traits.cc",
    "sensor_traits.h",
  ]

  public_deps = [
    ":sensor_mojom_traits",
    "//services/device/public/mojom:generic_sensor",
  ]

  deps = [
    "//base",
    "//device/base/synchronization",
    "//ui/gfx/geometry",
  ]
}

# Shared by both the blink and non-blink typemaps for
# device.mojom.SensorReadingRaw so both variants link a single traits
# component.
component("sensor_mojom_traits") {
  sources = [
    "platform_sensor_configuration.cc",
    "platform_sensor_configuration.h",
    "sensor_mojom_traits.cc",
    "sensor_mojom_traits.h",
    "sensor_reading.cc",
    "sensor_reading.h",
  ]

  defines = [ "IS_GENERIC_SENSOR_MOJOM_TRAITS_IMPL" ]

  public_deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    "//services/device/public/mojom:generic_sensor_shared",
  ]
}
