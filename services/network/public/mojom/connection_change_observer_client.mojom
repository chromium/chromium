module network.mojom;

import "services/network/public/mojom/load_timing_internal_info.mojom";
import "services/network/public/mojom/network_types.mojom";
import "mojo/public/mojom/base/time.mojom";

// LINT.IfChange(ConnectionEstablishmentInitiator)
// Indicates the initiator of the connection establishment.
// Mirrors `net::ConnectionEstablishmentInitiator`.
enum ConnectionEstablishmentInitiator {
    // The session was established for a preconnect request.
    kPreconnect,
    // The session was established for a normal request.
    kRequest
};
// LINT.ThenChange(
//   //net/base/reconnect_notifier.h:ConnectionEstablishmentInitiator
// )

// Aggregates core connection-establishment statistics to pass onto observers.
struct EstablishedConnectionInfo {
    // Connection protocol used.
    NextProto connection_info;
    // Time taken to establish the connection.
    mojo_base.mojom.TimeDelta connection_setup_time;
    // Initiator of the connection request.
    ConnectionEstablishmentInitiator initiator;
};
// An enum which represents the possible network change event that may happen
// in the underlying network connection. This mirrors `net::NetworkChangeEvent`.
enum NetworkChangeEvent {
    // The current network is soon to be disconnected.
    kSoonToDisconnect,

    // Disconnected from the previously connected network.
    kDisconnected,

    // Connected to a new network.
    kConnected,

    // The default network has been changed.
   kDefaultNetworkChanged
};

// An observer to monitor whether a reconnect-emitting event has happened in a
// connection. It primary use is to notify the browser process of the events
// from the //net layer.
interface ConnectionChangeObserverClient {
    // Notify that the underlying network session has been closed. This means
    // that a connection was established, but was later closed (e.g. because
    // of idle timeout, GoAway from server, etc.).
    // `was_ever_used_to_create_streams` is true if the connection was used to
    // create at least one stream.
    OnSessionClosed(bool was_ever_used_to_create_streams);

    // Notify that a network connection has been established.
    OnConnectionEstablished(EstablishedConnectionInfo info);
    // Notify on a network change event. This means that the status of
    // underlying network (such as 4G or Wifi) has changed.
    OnNetworkEvent(NetworkChangeEvent event);

    // Notify that the network connection could not be established. This means
    // that we attempted establishing the new connection, but could not
    // establish new connection.
    OnConnectionFailed();
};

// Coupled idle-timeout and keep-alive PING schedule for a preconnected QUIC
// session.
struct QuicKeepAliveTimeouts {
  // Timeout for the session to be closed after the last successful packet/PING.
  // Must be in `(2s, UINT32_MAX s]`.
  mojo_base.mojom.TimeDelta idle_timeout;

  // Optional interval between keep-alive PINGs (`>= 1s`). When null, QUIC's
  // default `kPingTimeoutSecs` (15s) is used. The effective ping interval must
  // be strictly less than `idle_timeout - 1s`.
  mojo_base.mojom.TimeDelta? ping_interval;
};

// Per-session QUIC keep-alive, handshake initial-RTT, and connection-option
// tuning passed to `NetworkContext::PreconnectSockets()`.
// Typemapped to `net::ConnectionKeepAliveConfig`.
struct ConnectionKeepAliveConfig {
  // Optional keep-alive and idle timeouts. When null, QUIC's default idle
  // network timeout and ping timeout are preserved unchanged.
  QuicKeepAliveTimeouts? keep_alive_timeouts;

  // Enables periodic keep-alive PING frames while no requests are active.
  bool enable_connection_keep_alive = false;

  // Optional positive client-side initial RTT (`> 0`, finite) configured
  // locally before any RTT samples arrive when no cached SRTT, 2G/3G estimate,
  // or explicit handshake RTT exists (never sent in the `IRTT` transport
  // parameter).
  mojo_base.mojom.TimeDelta? initial_rtt;

  // Comma-separated ASCII `QuicTag` connection options sent to the server
  // (e.g. "ABCD,EFGH"), parsed inside the network layer.
  string quic_connection_options = "";
};
